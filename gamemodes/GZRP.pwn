public AntiCJ(playerid) {
    if (IsPlayerConnected(playerid)) {
        SetPlayerVirtualWorld(playerid, VWTemporal[playerid]);
        Descongelar(playerid);
    }
}

public descongelartake(playerid) {
    if (JugadorLogeado[playerid] == 1 && !IsPlayerNPC(playerid) && IsPlayerConnected(playerid)) {
        Descongelar(playerid);
    }
    return 1;
}

public QuitarDineroTransfender(playerid, cantidad) {
    if (cantidad < 0) return 1;
    PLAYER_INFO[playerid][jDinero] -= cantidad;
    return 1;
}

public Recolectar(playerid) {
    new item = random(15);
    switch (item) {
        case 0: {
            SendClientMessage(playerid, -1, "Has encontrado {00FF00}50gr de crack{FFFFFF} y le diste la mitad a tu compañero.");
            SendClientMessage(Companero[playerid], -1, "Tu compañero encontro {F00000}50gr de crack{FFFFFF} y te dio la mitad.");
            PLAYER_INFO[playerid][pCrack] += 25;
            PLAYER_INFO[Companero[playerid]][pCrack] += 25;
        }
        case 3: {
            SendClientMessage(playerid, -1, "Has encontrado {00FF00}4 botiquines{FFFFFF} y le diste la mitad a tu compañero.");
            SendClientMessage(Companero[playerid], -1, "Tu compañero encontro {F00000}4 botiquines{FFFFFF} y te dio la mitad.");
            PLAYER_INFO[playerid][pBotiquines] += 2;
            PLAYER_INFO[Companero[playerid]][pBotiquines] += 2;
        }
        case 6: {
            SendClientMessage(playerid, -1, "Has encontrado una billetera con {00CC00}$10.000{FFFFFF} y le diste la mitad a tu compañero.");
            SendClientMessage(Companero[playerid], -1, "Tu compañero encontro una billetera con {00CC00}$10.000{FFFFFF}, y te dio la mitad.");
            DarDinero(playerid, 5000);
            DarDinero(Companero[playerid], 5000);
        }
        case 9: {
            SendClientMessage(playerid, -1, "Has encontrado {00CC00}50 medicamentos{FFFFFF} y le diste la mitad a tu compañero.");
            SendClientMessage(Companero[playerid], -1, "Tu compañero encontro {00CC00}50 medicamentos{FFFFFF} y te dio la mitad.");
            PLAYER_INFO[playerid][pMedicamentos] += 25;
            PLAYER_INFO[Companero[playerid]][pMedicamentos] += 25;
        }
        case 10: {
            SendClientMessage(playerid, -1, "Has encontrado {00FF00}50gr de marihuana{FFFFFF} y le diste la mitad a tu compañero.");
            SendClientMessage(Companero[playerid], -1, "Tu compañero encontro {F00000}50gr de marihuana{FFFFFF} y te dio la mitad.");
            PLAYER_INFO[playerid][pMarihuana] += 25;
            PLAYER_INFO[Companero[playerid]][pMarihuana] += 25;
        }
        case 11: {
            SendClientMessage(playerid, -1, "Has encontrado {00FF00}2 Totems{FFFFFF} y le diste la mitad a tu compañero.");
            SendClientMessage(Companero[playerid], -1, "Tu compañero encontro {F00000}2 Totems{FFFFFF} y te dio la mitad.");
            PLAYER_INFO[playerid][Totems] += 1;
            PLAYER_INFO[Companero[playerid]][Totems] += 1;
        }
        case 12: {
            SendClientMessage(playerid, -1, "Has encontrado {00FF00}2 Diamantes{FFFFFF} y le diste la mitad a tu compañero.");
            SendClientMessage(Companero[playerid], -1, "Tu compañero encontro {F00000}2 Diamantes{FFFFFF} y te dio la mitad.");
            PLAYER_INFO[playerid][Moneda] += 1;
            PLAYER_INFO[Companero[playerid]][Moneda] += 1;
        }
    }
    TimerRecoleccion[playerid] = 0;
    SendClientMessage(playerid, -1, "Sube al camion de basura para continuar.");
    recogiendo[playerid] = 0;
    PBasura[playerid]++;
    ApplyAnimation(playerid, "CARRY", "crry_prtial", 1.0, 0, 0, 0, 0, 0);
    if (RecorridoBasu[playerid] == 1) {
        switch (PBasura[playerid]) {
            case 2 :  {
                StartPlayerPath(Companero[playerid], 1548.8938, -1874.5441, 13.3828, 5.0);
                PuntoBaX[Companero[playerid]] = 1548.8938;
                PuntoBaY[Companero[playerid]] = -1874.5441;
                PuntoBaZ[Companero[playerid]] = 13.3828;
                PuntoBaA[Companero[playerid]] = 5.0;
            }
            case 3 :  {
                StartPlayerPath(Companero[playerid], 2084.0916, -1908.8611, 13.3828, 5.0);
                PuntoBaX[Companero[playerid]] = 2084.0916;
                PuntoBaY[Companero[playerid]] = -1908.8611;
                PuntoBaZ[Companero[playerid]] = 13.3828;
                PuntoBaA[Companero[playerid]] = 5.0;
            }
            case 4 :  {
