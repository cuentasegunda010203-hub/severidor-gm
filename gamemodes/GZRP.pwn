        //SetPlayerAttachedObject(playerid, 4,19142,1,0.109797,0.053399,-0.002000,0.000000,-2.299998,0.299997,1.046000,0.986998,0.893000);
        ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 1, 1, 0, 0);
        GameTextForPlayerEx(playerid, "~b~!Colocando ~w~Chaleco!", 5000, 5);
        EstablecerChaleco(playerid, 100);
    }
    return 1;
}
