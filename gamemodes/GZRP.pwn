            Notificador2(playerid, "Tocaste el timbre del departamento.");
            PLAYER_TEMP[playerid][PidioTimbre] = 1;
            SendClientMessageEx(playeriddepa, -1, "{"        COLOR_GM "}%s{FFFFFF} esta tocando el timbre, usa {"        COLOR_GM "}/pasar %d{FFFFFF} para dejarlo pasar.", PLAYER_INFO[playerid][Nickname], playerid);
