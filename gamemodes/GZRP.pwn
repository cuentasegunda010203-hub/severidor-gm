stock ActualizarPais(playerid) {
    new country[30], Queryx[300];
    GetPlayerCountry(playerid, country, sizeof(country));
    format(PLAYER_INFO[playerid][pPaisRegistro], 32, "%s", country);
    mysql_format(handle_db, Queryx, sizeof(Queryx), "UPDATE `usuarios` SET `Pais_Registro`='%e' WHERE `Username`=('%e')", country, PLAYER_INFO[playerid][Nickname]);
    mysql_tquery(handle_db, Queryx);
}
