                        strcat(DIALOG, string);
                        dialogs_ShowPlayerDialog(playerid, VIEW_RANK_NAME, DIALOG_STYLE_LIST, "Bandas: Rangos de la banda", DIALOG, "Cambiar", "Volver");
                    }
