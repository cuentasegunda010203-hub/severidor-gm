public LlamadaGrua(playerid) {
    for(new t = 0; t < sizeof POSTALLERES; t++) {
        if (IsPlayerInRangeOfPoint(playerid, 6, POSTALLERES[t][xXx], POSTALLERES[t][yYy], POSTALLERES[t][zZz])) {
            return SendClientMessage(playerid, -1, "No puedes llamar desde aca, busca mejor señal."), finllamada(playerid);
        }
    }
    if (GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0) return SendClientMessage(playerid, COLOR_WHITE, "No puedes hacer esto en un interior."), finllamada(playerid);
    if (PLAYER_INFO[playerid][pCargos] >= 5) return SendClientMessage(playerid, -1, "Contestadora Romina: no tratamos con delincuentes.");
    if (PLAYER_INFO[playerid][pTiempoCarcel] > 0 || PLAYER_INFO[playerid][pTiempoJail] > 0) return SendClientMessage(playerid, -1, "No puedes usar la mochila en estos momento."), finllamada(playerid);
    new string[340];
    SendClientMessage(playerid, -1, "{33CCFF}[Servicio de grua]{FFFFFF} Angelica: Hola, ¿quieres utilizar nuestro servicio de gruas?.");
    format(string, sizeof(string), "{FFFFFF}El servicio de grua sirve para recuperar el vehículo, en caso de que haya quedado\nen un lugar inaccesible.\nPor ejemplo: en el agua, dentro del estacionamiento de una propiedad, en una pileta, etc.\n\nNota: Los jugadores {40FF00}GVIP{FFFFFF} tienen este servicio con el 95% de descuento.\n\n{FFEE00}¿Quieres utilizar este servicio?");
    dialogs_ShowPlayerDialog(playerid, DIALOGO_GRUA, DIALOG_STYLE_MSGBOX, "Informacion sobre el servicio de grua", string, "Si", "No");
    return 1;
}
public ServicioGrua1(playerid) {
    for(new t = 0; t < sizeof POSTALLERES; t++) {
        if (IsPlayerInRangeOfPoint(playerid, 6, POSTALLERES[t][xXx], POSTALLERES[t][yYy], POSTALLERES[t][zZz])) {
            return SendClientMessage(playerid, -1, "No puedes llamar desde aca, busca mejor señal."), finllamada(playerid);
        }
    }
    if (GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0) return SendClientMessage(playerid, COLOR_WHITE, "No puedes hacer esto en un interior."), finllamada(playerid);
    if (PLAYER_INFO[playerid][pCargos] >= 5) return SendClientMessage(playerid, -1, "Contestadora Romina: no tratamos con delincuentes.");
    if (PLAYER_INFO[playerid][pTiempoCarcel] > 0 || PLAYER_INFO[playerid][pTiempoJail] > 0) return SendClientMessage(playerid, -1, "No puedes usar la mochila en estos momento."), finllamada(playerid);

    new stringo[256];
    SendClientMessage(playerid, -1, "{33CCFF}[Servicio de grua]{FFFFFF} Angelica: Perfecto, ¿Donde quiere que llevemos su vehículo?.");
    if (BOTE(autos[playerid]) || BOTE(autos2[playerid]) || BOTE(autos3[playerid]) || BOTE(autos4[playerid]) || BOTE(autos5[playerid])) format(stringo, 256, "Ultimo lugar estacionado\nEstacionamiento municipal\nEstacionamiento marítimo.");
    else format(stringo, 256, "Ultimo lugar estacionado\nEstacionamiento municipal\nEstacionamiento marítimo\nMi posicion actual");
    dialogs_ShowPlayerDialog(playerid, DIALOGO_GRUA3, DIALOG_STYLE_LIST, "¿Donde quieres que enviemos tu vehículo?", stringo, "Aceptar", "Cancelar");
    return 1;
}
public ServicioGrua2(playerid) {
    PANEL_GRUA(playerid);
    SendClientMessage(playerid, -1, "{33CCFF}[Servicio de grua]{FFFFFF} Angelica: ¿Podría decirme la matrícula?");
    return 1;
}



public CheckVIP(playerid) {
    new day, month, year, Query[200];
    getdate(year, month, day);
    if (month >= 13) {
        month = 1;
    }
    if (PLAYER_INFO[playerid][pVip]>0 && year*10000+month*100+day >= PLAYER_INFO[playerid][finano]*10000+PLAYER_INFO[playerid][finmes]*100+PLAYER_INFO[playerid][findia]) {

        PLAYER_INFO[playerid][pVip] = 0;
        Notificador2(playerid, "~r~Tu VIP ha expirado, puedes renovarlo en nuestra ~y~/web");
        mysql_format(handle_db, Query, sizeof(Query), "UPDATE `usuarios` SET `FinDia`='0',`FinMes`='0',`FinAno`='0' WHERE `Username`='%e'", PLAYER_INFO[playerid][Nickname]);
        mysql_tquery(handle_db, Query);
    }
    if (gettime() >= PLAYER_INFO[playerid][finlicencia]) PLAYER_INFO[playerid][pLicencia] = 0;
}
stock GetVehicleDriver(vehicleid) {
    new pilotojugador = INVALID_PLAYER_ID;
    foreach(new i : Player) {

        if (IsPlayerInVehicle(i, vehicleid) && !IsPlayerNPC(i)) {

            if (GetPlayerState(i) == PLAYER_STATE_DRIVER) {

                pilotojugador = i;
                break;
            }
        }
    }
    return pilotojugador;
}
public DarGasolina(driver, autoid, petroleo, gasoid) {
    if (IsPlayerInVehicle(driver, autoid) && IsPlayerConnected(driver)) {
        new ganancias;
        new preciolitro = Gasolineras[gasoid][gPrecioL];
        if (VehicleFuel[autoid] < petroleo) {
            VehicleFuel[autoid]++;
            ganancias++;
            //gasolineras
            Gasolineras[gasoid][gGasolina]--;
            Gasolineras[gasoid][gGanancias] += ganancias * preciolitro;
            new string[256];
            format(string, sizeof string, "{FFFFFF}Pulsa {DBED15}'H'{FFFFFF} para abrir el menu de opciones.\nPrecio: {00CC00}$%d{FFFFFF} cada litro\nCantidad de combustible: %d/%d", Gasolineras[gasoid][gPrecioL], Gasolineras[gasoid][gGasolina], Gasolineras[gasoid][gMaxGasolina]);
            UpdateDynamic3DTextLabelText(Gasolineras[gasoid][gTexto], 0xFFFFFFAA, string);
        } else if (VehicleFuel[autoid] >= petroleo) {
            new dueno = GetPlayerID_DB(Gasolineras[gasoid][gDuenoID]);
            new location[MAX_ZONE_NAME];
            Get2DZone(location, MAX_ZONE_NAME, Gasolineras[gasoid][Posss][0], Gasolineras[gasoid][Posss][1], Gasolineras[gasoid][Posss][2]);
            if (IsPlayerConnected(dueno) && JugadorLogeado[dueno] != 0) {
                new total = ganancias * preciolitro;
                SendClientMessageEx(dueno, -1, "{"            COLOR_GM "}Se registró una compra de {FFFF00}%d{"            COLOR_GM "} litros con un precio de $%s C/L en tu gasolinera ubicada en {FFFFFF}%s", ganancias, ConvertirNumero(preciolitro), location);
                SendClientMessageEx(dueno, -1, "{"            COLOR_GM "}Factura generada a {ffffff}%s{"            COLOR_GM "} con un precio neto de {ffffff}$%s", PLAYER_INFO[driver][Nickname], ConvertirNumero(total));
                SendClientMessageEx(dueno, -1, "{"            COLOR_GM "}Tu gasolinera ha recolectado {ffffff}${00FF00}%s{"            COLOR_GM "} hasta el momento.", ConvertirNumero(Gasolineras[gasoid][gGanancias]));
            }
            VehicleFuel[autoid] = petroleo;
            KillTimer(llenado[autoid]);
            Descongelar(driver);
            TimerCombustible[driver] = 0;
            PLAYER_TIMES[driver][TiempoLlenar] = gettime();
            GuardarGasolinera(gasoid);
        }
    } else KillTimer(llenado[autoid]);
    return 1;
}

