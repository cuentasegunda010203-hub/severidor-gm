stock MostrarPescar(playerid, idfinal) {
    _Select_Status[playerid] = true;
    SelectTextDraw(playerid, 0x272828FF);
    new vR = random(4);
    TextDrawShowForPlayer(playerid, BoxRobar);
    TextDrawShowForPlayer(playerid, LanzarArponMensaje);
    TextDrawShowForPlayer(playerid, EquisCerrar);
    PlayerTextDrawSetPreviewModel(playerid, Pescar[playerid][0], 1601);
    PlayerTextDrawSetPreviewModel(playerid, Pescar[playerid][1], 1601);
    PlayerTextDrawSetPreviewModel(playerid, Pescar[playerid][2], 1601);
    PlayerTextDrawSetPreviewModel(playerid, Pescar[playerid][3], 1601);
    switch (vR) {
        case 0 : PlayerTextDrawSetPreviewModel(playerid, Pescar[playerid][0], idfinal);
        case 1 : PlayerTextDrawSetPreviewModel(playerid, Pescar[playerid][1], idfinal);
        case 2 : PlayerTextDrawSetPreviewModel(playerid, Pescar[playerid][2], idfinal);
        case 3 : PlayerTextDrawSetPreviewModel(playerid, Pescar[playerid][3], idfinal);
    }
    LanzarArpon[playerid] = idfinal;
    LanzarArponID[playerid] = vR + 1;
    PlayerTextDrawShow(playerid, Pescar[playerid][0]);
    PlayerTextDrawShow(playerid, Pescar[playerid][1]);
    PlayerTextDrawShow(playerid, Pescar[playerid][2]);
    PlayerTextDrawShow(playerid, Pescar[playerid][3]);
}
stock DejarRocaProcesadora(playerid) {
    new ganancias;
    if (rocajugador[playerid] == 897) {
        switch (PLAYER_INFO[playerid][pNivelMinero]) {
            case 1: {
                new intento = random(6);
                switch (intento) {
                    case 0 :  { ganancias = 976; }
                    case 1 :  { ganancias = 851; }
                    case 2 :  { ganancias = 881; }
                    case 3 :  { ganancias = 922; }
                    case 4 :  { ganancias = 913; }
                    case 5 :  { ganancias = 961; }

                }
            }
            case 2: {
                new intento = random(6);
                switch (intento) {
                    case 0 :  { ganancias = 1176; }
                    case 1 :  { ganancias = 1251; }
                    case 2 :  { ganancias = 1281; }
                    case 3 :  { ganancias = 1322; }
                    case 4 :  { ganancias = 1313; }
                    case 5 :  { ganancias = 1161; }

                }
            }
            case 3..999: {
                new intento = random(6);
                switch (intento) {
                    case 0 :  { ganancias = 1576; }
                    case 1 :  { ganancias = 1651; }
                    case 2 :  { ganancias = 1581; }
                    case 3 :  { ganancias = 1622; }
                    case 4 :  { ganancias = 1613; }
                    case 5 :  { ganancias = 1561; }
                }
            }
        }
        new exp, texto[128];
        if (PLAYER_INFO[playerid][pVip] == 0) {
            format(texto, sizeof(texto), "Esta vez no ganaste puntos de habilidad, consigue membresia VIP para aumentar las posibiliades de ganar habilidad.");
            exp = random(3);
        } else {
            format(texto, sizeof(texto), "Esta vez no ganaste puntos de habilidad.");
            exp = random(2);
        }
        switch (exp) {
            case 0 : SendClientMessage(playerid, -1, texto);
            case 1: {
                if (PLAYER_INFO[playerid][pNivelMinero] == 999 && PLAYER_INFO[playerid][pExpMinero] >= 49) Notificador2(playerid, "Llegaste al nivel maximo como minero.");
                else if (PLAYER_INFO[playerid][pExpMinero] < 49) {
                    //Notificador2(playerid,"Habilidad de minero aumentada ~y~+1 punto ~w~/ ~y~ +1 Experiencia.");
                    CrearNotificacion(playerid, "hud:radar_gangb", "Habilidad de minero aumentada ~y~+1 punto ~w~/ ~y~ +1 Experiencia.", 5, 0xFFFFFFDD, 0x000000FF);
                    PLAYER_INFO[playerid][jExperiencia]++;
                    BarraExp(playerid, 1);
                    if (PLAYER_TIMES[playerid][FarmearLZ] == 0) {
                        PLAYER_INFO[playerid][Moneda] += 1;
                        PUSH(playerid, "~g~Has recibido 1"            SERVER_COIN " por ser dedicado en tu trabajo.");
                        PLAYER_TIMES[playerid][FarmearLZ] = 1800;
                    }
                    PLAYER_INFO[playerid][pExpMinero]++;
                } else if (PLAYER_INFO[playerid][pExpMinero] >= 49) {
                    PUSH(playerid, "~g~¡Felicitaciones!~w~ Aumentaste un nivel en el trabajo de minero.");
                    PLAYER_INFO[playerid][pExpMinero] = 0;
                    PLAYER_INFO[playerid][pNivelMinero]++;

                    PLAYER_INFO[playerid][jExperiencia]++;
                    BarraExp(playerid, 1);
                    if (PLAYER_TIMES[playerid][FarmearLZ] == 0) {
                        PLAYER_INFO[playerid][Moneda] += 2;
                        PUSH(playerid, "~g~Has recibido 2"            SERVER_COIN " por ser dedicado en tu trabajo.");
                        PLAYER_TIMES[playerid][FarmearLZ] = 1800;
                    }
                }
            }
            case 2 : SendClientMessage(playerid, -1, texto);
        }
        AddPlayerJobPoints(playerid, T_Minero);
        AccionesRol(playerid, "tira una roca a la procesadora.", 20);
        new string[128];
        format(string, sizeof(string), "~g~¡Buen trabajo!~w~ Tus ganancias son: ~g~$%d~g~.", ganancias);
        ShowPlayerMessage(playerid, string);
        DarDinero(playerid, ganancias);
        ClearAnimations(playerid);
        SacarAnimF(playerid);
        RemovePlayerAttachedObject(playerid, 4);
        rocajugador[playerid] = INVALID_TOY_ID;
        TogglePlayerControllable(playerid, 1);
        ClearAnimations(playerid);
    }
    return 1;
}

