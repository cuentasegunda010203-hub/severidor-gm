                    }
                    cache_delete(result);
                    SHA256_PassHash(inputtext, pNameL, hashdb, sizeof hashdb);
                    mysql_format(handle_db, Query, sizeof(Query), "SELECT * FROM `usuarios` WHERE `Username` = '%e' AND `Password` = '%e'", PLAYER_INFO[playerid][Nickname], hashdb);
                    RP_LGAuthBusy[playerid] = true;
