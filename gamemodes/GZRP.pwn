        if (PLAYER_INFO[playerid][pDuty] > 0) return PUSH(playerid, "No puedes obtener un trabajo estando de servicio.");

        if (PLAYER_INFO[playerid][pTrabajo] == T_Camionero || PLAYER_INFO[playerid][pTrabajo2] == T_Camionero) return PUSH(playerid, "No puedes tener dos trabajos iguales.");
        if (PLAYER_INFO[playerid][pTrabajo] == T_Ninguno) return AsignarTrabajo(playerid, T_Camionero, 0);
        else if (PLAYER_INFO[playerid][pTrabajo] != T_Ninguno && PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno && PLAYER_INFO[playerid][pVip] >= 2) return AsignarTrabajo(playerid, T_Camionero, 1);
        else if (PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno) return NoPuedeTrabajo(playerid);
        else if (PLAYER_INFO[playerid][pTrabajo2] != T_Ninguno) return YaTiene2Jobs(playerid);
    } else if (IsPlayerInRangeOfPoint(playerid, 2.0, 2226.2988, -1718.7993, 13.5236)) {
