    if (FABRICAS_INFO[ID][f_TIPO_ACTOR][2] == 1 || FABRICAS_INFO[ID][f_TIPO_ACTOR][2] == 2) {
        if (FABRICAS_INFO[ID][f_ESTADO_COCINERO][2] == 2) {
