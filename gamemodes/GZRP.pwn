public OnPlayerRegister(playerid, sexo) {
    if (!RP_LGValid(playerid) || RP_LGStage[playerid] != LG_SAVING) return 1;
    if (cache_num_rows() == 0) {

        new Query[1024], day, month, year;
        getdate(year, month, day);
        new rplName[32];
        format(rplName, sizeof(rplName), "%s", PLAYER_INFO[playerid][Nickname]);
        for(new i = 0; i < strlen(rplName); i++) {

            if (rplName[i] == '_') {

                rplName[i] = ' ';
            }
        }
        new Pais[30], dayR, monthR, yearR, FechaRegistro[30];
        getdate(yearR, monthR, dayR);
        GetPlayerCountry(playerid, Pais, sizeof(Pais));

        //Generate user encoded password hash
        new hashdb[64 + 1];
        SHA256_PassHash(PLAYER_INFO[playerid][pPassword], PLAYER_INFO[playerid][Nickname], hashdb, sizeof(hashdb));
        //EndHash
        format(PLAYER_INFO[playerid][pPaisRegistro], 32, "%s", Pais);
        format(FechaRegistro, sizeof(FechaRegistro), "%d/%d/%d", dayR, monthR, yearR);
        PLAYER_INFO[playerid][jRopa] = RP_LGModel(playerid);
        new Float:spawnX, Float:spawnY, Float:spawnZ;
        RP_LGSpawnPosition(playerid, spawnX, spawnY, spawnZ);
        mysql_format(handle_db, Query, sizeof(Query), "INSERT INTO `usuarios` (username, password,posX,posY,posZ,posA,vida,Registro,Email,EMS,Edad,Pais_Registro,Registro_U,username_low,cc_exp,Sexo,Skin) VALUES ('%e','%e','%f','%f','%f','0.0000','100','%02d/%02d/%02d','%e',1,%d,'%e','%e','ninguno','%d','%d','%d')", PLAYER_INFO[playerid][Nickname], hashdb, spawnX, spawnY, spawnZ, day, month, year, PLAYER_INFO[playerid][pEmail], PLAYER_INFO[playerid][jEdad], PLAYER_INFO[playerid][pPaisRegistro], FechaRegistro, gettime() + 63115200, sexo, PLAYER_INFO[playerid][jRopa]);
        new Cache:registerResult = mysql_query(handle_db, Query, true);
        new registeredID = cache_insert_id();
        cache_delete(registerResult);
        if(mysql_errno(handle_db) != 0 || registeredID <= 0) {
            SendClientMessage(playerid, COLOR_ORANGE, "No se pudo guardar tu cuenta. Intenta registrarte nuevamente.");
            TextdrawRegistro(playerid);
            return 1;
        }

        new Querys[1000];
        Usuarios[Cantidad]++;
        mysql_format(handle_db, Querys, sizeof(Query), "UPDATE `registros` SET `Cantidad`='%d'", Usuarios[Cantidad]);
        mysql_tquery(handle_db, Querys);




        mysql_format(handle_db, Query, sizeof(Query), "SELECT * FROM `usuarios` WHERE `Username` = '%e' AND `Password` = '%e';", PLAYER_INFO[playerid][Nickname], hashdb);
        mysql_tquery(handle_db, Query, "RP_LGAccountLoaded", "ii", playerid, RP_LGToken[playerid]);

        mysql_format(handle_db, Query, sizeof(Query), "UPDATE `usuarios` SET `IP`='%e' WHERE `Username`='%e'", PlayerIP(playerid), PLAYER_INFO[playerid][Nickname]);
        mysql_tquery(handle_db, Query);

        mysql_format(handle_db, Query, sizeof(Query), "UPDATE `usuarios` SET `LogAutomatico` = 1 WHERE `Username`='%e'", PLAYER_INFO[playerid][Nickname]);
        mysql_tquery(handle_db, Query);

        new stringg[128];
        MensajeAdmin(COLOR_CHEAT, "Nuevo usuario registrado:", 3);
        format(stringg, sizeof(stringg), "%s - ID: %d. (Nivel: %d) (Plataforma: %s)", PLAYER_INFO[playerid][Nickname], playerid, PLAYER_INFO[playerid][@Nivel], Launcher(playerid));
        MensajeAdmin(COLOR_CHEAT, stringg, 3);
        new plrIP[32];
        GetPlayerIp(playerid, plrIP, sizeof(plrIP));
        format(stringg, sizeof(stringg), "Pais Registrado: %s", PLAYER_INFO[playerid][pPaisRegistro]);
        MensajeAdmin(COLOR_CHEAT, stringg, 3);
        PLAYER_TEMP[playerid][RecienRegistradoTmp] = 1;
    } else {
        SendClientMessage(playerid, COLOR_ORANGE, "Ya hay una cuenta registrada con ese email.");
        SendClientMessage(playerid, COLOR_ORANGE, "Para recuperar tu contraseña, ingresa a http://"    WEB_ROL "/perdida.php");
        ExpulsarJugador(playerid, "Correo en uso");
    }
    return 1;
}

public UsuarioRegistrado(playerid) {
    new Query[512], Pais[30];
    GetPlayerCountry(playerid, Pais, sizeof(Pais));
    mysql_format(handle_db, Query, sizeof(Query), "INSERT INTO `perfiles` (ID, Nombre,Pais_Actual,Avatar,Color,Propietario) VALUES ('%d','%e','%e','32','1','%d')", PLAYER_INFO[playerid][pID], PLAYER_INFO[playerid][Nickname], Pais, PLAYER_INFO[playerid][pID]);
    mysql_tquery(handle_db, Query);
    return 1;
}

GuardarPropiedad(c, Mueble = -1) {
	#if DEBUG_GM == 1
    printf(""SERVER_COIN2 "RP: GuardarPropiedad: %d", c);
    #endif
    new query[1000];
    mysql_format(handle_db, query, sizeof(query), "UPDATE `propiedades` SET `EnVentaPor`='%d',`EnVenta`='%d',`Precio`='%d',`Nivel`='%d',`Ganancias`='%d' WHERE `ID`='%d'", PropInfo[c][pEnVentaPor], PropInfo[c][pEnVenta], PropInfo[c][pPrecio], PropInfo[c][pNivel], PropInfo[c][pGanancias], PropInfo[c][pID]);
    mysql_tquery(handle_db, query);

    mysql_format(handle_db, query, sizeof(query), "UPDATE `propiedades` SET `PosX`='%f',`PosY`='%f',`PosZ`='%f', PosA= '%f',`PosXS`='%f',`PosYS`='%f',`PosZS`='%f' WHERE `ID`='%d'", PropInfo[c][pPosX], PropInfo[c][pPosY], PropInfo[c][pPosZ], PropInfo[c][pPosA], PropInfo[c][pPosXS], PropInfo[c][pPosYS], PropInfo[c][pPosZS], PropInfo[c][pID]);
    mysql_tquery(handle_db, query);

    mysql_format(handle_db, query, sizeof(query), "UPDATE `propiedades` SET `PosAS`='%f',`EnUso`='%d',`Tipo`='%d',`Interior`='%d',`InteriorID`='%d',`Abierta`='%d' WHERE `ID`='%d'", PropInfo[c][pPosAS], PropInfo[c][pEnUso], PropInfo[c][pTipo], PropInfo[c][pInterior], PropInfo[c][pInteriorID], PropInfo[c][pAbierta], PropInfo[c][pID]);
    mysql_tquery(handle_db, query);

    mysql_format(handle_db, query, sizeof(query), "UPDATE `propiedades` SET `Sprunk`='%d',`Cerveza`='%d',`Aquarius`='%d',`Pizzas`='%d',`Vino`='%d',`Baston`='%d' WHERE `ID`='%d'", PropInfo[c][pSprunk], PropInfo[c][pCerveza], PropInfo[c][pAquarius], PropInfo[c][pPizzas], PropInfo[c][pVino], PropInfo[c][pBaston], PropInfo[c][pID]);
    mysql_tquery(handle_db, query);

    mysql_format(handle_db, query, sizeof(query), "UPDATE `propiedades` SET `AK47`='%d',`M4`='%d',`EscopetaNormal`='%d',`EscopetaDeCombate`='%d',`MP5`='%d',`9mm`='%d',`9mmSilenciada`='%d',`PaloDeBillar`='%d' WHERE`ID`='%d'", PropInfo[c][pAK47], PropInfo[c][pM4], PropInfo[c][pEscopetaNormal], PropInfo[c][pEscopetaDeCombate], PropInfo[c][pMP5], PropInfo[c][p9mm], PropInfo[c][p9mmSilenciada], PropInfo[c][pPaloDeBillar], PropInfo[c][pID]);
    mysql_tquery(handle_db, query);

    mysql_format(handle_db, query, sizeof(query), "UPDATE `propiedades` SET `DesertEagle`='%d',`Rifle`='%d',`Granada`='%d',`Manopla`='%d',`Cuchillo`='%d',`Katana`='%d',`Crack`='%d',`Medicamentos`='%d',`Marihuana`='%d',`GranVibradorBlanco`='%d' WHERE `ID`='%d'", PropInfo[c][pDesertEagle], PropInfo[c][pRifle], PropInfo[c][pGranada], PropInfo[c][pManopla], PropInfo[c][pCuchillo], PropInfo[c][pKatana], PropInfo[c][pCrack], PropInfo[c][pMedicamentos], PropInfo[c][pMarihuana], PropInfo[c][pGranVibradorBlanco], PropInfo[c][pID]);
    mysql_tquery(handle_db, query);

    mysql_format(handle_db, query, sizeof(query), "UPDATE `propiedades` SET `Camara`='%d',`Flores`='%d',`Pala`='%d',`BateDeBeisbol`='%d',`PaloDeGolf`='%d',`ConsoladorRosa`='%d',`VibradorBlanco`='%d',`VibradorPlateado`='%d' WHERE `ID`='%d'", PropInfo[c][pCamara], PropInfo[c][pFlores], PropInfo[c][pPala], PropInfo[c][pBateDeBeisbol], PropInfo[c][pPaloDeGolf], PropInfo[c][pConsoladorRosa], PropInfo[c][pVibradorBlanco], PropInfo[c][pVibradorPlateado], PropInfo[c][pID]);
    mysql_tquery(handle_db, query);

    if (Mueble != -1 && Mueble < MAX_OBJETOS_CASAS) {
        format(query, sizeof(query), "UPDATE server_muebles SET `x` = '%f', `y` = '%f', `z` = '%f', `x1` = '%f', `y1` = '%f', `z1` = '%f', `Puesto` = '%d' WHERE `ID` = '%d'",
            PropInfo[c][MuebleX1][Mueble],
            PropInfo[c][MuebleY1][Mueble],
            PropInfo[c][MuebleZ1][Mueble],
            PropInfo[c][MuebleX2][Mueble],
            PropInfo[c][MuebleY2][Mueble],
            PropInfo[c][MuebleZ2][Mueble],
            PropInfo[c][Puesto][Mueble],
            PropInfo[c][MuebleID][Mueble]);
        mysql_tquery(handle_db, query);
    }
    return true;
}
forward OnQueryReceive(data[]);
public OnQueryReceive(data[]) {
    printf("%s", data);
    for(new i = 0; i < strlen(data); i++)
        if (data[i] == '%') data[i] = '#';
    while (strfind(data, "%s", true) != -1) strdel(data, strfind(data, "%s", true), strfind(data, "%s", true) + 2);
    while (strfind(data, "%", true) != -1) strdel(data, strfind(data, "%", true), strfind(data, "%", true) + 2);
    new function [64], fncParams[300];
    printf("Socket data: %s", data);
    sscanf(data, "s[64]s[300]", function, fncParams);
    if(!strcmp(function, "restauro-diagnostico", true)) {
        new npcCount;
        for(new p; p < MAX_PLAYERS; p++) if(IsPlayerConnected(p) && IsPlayerNPC(p)) npcCount++;
        printf("[RESTAURO] Sistemas: NPC=%d Blindado=%d Stats=%d MySQL=%d CompatSultan=%d CompatBravura=%d", npcCount, StatusBlindado, StatsStatus, mysql_errno(handle_db), RP_TuningCompatible(560,1026), RP_TuningCompatible(401,1026));
        return 1;
    }
    if (!strcmp(function, "dar-vip", true)) //dar-vip <Nickname> <VipLevel> <price>
    {
        new playerName[MAX_PLAYER_NAME], vipLevel, pricevip;
        sscanf(fncParams, "s[24]ii", playerName, vipLevel, pricevip);
        new playerid = GetPlayerID(playerName);
        if (playerid == INVALID_PLAYER_ID) return true;
        PLAYER_INFO[playerid][pVip] = vipLevel;
        if (PLAYER_TIMES[playerid][CompraWeb] > 0) return SendClientMessage(playerid, -1, "Espera 10 segundos para volver a comprar.");
        PLAYER_TIMES[playerid][CompraWeb] += 10;
        if (PLAYER_INFO[playerid][Totems] < pricevip) return SendClientMessage(playerid, -1, "Necesitas 30 totems para comprar el vip");
        PLAYER_INFO[playerid][Totems] -= pricevip;

        new Query[256];
        new dia, mes, ano;
        getdate(ano, mes, dia);
        if (mes != 12) {
            mysql_format(handle_db, Query, sizeof(Query), "UPDATE `usuarios` SET `FinDia`='%d',`FinMes`='%d',`FinAno`='%d' WHERE `Username`='%e'", dia, mes + 1, ano, PLAYER_INFO[playerid][Nickname]);
            mysql_tquery(handle_db, Query);
            PLAYER_INFO[playerid][findia] = dia;
            PLAYER_INFO[playerid][finmes] = mes + 1;
            PLAYER_INFO[playerid][finano] = ano;
        }
        if (mes == 12) {
            mysql_format(handle_db, Query, sizeof(Query), "UPDATE `usuarios` SET `FinDia`='%d',`FinMes`='%d',`FinAno`='%d' WHERE `Username`='%e'", dia, mes, ano + 1, PLAYER_INFO[playerid][Nickname]);
            mysql_tquery(handle_db, Query);
            PLAYER_INFO[playerid][findia] = dia;
            PLAYER_INFO[playerid][finmes] = mes;
            PLAYER_INFO[playerid][finano] = ano + 1;
        }
        GuardarCuenta(playerid);
        SendClientMessageEx(playerid, 0xFFFFFFFF, "Ahora tu cuenta tiene una membresía {DBED16}VIP%d{FFFFFF} activa. Precio: %d", vipLevel, pricevip);
        SendClientMessage(playerid, 0xFFFFFFFF, "Para mas informacion, puedes ver la documentacion en el foro o usar el cmd {DBED16}/ayuda vip{FFFFFF}.");
    }
    if (!strcmp(function, "set-vip", true)) //set-vip <Nickname> <VipLevel>
    {
        new playerName[MAX_PLAYER_NAME], vipLevel;
        sscanf(fncParams, "s[24]ii", playerName, vipLevel);
        new playerid = GetPlayerID(playerName);
        if (playerid == INVALID_PLAYER_ID) return true;
        PLAYER_INFO[playerid][pVip] = vipLevel;
        if (PLAYER_TIMES[playerid][CompraWeb] > 0) return SendClientMessage(playerid, -1, "Espera 10 segundos para volver a comprar.");
        PLAYER_TIMES[playerid][CompraWeb] += 10;
        new Query[256];
        new dia, mes, ano;
        getdate(ano, mes, dia);
        if (mes != 12) {
            mysql_format(handle_db, Query, sizeof(Query), "UPDATE `usuarios` SET `FinDia`='%d',`FinMes`='%d',`FinAno`='%d' WHERE `Username`='%e'", dia, mes + 1, ano, PLAYER_INFO[playerid][Nickname]);
            mysql_tquery(handle_db, Query);
            PLAYER_INFO[playerid][findia] = dia;
            PLAYER_INFO[playerid][finmes] = mes + 1;
            PLAYER_INFO[playerid][finano] = ano;
        }
        if (mes == 12) {
            mysql_format(handle_db, Query, sizeof(Query), "UPDATE `usuarios` SET `FinDia`='%d',`FinMes`='%d',`FinAno`='%d' WHERE `Username`='%e'", dia, mes, ano + 1, PLAYER_INFO[playerid][Nickname]);
            mysql_tquery(handle_db, Query);
            PLAYER_INFO[playerid][findia] = dia;
            PLAYER_INFO[playerid][finmes] = mes;
            PLAYER_INFO[playerid][finano] = ano + 1;
        }
        GuardarCuenta(playerid);
        SendClientMessageEx(playerid, 0xFFFFFFFF, "Ahora tu cuenta tiene una membresía {DBED16}VIP%d{FFFFFF} activa.", vipLevel);
        SendClientMessage(playerid, 0xFFFFFFFF, "Para mas informacion, puedes ver la documentacion en el foro o usar el cmd {DBED16}/ayuda vip{FFFFFF}.");
    }
    if (!strcmp(function, "give-car", true)) //give-car <Nickname> <model> <color1> <color2> <cordX> <cordY> <cordZ> <cordA> <precio>
    {
        new playerName[MAX_PLAYER_NAME], model, color1, color2, Float:cordx, Float:cordy, Float:cordz, Float:corda, precio;
        new vmonedaa = 1;
        sscanf(fncParams, "s[24]iiiffffi", playerName, model, color1, color2, cordx, cordy, cordz, corda, precio);
        new playerid = GetPlayerID(playerName);
        if (playerid == INVALID_PLAYER_ID) return true;
        if (PLAYER_TIMES[playerid][CompraWeb] > 0) return SendClientMessage(playerid, -1, "Espera 10 segundos para volver a comprar.");
        if (PLAYER_INFO[playerid][Moneda] < precio) return SendClientMessageEx(playerid, -1, "Necesitas {00ff00}%d"    SERVER_COIN "{ffffff} para comprar este vehículo.", precio);
        PLAYER_TIMES[playerid][CompraWeb] += 10;
        //Check if can have more vehicles
        //Give player vehicle
        WebAuto[playerid] = true;
        SendClientMessageEx(playerid, -1, "Compraste un {FFFF00}%s{ffffff} por {00ff00}%dLZ{ffffff} desde: {FFFF00}"WEB_ROL "", NombreAuto[model - 400], precio);
        CreatePlayerVehicle(playerid, model, cordx, cordy, cordz, corda, color1, color2, precio, vmonedaa, -1);
        PLAYER_INFO[playerid][Moneda] -= precio;
        return true;
    }
    if (!strcmp(function, "tiendadp-car", true)) {
        new playerName[MAX_PLAYER_NAME], model, color1, color2, Float:cordx, Float:cordy, Float:cordz, Float:corda, precio;
        new vmonedaa = 1;
        sscanf(fncParams, "s[24]iiiffffi", playerName, model, color1, color2, cordx, cordy, cordz, corda, precio);
        new playerid = GetPlayerID(playerName);
        if (playerid == INVALID_PLAYER_ID) return true;
        CreatePlayerVehicle2(playerid, model, cordx, cordy, cordz, corda, color1, color2, precio, vmonedaa);
        return true;
    }
    if (!strcmp(function, "correo", true)) //correo <Nickname> 
    {
        new playerName[MAX_PLAYER_NAME];
        sscanf(fncParams, "s[24]", playerName);
        new playerid = GetPlayerID(playerName);
        if (playerid == INVALID_PLAYER_ID) return true;
        if (PLAYER_TIMES[playerid][CompraWeb] > 0) return SendClientMessage(playerid, -1, "Espera 10 segundos para volver a verificar tu correo.");
        PLAYER_TIMES[playerid][CompraWeb] += 10;
        SendClientMessageEx(playerid, -1, "Se ha enviado un correo de verificacion a tu direccion de email {DEED15}%s{ffffff}.", PLAYER_INFO[playerid][pEmail]);
        SendClientMessage(playerid, -1, "En caso de no ver el correo, espera 10 minutos y revisa la bandeja de SPAM.");
        EnviarCorreo(playerid, 0); //plantilla-email-v.php
        return true;
    }
    if (!strcmp(function, "correo-v", true)) //correo-v <Nickname> 
    {
        new playerName[MAX_PLAYER_NAME];
        sscanf(fncParams, "s[24]", playerName);
        new playerid = GetPlayerID(playerName);
        if (playerid == INVALID_PLAYER_ID) return true;
        PLAYER_INFO[playerid][EstadoCorreo] = 1;
        SendClientMessage(playerid, -1, "Correo verificado correctamente.");
        return true;
    }
    if (!strcmp(function, "give-toy", true)) //give-toy <Nickname> <model> <precio>
    {
        new playerName[MAX_PLAYER_NAME], model, precio;
        sscanf(fncParams, "s[24]ii", playerName, model, precio);
        new playerid = GetPlayerID(playerName);
        if (playerid == INVALID_PLAYER_ID) return true;
        if (PLAYER_TIMES[playerid][CompraWeb] > 0) return SendClientMessage(playerid, -1, "Espera 10 segundos para volver a comprar.");
        PLAYER_TIMES[playerid][CompraWeb] += 10;
        if (precio <= 0 || precio > 1000000) return SendClientMessage(playerid, -1, "Precio de prenda invalido.");
        if (CountPlayerToys(playerid) >= MAX_PLAYER_TOYS) return SendClientMessage(playerid, -1, "No puedes tener mas accesorios.");
        if (RP_NexusTotems[playerid] < precio) return SendClientMessageEx(playerid, -1, "Para comprar esta prenda necesitas {FF3300}%d{FFFFFF} Totems.", precio);
        new VALID_MODEL = -1;
        for(new i = 0; i < MAX_PLAYER_TOYS; i++) {
            if (PLAYER_TOYS[playerid][i][pt_MODEL_ID] == model) return SendClientMessageEx(playerid, -1, "Ya tienes un(a) {DEED15}%s{FFFFFF}.", GetNameObjeto(model));
        }
        for(new i = 0; i < (sizeof OBJETOS_INFO); i++) {
            if (OBJETOS_INFO[i][obj_ID] == model) {
                VALID_MODEL = i;
                break;
            }
        }
        if (VALID_MODEL == -1) {
            printf("--ACTUALIZAR 'OBJETOS_INFO' | %d |", model);
            return SendClientMessage(playerid, -1, "{FF6347}El objeto no esta disponible, contacta con un administrador.");
        }
        if (!RP_TotemsSpend(playerid, precio)) return SendClientMessage(playerid, -1, "No tienes suficientes Totems.");
        if (!GivePlayerToy(playerid, model)) {RP_TotemsRefund(playerid, precio);return SendClientMessage(playerid, -1, "No se pudo guardar la prenda. Totems devueltos.");}
        SendClientMessageEx(playerid, -1, "Acabas de comprar un(a) %s. Escribe {DEED15}/prendas{FFFFFF} para ver el menu disponible.", GetNameObjeto(model));
        return true;
    }
    if (!strcmp(function, "save-acc", true)) //save-acc <Nickname>
    {
        new playerName[MAX_PLAYER_NAME];
        sscanf(fncParams, "s[24]", playerName);
        new playerid = GetPlayerID(playerName);
        if (playerid == INVALID_PLAYER_ID) return true;
        GuardarCuenta(playerid);
        return true;
    }
    /*if(!strcmp(function, "color-banda", true)) //color-banda <bandaID> <color> <Nickname>
    {
        new playerName[MAX_PLAYER_NAME], bColor[24], BandaID;
        sscanf(fncParams, "ds[24]s[24]", BandaID, bColor, playerName);
        new playerid = GetPlayerID(playerName);
        if(playerid != INVALID_PLAYER_ID) {
            PLAYER_INFO[playerid][Totems] -= 1;
        }
        BandasInfo[BandaID][BColor2] = HexToInt(bColor);
        format(BandasInfo[BandaID][BColor], 24, bColor);
        new string[128];
        format(string, sizeof string, "[Banda]{00CCFF}%s{FFFFFF} cambio el color de la banda a -> {%s}||||||{FFFFFF},activa tus territorios en /config", playerName, BandasInfo[BandaID][BColor]);
        for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
		{
			if(IsPlayerConnected(i))
			{
				if(PLAYER_INFO[i][pFaccion] > 1)
				{
                    if(PLAYER_INFO[i][pFaccion] == BandaID) SendClientMessage(i, 0xFFFFFFFF, string);
			        if(ShowTerritorio[playerid] == 0) ShowTerritorio[playerid] = 1,ShowTerritorios(playerid);
				    else if(ShowTerritorio[playerid] == 1) ShowTerritorio[playerid] = 0,HideTerritorios(playerid);
                }
			}
        }
    }*/
    if (!strcmp(function, "crear-banda", true)) //crear-banda <Nickname> <BandaID> <Tipo>
    {
        new playerName[MAX_PLAYER_NAME], BandaID, bTipo, baTipo[24], value2;
        sscanf(fncParams, "s[24]iii", playerName, BandaID, bTipo, value2);
        new playerid = GetPlayerID(playerName);
        if (playerid == INVALID_PLAYER_ID) return true;
        if (PLAYER_TIMES[playerid][CompraWeb] > 0) return SendClientMessage(playerid, -1, "Espera 10 segundos para volver a comprar.");
        PLAYER_TIMES[playerid][CompraWeb] += 10;
        PLAYER_INFO[playerid][pFaccion] = BandaID;
        PLAYER_INFO[playerid][pRango] = 8;
        if (bTipo == 1) baTipo = "Pandilla";
        else if (bTipo == 2) baTipo = "Mafia";
        else baTipo = "Organizacion";
        QuitarDinero(playerid, value2);
        MensajeEx(playerid, -1, "Te hemos descontado {00FF00}%s{FFFFFF} por la creacion de tu {DBED16}%s", Numeros(value2), baTipo);
        SendClientMessageEx(playerid, 0xFFFFFFFF, "Felicidades, create una {DBED16}%s{FFFFFF} correctamente!", baTipo);
        GuardarCuenta(playerid);
        SendClientMessage(playerid, 0xFFFFFFFF, "Para conocer mas sobre lo que puedes hacer con tu banda, usa {DBED16}/ayuda bandas{FFFFFF}.");
    }
    if (!strcmp(function, "change-skin", true)) //change-skin <Nickname> <skin_id> <precio>
    {
        new fncName[MAX_PLAYER_NAME], fncValue, playerid, precio;
        sscanf(fncParams, "s[24]ii", fncName, fncValue, precio);
        playerid = GetPlayerID(fncName);
        if (playerid == INVALID_PLAYER_ID) return true;
        if (PLAYER_INFO[playerid][Moneda] < precio) return SendClientMessageEx(playerid, -1, "El precio de la skin es de %dLz y no tienes lo suficiente.", precio);
        if (PLAYER_TIMES[playerid][CompraWeb] > 0) return SendClientMessage(playerid, -1, "Espera 10 segundos para volver a comprar.");
        PLAYER_TIMES[playerid][CompraWeb] += 10;
        PLAYER_INFO[playerid][jRopa] = fncValue;
        SetPlayerSkin(playerid, PLAYER_INFO[playerid][jRopa]);
        SendClientMessage(playerid, -1, "Has cambiado tu {DBED16}skin {FFFFFF}correctamente.");
        PLAYER_INFO[playerid][Moneda] -= precio;
        GuardarCuenta(playerid);
        return true;
    }
    if (!strcmp(function, "send-fz", true)) //send-fz <Nickname> <quantity>
    {
        new fncName[MAX_PLAYER_NAME], fncValue, playerid;
        sscanf(fncParams, "s[24]i", fncName, fncValue);
        playerid = GetPlayerID(fncName);
        if (playerid == INVALID_PLAYER_ID) return true;
        PLAYER_INFO[playerid][Moneda] += fncValue;
        if (PLAYER_TIMES[playerid][CompraWeb] > 0) return SendClientMessage(playerid, -1, "Espera 10 segundos para volver a comprar.");
        PLAYER_TIMES[playerid][CompraWeb] += 10;
        SendClientMessageEx(playerid, 0x00CC00FF, "Acabas de comprar {00ccff}%d "    SERVER_COIN "", fncValue);
        GuardarCuenta(playerid);
        return true;
    }
    if (!strcmp(function, "send-coins", true)) //send-fz <Nickname> <quantity>
    {
        new fncName[MAX_PLAYER_NAME], fncValue, playerid;
        sscanf(fncParams, "s[24]i", fncName, fncValue);
        playerid = GetPlayerID(fncName);
        if (playerid == INVALID_PLAYER_ID) return true;
        PLAYER_INFO[playerid][Totems] += fncValue;
        if (PLAYER_TIMES[playerid][CompraWeb] > 0) return SendClientMessage(playerid, -1, "Espera 10 segundos para volver a comprar.");
        PLAYER_TIMES[playerid][CompraWeb] += 10;
        SendClientMessageEx(playerid, 0x00CC00FF, "Acabas de comprar {00ccff}%d Totems", fncValue);
        GuardarCuenta(playerid);
        return true;
    }
    if (!strcmp(function, "change-rank-name", true)) //change-rank-name <faction> <rank id> <User_Name> <New Rank Name>
    {
        new crewID, rankID, newName[32], olderName[32], changerName[MAX_PLAYER_NAME];
        sscanf(fncParams, "iis[24]s[32]", crewID, rankID, changerName, newName);
        switch (rankID) {
            case 1 : format(olderName, sizeof olderName, BandasInfo[crewID][BRango1]), format(BandasInfo[crewID][BRango1], sizeof olderName, newName);
            case 2 : format(olderName, sizeof olderName, BandasInfo[crewID][BRango2]), format(BandasInfo[crewID][BRango2], sizeof olderName, newName);
            case 3 : format(olderName, sizeof olderName, BandasInfo[crewID][BRango3]), format(BandasInfo[crewID][BRango3], sizeof olderName, newName);
            case 4 : format(olderName, sizeof olderName, BandasInfo[crewID][BRango4]), format(BandasInfo[crewID][BRango4], sizeof olderName, newName);
            case 5 : format(olderName, sizeof olderName, BandasInfo[crewID][BRango5]), format(BandasInfo[crewID][BRango5], sizeof olderName, newName);
            case 6 : format(olderName, sizeof olderName, BandasInfo[crewID][BRango6]), format(BandasInfo[crewID][BRango6], sizeof olderName, newName);
            case 7 : format(olderName, sizeof olderName, BandasInfo[crewID][BRango7]), format(BandasInfo[crewID][BRango7], sizeof olderName, newName);
            case 8 : format(olderName, sizeof olderName, BandasInfo[crewID][BRango8]), format(BandasInfo[crewID][BRango8], sizeof olderName, newName);
        }
        new string[128];
        format(string, sizeof string, "Banda: {00CCFF}%s{FFFFFF} cambio el nombre del rango {DBED15}%s{FFFFFF} a {DBED15}%s{FFFFFF}.", changerName, olderName, newName);
        foreach(new i : Player) {
            if (PLAYER_INFO[i][pFaccion] == crewID) SendClientMessage(i, 0xFFFFFFFF, string);
        }
        return true;
    }
    if (!strcmp(function, "change-user-rank", true)) //change-user-rank 1 1 Who To
    {
        new crewID, newRank, changeName[MAX_PLAYER_NAME], whoChange[MAX_PLAYER_NAME], string[128];
        sscanf(fncParams, "iis[24]s[24]", crewID, newRank, whoChange, changeName);
        if (newRank != 8) {
            format(string, sizeof string, "Banda: {00CCFF}%s{FFFFFF} cambio el rango de {00CCFF}%s{FFFFFF} a {FFFF00}%s{FFFFFF}.", whoChange, changeName);
            foreach(new i : Player) {
                if (PLAYER_INFO[i][pFaccion] == crewID) SendClientMessage(i, 0xFFFFFFFF, string);
            }
            new playerid = GetPlayerID(changeName);
            if (playerid == INVALID_PLAYER_ID) return true;
            PLAYER_INFO[playerid][pRango] = newRank;
        } else {
            format(string, sizeof string, "Banda: {00CCFF}%s{FFFFFF} hizo a {00CCFF}%s{FFFFFF} líder de la banda.", whoChange, changeName);
            foreach(new i : Player) {
                if (PLAYER_INFO[i][pFaccion] == crewID) SendClientMessage(i, 0xFFFFFFFF, string);
            }
            new playerid = GetPlayerID(changeName);
            new whoChangeID = GetPlayerID(whoChange);
            if (playerid != INVALID_PLAYER_ID) PLAYER_INFO[playerid][pRango] = 8;
            if (whoChangeID != INVALID_PLAYER_ID) PLAYER_INFO[whoChangeID][pRango] = newRank;
        }
        return true;
    }
    if (!strcmp(function, "accept-inv", true)) //accept-inv <crewID> <Nick_Name>
    {
        new crewID, whoJoinCrew[MAX_PLAYER_NAME];
        sscanf(fncParams, "is[24]", crewID, whoJoinCrew);
        new playerid = GetPlayerID(whoJoinCrew);
        if (playerid != INVALID_PLAYER_ID) {
            PLAYER_INFO[playerid][pFaccion] = crewID;
            PLAYER_INFO[playerid][pRango] = 1;
            SendClientMessageEx(playerid, 0xFFFFFFFF, "¡Felicitaciones! Te uniste a la banda {DBED15}%s{FFFFFF}.", BandasInfo[crewID][BNombre]);
        }
        new string[128];
        format(string, sizeof string, "El jugador {00CCFF}%s{FFFFFF} se unio a la banda.", whoJoinCrew);
        foreach(new i : Player) {
            if (PLAYER_INFO[i][pFaccion] == crewID) SendClientMessage(i, 0xFFFFFFFF, string);
        }
        return true;
    }
    if (!strcmp(function, "leave-crew", true)) //leave-crew <crew id> <Nick_Name>
    {
        new crewID, whoLeaveCrew[MAX_PLAYER_NAME];
        sscanf(fncParams, "is[24]", crewID, whoLeaveCrew);
        new playerid = GetPlayerID(whoLeaveCrew);
        new string[128];
        printf("Values: %s - %d", whoLeaveCrew, crewID);
        format(string, sizeof string, "El jugador {00CCFF}%s{FFFFFF} abandono la banda.", whoLeaveCrew);
        foreach(new i : Player) {
            if (PLAYER_INFO[i][pFaccion] == crewID) SendClientMessage(i, 0xFFFFFFFF, string);
        }
        if (playerid != INVALID_PLAYER_ID) {
            PLAYER_INFO[playerid][pFaccion] = 0;
            PLAYER_INFO[playerid][pRango] = 0;
        }
        return 1;
    }
    if (!strcmp(function, "kick-member", true)) //kick-member <crewID> <WhoKick> <PlayerKicked>
    {
        new crewID, whoKick[MAX_PLAYER_NAME], kickedPlayer[MAX_PLAYER_NAME];
        sscanf(fncParams, "is[24]s[24]", crewID, whoKick, kickedPlayer);
        new playerid = GetPlayerID(kickedPlayer), string[128];
        if (playerid != INVALID_PLAYER_ID) {
            PLAYER_INFO[playerid][pFaccion] = 0;
            PLAYER_INFO[playerid][pRango] = 0;
            SendClientMessageEx(playerid, 0xFFFFFFFF, "Fuiste expulsado de la banda {00CCFF}%s.", BandasInfo[crewID][BNombre]);
        }
        format(string, sizeof string, "Banda: {00CCFF}%s{FFFFFF} expulso a {DBED15}%s{FFFFFF} de la banda.", whoKick, kickedPlayer);
        foreach(new i : Player) {
            if (PLAYER_INFO[i][pFaccion] == crewID) SendClientMessage(i, 0xFFFFFFFF, string);
        }
        return true;
    }
    /*if(!strcmp(function, "reload-terris", true)) //reload-terris
    {
    	LoadTerritorios();
		return true;
    }*/

    if (!strcmp(function, "reload-crews", true)) //reload-crew
    {
        CargarFacciones();
        return true;
    }
    if (!strcmp(function, "ban-adminpanel", true)) //ban-adminpanel <Admin> <Nombre> <Razon>
    {
        new admin[MAX_PLAYER_NAME], nombre[MAX_PLAYER_NAME], razon[64];
        sscanf(fncParams, "s[24]s[24]s[64]", admin, nombre, razon);
        new playerid = GetPlayerID(nombre);
        if (playerid != INVALID_PLAYER_ID) {
            MensajeAdminEx(ADMIN_LEVEL_BANEOS, 0xFFFFFFFF, "El jugador {FF3300}%s(ID: %d){FFFFFF} fue baneado por un admin. Razon: {FF3300}%s{FFFFFF}.", nombre, playerid, razon);
            if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) SendClientMessageEx(playerid, 0xFFFFFFFF, "El jugador {FF3300}%s(ID: %d){FFFFFF} fue baneado por un admin. Razon: {FF3300}%s{FFFFFF}.", nombre, playerid, razon);
            MensajeAdminEx(ADMIN_LEVEL_BANEOS, 0xAFAFAFAA, "Administrador: %s", admin);
            new query[360];
            PLAYER_INFO[playerid][p_Ban] = 1;
            mysql_format(handle_db, query, sizeof(query), "UPDATE usuarios SET `Baneado`='1',`razon`='%e',`Banpor`='%e' WHERE `ID`='%d'", razon, admin, PLAYER_INFO[playerid][pID]);
            mysql_tquery(handle_db, query);
            ExpulsarJugador(playerid, "Baneo via panel administrativo.");
        }
        return true;
    }
    if (!strcmp(function, "mutear", true)) //mutear <1-3> <jugador> <tiempo> <admin>
    {
        new tipo, jugadornm[MAX_PLAYER_NAME], tiempo, admin[MAX_PLAYER_NAME];
        sscanf(fncParams, "is[24]is[24]", tipo, jugadornm, tiempo, admin);
        new playerid = GetPlayerID(jugadornm);
        if (playerid == INVALID_PLAYER_ID) return true;
        switch (tipo) {
            case 1 :  {
                new string[128];
                format(string, sizeof string, "A %s no se le permite hablar en el chat de ayuda. Razon: Mal uso", jugadornm);
                foreach(new l : Player) {
                    if (IsPlayerConnected(l) && PLAYER_INFO[l][pMuteos] == 1) SendClientMessage(l, 0xAA3333FF, string);
                }
            }
            case 3 : LimpiarLog(150);
        }

        PLAYER_TIMES[playerid][TiempoDuda] = gettime() + (tiempo * 60);
        SendClientMessageEx(playerid, 0xDEA600FF, "No se te permite hablar en el chat de ayuda. Por %d minuto(s)", tiempo);
        SendClientMessageEx(playerid, 0xDEA600FF, "Se te desconto $%d por el muteo.", tiempo);
        QuitarDinero(playerid, -tiempo);
        MensajeAdminEx(ADMIN_LEVEL_BANEOS, 0xAFAFAFAA, "Administrador: %s", admin);
        return true;
    }
    if (!strcmp(function, "jail-player", true)) {
        new razon[48], jugadornm[MAX_PLAYER_NAME], tiempo, admin[MAX_PLAYER_NAME];
        sscanf(fncParams, "s[24]is[24]s[48]", jugadornm, tiempo, admin, razon);
        new playerid = GetPlayerID(jugadornm);
        if (playerid == INVALID_PLAYER_ID) return true;
        if (PLAYER_INFO[playerid][pTiempoJail] > 0) return true;
        new string[128], query[144];
        format(string, sizeof(string), "%s fue sancionado por %s.", jugadornm, razon);
        foreach(new l : Player) {
            if (PlayerConectado(l) && PLAYER_INFO[l][pMuteos] == 1) SendClientMessage(l, 0xAA3333FF, string);
        }
        mysql_format(handle_db, query, sizeof(query), "UPDATE `usuarios` SET `RazonSan`='%e' WHERE `ID`='%d'", razon, PLAYER_INFO[playerid][pID]);
        mysql_tquery(handle_db, query);
        Curando[playerid] = 0;
        Revivir(playerid);
        SetPlayerPos(playerid, 346.870025, 309.259033, 999.155700);
        QuitarArma(playerid, 1);
        PLAYER_INFO[playerid][pCargos] = 0;
        SetPlayerWantedLevelEx(playerid, PLAYER_INFO[playerid][pCargos]);
        SetPlayerColor(playerid, COLORCARGO0);
        SetPlayerInterior(playerid, 6);
        SetPlayerVirtualWorld(playerid, playerid);
        PLAYER_INFO[playerid][sancionado]++;
        PLAYER_INFO[playerid][pTiempoJail] = (tiempo * 60);
        San[playerid] = 1;
        SendClientMessage(playerid, 0xDEA600FF, "Fuiste sancionado por incumplir alguna de las reglas, por favor lee las reglas.");
        SendClientMessage(playerid, 0xDEA600FF, "En el foro se encuentran todas las reglas y una guía de rol que te sera de utilidad.");
        SendClientMessageEx(playerid, 0xDEA600FF, "Fuiste sancionado por %d minutos", tiempo);
        MensajeAdminEx(ADMIN_LEVEL_BANEOS, 0xAFAFAFAA, "Tiempo de sancion: %d minutos, Administrador: %s", tiempo, admin);
        return true;
    }
    return true;
}
public OnQueryFinish() {
    SetTimer("FuncionActionQueue", 5000, false);
    if (cache_num_rows() > 0) {

        new type, queryString[180];
        for(new i = 0; i < cache_num_rows(); i++) {

            cache_get_value_name_int(0, "type", type);
            cache_get_value_name_int(0, "ID", ActionQueue[i][qID]);
            cache_get_value_name_int(0, "faccj", ActionQueue[i][qfaccj]);
            cache_get_value_name_int(0, "status", ActionQueue[i][qstatus]);
            cache_get_value_name_int(0, "TiempoJail", ActionQueue[i][TiempoJailW]);
            cache_get_value_name(0, "user_ses", ActionQueue[i][quser_ses]);
            cache_get_value_name(0, "jugname", ActionQueue[i][qjugname]);
            cache_get_value_name(0, "queue_params", ActionQueue[i][qparams]);
            cache_get_value_name(0, "razon", ActionQueue[i][Razon]);
            cache_get_value_name_int(0, "NRango", ActionQueue[i][TiempoMuteo]);

            if (ActionQueue[i][qID] >= MAX_ACTION_Q) mysql_tquery(handle_db, "TRUNCATE action_queue");

            //printf("Query: type: %d | ID: %d | FaccJ: %d | Status: %d | TiempoJail: %d | UserSes: %s | JugName: %s | queue: %s | razon: %s", type,ActionQueue[i][qID],ActionQueue[i][qfaccj],ActionQueue[i][qstatus],ActionQueue[i][TiempoJailW],ActionQueue[i][quser_ses],ActionQueue[i][qjugname],ActionQueue[i][qparams],ActionQueue[i][Razon]);

            if (ActionQueue[i][qstatus] == 0) {

                new qString[256];
                switch (type) {

                    case 1 :  // Aceptar invitacion
                    {

                        ActionQueue[i][qstatus] = 1;
                        format(qString, sizeof(qString), "jugadorinvitacion %d %s", ActionQueue[i][qfaccj], ActionQueue[i][quser_ses]);
                        CustomProc(qString);
                    }
                    case 2 :  // Cambiar de rango
                    {

                        if (!strcmp(ActionQueue[i][qparams], "nada", true)) {

                            ActionQueue[i][qstatus] = 2;
                        }
                        new gRank;
                        sscanf(ActionQueue[i][qparams], "p<|>d", gRank);
                        format(qString, sizeof(qString), "gMemberRank %d %d %s %s", ActionQueue[i][qfaccj], gRank, ActionQueue[i][quser_ses], ActionQueue[i][qjugname]);
                        CustomProc(qString);
                    }
                    case 3 :  // Expulsar
                    {

                        ActionQueue[i][qstatus] = 1;
                        format(qString, sizeof(qString), "expulsarmiembro %d %s %s", ActionQueue[i][qfaccj], ActionQueue[i][quser_ses], ActionQueue[i][qjugname]);
                        CustomProc(qString);
                    }
                    case 4 :  // Abandonar banda
                    {

                        ActionQueue[i][qstatus] = 1;
                        format(qString, sizeof(qString), "abandonarbanda %d %s", ActionQueue[i][qfaccj], ActionQueue[i][quser_ses]);
                        CustomProc(qString);
                    }
                    case 5 :  // Cargar banda
                    {

                        ActionQueue[i][qstatus] = 1;
                        format(qString, sizeof(qString), "recargarbandas");
                        CustomProc(qString);
                    }
                    case 6 :  // Cambiar nombre rango
                    {

                        ActionQueue[i][qstatus] = 1;
                        format(qString, sizeof(qString), "gRankName %d %s %s %s", ActionQueue[i][qfaccj], ActionQueue[i][quser_ses], ActionQueue[i][qparams], ActionQueue[i][qjugname]);
                        CustomProc(qString);
                    }
                    case 7 :  // Sancion Web
                    {

                        ActionQueue[i][qstatus] = 1;
                        format(qString, sizeof(qString), "sancionar %s %d %s %s", ActionQueue[i][qjugname], ActionQueue[i][TiempoJailW], ActionQueue[i][quser_ses], ActionQueue[i][Razon]);
                        CustomProc(qString);
                    }
                    case 8 :  // Baneo Web
                    {

                        ActionQueue[i][qstatus] = 1;
                        format(qString, sizeof(qString), "ban %s %s %s", ActionQueue[i][qjugname], ActionQueue[i][quser_ses], ActionQueue[i][Razon]);
                        CustomProc(qString);
                    }
                    case 9 :  // Muteo por 10m
                    {

                        ActionQueue[i][qstatus] = 1;
                        format(qString, sizeof(qString), "mut1 %s %s %s %d", ActionQueue[i][qjugname], ActionQueue[i][quser_ses], ActionQueue[i][Razon], ActionQueue[i][TiempoMuteo]);
                        CustomProc(qString);
                    }
                    case 10 :  // Mutear por 10 min sin registro
                    {

                        ActionQueue[i][qstatus] = 1;
                        format(qString, sizeof(qString), "mut2 %s %s %s %d", ActionQueue[i][qjugname], ActionQueue[i][quser_ses], ActionQueue[i][Razon], ActionQueue[i][TiempoMuteo]);
                        CustomProc(qString);
                    }
                    case 11 :  // SPAM Muteo + borrado de chat
                    {

                        ActionQueue[i][qstatus] = 1;
                        format(qString, sizeof(qString), "mut3 %s %s %s %d", ActionQueue[i][qjugname], ActionQueue[i][quser_ses], ActionQueue[i][Razon], ActionQueue[i][TiempoMuteo]);
                        CustomProc(qString);
                    }
                }
                mysql_format(handle_db, queryString, sizeof(queryString), "DELETE FROM `action_queue` WHERE `ID` = '%d'", ActionQueue[i][qID]);
                mysql_tquery(handle_db, queryString);
                //printf("Delete: %s", queryString);
            }
        }
    }
    return 1;
}
