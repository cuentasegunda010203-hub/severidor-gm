        return 1;
	}
	return 0;
}
funcion FuegoSiguiente()
{
    for(new i; i < MAX_INCENDIOS; i++)
	{
        if(!Incendios[i][pIDI])
		{
            return i;
        }
    }
    return -1;
}

funcion DestroyFire(fireid) {
 if(fireid<0 || fireid>=MAX_INCENDIOS || Incendios[fireid][pIDI]<=0) return 0;
 Incendios[fireid][pIDI]=0;Incendios[fireid][pType]=0;Incendios[fireid][pIntensidad]=0;
 for(new k;k<15;k++) {if(IsValidDynamicObject(Incendios[fireid][pObject][k])) DestroyDynamicObject(Incendios[fireid][pObject][k]);Incendios[fireid][pObject][k]=0;}
 if(IsValidDynamic3DTextLabel(Incendios[fireid][pInfoIncendio])) DestroyDynamic3DTextLabel(Incendios[fireid][pInfoIncendio]);
 Incendios[fireid][pInfoIncendio]=Text3D:INVALID_STREAMER_ID;return 1;
}
funcion CercaIncendio(playerid) { return RP_SAFDNearFire(playerid,15.0); }
funcion LIncendios(playerid) { return RP_SAFDFireMenu(playerid,false); }
CMD:apagarincendio(playerid) {
 if(!RP_SAFDReady(playerid)) return SendClientMessage(playerid,-1,"Necesitas pertenecer a Bomberos y estar de servicio.");
 new bool:truck=bool:RP_SAFDTruck(playerid);new f=RP_SAFDNearFire(playerid,truck?15.0:6.0);if(f<0) return SendClientMessage(playerid,-1,"No estas cerca de un incendio.");
 if(Incendios[f][pIntensidad]>0) return callcmd::bomberos(playerid,"extinguir");
 return RP_SAFDComplete(playerid,f,truck);
}
CMD:incendios(playerid)
{
	if (PLAYER_INFO[playerid][pAdmin] >= 3)
	{
		ListaIncendios(playerid);
	} 
	else if(IsABombero(playerid))
	{
		LIncendios(playerid);
	}
	return 1;
}
CMD:llamados(playerid)
{
	if(IsABombero(playerid))
	{
		LIncendios(playerid);
	}
	else return ShowPlayerMessage(playerid,"~r~No perteneces a San Andreas Fire Departament.");
	return 1;
}
funcion ListaIncendios(playerid) { return RP_SAFDFireMenu(playerid,true); }
funcion EstaEnFuego(playerid)
{
    if(GetPlayerVirtualWorld(playerid)!=0 || GetPlayerInterior(playerid)!=0) return 0;
    new Float:vida,Float:pos[3];
    GetPlayerHealth(playerid,vida);
    for(new f;f<MAX_INCENDIOS;f++) {
        if(!RP_SAFDPoint(f,pos)) continue;
        if(IsPlayerInRangeOfPoint(playerid,Incendios[f][pType]==0?2.5:1.5,pos[0],pos[1],pos[2])) EstablecerVida(playerid,vida-2.0);
    }
    return 1;
}
CMD:crearincendio(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < 6) return 1;
    new tipo, propiedad;
    if (sscanf(params, "ii", tipo, propiedad)) return SendClientMessage(playerid, -1, "Usa /crearincendio [0 casa / 1 estacionamiento] [ID]");
    if (tipo < 0 || tipo > 1 || propiedad <= 0) return SendClientMessage(playerid, -1, "Tipo o ID invalido.");
    if (tipo == 0) {
        if (propiedad >= MAX_PROPIEDADES) return SendClientMessage(playerid, -1, "ID de casa fuera del limite.");
        if (!PropInfo[propiedad][pTipo]) return SendClientMessage(playerid, -1, "La casa no existe.");
    } else {
        if (propiedad >= MAX_GARAGES) return SendClientMessage(playerid, -1, "ID de estacionamiento fuera del limite.");
        if (!Estacionamientos[propiedad][eEnUso]) return SendClientMessage(playerid, -1, "El estacionamiento no existe.");
    }
    if (!CrearIncendioP(propiedad, tipo)) return SendClientMessage(playerid, -1, "No se creo el incendio: revisa si ya existe o si se alcanzo el limite.");
    return SendClientMessageEx(playerid, -1, "Creaste un incendio en la propiedad %d (tipo %d).", propiedad, tipo);
}
CMD:crearincendio1(playerid)
{
	if(PLAYER_INFO[playerid][pAdmin] > 6)
	{
		IncendioAleatoreo();
	}
	return 1;
}
