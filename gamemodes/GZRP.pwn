                if (PLAYER_INFO[playerid][jDinero] < 500) return SendClientMessage(playerid, -1, "No tienes el dinero suficiente ({00CC00}$500{FFFFFF}).");
                QuitarDinero(playerid, 500);
                PLAYER_INFO[playerid][pCargos] = 0;
                ActualizarRadar();
                SetPlayerWantedLevelEx(playerid, PLAYER_INFO[playerid][pCargos]);
                SendClientMessage(playerid, -1, "Pagaste la fianza de {00CC00}$500{FFFFFF} y se te quitaron los cargos.");
            }
        }
        case ENTREGARSE2: {
