                            case 7 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                            case 8 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                            case 9 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                            case 10 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                            case 11 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                            case 12 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                            case 13 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                            case 14 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                            case 15 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                            case 16 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                            case 17 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                            case 18 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                            case 19 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                            case 20 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                        }
                    }
                }
            }
        }
    }
    return 1;
}

funcion CarrerasLV() {
    if (CarrerasAviso == 0) {
        foreach(new i : Player) {
            ShowPlayerMessage(i, "~b~~h~["NAME_LARGO "]: ~w~Las carreras en el estadio de Las Venturas comenzaran en ~y~2 minutos~w~.", 10000);
        }
        new texto[120];
        format(texto, sizeof(texto), "Las carreras en el estadio de Las Venturas comenzaran en 8 minutos.");
        Webhook_Canales(0, texto, 4, 0);
        CarrerasAviso = 1;
    }
    return 1;
}


public Quitar1Cargo(playerid) {
    if (PLAYER_INFO[playerid][pCargos] == 1 && CagoSeguro[playerid] == 1) {
        PLAYER_INFO[playerid][pCargos] -= 1;
        if (PLAYER_INFO[playerid][pCargos] == 0) { ActualizarRadar(); }
        SetPlayerWantedLevelEx(playerid, PLAYER_INFO[playerid][pCargos]);
        CagoSeguro[playerid] = 0;
        PUSH(playerid, "Tu nivel de busqueda se redujo.");
    }
    return 1;
}

public Quitar2Cargos(playerid) {
    if (PLAYER_INFO[playerid][pCargos] == 2 && RoboTienda[playerid] == 1) {
        PLAYER_INFO[playerid][pCargos] -= 2;
        if (PLAYER_INFO[playerid][pCargos] == 0) { ActualizarRadar(); }
        SetPlayerWantedLevelEx(playerid, PLAYER_INFO[playerid][pCargos]);
        RoboTienda[playerid] = 0;
        Notificador2(playerid, "La ~b~policia~w~ dejo de buscarte, ahora ~r~puedes robar~w~ otro negocio.");
    }
    return 1;
}
forward ponermueble(muebleid, casaid, slot);
public ponermueble(muebleid, casaid, slot) {
    new insertId = cache_insert_id();
    PropInfo[casaid][MuebleID][slot] = insertId;
    PropInfo[casaid][ModeloMuebles][slot] = muebleid;
}
public OnPlayerModelSelection(playerid, response, listid, modelid) {
    if (listid == comprarmuebles) {
        if (response) {
            new casaid, Casa[200], OBJ_INDEX, query[256];
            BuscarModeIndexInt(modelid, OBJ_INDEX);
            ObtenerCasaID(playerid, casaid);
            if (PLAYER_INFO[playerid][jDinero] < ObjetosInterior[OBJ_INDEX][1]) return SendClientMessageEx(playerid, -1, "Necesitas {ff0000}$%d {ffffff}para comprar este mueble.", ObjetosInterior[OBJ_INDEX][1]);
            if (casaid == -1) return SendClientMessage(playerid, -1, "Debes estar en tu casa para comprar un mueble.");
            new slot = ObtenerSlotMuebleVacio(casaid);
            if (slot == 1000) return SendClientMessage(playerid, -1, "Tu propiedad no puede poseer mas muebles.");
            mysql_format(handle_db, query, sizeof(query), "INSERT INTO server_muebles (CasaID,Modelo) VALUES ('%d','%d')", casaid, modelid);
            mysql_tquery(handle_db, query, "ponermueble", "iii", modelid, casaid, slot);
            format(Casa, sizeof(Casa), "Compraste un(a) ~y~%s ~w~por ~g~$%d ~w~correctamente.", ObjetosInterior[OBJ_INDEX][2], ObjetosInterior[OBJ_INDEX][1]);
            Notificador2(playerid, Casa);
            QuitarDinero(playerid, ObjetosInterior[OBJ_INDEX][1]);
        }
    }
    if (listid == objetos) {
        if (response) {
            new VALID_MODEL = -1;
            if (CountPlayerToys(playerid) >= MAX_PLAYER_TOYS) return SendClientMessage(playerid, -1, "No puedes tener mas accesorios.");
            if (PLAYER_INFO[playerid][Totems] < 25) return SendClientMessage(playerid, -1, "Comprar una prenda cuesta {FF3300}25{FFFFFF} Totems.");

            for(new i = 0; i < MAX_PLAYER_TOYS; i++) {
                if (PLAYER_TOYS[playerid][i][pt_MODEL_ID] == modelid) return SendClientMessageEx(playerid, -1, "Ya tienes un(a) {DEED15}%s{FFFFFF}.", GetNameObjeto(modelid));
            }
            for(new i = 0; i < (sizeof OBJETOS_INFO); i++) {
                if (OBJETOS_INFO[i][obj_ID] == modelid) {
                    VALID_MODEL = i;
                    break;
                }
            }
            if (VALID_MODEL == -1) {
                printf("--ACTUALIZAR 'OBJETOS_INFO' | %d |", modelid);
                return SendClientMessage(playerid, -1, "{FF6347}El objeto no esta disponible, contacta con un administrador.");
            }
            SendClientMessage(playerid, -1, "Acabas de comprar un objeto. Escribe {DEED15}/accesorios{FFFFFF} para ver el menu disponible.");
            GivePlayerToy(playerid, modelid);
            PLAYER_INFO[playerid][Totems] -= 25;
        }
        return 1;
    }
    if (listid == RoadblockList) {
        if (!response) return 1;
        new id = GetFreeObjectID();
        if (id == -1) return SendClientMessage(playerid, COLOR_WHITE, "Se alcanzo el limite de objetos.");
        CopObjectData[id][ObjCreated] = true;
        GetPlayerName(playerid, CopObjectData[id][Owner], MAX_PLAYER_NAME);
        CopObjectData[id][Type] = OBJECT_TYPE_ROADBLOCK;
        CopObjectData[id][ObjModel] = modelid;
        CopObjectData[id][ObjInterior] = GetPlayerInterior(playerid);
        CopObjectData[id][ObjVirtualWorld] = GetPlayerVirtualWorld(playerid);
        new Float: x, Float: y, Float: z, Float: a;
        GetPlayerPos(playerid, x, y, z);
        GetPlayerFacingAngle(playerid, a);
        x += (2.0 * floatsin(-a, degrees));
        y += (2.0 * floatcos(-a, degrees));
        CopObjectData[id][ObjX] = x;
        CopObjectData[id][ObjY] = y;
        CopObjectData[id][ObjZ] = z - 0.25;
        CopObjectData[id][ObjRX] = 0.0;
        CopObjectData[id][ObjRY] = 0.0;
        CopObjectData[id][ObjRZ] = a;
        CopObjectData[id][ObjID] = CreateDynamicObject(modelid, x, y, z - 0.20, 0.0, 0.0, a, CopObjectData[id][ObjVirtualWorld], CopObjectData[id][ObjInterior]);
        CopObjectData[id][ObjArea] = -1;
        new string[96];
        format(string, sizeof(string), "Barricada (ID: %d)\n{FFFFFF}Puesta por %s", id, CopObjectData[id][Owner]);
        CopObjectData[id][ObjLabel] = CreateDynamic3DTextLabel(string, 0x3498DBFF, x, y, z + 1.20, 10.0, _, _, _, CopObjectData[id][ObjVirtualWorld], CopObjectData[id][ObjInterior]);
    }
    if (listid == SignList) {
        if (!response) return 1;
        new id = GetFreeObjectID();
        if (id == -1) return SendClientMessage(playerid, COLOR_WHITE, "Se alcanzo el limite de objetos.");
        CopObjectData[id][ObjCreated] = true;
        GetPlayerName(playerid, CopObjectData[id][Owner], MAX_PLAYER_NAME);
        CopObjectData[id][Type] = OBJECT_TYPE_SIGN;
        CopObjectData[id][ObjModel] = modelid;
        CopObjectData[id][ObjInterior] = GetPlayerInterior(playerid);
        CopObjectData[id][ObjVirtualWorld] = GetPlayerVirtualWorld(playerid);
        new Float: x, Float: y, Float: z, Float: a;
        GetPlayerPos(playerid, x, y, z);
        GetPlayerFacingAngle(playerid, a);
        x += (2.0 * floatsin(-a, degrees));
        y += (2.0 * floatcos(-a, degrees));
        CopObjectData[id][ObjX] = x;
        CopObjectData[id][ObjY] = y;
        CopObjectData[id][ObjZ] = z - 1.25;
        CopObjectData[id][ObjRX] = 0.0;
        CopObjectData[id][ObjRY] = 0.0;
        CopObjectData[id][ObjRZ] = a;
        CopObjectData[id][ObjID] = CreateDynamicObject(modelid, x, y, z - 1.25, 0.0, 0.0, a, CopObjectData[id][ObjVirtualWorld], CopObjectData[id][ObjInterior]);
        CopObjectData[id][ObjArea] = -1;
        new string[96];
        format(string, sizeof(string), "Señal (ID: %d)\n{FFFFFF}Puesta por %s", id, CopObjectData[id][Owner]);
        CopObjectData[id][ObjLabel] = CreateDynamic3DTextLabel(string, 0x3498DBFF, x, y, z + 2.0, 10.0, _, _, _, CopObjectData[id][ObjVirtualWorld], CopObjectData[id][ObjInterior]);
    }
    if (listid == policiahombre || listid == policiamujer) {
        if (response) {

            Frecuencia[playerid] = 1;
            frecuencias[1]++;
            PLAYER_INFO[playerid][pDuty] = 1;
            SendClientMessage(playerid, COLOR_MEGAPHONE, "Te pusiste el uniforme de policia.");
            SetPlayerSkin(playerid, modelid);
            SetPlayerColor(playerid, COLOR_POLICIA);
            PLAYER_INFO[playerid][pModelo] = GetPlayerSkin(playerid);
            RopaMine[playerid] = 0, RopaMedi[playerid] = 0, RopaBasu[playerid] = 0, RopaMeca[playerid] = 0;
        } else return 1;
    }
    if (listid == militarhombre || listid == militarmujer) {
        if (response) {
            if (!RP_MilCanUniform(playerid) || modelid != (PLAYER_INFO[playerid][jSexo] == 2 ? 191 : 287)) return 1;

            Frecuencia[playerid] = 1;
            frecuencias[1]++;
            PLAYER_INFO[playerid][pDuty] = 1;
            SendClientMessage(playerid, COLOR_MEGAPHONE, "Te pusiste el uniforme militar.");
            SetPlayerSkin(playerid, modelid);
            SetPlayerColor(playerid, COLOR_MILITAR);
            PLAYER_INFO[playerid][pModelo] = GetPlayerSkin(playerid);
            RopaMine[playerid] = 0, RopaMedi[playerid] = 0, RopaBasu[playerid] = 0, RopaMeca[playerid] = 0;
        } else return 1;
    }
    if (listid == bomberohombre || listid == bomberomujer) {
        if (response) {
            if(!IsABombero(playerid) || PLAYER_INFO[playerid][suspendido]!=0 || !RP_SAFDUniformPoint(playerid)) return 1;
            Frecuencia[playerid] = 1;
            frecuencias[1]++;
            PLAYER_INFO[playerid][pDuty] = 1;
            SendClientMessage(playerid, COLOR_MEGAPHONE, "Te pusiste el uniforme de bombero.");
            SetPlayerSkin(playerid, modelid);
            SetPlayerColor(playerid, COLOR_BOMBERO);
            ShowPlayerMessage(playerid, "~g~~h~Usa /bomberos equipo en el vestuario o en el camion.");
            PLAYER_INFO[playerid][pModelo] = GetPlayerSkin(playerid);
            RopaMine[playerid] = 0, RopaMedi[playerid] = 0, RopaBasu[playerid] = 0, RopaMeca[playerid] = 0;
        } else return 1;
    }
    if (listid == Helrp) {
        if (response) {
            if (modelid == 447) modelid = 469;
            ComproVehiculoTienda(playerid, modelid);
        } else callcmd::29520965(playerid);
        return 1;
    }
    if (listid == Motosrp) {
        if (response) ComproVehiculoTienda(playerid, modelid);
        else callcmd::29520965(playerid);
        return 1;
    }
    if (listid == vehrp) {
        if (response) ComproVehiculoTienda(playerid, modelid);
        else callcmd::29520965(playerid);
        return 1;
    }
    if (listid == barp) {
        if (response) ComproVehiculoTienda(playerid, modelid);
        else callcmd::29520965(playerid);
        return 1;
    }
    new DB_Query[250];
    if (listid == RopaMujerBZ) {
        if (response) {
            if(PLAYER_INFO[playerid][Moneda]<5) return SendClientMessage(playerid,-1,"Necesitas 5 "SERVER_COIN" para comprar ropa.");
            mysql_format(handle_db, DB_Query, sizeof(DB_Query), "UPDATE `usuarios` SET `Skin`='%d' WHERE `Username`='%s'", modelid, PLAYER_INFO[playerid][Nickname]);
            mysql_tquery(handle_db, DB_Query);
            PLAYER_INFO[playerid][jRopa] = modelid;
            SetPlayerSkin(playerid, PLAYER_INFO[playerid][jRopa]);
            PLAYER_INFO[playerid][Moneda] -= 5;
            SendClientMessage(playerid, -1, "Has comprado una nueva {BBE2FF}ropa{FFFFFF} por {00CC00}5 "SERVER_COIN "");
        }
        return 1;
    }
    if (listid == RopaHombre) {
        if (response) {
            mysql_format(handle_db, DB_Query, sizeof(DB_Query), "UPDATE `usuarios` SET `Skin`='%d' WHERE `Username`='%s'", modelid, PLAYER_INFO[playerid][Nickname]);
            mysql_tquery(handle_db, DB_Query);
            PLAYER_INFO[playerid][jRopa] = modelid;
            SetPlayerSkin(playerid, PLAYER_INFO[playerid][jRopa]);
            SendClientMessage(playerid, -1, "Has comprado una nueva, con un precio de {00CC00}$1500");
            QuitarDinero(playerid, 1500);
        }
        return 1;
    }
    if (listid == RopaMujer) {
        if (response) {
            mysql_format(handle_db, DB_Query, sizeof(DB_Query), "UPDATE `usuarios` SET `Skin`='%d' WHERE `Username`='%s'", modelid, PLAYER_INFO[playerid][Nickname]);
            mysql_tquery(handle_db, DB_Query);
            PLAYER_INFO[playerid][jRopa] = modelid;
            SetPlayerSkin(playerid, PLAYER_INFO[playerid][jRopa]);
            SendClientMessage(playerid, -1, "Has comprado una nueva, con un precio de {00CC00}$1500");
            QuitarDinero(playerid, 1500);
        }
        return 1;
    }
    if (listid == RopaHombreBZ) {
        if (response) {
            if(PLAYER_INFO[playerid][Moneda]<5) return SendClientMessage(playerid,-1,"Necesitas 5 "SERVER_COIN" para comprar ropa.");
            mysql_format(handle_db, DB_Query, sizeof(DB_Query), "UPDATE `usuarios` SET `Skin`='%d' WHERE `Username`='%s'", modelid, PLAYER_INFO[playerid][Nickname]);
            mysql_tquery(handle_db, DB_Query);
            PLAYER_INFO[playerid][jRopa] = modelid;
            SetPlayerSkin(playerid, PLAYER_INFO[playerid][jRopa]);
            PLAYER_INFO[playerid][Moneda] -= 5;
            SendClientMessage(playerid, -1, "Has comprado una nueva {BBE2FF}ropa{FFFFFF} por {00CC00}5 "SERVER_COIN "");
        }
        return 1;
    }
    return 1;
}
stock ReproducirCancionParaTodos(const link[]) {
    foreach(new i : Player) if (IsPlayerConnected(i))
        PlayAudioStreamForPlayer(i, link);
}
stock ResetearEvento() {
    EventoStatus = false;
    NombreEventoDynamic = "Sin configurar";
    foreach(new i : Player) {
        if (JugandoEventoDinamico[i] == true) {
            JugandoEventoDinamico[i] = false;
            if (IsValidVehicle(VehiculoEvento[i])) DestroyVehicleEx(VehiculoEvento[i]);
            SetPosEx(i, BeforeEventX[i], BeforeEventY[i], BeforeEventZ[i], BeforeEventA[i], BeforeEventInt[i], BeforeEventVw[i], 1);
            TipoDeAuto[i] = 0;
            SendClientMessage(i, -1, "El evento finalizo, los administradores daran los respectivos premios a los ganadores.");
        }
    }
    TiempoAnuncioEvento = 0;
    AnunciadoEvento = false;
}

stock StrcatEx(text[], len, const message[], va_args < > ) {
    new out[144];
    va_format(out, sizeof(out), message, va_start < 3 > );
    strcat(text, out, len);
    return true;
}

stock JugadoresEnEvento() {
    new count = 0, string[48];
    foreach(new i : Player) {
        if (JugandoEventoDinamico[i] == true) count++;
    }
    if ((count <= Iter_Count(Player) / 3) || count == 0) {
        format(string, sizeof string, "{00CC00}%d{FFFFFF}", count);
    } else if ((count > Iter_Count(Player) / 3) && count < Iter_Count(Player)) {
        format(string, sizeof string, "{FFA500}%d{FFFFFF}", count);
    } else {
        format(string, sizeof string, "{FF0000}%d{FFFFFF}", count);
    }
    return string;
}
stock MostrarDialogoEvento(playerid) {
    new string[768], status[48];
    switch (EventoStatus) {
        case 0 : status = "{FF0000}Cerrado{FFFFFF}";
        case 1 : status = "{00CC00}Abierto{FFFFFF}";
    }
    format(string, sizeof string, "\
		Opcion\tEstado\n\
		{ffa500}» {FFFFFF}Nombre del evento (maximo 18 letras):\t%s\n\
		{ffa500}» {FFFFFF}Expulsar jugador\n\
		{ffa500}» {FFFFFF}Opciones de vehículos\n\
		{ffa500}» {FFFFFF}Opciones de armas\n\
		{ffa500}» {FFFFFF}Congelar jugadores\n\
		{ffa500}» {FFFFFF}Descongelar jugadores\n\
		{ffa500}» {FFFFFF}Reproducir sonido especial a todos\n\
		{ffa500}» {FFFFFF}Setear punto de aparicion\n\
		{ffa500}» {FFFFFF}Ubicaciones\n\
		{ffa500}» {FFFFFF}Anunciar evento a los jugadores\n\
		{ffa500}» {FFFFFF}Estado del evento:\t%s\n\
		\n \n\
		{ffa500}» {FFFFFF}Cantidad de jugadores:\t(%s/%d)\n\
		{ffa500}» {FFFFFF}Finalizar evento",
        NombreEventoDynamic, status, JugadoresEnEvento(), Iter_Count(Player));
    dialogs_ShowPlayerDialog(playerid, DIALOG_EVENT, DIALOG_STYLE_TABLIST_HEADERS, "{FFA500}Eventos "NAME_LARGO " Roleplay", string, "Seleccionar", "Cerrar");
    return true;
}
AntiFlood_Check(playerid, bool:inc = true) {
    AntiFlood_Data[playerid][floodRate] += inc ? RATE_INC : 0;
    AntiFlood_Data[playerid][floodRate] = AntiFlood_Data[playerid][floodRate] - (GetTickCount() - AntiFlood_Data[playerid][lastCheck]);
    AntiFlood_Data[playerid][lastCheck] = GetTickCount();
    AntiFlood_Data[playerid][floodRate] = AntiFlood_Data[playerid][floodRate] < 0 ? 0 : AntiFlood_Data[playerid][floodRate];

    if (AntiFlood_Data[playerid][floodRate] >= RATE_MAX) {
		#if THRESOLD_ACTION == 1
        Ban(playerid);
		#elseif THRESOLD_ACTION == 2
        SendClientMessage(playerid, 0xFF8C00FF, "Limite de comandos por segundo: 1");
        SetTimerEx("KickXD", 500, 0, "d", playerid);
		#else
        SendClientMessage(playerid, 0xFF8C00FF, "Limite de comandos por segundo: 1");

		#endif

        return false;
    }

    return true;
}
AntiFlood_InitPlayer(playerid) {
    AntiFlood_Data[playerid][lastCheck] = GetTickCount();
    AntiFlood_Data[playerid][floodRate] = 0;
}
stock GetPlayerFPS(playerid) return pFPS[playerid];


stock SCMTA(color, text[]) {
    foreach(new i : Player) {
        if (PLAYER_INFO[i][pMuteos] == 1) return 0;
        SendClientMessage(i, color, text);
    }
    return 1;
}
