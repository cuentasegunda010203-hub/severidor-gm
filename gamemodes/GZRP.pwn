//Sistema discord-connector

/*forward DCC_OnChannelMessage(DCC_Channel:channel, DCC_User:author, const message[]);
public DCC_OnChannelMessage(DCC_Channel:channel, DCC_User:author, const message[])
{
    if (channel != discord_channel_id) { // If channel is not 'samp-server', skip it.
        return 0;
    }

    new bool:is_bot;
    DCC_IsUserBot(author, is_bot); // Check if a bot sends a message, if so, ignore it.
    if (is_bot) {
        return 0;
    }

    new username[33];
    if (!DCC_GetUserName(author, username)) { // Get username of discord user.
        return 0;
    }

    return 1;
}
public DCC_OnMessageCreate(DCC_Message:message){

    new DCC_Channel:channel;

    DCC_GetMessageChannel(message, channel);

    // This if condition checks that if the channel is not the command channel then it will do nothing and return 1 //
    if(channel != discord_channel_id)
        return 1;

    // But before that we need to save who actually sent the message //
    new DCC_User:author;
    DCC_GetMessageAuthor(message, author);

    // We need to check if the author is a bot or not //

    new bool:isBot;
    DCC_IsUserBot(author, isBot);

    // If the author is a bot then nothing will happen //
    if(isBot){
        return 1;
    }


    // Now we will fetch if the author has the required role or not! //
    new bool:hasRole;
    DCC_HasGuildMemberRole(guildName, author, adminRole, hasRole);

    // If the author does not have the role then don't do anything //
   if(!hasRole){
        //DCC_SendChannelMessage(discord_channel_id, "No tienes el rol requerido");
        return 1;
    }

   // Now to actually make a command after all the checks are done //
    new str[32];
    new command[128], params[128];

    DCC_GetMessageContent(message, str); // Storing the entire message of the author in the variable str //

    // Now seperating the command and the params //

    sscanf(str, "s[32]s[128]", command, params);

    // Now we will check the command //




        We will make a command which sends a chat message from discord to the player

    

    if(!strcmp(command, "/chat", true))
	{
        new playerID, _message[128];

        sscanf(params, "us[128]", playerID, _message); // Seperating the playerID and the message //

        if(!IsPlayerConnected(playerID)) return //DCC_SendChannelMessage(channel, "El jugador no esta conectado.");

        SendClientMessage(playerID, -1, _message);
		//DCC_SendChannelMessage(discord_channel_id, "Mensaje enviado correctamente.");
    }
    if(!strcmp(command, "/darmonedas", true))
	{
        new playerID, cantidad;

        sscanf(params, "ud", playerID, cantidad); // Seperating the playerID and the message //

        if(!IsPlayerConnected(playerID)) return //DCC_SendChannelMessage(channel, "El jugador no esta conectado.");

        PLAYER_INFO[playerID][Moneda] += cantidad;
		//DCC_SendChannelMessage(discord_channel_id, "> Monedas entregadas.");
    }
    if(!strcmp(command, "/dartotems", true))
	{
        new playerID, cantidad;

        sscanf(params, "ud", playerID, cantidad); // Seperating the playerID and the message //

        if(!IsPlayerConnected(playerID)) return //DCC_SendChannelMessage(channel, "El jugador no esta conectado.");

        PLAYER_INFO[playerID][Totems] += cantidad;
		//DCC_SendChannelMessage(discord_channel_id, "> Totems entregados.");
    }
    if(!strcmp(command, "/dardinero", true))
	{
        new playerID, cantidad;

        sscanf(params, "ud", playerID, cantidad); // Seperating the playerID and the message //

        if(!IsPlayerConnected(playerID)) return //DCC_SendChannelMessage(channel, "El jugador no esta conectado.");

        DarDinero(playerID,cantidad);
		//DCC_SendChannelMessage(discord_channel_id, "> Dinero entregado.");
    }
    if(!strcmp(command, "/darnivel", true))
	{
        new playerID, cantidad;

        sscanf(params, "ud", playerID, cantidad); // Seperating the playerID and the message //

        if(!IsPlayerConnected(playerID)) return //DCC_SendChannelMessage(channel, "El jugador no esta conectado.");

        PLAYER_INFO[playerID][@Nivel] = cantidad;
		Actualizar(playerID);
		//DCC_SendChannelMessage(discord_channel_id, "> Nivel entregado.");
    }
	if(!strcmp(command, "/noti", true))
	{
        new playerID, _message[128];

        sscanf(params, "us[128]", playerID, _message); // Seperating the playerID and the message //

        if(!IsPlayerConnected(playerID)) return //DCC_SendChannelMessage(channel, "El jugador no esta conectado.");

        ShowPlayerMessage(playerID, _message);
		//DCC_SendChannelMessage(discord_channel_id, "El jugador ha sido notificado.");
    }
