				strreplace(str, "Administrator", "Usuario", true, 0, -1, sizeof(str));
				strreplace(str, "CEO", "Usuario", true, 0, -1, sizeof(str));
				strreplace(str, "Founder", "Usuario", true, 0, -1, sizeof(str));
				SendClientMessage( playerid, COLOR_CHEAT, szFormat[ 1 ] );
				CreatePlayerLabel(playerid, str, COLOR_CHEAT);
