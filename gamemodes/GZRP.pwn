                SetPosEx(playerid, 1372.4722, -1197.9072, 69.5106, 173.6606, 0, PLAYER_INFO[playerid][pID]);
                SendClientMessageEx(playerid, -1, "¡Bienvenido a tu departamento {"            COLOR_GM "}%s!", PLAYER_INFO[playerid][Nickname]);
