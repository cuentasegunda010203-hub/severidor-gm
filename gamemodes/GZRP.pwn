public OnRconLoginAttempt(ip[], password[], success) {
    if (!success) //If the password was incorrect
    {
        new pip[32];
        foreach(new i : Player) //Loop through all players
        {
            if (IsPlayerConnected(i) && JugadorLogeado[i] == 1 && PLAYER_INFO[i][pAdmin] == 0) {
                GetPlayerIp(i, pip, sizeof(pip));
                if (!strcmp(ip, pip, true)) //If a player's IP is the IP that failed the login
                {
                    KickPlayer(i, 0, "Rcon Failed"); //They are now kicked.
                }
            }
        }
    }
    if (success) {
        new pip[32];
        foreach(new i : Player) //Loop through all players
        {
            if (IsPlayerConnected(i) && JugadorLogeado[i] == 1 && PLAYER_INFO[i][pAdmin] == 0) {
                GetPlayerIp(i, pip, sizeof(pip));
                if (!strcmp(ip, pip, true)) //If a player's IP is the IP that failed the login
                {
                    KickPlayer(i, 0, "Rcon Failed"); //They are now kicked.
                }
            }
        }
    }
    return 1;
}
public OnRconCommand(cmd[]) {
    if (!strcmp(cmd, "exit", true)) {
        printf("[warning] Alguien intenta apagar el servidor."); // This will appear to the player who typed the rcon command in the chat in white
        return 1;
    }
    return 0;
}
public OnPlayerConnect(playerid) {
    RB_Car[playerid]=INVALID_VEHICLE_ID; RB_State[playerid]=0; RB_Progress[playerid]=0; RB_MoneyBag[playerid]=0; RB_CargoRaised[playerid]=0; RB_CocaineAccount[playerid]=0;
    if(!IsPlayerNPC(playerid)) { RemoveBuildingForPlayer(playerid,3594,2450.4609,-1890.7813,13.1641,0.25); RemoveBuildingForPlayer(playerid,5232,2472.6563,-1932.0859,23.2188,0.25); }
    HV_ResetPlayer(playerid);
    NX_Reset(playerid);
    RP_NexusTotems[playerid] = 0;
    RP_IAReset(playerid);
    RP_ExtraSkillSession[playerid]++;
    for (new skill = 0; skill < 2; skill++) { RP_ExtraSkillTotal[playerid][skill] = 0; RP_ExtraSkillEvents[playerid][skill] = 0; }
    for (new i = 0; i < 27; i++) MENU_INVENTARIO_BOX[playerid][i] = PlayerText:INVALID_TEXT_DRAW;
    BOX_FONDO_AMARILLo[playerid] = PlayerText:INVALID_TEXT_DRAW;
    INVENTARIO_CLICK_CONFIG[playerid] = PlayerText:INVALID_TEXT_DRAW;
    BOX_ARMA1[playerid] = PlayerText:INVALID_TEXT_DRAW;
    INVENTARIO_CLICK_HABILIDADES[playerid] = PlayerText:INVALID_TEXT_DRAW;
    INVENTARIO_CLICK_ESTADISTICAS[playerid] = PlayerText:INVALID_TEXT_DRAW;
    INVENTARIO_CLICK_CASA1[playerid] = PlayerText:INVALID_TEXT_DRAW;
    INVENTARIO_CLICK_CASA2[playerid] = PlayerText:INVALID_TEXT_DRAW;
    INVENTARIO_CLICK_CASA3[playerid] = PlayerText:INVALID_TEXT_DRAW;
    INVENTARIO_CLICK_AUTO1[playerid] = PlayerText:INVALID_TEXT_DRAW;
    INVENTARIO_CLICK_AUTO2[playerid] = PlayerText:INVALID_TEXT_DRAW;
    INVENTARIO_CLICK_AUTO3[playerid] = PlayerText:INVALID_TEXT_DRAW;
    INVENTARIO_CLICK_AUTO4[playerid] = PlayerText:INVALID_TEXT_DRAW;
    INVENTARIO_CLICK_AUTO5[playerid] = PlayerText:INVALID_TEXT_DRAW;
    INVENTARIO_ARMA_1[playerid] = PlayerText:INVALID_TEXT_DRAW;
    INVENTARIO_ARMA_2[playerid] = PlayerText:INVALID_TEXT_DRAW;
    INVENTARIO_ARMA_3[playerid] = PlayerText:INVALID_TEXT_DRAW;
    INVENTARIO_ARMA_4[playerid] = PlayerText:INVALID_TEXT_DRAW;
    INVENTARIO_ARMA_5[playerid] = PlayerText:INVALID_TEXT_DRAW;
    INVENTARIO_ARMA_6[playerid] = PlayerText:INVALID_TEXT_DRAW;
    INVENTARIO_CONSUMIR_MEDI[playerid] = PlayerText:INVALID_TEXT_DRAW;
    INVENTARIO_CONSUMIR_CRACK[playerid] = PlayerText:INVALID_TEXT_DRAW;
    INVENTARIO_CONSUMIR_PORRO[playerid] = PlayerText:INVALID_TEXT_DRAW;
    INVENTARIO_FUNCION_BOTIQUIN[playerid] = PlayerText:INVALID_TEXT_DRAW;
    INVENTARIO_FUNTION_CHALECO[playerid] = PlayerText:INVALID_TEXT_DRAW;
    RP_ClearWelcome(playerid);
    RP_ClearDeviceNotice(playerid);
    RP_DomClear(playerid);
    RP_SafeCancel(playerid);
    RP_ConstructionTarget[playerid] = -1;
    RP_ConstructionPickup[playerid] = INVALID_STREAMER_ID;
    RP_ConstructionLabel[playerid] = Text3D:INVALID_STREAMER_ID;
    RP_ConstructionIcon[playerid] = INVALID_STREAMER_ID;
    JugadorEnAlbanil[playerid] = 0;
    Mescla[playerid] = 0;
    RP_MineReturnDiablo[playerid] = false;
    RP_ClearInteriorLoading(playerid);
    EnablePlayerCameraTarget(playerid, true);

    			#if DEBUG_GM == 1
    printf("(OnPlayerConnect) PlayerID: %d", playerid);
    			#endif
    GetPlayerIp(playerid, PLAYER_INFO[playerid][IP], 32);
    if (!IsPlayerNPC(playerid)) {
        playerremoves(playerid);
        /*foreach(new i : Player)
        {
        	if(IsPlayerConnected(i) && PLAYER_INFO[i][pAdmin] >= 3 && VerAdmin[i] == 1)
        	{
        		SendDeathMessageToPlayer(i, INVALID_PLAYER_ID, playerid, 200);
        	}
        }*/
        new connecting_ip[32 + 1], string[128];
        GetPlayerIp(playerid, connecting_ip, 32 + 1);
        new num_players_on_ip = GetNumberOfPlayersOnThisIP(connecting_ip);

        if (num_players_on_ip > MAX_CONNECTIONS_FROM_IP) {
            format(string, sizeof(string), "[#Sensei]:{FFFF00} %s{FFFFFF} fue kickeado por el {FF0000}"    SERVER_NAME3 "{FFFFFF}, razon: excedio el límite de conexion por IP", NombreJugador(playerid));
            MensajeAdmin(-1, string, 3);
            BanEx(playerid, "Ban por bots");
            return 1;
        }

        ALM_BackPack(playerid);
        LimpiarCuenta(playerid);
        VerificarIP(playerid);
        Progressbar[playerid][Camionero] = CreatePlayerProgressBar(playerid, 278.000000, 429.000000, 91.500000, 3.200000, 16711935, 100);
        Progressbar[playerid][Cosecha] = CreatePlayerProgressBar(playerid, 278.000000, 429.000000, 91.500000, 3.200000, 16711935, 100);
        Progressbar[playerid][ReparandoBar] = CreatePlayerProgressBar(playerid, 278.000000, 429.000000, 91.500000, 3.200000, 16711935, 100);
        Progressbar[playerid][Picar] = CreatePlayerProgressBar(playerid, 278.000000, 429.000000, 91.500000, 3.200000, 16711935, 100);
        Progressbar[playerid][Revisar] = CreatePlayerProgressBar(playerid, 277.000000, 428.000000, 94.500000, 2.199999, 16711935, 100);
        format(PLAYER_INFO[playerid][Nickname], 25, "%s", PlayerName(playerid));
        PlayerAnticheat[playerid][acDead] = true;
        LoginTimer[playerid] = SetTimerEx("TimerLogin", segundos(SECONDS_TO_LOGIN), 0, "d", playerid);
        LCHAT[playerid] = SetTimerEx("TCHAT", 1000, true, "d", playerid);
        SetTimerEx("TAUDIO", 1000, false, "d", playerid);
        if (IsPlayerConnected(playerid)) {
            new Query[190];
            mysql_format(handle_db, Query, sizeof(Query), "SELECT * FROM `usuarios` WHERE `Username`='%s' LIMIT 1", PLAYER_INFO[playerid][Nickname]);
            mysql_pquery(handle_db, Query, "OnPlayerDataLoaded", "d", playerid);
        }
        gettime(Hora, Minuto);
        SetPlayerTime(playerid, Hora, Minuto);
        LimpiarChat(playerid, 25, 1);
        CrearBarras(playerid);
        CrearHUD(playerid);
        gettime(Hora, Minuto);
        SetPlayerTime(playerid, Hora, Minuto);
		#include "modulos/PlayerTextDrawShow.p"
		return 1;
    }
    return 1;
}

public OnPlayerDisconnect(playerid, reason) {
    GT_EndEdit(playerid);
    if(playerid==RB_NPC) { RB_NPC=INVALID_PLAYER_ID; if(RB_Phase) RB_StopTruck(true); }
    RB_ResetPlayer(playerid,true);
    NX_Reset(playerid);
    RP_IAReset(playerid);
    RP_ClearWelcome(playerid);
    RP_ClearDeviceNotice(playerid);
    RP_DomClear(playerid);
    RP_SafeCancel(playerid);
    RP_ClearInteriorLoading(playerid);
    if (!IsPlayerNPC(playerid)) RP_ClearGuards(playerid);
				#if DEBUG_GM == 1
    printf("(OnPlayerDisconnect) PlayerID: %d | Reason: %d", playerid, reason);
				#endif
    if (IsPlayerNPC(playerid)) {
        new string[32], botName[MAX_PLAYER_NAME];
        switch (reason) {
            case 0:
                format(string, sizeof string, "Timeout (perdio conexion)");
            case 1:
                format(string, sizeof string, "Quiteo por si solo (??)");
            case 2:
                format(string, sizeof string, "El GM lo kickeo");
                default: format(string, sizeof string, "Indefinido (wtf)");
        }

        printf("El NPC ID %d se ha desconectado! Razon: %s", playerid, string);
        GetPlayerName(playerid, botName, sizeof(botName));
        if (!strcmp(botName, ".Motorman1")) ReJoinNPC(4);
        if (!strcmp(botName, ".Motorman2")) ReJoinNPC(1);
        if (!strcmp(botName, ".Motorman3")) ReJoinNPC(2);
        if (!strcmp(botName, ".Motorman4")) ReJoinNPC(3);
        if (!strcmp(botName, ".Sergio")) ReJoinNPC(0);
        if (!strcmp(botName, ".Angelica", true)) {
            DestroyDynamic3DTextLabel(TextBot[0]);
            ReJoinNPC(10);
        }
        if (!strcmp(botName, ".Marcelo", true)) {
            DestroyDynamic3DTextLabel(TextBot[1]);
            KillTimer(TimerTxtMarcelo);
            ReJoinNPC(6);
        }
        if (!strcmp(botName, ".Ignacio", true)) {
            DestroyDynamic3DTextLabel(TextBot[2]);
            ReJoinNPC(12);
        }
        if (!strcmp(botName, ".Alejandro", true)) {
            DestroyDynamic3DTextLabel(TextBot[3]);
            ReJoinNPC(7);
        }
        if (!strcmp(botName, ".Camello1", true)) {
            DestroyDynamic3DTextLabel(TextBot[4]);
            ReJoinNPC(8);
        }
        if (!strcmp(botName, ".HippiePepe", true)) {
            DestroyDynamic3DTextLabel(TextBot[5]);
            ReJoinNPC(9);
        }
        if (!strcmp(botName, ".Hugo", true)) {
            DestroyDynamic3DTextLabel(TextBot[6]);
            ReJoinNPC(13);
        }
        if (!strcmp(botName, ".Mao", true)) {
            DestroyDynamic3DTextLabel(TextBot[7]);
            ReJoinNPC(14);
        }
        if (!strcmp(botName, ".Jorge", true)) {
            DestroyDynamic3DTextLabel(TextBot[8]);
            ReJoinNPC(11);
        }
        if (!strcmp(botName, ".Drogas", true)) {
            ReJoinNPC(15);
        }
    } else {
        if (Noti_Grafiti[playerid] != -1) {
            GoodNoteData[playerid][Noti_Grafiti[playerid]][GOOD_NOTE_TIME_OUT] = 1 + Timestamp();
            KillTimer(GoodNoteData[playerid][Noti_Grafiti[playerid]][GOOD_NOTE_TIMER]);
            GoodNoteData[playerid][Noti_Grafiti[playerid]][GOOD_NOTE_TIMER] = SetTimerEx("DestroyGoodNote", 100, false, "dd", playerid, GoodNoteData[playerid][Noti_Grafiti[playerid]][GOOD_NOTE_ID]);
            Noti_Grafiti[playerid] = -1;
            RemovePlayerMapIcon(playerid, 5);
        }
        if (PLAYER_TEMP[playerid][p_TUNING]) {
            PLAYER_TEMP[playerid][p_TUNING] = false;
            SetVehicleVirtualWorldEx(PLAYER_TEMP[playerid][p_TUNNING_VEHICLE_ID], 0);
            SetPlayerVirtualWorld(playerid, 0);
            SetVehiclePosEx(PLAYER_TEMP[playerid][p_TUNNING_VEHICLE_ID], S_TUNNING);
            SetVehicleZAngle(PLAYER_TEMP[playerid][p_TUNNING_VEHICLE_ID], 267.8575);
        }
        KillTimer(TimerMensaje[playerid]);
        RP_StopConstruction(playerid);
        Constructor[playerid] = 0;
        godmode[playerid] = 0;
        if (DISCOTEC_INFO[d_DJ] == playerid && DISCOTEC_INFO[d_USED]) {
            foreach(new i : Player) {
                if (PLAYER_TEMP[i][p_IN_DISCOTEC] && IsPlayerConnected(i)) {
                    SendClientMessage(i, -1, "El DJ que estaba colocando musica se desconecto.");
                    StopAudioStreamForPlayer(i);
                    PLAYER_TEMP[i][p_IN_DISCOTEC] = false;
                }
            }
            PLAYER_TEMP[playerid][p_IN_DISCOTEC] = false;
            DISCOTEC_INFO[d_USED] = false;
            DISCOTEC_INFO[d_DJ] = -1;
        }
        if (IsPlayerInAnyVehicle(playerid)) {
            new vrID = GetPlayerVehicleID(playerid);
            if (EmisoraEscuchando[vrID] != -1) {
                CabinasOcupadasEmisoras[EmisoraEscuchando[vrID]][2]--;
                Ciclo(i, MAX_CONECTADOS) {

                    if (IsPlayerInVehicle(i, vrID)) {
                        CabinasOcupadasEmisoras[EmisoraEscuchando[vrID]][2]--;
                    }
                }
            }
            EmisoraEscuchando[vrID] = -1;
        }
        PararEmisora(playerid);
        if (Emisoras[playerid][TransEmisora] == 1) {
            CerrarEmisora(Emisoras[playerid][CabinaOcupada]);
            Emisoras[playerid][TransEmisora] = 0;
            Emisoras[playerid][CabinaOcupada] = -1;
        }
        if (rtatrucker[playerid] > 0) {
            rtatrucker[playerid] = 0;
            Chofer[TrailerTruck2[playerid]] = INVALID_PLAYER_ID;
            SetVehicleToRespawn(TrailerTruck2[playerid]);
            SetVehicleToRespawn(TrailerTruck[playerid]);
        }
        new szMessage[200];
        switch (reason) {
            case 0: {
                format(szMessage, sizeof(szMessage), "%s(%d) se desconecto [Timeout/%s]", PLAYER_INFO[playerid][Nickname], playerid, Launcher(playerid));
                ProxDetector(10.0, playerid, szMessage, COLOR_COMBATE, COLOR_COMBATE, COLOR_COMBATE, COLOR_COMBATE, COLOR_COMBATE);
            }
            case 1: {
                format(szMessage, sizeof(szMessage), "%s(%d) se desconecto [/q/%s]", PLAYER_INFO[playerid][Nickname], playerid, Launcher(playerid));
                ProxDetector(10.0, playerid, szMessage, COLOR_COMBATE, COLOR_COMBATE, COLOR_COMBATE, COLOR_COMBATE, COLOR_COMBATE);
            }
            case 2: {
                format(szMessage, sizeof(szMessage), "%s(%d) se desconecto [Baneado o Kickeado/%s]", PLAYER_INFO[playerid][Nickname], playerid, Launcher(playerid));
                ProxDetector(10.0, playerid, szMessage, COLOR_COMBATE, COLOR_COMBATE, COLOR_COMBATE, COLOR_COMBATE, COLOR_COMBATE);
            }
        }
        VerificarParlante(playerid);
        if (Companero[playerid] != INVALID_PLAYER_ID && IsPlayerConnected(Companero[playerid])) {
            RecorridoBasu[Companero[playerid]] = 0;
            PBasura[Companero[playerid]] = 0;
            Companero[Companero[playerid]] = -1;
            DisablePlayerCheckpoint(Companero[playerid]);
            SendClientMessage(Companero[playerid], -1, "Tu compañero se ha marchado y el recorrido fue cancelado.");
        }
        GuardarCuenta(playerid);
        SaveAccount(playerid);
        ConEstado[playerid] = false;
        KillTimer(ResetearYaMostro[playerid]);
        KillTimer(HCurando[playerid]);
        KillTimer(canceltimer[playerid]);
        AutosUsuarios(playerid);
        KillTimer(ResetearYaMostro[playerid]);
        QuitarSombreroH(playerid);
        if (Mats1[playerid] == 1) DarDinero(playerid, 1250);
        if (Mats2[playerid] == 1) DarDinero(playerid, 1250);
        if (Mats3[playerid] == 1) DarDinero(playerid, 6250);
        if (Frecuencia[playerid] == 1) { frecuencias[1] -= 1; }
        if (Frecuencia[playerid] == 2) { frecuencias[2] -= 1; }
        if (Frecuencia[playerid] == 3) { frecuencias[3] -= 1; }
        if (Frecuencia[playerid] == 4) { frecuencias[4] -= 1; }
        if (Frecuencia[playerid] == 5) { frecuencias[5] -= 1; }
        if (Frecuencia[playerid] == 6) { frecuencias[6] -= 1; }
        if (Frecuencia[playerid] == 7) { frecuencias[7] -= 1; }
        if (Frecuencia[playerid] == 8) { frecuencias[8] -= 1; }
        KillTimer(LoginTimer[playerid]);
        KillTimer(TM[playerid]);
        KillTimer(TCV[playerid]);
        KillTimer(TCV2[playerid]);
        KillTimer(BaulPB[playerid]);
        KillTimer(llamadasonido1[playerid]);
        KillTimer(CLlamada[playerid]);
        KillTimer(llamadasonido2[playerid]);
        KillTimer(asd[playerid]);
        KillTimer(asdtren[playerid]);
        if (TieneEncargo[playerid] > 0) CancelarCriminal(playerid);
        if (Specteado[playerid] == 1) {
            foreach(new i : Player) {
                if (SpecJugador[i] == playerid && IsPlayerConnected(i)) {
                    Specteado[i] = INVALID_PLAYER_ID;
                    TogglePlayerSpectating(i, false);
                }
            }
        }
        DestroyPlayerProgressBar(playerid, Progressbar[playerid][Camionero]);
        DestroyPlayerProgressBar(playerid, Progressbar[playerid][Cosecha]);
        DestroyPlayerProgressBar(playerid, Progressbar[playerid][ReparandoBar]);
        DestroyPlayerProgressBar(playerid, Progressbar[playerid][Picar]);
        DestroyPlayerProgressBar(playerid, Progressbar[playerid][Revisar]);
        if (EnCarreras[playerid] > 0) SacarCarrera(playerid, 2);
        TextDrawHideForPlayer(playerid, BoxCarrera[0]);
        TextDrawHideForPlayer(playerid, BoxCarrera[1]);
        TextDrawHideForPlayer(playerid, BoxCarrera[2]);
        TextDrawHideForPlayer(playerid, BoxCarrera[3]);
        PlayerTextDrawHide(playerid, CarreraPosicion[playerid]);
        PlayerTextDrawHide(playerid, CarreraT[playerid][0]);
        PlayerTextDrawHide(playerid, CarreraT[playerid][1]);
        PlayerTextDrawHide(playerid, CarreraT[playerid][2]);
        if (GetPlayerScore(playerid) == 0) return 1;
        new stringo[128];
        for(new i = 0; i < MAX_REPORTS; i++) {
            if (Reports[i][ReportFrom] == playerid) {
                Reports[i][ReportFrom] = INVALID_PLAYER_ID;
                Reports[i][BeingUsed] = 0;
            }
        }
        if (PLAYER_INFO[playerid][pCama] > 0) {
            KillTimer(HCurando[playerid]);
            SendClientMessage(playerid, -1, "Ya te has recuperado completamente, puedes ir a tu casa.");
            switch (PLAYER_INFO[playerid][enHospital]) {
                case 1 :  {
                    CamillaLS[PLAYER_INFO[playerid][pCama]] = 0;
                    PLAYER_INFO[playerid][pCama] = 0;
                }
                case 2 :  {
                    CamillaSF[PLAYER_INFO[playerid][pCama]] = 0;
                    PLAYER_INFO[playerid][pCama] = 0;
                }
                case 3 :  {
                    CamillaLV[PLAYER_INFO[playerid][pCama]] = 0;
                    PLAYER_INFO[playerid][pCama] = 0;
                }
                case 4 :  {
                    CamillaGA[PLAYER_INFO[playerid][pCama]] = 0;
                    PLAYER_INFO[playerid][pCama] = 0;
                }
            }
            PLAYER_INFO[playerid][pCama] = 0;
        }
        DestroyDynamicObject(Transportistas[playerid][Objeto1]);
        Transportistas[playerid][Objeto1] = INVALID_OBJECT_ID;

        DestroyDynamicObject(Transportistas[playerid][Objeto2]);
        Transportistas[playerid][Objeto2] = INVALID_OBJECT_ID;

        DestroyDynamicObject(Transportistas[playerid][Objeto3]);
        Transportistas[playerid][Objeto3] = INVALID_OBJECT_ID;
        new Float:xz, Float:yz, Float:zz;
        GetPlayerPos(playerid, xz, yz, zz);
        foreach(new i : Player) {
            if (IsPlayerInRangeOfPoint(i, 10.0, xz, yz, zz)) {
                if (PLAYER_INFO[i][pAdmin] >= ADMIN_LEVEL_BANEOS && VerAdmin[i] > 0 && IsPlayerConnected(i)) {
                    new adminx[570];
                    format(adminx, sizeof(adminx), "--- %s (ID: %d) se desconecto con la IP: %s", PLAYER_INFO[playerid][Nickname], playerid, PLAYER_TEMP[playerid][voIP]);
                    SendClientMessage(i, -1, adminx);
                }
            }
        }
        if (EnCombate[playerid] == 1) {
            if (reason == 1) {
                if (NoQuitar[playerid] == 0 && PLAYER_INFO[playerid][pDuty] != 1) {
                    QuitarArmas(playerid);
                    format(stringo, 128, "%s(%d) perdio las armas por cerrar el juego en combate.", PLAYER_INFO[playerid][Nickname], playerid);
                    ProxDetector(15.0, playerid, stringo, COLOR_COMBATE, COLOR_COMBATE, COLOR_COMBATE, COLOR_COMBATE, COLOR_COMBATE);
                    KillTimer(TimerCombate[playerid]);
                }
            }
        }
        new nombrefaster[32];
        randomString(nombrefaster, 15);
        format(PLAYER_INFO[playerid][Nickname], 32, "%s", nombrefaster);

        new caller = PLAYER_INFO[playerid][MobileSub];
        if ((IsPlayerConnected(caller) && caller != INVALID_PLAYER_ID)) {
            SendClientMessage(caller, -1, "Colgaron la llamada.");
            finllamada(caller);
            PLAYER_INFO[caller][MobileSub] = INVALID_PLAYER_ID;
            PLAYER_INFO[caller][Mobile] = INVALID_PLAYER_ID;
            SetPlayerSpecialAction(caller, SPECIAL_ACTION_STOPUSECELLPHONE);
            SetPlayerSpecialAction(caller, SPECIAL_ACTION_STOPUSECELLPHONE);
        }
        PLAYER_INFO[playerid][MobileSub] = INVALID_PLAYER_ID;
        PLAYER_INFO[playerid][Mobile] = INVALID_PLAYER_ID;
        if (Manejando[playerid] == 1) {
            DarArmas(playerid);
        }
        for(new i = 1; i <= GetVehiclePoolSize(); i++) {
            if (Chofer[i] == playerid) {
                Chofer[i] = INVALID_PLAYER_ID;
                CamionCargado[i] = 0;
            }
        }
        DisablePlayerCheckpoint(playerid);
        Luces[autos[playerid]] = 0;
        MotorAuto[autos[playerid]] = 0;
        Luces[autos2[playerid]] = 0;
        MotorAuto[autos2[playerid]] = 0;
        Luces[autos3[playerid]] = 0;
        MotorAuto[autos3[playerid]] = 0;
        Luces[autos4[playerid]] = 0;
        MotorAuto[autos4[playerid]] = 0;
        Luces[autos5[playerid]] = 0;
        MotorAuto[autos5[playerid]] = 0;
        AutosUsuarios(playerid);
        if (IsValidDynamicObject(ObjetoTuning2[playerid])) {
            DestroyDynamicObject(ObjetoTuning2[playerid]);
            ObjetoTuning2[playerid] = INVALID_OBJECT_ID;
        }
        LimpiarCuenta(playerid);
    }
    return 1;
}

