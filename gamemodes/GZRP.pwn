CMD:pasar(playerid, params[]) {
    if (!IsPlayerInRangeOfPoint(playerid, 100.0, 1372.4722, -1197.9072, 69.5106) || GetPlayerVirtualWorld(playerid) != PLAYER_INFO[playerid][pID]) return PUSH(playerid, "{FF6347}No estas en tu departamento.");
    new player;
    if (sscanf(params, "d", player)) return SendClientMessage(playerid, -1, "Utiliza {FB6501}/pasar id");
    if (!IsPlayerConnected(player)) return SendClientMessage(playerid, -1, "{FF6347}El jugador no esta conectado.");
    //if(!IsPlayerInRangeOfPoint(player, 5.0, 341.2214,1807.7603,-48.4684) || !IsPlayerInRangeOfPoint(player, 5.0, 1427.5995,-1436.6549,-39.1775)) return SendClientMessage(playerid, -1, "{FF6347}El jugador no se encuentra en el ascensor.");
    if (PLAYER_TEMP[player][PidioTimbre] == 0) return PUSH(playerid, "~r~Error: ~w~Ese jugador no te ha tocado el timbre.");
    SetPosEx(player, 1372.4722, -1197.9072, 69.5106, 173.6606, 0, PLAYER_INFO[playerid][pID]);
    SendClientMessageEx(player, -1, "{37db3f}%s te a invitado a su departamento.", PLAYER_INFO[playerid][Nickname]);
    PLAYER_TEMP[player][PidioTimbre] = 0;
    return 1;
}

CMD:pintar(playerid, params[]) {
    new item[32], autoid;
    if (!sscanf(params, "s[30]", item)) {
        if (strcmp(item, "arma", true) == 0) {
            if (PLAYER_INFO[playerid][pVip] != 3) return SendClientMessage(playerid, -1, "Solo jugadores GVIP pueden hacer esto.");
            new armaM = GetPlayerWeapon(playerid);
            if (!armaM) return SendClientMessage(playerid, -1, "¡No tienes ningun arma en la mano!");
            dialogs_ShowPlayerDialog(playerid, DIALOG_PAINTW, DIALOG_STYLE_LIST, "Pintado de armas", "Army\nVerde\nNaranja\nAzul\nRosa\nGold\nRemover color", "Aceptar", "Cerrar");
            return 1;
        } else if (strcmp(item, "vehiculo", true) == 0) {
            if (PLAYER_INFO[playerid][pVip] != 3) return SendClientMessage(playerid, -1, "Solo jugadores GVIP pueden hacer esto. Pinta tu vehiculo en /web.");
            if (PLAYER_INFO[playerid][Totems] < 4) return SendClientMessage(playerid, -1, "Necesitas tener {00CC00}4 Totems{FFFFFF} para pintar un vehículo.");
            if (!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, "{cecece}Debes estar en un vehiculo para pintarlo");
            autoid = GetPlayerVehicleID(playerid);
            if (autoid == autos[playerid]) {
                new string[300];
                format(string, 300, "{cecece}Coloca el numero del color primario que deseas utilizar en tu vehiculo");
                dialogs_ShowPlayerDialog(playerid, TALLER, DIALOG_STYLE_INPUT, "Color primario", string, "Pintar", "Cancelar");
            } else if (autoid == autos2[playerid]) {
                new string[300];
                format(string, 300, "{cecece}Coloca el numero del color primario que deseas utilizar en tu vehiculo");
                dialogs_ShowPlayerDialog(playerid, TALLER, DIALOG_STYLE_INPUT, "Color primario", string, "Pintar", "Cancelar");
            } else if (autoid == autos3[playerid]) {
                new string[300];
                format(string, 300, "{cecece}Coloca el numero del color primario que deseas utilizar en tu vehiculo");
                dialogs_ShowPlayerDialog(playerid, TALLER, DIALOG_STYLE_INPUT, "Color primario", string, "Pintar", "Cancelar");
            } else if (autoid == autos4[playerid]) {
                new string[300];
                format(string, 300, "{cecece}Coloca el numero del color primario que deseas utilizar en tu vehiculo");
                dialogs_ShowPlayerDialog(playerid, TALLER, DIALOG_STYLE_INPUT, "Color primario", string, "Pintar", "Cancelar");
            } else if (autoid == autos5[playerid]) {
                new string[300];
                format(string, 300, "{cecece}Coloca el numero del color primario que deseas utilizar en tu vehiculo");
                dialogs_ShowPlayerDialog(playerid, TALLER, DIALOG_STYLE_INPUT, "Color primario", string, "Pintar", "Cancelar");
            } else return SendClientMessage(playerid, -1, "{cecece}Debes estar en un vehículo de tu propiedad");
        }
    }
    return 1;
}
CMD:dedicados(playerid, params[]) {
    new string[2500];
    foreach(new i : Player) {
        if (PLAYER_INFO[i][@Nivel] > 8) {
            format(string, sizeof(string), "%s%s", string, NombreJugador(i));
            format(string, sizeof(string), "%s\n", string);
        }
    }
    format(string, sizeof(string), "%s\n", string);
    dialogs_ShowPlayerDialog(playerid, INVENTARIO, DIALOG_STYLE_LIST, "{14F0E4}Usuarios Dedicados", string, "Volver", "");
    return 1;
}
CMD:android(playerid) {
    new string[900], title[50], players;
    foreach(new i : Player) {
        if (JugadorLogeado[i] == 1) {
            if (PLAYER_TEMP[i][IsAndroid] == 1 || IsPlayerMobile(i)) {
                format(string, sizeof(string), "%s%d. %s - Nivel: %d - Horas: %d", string, i, NombreJugador(i), PLAYER_INFO[i][@Nivel], PLAYER_INFO[i][horasjugadas]);
                format(string, sizeof(string), "%s\n", string);
                players++;
            }
        }
    }
    format(title, sizeof(title), "{14F0E4}Usuarios de Android (%d)", players);
    format(string, sizeof(string), "%s\n", string);
    dialogs_ShowPlayerDialog(playerid, INVENTARIO, DIALOG_STYLE_LIST, title, string, "Volver", "");
    return 1;
}
CMD:pc(playerid) {
    new string[900], title[50], players;
    foreach(new i : Player) {
        if (!IsPlayerMobile(i) && JugadorLogeado[i] == 1) {
            format(string, sizeof(string), "%s%d. %s - Nivel: %d - Horas: %d", string, i, NombreJugador(i), PLAYER_INFO[i][@Nivel], PLAYER_INFO[i][horasjugadas]);
            format(string, sizeof(string), "%s\n", string);
            players++;
        }
    }
    format(title, sizeof(title), "{14F0E4}Usuarios de PC (%d)", players);
    format(string, sizeof(string), "%s\n", string);
    dialogs_ShowPlayerDialog(playerid, INVENTARIO, DIALOG_STYLE_LIST, title, string, "Volver", "");
    return 1;
}

CMD:mp(playerid, params[]) {
    new id, msj[128], string[256];
    if (!sscanf(params, "ds[128]", id, msj)) {
        if (IsPlayerConnected(id)) {
            if (PLAYER_INFO[playerid][pAdmin] == 0) {
                if (PLAYER_INFO[id][pAdmin] == 0) return PUSH(playerid, "Solo puedes enviar mensajes a administradores");
                if (AdminDuty[id] == 0) return PUSH(playerid, "Este moderador/administrador no se encuentra en servicio.");
            }
            format(string, 128, "Mensaje de %s(ID:%d) %s", NombreJugador(playerid), playerid, msj);
            SendClientMessage(id, COLOR_MEGAPHONE, string);
            DetectarSPAM(playerid, msj);
            format(string, 128, "Enviado a %s(ID:%d) '%s'", NombreJugador(id), id, msj);
            SendClientMessage(playerid, COLOR_MEGAPHONE, string);
        } else SendClientMessage(playerid, COLOR_GAMEMODE, "No intentes bulnerarnos");
    }
    return 1;
}
CMD:aduty(playerid, params[]) {
    new string[200];
    if (PLAYER_INFO[playerid][pAdmin] <= 1) return false;
    switch (AdminDuty[playerid]) {
        case 0: {
            MostrarVeriAdmin(playerid);
        }
        default: {
            format(string, sizeof(string), "[Administracion] %s(ID: %d) ahora esta fuera de servicio administrativo", PLAYER_INFO[playerid][Nickname], playerid);
            MensajeAdmin(COLOR_CHEAT, string, 2);
            AdminDuty[playerid] = 0;
            SetPlayerColor(playerid, COLOR_WHITE);
        }
    }
    return true;
}
CMD:bienvenido(playerid, params[]) {
    new id, string[256], string2[260];
    if (!sscanf(params, "d", id)) {
        format(string, sizeof(string), "https://a.tumblr.com/tumblr_q9w5dyiy4A1v3gveto1.mp3");
        PlayAudioStreamForPlayer(id, string, 0, 0, 0, 0, 0);
        format(string2, 128, "El administrador %s te ha enviado un bienvenido, ¿que paso?", NombreJugador(playerid));
        SendClientMessage(id, COLOR_MEGAPHONE, string2);
    }
    return 1;
}
CMD:rappel(playerid, params[]) {
    new patrulla = GetPlayerVehicleID(playerid);
    if (!AVION(patrulla) && !HELISAPD(patrulla)) return SendClientMessage(playerid, -1, "Debes estar en un vehiculo aoreo.");
    if (GetPVarInt(playerid, "rappelling") == 1) return SendClientMessage(playerid, COLOR_WHITE, "Ya estas bajando."); {
        GetPlayerHealth(playerid, vidayarmadura[playerid][0]);
        GetPlayerArmour(playerid, vidayarmadura[playerid][1]);
        RemovePlayerFromVehicle(playerid);
        new Float:X, Float:Y, Float:Z, Float:Angle;
        GetPlayerPos(playerid, X, Y, Z);
        SetPlayerPos(playerid, X, Y, Z - 5);
        GetPlayerFacingAngle(playerid, Angle);
        GameTextForPlayerEx(playerid, "~r~Bajando...", 3000, 3);
        rappelactivo[playerid] = 1;
        SendClientMessage(playerid, -1, "Escribe {"    COLOR_GM "}/pararrappel{FFFFFF} o usa la tecla {"    COLOR_GM "}'H'{FFFFFF} para soltarse.");
        //EstablecerVida(playerid, INFINITY_HEALTH);
        SetPVarInt(playerid, "rappelling", 1);
        rapel[1] = CreateDynamicObject(19089, X, Y, Z + 5, 0, 0, Angle);
        rapel[2] = CreateDynamicObject(19089, X, Y, Z + 3, 0, 0, Angle);
        rapel[3] = CreateDynamicObject(19089, X, Y, Z + 1, 0, 0, Angle);
        rapel[4] = CreateDynamicObject(19089, X, Y, Z - 2, 0, 0, Angle);
        rapel[5] = CreateDynamicObject(19089, X, Y, Z - 5, 0, 0, Angle);
        rapel[6] = CreateDynamicObject(19089, X, Y, Z - 7, 0, 0, Angle);
        rapel[7] = CreateDynamicObject(19089, X, Y, Z - 9, 0, 0, Angle);
        rapel[8] = CreateDynamicObject(19089, X, Y, Z - 10, 0, 0, Angle);
        rapel[9] = CreateDynamicObject(19089, X, Y, Z - 12, 0, 0, Angle);
        rapel[10] = CreateDynamicObject(19089, X, Y, Z - 17, 0, 0, Angle);
        rapel[11] = CreateDynamicObject(19089, X, Y, Z - 25, 0, 0, Angle);
        rapel[12] = CreateDynamicObject(19089, X, Y, Z - 28, 0, 0, Angle);
        rapel[13] = CreateDynamicObject(19089, X, Y, Z - 31, 0, 0, Angle);
        rapel[14] = CreateDynamicObject(19089, X, Y, Z - 34, 0, 0, Angle);
        rapel[15] = CreateDynamicObject(19089, X, Y, Z - 38, 0, 0, Angle);
        rapel[16] = CreateDynamicObject(19089, X, Y, Z - 41, 0, 0, Angle);
        rapel[17] = CreateDynamicObject(19089, X, Y, Z - 45, 0, 0, Angle);
        rapel[18] = CreateDynamicObject(19089, X, Y, Z - 49, 0, 0, Angle);
