                SetPosEx(playerid, 1427.5995, -1436.6549, -39.1775, 99.5939, 1, PLAYER_INFO[playerid][pID]);
                SendClientMessageEx(playerid, -1, "¡Bienvenido al garaje {"            COLOR_GM "}%s", PLAYER_INFO[playerid][Nickname]);
                return 1;
            }
            new playeriddepa = g_dialog_select[playerid][listitem];
