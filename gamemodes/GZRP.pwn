                new kquery[200];
                new DiaCambio, MesCambio, AnoCambio;
                getdate(AnoCambio, MesCambio, DiaCambio);
                if (strfind(inputtext, "=", true) != -1 || strfind(inputtext, "¡", true) != -1 || strfind(inputtext, "'", true) != -1 || strfind(inputtext, "`", true) != -1 || strfind(inputtext, ",", true) != -1 || strfind(inputtext, "¡", true) != -1) return SendClientMessage(playerid, -1, "Error.");
                if (!IsCorrectMail(inputtext)) dialogs_ShowPlayerDialog(playerid, DCAMBIAR, DIALOG_STYLE_INPUT, "Modificar e-mail", "Ingresa una direccion de correo valida.", "Cambiar", "Cancelar");
                else {
                    if (PLAYER_INFO[playerid][Moneda] < 30) return SendClientMessage(playerid, -1, "No tienes LZ suficientes.");
                    MesCambio += 1;
                    mysql_format(handle_db, kquery, sizeof(kquery), "UPDATE `usuarios` SET CPendiente='1',FinAnoC='%d',FinMesC='%d',FinDiaC='%d',nuevocorreo='%e' WHERE `Username`=('%e')", AnoCambio, MesCambio, DiaCambio, inputtext, PLAYER_INFO[playerid][Nickname]);
                    mysql_tquery(handle_db, kquery);
                    format(kquery, 200, "En {00CC00}30 dias{FFFFFF} se cambiara el correo a {00CCFF}%s{FFFFFF}, costo {00CC00}30"        SERVER_COIN ".", inputtext);
                    SendClientMessage(playerid, -1, kquery);
                    SendClientMessage(playerid, -1, "El tiempo de espera es por la seguridad de la cuenta.");
