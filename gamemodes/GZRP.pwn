        case 1192 : QuitarDineroTransfender(playerid, 940);
        case 1193 : QuitarDineroTransfender(playerid, 1100);
    }
    new interior = GetPlayerInterior(playerid);
    if (interior == 2 && IsPlayerInRangeOfPoint(playerid, 15.0, 616.7820, -74.815, 997.6350)) return 1; //Loco Low
    if (interior == 3 && IsPlayerInRangeOfPoint(playerid, 15.0, 615.2851, -124.2390, 997.6350)) return 1; //Wheel Arch Angels
    if (interior == 1 && IsPlayerInRangeOfPoint(playerid, 15.0, 617.5380, -1.9900, 1000.6829)) return 1; //Transfender
    new string[250];
    format(string, sizeof(string), "El jugador {FF3300}%s(ID: %d){FFFFFF} fue baneado por el anticheat. Razon: {FF3300}Cheat de vehiculos (4){FFFFFF}.", PLAYER_INFO[playerid][Nickname], playerid, GetVehicleModel(vehicleid));
    foreach(new i : Player) {
        if (PlayerConectado(i) && PLAYER_INFO[i][pMuteos] == 1) SendClientMessage(i, -1, string);
    }
    ExpulsarJugador(playerid, "Posible cheat de tuneo.");
    return 1;
}

function NoPuedenConquistar(playerid) {
    new BandaP = PLAYER_INFO[playerid][pFaccion];
    new tiempo = BandasInfo[BandaP][UltimoAtaque] + 300 - gettime();
    SendClientMessageEx(playerid, COLOR_GAMEMODE, "Aún no pueden conquistar. Te quedan %s para conquistar.", TimeConvertEx(tiempo));
    Notificador2(playerid, "Mejorando tu banda podrías evitar restricciones.", "hud:radar_catalinapink");
    return true;
}

function conquistar(playerid) {
    printf("Conquistar(%s %d)", NombreJugador(playerid), playerid);
    new BandaP = PLAYER_INFO[playerid][pFaccion];
    if (gettime() < BandasInfo[BandaP][UltimoAtaque] + 300 && BandasInfo[BandaP][Mejoras] < 3) return NoPuedenConquistar(playerid);
    if (BandaP > 0) {
        if (gettime() > BandasInfo[BandaP][UltimoAtaque] + MAX_TIEMPO_NUEVO) {
            if (PLAYER_INFO[playerid][pt_LAST_TERRITORY] != INVALID_STREAMER_ID && IsPlayerInDynamicArea(playerid, TerritorioInfo[PLAYER_INFO[playerid][pt_LAST_TERRITORY]][Territorio_Area])) {
                if (TerritorioInfo[PLAYER_INFO[playerid][pt_LAST_TERRITORY]][Territorio_BandaID] != BandaP) {
                    if (!TerritorioInfo[PLAYER_INFO[playerid][pt_LAST_TERRITORY]][Territorio_EnGuerra] && !BandasInfo[BandaP][B_Atacando]) {
                        if (gettime() > TerritorioInfo[PLAYER_INFO[playerid][pt_LAST_TERRITORY]][Territorio_UltimoA] + MAX_TIEMPO_NUEVO) {
                            new attackers_in_area = ContarMiembrosEnTerritorio(BandaP, PLAYER_INFO[playerid][pt_LAST_TERRITORY]);
                            if (attackers_in_area >= 4) ComenzarAtaqueTerritorio(BandaP, PLAYER_INFO[playerid][pt_LAST_TERRITORY], TIEMPO_CONQUISTA / 2), Notificador2(playerid, "Comenzando conquista, dile a tu banda que no salga del territorio");
                            else ShowPlayerMessage(playerid, "Necesitas mínimo 4 miembros de tu banda para conquistar.");
                            printf("%s Intenta conquistar con %d miembros.", PLAYER_INFO[playerid][Nickname], attackers_in_area);
                        } else ShowPlayerMessage(playerid, "~r~El territorio fue conquistado recientemente. Intenta mas tarde.");
                    }
                } else ShowPlayerMessage(playerid, "~r~Este territorio ya pertenece a la banda");
            } else ShowPlayerMessage(playerid, "~r~No estas en un territorio valido.");
        } else NoPuedenConquistar(playerid);
    } else ShowPlayerMessage(playerid, "No tienes banda.");
    return 1;
}
public OnPlayerEditDynamicObject(playerid, STREAMER_TAG_OBJECT:objectid, response, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz) {
    if (objectid) {
        if (GetPVarInt(playerid, "OBJ_ADM")) {
            for(new objeto = 0; objeto < MAX_POBJETOS; objeto++) {
                if (objectid == cObjeto[objeto][pObjeto]) {
                    if (response == EDIT_RESPONSE_FINAL) {
                        cObjeto[objeto][pPosX] = x;
                        cObjeto[objeto][pPosY] = y;
                        cObjeto[objeto][pPosZ] = z;
                        cObjeto[objeto][pPosRX] = rx;
                        cObjeto[objeto][pPosRY] = ry;
                        cObjeto[objeto][pPosRZ] = rz;
                        SetDynamicObjectPos(cObjeto[objeto][pObjeto], x, y, z);
                        SetDynamicObjectRot(cObjeto[objeto][pObjeto], rx, ry, rz);
                        new ID_OBJETO = objeto, string[128];
                        if (cObjeto[ID_OBJETO][pOID] == PORTON_MODEL && cObjeto[ID_OBJETO][pBanda] > 0) {
                            format(string, sizeof(string), "{ffffff}Pulsa {"                        COLOR_GM "}'H' {ffffff}para abrir.\n{ffffff}Porton de {"                        COLOR_GM "}%s", BandasInfo[cObjeto[ID_OBJETO][pBanda]][BNombre]);
                            cObjeto[ID_OBJETO][Label] = CreateDynamic3DTextLabel(string, -1, cObjeto[ID_OBJETO][pPosX], cObjeto[ID_OBJETO][pPosY], cObjeto[ID_OBJETO][pPosZ] - 1.0, 15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid), -1, 100.0);
                        }
                        GuardarMapeosIC();
                        DeletePVar(playerid, "OBJ_ADM");
                        SendClientMessage(playerid, -1, "{00FF00}¡Has creado un objeto exitosamente!");
                    } else if (response == EDIT_RESPONSE_CANCEL) {
                        cObjeto[objeto][pPosX] = x;
                        cObjeto[objeto][pPosY] = y;
                        cObjeto[objeto][pPosZ] = z;
                        cObjeto[objeto][pPosRX] = rx;
                        cObjeto[objeto][pPosRY] = ry;
                        cObjeto[objeto][pPosRZ] = rz;
                        SetDynamicObjectPos(cObjeto[objeto][pObjeto], x, y, z);
                        SetDynamicObjectRot(cObjeto[objeto][pObjeto], rx, ry, rz);
                        GuardarMapeosIC();
                        DeletePVar(playerid, "OBJ_ADM");
                        SendClientMessage(playerid, -1, "{00FF00}¡Has creado un objeto exitosamente!");
                    }
                }
            }
            return 1;
        }
        if (response == EDIT_RESPONSE_FINAL || response == EDIT_RESPONSE_CANCEL) {
            if (GetPVarInt(playerid, "EditandoMuebles")) {
                new casaid;
                new idmueble = GetPVarInt(playerid, "ID_MUEBLE");
                ObtenerCasaID(playerid, casaid);
                if (!IsPlayerInRangeOfPoint(playerid, 3, x, y, z) || GetPlayerVirtualWorld(playerid) == 0) {
                    if (PropInfo[casaid][Puesto][idmueble] > 0) {
                        if (IsValidDynamicObject(PropInfo[casaid][Inmobiliario][idmueble])) DestroyDynamicObject(PropInfo[casaid][Inmobiliario][idmueble]);
                        PropInfo[casaid][Puesto][idmueble] = 0;
                    }
                    DeletePVar(playerid, "EditandoMuebles");
                    DeletePVar(playerid, "ID_MUEBLE");
                    return SendClientMessageEx(playerid, -1, "Debes estar cerca del mueble para hacer esto.");
                }
                PropInfo[casaid][MuebleX1][idmueble] = x;
                PropInfo[casaid][MuebleY1][idmueble] = y;
                PropInfo[casaid][MuebleZ1][idmueble] = z;
                PropInfo[casaid][MuebleX2][idmueble] = rx;
                PropInfo[casaid][MuebleY2][idmueble] = ry;
                PropInfo[casaid][MuebleZ2][idmueble] = rz;
                SetDynamicObjectPos(objectid, PropInfo[casaid][MuebleX1][idmueble], PropInfo[casaid][MuebleY1][idmueble], PropInfo[casaid][MuebleZ1][idmueble]);
                SetDynamicObjectRot(objectid, PropInfo[casaid][MuebleX2][idmueble], PropInfo[casaid][MuebleY2][idmueble], PropInfo[casaid][MuebleZ2][idmueble]);
                GuardarPropiedad(casaid, idmueble);
                DeletePVar(playerid, "EditandoMuebles");
                DeletePVar(playerid, "ID_MUEBLE");
            }
        }

    }
    if (EditingCopObjectID[playerid] != -1) {
        new id = EditingCopObjectID[playerid];
        switch (response) {
            case EDIT_RESPONSE_FINAL: {
                CopObjectData[id][ObjX] = x;
                CopObjectData[id][ObjY] = y;
                CopObjectData[id][ObjZ] = z;
                CopObjectData[id][ObjRX] = rx;
                CopObjectData[id][ObjRY] = ry;
                CopObjectData[id][ObjRZ] = rz;
                SetDynamicObjectPos(objectid, x, y, z);
                SetDynamicObjectRot(objectid, rx, ry, rz);

                Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, CopObjectData[id][ObjLabel], E_STREAMER_X, x);
                Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, CopObjectData[id][ObjLabel], E_STREAMER_Y, y);
                Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, CopObjectData[id][ObjLabel], E_STREAMER_Z, z + zOffsets[CopObjectData[id][Type]]);

                if (IsValidDynamicArea(CopObjectData[id][ObjArea])) {
                    Streamer_SetFloatData(STREAMER_TYPE_AREA, CopObjectData[id][ObjArea], E_STREAMER_X, x);
                    Streamer_SetFloatData(STREAMER_TYPE_AREA, CopObjectData[id][ObjArea], E_STREAMER_Y, y);
                    Streamer_SetFloatData(STREAMER_TYPE_AREA, CopObjectData[id][ObjArea], E_STREAMER_Z, z + zOffsets[CopObjectData[id][Type]]);
                }

                EditingCopObjectID[playerid] = -1;
            }

            case EDIT_RESPONSE_CANCEL: {
                SetDynamicObjectPos(objectid, CopObjectData[id][ObjX], CopObjectData[id][ObjY], CopObjectData[id][ObjZ]);
                SetDynamicObjectRot(objectid, CopObjectData[id][ObjRX], CopObjectData[id][ObjRY], CopObjectData[id][ObjRZ]);
                EditingCopObjectID[playerid] = -1;
            }
        }
    }
    return 1;
}
UpdatePlayerToy(playerid, index) {
    if (!RP_ToySlotValid(playerid, index)) return 0;
    RemovePlayerAttachedObject(playerid, index);
    SendClientMessage(playerid, -1, "{FF6347}ACTUALIZAMOS EL TOY.");
    SetPlayerAttachedObject(playerid, index, PLAYER_TOYS[playerid][index][pt_MODEL_ID],
        PLAYER_TOYS[playerid][index][pt_BONE], PLAYER_TOYS[playerid][index][pt_POS][0],
        PLAYER_TOYS[playerid][index][pt_POS][1], PLAYER_TOYS[playerid][index][pt_POS][2],
        PLAYER_TOYS[playerid][index][pt_ROT][0], PLAYER_TOYS[playerid][index][pt_ROT][1],
        PLAYER_TOYS[playerid][index][pt_ROT][2], PLAYER_TOYS[playerid][index][pt_SCALE][0],
        PLAYER_TOYS[playerid][index][pt_SCALE][1], PLAYER_TOYS[playerid][index][pt_SCALE][2],
        PLAYER_TOYS[playerid][index][player_toy_COLOR_1], PLAYER_TOYS[playerid][index][player_toy_COLOR_2]
    );

    return 1;
}
public OnPlayerEditAttachedObject(playerid, response, index, modelid, boneid, Float:fOffsetX, Float:fOffsetY, Float:fOffsetZ, Float:fRotX, Float:fRotY, Float:fRotZ, Float:fScaleX, Float:fScaleY, Float:fScaleZ) {
    #if DEBUG_GM == 1
    printf("(OnPlayerEditAttachedObject) PlayerID: %d", playerid);
	#endif
    if (!RP_ToySlotValid(playerid, index) || index != PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT]) return 1;
    if (modelid != PLAYER_TOYS[playerid][index][pt_MODEL_ID] || boneid < 1 || boneid > 18) return 1;
    if (response && !RP_ToyTransformValid(fOffsetX, fOffsetY, fOffsetZ, fRotX, fRotY, fRotZ, fScaleX, fScaleY, fScaleZ)) {
        RP_RestoreToy(playerid, index);
        PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT] = -1;
        return SendClientMessage(playerid, -1, "Ajuste no valido. Se conserva la posicion anterior del accesorio.");
    }
    if (response) {
        if (fScaleX >= 1.5 || fScaleY >= 1.5 || fScaleZ >= 1.5) {
            SendClientMessage(playerid, -1, "{FF6347}El tamaño del accesorio es demasiado grande.");
            RemovePlayerAttachedObject(playerid, PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT]);
            if (PLAYER_TOYS[playerid][PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT]][pt_ATTACHED]) {

                new INDEXBON = PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT];
                SetPlayerAttachedObject(playerid, INDEXBON, PLAYER_TOYS[playerid][INDEXBON][pt_MODEL_ID],
                    PLAYER_TOYS[playerid][INDEXBON][pt_BONE], PLAYER_TOYS[playerid][INDEXBON][pt_POS][0],
                    PLAYER_TOYS[playerid][INDEXBON][pt_POS][1], PLAYER_TOYS[playerid][INDEXBON][pt_POS][2],
                    PLAYER_TOYS[playerid][INDEXBON][pt_ROT][0], PLAYER_TOYS[playerid][INDEXBON][pt_ROT][1],
                    PLAYER_TOYS[playerid][INDEXBON][pt_ROT][2], PLAYER_TOYS[playerid][INDEXBON][pt_SCALE][0],
                    PLAYER_TOYS[playerid][INDEXBON][pt_SCALE][1], PLAYER_TOYS[playerid][INDEXBON][pt_SCALE][2],
                    PLAYER_TOYS[playerid][INDEXBON][player_toy_COLOR_1], PLAYER_TOYS[playerid][INDEXBON][player_toy_COLOR_2]);

            }
            return 1;
        }
        if ((fOffsetX >= 0.6 || -0.6 >= fOffsetX) || (fOffsetY >= 0.6 || -0.6 >= fOffsetY) || (fOffsetZ >= 0.6 || -0.6 >= fOffsetZ)) {
            SendClientMessage(playerid, -1, "La posicion del objeto esta demasiado lejos de ti.");

            RemovePlayerAttachedObject(playerid, PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT]);
            if (PLAYER_TOYS[playerid][PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT]][pt_ATTACHED]) {
                new INDEXBON = PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT];
                SetPlayerAttachedObject(playerid, INDEXBON, PLAYER_TOYS[playerid][INDEXBON][pt_MODEL_ID],
                    PLAYER_TOYS[playerid][INDEXBON][pt_BONE], PLAYER_TOYS[playerid][INDEXBON][pt_POS][0],
                    PLAYER_TOYS[playerid][INDEXBON][pt_POS][1], PLAYER_TOYS[playerid][INDEXBON][pt_POS][2],
                    PLAYER_TOYS[playerid][INDEXBON][pt_ROT][0], PLAYER_TOYS[playerid][INDEXBON][pt_ROT][1],
                    PLAYER_TOYS[playerid][INDEXBON][pt_ROT][2], PLAYER_TOYS[playerid][INDEXBON][pt_SCALE][0],
                    PLAYER_TOYS[playerid][INDEXBON][pt_SCALE][1], PLAYER_TOYS[playerid][INDEXBON][pt_SCALE][2],
                    PLAYER_TOYS[playerid][INDEXBON][player_toy_COLOR_1], PLAYER_TOYS[playerid][INDEXBON][player_toy_COLOR_2]);
            }
            return 1;
        }
        PLAYER_TOYS[playerid][PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT]][pt_POS][0] = fOffsetX;
        PLAYER_TOYS[playerid][PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT]][pt_POS][1] = fOffsetY;
        PLAYER_TOYS[playerid][PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT]][pt_POS][2] = fOffsetZ;
        PLAYER_TOYS[playerid][PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT]][pt_ROT][0] = fRotX;
        PLAYER_TOYS[playerid][PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT]][pt_ROT][1] = fRotY;
        PLAYER_TOYS[playerid][PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT]][pt_ROT][2] = fRotZ;

        PLAYER_TOYS[playerid][PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT]][pt_SCALE][0] = fScaleX;
        PLAYER_TOYS[playerid][PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT]][pt_SCALE][1] = fScaleY;
        PLAYER_TOYS[playerid][PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT]][pt_SCALE][2] = fScaleZ;

        if (!PLAYER_TOYS[playerid][PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT]][pt_ATTACHED]) PLAYER_TOYS[playerid][PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT]][pt_ATTACHED] = true;

        new INDEXBON = PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT];
        SetPlayerAttachedObject(playerid, INDEXBON, PLAYER_TOYS[playerid][INDEXBON][pt_MODEL_ID],
            PLAYER_TOYS[playerid][INDEXBON][pt_BONE], PLAYER_TOYS[playerid][INDEXBON][pt_POS][0],
            PLAYER_TOYS[playerid][INDEXBON][pt_POS][1], PLAYER_TOYS[playerid][INDEXBON][pt_POS][2],
            PLAYER_TOYS[playerid][INDEXBON][pt_ROT][0], PLAYER_TOYS[playerid][INDEXBON][pt_ROT][1],
            PLAYER_TOYS[playerid][INDEXBON][pt_ROT][2], PLAYER_TOYS[playerid][INDEXBON][pt_SCALE][0],
            PLAYER_TOYS[playerid][INDEXBON][pt_SCALE][1], PLAYER_TOYS[playerid][INDEXBON][pt_SCALE][2],
            PLAYER_TOYS[playerid][INDEXBON][player_toy_COLOR_1], PLAYER_TOYS[playerid][INDEXBON][player_toy_COLOR_2]);
        SavePlayerToys(playerid);
        SendClientMessage(playerid, -1, "Finalizaste de editar este objeto. Escribe {009EFF}/accesorios{FFFFFF} si quieres editar otro objeto.");
        PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT] = -1;
    } else {
        RemovePlayerAttachedObject(playerid, PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT]);
        if (PLAYER_TOYS[playerid][PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT]][pt_ATTACHED]) {
            new INDEXBON = PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT];
            SetPlayerAttachedObject(playerid, INDEXBON, PLAYER_TOYS[playerid][INDEXBON][pt_MODEL_ID],
                PLAYER_TOYS[playerid][INDEXBON][pt_BONE], PLAYER_TOYS[playerid][INDEXBON][pt_POS][0],
                PLAYER_TOYS[playerid][INDEXBON][pt_POS][1], PLAYER_TOYS[playerid][INDEXBON][pt_POS][2],
                PLAYER_TOYS[playerid][INDEXBON][pt_ROT][0], PLAYER_TOYS[playerid][INDEXBON][pt_ROT][1],
                PLAYER_TOYS[playerid][INDEXBON][pt_ROT][2], PLAYER_TOYS[playerid][INDEXBON][pt_SCALE][0],
                PLAYER_TOYS[playerid][INDEXBON][pt_SCALE][1], PLAYER_TOYS[playerid][INDEXBON][pt_SCALE][2],
                PLAYER_TOYS[playerid][INDEXBON][player_toy_COLOR_1], PLAYER_TOYS[playerid][INDEXBON][player_toy_COLOR_2]);
            SendClientMessage(playerid, -1, "{CCCCCC}Has cancelado la edicion de tu accesorio.");
            PLAYER_TEMP[playerid][p_SELECTED_TOY_SLOT] = -1;
        }
    }
    return 1;
}
public Cargar2AutosxD(playerid) {
    if (IsPlayerConnected(playerid)) {
        printf("Cargar2AutosxD (%d)", playerid);
        if (PLAYER_INFO[playerid][vModelo] > 0 || PLAYER_INFO[playerid][vModelo2] > 0 || PLAYER_INFO[playerid][vModelo3] > 0 || PLAYER_INFO[playerid][vModelo4] > 0 || PLAYER_INFO[playerid][vModelo5] > 0) SetTimerEx("Autos", 1500, false, "d", playerid);
    }
}
public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[]) {
    if(dialogid==RB_HELP_DIALOG) {
        if(response) {
            if(RB_HelpPage[playerid]<2) return RB_Help(playerid,RB_HelpPage[playerid]+1);
            return callcmd::ayuda(playerid,"");
        }
        if(RB_HelpPage[playerid]==1) return RB_Help(playerid,0);
        return 1;
    }
    if(RB_MarketResponse(playerid,dialogid,response,listitem,inputtext)) return 1;
    if(GT_Dialog(playerid,dialogid,response,listitem)) return 1;
    if(HP_Dialog(playerid,dialogid,response,listitem)) return 1;
    if(MC_Dialog(playerid,dialogid,response,listitem)) return 1;
    if(NX_DialogResponse(playerid,dialogid,response,listitem)) return 1;
    if (RP_EcoIntercept(playerid,dialogid,response,listitem,inputtext)) return 1;
    if (RP_IADialog(playerid, dialogid, response, listitem, inputtext)) return 1;
    if (RP_GuardDialog(playerid, dialogid, response, listitem, inputtext)) return 1;
    if (RP_LGDialog(playerid, dialogid, response, listitem, inputtext)) return 1;
	  #if DEBUG_GM == 1
    printf("(OnDialogResponse) PlayerID: %d | DialogID: %d | Response: %d | ListItem: %d", playerid, dialogid, response, listitem);
	  #endif
    if(!RP_EcoLegacyMode(playerid) && dl_playerDialogID[playerid] == -1 && PLAYER_TEMP[playerid][UltDialog] == dialogid && !IsPlayerMobile(playerid)) return KickPlayer(playerid, 0, "Dialog Flood");
    PLAYER_TEMP[playerid][UltDialog] = dialogid;
    dl_playerDialogID[playerid] = -1;
    if (dialogid != LOGIN) for(new i = 0; i < strlen(inputtext); i++) if (inputtext[i] == '%') inputtext[i] = '#';
    while (dialogid != LOGIN && strfind(inputtext, "%s", true) != -1) strdel(inputtext, strfind(inputtext, "%s", true), strfind(inputtext, "%s", true) + 2);
    while (dialogid != LOGIN && strfind(inputtext, "%", true) != -1) strdel(inputtext, strfind(inputtext, "%", true), strfind(inputtext, "%", true) + 2);
    new string[1500];
    new Query[800];
    new pName[50];
    GetPlayerName(playerid, pName, 50);
    new Coche;
    Coche = GetPlayerVehicleID(playerid);
    if(dialogid >= Tuning && dialogid <= Tuning + 6 && GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
    if (dialogid == Tuning) {
        if (response) {
            if (listitem == 0) {
                dialogs_ShowPlayerDialog(playerid, Tuning + 1, DIALOG_STYLE_LIST, "Ruedas", "Estilo 1 \nEstilo 2 \nEstilo 3 \nEstilo 4 \nEstilo 5 \nEstilo 6 \nEstilo 7 \nEstilo 8 \nEstilo 9 \nEstilo 10 \nEstilo 11 \nEstilo 12 \nEstilo 13", "Cambiar", "Atras");
            }
            if (listitem == 1) {
                dialogs_ShowPlayerDialog(playerid, Tuning + 2, DIALOG_STYLE_LIST, "Colores", "Negro \nBlanco \nAzul Oscuro \nCeleste \nVerde \nRojo \nAmarillo \nRosado \nCafe \nVerde Agua \nMorado  \nGris \nLila \nRojo Oscuro \nVerde Oscuro", "Pintar", "Atras");
            }
            if (listitem == 2) {
                RP_ShowPaintjobs(playerid);
            }
            if (listitem == 3) {
                dialogs_ShowPlayerDialog(playerid, Tuning + 4, DIALOG_STYLE_LIST, "Nitro", "Nitro x2 \nNitro x5 \nNitro x10", "Agregar", "Atras");
            }
            if (listitem == 4) {
                RP_AddTuningComponent(playerid, Coche, 1087);
            }
            if (listitem == 5) {
                RP_ShowTuningParts(playerid, 5);
            }
            if (listitem == 6) {
                RP_ShowTuningParts(playerid, 6);
            }
            if (listitem == 7) {
                RepairVehicle(Coche);
                PlayerPlaySound(playerid, 1083, 0.0, 0.0, 0.0);
            }
            if (listitem == 8) {
                new Query1[256], color_1, color_2;
                if (IsPlayerInVehicle(playerid, autos[playerid])) {
                    GetVehicleColor(autos[playerid], color_1, color_2);
                    PLAYER_INFO[playerid][vColor1] = color_1;
                    PLAYER_INFO[playerid][vColor2] = color_2;
                    PLAYER_INFO[playerid][vComponentes0] = GetVehicleComponentInSlot(autos[playerid], 0);
                    PLAYER_INFO[playerid][vComponentes1] = GetVehicleComponentInSlot(autos[playerid], 1);
                    PLAYER_INFO[playerid][vComponentes2] = GetVehicleComponentInSlot(autos[playerid], 2);
                    PLAYER_INFO[playerid][vComponentes3] = GetVehicleComponentInSlot(autos[playerid], 3);
                    PLAYER_INFO[playerid][vComponentes4] = GetVehicleComponentInSlot(autos[playerid], 4);
                    PLAYER_INFO[playerid][vComponentes5] = GetVehicleComponentInSlot(autos[playerid], 5);
                    PLAYER_INFO[playerid][vComponentes6] = GetVehicleComponentInSlot(autos[playerid], 6);
                    PLAYER_INFO[playerid][vComponentes7] = GetVehicleComponentInSlot(autos[playerid], 7);
                    PLAYER_INFO[playerid][vComponentes8] = GetVehicleComponentInSlot(autos[playerid], 8);
                    PLAYER_INFO[playerid][vComponentes9] = GetVehicleComponentInSlot(autos[playerid], 9);
                    PLAYER_INFO[playerid][vComponentes10] = GetVehicleComponentInSlot(autos[playerid], 10);
                    PLAYER_INFO[playerid][vComponentes11] = GetVehicleComponentInSlot(autos[playerid], 11);
                    PLAYER_INFO[playerid][vComponentes12] = GetVehicleComponentInSlot(autos[playerid], 12);
                    PLAYER_INFO[playerid][vComponentes13] = GetVehicleComponentInSlot(autos[playerid], 13);
