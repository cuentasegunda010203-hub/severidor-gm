stock GetPlayer2DZone(playerid, zone[], len) {
    new Float: x, Float: y, Float: z;
    GetPlayerPos(playerid, x, y, z);
    for(new i = 0; i != sizeof(NombreZona); i++) {
        if(x >= NombreZona[i][sz_Area][0] && x <= NombreZona[i][sz_Area][3] && y >= NombreZona[i][sz_Area][1] && y <= NombreZona[i][sz_Area][4]) {
            return format(zone, len, NombreZona[i][sz_Nombre], 0);
        }
    }
    return 0;
}
stock Get2DZone(const zone[], len, Float: x, Float: y, Float: z) {
    #pragma unused z
    for (new i = 0; i != sizeof(NombreZona); i++) {
        if (x >= NombreZona[i][sz_Area][0] && x <= NombreZona[i][sz_Area][3] && y >= NombreZona[i][sz_Area][1] && y <= NombreZona[i][sz_Area][4]) {
            return format(zone, len, NombreZona[i][sz_Nombre]);
        }
    }
    return format(zone, len, "San Andreas");
}
stock IsABombero(playerid)
{
	if(PLAYER_INFO[playerid][pFaccion] == 3) return 1;
	return 0;
}

funcion IncendioAleatoreo() { return RP_SAFDRandomFire(); }
funcion CrearIncendioP(houseid, tipo)
{
    if (houseid <= 0 || tipo < 0 || tipo > 1) return 0;
    if (tipo == 0) {
        if (houseid >= MAX_PROPIEDADES) return 0;
        if (!PropInfo[houseid][pTipo]) return 0;
    } else {
        if (houseid >= MAX_GARAGES) return 0;
        if (!Estacionamientos[houseid][eEnUso]) return 0;
    }
	new a = FuegoSiguiente();
	if(a == -1) return 0;
	new intensidad = random(40)+10;
    RP_SAFDNewFire(a);
	for(new c = 0; c < MAX_INCENDIOS;c++)
	{
	    if(Incendios[c][pIDI] == houseid && Incendios[c][pType] == tipo) return 0;
	}
	if(tipo == 0)
	{
		new string[70];
		format(string, sizeof(string), "\n\n{ff4000}Incendio\n{ffc100}Intensidad: {ffffff}%d%%", intensidad);
 		Incendios[a][pInfoIncendio] = CreateDynamic3DTextLabel(string, -1, PropInfo[houseid][pPosX], PropInfo[houseid][pPosY], PropInfo[houseid][pPosZ] + 0.5, 8.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);
	    Incendios[a][pType] = 0;
		Incendios[a][pIntensidad] = intensidad;
        Incendios[a][pIDI] = houseid;
        Incendios[a][pObject][14] = CreateDynamicObject(18691, PropInfo[houseid][pPosX], PropInfo[houseid][pPosY], PropInfo[houseid][pPosZ], 0.0, 0.0, 0.0, -1, -1, -1, MAX_RADIO_STREAM);
        Incendios[a][pObject][13] = CreateDynamicObject(18691, PropInfo[houseid][pPosX], PropInfo[houseid][pPosY], PropInfo[houseid][pPosZ] + 2, 0.0, 0.0, 0.0, -1, -1, -1, MAX_RADIO_STREAM);
        Incendios[a][pObject][12] = CreateDynamicObject(18691, PropInfo[houseid][pPosX], PropInfo[houseid][pPosY] + 2, PropInfo[houseid][pPosZ], 0.0, 0.0, 0.0, -1, -1, -1, MAX_RADIO_STREAM);
        Incendios[a][pObject][11] = CreateDynamicObject(18691, PropInfo[houseid][pPosX] + 2, PropInfo[houseid][pPosY], PropInfo[houseid][pPosZ], 0.0, 0.0, 0.0, -1, -1, -1, MAX_RADIO_STREAM);
        Incendios[a][pObject][10] = CreateDynamicObject(18691, PropInfo[houseid][pPosX] + 2, PropInfo[houseid][pPosY] + 2, PropInfo[houseid][pPosZ], 0.0, 0.0, 0.0, -1, -1, -1, MAX_RADIO_STREAM);
        Incendios[a][pObject][9] = CreateDynamicObject(18691, PropInfo[houseid][pPosX], PropInfo[houseid][pPosY] + 2, PropInfo[houseid][pPosZ] + 2, 0.0, 0.0, 0.0, -1, -1, -1, MAX_RADIO_STREAM);
        Incendios[a][pObject][8] = CreateDynamicObject(18691, PropInfo[houseid][pPosX] + 2, PropInfo[houseid][pPosY], PropInfo[houseid][pPosZ] + 2, 0.0, 0.0, 0.0, -1, -1, -1, MAX_RADIO_STREAM);
        Incendios[a][pObject][7] = CreateDynamicObject(18691, PropInfo[houseid][pPosX], PropInfo[houseid][pPosY], PropInfo[houseid][pPosZ] - 2, 0.0, 0.0, 0.0, -1, -1, -1, MAX_RADIO_STREAM);
        Incendios[a][pObject][6] = CreateDynamicObject(18691, PropInfo[houseid][pPosX], PropInfo[houseid][pPosY] - 2, PropInfo[houseid][pPosZ], 0.0, 0.0, 0.0, -1, -1, -1, MAX_RADIO_STREAM);
        Incendios[a][pObject][5] = CreateDynamicObject(18691, PropInfo[houseid][pPosX] - 2, PropInfo[houseid][pPosY], PropInfo[houseid][pPosZ], 0.0, 0.0, 0.0, -1, -1, -1, MAX_RADIO_STREAM);
        Incendios[a][pObject][4] = CreateDynamicObject(18691, PropInfo[houseid][pPosX] - 2, PropInfo[houseid][pPosY] - 2, PropInfo[houseid][pPosZ], 0.0, 0.0, 0.0, -1, -1, -1, MAX_RADIO_STREAM);
        Incendios[a][pObject][3] = CreateDynamicObject(18691, PropInfo[houseid][pPosX], PropInfo[houseid][pPosY] - 2, PropInfo[houseid][pPosZ] - 2, 0.0, 0.0, 0.0, -1, -1, -1, MAX_RADIO_STREAM);
        Incendios[a][pObject][2] = CreateDynamicObject(18691, PropInfo[houseid][pPosX] - 2, PropInfo[houseid][pPosY], PropInfo[houseid][pPosZ] - 2, 0.0, 0.0, 0.0, -1, -1, -1, MAX_RADIO_STREAM);
        Incendios[a][pObject][1] = CreateDynamicObject(18691, PropInfo[houseid][pPosX] + 2, PropInfo[houseid][pPosY] + 2, PropInfo[houseid][pPosZ] + 2, 0.0, 0.0, 0.0, -1, -1, -1, MAX_RADIO_STREAM);
        Incendios[a][pObject][0] = CreateDynamicObject(18691, PropInfo[houseid][pPosX] - 2, PropInfo[houseid][pPosY] - 2, PropInfo[houseid][pPosZ] - 2, 0.0, 0.0, 0.0, -1, -1, -1, MAX_RADIO_STREAM);
        return 1;
	}
	if(tipo == 1)
	{
		new string[70];
		format(string, sizeof(string), "\n\n{ff4000}Incendio\n{ffc100}Intensidad: {ffffff}%d%%", intensidad);
 		Incendios[a][pInfoIncendio] = CreateDynamic3DTextLabel(string, -1, Estacionamientos[houseid][PosX], Estacionamientos[houseid][PosY], Estacionamientos[houseid][PosZ] + 0.5, 8.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);
	    Incendios[a][pType] = 1;
        Incendios[a][pIntensidad] = intensidad;
		Incendios[a][pIDI] = houseid;
        Incendios[a][pObject][14] = CreateDynamicObject(18691, Estacionamientos[houseid][PosX], Estacionamientos[houseid][PosY], Estacionamientos[houseid][PosZ], 0.0, 0.0, 0.0, -1, -1, -1, MAX_RADIO_STREAM);
        Incendios[a][pObject][13] = CreateDynamicObject(18691, Estacionamientos[houseid][PosX], Estacionamientos[houseid][PosY], Estacionamientos[houseid][PosZ] + 2, 0.0, 0.0, 0.0, -1, -1, -1, MAX_RADIO_STREAM);
