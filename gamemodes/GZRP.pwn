                if (PLAYER_INFO[playerid][vModelo5] != 0) CountVeh++;

                if (CountVeh > 1 && PLAYER_INFO[playerid][pVip] == 0) return SendClientMessage(playerid, -1, "Las cuentas comunes solo pueden tener 2 vehículos."), RemovePlayerFromVehicle(playerid);
                if (CountVeh > 2 && PLAYER_INFO[playerid][pVip] == 1) return SendClientMessage(playerid, -1, "Las cuentas VIP1 solo pueden tener 3 vehículos."), RemovePlayerFromVehicle(playerid);
                if (CountVeh > 3 && PLAYER_INFO[playerid][pVip] == 2) return SendClientMessage(playerid, -1, "Las cuentas con membresía VIP2 solo pueden tener 4 vehículos."), RemovePlayerFromVehicle(playerid);
                if (CountVeh > 4 && PLAYER_INFO[playerid][pVip] == 3) return SendClientMessage(playerid, -1, "Las cuentas con membresía GVIP solo pueden tener 4 vehículos."), RemovePlayerFromVehicle(playerid);


                new CONCE_ID = ConceCercano(playerid);
                switch (VehiculosInfo[vehicleid][vmoneda]) {
                    case 0 :  //dinero
                    {
                        if (VehiculosInfo[vehicleid][vprecio] > PLAYER_INFO[playerid][jDinero]) return SendClientMessageEx(playerid, -1, "Necesitas {00CC00}$%d{FFFFFF} para comprar este vehiculo.", VehiculosInfo[vehicleid][vprecio]), RemovePlayerFromVehicle(playerid);
                        RemovePlayerFromVehicle(playerid);
                        CreatePlayerVehicle(playerid, VehiculosInfo[vehicleid][vmodelo], Concesionaria_Spawn_Positions[CONCE_ID][0], Concesionaria_Spawn_Positions[CONCE_ID][1], Concesionaria_Spawn_Positions[CONCE_ID][2], Concesionaria_Spawn_Positions[CONCE_ID][3], VehiculosInfo[vehicleid][vcolor1], VehiculosInfo[vehicleid][vcolor2], VehiculosInfo[vehicleid][vprecio], VehiculosInfo[vehicleid][vmoneda], -1);
                        QuitarDinero(playerid, VehiculosInfo[vehicleid][vprecio]);
                    }
                    case 1 :  //monedas EZ.
                    {
                        if (VehiculosInfo[vehicleid][vprecio] > PLAYER_INFO[playerid][Moneda]) return SendClientMessageEx(playerid, -1, "Necesitas {00CC00}%d "            SERVER_COIN "{FFFFFF} para comprar este vehiculo.", VehiculosInfo[vehicleid][vprecio]), RemovePlayerFromVehicle(playerid);
                        RemovePlayerFromVehicle(playerid);
                        CreatePlayerVehicle(playerid, VehiculosInfo[vehicleid][vmodelo], Concesionaria_Spawn_Positions[CONCE_ID][0], Concesionaria_Spawn_Positions[CONCE_ID][1], Concesionaria_Spawn_Positions[CONCE_ID][2], Concesionaria_Spawn_Positions[CONCE_ID][3], VehiculosInfo[vehicleid][vcolor1], VehiculosInfo[vehicleid][vcolor2], VehiculosInfo[vehicleid][vprecio], VehiculosInfo[vehicleid][vmoneda], -1);
                        PLAYER_INFO[playerid][Moneda] -= VehiculosInfo[vehicleid][vprecio];
                    }
                }
                return 1;
            } else {
                RemovePlayerFromVehicle(playerid);
                SetTimerEx("RespawnearV", 3000, false, "d", GetPlayerVehicleID(playerid));
            }
        }
        case DIALOG_INACTIVOS: {
            if (!response) return 1;
            switch (listitem) {
                case 0 :ShowDialog(playerid, DIALOG_DESOCUPAR_CASAS);
                case 1 : ShowDialog(playerid, DIALOG_DESOCUPAR_FABRICAS);
            }
            return 1;
        }
        case DIALOG_DESOCUPAR_CASAS: {
            if (!response) return ShowDialog(playerid, DIALOG_INACTIVOS);
            if (PLAYER_TEMP[playerid][p_PLAYER_LISTITEM][listitem] == -1) return 1;

            new ID = PLAYER_TEMP[playerid][p_PLAYER_LISTITEM][listitem];

            format(PropInfo[ID][pPropietario], 40, "Nadie");
            PropInfo[ID][pAbierta] = 1;
            PropInfo[ID][pRoperoAbierto] = 0;
            PropInfo[ID][pIDPropietario] = 0;
            PropInfo[ID][pGX] = 0.0;
            PropInfo[ID][pGY] = 0.0;
            PropInfo[ID][pGZ] = 0.0;
            PropInfo[ID][pGA] = 0.0;
            PropInfo[ID][pEnVenta] = 1;
            //
            if (GetPlayerID(PropInfo[ID][pPropietario]) != -1) {
                new pid = GetPlayerID(PropInfo[ID][pPropietario]);
                if (PLAYER_INFO[pid][CasaID][0] == ID) PLAYER_INFO[pid][CasaID][0] = 0;
                if (PLAYER_INFO[pid][CasaID][1] == ID) PLAYER_INFO[pid][CasaID][1] = 0;
                if (PLAYER_INFO[pid][CasaID][2] == ID) PLAYER_INFO[pid][CasaID][2] = 0;
                if (PLAYER_INFO[pid][CasaID][3] == ID) PLAYER_INFO[pid][CasaID][3] = 0;
                printf("Casa eliminada jugador conectado. - ID: %d - Nombre: %s", pid, PropInfo[ID][pPropietario]);
            }
            mysql_format(handle_db, Query, sizeof(Query), "UPDATE usuarios SET CasaID1 = '0' WHERE CasaID1 = '%d'", ID);
            mysql_tquery(handle_db, Query);
            mysql_format(handle_db, Query, sizeof(Query), "UPDATE usuarios SET CasaID2 = '0' WHERE CasaID2 = '%d'", ID);
            mysql_tquery(handle_db, Query);
            mysql_format(handle_db, Query, sizeof(Query), "UPDATE usuarios SET CasaID3 = '0' WHERE CasaID3 = '%d'", ID);
            mysql_tquery(handle_db, Query);
            mysql_format(handle_db, Query, sizeof(Query), "UPDATE usuarios SET CasaID4 = '0' WHERE CasaID4 = '%d'", ID);
            mysql_tquery(handle_db, Query);

            mysql_format(handle_db, Query, sizeof(Query), "UPDATE `propiedades` SET `Propietario`='Nadie',`IDPropietario`='0',`EnVenta`='1',`GX`='0',`GY`='0',`GZ`='0',`GA`='0' WHERE `ID`='%d'", PropInfo[ID][pID]);
            mysql_query(handle_db, Query, false);

            GuardarPropiedad(ID);
            BorrarLabelCasa(ID);
            CargarPropiedad(ID);

            SendClientMessageEx(playerid, -1, "Editaste el estado de la casa con id: {009AFF}%d", ID);
            ShowDialog(playerid, DIALOG_DESOCUPAR_CASAS);
            return 1;
        }
        case DIALOG_DESOCUPAR_FABRICAS: {
            if (!response) return 1;
            if (PLAYER_TEMP[playerid][p_PLAYER_LISTITEM][listitem] == -1) return 1;

            new ID = PLAYER_TEMP[playerid][p_PLAYER_LISTITEM][listitem];
            PLAYER_TEMP[playerid][pt_FABRICA_ID] = ID;

            if (FABRICAS_INFO[ID][f_VENTA] == 0) {
                SetPosEx(playerid, FABRICAS_INFO[ID][f_POS][0], FABRICAS_INFO[ID][f_POS][1], FABRICAS_INFO[ID][f_POS][2], FABRICAS_INFO[ID][f_POS][3], 0, 0);
                return 1;
            }
            mysql_format(handle_db, Query, sizeof(Query), "SELECT * FROM `usuarios` WHERE `Faccion`='%d'", FABRICAS_INFO[ID][f_FACCION_ID]);
            mysql_query(handle_db, Query, true);

            new dialog[115 * 25 + 1], line_str[115], Conexion[90], rango, name[24], online;
            dialog = "Nombre\tRango\tult. conexion\n";

            for(new i = 0; i < cache_num_rows(); i++) {
                cache_get_value_name(i, "Username", name);
                cache_get_value_name_int(i, "Rango", rango);
                cache_get_value_name(i, "Conexion", Conexion);
                cache_get_value_name_int(i, "Online", online);

                if (online == 0) format(line_str, sizeof line_str, "%s\t%s\t%s\n", name, RangoBanda(FABRICAS_INFO[ID][f_FACCION_ID], rango), Conexion);
                else format(line_str, sizeof line_str, "%s\t%s\t{80D465}Conectado{FFFFFF}\n", name, RangoBanda(PLAYER_INFO[playerid][pFaccion], rango));
                strcat(dialog, line_str);
            }
            dialogs_ShowPlayerDialog(playerid, DIALOG_DESOCUPAR_FABRICAS_2, DIALOG_STYLE_TABLIST_HEADERS, "Bandas: Miembros", dialog, "Desocupar", "Atras");
            return 1;
        }
        case DIALOG_DESOCUPAR_FABRICAS_2: {
            if (!response) return ShowDialog(playerid, DIALOG_DESOCUPAR_FABRICAS);

            new ID = PLAYER_TEMP[playerid][pt_FABRICA_ID];

            DesocuparFabrica(ID, true);

            MensajeEx(playerid, -1, "La fabrica {00CC00}%d{FFFFFF} fue desocupada", ID);
            ShowDialog(playerid, DIALOG_DESOCUPAR_FABRICAS);
            return 1;
        }
        case DIALOG_ACENTO: {
            if (!response) return 1;
            SendClientMessageEx(playerid, -1, "Ahora tu acento es {DEED15}%s{FFFFFF}, usa {DEED15}/acento{FFFFFF} para cambiarlo.", GetNameAcento(listitem));
            PLAYER_INFO[playerid][pAcento] = PLAYER_TEMP[playerid][p_PLAYER_LISTITEM][listitem];

            mysql_format(handle_db, Query, sizeof(Query), "UPDATE `usuarios` SET `Acento`='%d' WHERE `Username`='%e'", PLAYER_INFO[playerid][pAcento], PLAYER_INFO[playerid][Nickname]);
            mysql_query(handle_db, Query);
            return 1;
        }
        case DIALOG_PAINTW: {
            if (!response) return 1;
            if (response) {
                switch (listitem) {
                    case 0..5: {

                        COLOR_ARMA[playerid] = listitem;
                        PLAYER_INFO[playerid][OtrasArmas] = 1;
                        Notificador2(playerid, "~g~Hola, te recordamos que al pintar tus armas no se mostraran en la espalda.");
                        SendClientMessageEx(playerid, 0xFFFF1493, "Informacion: Color de arma establecido correctamente.");
                        if (GetPlayerWeapon(playerid)) DAR_COLOREARAM(playerid, GetPlayerWeapon(playerid));
                    }
                    case 6: {
                        COLOR_ARMA[playerid] = -1;
                        PLAYER_INFO[playerid][OtrasArmas] = 0;
                        SendClientMessageEx(playerid, 0xFFFF1493, "Informacion: Color de arma removido correctamente.");
                        if (GetPlayerWeapon(playerid)) DAR_COLOREARAM(playerid, GetPlayerWeapon(playerid));
                    }
                }

            }
        }
        case DIALOG_ACTIVIDAD: {
            if (!response) return 1;

            switch (listitem) {
                case 0: //pedir quimicos
                {
                    for(new ID = 1; ID < MAX_FABRICAS; ID++) {
                        if (!FABRICAS_INFO[ID][f_VALID]) continue;
                        if (PLAYER_INFO[playerid][pFaccion] != FABRICAS_INFO[ID][f_FACCION_ID]) continue;
                        if (FABRICAS_INFO[ID][f_ACTIVIDAD] == ACTIVIDAD_NONE) {
                            for(new i = 0; i < sizeof CP_Fabricas_Barril; i++) {
                                if (i == FABRICAS_INFO[ID][f_ID]) {
                                    MandarMensajeFabrica(ID, "Ve con el {00CCFF}vehiculo de la fabrica{FFFFFF} hasta el {FF0000}punto marcado{FFFFFF} en el mapa.");
                                    StartPlayerPath(playerid, CP_Fabricas_Barril[i][0], CP_Fabricas_Barril[i][1], CP_Fabricas_Barril[i][2], 5.0);
                                    Streamer_Update(playerid);
                                    break;
                                }
                            }
                            FABRICAS_INFO[ID][f_ACTIVIDAD] = ACTIVIDAD_QUIMICOS;
                            break;
                        } else return SendClientMessage(playerid, -1, "Primero termina la actividad pendiente.");
                    }
                    return 1;
                }
                case 1: {
                    for(new ID = 1; ID < MAX_FABRICAS; ID++) {
                        if (!FABRICAS_INFO[ID][f_VALID]) continue;
                        if (PLAYER_INFO[playerid][pFaccion] != FABRICAS_INFO[ID][f_FACCION_ID]) continue;

                        if (FABRICAS_INFO[ID][f_ACTIVIDAD] == ACTIVIDAD_NONE) {
                            FABRICAS_INFO[ID][f_ACTIVIDAD] = ACTIVIDAD_VENDER;

                            MandarMensajeFabrica(ID, "Carga el {00CCFF}vehiculo de la fabrica{FFFFFF} con metanfetamina y llevalo al {EB0000}punto marcado{FFFFFF} en el mapa.");

                            new pos = random(sizeof CP_Fabricas_Ventas);
                            FABRICAS_INFO[ID][f_VENTA_ID] = pos;
                            StartPlayerPath(playerid, CP_Fabricas_Ventas[pos][0], CP_Fabricas_Ventas[pos][1], CP_Fabricas_Ventas[pos][2], 5.0);
                            break;
                        } else return SendClientMessage(playerid, -1, "Primero termina la actividad pendiente.");
                    }
                    return 1;
                }
                case 2: {
                    for(new ID = 1; ID < MAX_FABRICAS; ID++) {
                        if (!FABRICAS_INFO[ID][f_VALID]) continue;
                        if (PLAYER_INFO[playerid][pFaccion] != FABRICAS_INFO[ID][f_FACCION_ID]) continue;

                        if (FABRICAS_INFO[ID][f_ACTIVIDAD] == ACTIVIDAD_NONE) {
                            if (FABRICAS_INFO[ID][f_SOBORNO_TIME] > gettime()) {
                                SendClientMessageEx(playerid, -1, "aun no puedes pagar el soborno, intenta en {EB0000}%s{ffffff}.", FormatTimeleft2(FABRICAS_INFO[ID][f_SOBORNO_TIME] - gettime()));
                                return ShowDialog(playerid, DIALOG_ACTIVIDAD);
                            }
                            if (FABRICAS_INFO[ID][f_SOBORNO_ACTIVE] == 0) {
                                FABRICAS_INFO[ID][f_SOBORNO_ACTIVE] = 1;
                                StartPlayerPath(playerid, 1543.1437, -1675.5537, 13.5559, 5.0);
                            }
                            FABRICAS_INFO[ID][f_ACTIVIDAD] = ACTIVIDAD_SOBORNO;
                            SendClientMessage(playerid, -1, "Agarra un {00CC00}bolso de dinero{FFFFFF} y llevalo a la{3399FF} oficina del comandante{FFFFFF} en el Departamento de policia de Los Santos.");
                            break;
                        } else return SendClientMessage(playerid, -1, "Primero termina la actividad pendiente.");
                    }
                    return 1;
                }
                case 3 :  //ver pedidos
                {
                    for(new ID = 1; ID < MAX_FABRICAS; ID++) {
                        if (!FABRICAS_INFO[ID][f_VALID]) continue;
                        if (PLAYER_INFO[playerid][pFaccion] != FABRICAS_INFO[ID][f_FACCION_ID]) continue;

                        switch (FABRICAS_INFO[ID][f_ACTIVIDAD]) {
                            case ACTIVIDAD_QUIMICOS: {
                                for(new i = 0; i < sizeof CP_Fabricas_Barril; i++) {
                                    if (i == FABRICAS_INFO[ID][f_ID]) {
                                        SendClientMessage(playerid, -1, "Ve con el {00CCFF}vehiculo de la fabrica{FFFFFF} hasta el {FF0000}punto marcado{FFFFFF} en el mapa.");
                                        StartPlayerPath(playerid, CP_Fabricas_Barril[i][0], CP_Fabricas_Barril[i][1], CP_Fabricas_Barril[i][2], 5.0);
                                        return 1;
                                    }
                                }
                            }
                            case ACTIVIDAD_VENDER: {
                                SendClientMessage(playerid, -1, "Carga el {00CCFF}vehiculo de la fabrica{FFFFFF} con metanfetamina y llevalo al {EB0000}punto marcado{FFFFFF} en el mapa.");

                                new pos = FABRICAS_INFO[ID][f_VENTA_ID];
                                StartPlayerPath(playerid, CP_Fabricas_Ventas[pos][0], CP_Fabricas_Ventas[pos][1], CP_Fabricas_Ventas[pos][2], 5.0);
                                return 1;
                            }
                            case ACTIVIDAD_SOBORNO: {
                                if (FABRICAS_INFO[ID][f_SOBORNO_TIME] > gettime()) {
                                    SendClientMessageEx(playerid, -1, "aun no puedes pagar el soborno, intenta en {EB0000}%s{ffffff}.", FormatTimeleft2(FABRICAS_INFO[ID][f_SOBORNO_TIME] - gettime()));
                                    return ShowDialog(playerid, DIALOG_ACTIVIDAD);
                                }
                                if (FABRICAS_INFO[ID][f_SOBORNO_ACTIVE] == 1) {
                                    StartPlayerPath(playerid, 1543.1437, -1675.5537, 13.5559, 5.0);
                                    return SendClientMessage(playerid, -1, "Agarra un {00CC00}bolso de dinero{FFFFFF} y llevalo a la{3399FF} oficina del comandante{FFFFFF} en el Departamento de policia de Los Santos.");
                                }
                            }
                            default: return 1;
                        }
                    }
                    return 1;
                }
                case 4 :  //cancelar pedidos
                {
                    for(new ID = 1; ID < MAX_FABRICAS; ID++) {
                        if (!FABRICAS_INFO[ID][f_VALID]) continue;
                        if (PLAYER_INFO[playerid][pFaccion] != FABRICAS_INFO[ID][f_FACCION_ID]) continue;

                        switch (FABRICAS_INFO[ID][f_ACTIVIDAD]) {
                            case ACTIVIDAD_QUIMICOS: {
                                SendClientMessage(playerid, -1, "La actividad actual fue cancelada.");
                                FABRICAS_INFO[ID][f_ACTIVIDAD] = ACTIVIDAD_NONE;
                                Streamer_Update(playerid);
                                return 1;
                            }
                            case ACTIVIDAD_VENDER: {
                                FABRICAS_INFO[ID][f_VENTA_ID] = 0;
                                FABRICAS_INFO[ID][f_ACTIVIDAD] = ACTIVIDAD_NONE;
                                SendClientMessage(playerid, -1, "La actividad actual fue cancelada.");
                                return 1;
                            }
                            case ACTIVIDAD_SOBORNO: {
                                if (FABRICAS_INFO[ID][f_SOBORNO_ACTIVE] == 1) {
                                    FABRICAS_INFO[ID][f_SOBORNO_ACTIVE] = 0;
                                }
                                FABRICAS_INFO[ID][f_ACTIVIDAD] = ACTIVIDAD_NONE;
                                SendClientMessage(playerid, -1, "La actividad actual fue cancelada.");
                            }
                            default: return 1;
                        }
                    }
                    return 1;
                }
            }
        }
        case DIALOG_MEJORAS_VEH: {
            if (response) {
                if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
                    switch (listitem) {
                        case 0: {
                            new stringx[200];
                            format(stringx, sizeof(stringx), "{ffffff}Mejorar motor al vehiculo: \"%s\" por un costo de {00ff00}100 Totems{ffffff}\nObtendras mas aceleracion en poco tiempo", GetVehicleName(GetPlayerVehicleID(playerid)));
                            dialogs_ShowPlayerDialog(playerid, DIALOG_MEJORAR_MOTOR, DIALOG_STYLE_MSGBOX, "Mejorar motor", stringx, "Aceptar", "Cancelar");
                        }
                        case 1: {
                            if (IsPlayerInAnyVehicle(playerid)) {
                                if (PLAYER_INFO[playerid][TUNEANDO] == 0) {
                                    new stringx[600];
                                    format(stringx, sizeof(stringx), "{ffffff}Mejorar estetica al vehiculo: \"%s\" por un costo de {00ff00}$100.000 Dolares{ffffff}\nObtendras un vehículo con nitro/suspension/ruedas y colores unicos\n{ffff00}OJO: Luego de tunear pulsa en {0066ff}GUARDAR CAMBIOS{ffffff} de lo contrario puedes perder los {00ff00}$100.000", GetVehicleName(GetPlayerVehicleID(playerid)));
                                    dialogs_ShowPlayerDialog(playerid, DIALOG_TUNEO, DIALOG_STYLE_MSGBOX, "Mejorar Estetica", stringx, "Aceptar", "Cancelar");
                                }
                                if (PLAYER_INFO[playerid][TUNEANDO] == 1) {
                                    dialogs_ShowPlayerDialog(playerid, Tuning, DIALOG_STYLE_LIST, "Taller tuning", "{8D3EE2}Ruedas\n{E23E43}Colores\n{3EE2DD}Paintjobs\n{3EE2DD}Nitro\n{ABE23E}Suspension hidraublica\n{DFE23E}Sideskirts\n{E23ECF}Tubos de escape\n{888487}Reparar\n{0066ff}Guardar Cambios", "Colocar", "Cancelar");
                                }
                            }
                        }
                    }
                }
            }
        }
        case DIALOG_SALTICO_VEH: {
            if (response) {
                if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
                    switch (listitem) {
                        case 0: {
                            new vehicleid = GetPlayerVehicleID(playerid);
                            if (GLOBAL_VEHICLES[vehicleid][gb_vehicle_SALTO_V_1] == 1) return SendClientMessage(playerid, -1, "Tu vehiculo ya tiene esta mejora");

                            if (vehicleid != autos[playerid] && vehicleid != autos2[playerid] && vehicleid != autos3[playerid] && vehicleid != autos4[playerid] && vehicleid != autos5[playerid]) return SendClientMessage(playerid, -1, "Solo puedes modificar tus vehiculos.");
                            if (vehicleid == autos[playerid] && PLAYER_INFO[playerid][vID1] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para tunear.");
                            if (vehicleid == autos2[playerid] && PLAYER_INFO[playerid][vID2] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para tunear.");
                            if (vehicleid == autos3[playerid] && PLAYER_INFO[playerid][vID3] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para tunear.");
                            if (vehicleid == autos4[playerid] && PLAYER_INFO[playerid][vID4] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para tunear.");
                            if (vehicleid == autos4[playerid] && PLAYER_INFO[playerid][vID5] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para tunear.");

                            if (70000 > PLAYER_INFO[playerid][jDinero]) return SendClientMessage(playerid, -1, "No tienes dinero suficiente para mejorar el vehiculo");

                            if (!vehicleid) return SendClientMessage(playerid, -1, "No estas en un vehiculo.");

                            QuitarDinero(playerid, 70000);

                            GLOBAL_VEHICLES[vehicleid][gb_vehicle_SALTO_V] = 1;
                            GLOBAL_VEHICLES[vehicleid][gb_vehicle_SALTO_V_1] = 1;

                            SendClientMessage(playerid, -1, "Pulsa 'W y S' por unos segundos para usar esta mejora.");
                        }
                        case 1: {
                            new vehicleid = GetPlayerVehicleID(playerid);
                            if (GLOBAL_VEHICLES[vehicleid][gb_vehicle_SALTO_V_2] == 2) return SendClientMessage(playerid, -1, "Tu vehiculo ya tiene esta mejora");
                            if (vehicleid != autos[playerid] && vehicleid != autos2[playerid] && vehicleid != autos3[playerid] && vehicleid != autos4[playerid] && vehicleid != autos5[playerid]) return SendClientMessage(playerid, -1, "Solo puedes modificar tus vehiculos.");
                            if (vehicleid == autos[playerid] && PLAYER_INFO[playerid][vID1] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para tunear.");
                            if (vehicleid == autos2[playerid] && PLAYER_INFO[playerid][vID2] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para tunear.");
                            if (vehicleid == autos3[playerid] && PLAYER_INFO[playerid][vID3] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para tunear.");
                            if (vehicleid == autos4[playerid] && PLAYER_INFO[playerid][vID4] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para tunear.");
                            if (vehicleid == autos5[playerid] && PLAYER_INFO[playerid][vID5] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para tunear.");
                            if (100000 > PLAYER_INFO[playerid][jDinero]) return SendClientMessage(playerid, -1, "No tienes dinero suficiente para mejorar el vehiculo");
                            if (!vehicleid) return SendClientMessage(playerid, -1, "No estas en un vehiculo.");

                            QuitarDinero(playerid, 100000);

                            GLOBAL_VEHICLES[vehicleid][gb_vehicle_SALTO_V] = 2;
                            GLOBAL_VEHICLES[vehicleid][gb_vehicle_SALTO_V_2] = 1;

                            SendClientMessage(playerid, -1, "Pulsa 'W y S' por unos segundos para usar esta mejora.");
                        }
                    }
                }
            }
        }
        case DIALOG_MEJORAR_MOTOR: {
            if (response) {
                new vehicleid = GetPlayerVehicleID(playerid);
                if (!vehicleid) return SendClientMessage(playerid, -1, "No estas en un vehiculo.");

                if (vehicleid != autos[playerid] && vehicleid != autos2[playerid] && vehicleid != autos3[playerid] && vehicleid != autos4[playerid] && vehicleid != autos5[playerid]) return SendClientMessage(playerid, -1, "Solo puedes modificar tus vehiculos.");
                if (vehicleid == autos[playerid] && PLAYER_INFO[playerid][vID1] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para tunear.");
                if (vehicleid == autos2[playerid] && PLAYER_INFO[playerid][vID2] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para tunear.");
                if (vehicleid == autos3[playerid] && PLAYER_INFO[playerid][vID3] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para tunear.");
                if (vehicleid == autos4[playerid] && PLAYER_INFO[playerid][vID4] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para tunear.");
                if (vehicleid == autos5[playerid] && PLAYER_INFO[playerid][vID5] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para tunear.");

                if (100 > PLAYER_INFO[playerid][Totems]) return SendClientMessage(playerid, -1, "No tienes Totems suficiente para mejorar el motor");

                if (!EstadoVelocidad(playerid, vehicleid, true)) return SendClientMessage(playerid, -1, "Tu vehiculo ya tiene esta mejora");

                PLAYER_INFO[playerid][Totems] -= 100;
                GLOBAL_VEHICLES[vehicleid][gb_vehicle_ACELERACION] = 1;
                GuardarCuenta(playerid);
                SendClientMessage(playerid, -1, "Motor del vehiculo mejorado, escribe '{ffff00}/vehiculo{FFFFFF}' para activar/desactivar");
            }
        }
        case DIALOG_ANUNCIO: {
            if (response) {
                new stringanuncio[128], tipoad[20];
                switch (listitem) {
                    case 0 : tipoad = "mensaje de texto", PLAYER_TEMP[playerid][AnuncioTipo2] = 2;
                    case 1 : tipoad = "periodico", PLAYER_TEMP[playerid][AnuncioTipo2] = 1;
                }
                format(stringanuncio, sizeof(stringanuncio), "%s (por celular) dice: Necesito publicar un anuncio vía %s.", PLAYER_INFO[playerid][Nickname], tipoad);
                if (PLAYER_TEMP[playerid][@Specteando] == 0) ProxDetector(15.0, playerid, stringanuncio, Hablar, Hablar2, Hablar3, Hablar4, Hablar5);
                SetTimerEx("LlamadaAnuncios2", 2000, false, "d", playerid);
            } else CancelarLlamadaAnuncio(playerid);
        }
        case DIALOG_ANUNCIO1: {
            if (response) {
                new stringanuncio[128], tipoad[16];
                switch (listitem) {
                    case 0 : tipoad = "de compra";
                    case 1 : tipoad = "de venta";
                    case 2 : tipoad = "normal";
                }
                format(stringanuncio, sizeof(stringanuncio), "%s (por celular) dice: Necesito publicar un anuncio %s.", PLAYER_INFO[playerid][Nickname], tipoad);
                if (PLAYER_TEMP[playerid][@Specteando] == 0) ProxDetector(15.0, playerid, stringanuncio, Hablar, Hablar2, Hablar3, Hablar4, Hablar5);
                AnuncioTipo[playerid] = listitem + 1;
                SetTimerEx("AnuncioPlayer2", 2000, false, "d", playerid);
            } else CancelarLlamadaAnuncio(playerid);
        }
        case DIALOG_ANUNCIO2: {
            if (response) {
                if (strlen(inputtext) > 100 || strlen(inputtext) < 5) return dialogs_ShowPlayerDialog(playerid, DIALOG_ANUNCIO2, DIALOG_STYLE_INPUT, "Informacion sobre el servicio de anuncios", "{FFFFFF}A continuacion, usa el siguiente campo para ingresar el contenido de tu anuncio:\n\n{FF0000}El anuncio no puede tener mas de 100 caracteres ni menos de 5.", "Siguiente", "Cancelar");
                format(AnuncioTexto[playerid], 144, "%s", inputtext);
                dialogs_ShowPlayerDialog(playerid, DIALOG_ANUNCIO3, DIALOG_STYLE_MSGBOX, "{"            COLOR_GM "}¡ATENCION!", "{FFFFFF}estas por utiliza el canal de anuncios\n\nEl canal de anuncios es unicamente para publicar anuncios a nivel global del servidor.\nNo mal uses el canal de anuncios, como por ejemplo para insultar a otros jugadores.\nSi lo haces puedes ser sancionado o hasta baneado.\n\n                                    ¿Quieres enviar el anuncio?", "Anunciar", "Cancelar");
            } else CancelarLlamadaAnuncio(playerid);
        }
        case DIALOG_ENVIVO: {
            if (response) {
                if (strlen(inputtext) > 100 || strlen(inputtext) < 5) return dialogs_ShowPlayerDialog(playerid, DIALOG_ANUNCIO2, DIALOG_STYLE_INPUT, "APSA | Transmisiones", "{FFFFFF}A continuacion, usa el siguiente campo para ingresar el contenido de tu transmision:\n\n{FF0000}El contenido no puede tener mas de 100 caracteres ni menos de 5.", "Siguiente", "Cancelar");
                format(AnuncioTextoVivo[playerid], 144, "%s", inputtext);
                strreplace(AnuncioTextoVivo[playerid], " ", "_", true, 0, -1, 144);
                Envivo = playerid;
                SendClientMessage(playerid, -1, "Director dice: Las camaras estan listas y pronto estaremos dando informe de las vistas.");
                SendClientMessage(playerid, -1, "Director dice: Luces, camaras, ACCIoN.");
                foreach(new i : Player) Notificador2(i, "~g~[APSA] Noticiero informativo. ¡Puedes verlo desde tu TV o SmartPhone!");
                TextDrawSetString(APSA[1], AnuncioTextoVivo[playerid]);
            }
        }
        case DIALOG_TUNEO: {
            if (response) {
                if (100000 > PLAYER_INFO[playerid][jDinero]) return PUSH(playerid, "No tienes dinero suficiente para mejorar tu ~r~vehiculo~w~.");
                dialogs_ShowPlayerDialog(playerid, Tuning, DIALOG_STYLE_LIST, "Taller tuning", "{8D3EE2}Ruedas\n{E23E43}Colores\n{3EE2DD}Paintjobs\n{3EE2DD}Nitro\n{ABE23E}Suspension hidraublica\n{DFE23E}Sideskirts\n{E23ECF}Tubos de escape\n{888487}Reparar\n{0066ff}Guardar Cambios", "Colocar", "Cancelar");
                QuitarDinero(playerid, 100000);
                PLAYER_INFO[playerid][TUNEANDO] = 1;
            }
        }
        case DIALOG_STATS: {
            if (response) {
                if (PLAYER_INFO[playerid][@Nivel] >= 3) return ShowPlayerMessage(playerid, "Esto es para usuarios menor a nivel 3");
                if (PLAYER_INFO[playerid][pStats] == 0) {
                    new Query1[128];
                    mysql_format(handle_db, Query1, sizeof(Query1), "UPDATE `usuarios` SET `Stats`='1' WHERE `ID`='%d'", PLAYER_INFO[playerid][pID]);
                    mysql_tquery(handle_db, Query1);
                    DarDinero(playerid, S_DINERO);
                    DarDineroBanco(playerid, 100000);
                    PLAYER_INFO[playerid][pStats] = 1, PLAYER_INFO[playerid][@Nivel] = S_NIVEL;
                    PLAYER_INFO[playerid][Totems] = S_COINS, PLAYER_INFO[playerid][Moneda] = S_MONEDAS;
                    PLAYER_INFO[playerid][pCrack] = S_CRACK, PLAYER_INFO[playerid][pRemedios] = S_MEDIS;
                    PLAYER_INFO[playerid][pMateriales] = S_LEGOS, PLAYER_INFO[playerid][pNivelCamionero] = S_N_CAMIONERO,
                        PLAYER_INFO[playerid][pNivelArmero] = S_N_ARMERO, PLAYER_INFO[playerid][pLSD] = S_KP,
                        PLAYER_INFO[playerid][pKrippy] = S_LSD, PLAYER_INFO[playerid][pPatines] = S_PATINES,
                        PLAYER_INFO[playerid][pNivelLadron] = S_N_LADRON;
                    PLAYER_INFO[playerid][pNivelBasurero] = S_N_BASURERO;
                    PLAYER_INFO[playerid][pBotiquines] = S_BOTIQUINES;
                    PLAYER_INFO[playerid][pGPS] = S_GPS;
                    Actualizar(playerid);
                    RevisarLogro(playerid, 1);
                    SetPlayerVirtualWorld(playerid, 0);
                    GuardarCuenta(playerid);
                    UsuarioRegistrado(playerid);
                    SetTimerEx("TutorialPlayer", 5000, false, "dd", playerid, 0);
                    RecienRegistrado[playerid] = 1;
                }
            } else return Notificador2(playerid, "Debes recibir los regalos para verificar tu cuenta en foro");
