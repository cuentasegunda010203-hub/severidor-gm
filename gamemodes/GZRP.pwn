CMD:est(playerid, params[]) {
    #pragma unused params
    return RP_StatsShow(playerid);
}

stock localizarveh(playerid) {
    if (PLAYER_INFO[playerid][vModelo] > 0 || PLAYER_INFO[playerid][vModelo2] > 0 || PLAYER_INFO[playerid][vModelo3] > 0 || PLAYER_INFO[playerid][vModelo4] > 0 || PLAYER_INFO[playerid][vModelo5] > 0) {
        new vehiculo1[360], vehiculo2[360], vehiculo3[360], vehiculo4[360], vehiculo5[360], mensaje[600], count;
        new Float:x, Float:y, Float:z, Float:x2, Float:y2, Float:z2, Float:x3, Float:y3, Float:z3, Float:x4, Float:y4, Float:z4, Float:x5, Float:y5, Float:z5;
        GetVehiclePos(autos[playerid], x, y, z);
        GetVehiclePos(autos2[playerid], x2, y2, z2);
        GetVehiclePos(autos3[playerid], x3, y3, z3);
        GetVehiclePos(autos4[playerid], x4, y4, z4);
        GetVehiclePos(autos5[playerid], x5, y5, z5);
        new Float:L1 = GetPlayerDistanceFromPoint(playerid, x, y, z);
        new Float:L2 = GetPlayerDistanceFromPoint(playerid, x2, y2, z2);
        new Float:L3 = GetPlayerDistanceFromPoint(playerid, x3, y3, z3);
        new Float:L4 = GetPlayerDistanceFromPoint(playerid, x4, y4, z4);
        new Float:L5 = GetPlayerDistanceFromPoint(playerid, x5, y5, z5);
        if (PLAYER_INFO[playerid][vModelo] > 0) {
            LocalizarID[playerid][count] = autos[playerid];
            format(vehiculo1, sizeof(vehiculo1), "Nombre: {FF5454}%s{FFFFFF} | Patente: {FF9C19}%s {FFFFFF}| Distancia: {999999}%.2f m", NombreAuto[GetVehicleModel(autos[playerid]) - 400], PLAYER_INFO[playerid][vpatente], L1);
            count++;
        }
        if (PLAYER_INFO[playerid][vModelo2] > 0) {
            LocalizarID[playerid][count] = autos2[playerid];
            format(vehiculo2, sizeof(vehiculo2), "\nNombre: {FF5454}%s{FFFFFF} | Patente: {FF9C19}%s {FFFFFF}| Distancia: {999999}%.2f m", NombreAuto[GetVehicleModel(autos2[playerid]) - 400], PLAYER_INFO[playerid][v2patente], L2);
            count++;
        }
        if (PLAYER_INFO[playerid][vModelo3] > 0) {
            LocalizarID[playerid][count] = autos3[playerid];
            format(vehiculo3, sizeof(vehiculo3), "\nNombre: {FF5454}%s{FFFFFF} | Patente: {FF9C19}%s {FFFFFF}| Distancia: {999999}%.2f m", NombreAuto[GetVehicleModel(autos3[playerid]) - 400], PLAYER_INFO[playerid][v3patente], L3);
            count++;
        }
        if (PLAYER_INFO[playerid][vModelo4] > 0) {
            LocalizarID[playerid][count] = autos4[playerid];
            format(vehiculo4, sizeof(vehiculo4), "\nNombre: {FF5454}%s{FFFFFF} | Patente: {FF9C19}%s {FFFFFF}| Distancia: {999999}%.2f m", NombreAuto[GetVehicleModel(autos4[playerid]) - 400], PLAYER_INFO[playerid][v4patente], L4);
            count++;
        }
        if (PLAYER_INFO[playerid][vModelo5] > 0) {
            LocalizarID[playerid][count] = autos5[playerid];
            format(vehiculo5, sizeof(vehiculo5), "\nNombre: {FF5454}%s{FFFFFF} | Patente: {FF9C19}%s {FFFFFF}| Distancia: {999999}%.2f m", NombreAuto[GetVehicleModel(autos5[playerid]) - 400], PLAYER_INFO[playerid][v5patente], L5);
            count++;
        }
        format(mensaje, sizeof(mensaje), "%s%s%s%s%s", vehiculo1, vehiculo2, vehiculo3, vehiculo4, vehiculo5);
        dialogs_ShowPlayerDialog(playerid, GeoLocalization, DIALOG_STYLE_LIST, "Selecciona el vehiculo que deseas localizar", mensaje, "Localizar", "Cancelar");
    } else SendClientMessage(playerid, -1, "No se encontraron vehiculos, si crees que es un error relogea.");
    return 1;
}
CMD:habilidad(playerid, params[]) {
    new ID, string[70];
    if (sscanf(params, "d", ID)) return Habilidad(playerid, playerid);
    if (PLAYER_INFO[playerid][pAdmin] > ADMIN_LEVEL_DUDAS) {
        format(string, 128, "Listado de Habilidades de %s", PLAYER_INFO[ID][Nickname]);
        SendClientMessage(playerid, COLOR_MEGAPHONE, string);
        Habilidad(ID, playerid);
    } else Habilidad(playerid, playerid);
    return 1;
}
CMD:frecuencias(playerid, params[]) {
    if (PLAYER_INFO[playerid][pDuty] != 1) return 1;
    MostrarFrecuencias(playerid);
    return 1;
}
CMD:esposar(playerid, params[]) {
    new data[144], Float:pos[3], id;
    if (sscanf(params, "d", id)) return SendClientMessage(playerid, COLOR_WHITE, "Usa: {"COLOR_GM "}/esposar [id o nombre]");
    GetPlayerPos(id, pos[0], pos[1], pos[2]);
    if (IsPlayerNPC(id)) return 1;
    if (!IsPlayerConnected(id)) return 1;
    if (!IsAPolice(playerid)) return ShowPlayerMessage(playerid, "No puedes usar este comando.");
    if (PLAYER_INFO[id][pCargos] == 0) return SendClientMessage(playerid, -1, "Esa persona no tiene nivel de b?squeda.");
    if (!IsPlayerInRangeOfPoint(playerid, 5.0, pos[0], pos[1], pos[2])) return SendClientMessage(playerid, -1, "esta demasiado lejos, distancia m?xima {"COLOR_GM "}5m{FFFFFF}."); {
        if (PLAYER_INFO[playerid][pDuty] != 1) return 1;
        Esposando[id] = 1;
        Oficial[id] = playerid;
        TogglePlayerControllable(id, 0);
        SetPVarInt(id, "IsFrozen", 0);
        TimerEsposar[id] = SetTimerEx("TiempoArresto", 10000, false, "d", id);
        EnPatrulla[id] = 0;
        SetPVarInt(id, "Player:Cuff", 1);
        SetPlayerSpecialAction(id, SPECIAL_ACTION_HANDSUP);
        format(data, sizeof(data), "Oficial %s intenta esposar a %s", PLAYER_INFO[playerid][Nickname], PLAYER_INFO[id][Nickname]);
        ProxDetector(20.0, playerid, data, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES);
        SendClientMessage(id, -1, "Estas siendo esposado, para resitirte escribe {"    COLOR_GM "}/resistirse");
        SendClientMessage(playerid, -1, "Si logras esposar al {00CCFF}sospecho{FFFFFF} usa {"    COLOR_GM "}/desposar{FFFFFF} para poder desesposarlo.");

    }
    return true;
}
CMD:desposar(playerid, params[]) {
    new id, Float:x, Float:y, Float:z, string[128];
    if (!sscanf(params, "d", id)) {
        if (PLAYER_INFO[playerid][pDuty] == 1 && PLAYER_INFO[playerid][pFaccion] == 1 || PLAYER_INFO[playerid][pFaccion] == 2) {
            GetPlayerPos(id, x, y, z);
            if (PLAYER_INFO[id][pCargos] > 1) return 1;
            if (!IsPlayerInRangeOfPoint(playerid, 5.0, x, y, z)) return SendClientMessage(playerid, -1, "No estas cerca de este jugador");
            if (PLAYER_INFO[id][Agonizando] == 1 || Esposando[id] == 2 || EnPatrulla[id] == 1) {
                if (IsPlayerInAnyVehicle(id)) RemovePlayerFromVehicle(id);
                PLAYER_INFO[id][Agonizando] = 0;
                Esposando[id] = 0;
                SetPlayerSpecialAction(id, SPECIAL_ACTION_NONE);
                PLAYER_INFO[id][pCargos] = 0;
                ActualizarRadar();
                SetPlayerWantedLevelEx(id, PLAYER_INFO[id][pCargos]);
                TogglePlayerControllable(id, 1);
                SetPVarInt(id, "IsFrozen", 1);
                PLAYER_TEMP[id][VariableCaido] = 0;
                format(string, sizeof(string), "%s %s desposa al sospechoso", RangoPolicia(playerid), PLAYER_INFO[playerid][Nickname]);
                ProxDetector(15.0, playerid, string, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO);
            } else return SendClientMessage(playerid, -1, "El jugador debe estar abatido o esposado");
        }
    } else return SendClientMessage(playerid, -1, "Usa: {008FFF}/desposar id");
    return 1;
}

CMD:resistirse(playerid, params[]) {
    new string[126], chatadmin[256];
    if (PLAYER_TEMP[playerid][VariableCaido] == 1) return SendClientMessage(playerid, -1, "No puedes hacer esto por que ya has sido abatido.");
    if (Esposando[playerid] == 1) {
        if (PLAYER_INFO[playerid][pCargos] == 1) {
            SetPlayerWantedLevelEx(playerid, PLAYER_INFO[playerid][pCargos] = 2);
            foreach(new i : Player) {
                if (PLAYER_INFO[i][pDuty] == 1) SetPlayerMarkerForPlayer(i, params[0], c2_color);
            }
        }
        TogglePlayerControllable(playerid, 1);
        SetPVarInt(playerid, "IsFrozen", 1);
        Esposando[playerid] = 0;
        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
        KillTimer(TimerEsposar[playerid]);
        format(chatadmin, sizeof(chatadmin), "[Radio] {FFFFFF}%s %s: {00CCFF}%s{FFFFFF} se resistio al arresto, inicio persecucion.", RangoPolicia(Oficial[playerid]), PlayerName(Oficial[playerid]), PLAYER_INFO[playerid][Nickname]);
        SendRadioMessage(1, TEAM_BLUE_COLOR, chatadmin, playerid, 1);
        format(string, sizeof(string), "[Radio de policia] (%s %s) dice: %s se resistio al arresto, inicio persecucion.", RangoPolicia(Oficial[playerid]), PlayerName(Oficial[playerid]), PLAYER_INFO[playerid][Nickname]);
        ProxDetector(15.0, playerid, string, COLOR_GRAD6, COLOR_GRAD5, COLOR_GRAD4, COLOR_GRAD3, COLOR_GRAD2);
    } else return 1;
    return 1;
}
CMD:entregar(playerid, params[]) {
    new string[158], patrulla;
    new day, month, year;
    getdate(year, month, day);
    patrulla = GetPlayerVehicleID(playerid);
    if (IsPlayerInAnyVehicle(playerid))
        if (PLAYER_INFO[playerid][pDuty] != 1) return SendClientMessage(playerid, COLOR_WHITE, "No estas autorizado para usar este comando");
    if (!EnComisaria(playerid)) return SendClientMessage(playerid, -1, "No estas en el area de entrega de ninguna comisaria");
    if (tiempoentrega[playerid] == 1) return SendClientMessage(playerid, COLOR_WHITE, "Solo puedes usar este comando cada {FF0000}10 segundos{FFFFFF}.");
    foreach(new i : Player) {
        if (EnAuto[i] == patrulla && PLAYER_INFO[i][pCargos] > 0) {
            RemovePlayerFromVehicle(i);
            Congelar(i);
            format(string, sizeof(string), "%s baja a %s de su vehiculo.", PLAYER_INFO[playerid][Nickname], PLAYER_INFO[i][Nickname]);
            ProxDetector(30.0, playerid, string, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES);
            SetTimerEx("EncerrandoNombre", 4000, false, "dd", playerid, i);
            SetTimerEx("Encerrando", 4800, false, "d", i);
            new Query[400];
            mysql_format(handle_db, Query, sizeof(Query), "INSERT INTO `log_arrestos` (Player, Fecha) VALUES ('%d', '%02d/%02d/%02d')", PLAYER_INFO[i][pID], day, month, year);
            mysql_tquery(handle_db, Query);
            new datosxd[50];
            tiempoentrega[playerid] = 1;
            new result = getRandomMoney(4550, 8432);
            DarDinero(playerid, result);
            SetTimerEx("dartiempoentrega", 10000, false, "d", playerid);
            format(datosxd, 200, "Recibes {00CC00}$%d{FFFFFF} por entregar un delicuente.", result);
            SendClientMessage(playerid, -1, datosxd);
        }
    }
    return 1;
}
funcion EfectoBalasGoma(playerid) {
    if (JugadorLogeado[playerid] != 1) return 1;
    ShowPlayerMessage(playerid, "Te has recuperado de la herida causada por una bala de goma.");
    Descongelar(playerid);
    PLAYER_TEMP[playerid][HeridoBalasGoma] = 0;
    return 1;
}
CMD:hurtar(playerid) {
    new string[220];
    if (!IsAIlegal(playerid)) return ShowPlayerMessage(playerid, "No puedes usar este comando.");
    foreach(new i : Player) {
        if (PLAYER_TEMP[i][HeridoBalasGoma] == 1) {
            if (PLAYER_TEMP[playerid][Hurtado] == i) return ShowPlayerMessage(playerid, "Ya hurtaste este sujeto.");
            if (!EstaEnP(playerid, i, 10.00)) return ShowPlayerMessage(playerid, "No estas cerca del sujeto.");
            format(string, sizeof(string), "%s hurta todas las pertenencias del herido %s.", PLAYER_INFO[playerid][Nickname], PLAYER_INFO[i][Nickname]);
            ProxDetector(30.0, playerid, string, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES);
            DROP_BACKPACK(i);
            ApplyAnimation(i, "WUZI", "CS_Dead_Guy", 4.0, 0, 0, 0, 1, 0);
            ShowPlayerMessage(i, "~r~Te han hurtado todas tus pertenencias.");
            PLAYER_INFO[i][pMateriales] = PLAYER_INFO[i][pMateriales] / 2 / 2;
            PLAYER_INFO[i][pCrack] = PLAYER_INFO[i][pCrack] / 2 / 2;
            PLAYER_TEMP[playerid][Hurtado] = i;
            PLAYER_INFO[i][pMedicamentos] = PLAYER_INFO[i][pMedicamentos] / 2 / 2;
            if (PLAYER_INFO[i][jDinero] > 0) QuitarDinero(i, PLAYER_INFO[i][jDinero] / 2 / 2);
            DarDinero(playerid, PLAYER_INFO[i][jDinero] / 2 / 2);
            PLAYER_INFO[playerid][pMateriales] += PLAYER_INFO[i][pMateriales] / 2 / 2;
            PLAYER_INFO[playerid][pCrack] += PLAYER_INFO[i][pCrack] / 2 / 2;
            PLAYER_INFO[playerid][pMedicamentos] += PLAYER_INFO[i][pMedicamentos] / 2 / 2;
            PLAYER_INFO[playerid][Totems] += 2;
            ShowPlayerMessage(playerid, "~g~~h~Has recibido 2 Totems por hurtar.");
            ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 1, 1, 0, 0);
        }
    }
    return 1;
}
CMD:incautar(playerid) {
    new string[220];
    if (!IsAPolice(playerid)) return ShowPlayerMessage(playerid, "No puedes usar este comando.");
    if (PLAYER_INFO[playerid][pRango] < 3) return ShowPlayerMessage(playerid, "No puedes usar este comando.");
    if (PLAYER_TEMP[playerid][CoolDown_Incautar] > 0) return SendClientMessageEx(playerid, -1, "Debes esperar %d segudos para volver a usar este comando");
    foreach(new i : Player) {
        if (PLAYER_INFO[i][pCargos] > 4 && Esposando[i] == 2) {

            if (!EstaEnP(playerid, i, 10.00)) return ShowPlayerMessage(playerid, "No estas cerca del sujeto.");
            format(string, sizeof(string), "%s incauta todas las pertenencias de %s.", PLAYER_INFO[playerid][Nickname], PLAYER_INFO[i][Nickname]);
            ProxDetector(30.0, playerid, string, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES);
            DROP_BACKPACK(i);
            ApplyAnimation(i, "WUZI", "CS_Dead_Guy", 4.0, 0, 0, 0, 1, 0);
            ShowPlayerMessage(i, "Te han incautado todas tus pertenencias. No te devolveran nada.");
            PLAYER_INFO[i][pMateriales] = 0;
            PLAYER_INFO[i][pCrack] = 0;
            if (PLAYER_INFO[i][pMascara] > 0) PLAYER_INFO[i][pMascara] = 0;
            PLAYER_INFO[i][pMedicamentos] = 0;
            QuitarDinero(i, PLAYER_INFO[i][jDinero] - 200);
            PLAYER_INFO[playerid][Totems] += 2;
            PLAYER_TEMP[playerid][CoolDown_Incautar] += 3600;
            ShowPlayerMessage(playerid, "~g~Has recibido 2 Totems por desalojar al sujeto de todas sus pertenencias.");
            ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 1, 1, 0, 0);
        }
    }
    return 1;
}
CMD:liberar(playerid, params[]) {
    new id, Float:x, Float:y, Float:z, pName[32], string[128];
    GetPlayerName(playerid, pName, 32);
    if (!sscanf(params, "d", id)) {
        if (PLAYER_INFO[playerid][pDuty] == 1 && PLAYER_INFO[playerid][pFaccion] == 1 || PLAYER_INFO[playerid][pFaccion] == 2) {
            GetPlayerPos(id, x, y, z);
            if (PLAYER_INFO[id][pCargos] > 1) return 1;
            if (!IsPlayerInRangeOfPoint(playerid, 5.0, x, y, z)) return SendClientMessage(playerid, -1, "No estas cerca de este jugador");
            if (PLAYER_INFO[id][Agonizando] == 1 || Esposando[id] == 2 || EnPatrulla[id] == 1) {
                if (IsPlayerInAnyVehicle(id)) {
                    RemovePlayerFromVehicle(id);
                }
                PLAYER_INFO[id][Agonizando] = 0;
                Esposando[id] = 0;
                SetPlayerSpecialAction(id, SPECIAL_ACTION_NONE);
                PLAYER_INFO[id][pCargos] = 0;
                SetPlayerWantedLevelEx(id, PLAYER_INFO[id][pCargos]);
                TogglePlayerControllable(id, 1);
                PLAYER_TEMP[id][VariableCaido] = 0;
                SetPVarInt(id, "IsFrozen", 1);
                format(string, 128, "%s %s libera al sospechoso", RangoPolicia(playerid), pName);
                ProxDetector(15.0, playerid, string, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES);
            } else return SendClientMessage(playerid, -1, "El jugador debe estar abatido o esposado");
        }
    } else return SendClientMessage(playerid, -1, "Usa: {"COLOR_GM "}/liberar id");
    return 1;
}
CMD:1(playerid, params[]) {
    if (!IsAPolice(playerid)) return SendClientMessage(playerid, COLOR_WHITE, "Necesitas ser policia.");
    AccionesRol(playerid, "saca sus esposas del cinturon de su cinturon tactico.", 20);
    AccionesRol(playerid, "toma dichas esposas y se las pone al sujeto.", 20);
    return 1;
}
CMD:2(playerid, params[]) {
    if (!IsAPolice(playerid)) return SendClientMessage(playerid, COLOR_WHITE, "Necesitas ser policia.");
    AccionesRol(playerid, "se pone sus guantes de latex.", 20);
    AccionesRol(playerid, "procede a revisar al sujeto.", 20);
    return 1;
}
CMD:3(playerid, params[]) {
    new patrulla = GetPlayerVehicleID(playerid);
    if (!IsAPolice(playerid)) return SendClientMessage(playerid, COLOR_WHITE, "Necesitas ser policia.");
    if (!SAPD(patrulla) && !HELISAPD(patrulla) && !DEPORTIVOCOP(patrulla)) return SendClientMessage(playerid, -1, "Necesitas estar conduciendo un patrullero para arrestar a alguien.");
    AccionesRol(playerid, "saca un Megafono de su guantera y proceder hablar por el mismo.", 20);
    new string[128];
    format(string, sizeof(string), "(Megafono) %s: {3399FF}¡¡ {FFFFFF}Le habla la policia de San Andreas, detengase ahora mismo{3399FF} !!", PLAYER_INFO[playerid][Nickname]);
    ProxDetector(60.0, playerid, string, COLOR_MEGAPHONE, COLOR_MEGAPHONE, COLOR_MEGAPHONE, COLOR_MEGAPHONE, COLOR_MEGAPHONE);
    return 1;
}
CMD:4(playerid, params[]) {

    if (!IsAPolice(playerid)) return SendClientMessage(playerid, COLOR_WHITE, "Necesitas ser policia.");
    new string[128];
    format(string, sizeof(string), "%s grita: ¡Alto, le habla policia de San Andreas, detengase o procedere a abrir fuego!", PLAYER_INFO[playerid][Nickname]);
    if (strlen(string) < 128) ProxDetector(30.0, playerid, string, COLOR_WHITE, COLOR_WHITE, COLOR_WHITE, CHAT, CHAT2);
    format(string, sizeof(string), "¡¡Alto, le habla policia de San Andreas, detengase o procedere a abrir fuego!!");
    if (strlen(string) < 128) SetPlayerChatBubble(playerid, string, COLOR_WHITE, 60.0, 5000);
    return 1;
}
CMD:5(playerid, params[]) {
    if (!IsAPolice(playerid)) return SendClientMessage(playerid, COLOR_WHITE, "Necesitas ser policia.");
    AccionesRol(playerid, "toma su radio de su cinturon tactico y procede hablar por el mismo.", 20);
    return 1;
}
CMD:6(playerid, params[]) {
    if (!IsAPolice(playerid)) return SendClientMessage(playerid, COLOR_WHITE, "Necesitas ser policia.");
    AccionesRol(playerid, "toma al sujeto del brazo, seguidamente lo lleva hacia la patrulla", 20);
    AccionesRol(playerid, "abre la puerta de la patrulla y lo mete dentro, acto seguido cierra la puerta.", 20);
    return 1;
}

CMD:macros(playerid, params[]) {
    if (!IsAPolice(playerid)) return SendClientMessage(playerid, COLOR_WHITE, "Necesitas ser policia.");
    new string[2000];
    string = "{FFFFFF}¡Hola Agente de {3399FF}policia!\n {FFFFFF}Estos son los {3399FF}macros{FFFFFF} puedes utilizar para llevar acabo tus roles:\n{3399FF}(/1):{FFFFFF} Rol para esposar sujeto, {3399FF}(/2):{FFFFFF} Rol para revisar sujeto, {3399FF}(/3):{FFFFFF} Rol para hablar Megafono.\n {3399FF}(/4):{FFFFFF} Rol para advertir mientras corres, {3399FF}(/5):{FFFFFF} Rol para hablar por la radio de policia, {3399FF}(/6):{FFFFFF} Rol para subir al sujeto a la patrulla.";
    dialogs_ShowPlayerDialog(playerid, 500, DIALOG_STYLE_MSGBOX, "Macros para policias", string, "Cerrar", "");
    return 1;
}
CMD:arrastrar(playerid, params[]) {
    new ID;
    if (sscanf(params, "d", ID)) return SendClientMessage(playerid, COLOR_WHITE, "Usa: {"COLOR_GM "}/arrastrar id {FFFFFF}para que este jugador te siga.");
    if (PLAYER_INFO[playerid][pDuty] != 1) return SendClientMessage(playerid, COLOR_WHITE, "No estas con el uniforme de policia.");
    if (IsPlayerNPC(ID)) return 1;
    if (!IsPlayerConnected(ID)) return 1;
    if (PLAYER_INFO[ID][Agonizando] != 1 && Esposando[ID] != 2) return SendClientMessage(playerid, COLOR_WHITE, "El sospechoso no esta esposado o abatido.");
    if (PLAYER_INFO[ID][pCargos] == 0) return SendClientMessage(playerid, -1, "Este jugador no tiene nivel de busqueda.");
    Arrastrar(playerid, ID);
    return 1;
}
CMD:soltar(playerid, params[]) {
    new ID;
    if (sscanf(params, "d", ID)) return SendClientMessage(playerid, COLOR_WHITE, "Usa: {"COLOR_GM "}/soltar id {FFFFFF}para que este jugador te siga.");
    if (PLAYER_INFO[playerid][pDuty] != 1) return SendClientMessage(playerid, COLOR_WHITE, "No estas con el uniforme de policia.");
    if (IsPlayerNPC(ID)) return 1;
    if (!IsPlayerConnected(ID)) return 1;
    Darrastrar(playerid, ID);
    return 1;
}
CMD:arrestar(playerid, params[]) {
    new ID, Lugar, patrulla, Float:x, Float:y, Float:z;
    patrulla = GetPlayerVehicleID(playerid);
    if (sscanf(params, "dd", ID, Lugar)) return SendClientMessage(playerid, COLOR_WHITE, "Usa: {"COLOR_GM "}/arrestar id {FFFFFF}[{"COLOR_GM "}1{FFFFFF} para subirlo en el asiento izquierdo o {"COLOR_GM "}2{FFFFFF} en el derecho]");
    if (PLAYER_INFO[playerid][pDuty] != 1) return SendClientMessage(playerid, COLOR_WHITE, "No estas con el uniforme de policia.");
    //if(!SAPD(patrulla) && !HELISAPD(patrulla) && !DEPORTIVOCOP(patrulla)) return SendClientMessage(playerid,-1,"Necesitas estar conduciendo un patrullero para arrestar a alguien.");
    if (IsPlayerNPC(ID)) return 1;
    if (!IsPlayerConnected(ID)) return 1;
    if (PLAYER_INFO[ID][Agonizando] != 1 && Esposando[ID] != 2) return SendClientMessage(playerid, COLOR_WHITE, "El sospechoso no esta esposado o abatido.");
    if (PLAYER_INFO[ID][pCargos] == 0) return SendClientMessage(playerid, -1, "Este jugador no tiene nivel de busqueda.");
    if (!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, "Debes estar en una patrulla o helicoptero policial.");
    if (GetVehicleModel(GetPlayerVehicleID(playerid)) == 528 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 601) return SendClientMessage(playerid, -1, "Debes estar en una patrulla o helicoptero policial.");
    if (GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, -1, "Debes estar conduciendo la patrulla.");
    GetPlayerPos(ID, x, y, z);
    if (IsPlayerInRangeOfPoint(playerid, 40.0, x, y, z)) {
        switch (Lugar) {
            case 1 : PutPlayerInVehicle(ID, patrulla, 2);
            case 2 : PutPlayerInVehicle(ID, patrulla, 3);
            default: return 1;
        }
        if (PLAYER_INFO[ID][pMascaraPuesta] == 1) {
            PLAYER_INFO[ID][pMascaraPuesta] = 0;
            PLAYER_INFO[ID][pMascara] = 0;
            ShowPlayerMessage(ID, "~r~La polic?a te ha quitado tu m?scara.");
            SetPlayerName(ID, PLAYER_INFO[ID][Nickname]);
            if (IsPlayerAttachedObjectSlotUsed(ID, 2)) RemovePlayerAttachedObject(ID, 2);
        }
        QuitarArmas(ID);
        SetPlayerArmedWeapon(ID, 0);
        BajandoV[ID] = 0;
        EnAuto[ID] = patrulla;
        EnPatrulla[ID] = 1;
        PLAYER_INFO[ID][Agonizando] = 0;
        TogglePlayerControllable(ID, 0);
        PLAYER_TEMP[ID][VariableCaido] = 0;
        SetPVarInt(ID, "IsFrozen", 0);
        AccionesRol(playerid, "sube al detenido en su patrullero.", 20);
        if (GetPVarInt(ID, "Player:Follow") != INVALID_PLAYER_ID) {
            SetPVarInt(GetPVarInt(ID, "Player:Follow"), "Player:Lead", INVALID_PLAYER_ID);
            SetPVarInt(ID, "Player:Follow", INVALID_PLAYER_ID);
        }
        if (GetPVarInt(ID, "Player:Cuff")) {
            DeletePVar(ID, "Player:Cuff");
            SetPlayerSpecialAction(ID, SPECIAL_ACTION_NONE);
            //RemovePlayerAttachedObject( ID, 4 );
            //FreezePlayer( ID, true );
        }
    } else SendClientMessage(playerid, -1, "Acerca el patrullero para subir al prisionero.");
    return 1;
}
CMD:domiciliaria(playerid) {
    return RP_DomRequest(playerid);
}
stock EntrarFabricaPolis(playerid) {
    for(new ID = 1; ID < MAX_FABRICAS; ID++) {
        if (!FABRICAS_INFO[ID][f_VALID]) continue;
        if (IsAPolice(playerid)) {
            if (IsPlayerInRangeOfPoint(playerid, 3.0, FABRICAS_INFO[ID][f_POS][0], FABRICAS_INFO[ID][f_POS][1], FABRICAS_INFO[ID][f_POS][2])) {
                if (IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, "Tienes que estar parado en la puerta de la propiedad para poder entrar.");

                if (GetPlayerInterior(playerid) == 0) {
                    if (PLAYER_INFO[playerid][pCargos] >= 2) {
                        foreach(new i : Player) {
                            if (PLAYER_INFO[i][pFaccion] == 1 && PLAYER_INFO[i][pDuty] == 1 && EstaEnP(playerid, i, 30.00)) {
                                SendClientMessage(playerid, -1, "No puedes entrar si la policia te esta siguiendo.");
                                return 1;
                            }
                        }
                    }
                }
                CargarMapeosEx(playerid);
                NoTeleportHack(playerid);
                SetPosEx(playerid, -1976.39, 206.366, 1035.82, 90.0, FABRICAS_INFO[ID][f_INTERIOR], FABRICAS_INFO[ID][f_VW]);
                return 1;
            }
        }
    }
    return true;
}
stock EntrarInterior(playerid) {
    if (RP_TryMineTransition(playerid)) return 1;
    if (GetPVarInt(playerid, "EditandoMuebles")) {
        return SendClientMessage(playerid, -1, "No puedes hacer esto ahora, relogea en caso de bug.");
    }
    if (PLAYER_INFO[playerid][pTiempoCarcel] > 0) {
        if (GetPlayerInterior(playerid) != 0) return 1;
        new string[129];
        QuitarArmas(playerid);
        PLAYER_INFO[playerid][pCargos] = 0;
        ActualizarRadar();
        SetPlayerWantedLevelEx(playerid, PLAYER_INFO[playerid][pCargos]);
        SetPlayerColor(playerid, c0_color);
        SetPlayerInterior(playerid, 6);
        SetPlayerVirtualWorld(playerid, playerid);
        PLAYER_INFO[playerid][pTiempoJail] = 10 * 60;
        foreach(new i : Player) {
            if (JugadorLogeado[i] == 1) {
                if (PLAYER_INFO[i][pMuteos] == 1) {
                    format(string, sizeof(string), "%s fue sancionado por el AntiCheat razon: Incumplir Tiempo Carcel.", PLAYER_INFO[playerid][Nickname]);
                    SendClientMessage(i, 0xAA3333FF, string);
                }
            }
        }
        NoTeleportHack(playerid);
        SetPlayerPos(playerid, 346.870025, 309.259033, 999.155700);
        San[playerid] = 1;
    }
    if (RP_PublicEnter(playerid)) return 1;
    new FireID = CercaIncendio(playerid);
    if (FireID != -1) return ShowPlayerMessage(playerid, "~r~~h~¡No puedes entrar, la propiedad se esta quemando!");

    if (IsPlayerInRangeOfPoint(playerid, 2.0, -2521.0481, -624.9498, 132.7843)) // APSA entrada
    {
        SetPosEx(playerid, -1118.6176, 1275.4647, 1549.6744, 355.6106, 5, 5);
        CargarMapeosEx(playerid);
        return 1;
    }
    if (IsPlayerInRangeOfPoint(playerid, 2.0, -1115.7280, 1291.3303, 1549.6744)) // APSA  estudio
    {
        SetPosEx(playerid, -1101.2118, 1280.7987, 1551.4596, 355.6106, 5, 5);
        CargarMapeosEx(playerid);
        return 1;
    }
    if (IsPlayerInRangeOfPoint(playerid, 2.0, -1124.9226, 1277.2719, 1549.6744)) // APSA  helipuerto
    {
        SetPosEx(playerid, -2535.0879, -688.6660, 139.3164, 355.6106, 0, 0);
        CargarMapeosEx(playerid);
        return 1;
    }
    if (IsPlayerInRangeOfPoint(playerid, 2.0, 2016.6925, -2094.7124, 13.5469)) {
        new cabeza;
        GetPlayerFacingAngle(playerid, cabeza);
        //EntradaBomberos
        SetPosEx(playerid, 1437.9700, -1615.5300, 974.9464, cabeza, 4, 0, 1);
        if (!IsABombero(playerid)) {
            if (PLAYER_INFO[playerid][jSexo] == 1) ShowPlayerMessage(playerid, "Romina dice: bienvenido, ¿en que puedo ayudarle?");
            if (PLAYER_INFO[playerid][jSexo] == 2) ShowPlayerMessage(playerid, "Romina dice: bienvenida, ¿en que puedo ayudarle?");
        }
    }
    if (IsPlayerInRangeOfPoint(playerid, 2.0, 2042.1675, -2070.6011, 18.7472)) { //entrada garage bomberos
        new cabeza;
        GetPlayerFacingAngle(playerid, cabeza);
        SetPosEx(playerid, 1420.8352, -1605.9150, 974.9464, cabeza, 4, 0, 1);
        return 1;
    }
    if (IsPlayerInRangeOfPoint(playerid, 2.0, 1420.8352, -1605.9150, 974.9464)) { //Salida garage bomberos
        new cabeza;
        GetPlayerFacingAngle(playerid, cabeza);
        SetPosEx(playerid, 2042.1675, -2070.6011, 18.7472, cabeza, 0, 0, 1);
        return 1;
    }
    if (IsPlayerInRangeOfPoint(playerid, 2.0, 1368.9310, -1279.7756, 13.5469)) { //PaintBall
        SetPlayerInterior(playerid, 1);
        SetPlayerPosEx(playerid, 285.4624, -41.7981, 1001.5156, 357.7615);

    }
    if (IsPlayerInRangeOfPoint(playerid, 2.0, 1186.2395, -1376.4542, 13.5704)) {
        SetPlayerPos(playerid, -2572.1125, 312.8246, -20.2871);
        SetPlayerFacingAngle(playerid, 179.1108);
    }
    if (IsPlayerInRangeOfPoint(playerid, 2.0, -2572.1125, 312.8246, -20.2871)) {
        SetPlayerPos(playerid, 1186.2395, -1376.4542, 13.5704);
        SetPlayerFacingAngle(playerid, 266.8450);
    }
    // Las transiciones de mina se resuelven al inicio, con retorno inmediato.
    if (IsPlayerInRangeOfPoint(playerid, 5.0, 1399.4634, -1228.7635, 13.5469) && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) {
        if (PLAYER_INFO[playerid][pTiempoDepa] == 0) return PUSH(playerid, "No tienes un piso alquilado");
        SetPlayerPosEx(playerid, 1403.9419, -1436.6149, -39.1775);
        SetPlayerVirtualWorld(playerid, PLAYER_INFO[playerid][pID]);
        SetPlayerInterior(playerid, 1);

        return 1;
    }

    if (IsPlayerInRangeOfPoint(playerid, 5.0, 1403.9419, -1436.6149, -39.1775) && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) {
        SetPlayerPosEx(playerid, 1399.4634, -1228.7635, 13.5469);
        SetPlayerVirtualWorld(playerid, 0);
        SetPlayerInterior(playerid, 0);
        return 1;
    }

    for(new et = 0; et < MAX_GARAGES; et++) {
        if (Estacionamientos[et][eEnUso] > 0) {
            if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) {
                if (IsPlayerInRangeOfPoint(playerid, 2.0, Estacionamientos[et][PosX], Estacionamientos[et][PosY], Estacionamientos[et][PosZ])) {
                    SetPosEx(playerid, Estacionamientos[et][SalidX], Estacionamientos[et][SalidY], Estacionamientos[et][SalidZ], Estacionamientos[et][SalidA], Estacionamientos[et][eInterior], Estacionamientos[et][eMundoVirtual]);
                    CargarMapeosEx(playerid);
                }
            }
        }
    }
    EntrarFabricaPolis(playerid);
    for(new ID = 1; ID < MAX_FABRICAS; ID++) {
        if (!FABRICAS_INFO[ID][f_VALID]) continue;
        if (FABRICAS_INFO[ID][f_FACCION_ID] != PLAYER_INFO[playerid][pFaccion]) continue;

        if (IsPlayerInRangeOfPoint(playerid, 3.0, FABRICAS_INFO[ID][f_POS][0], FABRICAS_INFO[ID][f_POS][1], FABRICAS_INFO[ID][f_POS][2])) {
            if (IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, "Tienes que estar parado en la puerta de la propiedad para poder entrar.");

            if (GetPlayerInterior(playerid) == 0) {
                if (PLAYER_INFO[playerid][pCargos] >= 2) {
                    foreach(new i : Player) {
                        if (PLAYER_INFO[i][pFaccion] == 1 && PLAYER_INFO[i][pDuty] == 1 && EstaEnP(playerid, i, 30.00)) {
                            SendClientMessage(playerid, -1, "No puedes entrar si la policia te esta siguiendo.");
                            return 1;
                        }
                    }
                }
            }
            CargarMapeosEx(playerid);
            NoTeleportHack(playerid);
            SetPosEx(playerid, -1976.39, 206.366, 1035.82, 90.0, FABRICAS_INFO[ID][f_INTERIOR], FABRICAS_INFO[ID][f_VW]);
            return 1;
        }
    }
    if (PLAYER_INFO[playerid][pTiempoJail] == 0) {
        for(new c = 0; c < MAX_PROPIEDADES; c++) {
            if (PropInfo[c][pEnUso] == 1) {
                if (IsPlayerInRangeOfPoint(playerid, 2.0, PropInfo[c][pPosX], PropInfo[c][pPosY], PropInfo[c][pPosZ])) {
                    if (IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, "Tienes que estar parado en la puerta de la propiedad para poder entrar.");
                    if (GetPlayerVirtualWorld(playerid) == 0) {
                        if (PLAYER_INFO[playerid][pCargos] >= 2) {
                            foreach(new i : Player) {
                                if (PLAYER_INFO[i][pFaccion] == 1 && PLAYER_INFO[i][pDuty] == 1 && EstaEnP(playerid, i, 30.00)) return SendClientMessage(playerid, -1, "No puedes entrar si la policia te esta siguiendo.");
                            }
                        }
                        if (PLAYER_INFO[playerid][pID] != PropInfo[c][pIDPropietario] && PropInfo[c][pAbierta] == 0) return SendClientMessage(playerid, -1, "La propiedad esta cerrada, solo el Dueño puede entrar.");
                        if (PropInfo[c][pAbierta] == 0 && PropInfo[c][pIDPropietario] == PLAYER_INFO[playerid][pID]) {
                            SendClientMessage(playerid, -1, "La puerta se encuentra cerrada, escribe {"                        COLOR_GM "}/abrir puerta{FFFFFF} para abrirla.");
                            ShowPlayerMessage(playerid, "Puedes administrar tu ~y~propiedad~w~ usando el comando ~b~/casa");
                        }
                        SetPosEntrar(playerid, PropInfo[c][pPosXS], PropInfo[c][pPosYS], PropInfo[c][pPosZS], PropInfo[c][pPosAS], PropInfo[c][pInteriorID], PropInfo[c][pVW]);
                        if (PropInfo[c][pEmisora] != 0) {
                            foreach(new id : Player) {
                                if (Emisoras[id][CabinaOcupada] == PropInfo[c][pEmisora]) {
                                    if (Emisoras[id][TransEmisora] == 1) {
                                        MensajeEx(playerid, 0xFFFFFFFF, "{FFFFFF}Escuchando radio {009AFF}%s", Emisoras[id][NombreEmisora]);
                                        new stringa[70];
                                        format(stringa, sizeof(stringa), "http://"                            EMISORA_URL "?sid=%d", Emisoras[id][EmisoraID]);
                                        ReproducirEmisora(playerid, PropInfo[c][pEmisora], stringa);
                                    }
                                }
                            }
                        }
                    }
                }
                if (IsPlayerInRangeOfPoint(playerid, 2.0, PropInfo[c][pRoperoX], PropInfo[c][pRoperoY], PropInfo[c][pRoperoZ]) && GetPlayerVirtualWorld(playerid) == PropInfo[c][pVW]) {
                    if (IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, "Tienes que estar parado en la puerta de la propiedad para poder entrar.");
                    if (PLAYER_INFO[playerid][pID] == PropInfo[c][pIDPropietario] && PropInfo[c][pRoperoAbierto] == 0) {
                        AccionesRol(playerid, "abre el ropero, entra y lo cierra rapidamente.", 20);
                        SendClientMessage(playerid, -1, "El ropero esta cerrado, usa {"                    COLOR_GM "}/abrir ropero{FFFFFF} para abrirlo.");
                    }
                    if (PLAYER_INFO[playerid][pID] != PropInfo[c][pIDPropietario] && PropInfo[c][pRoperoAbierto] == 0) return SendClientMessage(playerid, -1, "El ropero esta cerrado.");
                    CargarMapeosEx(playerid);
                    NoTeleportHack(playerid);
                    SetPosEntrar(playerid, 254.2685, -41.5420, 1002.0308, 267.0000, 14, GetPlayerVirtualWorld(playerid));
                }
                if (IsPlayerInRangeOfPoint(playerid, 1.0, 274.6613, 311.1681, 1009.1297) && GetPlayerVirtualWorld(playerid) == PropInfo[c][pVW] && GetPlayerInterior(playerid) == 4) {
                    new Float:Pos[4], InteriorJ;
                    ObtenerPosicionEntradaCasa(PropInfo[c][pInterior], Pos[0], Pos[1], Pos[2], Pos[3], InteriorJ);
                    if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) SetPosEntrar(playerid, PropInfo[c][pPosXS], PropInfo[c][pPosYS], PropInfo[c][pPosZS], PropInfo[c][pPosAS], PropInfo[c][pInteriorID], PropInfo[c][pVW]);
                    else SendClientMessage(playerid, -1, "Necesitas estar parado en la puerta para entrar.");
                }
            }
        }
    }
    if (IsPlayerInRangeOfPoint(playerid, 2.0, 214.7758, 126.6979, 999.0216)) // Azotea sapd
    {
        if (PLAYER_INFO[playerid][pDuty] == 0) return SendClientMessage(playerid, -1, "No se te permite ingresar aca.");
        SetPosEntrar(playerid, 1558.0908, -1675.5757, 28.3955, 271.5697, 0, 0);
    }
    if (IsPlayerInRangeOfPoint(playerid, 2.0, 1094.0945, 1597.0083, 12.5469)) // Estadio
    {
        if (IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, "Tienes que estar parado en la puerta de la propiedad para poder entrar.");
        if (HabilitarCarreras == 0) return SendClientMessage(playerid, -1, "El estadio esta cerrado, consulta los horarios en la boleteria.");
        if (PLAYER_INFO[playerid][@Nivel] >= 4) {
            if (Armado(playerid) && PLAYER_INFO[playerid][pDuty] != 1) return SendClientMessage(playerid, -1, "No puedes entrar armado al estadio.");
            if (EntradaCarrera[playerid] == false) return SendClientMessage(playerid, -1, "Debes comprar una entrada en la boleteria primero.");
            if (PLAYER_INFO[playerid][pCargos] > 0) return SendClientMessage(playerid, -1, "No puedes entrar si la policia te esta siguiendo.");
            SetPosEntrar(playerid, -1387.9806, -324.9726, 1052.0834, 3.5876, 7, 7);
            CargarMapeosEx(playerid);
            Boleto[playerid] = false;
        }
    }
    if (IsPlayerInRangeOfPoint(playerid, 1.5, -234.4394, 2778.2483, 62.2608)) SetPosEntrar(playerid, 651.6872, 2538.2026, -89.4551, 270.0000, 1, 1); // Militar
    if (IsPlayerInRangeOfPoint(playerid, 2.0, 186.8628, 1428.6979, 10.5912) && PLAYER_INFO[playerid][pTiempoCarcel] >= 1 && PuedenSalirPatio == true) return SetPosEntrar(playerid, 168.1524, 1436.1014, 1084.8462, 0, 15, 15); // Celdas Fort Carson
    if (IsPlayerInRangeOfPoint(playerid, 2.0, 1742.9551, -1864.2202, 13.5741)) return SetPosEntrar(playerid, -2029.7441, -118.6951, 1038.8187, 355.6106, 5, 5); // Unity Station
    if (IsPlayerInRangeOfPoint(playerid, 2.0, 2495.4424, -1691.1359, 14.7656)) return SendClientMessage(playerid, -1, "Solamente los miembros de la banda pueden ingresar a la propiedad.");


    if (IsPlayerInRangeOfPoint(playerid, 1.3, 1420.8903, -1180.1770, 25.9922)) //Entrada departamento //Antes 1423.4301,-1180.1801,25.9922
    {
        if (Armado(playerid) && !IsAPolice(playerid)) return SendClientMessage(playerid, -1, "No puedes entrar armado al Departamento.");
        if (IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, "Tienes que estar parado en la puerta de la propiedad para poder entrar.");
        SetPosEntrar(playerid, 357.5344, 1815.1636, -48.4684, 87.4881, 1, 1);
    }

    //	if(IsPlayerInRangeOfPoint(playerid, 2.0, 1122.7065,-2036.9232,69.8942))	return SendClientMessage(playerid,-1,"Solamente los miembros de la banda pueden ingresar a la propiedad.");
    if (IsPlayerInRangeOfPoint(playerid, 2.0, 649.0013, -1360.7864, 13.5868)) // Estudio de Radio y Television
    {
        if (PLAYER_INFO[playerid][@Nivel] == 1) return SendClientMessage(playerid, -1, "Necesitas aumentar de nivel para ingresar al Estudio de Radio y Television.");
        if (PLAYER_INFO[playerid][pCargos] > 0) return SendClientMessage(playerid, -1, "La policia te esta buscando, no puedes entrar al Estudio de radio y Television.");
        return SetPosEntrar(playerid, 387.4330, 194.3359, 1040.1078, 185.9930, 5, 5);
    }
    if (IsPlayerInRangeOfPoint(playerid, 2.0, 224.2623, 1443.8137, 10.8052)) // Interior FC
    {
        if (Armado(playerid) && !IsAPolice(playerid)) return SendClientMessage(playerid, -1, "No puedes entrar armado a la penitenciaria.");
        return SetPosEntrar(playerid, 203.4271, 1417.9021, 1091.2000, 278.1793, 15, 15);
    }
    if (IsPlayerInRangeOfPoint(playerid, 2.0, 2229.6833, -1721.4192, 13.5627)) return SetPosEx(playerid, 772.2999, -5.2435, 1000.7286, 0, 5, 0); // GYM Ganton
    if (IsPlayerInRangeOfPoint(playerid, 2.0, 2014.8400, 1150.4700, 10.9203)) return SetPosEntrar(playerid, 966.1780, -53.2595, 1001.2200, 90.0000, 3, 0); //Burdel
    if (IsPlayerInRangeOfPoint(playerid, 2.0, 824.8679, 860.2719, 12.3028)) return SetPosEntrar(playerid, -229.1293, 1401.1205, 27.7656, 0, 18, 0); // Bar Cantera
    //if(IsPlayerInRangeOfPoint(playerid, 2.0, 2492.1536,924.8977,11.0234)) return SetPosEntrar(playerid,-2191.3962,-82.6744,1016.4689,90.0000,8,0); // Iglesia LV
    if (IsPlayerInRangeOfPoint(playerid, 2.0, -1820.8500, -125.7650, 5.7484)) return SetPosEntrar(playerid, 502.0160, -67.6595, 998.7578, 180, 11, 3); //bar sf
    if (IsPlayerInRangeOfPoint(playerid, 2.0, -1724.9301, -26.2651, 3.5547)) // ALBERGUE ENTRAR
    {
        if (IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, "Tienes que estar parado en la puerta de la propiedad para poder entrar.");
        if (Armados(playerid) && !IsAPolice(playerid)) return SendClientMessage(playerid, -1, "No puedes entrar armado.");
        if (PLAYER_INFO[playerid][pCargos] > 0) return SendClientMessage(playerid, -1, "La policia te esta buscando, no puedes entrar a esta propiedad.");
        SetPosEntrar(playerid, 2332.5701, -1254.7500, 1026.2899, 0.0000, 1, 19);
        CargarMapeosEx(playerid);
        return 1;
    }
    if (IsPlayerInRangeOfPoint(playerid, 2.0, 1836.9700, -1682.4700, 13.4258)) // ALHAMBRA ENTRAR
    {
        if (IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, "Tienes que estar parado en la puerta de la propiedad para poder entrar.");
        if (Armados(playerid) && !IsAPolice(playerid)) return SendClientMessage(playerid, -1, "No puedes entrar armado.");
        if (PLAYER_INFO[playerid][pCargos] > 0) return SendClientMessage(playerid, -1, "La policia te esta buscando, no puedes entrar a esta propiedad.");
        SetPosEntrar(playerid, 493.3470, -24.8391, 1000.7800, 90.0000, 17, 3);
        CargarMapeosEx(playerid);
        return 1;
    }

    if (IsPlayerInRangeOfPoint(playerid, 2.0, 1434.4745, -968.5344, 37.3876)) // ROBO BANCO
    {
        new string[256];
        format(string, sizeof(string), "* %s se mete por el conducto de ventilacion.", PLAYER_INFO[playerid][Nickname]);
        ProxDetector(15.0, playerid, string, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES);
        PlayerPlaySound(playerid, 1068, 0.0, 0.0, 0.0);
        SetPosEntrar(playerid, 992.6885, -1169.0198, 20.3868, 6, 6, 0);
        SendClientMessage(playerid, -1, "{FFFFFF}Una vez explotada la puerta tienen {FF0000}1{FFFFFF} minuto para robar todo lo que puedan, antes de que la puerta de emergencia del banco se active y los dejen encerrados.");
        return 1;
    }
    if (IsPlayerInRangeOfPoint(playerid, 2.0, 978.3593, -1170.2479, 12.6105)) // ROBO BANCO
    {
        SetPosEntrar(playerid, 979.5402, -1169.6628, 12.7304, 6, 6, 0);
        return 1;
    }

    if (IsPlayerInRangeOfPoint(playerid, 2.0, 2014.8101, 1107.0100, 10.9203)) // Club Striptease
    {
        if (IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, "Tienes que estar parado en la puerta de la propiedad para poder entrar.");
        if (Armados(playerid) && !IsAPolice(playerid)) return SendClientMessage(playerid, -1, "No puedes entrar armado.");
        if (PLAYER_INFO[playerid][pCargos] > 0) return SendClientMessage(playerid, -1, "La policia te esta buscando, no puedes entrar a esta propiedad.");
        for(new i = 0; i < 7; i++) {
