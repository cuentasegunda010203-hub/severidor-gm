                        if (PLAYER_INFO[playerid][pFaccion] == 0) return SendClientMessage(playerid, -1, "No perteneces a ninguna faccion.");
                        foreach(new i : Player) {
                            if (PLAYER_INFO[i][pFaccion] == PLAYER_INFO[playerid][pFaccion]) {
                                format(string2, 250, "{FFD100}%s", BandasInfo[PLAYER_INFO[playerid][pFaccion]][BNombre]);
                                format(string, 2000, "{FFFF00}%s{FFFF00}%s{FFFFFF}  (Rango: {FFA900}%d{FFFFFF})  {00D900}Conectado\n", string, NombreJugador(i), PLAYER_INFO[i][pRango]);
                            }
