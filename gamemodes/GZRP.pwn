            mysql_format(handle_db, Query, sizeof(Query), "UPDATE `p_vehicles` SET `Componentes1`='%d',`Componentes2`='%d',`Componentes3`='%d',`Componentes4`='%d',`Componentes5`='%d',`Componentes6`='%d',`Componentes7`='%d' WHERE id = '%d'", PLAYER_INFO[playerid][v5Componentes1], PLAYER_INFO[playerid][v5Componentes2], PLAYER_INFO[playerid][v5Componentes3], PLAYER_INFO[playerid][v5Componentes4], PLAYER_INFO[playerid][v5Componentes5], PLAYER_INFO[playerid][v5Componentes6], PLAYER_INFO[playerid][v5Componentes7], PLAYER_INFO[playerid][vID5]);
            mysql_tquery(handle_db, Query);
            mysql_format(handle_db, Query, sizeof(Query), "UPDATE `p_vehicles` SET `Componentes8`='%d',`Componentes9`='%d',`Componentes10`='%d',`Componentes11`='%d',`Componentes12`='%d',`Componentes13`='%d',`Componentes0`='%d' WHERE id = '%d'", PLAYER_INFO[playerid][v5Componentes8], PLAYER_INFO[playerid][v5Componentes9], PLAYER_INFO[playerid][v5Componentes10], PLAYER_INFO[playerid][v5Componentes11], PLAYER_INFO[playerid][v5Componentes12], PLAYER_INFO[playerid][v5Componentes13], PLAYER_INFO[playerid][v5Componentes0], PLAYER_INFO[playerid][vID5]);
