                        if (PLAYER_INFO[playerid][pRango] < 7) return SendClientMessage(playerid, -1, "No tienes los suficientes permisos.");
                        dialogs_ShowPlayerDialog(playerid, D_COLOR2, DIALOG_STYLE_LIST, "{FFFFFF}Selecciona el color para tu banda", DIALOG_CREATE_CREW_COLOR_String, "Seleccionar", "Atras");
                    }
