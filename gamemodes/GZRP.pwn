CMD:entrar(playerid, params[]) {
    if (Entrando[playerid] > 0) return 1;
    if (PLAYER_TEMP[playerid][pt_TIENE_BARRIL] > 0) return 1;

    if (PLAYER_TEMP[playerid][VariableCaido] == 1) return SendClientMessage(playerid, -1, "No puedes entrar abatido.");
    if (EnCombate[playerid] == 1) return SendClientMessage(playerid, -1, "No puedes hacer esto en combate.");
    NoTeleportHack(playerid);
    EntrarInterior(playerid);
    if (IsPlayerInRangeOfPoint(playerid, 1.0, 1204.8096, 12.6643, 1000.9219)) return MostrarMenuBailarinas(playerid); //Puticlub salon privado
    return 1;
}
CMD:darcoins(playerid, params[]) {
    new id, totem, string[128];
    if (PLAYER_INFO[playerid][pAdmin] < 7) return 0;
    if (!sscanf(params, "dd", id, totem)) {
        if (IsPlayerNPC(id)) return 1;
        PLAYER_INFO[id][Totems] += totem;
        format(string, 128, "{FFFFFF}Has recibido {00FF00}%d Totems{FFFFFF} por parte de la administracion.", totem);
        SendClientMessage(id, -1, string);
    } else return SendClientMessage(playerid, COLOR_WHITE, "Escribe {"COLOR_GM "}/darCoins {FFFFFF}<PlayerID> <Cantidad>");
    return 1;
}

CMD:daremisora(playerid, params[]) {
    new id, string[128];
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM) return 0;
    if (!sscanf(params, "d", id)) {
        if (IsPlayerNPC(id)) return 1;
        format(string, 128, "{FFFFFF}Le diste una emisora a {00ff00}%s", PlayerName(id));
        SendClientMessage(playerid, -1, string);
        format(string, 128, "{FFFFFF}El administrador %s te ofrecio crear una {366397}emisora", PlayerName(playerid));
        SendClientMessage(id, -1, string);
        dialogs_ShowPlayerDialog(id, COMPRARRADIO, DIALOG_STYLE_INPUT, "Crear estacion de radio", "Ingresa el nombre de tu nueva estacion de radio:", "Crear", "Cancelar");
    } else return SendClientMessage(playerid, -1, "Escribe {"COLOR_GM "}/daremisora {FFFFFF}<PlayerID>");
    return 1;
}
CMD:quitaremisora(playerid, params[]) {
    new id, string[128];
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM) return 0;
    if (!sscanf(params, "d", id)) {
        if (IsPlayerNPC(id)) return 1;
        format(string, 128, "{FFFFFF}Le quitaste la emisora a %s", PlayerName(id));
        SendClientMessage(playerid, -1, string);
        format(string, 128, "{FFFFFF}El administrador %s te quito tu{366397}emisora", PlayerName(playerid));
        SendClientMessage(playerid, -1, string);
        Emisoras[id][TieneEmisora] = 0;
        GuardarCuenta(id);
    } else return SendClientMessage(playerid, -1, "Escribe {"COLOR_GM "}/quitaremisora {FFFFFF}<PlayerID>");
    return 1;
}
CMD:allcoins(playerid, params[]) {
    new cantidad, string[128];
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM) return 0;
    if (!sscanf(params, "d", cantidad)) {
        foreach(new i : Player) {
            if (IsPlayerConnected(i) && !IsPlayerNPC(i)) {
                format(string, 128, "{FFFFFF}Has recibido {00FF00}%d Totems{FFFFFF} de parte de la administracion, ¡felicidades!", cantidad);
                SendClientMessage(i, -1, string);
                PLAYER_INFO[i][Totems] += cantidad;
            }
        }
    } else return SendClientMessage(playerid, COLOR_WHITE, "Escribe {"COLOR_GM "}/allCoins {FFFFFF}<Cantidad>");
    return 1;
}

CMD:regalos(playerid, params[]) {

    if (PLAYER_INFO[playerid][pAdmin] >= 7) {
        SendClientMessage(playerid, -1, "El servidor sufrio una sobre valoracion en la economía, intente mas tarde.");
        return 1;
    } else return 0;
}
CMD:pregalos(playerid, params[]) {
    if (JugadorLogeado[playerid] != 1) return 1;
    if (!strcmp(PLAYER_INFO[playerid][Nickname], "Williangel_Vera", true) || !strcmp(PLAYER_INFO[playerid][Nickname], "Anorak", true) || !strcmp(PLAYER_INFO[playerid][Nickname], "Jackson_Wang", true)) {
        if (PLAYER_INFO[playerid][pAdmin] >= 7) {
            new mensaje[256], string[24];
            if (PayDayActive == true) string = "Activo";
            else string = "Inactivo";
            format(mensaje, sizeof(mensaje), "Medicamentos.\nCrack.\nMarihuana.\nCaramelos.\nPiezas de armas.\nPatines\nDinero\nCoins\nMonedas "SERVER_COIN2 "\nPago diario (%s)", string);
            dialogs_ShowPlayerDialog(playerid, D_REGALOS, DIALOG_STYLE_LIST, "{00CC00}menu de regalos | "SERVER_COIN2 "RP", mensaje, "Siguiente", "Cerrar");
            return 1;
        }
    }
    return 1;
}

stock MostrarDepartamento(playerid) {
    SetPosEx(playerid, 1372.4722, -1197.9072, 69.5106, 173.6606, 0, PLAYER_INFO[playerid][pID]);
    KillTimer(TimerDepa[playerid]);
    FaseDepa[playerid] = 1;
    TimerDepa[playerid] = SetTimerEx("CamaraDepaI", 100, false, "d", playerid);
    MostrarCartelCD(playerid);
    SelectTextDraw(playerid, 0xe8d08fFF);
    return 1;
}
stock MostrarCamaraLogin(playerid) {
    SetTimerEx("CRLMove", 200, 0, "i", playerid);
    return 1;
}
forward CamaraDepaI(playerid);
public CamaraDepaI(playerid) {
    KillTimer(TimerDepa[playerid]);
    switch (FaseDepa[playerid]) {
        case 1: {
            FaseDepa[playerid]++;
            TimerDepa[playerid] = SetTimerEx("CamaraDepaI", 7000, false, "d", playerid);
            InterpolateCameraPos(playerid, 1371.875488, -1199.039062, 71.910568, 1371.875488, -1199.039062, 71.910568, 7000);
            InterpolateCameraLookAt(playerid, 1376.255615, -1201.269409, 70.993812, 1374.302490, -1203.298095, 70.925804, 7000);
        }
        case 2: {
            FaseDepa[playerid]++;
            TimerDepa[playerid] = SetTimerEx("CamaraDepaI", 7000, false, "d", playerid);
            InterpolateCameraPos(playerid, 1379.134521, -1217.984741, 70.712692, 1379.595336, -1224.484252, 70.712692, 7000);
            InterpolateCameraLookAt(playerid, 1377.611938, -1222.685180, 69.946197, 1375.666870, -1221.681518, 69.404403, 7000);
        }
        case 3: {
            FaseDepa[playerid] = 1;
            TimerDepa[playerid] = SetTimerEx("CamaraDepaI", 7000, false, "d", playerid);
            InterpolateCameraPos(playerid, 1378.886108, -1211.033203, 64.551017, 1378.886108, -1211.033203, 64.551017, 7000);
            InterpolateCameraLookAt(playerid, 1381.397338, -1215.174804, 63.309711, 1374.834106, -1213.716918, 63.376930, 7000);
        }
    }
    return 1;
}
