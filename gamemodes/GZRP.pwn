// Flecha original de acceso, aplicada a las puertas reconstruidas.
// No recoge objetos ni altera /entrar. Respeta pickups existentes del mismo exterior.
stock RP_EnsureDoorPickup(Float:x, Float:y, Float:z) {
    for (new id = 1, limite = Streamer_GetUpperBound(STREAMER_TYPE_PICKUP); id <= limite; id++) {
        if (!IsValidDynamicPickup(id)) continue;
        new mundo = Streamer_GetIntData(STREAMER_TYPE_PICKUP, id, E_STREAMER_WORLD_ID);
        new interior = Streamer_GetIntData(STREAMER_TYPE_PICKUP, id, E_STREAMER_INTERIOR_ID);
        if ((mundo != 0 && mundo != -1) || (interior != 0 && interior != -1)) continue;
        new Float:dx, Float:dy, Float:dz;
        Streamer_GetFloatData(STREAMER_TYPE_PICKUP, id, E_STREAMER_X, dx);
        Streamer_GetFloatData(STREAMER_TYPE_PICKUP, id, E_STREAMER_Y, dy);
        Streamer_GetFloatData(STREAMER_TYPE_PICKUP, id, E_STREAMER_Z, dz);
        dx -= x; dy -= y; dz -= z;
        if (dx * dx + dy * dy + dz * dz <= 2.25) return 0;
    }
    new pickup = CreateDynamicPickup(1318, 1, x, y, z, 0, 0, -1, 60.0);
    return IsValidDynamicPickup(pickup) ? 1 : -1;
}
stock RP_LoadOriginalDoorLabels() {
    if (RP_DoorLabelsReady) return 1;
    RP_DoorLabelsReady = true;
    new creados, existentes, fallidos;
    for (new i; i < sizeof(RP_OriginalDoors); i++) {
        new texto[220];
        format(texto, sizeof(texto), "{37db3f}%s\n\n{FFFFFF}Pulsar [ F ] Para Entrar.", RP_OriginalDoors[i][rp_doorName]);
        if(!RP_PublicSuppressDoor(i)) CreateDynamic3DTextLabel(texto, COLOR_WHITE, RP_OriginalDoors[i][rp_doorX], RP_OriginalDoors[i][rp_doorY], RP_OriginalDoors[i][rp_doorZ] + 0.6, 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0, -1, 60.0);
        new resultado = RP_PublicSuppressDoor(i)?0:RP_EnsureDoorPickup(RP_OriginalDoors[i][rp_doorX], RP_OriginalDoors[i][rp_doorY], RP_OriginalDoors[i][rp_doorZ]);
        if (resultado > 0) creados++;
        else if (resultado == 0) existentes++;
        else fallidos++;
        if (!strcmp(RP_OriginalDoors[i][rp_doorName], "24/7"))
            CreateDynamicMapIcon(RP_OriginalDoors[i][rp_doorX], RP_OriginalDoors[i][rp_doorY], RP_OriginalDoors[i][rp_doorZ], 17, 0, 0, 0, -1, 300.0, MAPICON_LOCAL);
    }
    printf("[RESTAURO] Puertas: %d textos, %d flechas creadas, %d pickups existentes, %d fallidos", sizeof(RP_OriginalDoors), creados, existentes, fallidos);
    return 1;
}
stock RP_LoadOriginalMaps() {
    if (RP_OriginalMapsReady) return 1;
    RP_OriginalMapsReady = true;
    mapaslz();
    RP_LoadConstructionMap();
    RP_LoadFerryMap();
    ResidenciasCreate(); // Incluye el mercado original de chalecos junto al GYM.
    RP_LoadOriginalDoorLabels();
    new iconos;
    for (new id = 1, limite = Streamer_GetUpperBound(STREAMER_TYPE_MAP_ICON); id <= limite; id++) {
        if (!IsValidDynamicMapIcon(id)) continue;
        Streamer_SetFloatData(STREAMER_TYPE_MAP_ICON, id, E_STREAMER_STREAM_DISTANCE, 300.0);
        Streamer_SetIntData(STREAMER_TYPE_MAP_ICON, id, E_STREAMER_STYLE, MAPICON_LOCAL);
        iconos++;
    }
    printf("[RESTAURO] Mapeos originales cargados: objetos=%d etiquetas=%d pickups=%d iconos=%d", CountDynamicObjects(), CountDynamic3DTextLabels(), CountDynamicPickups(), iconos);
    return 1;
}

