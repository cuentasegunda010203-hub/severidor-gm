        mysql_tquery(handle_db, Query);
    }
    return 1;
}

public OnPlayerEnterRaceCheckpoint(playerid) {
		#if DEBUG_GM == 1
    printf("(OnPlayerEnterRaceCheckpoint) PlayerID: %d", playerid);
		#endif
    
     
    if (EnCarreras[playerid] > 0) {

        if (IsPlayerInRangeOfPoint(playerid, 10, -1418.1959, -276.4316, 1051.0911)) {

            VueltasCarrera[playerid]++;
            new string2[50];
            format(string2, sizeof(string2), "Vuelta: %d/5", VueltasCarrera[playerid]);
            PlayerTextDrawSetString(playerid, CarreraT[playerid][0], string2);
            if (VueltasCarrera[playerid] >= 5) {

                NoTeleportHack(playerid);
                DisablePlayerRaceCheckpoint(playerid);
                SetPlayerPos(playerid, -1405.2959, -309.6738, 1052.0900);
                SetPlayerFacingAngle(playerid, 190.0000);
                TextDrawHideForPlayer(playerid, BoxCarrera[0]);
                TextDrawHideForPlayer(playerid, BoxCarrera[1]);
                TextDrawHideForPlayer(playerid, BoxCarrera[2]);
                TextDrawHideForPlayer(playerid, BoxCarrera[3]);
                PlayerTextDrawHide(playerid, CarreraPosicion[playerid]);
                PlayerTextDrawHide(playerid, CarreraT[playerid][0]);
                PlayerTextDrawHide(playerid, CarreraT[playerid][1]);
                PlayerTextDrawHide(playerid, CarreraT[playerid][2]);
                SlotGanador++;
                new string[250];
                if (SlotGanador == 1) {

                    new premio = 1;
                    switch (ParticipantesCarrera2) {

                        case 2 : premio = 1;
                        case 3 : premio = 2;
                        case 4 : premio = 3;
                        case 5 : premio = 4;
                        case 6 : premio = 5;
                        case 7 : premio = 6;
                        case 8 : premio = 7;
                        case 9 : premio = 8;
                        case 10 : premio = 9;
                    }
                    MensajeEx(playerid, -1, "¡Felicidades! Ganaste la carrera, tu premio es de {00CC00}%d Totems{FFFFFF}.", premio);
                    PLAYER_INFO[playerid][Totems] += premio;
                    format(string, sizeof(string), "El corredor {00CCFF}%s{FFFFFF} consiguio el primer puesto tardando {00CC00}%d:%d{FFFFFF}.", PLAYER_INFO[playerid][Nickname], PLAYER_TIMES[playerid][TiempoCarrera] / 60, PLAYER_TIMES[playerid][TiempoCarrera] % (60));
                    Webhook_Canales(1, string, 5, 0);
                    PLAYER_INFO[playerid][pPuntosCarrera] += 3;
                    new query[256];
                    mysql_format(handle_db, query, sizeof(query), "UPDATE usuarios SET PuntosCarrera = '%d' WHERE Username = '%e'", PLAYER_INFO[playerid][pPuntosCarrera], PLAYER_INFO[playerid][Nickname]);
                    mysql_tquery(handle_db, query);
                    RevisarLogro(playerid, 7);
                } else if (SlotGanador == 2) {

                    new premio = 1000;
                    switch (ParticipantesCarrera2) {

                        case 2 : premio = 1000;
                        case 3 : premio = 1500;
                        case 4 : premio = 2000;
                        case 5 : premio = 2500;
                        case 6 : premio = 3000;
                        case 7 : premio = 3500;
                        case 8 : premio = 4000;
                        case 9 : premio = 4500;
                        case 10 : premio = 5450;
                    }
                    MensajeEx(playerid, -1, "Lograste terminar la carrera en el segundo lugar, tu premio es de {00CC00}$%d{FFFFFF}.", premio);
                    DarDinero(playerid, premio);
                    SendClientMessage(playerid, -1, "Conseguiste 2 puntos en el torneo del mes.");
                    format(string, sizeof(string), "El corredor {00CCFF}%s{FFFFFF} consiguio el segundo puesto tardando {00CC00}%d:%d{FFFFFF}.", PLAYER_INFO[playerid][Nickname], PLAYER_TIMES[playerid][TiempoCarrera] / 60, PLAYER_TIMES[playerid][TiempoCarrera] % (60));
                    PLAYER_INFO[playerid][pPuntosCarrera] += 2;
                    new query[256];
                    mysql_format(handle_db, query, sizeof(query), "UPDATE usuarios SET PuntosCarrera = '%d' WHERE Username = '%e'", PLAYER_INFO[playerid][pPuntosCarrera], PLAYER_INFO[playerid][Nickname]);
                    mysql_tquery(handle_db, query);
                } else if (SlotGanador == 3) {

                    new premio = 600;
                    switch (ParticipantesCarrera2) {

                        case 3 : premio = 600;
                        case 4 : premio = 800;
                        case 5 : premio = 1000;
                        case 6 : premio = 1200;
                        case 7 : premio = 1400;
                        case 8 : premio = 1600;
                        case 9 : premio = 1800;
                        case 10 : premio = 2000;
                    }
                    MensajeEx(playerid, -1, "Lograste terminar la carrera en el tercer lugar, tu premio es de {00CC00}$%d{FFFFFF}.", premio);
                    DarDinero(playerid, premio);
                    SendClientMessage(playerid, -1, "Conseguiste 1 punto en el torneo del mes.");
                    format(string, sizeof(string), "El corredor {00CCFF}%s{FFFFFF} consiguio el tercer puesto tardando {00CC00}%d:%d{FFFFFF}.", PLAYER_INFO[playerid][Nickname], PLAYER_TIMES[playerid][TiempoCarrera] / 60, PLAYER_TIMES[playerid][TiempoCarrera] % (60));
                    PLAYER_INFO[playerid][pPuntosCarrera] += 1;
                    new query[256];
                    mysql_format(handle_db, query, sizeof(query), "UPDATE usuarios SET PuntosCarrera = '%d' WHERE Username = '%e'", PLAYER_INFO[playerid][pPuntosCarrera], PLAYER_INFO[playerid][Nickname]);
                    mysql_tquery(handle_db, query);
                } else if (SlotGanador > 3) {
                    format(string, sizeof(string), "El corredor {00CCFF}%s{FFFFFF} consiguio terminar en la posicion %d tardando {00CC00}%d:%d{FFFFFF}.", PLAYER_INFO[playerid][Nickname], SlotGanador, PLAYER_TIMES[playerid][TiempoCarrera] / 60, PLAYER_TIMES[playerid][TiempoCarrera] % (60));
                    MensajeEx(playerid, -1, "Lograste terminar la carrera en la posicion %d.", SlotGanador);
                }
                foreach(new i : Player) if (IsPlayerInRangeOfPoint(i, 250, -1408.8688, -304.5082, 1056.4351) && GetPlayerInterior(i) == 7) SendClientMessage(i, -1, string), SacarCarrera(playerid, 2);
                format(string, sizeof(string), "El piloto %s consiguio el primer puesto tardando %d:%d en el autodromo de LV.", PLAYER_INFO[playerid][Nickname], PLAYER_TIMES[playerid][TiempoCarrera] / 60, PLAYER_TIMES[playerid][TiempoCarrera] % (60));
                Webhook_Canales(1, string, 5, 0);
                if (ParticipantesCarrera <= 0) {

                    ResetearCarrera();
                    HabilitarCarreras = 0;
                    UpdateDynamic3DTextLabelText(TextoCarrera, COLOR_WHITE, "{FF3300}Boleteria cerrada\n{"                COLOR_GM "}Horarios de los eventos: {FFFFFF}5hs,11hs,17hs,23hs");
                }
            } else {

                PlayerPlaySound(playerid, 1056, 0.0, 0.0, 0.0);
                SetPlayerRaceCheckpoint(playerid, 0, -1357.2258, -130.9288, 1051.0356, -1365.4042, -280.5632, 1045.2321, 10);
                InfoCP[0][VueltasCarrera[playerid]]++;
                new string[100];
                format(string, sizeof(string), "%d/%d", InfoCP[0][VueltasCarrera[playerid]], ParticipantesCarrera2);
                PlayerTextDrawSetString(playerid, CarreraT[playerid][1], string);
            }
        }
        if (IsPlayerInRangeOfPoint(playerid, 10, -1357.2258, -130.9288, 1051.0356)) {

            PlayerPlaySound(playerid, 1056, 0.0, 0.0, 0.0);
            InfoCP[1][VueltasCarrera[playerid]]++;
            SetPlayerRaceCheckpoint(playerid, 0, -1365.4042, -280.5632, 1045.2321, -1504.3351, -154.6163, 1049.3365, 10);
            new string[100];
            format(string, sizeof(string), "%d/%d", InfoCP[1][VueltasCarrera[playerid]], ParticipantesCarrera2);
            PlayerTextDrawSetString(playerid, CarreraT[playerid][1], string);
        }
        if (IsPlayerInRangeOfPoint(playerid, 10, -1365.4042, -280.5632, 1045.2321)) {

            PlayerPlaySound(playerid, 1056, 0.0, 0.0, 0.0);
            SetPlayerRaceCheckpoint(playerid, 0, -1504.3351, -154.6163, 1049.3365, -1418.1959, -276.4316, 1051.0911, 10);
            InfoCP[2][VueltasCarrera[playerid]]++;
            new string[100];
            format(string, sizeof(string), "%d/%d", InfoCP[2][VueltasCarrera[playerid]], ParticipantesCarrera2);
            PlayerTextDrawSetString(playerid, CarreraT[playerid][1], string);
        }
        if (IsPlayerInRangeOfPoint(playerid, 10, -1504.3351, -154.6163, 1049.3365)) {

            PlayerPlaySound(playerid, 1056, 0.0, 0.0, 0.0);
            if (VueltasCarrera[playerid] == 4) SetPlayerRaceCheckpoint(playerid, 1, -1418.1959, -276.4316, 1051.0911, -1357.2258, -130.9288, 1051.0356, 10);
            else SetPlayerRaceCheckpoint(playerid, 0, -1418.1959, -276.4316, 1051.0911, -1357.2258, -130.9288, 1051.0356, 10);
            InfoCP[3][VueltasCarrera[playerid]]++;
            new string[100];
            format(string, sizeof(string), "%d/%d", InfoCP[3][VueltasCarrera[playerid]], ParticipantesCarrera2);
            PlayerTextDrawSetString(playerid, CarreraT[playerid][1], string);
        }
    }
    if (Cosechas[playerid][RutaCosecha] != 0) {

        if (IsPlayerInAnyVehicle(playerid)) {

            new autoid = GetPlayerVehicleID(playerid);
            if (COSECHA(autoid)) {

                if (Cosechas[playerid][ProgresoCosecha] > 19 && Cosechas[playerid][RutaCosecha] == 1 && Cosechas[playerid][CosechaLugar] == 1) return PagarCosechador(playerid);
                if (Cosechas[playerid][ProgresoCosecha] > 14 && Cosechas[playerid][RutaCosecha] == 2 && Cosechas[playerid][CosechaLugar] == 1) return PagarCosechador(playerid);
                if (Cosechas[playerid][ProgresoCosecha] > 14 && Cosechas[playerid][RutaCosecha] == 1 && Cosechas[playerid][CosechaLugar] == 2) return PagarCosechador(playerid);
                if (Cosechas[playerid][ProgresoCosecha] > 14 && Cosechas[playerid][RutaCosecha] == 2 && Cosechas[playerid][CosechaLugar] == 2) return PagarCosechador(playerid);
                Cosechas[playerid][ProgresoCosecha]++;
                RutaCosechador(playerid);
                SetPlayerProgressBarValue(playerid, Progressbar[playerid][Cosecha], Cosechas[playerid][ProgresoCosecha]);
                UpdatePlayerProgressBar(playerid, Progressbar[playerid][Cosecha]);
            }
        }
    }
    return 1;
}

public LoadTrucker(playerid) {
    if (!IsPlayerConnected(playerid)) return true;
    new cadenita[120];
    new randomgly = random(22);
    Descongelar(playerid);
    if (randomgly == 0) randomgly++;
    rtatrucker[playerid] = randomgly;
    //if(TrailerTruck[playerid] > 0) SetVehicleToRespawn(TrailerTruck[playerid]);
    TrailerTruck[playerid] = GetVehicleTrailer(GetPlayerVehicleID(playerid));
    TrailerTruck2[playerid] = GetPlayerVehicleID(playerid);
    StartPlayerPath2(playerid, ALocations[randomgly][LocX], ALocations[randomgly][LocY], ALocations[randomgly][LocZ], 5.0);
    format(cadenita, sizeof(cadenita), "Entrega el camion en ~g~%s.", ALocations[randomgly][LocationName]);
    PUSH(playerid, cadenita);
    return true;
}
funcion EntregarTrailerGasolinera(playerid) {
    ApplyDynamicActorAnimation(distribuidor, "PED", "IDLE_chat", 4.000000, 0, 0, 0, 1, 0);
    ApplyDynamicActorAnimation(distribuidor2, "PED", "IDLE_chat", 4.000000, 0, 0, 0, 1, 0);
    DisablePlayerCheckpoint(playerid);
    SendClientMessage(playerid, -1, "Entrega el trailer en la gasolinera");
    new g = PLAYER_TEMP[playerid][CargaGasolinera];
    RutaGasolinera(g, playerid);
    return 1;
}
public EntregarCamion(playerid) {
    PagarTrucker(playerid);
    rtatrucker[playerid] = 0;
    Chofer[GetPlayerVehicleID(playerid)] = INVALID_PLAYER_ID;
    new trailer = GetVehicleTrailer(GetPlayerVehicleID(playerid));
    //SetVehicleToRespawn(GetPlayerVehicleID(playerid));
    SetVehicleToRespawn(trailer);
    Descongelar(playerid);
    PLAYER_INFO[playerid][CargoTrailer] = 0;
    return true;
}
Hablar_Lorito(playerid) {
    if (PLAYER_TEMP[playerid][LoroHabla] == false) return 1;
    new PALABRA_LORITO[100 + MAX_PLAYER_NAME], PALABRA_LORITO2[100 + MAX_PLAYER_NAME];
    format(PALABRA_LORITO, sizeof(PALABRA_LORITO), "Loro de %s dice: %s", PLAYER_INFO[playerid][Nickname], FraseLoro[playerid]);
    ProxDetector(15.0, playerid, PALABRA_LORITO, 0xCDFFCEFF, 0xCDFFCEFF, 0xCDFFCEFF, 0xCDFFCEFF, 0xCDFFCEFF);
    format(PALABRA_LORITO2, sizeof(PALABRA_LORITO2), "(Loro): ¡%s!", FraseLoro[playerid]);
    SetPlayerChatBubble(playerid, PALABRA_LORITO2, COLOR_WHITE, 30.0, 6000);
    PLAYER_TIMES[playerid][pTIME_LORO] = gettime() + 90;
    return 1;
}
stock PagarTrucker(playerid) {
    if (PLAYER_INFO[playerid][vModelo] == 435 || PLAYER_INFO[playerid][vModelo2] == 435 || PLAYER_INFO[playerid][vModelo3] == 435 || PLAYER_INFO[playerid][vModelo4] == 435 || PLAYER_INFO[playerid][vModelo5] == 435) {
        if (PLAYER_TIMES[playerid][FarmearLZ] == 0) {
            new randlz = random(3) + 1;
            SendClientMessage(playerid, -1, "Recibiste bono de {00ff00}2 Totems{ffffff} por trabajar con trailer propio.");
            SendClientMessageEx(playerid, -1, "El gobierno te ha otorgado %d"SERVER_COIN " por cuidar tu carga.");
            PLAYER_TIMES[playerid][FarmearLZ] = 3600;
            PLAYER_INFO[playerid][Totems] += 2;
            PLAYER_INFO[playerid][pMateriales] += 50;
            Notificador2(playerid, "~g~Has recibido 50 legos por el viaje y +1 de Exp. ~w~Excelente sigue así.");
            PLAYER_INFO[playerid][jExperiencia]++;
            if (randlz < 0) randlz = 1;
            PLAYER_INFO[playerid][Moneda] += randlz;
            new rutero[128];
            format(rutero, sizeof(rutero), "[APSA] El camionero %s ha completado su ruta exitosamente. Al parecer los robos de trailers acabaron.", PLAYER_INFO[playerid][Nickname]);
            Webhook_Canales(1, rutero, 5, 0);
        }
    }
    new parchis[120];
    new rand = random(7000) + 3000;
    DarDinero(playerid, rand);
    format(parchis, sizeof(parchis), "¡Excelente entrega! Tus ganancias son: ~g~$%d", rand);
    Notificador2(playerid, parchis);
    AddPlayerJobPoints(playerid, T_Trailero);
}

public OnPlayerEnterCheckpoint(playerid) {
    if(RB_Deliver(playerid)) return 1;
		#if DEBUG_GM == 1
    printf("(OnPlayerEnterCheckpoint) PlayerID: %d", playerid);
		#endif
    CancelTracing(playerid);
    if (IsABombero(playerid)) {
        if (PLAYER_TEMP[playerid][CpIncendio] != 0) {
            PLAYER_TEMP[playerid][CpIncendio] = 0;
            ShowPlayerMessage(playerid, "~r~¡Apaga el fuego antes que sea demasiado tarde!");
        }
    }
    new autoid = GetPlayerVehicleID(playerid);
    if (IsPlayerInRangeOfPoint(playerid, 10.0, 346.5929, 912.4615, 20.4063)) {
        Congelar(playerid);
        SendClientMessage(playerid, -1, "Porfavor espera mientras se carga el camion.");
        SetTimerEx("LoadTrucker", 10000, false, "d", playerid);
        DisablePlayerCheckpoint(playerid);
    }
    if (IsPlayerInRangeOfPoint(playerid, 5.5, 360.2098, 884.3367, 20.4063)) {
        PagarTrucker(playerid);
        rtatrucker[playerid] = 0;
        Chofer[GetPlayerVehicleID(playerid)] = INVALID_PLAYER_ID;
        Descongelar(playerid);
    }
    if (rtatrucker[playerid] == 100) {
        if (IsPlayerInRangeOfPoint(playerid, 10.0, 8712.5752, -1783.7819, 86.8102)) {
            if (!IsTrailerAttachedToVehicle(GetPlayerVehicleID(playerid))) return PUSH(playerid, "~r~Debes tener enganchado el trailer para cargarlo");
            PUSH(playerid, "Cargando el ~r~tanque~w~. Por favor espera...");
            SetTimerEx("EntregarTrailerGasolinera", 10000, false, "d", playerid);
            new g = PLAYER_TEMP[playerid][CargaGasolinera];
            new total = Gasolineras[g][gMaxGasolina] - Gasolineras[g][gGasolina];
            SendClientMessageEx(playerid, -1, "{"        COLOR_GM "}Necesitaras ${00ff00}%d {"        COLOR_GM "}para cargar el tanque de la gasolinera. De lo contrario te rechazaran la carga.", total * 5);
            ApplyDynamicActorAnimation(distribuidor, "PED", "IDLE_chat", 4.000000, 0, 0, 0, 1, 0);
            ApplyDynamicActorAnimation(distribuidor2, "PED", "IDLE_chat", 4.000000, 0, 0, 0, 1, 0);
            Congelar(playerid);
            rtatrucker[playerid] = 0;
            DisablePlayerCheckpoint(playerid);
        }

    }
    if (rtatrucker[playerid] == 200) {
        new g = PLAYER_TEMP[playerid][CargaGasolinera];
        if (IsPlayerInRangeOfPoint(playerid, 10.0, Gasolineras[g][Poss2][0], Gasolineras[g][Poss2][1], Gasolineras[g][Poss2][2])) {
            if (!IsTrailerAttachedToVehicle(GetPlayerVehicleID(playerid))) return PUSH(playerid, "~r~Debes tener enganchado el trailer para cargarlo");
            PUSH(playerid, "Descargando el ~r~tanque~w~. Por favor espera...");
            SetTimerEx("PagarGasolinera", 10000, false, "d", playerid);
            Congelar(playerid);
            rtatrucker[playerid] = 0;
            DisablePlayerCheckpoint(playerid);
        }

    }
    if (rtatrucker[playerid] > 0) {
        if (rtatrucker[playerid] == 100) return 1;
        if (rtatrucker[playerid] == 200) return 1;
        if (IsPlayerInRangeOfPoint(playerid, 10.0, ALocations[rtatrucker[playerid]][LocX], ALocations[rtatrucker[playerid]][LocY], ALocations[rtatrucker[playerid]][LocZ])) {
            if (!IsTrailerAttachedToVehicle(GetPlayerVehicleID(playerid))) return PUSH(playerid, "~r~Mision fallida, debes traer enganchado el trailer");
            PUSH(playerid, "Descargando el ~r~trailer~w~. Por favor espera...");
            SetTimerEx("EntregarCamion", 10000, false, "d", playerid);
            Congelar(playerid);
            rtatrucker[playerid] = 0;
            DisablePlayerCheckpoint(playerid);
        }
    }
    for(new i = 0; i < sizeof CP_Fabricas_Barril; i++) {
        if (IsPlayerInRangeOfPoint(playerid, 5.0, CP_Fabricas_Barril[i][0], CP_Fabricas_Barril[i][1], CP_Fabricas_Barril[i][2])) {
            for(new ID = 1; ID < MAX_FABRICAS; ID++) {
                if (!FABRICAS_INFO[ID][f_VALID]) continue;
                if (PLAYER_INFO[playerid][pFaccion] != FABRICAS_INFO[ID][f_FACCION_ID]) continue;
                if (FABRICAS_INFO[ID][f_ACTIVIDAD] == ACTIVIDAD_NONE) continue;
                if (GetPlayerVehicleID(playerid) == FABRICAS_INFO[ID][f_VEHICLES][0]) {
                    if (i == FABRICAS_INFO[ID][f_ID]) {
                        FABRICAS_INFO[ID][f_ACTIVIDAD] = ACTIVIDAD_QUIMICOS;
                        SendClientMessage(playerid, -1, "Carga los {00CC00}tanques{FFFFFF} en la camioneta y regrosalos a la {ff3e3e}fabrica");
                        Streamer_Update(playerid);
                        DisablePlayerCheckpoint(playerid);
                    }
                }
            }
        }
    }
    for(new i = 0; i < sizeof CP_Fabricas_Ventas; i++) {
        for(new ID = 1; ID < MAX_FABRICAS; ID++) {
            if (!FABRICAS_INFO[ID][f_VALID]) continue;
            if (PLAYER_INFO[playerid][pFaccion] != FABRICAS_INFO[ID][f_FACCION_ID]) continue;
            if (FABRICAS_INFO[ID][f_ACTIVIDAD] == ACTIVIDAD_NONE) continue;

            if (IsPlayerInRangeOfPoint(playerid, 5.0, CP_Fabricas_Ventas[i][0], CP_Fabricas_Ventas[i][1], CP_Fabricas_Ventas[i][2])) {
                if (FABRICAS_INFO[ID][f_VENTA_ID] != i) continue;
                if (GetPlayerVehicleID(playerid) == FABRICAS_INFO[ID][f_VEHICLES][0]) {
                    if (FABRICAS_INFO[ID][f_VEHICLE_CAJAS] < 5) {
                        FABRICAS_INFO[ID][f_ACTIVIDAD] = ACTIVIDAD_NONE;
                        SendClientMessage(playerid, -1, "Necesitas tener todas las cajas de metanfetamina en la camioneta para poder venderlas.");
                        DisablePlayerCheckpoint(playerid);
                        return 1;
                    }
                    new total = 50000 + random(169), Float:Pos[3];
                    GetVehiclePos(FABRICAS_INFO[ID][f_VEHICLES][0], Pos[0], Pos[1], Pos[2]);
                    foreach(new x : Player) {
                        if (IsPlayerInRangeOfPoint(x, 50.0, Pos[0], Pos[1], Pos[2])) {
                            if (PLAYER_INFO[x][pFaccion] == FABRICAS_INFO[ID][f_FACCION_ID]) {
                                DarDinero(x, total);
                                SendClientMessageEx(x, -1, "Metanfetamina transportada con exito. Recibes {00CC00}$%d{FFFFFF} por haber participado.", total);
                            }
                        }
                    }
                    FABRICAS_INFO[ID][f_ALMACE_BARRIL] = 0;
                    FABRICAS_INFO[ID][f_VEHICLE_BARRIL] = 0;
                    FABRICAS_INFO[ID][f_VEHICLE_CAJAS] = 0;

                    for(new slot = 0; slot < MAX_OBJETOS; slot++) {
                        VEHICLE_OBJECTS[FABRICAS_INFO[ID][f_VEHICLES][0]][slot][vobject_ATTACHED] = false;
                        UpdateVehicleAttachedObject(FABRICAS_INFO[ID][f_VEHICLES][0], slot);
                    }
                    FABRICAS_INFO[ID][f_ACTIVIDAD] = ACTIVIDAD_NONE;
                    FABRICAS_INFO[ID][f_VENTA_ID] = 0;
                    DarDineroFabrica(ID, 1500000);
                    MandarMensajeFabrica(ID, "Tu fabrica recibio {00CC00}$1.500.000{FFFFFF} por la venta de la metanfetamina.");
                    Webhook_Fabrica(ID, "Tu fabrica recibio $1.500.000 por la venta de la metanfetamina");
                    DisablePlayerCheckpoint(playerid);
                    return 1;
                }
            }
        }
    }
    
    // Localizar amigo
    if (BuscandoAmigo[playerid] == 1) {

        SendClientMessage(playerid, -1, "Si tu amigo no se encuentra en el lugar, usa nuevamente el GPS para {"    COLOR_GM "}/encontrar amigo");
        DisablePlayerCheckpoint(playerid);
        BuscandoAmigo[playerid] = 0;
        return 1;
    }
    // Localizar
    if (Localizando[playerid] == 1) {

        SendClientMessage(playerid, -1, "Si no encuentras tu vehiculo, quiere decir que te lo han robado.");
        SendClientMessage(playerid, -1, "Por favor, llama a la policia para que lo recuperen.");
        DisablePlayerCheckpoint(playerid);
        Localizando[playerid] = 0;
        return 1;
    }
    // Cerrar GPS
    if (TieneGPSActivo[playerid] == 1) {

        TieneGPSActivo[playerid] = 0;
        DisablePlayerCheckpoint(playerid);
        return 1;
    }
    if (IsPlayerInRangeOfPoint(playerid, 10.0, 1908.3149, 935.6036, 10.9811)) return StartPlayerPath(playerid, 1999.6644, 933.4708, 10.7981, 10.0);
    if (IsPlayerInRangeOfPoint(playerid, 10.0, 1999.6644, 933.4708, 10.7981)) return StartPlayerPath(playerid, 2010.7413, 972.2186, 10.7965, 10.0);
    if (IsPlayerInRangeOfPoint(playerid, 10.0, 2010.7413, 972.2186, 10.7965)) return StartPlayerPath(playerid, 2046.9509, 856.2018, 6.8548, 10.0);
    if (IsPlayerInRangeOfPoint(playerid, 10.0, 2046.9509, 856.2018, 6.8548)) return StartPlayerPath(playerid, 1799.7394, 846.0538, 10.7795, 10.0);
    if (IsPlayerInRangeOfPoint(playerid, 10.0, 1799.7394, 846.0538, 10.7795)) return StartPlayerPath(playerid, 1708.5696, 465.3290, 30.7572, 10.0);
    if (IsPlayerInRangeOfPoint(playerid, 10.0, 1708.5696, 465.3290, 30.7572)) return StartPlayerPath(playerid, 1616.4937, 144.9171, 36.0788, 10.0);
    if (IsPlayerInRangeOfPoint(playerid, 10.0, 1616.4937, 144.9171, 36.0788)) return StartPlayerPath(playerid, 1667.7742, -795.5954, 55.8881, 10.0);
    if (IsPlayerInRangeOfPoint(playerid, 10.0, 1667.7742, -795.5954, 55.8881)) return StartPlayerPath(playerid, 1388.7821, -940.4939, 34.2972, 10.0);
    if (IsPlayerInRangeOfPoint(playerid, 10.0, 1388.7821, -940.4939, 34.2972)) return StartPlayerPath(playerid, 1262.7042, -937.6155, 42.5248, 10.0);
    if (IsPlayerInRangeOfPoint(playerid, 10.0, 1262.7042, -937.6155, 42.5248)) return StartPlayerPath(playerid, 1263.4191, -1035.9680, 32.0161, 10.0);
    if (IsPlayerInRangeOfPoint(playerid, 10.0, 1263.4191, -1035.9680, 32.0161)) return StartPlayerPath(playerid, 1162.8492, -1018.5044, 33.9312, 10.0);
    // Pruebas Academia LV
    if (EnPrueba[playerid]) {

        if (IsPlayerInRangeOfPoint(playerid, 3.0, 635.3787, -222.2007, 1276.7941)) {

            PruebaOnline[playerid] = true;
            DisablePlayerCheckpoint(playerid);
            StartPlayerPath(playerid, 608.2529, -221.9856, 1276.7941, 3.0);
            return 1;
        }
        if (IsPlayerInRangeOfPoint(playerid, 3.0, 608.2529, -221.9856, 1276.7941)) return StartPlayerPath(playerid, 593.6731, -221.9529, 1276.7941, 3.0);
        if (IsPlayerInRangeOfPoint(playerid, 3.0, 593.6731, -221.9529, 1276.7941)) return StartPlayerPath(playerid, 593.2269, -261.0184, 1276.7941, 3.0);
        if (IsPlayerInRangeOfPoint(playerid, 3.0, 593.2269, -261.0184, 1276.7941)) return StartPlayerPath(playerid, 587.6206, -248.2012, 1276.7941, 3.0);
        if (IsPlayerInRangeOfPoint(playerid, 3.0, 587.6206, -248.2012, 1276.7941)) return StartPlayerPath(playerid, 583.4668, -237.1445, 1276.7941, 3.0);
        if (IsPlayerInRangeOfPoint(playerid, 3.0, 583.4668, -237.1445, 1276.7941)) return StartPlayerPath(playerid, 552.4970, -235.8692, 1280.2028, 3.0);
        if (IsPlayerInRangeOfPoint(playerid, 3.0, 552.4970, -235.8692, 1280.2028)) return StartPlayerPath(playerid, 552.4763, -266.4409, 1276.7941, 3.0);
        if (IsPlayerInRangeOfPoint(playerid, 3.0, 552.4763, -266.4409, 1276.7941)) return StartPlayerPath(playerid, 598.8328, -266.1846, 1276.7941, 3.0);
        if (IsPlayerInRangeOfPoint(playerid, 3.0, 598.8328, -266.1846, 1276.7941)) return StartPlayerPath(playerid, 636.0906, -230.4454, 1276.7941, 3.0);
        if (IsPlayerInRangeOfPoint(playerid, 3.0, 636.0906, -230.4454, 1276.7941)) {

            new tempo[160];
            DisablePlayerCheckpoint(playerid);
            if (PLAYER_TIMES[playerid][TiempoAcademia] < 60) format(tempo, 160, "{00CCFF}%s{FFFFFF} termino la prueba fisica en {00CC00}%d segundos{FFFFFF}.", PLAYER_INFO[playerid][Nickname], PLAYER_TIMES[playerid][TiempoAcademia]);
            else if (PLAYER_TIMES[playerid][TiempoAcademia] >= 60) format(tempo, 160, "{00CCFF}%s{FFFFFF} termino la prueba fisica en {00CC00}%d minutos con %d segundos{FFFFFF}.", PLAYER_INFO[playerid][Nickname], PLAYER_TIMES[playerid][TiempoAcademia] / 60, PLAYER_TIMES[playerid][TiempoAcademia] % (60));
            foreach(new i : Player) {

                if (EnAcademia(i)) {

                    SendClientMessage(i, -1, tempo);
                }
            }
            PLAYER_TIMES[playerid][TiempoAcademia] = 0;
            PruebaOnline[playerid] = false;
            EnPrueba[playerid] = false;
            return 1;
