                PropInfo[id][pLabel5] = CreateDynamic3DTextLabel("{FFFFFF}Pulsa {"            COLOR_GM "}'H'{FFFFFF} para ingresar al garaje.", COLOR_WHITE, PropInfo[id][pGX], PropInfo[id][pGY], PropInfo[id][pGZ] + 0.6, 7.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, 0, 0, -1, 100.0);
            }
