            PLAYER_INFO[playerid][v3Z] = z3;
            GetVehicleZAngle(autos3[playerid], z_a3);
            PLAYER_INFO[playerid][v3A] = z_a3;
            PLAYER_INFO[playerid][pVidaV3] = VidaV3;
