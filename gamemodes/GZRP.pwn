            }
            if (response) {
                if (IsPlayerConnected(playerid)) {
                    new hashdb[64 + 1], query2[128], pNameL[128];
                    mysql_format(handle_db, query2, sizeof query2, "SELECT Username FROM usuarios WHERE Username = '%e'", PLAYER_INFO[playerid][Nickname]);
                    new Cache:result = mysql_query(handle_db, query2, true);
