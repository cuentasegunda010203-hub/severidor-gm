    FABRICAS_INFO[ID][f_LABELS][3] = CreateDynamic3DTextLabel("{FFFFFF}Pulsa {009AFF}'H'{FFFFFF} para salir de la propiedad.", -1, -1976.1282, 212.3176, 1035.8162, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, FABRICAS_INFO[ID][f_VW], FABRICAS_INFO[ID][f_INTERIOR], -1, 10.0);
