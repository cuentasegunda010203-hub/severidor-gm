                        format(item, sizeof(item), "%s\n{FFFFFF}Rango 1: {ff3364}%s{FFFFFF}\n", item, BandasInfo[banda][BRango1]);
                        format(item, sizeof(item), "%s\nRango 2: {ff3364}%s{FFFFFF}\n", item, BandasInfo[banda][BRango2]);
                        format(item, sizeof(item), "%s\nRango 3: {ff3364}%s{FFFFFF}\n", item, BandasInfo[banda][BRango3]);
