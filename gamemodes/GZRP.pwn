                    case 1 :  {
                        dialogs_ShowPlayerDialog(playerid, DIALOG_KICKPLAYER_EVENT, DIALOG_STYLE_INPUT, "{ffa500}Expulsar jugador del evento", "{FFFFFF}Ingresa la ID del jugador a expulsar:", "Aceptar", "Atras");
                    }
                    case 2 :  {
                        new str[256];
                        format(str, sizeof(str), "{ffa500}» {FFFFFF}Dar un vehiculo a cada jugador\n{ffa500}» {FFFFFF}Dar un auto a la mitad de los jugadores\n{ffa500}» {FFFFFF}Eliminar vehículo de los participantes\n{ffa500}» {FFFFFF}Setear vida de vehículos");
