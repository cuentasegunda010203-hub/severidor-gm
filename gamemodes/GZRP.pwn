CMD:mariainfo(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LVL_GLOBAL1) return 0;
    for(new e; e < MAX_MARIHUANA; e++) {
        if (EstaEn(playerid, 2.0, MariInfo[e][pX], MariInfo[e][pY], MariInfo[e][pZ])) {
            new string[150];
            format(string, sizeof(string), "Esta planta tiene la ID %d | Plantador: %s | Estado: %d | Creado %d.", MariInfo[e][IDMaria], MariInfo[e][Plantador], MariInfo[e][State], MariInfo[e][Creado]);
            SendClientMessage(playerid, -1, string);
        }
    }
    return 1;
}
CMD:sembrar(playerid, params[]) {

    if (PLAYER_INFO[playerid][@Nivel] < 4) return SendClientMessage(playerid, COLOR_BLANCO, "Para sembrar necesitas tener como mínimo nivel 4.");
    if (PLAYER_INFO[playerid][j_ARMAS][GetWeaponSlot(4)] != 4) return SendClientMessage(playerid, COLOR_BLANCO, "Necesitas un cuchillo para sembrar marihuana.");
    if (PLAYER_INFO[playerid][pSemillas] < 5) return SendClientMessage(playerid, COLOR_BLANCO, "Necesitas 5 semillas de marihuana.");
    if (IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_BLANCO, "No puedes hacer esto en un vehículo.");
    if (GetPlayerVirtualWorld(playerid) != 0) return SendClientMessage(playerid, COLOR_BLANCO, "No puedes hacer esto en un interior.");
    if (GetPlayerInterior(playerid) != 0) return SendClientMessage(playerid, COLOR_BLANCO, "No puedes hacer esto en un interior.");
    switch (PLAYER_INFO[playerid][pVip]) {
        case 1 : if(CuantoPlanto(playerid) == 4) return MensajeEx(playerid, -1, "No puedes tener mas de %d plantas, necesitas una cuenta VIP superior para aumentar la capacidad permitida.", CuantoPlanto(playerid));
        case 2 : if(CuantoPlanto(playerid) == 6) return MensajeEx(playerid, -1, "No puedes tener mas de %d plantas, necesitas una cuenta VIP superior para aumentar la capacidad permitida.", CuantoPlanto(playerid));
        case 3 : if(CuantoPlanto(playerid) == 8) return MensajeEx(playerid, -1, "No puedes tener mas de %d plantas, necesitas una cuenta VIP superior para aumentar la capacidad permitida.", CuantoPlanto(playerid));
        default: if(CuantoPlanto(playerid) == 2) return MensajeEx(playerid, -1, "No puedes tener mas de %d plantas, necesitas una cuenta VIP superior para aumentar la capacidad permitida.", CuantoPlanto(playerid));
    }
    new id = PlantaLibre();
    if (id == -1) return SendClientMessage(playerid, -1, "No se puede crear mas plantas, intentalo mas tarde.");
    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);
    for(new e; e < MAX_MARIHUANA; e++) {
        if (EstaEn(playerid, 4.0, MariInfo[e][pX], MariInfo[e][pY], MariInfo[e][pZ])) return SendClientMessage(playerid, -1, "No puedes sembrar tan cerca de otra plantacion.");
    }
    PLAYER_INFO[playerid][pSemillas] -= 5;
    Congelar(playerid);
    new interior = GetPlayerInterior(playerid);
    new world = GetPlayerVirtualWorld(playerid);
    GameTextForPlayerEx(playerid, "~g~Sembrando...", 6000, 3);
    LoopingAnim(playerid, "BOMBER", "BOM_Plant", 4.0, 1, 1, 1, 1, 6000);
    SetTimerEx("CreandoMaria", 5000, false, "ud", playerid, id);
    MariInfo[id][Label] = CreateDynamic3DTextLabel("{00ff00}Sembrando...", COLOR_WHITE, x, y, z + 0.6, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, world, interior, -1, 100.0);
    return 1;
}

CMD:runanim(playerid, params[]) {
    new tema[48], animacion[48];
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM) return 0;

    if (sscanf(params, "s[48]s[48]", tema, animacion)) return SendClientMessage(playerid, COLOR_GRAD2, "MODO DE USO: /runanim [1] [2]");
    ApplyAnimation(playerid, tema, animacion, 1, 0, 1, 1, 0, 0);
    return 1;
}
CMD:unbanip(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_GLOBAL) return 0;
    if (!sscanf(params, "s[128]", params[0])) {
        new string[150];
        format(string, sizeof(string), "unbanip %s", params[0]);
        SendRconCommand(string);
        SendRconCommand("reloadbans");
        format(string, sizeof(string), "%s[%d] desbaneo la IP: %s", PLAYER_INFO[playerid][Nickname], playerid, params[0]);
        MensajeAdmin(COLOR_GREY, string, ADMIN_LEVEL_GLOBAL);
    }
    return 1;
}
CMD:contrato(playerid, params[]) {
    if (strcmp(params, "guardaespaldas", true) == 0) {
        if (PLAYER_INFO[playerid][T_Guarda] == 0) return SendClientMessage(playerid, -1, "No tienes ningun guarda espaldas contratado.");
        new texto[48], mensaje[128], result = PLAYER_TIMES[playerid][TiempoGuarda] - gettime();
        if (result < 60) format(texto, sizeof(texto), "%ds", result % (60));
        else if (result < 3600) format(texto, sizeof(texto), "%dm %ds", result / 60 % (60), result % (60));
        else if (result < 86400) format(texto, sizeof(texto), "%dh %dm %ds", result / 3600 % (60), result / 60 % (60), result % (60));
        else format(texto, sizeof(texto), "%dd %dh %dm %ds", result / 86400, result / 3600 % (60), result / 60 % (60), result % (60));
        format(mensaje, sizeof(mensaje), "Tiempo servicio de tus guardaespaldas: {00CC00}%s{FFFFFF}.", texto);
        SendClientMessage(playerid, -1, mensaje);
    }
    return 1;
}

CMD:trabajo(playerid, params[]) {
    new item[128];
    if (!sscanf(params, "s[128]", item)) {
        if (IsPlayerInAnyVehicle(playerid)) return PUSH(playerid, "Necesitas estar fuera del vehiculo.");
        if (PLAYER_INFO[playerid][pDuty] > 0) return PUSH(playerid, "No puedes obtener un trabajo estando de servicio.");
        if (strcmp(item, "medico", true) == 0) {
            if (!IsPlayerInRangeOfPoint(playerid, 5.0, 1178.1359, -1361.3021, 14.2302)) return SendClientMessage(playerid, -1, "No estas donde se consigue el trabajo de Medico.");
            if (PLAYER_INFO[playerid][@Nivel] < 2) return PUSH(playerid, "Necesitas ser al menos nivel 2 para aprender el trabajo de Medico.");
            if (PLAYER_INFO[playerid][jDinero] < 4000) return SendClientMessage(playerid, -1, "Necesitas tener {00CC00}$4000{FFFFFF} para pertenecer al equipo Medico.");
            if (PLAYER_INFO[playerid][pTrabajo] == T_Medico || PLAYER_INFO[playerid][pTrabajo2] == T_Medico) return PUSH(playerid, "No puedes tener dos trabajos iguales.");
            if (PLAYER_INFO[playerid][pTrabajo] == T_Ninguno) return dialogs_ShowPlayerDialog(playerid, TRABAJO_MEDICO, DIALOG_STYLE_MSGBOX, "¿Quieres ser Medico?", "{FFFFFF}Para fomar parte del equipo de Medicos de San Andreas debes pagar {00FC00}$4000{FFFFFF}.\n", "Aceptar", "Cancelar");
            else if (PLAYER_INFO[playerid][pTrabajo] != T_Ninguno && PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno && PLAYER_INFO[playerid][pVip] >= 2) return dialogs_ShowPlayerDialog(playerid, TRABAJO_MEDICO2, DIALOG_STYLE_MSGBOX, "¿Quieres ser Medico?", "{FFFFFF}Para fomar parte del equipo de Medicos de San Andreas debes pagar {00FC00}$4000{FFFFFF}.\n", "Aceptar", "Cancelar");
            else if (PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno) return NoPuedeTrabajo(playerid);
            else if (PLAYER_INFO[playerid][pTrabajo2] != T_Ninguno) return YaTiene2Jobs(playerid);
        }
        if (strcmp(item, "armero", true) == 0) {
            if (!IsPlayerInRangeOfPoint(playerid, 5.0, 2122.9236, -2275.1238, 20.6719)) return SendClientMessage(playerid, -1, "No estas donde se consigue el trabajo de Armero.");
            if (PLAYER_INFO[playerid][@Nivel] < 3) return Notificador2(playerid, "Para trabajar de armero necesitas nivel 3 como minimo.");
            if (PLAYER_INFO[playerid][pTrabajo] == T_Armero || PLAYER_INFO[playerid][pTrabajo2] == T_Armero) return PUSH(playerid, "No puedes tener dos trabajos iguales.");
            if (PLAYER_INFO[playerid][pTrabajo] == T_Ninguno) return AsignarTrabajo(playerid, T_Armero, 0);
            else if (PLAYER_INFO[playerid][pTrabajo] != T_Ninguno && PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno && PLAYER_INFO[playerid][pVip] >= 2) return AsignarTrabajo(playerid, T_Armero, 1);
            else if (PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno) return NoPuedeTrabajo(playerid);
            else if (PLAYER_INFO[playerid][pTrabajo2] != T_Ninguno) return YaTiene2Jobs(playerid);
        }
        if (strcmp(item, "trailero", true) == 0) {
            if (!IsPlayerInRangeOfPoint(playerid, 5.0, 319.8048, 874.8229, 20.3990)) return SendClientMessage(playerid, -1, "No estas donde se consigue el trabajo de Trailero.");
            if (PLAYER_INFO[playerid][@Nivel] < 6) return Notificador2(playerid, "Para trabajar de Trailero necesitas nivel 6 como minimo.");
            if (PLAYER_INFO[playerid][pNivelTransportista] < 2) return Notificador2(playerid, "Para conseguir este trabajo necesitas habilidad de transportista. (nivel 2 o mas)");
            if (PLAYER_INFO[playerid][pTrabajo] == T_Trailero || PLAYER_INFO[playerid][pTrabajo2] == T_Trailero) return PUSH(playerid, "No puedes tener dos trabajos iguales.");
            if (PLAYER_INFO[playerid][pTrabajo] == T_Ninguno) return AsignarTrabajo(playerid, T_Trailero, 0);
            else if (PLAYER_INFO[playerid][pTrabajo] != T_Ninguno && PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno && PLAYER_INFO[playerid][pVip] >= 2) return AsignarTrabajo(playerid, T_Trailero, 1);
            else if (PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno) return NoPuedeTrabajo(playerid);
            else if (PLAYER_INFO[playerid][pTrabajo2] != T_Ninguno) return YaTiene2Jobs(playerid);
        }
        if (strcmp(item, "camionero", true) == 0) {
            if (!IsPlayerInRangeOfPoint(playerid, 5.0, -1715.0378, -63.1466, 3.6340)) return SendClientMessage(playerid, -1, "No estas donde se consigue el trabajo de Camionero.");
            if (PLAYER_INFO[playerid][pTrabajo] == T_Camionero || PLAYER_INFO[playerid][pTrabajo2] == T_Camionero) return PUSH(playerid, "No puedes tener dos trabajos iguales.");
            if (PLAYER_INFO[playerid][pTrabajo] == T_Ninguno) return AsignarTrabajo(playerid, T_Camionero, 0);
            else if (PLAYER_INFO[playerid][pTrabajo] != T_Ninguno && PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno && PLAYER_INFO[playerid][pVip] >= 2) return AsignarTrabajo(playerid, T_Camionero, 1);
            else if (PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno) return NoPuedeTrabajo(playerid);
            else if (PLAYER_INFO[playerid][pTrabajo2] != T_Ninguno) return YaTiene2Jobs(playerid);
        }
        if (strcmp(item, "guardaespaldas", true) == 0) {
            if (!IsPlayerInRangeOfPoint(playerid, 2.0, 2226.2988, -1718.7993, 13.5236)) return SendClientMessage(playerid, -1, "No estas donde se consigue el trabajo de Guardaespaldas.");
            if (PLAYER_INFO[playerid][pTrabajo] == T_Guardaespaldas || PLAYER_INFO[playerid][pTrabajo2] == T_Guardaespaldas) return PUSH(playerid, "No puedes tener dos trabajos iguales.");
            if (PLAYER_INFO[playerid][pTrabajo] == T_Ninguno) return AsignarTrabajo(playerid, T_Guardaespaldas, 0);
            else if (PLAYER_INFO[playerid][pTrabajo] != T_Ninguno && PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno && PLAYER_INFO[playerid][pVip] >= 2) return AsignarTrabajo(playerid, T_Guardaespaldas, 1);
            else if (PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno) return NoPuedeTrabajo(playerid);
            else if (PLAYER_INFO[playerid][pTrabajo2] != T_Ninguno) return YaTiene2Jobs(playerid);
        }
        if (strcmp(item, "transportista", true) == 0) {
            if (!IsPlayerInRangeOfPoint(playerid, 2.0, 2583.8274, 1644.3837, 1087.5602) || GetPlayerInterior(playerid) != 1 || GetPlayerVirtualWorld(playerid) != 5) return SendClientMessage(playerid, -1, "No estas donde se consigue el trabajo de Transportista.");
            if (PLAYER_INFO[playerid][pNivelCamionero] < 3) return Notificador2(playerid, "Para conseguir este trabajo necesitas habilidad de camionero. (nivel 3 o mas)");
            if (PLAYER_INFO[playerid][pTrabajo] == T_Transportista || PLAYER_INFO[playerid][pTrabajo2] == T_Transportista) return PUSH(playerid, "No puedes tener dos trabajos iguales.");
            if (PLAYER_INFO[playerid][pTrabajo] == T_Ninguno) return AsignarTrabajo(playerid, T_Transportista, 0);
            else if (PLAYER_INFO[playerid][pTrabajo] != T_Ninguno && PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno && PLAYER_INFO[playerid][pVip] >= 2) return AsignarTrabajo(playerid, T_Transportista, 1);
            else if (PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno) return NoPuedeTrabajo(playerid);
            else if (PLAYER_INFO[playerid][pTrabajo2] != T_Ninguno) return YaTiene2Jobs(playerid);
        }
        if (strcmp(item, "basurero", true) == 0) {
            if (!IsPlayerInRangeOfPoint(playerid, 2.0, -177.6093, -1549.4420, 6.3284)) return SendClientMessage(playerid, -1, "No estas donde se consigue el trabajo de Basurero.");
            if (PLAYER_INFO[playerid][pTrabajo] == T_Basurero || PLAYER_INFO[playerid][pTrabajo2] == T_Basurero) return PUSH(playerid, "No puedes tener dos trabajos iguales.");
            if (PLAYER_INFO[playerid][pTrabajo] == T_Ninguno) return AsignarTrabajo(playerid, T_Basurero, 0);
            else if (PLAYER_INFO[playerid][pTrabajo] != T_Ninguno && PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno && PLAYER_INFO[playerid][pVip] >= 2) return AsignarTrabajo(playerid, T_Basurero, 1);
            else if (PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno) return NoPuedeTrabajo(playerid);
            else if (PLAYER_INFO[playerid][pTrabajo2] != T_Ninguno) return YaTiene2Jobs(playerid);
        }
        if (strcmp(item, "taxi", true) == 0) {
            if (!IsPlayerInRangeOfPoint(playerid, 2.0, -2024.7489, -113.9102, 1038.8187)) return SendClientMessage(playerid, -1, "No estas donde se consigue el trabajo de taxista.");
            if (PLAYER_INFO[playerid][pTrabajo] == T_Taxista || PLAYER_INFO[playerid][pTrabajo2] == T_Taxista) return PUSH(playerid, "No puedes tener dos trabajos iguales.");
            if (PLAYER_INFO[playerid][pTrabajo] == T_Ninguno) return AsignarTrabajo(playerid, T_Taxista, 0);
            else if (PLAYER_INFO[playerid][pTrabajo] != T_Ninguno && PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno && PLAYER_INFO[playerid][pVip] >= 2) return AsignarTrabajo(playerid, T_Taxista, 1);
            else if (PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno) return NoPuedeTrabajo(playerid);
            else if (PLAYER_INFO[playerid][pTrabajo2] != T_Ninguno) return YaTiene2Jobs(playerid);
        }
        if (strcmp(item, "mecanico", true) == 0) {
            if (!IsPlayerInRangeOfPoint(playerid, 2.0, 114.7220, -151.4292, 1.5781)) return SendClientMessage(playerid, -1, "No estas donde se consigue el trabajo de mecanico.");
            if (PLAYER_INFO[playerid][pTrabajo] == T_Mecanico || PLAYER_INFO[playerid][pTrabajo2] == T_Mecanico) return PUSH(playerid, "No puedes tener dos trabajos iguales.");
            if (PLAYER_INFO[playerid][pTrabajo] == T_Ninguno) return AsignarTrabajo(playerid, T_Mecanico, 0);
            else if (PLAYER_INFO[playerid][pTrabajo] != T_Ninguno && PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno && PLAYER_INFO[playerid][pVip] >= 2) return AsignarTrabajo(playerid, T_Mecanico, 1);
            else if (PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno) return NoPuedeTrabajo(playerid);
            else if (PLAYER_INFO[playerid][pTrabajo2] != T_Ninguno) return YaTiene2Jobs(playerid);
        } else if (strcmp(item, "pescador", true) == 0) {
            if (!IsPlayerInRangeOfPoint(playerid, 5.0, 2789.3672, -2574.6675, 3.1683)) return 1;
            if (PLAYER_INFO[playerid][@Nivel] < 2) return SendClientMessage(playerid, -1, "Necesitas como minimo nivel 2 para conseguir este trabajo.");
            if (PLAYER_INFO[playerid][pTrabajo] == T_Pescador || PLAYER_INFO[playerid][pTrabajo2] == T_Pescador) return PUSH(playerid, "No puedes tener dos trabajos iguales.");
            if (PLAYER_INFO[playerid][pTrabajo] == T_Ninguno) return AsignarTrabajo(playerid, T_Pescador, 0);
            else if (PLAYER_INFO[playerid][pTrabajo] != T_Ninguno && PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno && PLAYER_INFO[playerid][pVip] >= 2) return AsignarTrabajo(playerid, T_Pescador, 1);
            else if (PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno) return NoPuedeTrabajo(playerid);
            else if (PLAYER_INFO[playerid][pTrabajo2] != T_Ninguno) return YaTiene2Jobs(playerid);
        }

        if (strcmp(item, "criminal", true) == 0) {
            if (!IsPlayerInRangeOfPoint(playerid, 2.0, -2181.3860, 714.7617, 53.8915)) return 1;
            if (PLAYER_INFO[playerid][pTrabajo] == T_Criminal || PLAYER_INFO[playerid][pTrabajo2] == T_Criminal) return PUSH(playerid, "No puedes tener dos trabajos iguales.");
            if (PLAYER_INFO[playerid][@Nivel] <= 7 && PLAYER_INFO[playerid][pVip] == 0) {
                SendClientMessage(playerid, -1, "Necesitas ser {FF3300}nivel 8{FFFFFF} para conseguir este trabajo.");
                SendClientMessage(playerid, -1, "Si no llegas a ese nivel puedes optar por adquirir membresia {"            COLOR_GM "}Vip1 {FFFFFF}o {"            COLOR_GM "}Vip2");
                return 1;
            }
            if (PLAYER_INFO[playerid][pTrabajo] == T_Ninguno) return AsignarTrabajo(playerid, T_Criminal, 0);
            else if (PLAYER_INFO[playerid][pTrabajo] != T_Ninguno && PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno && PLAYER_INFO[playerid][pVip] >= 2) return AsignarTrabajo(playerid, T_Criminal, 1);
            else if (PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno) return NoPuedeTrabajo(playerid);
            else if (PLAYER_INFO[playerid][pTrabajo2] != T_Ninguno) return YaTiene2Jobs(playerid);
        }
        if (strcmp(item, "prostitucion", true) == 0) {
            if (!IsPlayerInRangeOfPoint(playerid, 2.0, 958.2482, -54.3517, 1001.1172)) return 1;
            if (PLAYER_INFO[playerid][pTrabajo] == T_Prostituta || PLAYER_INFO[playerid][pTrabajo2] == T_Prostituta) return PUSH(playerid, "No puedes tener dos trabajos iguales.");
            if (PLAYER_INFO[playerid][pTrabajo] == T_Ninguno) return AsignarTrabajo(playerid, T_Prostituta, 0);
            else if (PLAYER_INFO[playerid][pTrabajo] != T_Ninguno && PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno && PLAYER_INFO[playerid][pVip] >= 2) return AsignarTrabajo(playerid, T_Prostituta, 1);
            else if (PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno) return NoPuedeTrabajo(playerid);
            else if (PLAYER_INFO[playerid][pTrabajo2] != T_Ninguno) return YaTiene2Jobs(playerid);
        } else SendClientMessage(playerid, COLOR_WHITE, "Por favor usa {"    COLOR_GM "}/trabajo nombre del trabajo");
    }
    return 1;
}
CMD:sacaradmoff(playerid, params[]) {
    new id[32], pName[32];
    new DB_Query[256];
    GetPlayerName(playerid, pName, 32);
    SetPVarInt(playerid, "antiflood", GetTickCount());
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM) return 0;
    if (!sscanf(params, "s[32]", id)) {
        mysql_format(handle_db, DB_Query, sizeof(DB_Query), "SELECT * FROM `usuarios` WHERE `Username`='%s' AND `Admin`='0'", id);
        mysql_tquery(handle_db, DB_Query);
        SendClientMessage(playerid, -1, "{FF0000}["    SERVER_COIN2 ":RP] {FFFFFF} El jugador fue expulsado de la administracion.");
    } else return SendClientMessage(playerid, -1, "Modo de uso: /sacaradmoff [Nombre_Apellido]");
    return 1;
}
CMD:quitartelefono(playerid, params[]) {
    new id, string[150];
    if (PLAYER_INFO[playerid][jAdminNvl] < ADMIN_LEVEL_ADM) return 0;
    if (!sscanf(params, "d", id)) {
        format(string, 150, "%s le quito un {00cc00}telefono{ffffff} a %s.", NombreJugador(playerid), NombreJugador(id));
        MensajeAdmin(-1, string, 5);
        format(string, 150, "Un administrador te quito el telefono.");
        SendClientMessage(id, COLOR_BLANCO, string);
        PLAYER_INFO[playerid][pNumero] = 0;
    }
    return 1;
}
