                PLAYER_INFO[playerid][vSeguro5] = 0;
            } else {
                PUSH(playerid, "Este vehiculo ya esta abierto.");
                Notificador2(playerid, "Pulsa ~b~Espacio + Y ~w~para trabar las puertas de tu vehiculo.");
            }
        } else if (PLAYER_INFO[playerid][pFaccion] != 0) {
            new vehicleid, Float:eX, Float:eY, Float:eZ;

            if (IsPlayerInAnyVehicle(playerid) && GetPlayerVehicleID(playerid) != INVALID_VEHICLE_ID)
                vehicleid = GetPlayerVehicleID(playerid);
            else {
                new emax = GetVehiclePoolSize();
                for(new v = 1; v < emax + 1; v++) {
                    if (!IsValidVehicle(v)) continue;

                    GetVehiclePos(v, eX, eY, eZ);
                    if (IsPlayerInRangeOfPoint(playerid, 5.0, eX, eY, eZ)) {
                        vehicleid = v;
                        break;
                    }
                }
            }
            if (vehicleid != 0 && VehicleFacData[vehicleid][vFaccID] == PLAYER_INFO[playerid][pFaccion]) {
                if (!bloqueado[vehicleid]) {
                    PUSH(playerid, "Este vehiculo ya esta abierto.");
                    Notificador2(playerid, "Pulsa ~b~Espacio + Y ~w~para trabar las puertas de tu vehiculo.");
                } else {
                    GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
                    SetVehicleParamsEx(vehicleid, engine, lights, alarm, 0, bonnet, boot, objective);
                    AccionesRol(playerid, "destrabo las puertas de su vehiculo.", 20);
                    Notificador2(playerid, "Pulsa ~b~Espacio + Y ~w~para destrabar las puertas de tu vehiculo.");
                    PlayerPlaySound(playerid, 1145, eX, eY, eZ);
                    bloqueado[vehicleid] = 0;
                    VehicleFacData[vehicleid][vfSeguro] = true;
                }
            } else Notificador2(playerid, "Necesitas estar al lado de un vehiculo para poder abrirlo.");
        } else {
            Notificador2(playerid, "Necesitas estar al lado de un vehiculo para poder abrirlo.");
        }
    }
    return 1;
}
CMD:detener(playerid, params[]) {
    if (GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
    ApagarMotor(playerid);
    return 1;
}
CMD:kill(playerid, params[]) {
    if (JugadorLogeado[playerid] != 1) return 1;
    if (PLAYER_INFO[playerid][pCargos] > 0) return ShowPlayerMessage(playerid, "~r~No puedes hacer esto teniendo cargos");
    if (GetPlayerState(playerid) == 2 || GetPlayerState(playerid) == 3) return MensajeEx(playerid, -1, "No puedes hacer esto dentro de un vehículo.");
    if (Jail[playerid] == 1 || PLAYER_INFO[playerid][pTiempoJail] > 0 || PLAYER_INFO[playerid][Agonizando] > 0 || PLAYER_TEMP[playerid][VariableCaido] == 1) return 1; {
        if (PLAYER_INFO[playerid][pTiempoJail] <= 0 && PLAYER_INFO[playerid][pTiempoCarcel] <= 0) {
            suicidio[playerid] = 1;
            EstablecerVida(playerid, 0.0);
        } else return MensajeEx(playerid, -1, "No puedes hacer esto si estas en prision.");
    }
    return 1;
}
CMD:m(playerid, params[]) {
    new text[128];
    if (PLAYER_INFO[playerid][pDuty] != 1) return 1;
    if (IsPlayerInAnyVehicle(playerid)) {
        if (SAPD(GetPlayerVehicleID(playerid)) || MILITARVEH(GetPlayerVehicleID(playerid)) || DEPORTIVOCOP(GetPlayerVehicleID(playerid))) {
            if (!sscanf(params, "s[128]", text)) {
                new string[128];
                format(string, sizeof(string), "(Megafono) %s: {3399FF}¡¡ {FFFFFF}%s{3399FF} !!", PLAYER_INFO[playerid][Nickname], text);
                ProxDetector(60.0, playerid, string, COLOR_MEGAPHONE, COLOR_MEGAPHONE, COLOR_MEGAPHONE, COLOR_MEGAPHONE, COLOR_MEGAPHONE);
            }
        } else if (HELISAPD(GetPlayerVehicleID(playerid) || MILITARVEH(GetPlayerVehicleID(playerid)))) {
            if (!sscanf(params, "s[128]", text)) {
                new string[128];
                format(string, sizeof(string), "(Megafono) %s: {3399FF}¡¡ {FFFFFF}%s{3399FF} !!", PLAYER_INFO[playerid][Nickname], text);
                ProxDetector(90.0, playerid, string, COLOR_MEGAPHONE, COLOR_MEGAPHONE, COLOR_MEGAPHONE, COLOR_MEGAPHONE, COLOR_MEGAPHONE);
            }
        } else SendClientMessage(playerid, -1, "Solamente los vehiculos de la policia cuentan con megafonos.");
    } else {
        new Float:VPos[3];
        for(new i = 1, limite = GetVehiclePoolSize(); i <= limite; i++) {
            if (SAPD(i) || HELISAPD(i) || MILITARVEH(i)) {
                new string[128];
                GetVehiclePos(i, VPos[0], VPos[1], VPos[2]);
                if (IsPlayerInRangeOfPoint(playerid, 4.0, VPos[0], VPos[1], VPos[2])) {
                    if (PLAYER_INFO[playerid][pDuty] == 1) {
                        if (!sscanf(params, "s[128]", text)) {
                            format(string, sizeof(string), "(Megafono) %s: {3399FF}¡¡ {FFFFFF}%s{3399FF} !!", PLAYER_INFO[playerid][Nickname], text);
                            ProxDetector(60.0, playerid, string, COLOR_MEGAPHONE, COLOR_MEGAPHONE, COLOR_MEGAPHONE, COLOR_MEGAPHONE, COLOR_MEGAPHONE);
                        }
                    } else SendClientMessage(playerid, -1, "Solamente los vehiculos de la policia cuentan con Megafonos.");
                }
            }
        }
    }
    return 1;
}
