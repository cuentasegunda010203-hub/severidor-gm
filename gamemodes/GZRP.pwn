    mysql_tquery(handle_db, Query, "CargarEst");
}

function CargarEst() {
    Usuarios[Cantidad] = cache_num_rows();
    printf("La DB tiene %d usuarios registrados en total.", Usuarios[Cantidad]);
}
public TextoCombate(playerid) {
    if (EnCombate[playerid] == 1) {

        if (PLAYER_TIMES[playerid][TiempoCombate] > 0) {

            if (CColocado[playerid] == 0) {

                GangZoneShowForPlayer(playerid, ModoCombate, -1879048029);
                GangZoneFlashForPlayer(playerid, ModoCombate, -1879048029);
                PLAYER_TIMES[playerid][TiempoCombate]--;
                CColocado[playerid] = 1;
            } else {

                GangZoneHideForPlayer(playerid, ModoCombate);
                GangZoneStopFlashForPlayer(playerid, ModoCombate);
                PLAYER_TIMES[playerid][TiempoCombate]--;
                CColocado[playerid] = 0;
            }
        } else if (PLAYER_TIMES[playerid][TiempoCombate] <= 0) {

            GangZoneHideForPlayer(playerid, ModoCombate);
            GangZoneStopFlashForPlayer(playerid, ModoCombate);
            PLAYER_TIMES[playerid][TiempoCombate] = 0;
            CColocado[playerid] = 0;
            EnCombate[playerid] = 0;
            KillTimer(TimerCombate[playerid]);
        }
    } else if (EnCombate[playerid] == 0) {

        GangZoneHideForPlayer(playerid, ModoCombate);
        GangZoneStopFlashForPlayer(playerid, ModoCombate);
        PLAYER_TIMES[playerid][TiempoCombate] = 0;
        CColocado[playerid] = 0;
        EnCombate[playerid] = 0;
        KillTimer(TimerCombate[playerid]);
    }
}
stock ArmorDamage(playerid, Float:ammount) {
    new Float:Chaleco;
    GetPlayerArmour(playerid, Chaleco);
    if (Chaleco - ammount <= 0)
        EstablecerChaleco(playerid, 0.0);
    else
        EstablecerChaleco(playerid, Chaleco - ammount);

    return true;
}

stock HealthDamage(playerid, Float:ammount) {
    new Float:Vida;
    GetPlayerHealth(playerid, Vida);
    if ((Vida - ammount) <= 0.0) {

        EstablecerVida(playerid, 0.0);
    } else {

        EstablecerVida(playerid, Vida - ammount);
    }

    return true;
}
stock GiveDamageForPlayer(playerid, Float:ammount) {
    if (PLAYER_TEMP[playerid][IsAndroid] == 1 || pFPS[playerid] > 70 || pFPS[playerid] == 0 || pFPS[playerid] < 0 || pFPS[playerid] < 15 || PLAYER_INFO[playerid][pCargos] > 3) {
        if (IsPlayerInAnyVehicle(playerid)) {
            new vehicleid = GetPlayerVehicleID(playerid);
            new Float:VidaV;
            GetVehicleHealth(vehicleid, VidaV);
            new Float:resta = VidaV - ammount;
            SetVehicleHealth(vehicleid, resta);
        }
        new Float:Vida;
        GetPlayerHealth(playerid, Vida);
        new Float:Chaleco;
        GetPlayerArmour(playerid, Chaleco);
        if (Vida >= 1) {
            if (Chaleco - ammount <= 0) {
                EstablecerChaleco(playerid, 0.0);
                HealthDamage(playerid, ammount - Chaleco);
            } else
                ArmorDamage(playerid, ammount);
        } else
            HealthDamage(playerid, ammount);
    }
    return true;
}

public OnPlayerGiveDamage(playerid, damagedid, Float:amount, weaponid, bodypart) {
    switch (weaponid) {
        case 22 : GiveDamageForPlayer(damagedid, amount); // Colt
        case 23 : GiveDamageForPlayer(damagedid, amount); // SD Pistol
        case 24 : GiveDamageForPlayer(damagedid, amount); // Deagle

        case 25: {
            GiveDamageForPlayer(damagedid, amount); // Shotgun
        }
        case 26 : GiveDamageForPlayer(damagedid, amount); // Shotgun
        case 27 : GiveDamageForPlayer(damagedid, amount); // EDC

        case 28 : GiveDamageForPlayer(damagedid, amount); // Micro-Uzi
        case 29 : GiveDamageForPlayer(damagedid, amount); // MP5
        case 30 : GiveDamageForPlayer(damagedid, amount); // AK-47
        case 31 : GiveDamageForPlayer(damagedid, amount); // M4A1
        case 33 : GiveDamageForPlayer(damagedid, amount); // Rifle
        case 34 : GiveDamageForPlayer(damagedid, amount); // Sniper
        case 38 : GiveDamageForPlayer(damagedid, amount); // Minigun
        case 32 : GiveDamageForPlayer(damagedid, amount);
    }
    if (PLAYER_INFO[playerid][BalasGoma] > 0) {
        Congelar(damagedid);
        ShowPlayerMessage(damagedid, "~r~Te han herido con una bala de goma. En 3 minutos podras recuperarte.");
        ApplyAnimation(damagedid, "WUZI", "CS_Dead_Guy", 4.0, 0, 0, 0, 1, 0);
        SetTimerEx("EfectoBalasGoma", 60000 * 3, false, "d", damagedid);
        PLAYER_TEMP[damagedid][HeridoBalasGoma] = 1;
        PLAYER_INFO[playerid][BalasGoma]--;
    }
    if (IsPlayerNPC(damagedid)) {
        new string[256];
        if (PLAYER_INFO[playerid][pCargos] < 1) return 1;
        if (!strcmp(PLAYER_INFO[damagedid][Nickname], ".Marcelo", true)) {
            if (PLAYER_INFO[playerid][pDuty] < 1) return 1;
            PLAYER_INFO[playerid][pCargos]++;
            SetPlayerWantedLevelEx(playerid, PLAYER_INFO[playerid][pCargos]);
            SetTimerEx("Quitar1Cargo", 300000, 0, "d", playerid);
            SendClientMessage(playerid, COLOR_WHITE, "Fuiste descubierto por un guardia de seguridad, escapa de la zona.");
            SendClientMessage(playerid, COLOR_WHITE, "Si te escondes bien durante 5 minutos, la policía perdera tu rastro.");
            format(string, sizeof(string), "{3399FF}[Central de policía] {FFFFFF}reportando: (({00D2CF}%s{FFFFFF})) [%d] disturbios en el Departamento de policías de Los Santos.", PLAYER_INFO[playerid][Nickname], playerid);
            SendRadioMessage(1, COLOR_WHITE, string, INVALID_PLAYER_ID, 1);
            quienfue = "Marcelo";
        }
        if (!strcmp(PLAYER_INFO[damagedid][Nickname], ".Alejandro", true)) {
            if (PLAYER_INFO[playerid][pDuty] < 1) return 1;
            PLAYER_INFO[playerid][pCargos]++;
            SetPlayerWantedLevelEx(playerid, PLAYER_INFO[playerid][pCargos]);
            SetTimerEx("Quitar1Cargo", 300000, 0, "d", playerid);
            SendClientMessage(playerid, COLOR_WHITE, "Fuiste descubierto por un guardia de seguridad, escapa de la zona.");
            SendClientMessage(playerid, COLOR_WHITE, "Si te escondes bien durante 5 minutos, la policía perdera tu rastro.");
            format(string, sizeof(string), "{3399FF}[Central de policía] {FFFFFF}reportando: (({00D2CF}%s{FFFFFF})) [%d] disturbios en All Saints General Hospital.", PLAYER_INFO[playerid][Nickname], playerid);
            SendRadioMessage(1, COLOR_WHITE, string, INVALID_PLAYER_ID, 1);
            quienfue = "Alejandro";
        }
        if (!strcmp(PLAYER_INFO[damagedid][Nickname], ".Hugo", true)) {
            if (PLAYER_INFO[playerid][pDuty] < 1) return 1;
            PLAYER_INFO[playerid][pCargos]++;
            SetPlayerWantedLevelEx(playerid, PLAYER_INFO[playerid][pCargos]);
            SetTimerEx("Quitar1Cargo", 300000, 0, "d", playerid);
            SendClientMessage(playerid, COLOR_WHITE, "Fuiste descubierto por un guardia de seguridad, escapa de la zona.");
            SendClientMessage(playerid, COLOR_WHITE, "Si te escondes bien durante 5 minutos, la policía perdera tu rastro.");
            format(string, sizeof(string), "{3399FF}[Central de policía] {FFFFFF}reportando: (({00D2CF}%s{FFFFFF})) [%d] disturbios en Easter Basin.", PLAYER_INFO[playerid][Nickname], playerid);
            SendRadioMessage(1, COLOR_WHITE, string, INVALID_PLAYER_ID, 1);
            quienfue = "Hugo";
        }
        return 1;
    } else {
        if (IsPlayerInRangeOfPoint(playerid, 70.0, 2332.2532, -1235.1134, 1026.1887) || RopaMeca[playerid] == 1 && RopaMeca[damagedid] == 1 && damagedid == 0 || RopaMeca[playerid] == 1 && RopaMeca[damagedid] == 1 || RopaMedi[playerid] == 1 && RopaMedi[damagedid] == 1) {
            new Float:old_health;
            GetPlayerHealth(damagedid, old_health);
            EstablecerVida(damagedid, old_health + amount);
            SendClientMessage(playerid, -1, "No puedes hacerle daño a tus colegas.");
        }
    }
    return 1;
}


public elSexoOral(playerid) {
    ProgresoSexoOral[playerid]++;
    switch (ProgresoSexoOral[playerid]) {
        case 1 : ApplyAnimation(SexoOral[playerid], "BLOWJOBZ", "BJ_CAR_START_W", 4.1, 0, 0, 0, 1, 0, 1);
        case 3 : ApplyAnimation(SexoOral[playerid], "BLOWJOBZ", "BJ_CAR_LOOP_W", 4.1, 1, 0, 0, 1, 0, 1);
        case 15 : ApplyAnimation(SexoOral[playerid], "BLOWJOBZ", "BJ_CAR_END_W", 4.1, 0, 0, 0, 1, 0, 1);
        case 16: {
            ApplyAnimation(playerid, "BLOWJOBZ", "BJ_CAR_END_P", 4.0, 0, 0, 0, 1, 0, 1);
            SexoOral[playerid] = INVALID_PLAYER_ID;
            KillTimer(PLAYER_TIMES[playerid][TimerChupar]);
            ProgresoSexoOral[playerid] = 0;
            return 1;
        }
    }
    PLAYER_TIMES[playerid][TimerChupar] = SetTimerEx("elSexoOral", 1000, false, "d", playerid);
    return true;
}

