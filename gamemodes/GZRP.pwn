CMD:encargo(playerid) {
    if (PLAYER_INFO[playerid][pTrabajo] != T_Criminal && PLAYER_INFO[playerid][pTrabajo2] != T_Criminal) return SendClientMessage(playerid, -1, "Primero tienes que hablar con el jefe para unirte al crimen.");
    if (PLAYER_INFO[playerid][@Nivel] < 10 && PLAYER_INFO[playerid][pVip] == 0) {
        SendClientMessage(playerid, -1, "Para solicitar un encargo necesitas {CF0613}Nivel 10{FFFFFF} o membresia {"    COLOR_GM "}Vip1/Vip2/GVIP");
        SendClientMessage(playerid, -1, "De todas formas puedes participar uniondote al encargo de otra persona");
        return 1;
    }
    if (IsPlayerInRangeOfPoint(playerid, 2.0, -2186.6309, 714.9852, 53.8988)) {
        if (TomoEncargo[playerid] == 1) return SendClientMessage(playerid, -1, "Ya tienes un encargo.");
        TomoEncargo[playerid] = 1;
        SendClientMessage(playerid, -1, "Para invitar a alguien a participar usa {"    COLOR_GM "}/colega id-o-nombre");
        new e;
        e = random(5);
        if (e == 0) e = 1;
        //e = 5;
        if (Encargo[e][MisionActiva] == 0) {
            TieneEncargo[playerid] = e;
            Encargo[e][MisionActiva] = 1;
            Encargo[e][IdCriminal] = playerid;
            Encargo[e][IdColega] = INVALID_PLAYER_ID;
            Encargo[e][SegundosMision] = 119;
            TextDrawSetString(MisionCriminal[e], "Busca un ~g~colega~w~ para realizar el encargo.");
            TextDrawShowForPlayer(playerid, FranjaCriminal);
        } else {
            e = random(5);
            if (Encargo[e][MisionActiva] == 0) {
                TieneEncargo[playerid] = e;
                Encargo[e][MisionActiva] = 1;
                Encargo[e][IdCriminal] = playerid;
                Encargo[e][IdColega] = INVALID_PLAYER_ID;
                Encargo[e][SegundosMision] = 119;
                TextDrawSetString(MisionCriminal[e], "Busca un ~g~colega~w~ para realizar el encargo.");
                TextDrawShowForPlayer(playerid, FranjaCriminal);
            } else SendClientMessage(playerid, -1, "No hay encargos disponible, intenta de nuevo..");
        }
    }
    return 1;
}

CMD:colega(playerid, params[]) {
    new Float:x, Float:y, Float:z, string[128], ID;
    if (TomoEncargo[playerid] != 1) return SendClientMessage(playerid, -1, "Primero tienes que pedir un {"COLOR_GM "}/encargo{FFFFFF} para invitar colegas.");
    if (PLAYER_INFO[playerid][pTrabajo] != T_Criminal && PLAYER_INFO[playerid][pTrabajo2] != T_Criminal) return 1;
    if (sscanf(params, "d", ID)) return SendClientMessage(playerid, -1, "El comando ingresado no es correcto, usa {"COLOR_GM "}/colega id-o-nombre{FFFFFF} para invitar.");
    if (TieneEncargo[ID] > 0) return SendClientMessage(playerid, -1, "El jugador que deseas invitar ya tiene un encargo.");
    GetPlayerPos(ID, x, y, z);
    if (!IsPlayerInRangeOfPoint(playerid, 5.0, x, y, z)) {
        SendClientMessage(playerid, -1, "Esa persona esta muy lejos.");
        return 0;
    }
    CriminalAceptado[playerid] = 0;
    CriminalAceptado[ID] = 0;
    format(string, 128, "{00CCFF}%s{FFFFFF} te esta invitando a participar de un encargo\n{"COLOR_GM "}¿Aceptas la invitacion?", PLAYER_INFO[playerid][Nickname]);
    dialogs_ShowPlayerDialog(ID, INVITARCRI, DIALOG_STYLE_MSGBOX, "Invitacion recibida", string, "Aceptar", "Cancelar");
    Invito[playerid] = ID;
    Invitador[ID] = playerid;
    SendClientMessage(playerid, 0x0CF22BFF, "Invitacion enviada.");
    return 1;
}

CMD:hablar(playerid, params[]) {
    if (ProxDetectorS(2.5, playerid, Camello)) {
        foreach(new i : Player) {
            if (PLAYER_INFO[i][pFaccion] == 1 && EstaEnP(playerid, i, 30.00)) return SetPlayerChatBubble(Camello, "Ahora no, nos estan viendo.", -1, 30.0, 5000);
        }
        if (PuntosCamello(Camello) == -1) return SetPlayerChatBubble(Camello, "Ven... Sigueme.", -1, 30.0, 5000);
        dialogs_ShowPlayerDialog(playerid, COMPRARCAMELLO, DIALOG_STYLE_LIST, "Camello", "Comprar\nVender", "Aceptar", "Cancelar");
    } else {
        if (Muriendo[playerid] == 1 || PLAYER_TIMES[playerid][Consumible] == 1 || PLAYER_INFO[playerid][Agonizando] != 0 || Esposando[playerid] == 2 || recogiendo[playerid] > 0) return 1;
        if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) {
            ApplyAnimation(playerid, "PED", "IDLE_chat", 4.1, 7, 5, 1, 1, 1);
            ApplyAnimation(playerid, "PED", "IDLE_chat", 4.1, 7, 5, 1, 1, 1);
        }
    }
    return 1;
}

CMD:quien(playerid, params[]) {
    new string[200], id;
    if (PLAYER_INFO[playerid][pDuty] != 1 && PLAYER_INFO[playerid][pAdmin] < 2) return 1;
    if (sscanf(params, "d", id)) return SendClientMessage(playerid, -1, "Escribe {"COLOR_GM "} /quien {FFFFFF}[{"COLOR_GM "}ID{FFFFFF}]"); {
        if (PLAYER_INFO[id][pCargos] == 0) return SendClientMessage(playerid, -1, "Este jugador no tiene cargos");
        format(string, 200, "Los cargos los coloco: {"    COLOR_GM "}%s{FFFFFF}, el jugador tiene {FF3300}%d{FFFFFF} cargos", PLAYER_INFO[id][QuienC], PLAYER_INFO[id][pCargos]);
        SendClientMessage(playerid, -1, string);
    }
    return 1;
}
CMD:tirar(playerid, params[]) {
    if (IsPlayerConnected(playerid)) {
        new opcion[20];
        if (!sscanf(params, "s[20]", opcion)) {
            if (strcmp(opcion, "arma", true) == 0) {
                new weaponid = GetPlayerWeapon(playerid);
                if (weaponid == 0) return PUSH(playerid, "~r~~h~Debes tener el arma que quieres tirar en mano.");
                TirarArma(playerid);
            } else if (strcmp(opcion, "m4", true) == 0) {
                PUSH(playerid, "Pulsa ~r~ESPACIO + H ~w~para tirar un arma al suelo");
            } else if (strcmp(opcion, "edc", true) == 0) {
                PUSH(playerid, "Pulsa ~r~ESPACIO + H ~w~para tirar un arma al suelo");
            } else if (strcmp(opcion, "dk", true) == 0) {
                PUSH(playerid, "Pulsa ~r~ESPACIO + H ~w~para tirar un arma al suelo");
            } else if (strcmp(opcion, "desert-eagle", true) == 0) {
                PUSH(playerid, "Pulsa ~r~ESPACIO + H ~w~para tirar un arma al suelo");
            } else if (strcmp(opcion, "barril", true) == 0) {
                if (PLAYER_TEMP[playerid][pt_TIENE_BARRIL] == 1) {
                    RemovePlayerAttachedObject(playerid, 2);
                    PLAYER_TEMP[playerid][pt_TIENE_BARRIL] = 0;
                } else return SendClientMessage(playerid, -1, "No puedes tirar algo que no tienes.");
            } else if (strcmp(opcion, "objeto", true) == 0) {
                if (Objeto[playerid] == 0 && PLAYER_TEMP[playerid][pt_TIENE_CRISTAL] == 0 && PLAYER_TEMP[playerid][pt_TIENE_BARRIL] == 0) return SendClientMessage(playerid, -1, "No puedes tirar algo que no tienes.");
                Objeto[playerid] = 0;
                PLAYER_TEMP[playerid][pt_TIENE_BARRIL] = 0;

                PLAYER_TEMP[playerid][pt_TIENE_CRISTAL] = 0;
                DCaja(playerid);
                SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
                RemovePlayerAttachedObject(playerid, 4);
                if (PLAYER_TEMP[playerid][pt_TIENE_BARRIL] != 0) RemovePlayerAttachedObject(playerid, 2);
                AccionesRol(playerid, "deja un objeto en el suelo.", 20);
                KillTimer(canceltimer[playerid]);
            } else if (strcmp(opcion, "mochila", true) == 0) {
                if (!BackPack[playerid][bDBID]) return SendClientMessage(playerid, -1, "No tienes mochila para tirar.");
                PUSH(playerid, "Tiraste tu ~g~Mochila");
                DROP_BACKPACK(playerid);
            }
        } else return SendClientMessageEx(playerid, COLOR_WHITE, "Utiliza: /tirar objeto");
    }
    return 1;
}
