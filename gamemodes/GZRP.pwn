stock ShowConfig(playerid) {
    if (JugadorLogeado[playerid] != 1) return 0;
    new string[1024], ANAME[600], AOPTIONS[600];
    if (PLAYER_INFO[playerid][pAdmin] > ADMIN_LEVEL_DUDAS) {
        ANAME = "\nLog Administrativo.\t";
        format(AOPTIONS, sizeof(AOPTIONS), "%s", GetYesOrNoConfig(VerAdmin[playerid]));
    }
    format(string, sizeof(string), "Opcion\tEstado actual\nMostrar canal de Twitter.\t%s\nMostrar Clima.\t%s\nMostrar canal de dudas y anuncios.\t%s\nMostrar muteos, sanciones y baneos.\t%s\nReproducir sonidos especiales y de radios.\t%s\nMostrar alertas de conexion.\t%s\nAparecer en la guia telefonica. \t%s\nMostrar barras de hambre y sed.\t%s\nMostrar velocimetro y medidor de combustible.\t%s\nIngreso automatico (misma IP).\t%s%s%s", GetYesOrNoConfig(CanalTwt[playerid]), GetYesOrNoConfig(PLAYER_INFO[playerid][pClima]), GetYesOrNoConfig(CanalDudas[playerid]), GetYesOrNoConfig(PLAYER_INFO[playerid][pMuteos]), GetYesOrNoConfig(PLAYER_INFO[playerid][pSonidos]), GetYesOrNoConfig(PLAYER_INFO[playerid][pAlerta]), GetYesOrNoConfig(PLAYER_INFO[playerid][pGuia]), GetYesOrNoConfig(PLAYER_INFO[playerid][pBarras]), GetYesOrNoConfig(PLAYER_INFO[playerid][pVelocimetro]), GetYesOrNoConfig(RP_AutoLogin[playerid]), ANAME, AOPTIONS);
    dialogs_ShowPlayerDialog(playerid, DCONFIG, DIALOG_STYLE_TABLIST_HEADERS, "Opciones de configuracion", string, "Cambiar", "Cerrar");
    return 1;
}

