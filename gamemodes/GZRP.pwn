//====================================    STOCKS     ====================================//

stock ObtenerCasaID(playerid, & lacasa) {
    for(new casa = 0; casa < MAX_PROPIEDADES; casa++) {
        if (GetPlayerVirtualWorld(playerid) == PropInfo[casa][pVW]) {
            lacasa = casa;
        }
    }
    return true;
}
stock LocalizarPropiedad(playerid) {
    new string[100 * MAX_PCASAS];
    for(new i = 0; i < MAX_PCASAS; i++) {
        if (PLAYER_INFO[playerid][CasaID][i] == 0) continue;
        for(new p = 0; p < MAX_PROPIEDADES; p++) {
            if (PropInfo[p][pID] == PLAYER_INFO[playerid][CasaID][i]) format(string, sizeof(string), "%s Ubicacion: {DBED15}%s{FFFFFF} | Interior: {009BE4}%d{FFFFFF}\n", string, PropInfo[p][pLocalizacion], PropInfo[p][pInterior]);
        }
    }
    dialogs_ShowPlayerDialog(playerid, LocalizarP, DIALOG_STYLE_LIST, "Selecciona la propiedad que deseas localizar", string, "Localizar", "Cancelar");
    return 1;
}
stock LocalizarAmigo(playerid) {
    new amigoenc = 0, contador2 = 0, info2[1000];
    foreach(new i : Player) {
        if (i != playerid) {
            if (!IsPlayerNPC(i)) {
                if (IsPlayerConnected(i)) {
                    if (strcmp(PLAYER_INFO[playerid][Totem], PLAYER_INFO[i][Nickname], true) == 0) {
                        if (strcmp(PLAYER_INFO[i][Totem], PLAYER_INFO[playerid][Nickname]) == 0) continue;
                        amigoenc = 1;
                        format(info2, sizeof(info2), "%s\n{00CCFF}%s", info2, PLAYER_INFO[i][Nickname]);
                        TotemBuscar[playerid][contador2] = i;
                        contador2++;
                    } else if (strcmp(PLAYER_INFO[i][Totem], PLAYER_INFO[playerid][Nickname], true) == 0) {
                        amigoenc = 1;
                        format(info2, sizeof(info2), "%s\n{00CCFF}%s", info2, PLAYER_INFO[i][Nickname]);
                        TotemBuscar[playerid][contador2] = i;
                        contador2++;
                    }
                }
            }
        }
    }
    if (amigoenc == 0) return SendClientMessage(playerid, -1, "No hay ningun amigo conectado con cuenta vinculada en este momento.");
    dialogs_ShowPlayerDialog(playerid, LOCALIZARAMIGO, DIALOG_STYLE_LIST, "Localizar Amigo", info2, "Localizar", "Salir");
    return 1;
}
//

stock ObtenerCasas(playerid) {
    new casas;
    for(new i = 0; i < MAX_PCASAS; i++) {
        if (PLAYER_INFO[playerid][CasaID][i] == 0) continue;
        else casas++;
    }
    return casas;
}

stock SlotPropiedad(playerid) {
    new slot = -1;
    for(new i = 0; i < MAX_PCASAS; i++) {
        if (PLAYER_INFO[playerid][CasaID][i] != 0) continue;
        else {
            slot = i;
            break;
        }
    }
    return slot;
}

HidePlayerGangZones(playerid) {
    for(new i = 0; i != MAX_T; i++) {
        if (!TerritorioInfo[i][Territorio_Valido]) continue;
        GangZoneHideForPlayer(playerid, TerritorioInfo[i][Territorio_GZ]);
    }
    return 1;
}
GetInvitacionesPlayerid(playerid) {
    new Query[150];
    mysql_format(handle_db, Query, sizeof(Query), "SELECT * FROM `invitaciones` WHERE `Invitado`='%s'", PLAYER_INFO[playerid][Nickname]);
    mysql_query(handle_db, Query, true);
    return cache_num_rows();
}

stock LimpiarAnuncios() {
    format(_InfoAnuncio[2][Anuncio], 128, " ");
    TextDrawSetString(_InfoAnuncio[2][TDAnuncio], _InfoAnuncio[2][Anuncio]);
    format(_InfoAnuncio[1][Anuncio], 128, " ");
    TextDrawSetString(_InfoAnuncio[1][TDAnuncio], _InfoAnuncio[1][Anuncio]);
    format(_InfoAnuncio[0][Anuncio], 128, " ");
    TextDrawSetString(_InfoAnuncio[0][TDAnuncio], _InfoAnuncio[0][Anuncio]);
    return 1;
}
stock PlantaOcupada(id) {
    for(new p = 0; p < MAX_MARIHUANA; p++) {
        if (MariInfo[p][Creado] == 1 && MariInfo[p][State] != 0 && p == id) return 1;
    }
    return -1;
}

stock PlantaLibre() {
    for(new p = 0; p < MAX_MARIHUANA; p++) {
        if (MariInfo[p][Creado] == 0 && MariInfo[p][State] == 0 && p != 0) return p;
    }
    return -1;
}

stock CuantoPlanto(playerid) {
    new count;
    for(new i = 0; i < MAX_MARIHUANA; i++) {
        if (strcmp(MariInfo[i][Plantador], NombreJugador(playerid), true) == 0) count++;
    }
    return count;
}
forward CosechandoPlanta(playerid, id);
public CosechandoPlanta(playerid, id) {
    if (EstaEn(playerid, 2.0, MariInfo[id][pX], MariInfo[id][pY], MariInfo[id][pZ])) {
        if (MariInfo[id][State] == 3) {
            DestroyDynamicObjectEx(MariInfo[id][ObjetoID]);
            DestroyDynamic3DTextLabel(MariInfo[id][Label]);
            PLAYER_INFO[playerid][pMarihuana] += 15;
            MensajeEx(playerid, -1, "Consigues {00CC00}15 gramos de marihuana{FFFFFF}, ahora puedes {DBED15}/armar porro{FFFFFF}.");
            LoopingAnim(playerid, "CARRY", "crry_prtial", 1.0, 0, 0, 0, 0, 0);
            MariInfo[id][Creado] = 0;
            MariInfo[id][State] = 0;
            MariInfo[id][pX] = 0;
            MariInfo[id][pY] = 0;
            MariInfo[id][pZ] = 0;
            format(MariInfo[id][Plantador], 24, "Nadie");
            RevisarLogro(playerid, 7);
            return 1;
        }
    }
    return 1;
}
forward TirandoRecogiendo(playerid);
public TirandoRecogiendo(playerid) { Tirando_Recogiendo[playerid] = 0; }
