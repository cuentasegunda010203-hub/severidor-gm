                            return ShowTuning(playerid, dialogid);
                        }
                        if (slot == -1) {
                            SendClientMessage(playerid, -1, "{999999}No hay mas espacio para objetos en este vehículo.");
                            return ShowTuning(playerid, dialogid);
                        }
                        if (PLAYER_INFO[playerid][jDinero] < 20000) return SendClientMessage(playerid, -1, "No tienes el dinero suficiente ($20.000)");
                        C_Type[playerid] = 0;
                        ShowTuning(playerid, DIALOG_VOBJECT_COUNTRY);
                    }
                    case 4: {
                        new slot = GetVehicleFreeObjectSlot(TuneandoCoche[playerid]);
                        if (PLAYER_INFO[playerid][pVip] == 0 && slot >= 5) {
                            PlayerPlaySound(playerid, 1085, 0.0, 0.0, 0.0);
                            SendClientMessage(playerid, -1, "{FFFFFF}¡Los jugadores VIP pueden tener hasta 10 objetos en vehículos!");
                            return ShowTuning(playerid, dialogid);
