            if (listitem == 10) {
                ChangeVehicleColor(Coche, 157, 157);
                PlayerPlaySound(playerid, 1134, 0.0, 0.0, 0.0);
                SendClientMessage(playerid, Morado, "Nuevo color adquirido: Morado");
            }
            if (listitem == 11) {
                ChangeVehicleColor(Coche, 92, 92);
                PlayerPlaySound(playerid, 1134, 0.0, 0.0, 0.0);
                SendClientMessage(playerid, Gris, "Nuevo color adquirido: Gris");
            }
        }
        return 1;
    }
    if(dialogid == Tuning + 3) {
        if(!response) return 1;
        new count = RP_PaintjobCount(GetVehicleModel(Coche));
        if(!count || Coche != RP_TuningVehicle[playerid] || listitem < 0 || listitem > count) return 1;
        ChangeVehiclePaintjob(Coche, listitem == count ? 3 : listitem);
        return 1;
    }
    if(dialogid == Tuning + 4) {
        if(!response || listitem < 0 || listitem > 2) return 1;
        new const components[] = {1009,1008,1010};
        if(RP_AddTuningComponent(playerid, Coche, components[listitem], 15000)) SendClientMessage(playerid, -1, "Nitro instalado por $15000.");
        return 1;
    }
    if(dialogid == Tuning + 5 || dialogid == Tuning + 6) {
        if(!response || Coche != RP_TuningVehicle[playerid] || listitem < 0 || listitem >= RP_TuningCount[playerid]) return 1;
        RP_AddTuningComponent(playerid, Coche, RP_TuningChoices[playerid][listitem]);
        return 1;
    }
    switch (dialogid) {
        case JOB_ALBAnIL_CONSEGUIR: {
            if (!response) return 1;
            if (!JugadorLogeado[playerid] || GetPlayerVirtualWorld(playerid) != 0 || GetPlayerInterior(playerid) != 0 || !IsPlayerInRangeOfPoint(playerid, 2.0, 1960.5045, -1318.6222, 23.5397)) return 1;
            if (PLAYER_INFO[playerid][pTrabajo] == T_Albanil || PLAYER_INFO[playerid][pTrabajo2] == T_Albanil) return RP_ResignConstruction(playerid);
            return RP_StartConstruction(playerid);
        }
        case D_ACEPTAR_VENTA: {
            if (response) {
                printf("[DEBUG] AceptarVenta(%s[%d]) listitem: %d", PLAYER_INFO[playerid][Nickname], playerid, listitem);
                AceptarVenta(playerid, listitem);
            }
        }
        case D_TOPS: {
            if (response) {
                TOPS(playerid, listitem);
            }
        }
        case D_BAUL: {
            if (response) {
                UsarBaul(playerid, PLAYER_TEMP[playerid][BaulSeleccionado], listitem);
            } else Notificador2(playerid, "~r~Cancelado"), EstadoBaul(playerid, 0);
        }
        case D_Casa: {
            if (response) {
                switch (listitem) {
                    case 1: {
                        for(new p = 0; p < MAX_PROPIEDADES; p++) {
                            if (PropInfo[p][pEnUso] == 1) {
                                if (PLAYER_INFO[playerid][pID] == PropInfo[p][pIDPropietario]) {
                                    if (GetPlayerVirtualWorld(playerid) == PropInfo[p][pVW] && GetPlayerInterior(playerid) == PropInfo[p][pInteriorID]) {
                                        if (PropInfo[p][pAbierta] == 0) {
                                            if (PropInfo[p][pTipo] == 3) {
                                                if (!IsValidDynamicPickup(PropInfo[p][pPickup])) PropInfo[p][pPickup] = CreateDynamicPickup(1318, 23, PropInfo[p][pPosX], PropInfo[p][pPosY], PropInfo[p][pPosZ], 0);
                                                if (!IsValidDynamicMapIcon(PropInfo[p][pMapIcon])) PropInfo[p][pMapIcon] = CreateDynamicMapIcon(PropInfo[p][pPosX], PropInfo[p][pPosY], PropInfo[p][pPosZ], 50, 0, 0, 0, -1, 600.0);
                                            }
                                            PropInfo[p][pAbierta] = 1;
                                            AccionesRol(playerid, "abre la puerta de su propiedad.", 20);
                                            GuardarPropiedad(p);
                                        } else {
                                            if (PropInfo[p][pTipo] == 3) {
                                                if (IsValidDynamicPickup(PropInfo[p][pPickup])) DestroyDynamicPickup(PropInfo[p][pPickup]);
                                                if (IsValidDynamicMapIcon(PropInfo[p][pMapIcon])) DestroyDynamicMapIcon(PropInfo[p][pMapIcon]);
                                            }
                                            PropInfo[p][pAbierta] = 0;
                                            AccionesRol(playerid, "cierra la puerta de su propiedad.", 20);
                                            GuardarPropiedad(p);
                                        }
                                        return 1;
                                    }
                                }
                            }
                        }
                    }
                    case 2: { MC_MenuShow(playerid); }
                    case 3: { MC_MenuShow(playerid); MC_ListShow(playerid,true); }
                    case 6: { HP_Show(playerid); }
                    case 7: { GT_List(playerid); }
                    case 5 :  {
                        SendClientMessage(playerid, -1, "En desarrollo.");
                    }
                }
            }
        }
        case D_CasaMuebles: {
            if (response) {
                new casaid = -1, OBJ_INDEX, string2[2048], bool:found = false;
                ObtenerCasaID(playerid, casaid);
                if (casaid == -1) return false;
                switch (listitem) {
                    case 0: {
                        for(new i; i < MAX_OBJETOS_CASAS; i++) {
                            if (PropInfo[casaid][ModeloMuebles][i] > 0) {
                                BuscarModeIndexInt(PropInfo[casaid][ModeloMuebles][i], OBJ_INDEX);
                                format(string2, sizeof(string2), "%s> %s\t%s\n", string2, ObjetosInterior[OBJ_INDEX][2], GetMuebleStatus(PropInfo[casaid][Puesto][i]));
                                found = true;
                            }
                        }
                        if (found == true) dialogs_ShowPlayerDialog(playerid, D_PonerMueble, DIALOG_STYLE_TABLIST, "> Colocar un mueble", string2, "Colocar", "Cerrar");
                        else SendClientMessage(playerid, -1, "No tienes muebles para poner.");
                    }
                    case 1: {
                        for(new i; i < MAX_OBJETOS_CASAS; i++) {
                            if (PropInfo[casaid][ModeloMuebles][i] > 0) {
                                BuscarModeIndexInt(PropInfo[casaid][ModeloMuebles][i], OBJ_INDEX);
                                format(string2, sizeof(string2), "%s> %s\t%s\n", string2, ObjetosInterior[OBJ_INDEX][2], GetMuebleStatus(PropInfo[casaid][Puesto][i]));
                                found = true;
                            }
                        }
                        if (found == true) dialogs_ShowPlayerDialog(playerid, D_VenderMueble, DIALOG_STYLE_TABLIST, "> Vender un mueble", string2, "Vender", "Cerrar");
                        else SendClientMessage(playerid, -1, "No tienes muebles para poner.");
                    }
                    case 2: {
                        for(new i; i < MAX_OBJETOS_CASAS; i++) {
                            if (PropInfo[casaid][ModeloMuebles][i] > 0) {
                                BuscarModeIndexInt(PropInfo[casaid][ModeloMuebles][i], OBJ_INDEX);
                                format(string2, sizeof(string2), "%s> %s\t%s\n", string2, ObjetosInterior[OBJ_INDEX][2], GetMuebleStatus(PropInfo[casaid][Puesto][i]));
                                found = true;
                            }
                        }
                        if (found == true) dialogs_ShowPlayerDialog(playerid, D_AcomodarMueble, DIALOG_STYLE_TABLIST, "> Acomodar un mueble", string2, "Seleccionar", "Cerrar");
                        else SendClientMessage(playerid, -1, "No tienes muebles para poner.");
                    }
                    case 3: {
                        for(new i; i < MAX_OBJETOS_CASAS; i++) {
                            if (PropInfo[casaid][ModeloMuebles][i] > 0) {
                                BuscarModeIndexInt(PropInfo[casaid][ModeloMuebles][i], OBJ_INDEX);
                                format(string2, sizeof(string2), "%s> %s\t%s\n", string2, ObjetosInterior[OBJ_INDEX][2], GetMuebleStatus(PropInfo[casaid][Puesto][i]));
                                found = true;
                            }
                        }
                        if (found == true) dialogs_ShowPlayerDialog(playerid, D_QuitarMueble, DIALOG_STYLE_TABLIST, "> Quitar mueble", string2, "Quitar", "Cerrar");
                        else SendClientMessage(playerid, -1, "No tienes muebles para poner.");
                    }
                }
            }
        }
        case D_VenderMueble: {

            if (response) {
                new casaid, INDEX_ITEM, oID;
                ObtenerCasaID(playerid, casaid);
                for(new i = 0; i < listitem + 1; i++) {
                    if (PropInfo[casaid][ModeloMuebles][i]) {
                        BuscarModeIndexInt(PropInfo[casaid][ModeloMuebles][i], INDEX_ITEM);
                        oID = i;
                    }
                }
                VenderMuebleCasa(playerid, oID, casaid);
            }
        }
        case D_QuitarMueble: {
            if (response) {
                new casaid, INDEX_ITEM, oID;
                ObtenerCasaID(playerid, casaid);
                for(new i = 0; i < listitem + 1; i++) {
                    if (PropInfo[casaid][ModeloMuebles][i]) {
                        BuscarModeIndexInt(PropInfo[casaid][ModeloMuebles][i], INDEX_ITEM);
                        oID = i;
                    }
                }
                if (PropInfo[casaid][Puesto][oID] > 0) {
                    if (IsValidDynamicObject(PropInfo[casaid][Inmobiliario][oID])) DestroyDynamicObject(PropInfo[casaid][Inmobiliario][oID]);
                    PropInfo[casaid][Puesto][oID] = 0;
                } else return SendClientMessage(playerid, -1, "Este mueble no se encuentra puesto en tu casa.");
            }
        }
        case D_AcomodarMueble: {
            if (response) {
                new casaid, INDEX_ITEM, oID;
                ObtenerCasaID(playerid, casaid);
                for(new i = 0; i < listitem + 1; i++) {
                    if (PropInfo[casaid][ModeloMuebles][i]) {
                        BuscarModeIndexInt(PropInfo[casaid][ModeloMuebles][i], INDEX_ITEM);
                        oID = i;
                    }
                }
                if (PropInfo[casaid][Puesto][oID] > 0) {
                    SetPVarInt(playerid, "EditandoMuebles", 1);
                    SetPVarInt(playerid, "ID_MUEBLE", oID);
                    EditDynamicObject(playerid, PropInfo[casaid][Inmobiliario][oID]);
                } else return SendClientMessage(playerid, -1, "Este mueble no se encuentra puesto en tu casa.");
            }
        }
        case D_PonerMueble: {
            if (response) {
                new casaid, INDEX_ITEM, oID;
                ObtenerCasaID(playerid, casaid);
                for(new i = 0; i < listitem + 1; i++) {
                    if (PropInfo[casaid][ModeloMuebles][i]) {
                        BuscarModeIndexInt(PropInfo[casaid][ModeloMuebles][i], INDEX_ITEM);
                        oID = i;
                    }
                }
                if (PropInfo[casaid][Puesto][oID] > 0) return SendClientMessage(playerid, 0xFFFFFF, "Error: Este mueble ya se encuentra puesto en tu casa.");
                if (IsPlayerInRangeOfPoint(playerid, 250.0, PropInfo[casaid][MuebleX1][oID], PropInfo[casaid][MuebleY1][oID], PropInfo[casaid][MuebleZ1][oID])) {
                    PropInfo[casaid][Inmobiliario][oID] = CreateDynamicObject(PropInfo[casaid][ModeloMuebles][oID], PropInfo[casaid][MuebleX1][oID], PropInfo[casaid][MuebleY1][oID], PropInfo[casaid][MuebleZ1][oID], PropInfo[casaid][MuebleX2][oID], PropInfo[casaid][MuebleY2][oID], PropInfo[casaid][MuebleZ2][oID], PropInfo[casaid][pVW]);
                } else {
                    GetPlayerPos(playerid, PropInfo[casaid][MuebleX1][oID], PropInfo[casaid][MuebleY1][oID], PropInfo[casaid][MuebleZ1][oID]);
                    GetPosInFrontOfPlayer(playerid, PropInfo[casaid][MuebleX1][oID], PropInfo[casaid][MuebleY1][oID], 1.5);
                    PropInfo[casaid][Inmobiliario][oID] = CreateDynamicObject(PropInfo[casaid][ModeloMuebles][oID], PropInfo[casaid][MuebleX1][oID], PropInfo[casaid][MuebleY1][oID], PropInfo[casaid][MuebleZ1][oID], PropInfo[casaid][MuebleX2][oID], PropInfo[casaid][MuebleY2][oID], PropInfo[casaid][MuebleZ2][oID], PropInfo[casaid][pVW]);
                    EditDynamicObject(playerid, PropInfo[casaid][Inmobiliario][oID]);
                }
                SetPVarInt(playerid, "ID_MUEBLE", oID);
                PropInfo[casaid][Puesto][oID] = 1;
                SetPVarInt(playerid, "EditandoMuebles", 1);
            }
        }
        case DIALOG_GASOLINERAE: {
            if (response) {
                switch (listitem) {
                    case 0 : return callcmd::llenar(playerid, "tanque");
                    case 1 : dialogs_ShowPlayerDialog(playerid, DIALOG_GASOLINERA_C, DIALOG_STYLE_INPUT, "Menu de gasolinera", "Ingresa la cantidad de combustible a cargar:", "Aceptar", "Cancelar");
                    case 2 : return callcmd::comprar(playerid, "bidon");
                }
            }
        }
        case DIALOG_GASOLINERA_C: {
            if (response) {
                if (!IsNumeric(inputtext) || isnull(inputtext)) return SendClientMessage(playerid, -1, "Debe ingresar un valor numerico.");
                callcmd::combustible(playerid, inputtext);
            }
        }
        case ADM_GASOLINERA_L: {
            if (response) {
                if (!IsNumeric(inputtext) || isnull(inputtext)) return SendClientMessage(playerid, -1, "Debe ingresar un valor numerico entre $5 y $100.");
                if (strval(inputtext) > 100) return SendClientMessage(playerid, -1, "Debe ingresar un valor numerico entre $0 y $100.");

                for(new g = 0; g < MAX_GASOLINERAS; g++) {
                    if (IsPlayerInRangeOfPoint(playerid, 2, Gasolineras[g][Posss][0], Gasolineras[g][Posss][1], Gasolineras[g][Posss][2])) {
                        if (Gasolineras[g][gEnUso] == 1) {
                            if (PLAYER_INFO[playerid][pID] != Gasolineras[g][gDuenoID]) return 1;
                            SendClientMessageEx(playerid, -1, "Cambiaste el precio del combustible a {00CA00}$%d{FFFFFF} por litro.", strval(inputtext));
                            Gasolineras[g][gPrecioL] = strval(inputtext);
                            //3dgaso
                            new gasolineraxd[256];
                            format(gasolineraxd, sizeof gasolineraxd, "{FFFFFF}Pulsa {DBED15}'H'{FFFFFF} para abrir el menu de opciones.\nPrecio: {00CC00}$%d{FFFFFF} cada litro\nCantidad de combustible: %d/%d", Gasolineras[g][gPrecioL], Gasolineras[g][gGasolina], Gasolineras[g][gMaxGasolina]);
                            UpdateDynamic3DTextLabelText(Gasolineras[g][gTexto], 0xFFFFFFAA, gasolineraxd);
                            GuardarGasolinera(g);
                        }
                    }
                }
            }
        }
        case GASOLINERA_ADD: {
            if (response) {
                for(new g = 0; g < MAX_GASOLINERAS; g++) {
                    if (IsPlayerInRangeOfPoint(playerid, 2, Gasolineras[g][Posss][0], Gasolineras[g][Posss][1], Gasolineras[g][Posss][2])) {
                        if (Gasolineras[g][gEnUso] == 1) {
                            
                            if (PLAYER_INFO[playerid][jDinero] < 200000) return SendClientMessage(playerid, -1, "No tienes el dinero suficiente para comprar otro tanque de almacenamiento.");
                            Gasolineras[g][gMaxGasolina] += Gasolineras[g][gMaxGasolina] + 200;
                            QuitarDinero(playerid, 200000);
                            new gasolineraxd[256];
                            format(gasolineraxd, sizeof gasolineraxd, "{FFFFFF}Pulsa {DBED15}'H'{FFFFFF} para abrir el menu de opciones.\nPrecio: {00CC00}$%d{FFFFFF} cada litro\nCantidad de combustible: %d/%d", Gasolineras[g][gPrecioL], Gasolineras[g][gGasolina], Gasolineras[g][gMaxGasolina]);
                            UpdateDynamic3DTextLabelText(Gasolineras[g][gTexto], 0xFFFFFFAA, gasolineraxd);
                            GuardarGasolinera(g);
                        }
                    }
                }
            }
        }
        case ADM_GASOLINERA: {
            if (response) {
                switch (listitem) {
                    case 0 : dialogs_ShowPlayerDialog(playerid, ADM_GASOLINERA_L, DIALOG_STYLE_INPUT, "Gasolinera", "{FFFFFF}Ingresa el precio del litro de combustible\nMínimo 0 - Maximo 100.\nRecuerda que la distribuidora lo vende a $5.", "Aceptar", "Cancelar");
                    case 1 : dialogs_ShowPlayerDialog(playerid, GASOLINERA_ADD, DIALOG_STYLE_MSGBOX, "Gasolinera", "{FFFFFF}Comprar un tanque de almacenamiento para la gasolinera tiene un costo de {00CA00}$200.000\n{FFFFFF}¿Quieres comprar un tanque de 200 litros por {00CA00}$200.000{FFFFFF}?.", "Comprar", "Cancelar");
                    case 2: {
                        for(new g = 0; g < MAX_GASOLINERAS; g++) {
                            if (IsPlayerInRangeOfPoint(playerid, 2, Gasolineras[g][Posss][0], Gasolineras[g][Posss][1], Gasolineras[g][Posss][2])) {
                                if (Gasolineras[g][gEnUso] == 1) {
                                    if (PLAYER_INFO[playerid][pID] != Gasolineras[g][gDuenoID]) return 1;
                                    if (Gasolineras[g][gGasolina] == Gasolineras[g][gMaxGasolina]) return SendClientMessage(playerid, -1, "El tanque de esta gasolinera esta lleno.");
                                    //Trabajo Distribuidor
                                    if (PLAYER_INFO[playerid][vModelo] == 584 || PLAYER_INFO[playerid][vModelo2] == 584 || PLAYER_INFO[playerid][vModelo3] == 584 || PLAYER_INFO[playerid][vModelo4] == 584 || PLAYER_INFO[playerid][vModelo5] == 584) {
                                        PLAYER_TEMP[playerid][CargaGasolinera] = g;
                                        rtatrucker[playerid] = 100;
                                        SendClientMessage(playerid, -1, "La distribuidora de gasolina, fue marcada en el mapa");
                                        SendClientMessage(playerid, -1, "Trae el trailer cargado para llenar el tanque");
                                        SetPlayerCheckpoint(playerid, 8712.5752, -1783.7819, 86.8102, 5.0);
                                        MostrarRutaFerry(playerid);
                                    } else return SendClientMessage(playerid, -1, "Necesitas comprar un trailer para poder transportar combustible.");
                                }
                            }
                        }
                    }
                    case 3: {
                        for(new g = 0; g < MAX_GASOLINERAS; g++) {
                            if (IsPlayerInRangeOfPoint(playerid, 2, Gasolineras[g][Posss][0], Gasolineras[g][Posss][1], Gasolineras[g][Posss][2])) {
                                if (Gasolineras[g][gEnUso] == 1) {
                                    if (PLAYER_INFO[playerid][pID] != Gasolineras[g][gDuenoID]) return 1;
                                    return RP_EcoGasWithdraw(playerid,g);
                                }
                            }
                        }
                    }
                }
            }
        }
        case D_Ilista: {if(response) RP_SAFDFireSelection(playerid,listitem,true);}
        case D_Ibuscar: {if(response) RP_SAFDFireSelection(playerid,listitem,false);}
        case D_Gbuscar: {
            if (response == 1) {
                new gid = PLAYER_TEMP[playerid][ListaGasolineras][listitem];
                new location[MAX_ZONE_NAME], string6[256];
                Get2DZone(location, MAX_ZONE_NAME, Gasolineras[gid][Poss2][0], Gasolineras[gid][Poss2][1], Gasolineras[gid][Poss2][2]);
                format(string6, sizeof(string6), "Se ha marcado la ~y~gasolinera~w~ en direccion ~g~~h~~h~%s~w~.", location);
                StartPlayerPath(playerid, Gasolineras[gid][Poss2][0], Gasolineras[gid][Poss2][1], Gasolineras[gid][Poss2][2], 2);
                ShowPlayerMessage(playerid, string6);
            }
        }
        case D_VEHFACC:
        {
            if(response == 1)
            {
               new k = PLAYER_TEMP[playerid][LVehFacc][listitem];
               PLAYER_TEMP[playerid][VehFacc_S] = k;
               new strings[50];
               format(strings, sizeof(strings), "%s", NombreAuto[GetVehicleModel(k) - 400]);
               Dialog(playerid, D_VEHFACC_OPT, DIALOG_STYLE_LIST, strings, "Localizar\nRespawnear\nConfigurar", "Aceptar", "Cancelar");
            }
        }
        case D_CONFIG_VEHDATA:
        {
            if(response)
            {
                switch(listitem)
                {
                    case 0: //Configurar rango
                    {
                        new str[128];
                        format(str, sizeof(str), "Ninguno\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s", 
                        ObtenerVehRango(PLAYER_INFO[playerid][pFaccion], 1), 
                        ObtenerVehRango(PLAYER_INFO[playerid][pFaccion], 2), 
                        ObtenerVehRango(PLAYER_INFO[playerid][pFaccion], 3), 
                        ObtenerVehRango(PLAYER_INFO[playerid][pFaccion], 4), 
                        ObtenerVehRango(PLAYER_INFO[playerid][pFaccion], 5), 
                        ObtenerVehRango(PLAYER_INFO[playerid][pFaccion], 6), 
                        ObtenerVehRango(PLAYER_INFO[playerid][pFaccion], 7), 
                        ObtenerVehRango(PLAYER_INFO[playerid][pFaccion], 8));
                        new nameveh[128], vid= PLAYER_TEMP[playerid][VehFacc_S];
                        format(nameveh, sizeof(nameveh), "Configurar %s", NombreAuto[Veh_Data[vid][vModel]-400]);
                        dialogs_ShowPlayerDialog(playerid, D_CONFIG_VEHDATA_R, DIALOG_STYLE_TABLIST, nameveh, str, "Aceptar", "Cancelar");

                        ShowPlayerMessage(playerid, "~g~Selecciona desde que rango pueden usar el ~w~vehiculo~g~.");
                    }
                    case 1: //Borrar objetos tuning
                    {
                        ShowPlayerMessage(playerid, "~y~En desarrollo...");
                    }
                }
            }
        }
        case D_CONFIG_VEHDATA_R:
        {
            if(response)
            {
                new banda = PLAYER_INFO[playerid][pFaccion];
                new vid = PLAYER_TEMP[playerid][VehFacc_S];
                Veh_Data[vid][vRango] = listitem;
                SendClientMessageEx(playerid, COLOR_GAMEMODE, "{%06x}Ahora miembros igual o mayor al rango %s podrán usar este vehículo.", BandasInfo[banda][BColor] >>> 8, ObtenerVehRango(banda, Veh_Data[vid][vRango]));
            }
        }
        case D_VEHFACC_OPT:
        {
            if(response == 1)
            {
                new k = PLAYER_TEMP[playerid][VehFacc_S];
                switch(listitem)
                {
                    case 0:
                    {
                        new location[MAX_ZONE_NAME], string6[256];
                        new Float:PosVeh[3];
                        GetVehiclePos(k, PosVeh[0], PosVeh[1], PosVeh[2]);
                        Get2DZone(location, MAX_ZONE_NAME, PosVeh[0], PosVeh[1], PosVeh[2]);
                        format(string6, sizeof(string6), "Se ha marcado la ~y~posicion~w~ del ~g~~h~~h~%s~w~.", NombreAuto[GetVehicleModel(k)-400]);
                        StartPlayerPath(playerid, PosVeh[0], PosVeh[1], PosVeh[2], 2);
                        ShowPlayerMessage(playerid, string6);
                    }
                    case 1:
                    {
                        Respawnear(k);
                        ShowPlayerMessage(playerid, "~g~Vehiculo respawneado");
                    }
                    case 2:
                    {
                        ConfigurarVehData(playerid, k);
                    }
                }
            }
        }
        case D_Mbuscar: {
            if (response) {
                new m = PLAYER_TEMP[playerid][ListaMnegros][listitem];
                SendClientMessageEx(playerid, -1, "Se ha marcado el Black Market en direccion %s.", ObtenerUbicacionM(m));
                StartPlayerPath(playerid, InfoMercado[m][mX], InfoMercado[m][mY], InfoMercado[m][mZ], 2);
            }
        }
        case DIALOG_VIDA_JUGADORES: {
            if (response) {
                foreach(new i : Player) {
                    if (JugandoEventoDinamico[i] == true && LoggedYet[i] == true) {
                        EstablecerChaleco(i, strval(inputtext));
                    }
                }
                MostrarDialogoEvento(playerid);
            } else MostrarDialogoEvento(playerid);
        }
        case DIALOG_ARMOR_JUGADORES: {
            if (response) {
                foreach(new i : Player) {
                    if (JugandoEventoDinamico[i] == true && LoggedYet[i] == true) {
                        EstablecerVida(i, strval(inputtext));
                    }
                }
                MostrarDialogoEvento(playerid);
            } else MostrarDialogoEvento(playerid);
        }
        case DIALOG_CHANGENAME_EVENT: {
            if (response) {
                format(NombreEventoDynamic, sizeof(NombreEventoDynamic), inputtext);
                TextDrawSetString(TeleportEvent[0], inputtext);
                MostrarDialogoEvento(playerid);
            } else MostrarDialogoEvento(playerid);
        }
        case DIALOG_SET_VEHICLE_EVENT: {
            if (response) {
                foreach(new i : Player) {
                    if (TipoDeAuto[playerid] == 2 && (i % 2 == 0)) continue;
                    if (JugandoEventoDinamico[i] == true && LoggedYet[i] == true) {
                        new Float:x, Float:y, Float:z, Float:a;
                        GetPlayerPos(i, x, y, z);
                        GetPlayerFacingAngle(i, a);
                        VehiculoEvento[i] = LZ_CreateVehicle(listitem + 400, x, y, z, a, -1, -1, -1);
                        PutPlayerInVehicle(i, VehiculoEvento[i], 0);
                    }
                }
                MostrarDialogoEvento(playerid);
                SendClientMessageEx(playerid, 0xFFFFFFFF, "{ffa500}» Evento:{FFFFFF} Se le dio un %s a todos los jugadores del evento.", NombreAuto[listitem]);
            } else MostrarDialogoEvento(playerid);
        }
        case DIALOG_SETEAR_VIDA:  {
            if (response) {
                if (IsNumeric(inputtext) == 0 || isnull(inputtext)) return SendClientMessage(playerid, 0xFFFFFFFF, "{ffa500}» Evento:{FFFFFF} Ingresa una ID para kickear un jugador del evento.");
                if (strval(inputtext) <= 375.0) return SendClientMessage(playerid, 0xFFFFFFFF, "{ffa500}» Evento:{FFFFFF} La vida debe ser mayor a 375, de lo contrario los autos estarian averiados.");
                foreach(new i : Player) {
                    if (JugandoEventoDinamico[i] == true && LoggedYet[i] == true) {
                        if (IsValidVehicle(VehiculoEvento[i])) SetVehicleHealth(VehiculoEvento[i], strval(inputtext));
                    }
                }
                MostrarDialogoEvento(playerid);
            }
        }
        case DIALOG_VEHICLE_EVENT:  {
            if (response) {
                switch (listitem) {
                    case 0 :  { // Dar un vehiculo a cada jugador
                        new vehicles[4096];
                        for(new i = 400; i < 600; i++) {
                            StrcatEx(vehicles, sizeof vehicles, "{ffa500}» {FFFFFF}%s (ID: %d)\n", NombreAuto[i - 400], i);
                        }
                        TipoDeAuto[playerid] = 1;
                        dialogs_ShowPlayerDialog(playerid, DIALOG_SET_VEHICLE_EVENT, DIALOG_STYLE_LIST, "{ffa500}Selecciona el modelo de vehículo", vehicles, "Seleccionar", "Cancelar");
                    }
                    case 1 :  { // Dar un vehículo a un jugador si, otro no
                        new vehicles[4096];
                        for(new i = 400; i < 600; i++) {
                            StrcatEx(vehicles, sizeof vehicles, "{ffa500}» {FFFFFF}%s (ID: %d)\n", NombreAuto[i - 400], i);
                        }
                        TipoDeAuto[playerid] = 2;
                        dialogs_ShowPlayerDialog(playerid, DIALOG_SET_VEHICLE_EVENT, DIALOG_STYLE_LIST, "{ffa500}»{ffa500}» Evento:{FFFFFF} Selecciona el modelo de vehículo", vehicles, "Seleccionar", "Cancelar");
                    }
                    case 2 :  { // Eliminar vehículo de los participantes
                        foreach(new i : Player) {
                            if (JugandoEventoDinamico[i] == true && LoggedYet[i] == true) {
                                if (IsValidVehicle(VehiculoEvento[i])) DestroyVehicleEx(VehiculoEvento[i]);
                            }
                        }
                        SendClientMessage(playerid, 0xFFFFFFFF, "Se le quito el vehículo a los participantes del evento.");
                        MostrarDialogoEvento(playerid);
                    }
                    case 3 :  { // Setear vida de los vehículos
                        new str[53 + 1];
                        format(str, sizeof(str), "%sIngresa la cantidad de vida para los autos del evento", str);
                        dialogs_ShowPlayerDialog(playerid, DIALOG_SETEAR_VIDA, DIALOG_STYLE_INPUT, "{ffa500}Setear vida de los vehículos", str, "Setear", "Cancelar");
                    }
                }
            } else MostrarDialogoEvento(playerid);
        }
        case DIALOG_KICKPLAYER_EVENT: {
            if (response) {
                if (IsNumeric(inputtext) == 0 || isnull(inputtext)) return SendClientMessage(playerid, 0xFFFFFFFF, "{ffa500}» Evento:{FFFFFF} Ingresa una ID para kickear un jugador del evento.");
                if (JugandoEventoDinamico[strval(inputtext)] == false) return SendClientMessage(playerid, 0xFFFFFFFF, "{ffa500}» Evento:{FFFFFF} Este jugador no es un participante.");
                SetPosEx(strval(inputtext), BeforeEventX[strval(inputtext)], BeforeEventY[strval(inputtext)], BeforeEventZ[strval(inputtext)], BeforeEventA[strval(inputtext)], BeforeEventInt[strval(inputtext)], BeforeEventVw[strval(inputtext)], 1);
                SendClientMessageEx(playerid, 0xFFFFFFFF, "{ffa500}» Evento:{FFFFFF} El jugador {FF0000}%s{FFFFFF} fue expulsado del evento.", PLAYER_INFO[strval(inputtext)][Nickname]);
                SendClientMessageEx(strval(inputtext), 0xFFFFFFFF, "{ffa500}» Evento:{FFFFFF} El administrador %s te saco del evento", PLAYER_INFO[playerid][Nickname]);
                JugandoEventoDinamico[strval(inputtext)] = false;
                MostrarDialogoEvento(playerid);
            } else MostrarDialogoEvento(playerid);
        }
        case DARAMAS_EVENTO:  {
            if (response) {
                foreach(new i : Player) {
                    if (JugandoEventoDinamico[i] == true && LoggedYet[i] == true) {
                        DarArma(i, listitem);
                    }
                }
                SendClientMessageEx(playerid, 0xFFFFFFFF, "{ffa500}» Evento:{FFFFFF} Se dio una %s a todos los participantes.", ArmaNombre2[listitem]);
                MostrarDialogoEvento(playerid);
            } else MostrarDialogoEvento(playerid);
        }
        case DIALOG_ARMAS_EVENT:  {
            if (response) {
                switch (listitem) {
                    case 0 :  {
                        new string8[512];
                        for(new i = 0; i < sizeof ArmaNombre2; i++) {
                            StrcatEx(string8, sizeof(string8), "{ffa500}» {FFFFFF}%s\n", ArmaNombre2[i]);
                        }
                        dialogs_ShowPlayerDialog(playerid, DARAMAS_EVENTO, DIALOG_STYLE_LIST, "{ffa500}Selecciona el arma", string8, "Dar arma", "Cancelar");
                    }
                    case 1 :  {
                        foreach(new i : Player) {
                            if (JugandoEventoDinamico[i] == true && LoggedYet[i] == true) {
                                QuitarArmas(i);
                            }
                        }
                        SendClientMessage(playerid, 0xFFFFFFFF, "{ffa500}» Evento:{FFFFFF} Le quitaste las armas a los jugadores.");
                    }
                }
            } else MostrarDialogoEvento(playerid);
        }
        case DIALOG_AUDIO_EVENT:  {
            if (response) {
                foreach(new i : Player) {
                    if (JugandoEventoDinamico[i] == true && LoggedYet[i] == true) {
                        PlayAudioStreamForPlayer(i, inputtext);
                    }
                }
                PlayAudioStreamForPlayer(playerid, inputtext);
