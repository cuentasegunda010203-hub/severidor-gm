public ReactivarCaja() {
    if (RP_SafeResetTimer) KillTimer(RP_SafeResetTimer);
    RP_SafeResetTimer = 0;
    for (new p; p < MAX_PLAYERS; p++) RP_SafeCancel(p);
    for (new i; i < 4; i++) RP_SafeClaimAccount[i] = 0;
    CajaAbierta = 0;
    RobadaTM = 0;
    Robado[0] = 0;
    Robado[1] = 0;
    Robado[2] = 0;
    Robado[3] = 0;
    DestroyDynamic3DTextLabel(CajaFuerteTX);
    CajaFuerteTX = CreateDynamic3DTextLabel("{FFFFFF}CAJA FUERTE - CERRADA\nPulsa {"COLOR_GM "}Y{FFFFFF} para empezar a forzarla.", 0xFFFFFFFF, 820.41010, 8.37117, 1003.60370, 10.0);
    foreach(new i : Player) Notificador2(i, "~g~~h~[APSA] ~w~El banco de LSPD informa que se ha recuperado del reciente robo.");
    return 1;
}

public darroboc(playerid) {
    new cargos = 0;
    foreach(new c : Player) {
        if (PLAYER_INFO[c][pFaccion] == 1 && PLAYER_INFO[c][pDuty] == 1 && EstaEnP(playerid, c, 20.00)) cargos = 1;
        if (PLAYER_INFO[c][pFaccion] == 2 && PLAYER_INFO[c][pDuty] == 1 && EstaEnP(playerid, c, 20.00)) cargos = 1;
    }
    if (cargos == 1) {
        PLAYER_INFO[playerid][pCargos] = 0;
        SetPlayerWantedLevelEx(playerid, PLAYER_INFO[playerid][pCargos]);
        ShowPlayerMessage(playerid, "No lograste escapar de la policía por lo tanto los cargos no se te iran.");
    }
    TipoCargo[playerid] = 1;
    SetPlayerColor(playerid, c0_color);
    abrirrrobo(playerid);
    robobanco[playerid] = 0;
    DarPrendas(playerid);
    if (IsPlayerAttachedObjectSlotUsed(playerid, 4)) RemovePlayerAttachedObject(playerid, 4);
    return 1;
}
