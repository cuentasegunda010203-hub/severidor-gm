stock abrirrrobo(playerid) {
    if (!IsPlayerConnected(playerid)) return 1;
    if (JugadorLogeado[playerid] != 1) return 1;
    new regalo = random(14);
    switch (regalo) {
        case 0: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$50.000{FFFFFF} y {74F20C}1 Totems{FFFFFF} del robo.");
            DarDinero(playerid, 5000);
            PLAYER_INFO[playerid][Totems] += 1;
            PlayerPlaySound(playerid, 1139, 0.0, 0.0, 0.0);
        }
        case 1: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$58.000{FFFFFF} y {74F20C}2 "SERVER_COIN " {FFFFFF} del robo.");
            DarDinero(playerid, 58000);
            PLAYER_INFO[playerid][Moneda] += 2;
            PlayerPlaySound(playerid, 1139, 0.0, 0.0, 0.0);
        }
        case 2: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$70.000{FFFFFF} del robo.");
            DarDinero(playerid, 70000);
            PlayerPlaySound(playerid, 1139, 0.0, 0.0, 0.0);
        }
        case 3: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$71.000{FFFFFF} del robo.");
            DarDinero(playerid, 71000);
            PlayerPlaySound(playerid, 1139, 0.0, 0.0, 0.0);
        }
        case 4: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$40.000{FFFFFF} y {74F20C}500 piezas de armas{FFFFFF} del robo.");
            DarDinero(playerid, 40000);
            PLAYER_INFO[playerid][pMateriales] += 500;
            PlayerPlaySound(playerid, 1139, 0.0, 0.0, 0.0);
        }
        case 5: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$20.0000{FFFFFF} y {74F20C}1 "SERVER_COIN "{FFFFFF} del robo.");
            DarDinero(playerid, 20000);
            PLAYER_INFO[playerid][Moneda] += 1;
            PlayerPlaySound(playerid, 1139, 0.0, 0.0, 0.0);
        }
        case 6: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$44.000{FFFFFF} y {74F20C}1 Totems{FFFFFF} del robo.");
            DarDinero(playerid, 44000);
            PLAYER_INFO[playerid][Totems] += 1;
            PlayerPlaySound(playerid, 1139, 0.0, 0.0, 0.0);
        }
        case 7: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$42000{FFFFFF} y {74F20C}100 de crack{FFFFFF} del robo.");
            DarDinero(playerid, 42000);
            PLAYER_INFO[playerid][pCrack] += 100;
            PlayerPlaySound(playerid, 1139, 0.0, 0.0, 0.0);
        }
        case 8: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$5000{FFFFFF} y {74F20C}2 Totems{FFFFFF} del robo.");
            DarDinero(playerid, 5000);
            PLAYER_INFO[playerid][Totems] += 2;
            PlayerPlaySound(playerid, 1139, 0.0, 0.0, 0.0);
        }
        case 9: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$85000{FFFFFF} del robo.");
            DarDinero(playerid, 85000);
            DarArma(playerid, 8);
            PlayerPlaySound(playerid, 1139, 0.0, 0.0, 0.0);
        }
        case 10: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$20.000{FFFFFF} del robo.");
            DarDinero(playerid, 20000);
            DarArma(playerid, 43);
            PlayerPlaySound(playerid, 1139, 0.0, 0.0, 0.0);
        }
        case 11: {
            SendClientMessage(playerid, -1, "El {74F20C}dinero{FFFFFF} se te cayo y no te diste cuenta, no has logrado ganar nada del robo.");
        }
        case 12: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}3 Totems{FFFFFF} del robo.");
            PLAYER_INFO[playerid][Totems] += 3;
            PlayerPlaySound(playerid, 1139, 0.0, 0.0, 0.0);
        }
        case 13: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$10.000{FFFFFF} del robo.");
            DarDinero(playerid, 10000);
            PlayerPlaySound(playerid, 1139, 0.0, 0.0, 0.0);
        }
    }
    return 1;
}

