CMD:quitardinero(playerid, params[]) {
    new id, dinero, string[128];
    if (PLAYER_INFO[playerid][jAdminNvl] < ADMIN_LEVEL_ADM) return 0;
    if (!sscanf(params, "dd", id, dinero)) {
        QuitarDinero(id, dinero);
        new cadena[50];
        format(string, 128, "Un administrador te quito $%d.", dinero);
        SendClientMessage(id, COLOR_BLANCO, string);
        format(cadena, sizeof(cadena), "%s le quitaste %d$ a %s", NombreJugador(playerid), dinero, NombreJugador(id));
        SendClientMessage(playerid, -1, cadena);
    }
    return 1;
}
CMD:quitarmoneda(playerid, params[]) {
    new id, cantidad;
    if (PLAYER_INFO[playerid][jAdminNvl] < ADMIN_LEVEL_ADM) return SendClientMessage(playerid, -1, "No tienes permisos para utilizar este comando.");
    if (sscanf(params, "dd", id, cantidad)) return SendClientMessage(playerid, -1, "Uso correcto /quitar"SERVER_COIN " id cantidad"); {
        new string[128];
        format(string, sizeof(string), "Un Administrador te quito %d "    SERVER_COIN "", cantidad);
        SendClientMessage(id, COLOR_BLANCO, string);
        PLAYER_INFO[id][Moneda] -= cantidad;
    }
    new string[200];
    format(string, sizeof(string), "Le quitaste una cantidad de {00cc00}%d{FFFFFF} Monedas "SERVER_COIN " a %s.", cantidad, NombreJugador(id));
    ASendClientMessageEx(-1, string);
    return 1;
}
