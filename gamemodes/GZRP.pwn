                UpdateVehicleAttachedObject(TuneandoCoche[playerid], ObjetoSlot[playerid], true);
                SendClientMessage(playerid, -1, "Color de letra actualizado.");
            }
            return ShowTuning(playerid, DIALOG_VOBJECT_TEXT_MENU);
        }
