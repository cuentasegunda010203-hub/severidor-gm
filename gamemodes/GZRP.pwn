                {
                	strmid(PLAYER_INFO[playerid][pEstadoX], inputtext, 0, strlen(inputtext), 80);
                	new stringranking[250];
                	format(stringranking, sizeof(stringranking), "{F0525F}[%s] %s",Launcher(playerid), inputtext);
                	CreatePlayerLabel(playerid, stringranking, COLOR_GAMEMODE);
                	Notificador2(playerid, "~b~~h~~h~Estado activado");
                	PLAYER_INFO[playerid][EstadoON] = 1;
                	DetectarSPAM(playerid,inputtext);
