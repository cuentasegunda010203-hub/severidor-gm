                        format(item, sizeof(item), "%s\nRango 5: {ff3364}%s{FFFFFF}\n", item, BandasInfo[banda][BRango5]);
                        format(item, sizeof(item), "%s\nRango 6: {ff3364}%s{FFFFFF}\n", item, BandasInfo[banda][BRango6]);
                        format(item, sizeof(item), "%s\nRango 7: {ff3364}%s{FFFFFF}\n", item, BandasInfo[banda][BRango7]);
                        format(item, sizeof(item), "%s\nRango 8: {ff3364}%s{FFFFFF} (Líder)\n", item, BandasInfo[banda][BRango8]);
                        format(item, sizeof(item), "%s\nMejoras de la banda: {ff3364}%d{FFFFFF}\n", item, BandasInfo[banda][Mejoras]);
                        format(item, sizeof(item), "%s\nDiscord de la banda: {ff3364}%s{FFFFFF}\n", item, BandasInfo[banda][DiscordInv]);
                        format(item, sizeof(item), "%s\nRopa de hombres: {0066FF}SKINID: %d{FFFFFF}\n", item, BandasInfo[banda][Uniforme1]);
                        format(item, sizeof(item), "%s\nRopa de mujeres: {ff3364}SKINID: %d{FFFFFF}\n", item, BandasInfo[banda][Uniforme2]);
                        dialogs_ShowPlayerDialog(playerid, INVENTARIO, DIALOG_STYLE_MSGBOX, "Informacion sobre la banda", item, "Cerrar", "");

                    }
                    case 1: {
                        if (PLAYER_INFO[playerid][pFaccion] <= 3) return SendClientMessage(playerid, -1, "Las {"                    COLOR_GM "}Bandas civiles{FFFFFF} no pueden usar esta opcion.");

                        new affected_members, crew_territories;

                        mysql_format(handle_db, Query, sizeof(Query), "SELECT * FROM `usuarios` WHERE `Faccion`='%d';", PLAYER_INFO[playerid][pFaccion]);
                        mysql_query(handle_db, Query, true);
                        affected_members = cache_num_rows();

                        mysql_format(handle_db, Query, sizeof(Query), "SELECT * FROM `facciones` WHERE `id`='%d' AND `cuentaterris`;", PLAYER_INFO[playerid][pFaccion]);
