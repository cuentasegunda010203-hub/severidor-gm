        {
            SendClientMessage(i, color, string);
        }
    }
    return 1;
}
CMD:uniformesapd(playerid, params[]) {
    if (PLAYER_INFO[playerid][pFaccion] == 1 || PLAYER_INFO[playerid][pFaccion] == 2) {
        if (PLAYER_INFO[playerid][suspendido] == 0) {
            if (PlayerToPoint(2.0, playerid, 254.4149, 73.7001, 1003.6406) || PlayerToPoint(2.0, playerid, -242.6964, 2778.3052, 62.4265)) //254.0884,73.6973,1003.6406))//normal
            {
                if (PLAYER_INFO[playerid][pDuty] == 0) {

                    if (PLAYER_INFO[playerid][jSexo] == 1) {
                        Frecuencia[playerid] = 1;
                        frecuencias[1]++;
                        PLAYER_INFO[playerid][pDuty] = 1;
                        SendClientMessage(playerid, COLOR_MEGAPHONE, "Te pusiste el uniforme de policia.");
                        SetPlayerSkin(playerid, 310);
                        SetPlayerColor(playerid, COLOR_POLICIA);
                        PLAYER_INFO[playerid][pModelo] = GetPlayerSkin(playerid);
                        RopaMine[playerid] = 0, RopaMedi[playerid] = 0, RopaBasu[playerid] = 0, RopaMeca[playerid] = 0;
                    } else if (PLAYER_INFO[playerid][jSexo] == 2) {
                        Frecuencia[playerid] = 1;
                        frecuencias[1]++;
                        PLAYER_INFO[playerid][pDuty] = 1;
                        SendClientMessage(playerid, COLOR_MEGAPHONE, "Te pusiste el uniforme de policia.");
                        SetPlayerSkin(playerid, 309);
                        SetPlayerColor(playerid, COLOR_POLICIA);
                        PLAYER_INFO[playerid][pModelo] = GetPlayerSkin(playerid);
                        RopaMine[playerid] = 0, RopaMedi[playerid] = 0, RopaBasu[playerid] = 0, RopaMeca[playerid] = 0;
                    }
                } else {
                    //	if(PlayerToPoint(2.0, playerid, 254.4149,73.7001,1003.6406))//254.0884,73.6973,1003.6406)) //|| PlayerToPoint(2.0, playerid, 258.5233,76.5009,1003.6406) || PlayerToPoint(2.0, playerid, 253.2736,77.8771,1003.6406))//normal
                    SetPlayerColor(playerid, COLOR_WHITE);
                    frecuencias[Frecuencia[playerid]]--;
                    Frecuencia[playerid] = 0;
                    SendClientMessage(playerid, -1, "Dejaste el uniforme de policia y recuperaste tu ropa.");
                    SetPlayerSkin(playerid, PLAYER_INFO[playerid][jRopa]);
                    RemovePlayerAttachedObject(playerid, 4);
                    RemovePlayerAttachedObject(playerid, 5);
                    PLAYER_INFO[playerid][pDuty] = 0;
                    if (PLAYER_INFO[playerid][j_ARMAS][1] == 3) QuitarArma(playerid, 3);
                    ResetPlayerWeapons(playerid);
                    RopaMine[playerid] = 0, RopaMedi[playerid] = 0, RopaBasu[playerid] = 0, RopaMeca[playerid] = 0;
                    DarArmas(playerid);
                }
            }
        } else SendClientMessage(playerid, COLORCARGO0, "No puedes usar tu uniforme de policia mientras te encuentres suspendido.");
    }
    return 1;
}
CMD:limpiarchat(playerid, params[]) {
    if (PLAYER_INFO[playerid][jAdminNvl] < 5) return 0;
    for(new i = 0; i < 150; i++) {
        SendClientMessageToAll(-1, "");
    }
    new string[70];
    format(string, 70, "El log del chat fue borrado por {366397}%s", NombreJugador(playerid));
    MensajeAdmin(COLOR_GREY, string, 2);

    return 1;
}

COMMAND:callsign(playerid, params[]) {
    new patrulla;
    patrulla = GetPlayerVehicleID(playerid);
    if (PLAYER_INFO[playerid][pDuty] != 1) return SendClientMessage(playerid, COLOR_WHITE, "No estas en servicio policial.");
    if (!SAPD(patrulla) && !HELISAPD(patrulla)) return SendClientMessage(playerid, -1, "Necesitas estar conduciendo una patrulla para hacer esto.");
    if (IsPlayerInAnyVehicle(playerid)) {
        if (isnull(params)) return SendClientMessage(playerid, COLOR_ORANGE, "INFO: {FFFFFF}/callsign [text]");
        if (!veicolo_callsign_status[patrulla]) {
            new string[128];
            format(string, sizeof(string), "%s", params);
            veicolo_callsign_testo[patrulla] = Create3DTextLabel(string, 0xFFFFFFFF, 0.0, 0.0, 0.0, 50.0, 0, 1);
            Attach3DTextLabelToVehicle(veicolo_callsign_testo[patrulla], patrulla, -0.7, -1.9, -0.3);
            veicolo_callsign_status[patrulla] = 1;
        } else {
            Delete3DTextLabel(veicolo_callsign_testo[patrulla]);
            veicolo_callsign_status[patrulla] = 0;
            return 1;
        }
    } else {
        SendClientMessage(playerid, COLOR_ORANGE, "ERROR: {FFFFFF}no estas en una patrulla.");
        return 1;
    }
    return 1;
}
COMMAND:dcallsign(playerid, params[]) {

    new patrulla;
    patrulla = GetPlayerVehicleID(playerid);
    if (PLAYER_INFO[playerid][pDuty] != 1) return SendClientMessage(playerid, COLOR_WHITE, "No estas en servicio policial.");
    if (!SAPD(patrulla) && !HELISAPD(patrulla)) return SendClientMessage(playerid, -1, "Necesitas estar conduciendo una patrulla para hacer esto.");
    if (IsPlayerInAnyVehicle(playerid)) {
        Delete3DTextLabel(veicolo_callsign_testo[patrulla]);
        veicolo_callsign_status[patrulla] = 0;
    } else {
        SendClientMessage(playerid, COLOR_ORANGE, "ERROR: {FFFFFF}no estas en una patrulla");
    }
    return 1;
}
CMD:transmitir(playerid) {
    new stringa[264];
    if (IsPlayerInDynamicArea(playerid, AREA_DISCOTEC[1])) {
        if (DISCOTEC_INFO[d_DJ] == -1) {
            DISCOTEC_INFO[d_USED] = true;
            DISCOTEC_INFO[d_DJ] = playerid;
            format(DISCOTEC_INFO[d_URL], sizeof(DISCOTEC_INFO[d_URL]), "http://"EMISORA_URL "/stream/%d/", 139123 + PLAYER_INFO[playerid][pID]);
            foreach(new i : Player) {
                if (IsPlayerInDynamicArea(i, AREA_DISCOTEC[0])) {
                    PLAYER_TEMP[i][p_IN_DISCOTEC] = true;
                    PlayAudioStreamForPlayerEx(i, DISCOTEC_INFO[d_URL]);
                }
            }
            return 1;
        } else return SendClientMessage(playerid, -1, "Ya se encuetra un DJ en la cabina.");
    }
    if (IsPlayerInDynamicArea(playerid, AreaCabinas[1])) {
        if (Emisoras[playerid][TieneEmisora] == 0) return SendClientMessage(playerid, COLOR_BLANCO, "No tienes una emisora, ve y consigue una en la entrada.");
        if (Emisoras[playerid][TransEmisora] == 1) return SendClientMessage(playerid, COLOR_BLANCO, "Ya estas transmitiendo en otra cabina de radio.");
        if (CabinasOcupadasEmisoras[1][0] == 0) {
            CabinasOcupadasEmisoras[1][0] = 1;
            CabinasOcupadasEmisoras[1][1] = playerid;
            Emisoras[playerid][TransEmisora] = 1;
            Emisoras[playerid][CabinaOcupada] = 1;
            //Emisoras[playerid][EmisoraID] = PLAYER_INFO[playerid][pID] + 31;
            Emisoras[playerid][EmisoraID] = PLAYER_INFO[playerid][pID] + 1451;
            format(stringa, sizeof(stringa), "{FFFFFF}Ocupado por {DBED15}%s", Emisoras[playerid][NombreEmisora]);
            UpdateDynamic3DTextLabelText(CabinasTextos[1], 0xFFFFFFFF, stringa);
            format(Emisoras[playerid][URLEmisora], 128, "http://"WEB_RADIO ":8000/listen.pls?sid=%d", Emisoras[playerid][EmisoraID]);
            format(stringa, sizeof(stringa), "Ya puedes comenzar a transmitir por Stream ID: {DBED15}%d", Emisoras[playerid][EmisoraID]);
            SendClientMessage(playerid, COLOR_BLANCO, stringa);
            for(new id = 0; id < MAX_PLAYERS; id++) {
                if (IsPlayerInDynamicArea(id, AreaCabinas[1])) {
                    format(stringa, sizeof(stringa), "Emisora: 1 {DBED15}- %s", Emisoras[playerid][NombreEmisora]);
                    SendClientMessage(id, COLOR_BLANCO, stringa);
                    format(stringa, sizeof(stringa), "http://"        WEB_RADIO ":8000/listen.pls?sid=%d", Emisoras[playerid][EmisoraID]);
                    PlayAudioStreamForPlayer(id, stringa);
                    CabinasOcupadasEmisoras[1][2]++;
                }
            }
        } else return SendClientMessage(playerid, COLOR_BLANCO, "Ya hay alguien transmitiendo en esta cabina de radio.");
    } else if (IsPlayerInDynamicArea(playerid, AreaCabinas[2])) {
        if (Emisoras[playerid][TieneEmisora] == 0) return SendClientMessage(playerid, COLOR_BLANCO, "No tienes una emisora, ve y consigue una en la entrada.");
        if (Emisoras[playerid][TransEmisora] == 1) return SendClientMessage(playerid, COLOR_BLANCO, "Ya estas transmitiendo en otra cabina de radio.");
        if (CabinasOcupadasEmisoras[2][0] == 0) {
            CabinasOcupadasEmisoras[2][0] = 1;
            CabinasOcupadasEmisoras[2][1] = playerid;
            Emisoras[playerid][TransEmisora] = 1;
            Emisoras[playerid][CabinaOcupada] = 2;
            //Emisoras[playerid][EmisoraID] = PLAYER_INFO[playerid][pID] + 31;
            Emisoras[playerid][EmisoraID] = PLAYER_INFO[playerid][pID] + 1452;
            format(stringa, sizeof(stringa), "{FFFFFF}Ocupado por {DBED15}%s", Emisoras[playerid][NombreEmisora]);
            UpdateDynamic3DTextLabelText(CabinasTextos[2], 0xFFFFFFFF, stringa);
            format(Emisoras[playerid][URLEmisora], 128, "http://"WEB_RADIO ":8000/listen.pls?sid=%d", Emisoras[playerid][EmisoraID]);
            format(stringa, sizeof(stringa), "Ya puedes comenzar a transmitir por Stream ID: {DBED15}%d", Emisoras[playerid][EmisoraID]);
            SendClientMessage(playerid, COLOR_BLANCO, stringa);
            for(new id = 0; id < MAX_PLAYERS; id++) {
                if (IsPlayerInDynamicArea(id, AreaCabinas[2])) {
                    format(stringa, sizeof(stringa), "Emisora: 2 {DBED15}- %s", Emisoras[playerid][NombreEmisora]);
                    SendClientMessage(id, COLOR_BLANCO, stringa);
                    format(stringa, sizeof(stringa), "http://"        WEB_RADIO ":8000/listen.pls?sid=%d", Emisoras[playerid][EmisoraID]);
                    PlayAudioStreamForPlayer(id, stringa);
                    CabinasOcupadasEmisoras[2][2]++;
                }
            }
        } else return SendClientMessage(playerid, COLOR_BLANCO, "Ya hay alguien transmitiendo en esta cabina de radio.");
    } else if (IsPlayerInDynamicArea(playerid, AreaCabinas[3])) {
        if (Emisoras[playerid][TieneEmisora] == 0) return SendClientMessage(playerid, COLOR_BLANCO, "No tienes una emisora, ve y consigue una en la entrada.");
        if (Emisoras[playerid][TransEmisora] == 1) return SendClientMessage(playerid, COLOR_BLANCO, "Ya estas transmitiendo en otra cabina de radio.");
        if (CabinasOcupadasEmisoras[3][0] == 0) {
            CabinasOcupadasEmisoras[3][0] = 1;
            CabinasOcupadasEmisoras[3][1] = playerid;
            Emisoras[playerid][TransEmisora] = 1;
            Emisoras[playerid][CabinaOcupada] = 3;
            //Emisoras[playerid][EmisoraID] = PLAYER_INFO[playerid][pID] + 31;
            Emisoras[playerid][EmisoraID] = PLAYER_INFO[playerid][pID] + 1453;
            format(stringa, sizeof(stringa), "{FFFFFF}Ocupado por {DBED15}%s", Emisoras[playerid][NombreEmisora]);
            UpdateDynamic3DTextLabelText(CabinasTextos[3], 0xFFFFFFFF, stringa);
            format(Emisoras[playerid][URLEmisora], 128, "http://"WEB_RADIO ":8000/listen.pls?sid=%d", Emisoras[playerid][EmisoraID]);
            format(stringa, sizeof(stringa), "Ya puedes comenzar a transmitir por Stream ID: {DBED15}%d", Emisoras[playerid][EmisoraID]);
            SendClientMessage(playerid, COLOR_BLANCO, stringa);
            for(new id = 0; id < MAX_PLAYERS; id++) {
                if (IsPlayerInDynamicArea(id, AreaCabinas[3])) {
                    format(stringa, sizeof(stringa), "Emisora: 3 {DBED15}- %s", Emisoras[playerid][NombreEmisora]);
                    SendClientMessage(id, COLOR_BLANCO, stringa);
                    format(stringa, sizeof(stringa), "http://"        WEB_RADIO ":8000/listen.pls?sid=%d", Emisoras[playerid][EmisoraID]);
                    PlayAudioStreamForPlayer(id, stringa);
                    CabinasOcupadasEmisoras[3][2]++;
                }
            }
        } else return SendClientMessage(playerid, COLOR_BLANCO, "Ya hay alguien transmitiendo en esta cabina de radio.");
    } else if (IsPlayerInDynamicArea(playerid, AreaCabinas[4])) {
        if (Emisoras[playerid][TieneEmisora] == 0) return SendClientMessage(playerid, COLOR_BLANCO, "No tienes una emisora, ve y consigue una en la entrada.");
        if (Emisoras[playerid][TransEmisora] == 1) return SendClientMessage(playerid, COLOR_BLANCO, "Ya estas transmitiendo en otra cabina de radio.");
        if (CabinasOcupadasEmisoras[4][0] == 0) {
            CabinasOcupadasEmisoras[4][0] = 1;
            CabinasOcupadasEmisoras[4][1] = playerid;
            Emisoras[playerid][TransEmisora] = 1;
            Emisoras[playerid][CabinaOcupada] = 4;
            //Emisoras[playerid][EmisoraID] = PLAYER_INFO[playerid][pID] + 31;
            Emisoras[playerid][EmisoraID] = PLAYER_INFO[playerid][pID] + 1454;
            format(stringa, sizeof(stringa), "{FFFFFF}Ocupado por {DBED15}%s", Emisoras[playerid][NombreEmisora]);
            UpdateDynamic3DTextLabelText(CabinasTextos[4], 0xFFFFFFFF, stringa);
            format(Emisoras[playerid][URLEmisora], 128, "http://"WEB_RADIO ":8000/listen.pls?sid=%d", Emisoras[playerid][EmisoraID]);
            format(stringa, sizeof(stringa), "Ya puedes comenzar a transmitir por Stream ID: {DBED15}%d", Emisoras[playerid][EmisoraID]);
            SendClientMessage(playerid, COLOR_BLANCO, stringa);
            for(new id = 0; id < MAX_PLAYERS; id++) {
                if (IsPlayerInDynamicArea(id, AreaCabinas[4])) {
                    format(stringa, sizeof(stringa), "Emisora: 4 {DBED15}- %s", Emisoras[playerid][NombreEmisora]);
                    SendClientMessage(id, COLOR_BLANCO, stringa);
                    format(stringa, sizeof(stringa), "http://"        WEB_RADIO ":8000/listen.pls?sid=%d", Emisoras[playerid][EmisoraID]);
                    PlayAudioStreamForPlayer(id, stringa);
                    CabinasOcupadasEmisoras[4][2]++;
                }
            }
        } else return SendClientMessage(playerid, COLOR_BLANCO, "Ya hay alguien transmitiendo en esta cabina de radio.");
    } else return SendClientMessage(playerid, COLOR_BLANCO, "No estas en ninguna cabina de radio.");
    return 1;
}
CMD:envivo(playerid) {
    if (EnvivoAutorizado == 0) return SendClientMessage(playerid, -1, "El jefe de APSA no ha autorizado un envivo.");
    if (PLAYER_INFO[playerid][EnApsa] == 0) return SendClientMessage(playerid, -1, "No perteneces a APSA.");
    if (Envivo == 0) {
        dialogs_ShowPlayerDialog(playerid, DIALOG_ENVIVO, DIALOG_STYLE_INPUT, "APSA | Transmisiones", "A continuacion, usa el siguiente campo para ingresar el contenido de tu envivo", "Siguiente", "Cancelar");
    } else TerminarEnvivo();
    return 1;
}
CMD:opciones(playerid) {
    OpcionesAPSA(playerid);
    return 1;
}
CMD:probarapsa(playerid) {
    PLAYER_INFO[playerid][EnApsa] = 1;
    PLAYER_INFO[playerid][LiderApsa] = 1;
    ShowPlayerMessage(playerid, "Ahora eres de APSA");
    return 1;
}
CMD:terminar(playerid) {
    NoverApsa(playerid);
    return 1;
}
CMD:r(playerid, params[]) {
    new mensaje[128], string[128];
    if (sscanf(params, "s[128]", mensaje)) return SendClientMessage(playerid, COLOR_BLANCO, "Por favor usa {DBED15}/r texto");
    if (IsPlayerInDynamicArea(playerid, AreaCabinas[1])) {
        if (CabinasOcupadasEmisoras[1][1] == playerid) {
            format(string, sizeof(string), "%s por microfono: %s", NombreJugador(playerid), mensaje);
            ProxDetector(15.0, playerid, string, COLOR_GRAD6, COLOR_GRAD5, COLOR_GRAD4, COLOR_GRAD3, COLOR_GRAD2);
            MandarMensajeLocutor(playerid, 1, mensaje);
        } else if (TieneMicrofono[playerid] == 1) {
            format(string, sizeof(string), "%s por microfono: %s", NombreJugador(playerid), mensaje);
            ProxDetector(15.0, playerid, string, COLOR_GRAD6, COLOR_GRAD5, COLOR_GRAD4, COLOR_GRAD3, COLOR_GRAD2);
            MandarMensajeInvitado(playerid, 1, mensaje);
        } else return SendClientMessage(playerid, COLOR_BLANCO, "No tienes un microfono para poder hablar por la radio.");
    } else if (IsPlayerInDynamicArea(playerid, AreaCabinas[2])) {
        if (CabinasOcupadasEmisoras[2][1] == playerid) {
            format(string, sizeof(string), "%s por microfono: %s", NombreJugador(playerid), mensaje);
            ProxDetector(15.0, playerid, string, COLOR_GRAD6, COLOR_GRAD5, COLOR_GRAD4, COLOR_GRAD3, COLOR_GRAD2);
            MandarMensajeLocutor(playerid, 2, mensaje);
        } else if (TieneMicrofono[playerid] == 2) {
            format(string, sizeof(string), "%s por microfono: %s", NombreJugador(playerid), mensaje);
            ProxDetector(15.0, playerid, string, COLOR_GRAD6, COLOR_GRAD5, COLOR_GRAD4, COLOR_GRAD3, COLOR_GRAD2);
            MandarMensajeInvitado(playerid, 2, mensaje);
        } else return SendClientMessage(playerid, COLOR_BLANCO, "No tienes un microfono para poder hablar por la radio.");
    } else if (IsPlayerInDynamicArea(playerid, AreaCabinas[3])) {
        if (CabinasOcupadasEmisoras[3][1] == playerid) {
            format(string, sizeof(string), "%s por microfono: %s", NombreJugador(playerid), mensaje);
            ProxDetector(15.0, playerid, string, COLOR_GRAD6, COLOR_GRAD5, COLOR_GRAD4, COLOR_GRAD3, COLOR_GRAD2);
            MandarMensajeLocutor(playerid, 3, mensaje);
        } else if (TieneMicrofono[playerid] == 3) {
            format(string, sizeof(string), "%s por microfono: %s", NombreJugador(playerid), mensaje);
            ProxDetector(15.0, playerid, string, COLOR_GRAD6, COLOR_GRAD5, COLOR_GRAD4, COLOR_GRAD3, COLOR_GRAD2);
            MandarMensajeInvitado(playerid, 3, mensaje);
        } else return SendClientMessage(playerid, COLOR_BLANCO, "No tienes un microfono para poder hablar por la radio.");
    } else if (IsPlayerInDynamicArea(playerid, AreaCabinas[4])) {
        if (CabinasOcupadasEmisoras[4][1] == playerid) {
            format(string, sizeof(string), "%s por microfono: %s", NombreJugador(playerid), mensaje);
            ProxDetector(15.0, playerid, string, COLOR_GRAD6, COLOR_GRAD5, COLOR_GRAD4, COLOR_GRAD3, COLOR_GRAD2);
            MandarMensajeLocutor(playerid, 4, mensaje);
        } else if (TieneMicrofono[playerid] == 4) {
            format(string, sizeof(string), "%s por microfono: %s", NombreJugador(playerid), mensaje);
            ProxDetector(15.0, playerid, string, COLOR_GRAD6, COLOR_GRAD5, COLOR_GRAD4, COLOR_GRAD3, COLOR_GRAD2);
            MandarMensajeInvitado(playerid, 4, mensaje);
        } else return SendClientMessage(playerid, COLOR_BLANCO, "No tienes un microfono para poder hablar por la radio.");
    } else {
        new item[32], Float:loc[3];
        if (!sscanf(params, "s[32]", item)) {
            if (strcmp(item, "medico", true) == 0) {
                if (PLAYER_INFO[playerid][pTrabajo] == T_Medico || PLAYER_INFO[playerid][pTrabajo2] == T_Medico) {
                    if (ResponderMedi[playerid] == 1) {
                        if (RopaMedi[playerid] == 1) {
                            foreach(new i : Player) {
                                if (LlamadaMedicos[i] == 1) {
                                    Notificador2(i, "Un Medico respondio a tu llamado y va en camino.");
                                    GetPlayerPos(i, loc[0], loc[1], loc[2]);
                                    if (GetPlayerInterior(i) != 0) {
                                        new Float:X, Float:Y, Float:Z;
                                        SendClientMessage(playerid, -1, "El paciente que solicito Medico se encuentra en un interior, se marco la entrada de la puerta en tu {"                                    COLOR_GM "}GPS");
                                        for(new p = 0; p < MAX_PROPIEDADES; p++) {
                                            if (GetPlayerVirtualWorld(i) == PropInfo[p][pVW]) {
                                                X = PropInfo[p][pPosX];
                                                Y = PropInfo[p][pPosY];
                                                Z = PropInfo[p][pPosZ];
                                            }
                                        }
                                        SetPlayerMapIcon(playerid, i, X, Y, Z, 0, HexToInt("00CC00FF"), MAPICON_GLOBAL);
                                    }
                                    StartPlayerPath(playerid, loc[0], loc[1], loc[2], 3.0);
                                    SendClientMessage(playerid, -1, "{"                                COLOR_GM "}Le acabas de avisar al paciente que vas a buscarlo.");
                                    SendClientMessage(playerid, -1, "{"                                COLOR_GM "}Hemos marcado la última ubicación del paciente.");
                                    ShowPlayerMessage(playerid, "~w~Una vez cerca del paciente usa ~b~/reanimar~w~.", 40000);
                                    ResponderMedi[playerid] = 0;
                                    break;
                                }
                            }
                        }
                    } else return SendClientMessage(playerid, -1, "Ya fueron atendidos todos los llamados.");
                }
            }
            if (strcmp(item, "taxi", true) == 0) {
                if (PLAYER_INFO[playerid][pTrabajo] != T_Taxista && PLAYER_INFO[playerid][pTrabajo2] != T_Taxista) return 1;
                if (ResponderTaxi[playerid] == 1) {
                    foreach(new i : Player) {
                        if (LlamadaTaxi[i] == 1) {
                            Notificador2(i, "Un taxista respondio a tu llamado y va en camino.");
                        }
                    }
                    SendClientMessage(playerid, -1, "{00CC00}Acabas de avisarle al cliente que vas a buscarlo.");
                    ResponderTaxi[playerid] = 0;
                } else return SendClientMessage(playerid, -1, "Ya fueron atendidos todos los llamados.");
            }
            if (strcmp(item, "mecanico", true) == 0) {
                if (PLAYER_INFO[playerid][pTrabajo] != T_Mecanico && PLAYER_INFO[playerid][pTrabajo2] != T_Mecanico) return 1;
                if (ResponderMeca[playerid] == 1) {
                    foreach(new i : Player) {
                        if (LlamadaMeca[i] == 1) {
                            Notificador2(i, "Un mecanico respondio a tu llamado y va en camino.");
                        }
                    }
                    SendClientMessage(playerid, -1, "{00CC00}Acabas de avisarle al cliente que vas a reparar su vehiculo.");
                    ResponderMeca[playerid] = 0;
                } else return SendClientMessage(playerid, -1, "Ya fueron atendidos todos los llamados.");
            }
        }
    }
    return 1;
}
MandarMensajeInvitado(playerid, radio, mensaje[]) {
    Ciclo(i, MAX_CONECTADOS) {
        if ((EmisoraEscuchando[GetPlayerVehicleID(i)] == radio || IsPlayerInDynamicArea(i, AreaCabinas[radio])) && i != playerid) {
            if (PLAYER_INFO[i][jAdminNvl] < 2) {
                new string[256], locutor;
                locutor = CabinasOcupadasEmisoras[radio][1];
                format(string, sizeof(string), "[Invitado en radio %s]: %s", Emisoras[locutor][NombreEmisora], mensaje);
                SendClientMessage(i, 0xFFD46EFF, string);
            } else if (PLAYER_INFO[i][jAdminNvl] >= 2) {
                new string[256];
                format(string, sizeof(string), "[Emis. Invitado %s (%d)]: %s", NombreJugador(playerid), playerid, mensaje);
                SendClientMessage(i, 0xFFD46EFF, string);
            }
        }
    }
    return 1;
}
MandarMensajeLocutor(playerid, radio, mensaje[]) {
    Ciclo(i, MAX_CONECTADOS) {
        if ((EmisoraEscuchando[GetPlayerVehicleID(i)] == radio || IsPlayerInDynamicArea(i, AreaCabinas[radio])) && i != playerid) {
            if (PLAYER_INFO[i][jAdminNvl] < 2) {
                new string[256], locutor;
                locutor = CabinasOcupadasEmisoras[radio][1];
                format(string, sizeof(string), "[Locutor de radio %s]: %s", Emisoras[locutor][NombreEmisora], mensaje);
                SendClientMessage(i, 0xFFD46EFF, string);
            } else if (PLAYER_INFO[i][jAdminNvl] >= 2) {
                new string[256];
                format(string, sizeof(string), "[Emis. loc. %s (%d)]: %s", NombreJugador(playerid), playerid, mensaje);
                SendClientMessage(i, 0xFFD46EFF, string);
            }
        }
    }
    return 1;
}
CMD:transmision(playerid) {
    if (Emisoras[playerid][TieneEmisora] == 0) return SendClientMessage(playerid, COLOR_BLANCO, "No tienes una emisora, ve y consigue una en la entrada.");
    if (Emisoras[playerid][TransEmisora] == 0) return SendClientMessage(playerid, COLOR_BLANCO, "No estas transmitiendo en ninguna cabina de radio.");
    new string[128];
    format(string, sizeof(string), "http://"WEB_RADIO ":8000/listen.pls?sid=%d", Emisoras[playerid][EmisoraID]);
    PlayAudioStreamForPlayer(playerid, string);
    return 1;
}
CMD:oyentes(playerid) {
    if (Emisoras[playerid][TieneEmisora] == 0) return SendClientMessage(playerid, COLOR_WHITE, "No tienes una emisora, ve y consigue una en la entrada.");
    if (Emisoras[playerid][TransEmisora] == 0) return SendClientMessage(playerid, COLOR_WHITE, "No estas transmitiendo en ninguna cabina de radio.");
    new emisoraid, string[128];
    emisoraid = Emisoras[playerid][CabinaOcupada];
    format(string, sizeof(string), "Tienes un total de {00CC00}%d{FFFFFF} oyentes.", GetOyentesEmisora(emisoraid));
    SendClientMessage(playerid, COLOR_WHITE, string);
    return 1;
}
CMD:consola(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] >= 4) {
        new string[128], ac_cmd_true[100], ac_func_true[100];
        if (VerComandos[playerid] == 1) format(ac_cmd_true, sizeof(ac_cmd_true), "{00FF00}Activado");
        else format(ac_cmd_true, sizeof(ac_cmd_true), "{FFFF00}Desactivado");

        if (VerAnticheat[playerid] == 1) format(ac_func_true, sizeof(ac_func_true), "{00FF00}Activado");
        else format(ac_func_true, sizeof(ac_func_true), "{FFFF00}Desactivado");
        format(string, sizeof(string), "Ver Funciones - Estado: %s\nVer Comandos - Estado: %s", ac_func_true, ac_cmd_true);
        dialogs_ShowPlayerDialog(playerid, DIALOG_CONSOLA, DIALOG_STYLE_LIST, "AntiCheat by Williangel_Vera", string, "Aceptar", "Cancelar");
    }
    return 1;
}

CerrarEmisora(cabinaid) {
    if (cabinaid == 1) {
        CabinasOcupadasEmisoras[1][0] = 0;
        CabinasOcupadasEmisoras[1][0] = 0;
        CabinasOcupadasEmisoras[1][0] = 0;
        CabinasOcupadasEmisoras[1][1] = -1;
        CabinasOcupadasEmisoras[1][2] = 0;
        UpdateDynamic3DTextLabelText(CabinasTextos[1], 0xFFFFFFFF, "{FFFFFF}Radio disponible {C0C0C0}[N1]");
        for(new id = 0; id < MAX_PLAYERS; id++) {
            if (Emisoras[id][CabinaOcupada] == 1 && Emisoras[id][TransEmisora] == 1) {
                Emisoras[id][TransEmisora] = 0;
                Emisoras[id][CabinaOcupada] = 0;
            }
            if (TieneMicrofono[id] == 1) {
                TieneMicrofono[id] = 0;
            }
            if (IsPlayerInDynamicArea(id, AreaCabinas[1])) {
                SendClientMessage(id, COLOR_BLANCO, "La emisora que estabas escuchando dejo de transmitir.");
                StopAudioStreamForPlayer(id);
            }
            if (IsPlayerInAnyVehicle(id) && EmisoraEscuchando[GetPlayerVehicleID(id)] == 1) {
                SendClientMessage(id, COLOR_BLANCO, "La emisora que estabas escuchando dejo de transmitir.");
                StopAudioStreamForPlayer(id);
            }
        }
    }
    if (cabinaid == 2) {
        CabinasOcupadasEmisoras[2][0] = 0;
        CabinasOcupadasEmisoras[2][1] = -1;
        CabinasOcupadasEmisoras[2][2] = 0;
        UpdateDynamic3DTextLabelText(CabinasTextos[2], 0xFFFFFFFF, "{FFFFFF}Radio disponible {C0C0C0}[N2]");
        for(new id = 0; id < MAX_PLAYERS; id++) {
            if (Emisoras[id][CabinaOcupada] == 2 && Emisoras[id][TransEmisora] == 1) {
                Emisoras[id][TransEmisora] = 0;
                Emisoras[id][CabinaOcupada] = 0;
            }
            if (TieneMicrofono[id] == 2) {
                TieneMicrofono[id] = 0;
            }
            if (IsPlayerInDynamicArea(id, AreaCabinas[2])) {
                SendClientMessage(id, COLOR_BLANCO, "La emisora que estabas escuchando dejo de transmitir.");
                StopAudioStreamForPlayer(id);
            }
            if (IsPlayerInAnyVehicle(id) && EmisoraEscuchando[GetPlayerVehicleID(id)] == 2) {
                SendClientMessage(id, COLOR_BLANCO, "La emisora que estabas escuchando dejo de transmitir.");
                StopAudioStreamForPlayer(id);
            }
        }
    }
    if (cabinaid == 3) {
        CabinasOcupadasEmisoras[3][0] = 0;
        CabinasOcupadasEmisoras[3][1] = -1;
        CabinasOcupadasEmisoras[3][2] = 0;
        UpdateDynamic3DTextLabelText(CabinasTextos[3], 0xFFFFFFFF, "{FFFFFF}Radio disponible {C0C0C0}[N3]");
        for(new id = 0; id < MAX_PLAYERS; id++) {
            if (Emisoras[id][CabinaOcupada] == 3 && Emisoras[id][TransEmisora] == 1) {
                Emisoras[id][TransEmisora] = 0;
                Emisoras[id][CabinaOcupada] = 0;
            }
            if (TieneMicrofono[id] == 3) {
                TieneMicrofono[id] = 0;
            }
            if (IsPlayerInDynamicArea(id, AreaCabinas[3])) {
                SendClientMessage(id, COLOR_BLANCO, "La emisora que estabas escuchando dejo de transmitir.");
                StopAudioStreamForPlayer(id);
            }
            if (IsPlayerInAnyVehicle(id) && EmisoraEscuchando[GetPlayerVehicleID(id)] == 3) {
                SendClientMessage(id, COLOR_BLANCO, "La emisora que estabas escuchando dejo de transmitir.");
                StopAudioStreamForPlayer(id);
            }
        }
    }
    if (cabinaid == 4) {
        CabinasOcupadasEmisoras[4][0] = 0;
        CabinasOcupadasEmisoras[4][1] = -1;
        CabinasOcupadasEmisoras[4][2] = 0;
        UpdateDynamic3DTextLabelText(CabinasTextos[4], 0xFFFFFFFF, "{FFFFFF}Radio disponible {C0C0C0}[N4]");
        for(new id = 0; id < MAX_PLAYERS; id++) {
            if (Emisoras[id][CabinaOcupada] == 4 && Emisoras[id][TransEmisora] == 1) {
                Emisoras[id][TransEmisora] = 0;
                Emisoras[id][CabinaOcupada] = 0;
            }
            if (TieneMicrofono[id] == 4) {
                TieneMicrofono[id] = 0;
            }
            if (IsPlayerInDynamicArea(id, AreaCabinas[4])) {
                SendClientMessage(id, COLOR_BLANCO, "La emisora que estabas escuchando dejo de transmitir.");
                StopAudioStreamForPlayer(id);
            }
            if (IsPlayerInAnyVehicle(id) && EmisoraEscuchando[GetPlayerVehicleID(id)] == 4) {
                SendClientMessage(id, COLOR_BLANCO, "La emisora que estabas escuchando dejo de transmitir.");
                StopAudioStreamForPlayer(id);
            }
        }
    }
    return 1;
}

CMD:anuncio(playerid, params[]) {
    if (PLAYER_TIMES[playerid][TiempoAD] > 0) {
        if (PLAYER_TIMES[playerid][TiempoAD] < 60) SendClientMessageEx(playerid, -1, "No se te permite hablar por el canal de anuncios. Espera {00CC00}%ds{FFFFFF} para enviar otro anuncio.", PLAYER_TIMES[playerid][TiempoAD]);
        else if (PLAYER_TIMES[playerid][TiempoAD] >= 60) SendClientMessageEx(playerid, -1, "No se te permite hablar por el canal de anuncios. Espera {00CC00}%dm %ds{FFFFFF} para enviar otro anuncio.", PLAYER_TIMES[playerid][TiempoAD] / 60, PLAYER_TIMES[playerid][TiempoAD] % (60));
        return 1;
    }
    new message[145];
    if (!sscanf(params, "s[145]", message)) {
        if (PLAYER_INFO[playerid][pNumero] == 0) {
            SendClientMessage(playerid, -1, "Necesitas comprar un telefono movil para enviar mensajes de texto.");
            SendClientMessage(playerid, -1, "Puedes comprar un Telefono en cualquier {DBED15}24/7");
            return 1;
        }
        if (PLAYER_TEMP[playerid][AnuncioTipo2] != INVALID_PLAYER_ID && AnuncioTipo[playerid] != INVALID_PLAYER_ID) {
            new anuncio[200], anuncio2[300];
            if (PLAYER_TEMP[playerid][AnuncioTipo2] == 1) {
                switch (AnuncioTipo[playerid]) {
                    case 1 : format(anuncio, sizeof(anuncio), "~y~>~h~~h~Compra:~w~ %s ~b~", message);
                    case 2 : format(anuncio, sizeof(anuncio), "~g~>~h~~h~Venta:~w~ %s ", message);
                    case 3 : format(anuncio, sizeof(anuncio), "~r~>~h~~h~Anuncio:~w~ %s ", message);
                }
            } else {
                switch (AnuncioTipo[playerid]) {
                    case 1 : format(anuncio2, sizeof(anuncio2), ">Compra:{FFFFFF} %s {006600}[#%d]", message, PLAYER_INFO[playerid][pNumero]);
                    case 2 : format(anuncio2, sizeof(anuncio2), ">Venta:{FFFFFF} %s {006600}[#%d]", message, PLAYER_INFO[playerid][pNumero]);
                    case 3 : format(anuncio2, sizeof(anuncio2), ">Anuncio:{FFFFFF} %s {006600}[#%d]", message, PLAYER_INFO[playerid][pNumero]);
                }
            }
            if (PLAYER_INFO[playerid][jDinero] < strlen(AnuncioTexto[playerid]) * 100) return SendClientMessage(playerid, -1, "No tienes dinero suficiente...");

            switch (PLAYER_TEMP[playerid][AnuncioTipo2]) {
                case 1:
                    SetTextDrawAnuncioText(PLAYER_INFO[playerid][pNumero], anuncio);
                    default: SetTextDrawAnuncioText(PLAYER_INFO[playerid][pNumero], anuncio2, 1);
            }
            Webhook_Canales(playerid, message, 1, AnuncioTipo[playerid]);
            new str_anuncio[128];
            format(str_anuncio, sizeof(str_anuncio), "Anuncio enviado por: {366397}%s [ID: %d # %d]", PLAYER_INFO[playerid][Nickname], playerid, PLAYER_INFO[playerid][pNumero]); // :v
            MensajeAAdministradores(-1, str_anuncio);
            SendClientMessageEx(playerid, -1, "Enviaste un anuncio por {00CC00}%d$.", strlen(AnuncioTexto[playerid]) * 100);
            QuitarDinero(playerid, strlen(AnuncioTexto[playerid]) * 100);
            PLAYER_TIMES[playerid][TiempoAD] = 150;
        } else return SendClientMessage(playerid, -1, "No estas registrado en nuestro sistema de anuncios, usa {c6d368}/llamar 715");
    } else SendClientMessage(playerid, -1, "Uso correcto {c6d368}/ad [texto]");
    return 1;
}
CMD:admins(playerid) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM) return 0;
    mysql_tquery(handle_db, "SELECT * FROM `usuarios` WHERE `Admin` > 0;", "LoadAdmins", "i", playerid);
    return 1;
}
RangoAdministrativo(level) {
    new adnm[65];
    switch (level) {
        case 1 : adnm = "Helper";
        case 2 : adnm = "Moderador Dudas";
        case 3 : adnm = "Moderador Juego";
        case 4 : adnm = "Moderador Global";
        case 5 : adnm = "Administrador";
        case 6 : adnm = "Sub-Dueño";
        case 7 : adnm = "Fundador";
        case 8 : adnm = "Dueño";
        default: adnm = "Usuario";
    }
    return adnm;
}
stock EstadoAdmin(playerid) {
    new str[50];
    if (AdminDuty[playerid] == 0) {
        format(str, sizeof(str), "{FF0000}(Aduty Off)");
    } else format(str, sizeof(str), "{FFFF00}(En servicio)");

    return str;
}
public LoadAdmins(playerid) {
    if (cache_num_rows() == 0) return false;
    new content[64], NombrePlayer[35], EstadoP, dialogo[2500], UltimaC[50], Rango, estadoadm[50];
    format(dialogo, sizeof dialogo, "{FFFFFF}Nombre\t{FFFFFF}Rango\t{FFFFFF}ult. conexion\n");
    for(new z; z < cache_num_rows(); z++) {
        cache_get_value_name(z, "Conexion", content);
        format(UltimaC, 50, "%s", content);
        cache_get_value_name(z, "Username", content);
        format(NombrePlayer, 35, "%s", content);
        cache_get_value_name(z, "ID", content);
        ListaAdmins[playerid][z] = strval(content);
        cache_get_value_name(z, "Admin", content);
        Rango = strval(content);
        EstadoP = 0;
        foreach(new i : Player) {
            if (strcmp(PLAYER_INFO[i][Nickname], NombrePlayer, true) == 0) {
                EstadoP = 1;
                estadoadm = EstadoAdmin(i);
            }
        }
        if (EstadoP == 1) format(UltimaC, sizeof(UltimaC), "{00ff00}Conectado %s", estadoadm);
        format(dialogo, sizeof dialogo, "%s%s\t%s\t%s\n", dialogo, NombrePlayer, ADMIN_RANKS[Rango], UltimaC);
        dialogs_ShowPlayerDialog(playerid, D_ADMINS, DIALOG_STYLE_TABLIST_HEADERS, "Administradores", dialogo, "Opciones", "Cerrar");
    }
    return true;
}
public AbrirLZ() {
		#if TipoHost == 0
    {
        new hostname[128];
        format(hostname,sizeof(hostname), "hostname %s", RP_SERVER_HOSTNAME);
