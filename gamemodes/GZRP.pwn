    conquistar(playerid);
    return 1;
}
CMD:desenganchar(playerid) {
    // Detach the trailer from the vehicle
    DetachTrailerFromVehicle(GetPlayerVehicleID(playerid));
    // Send the player a message that the trailer has been detached
    PUSH(playerid, "Desenganchado");

    return 1;
}
ContarMiembrosEnTerritorio(banda_id, terri_id) {
    new count;
    foreach(new i : Player) {
        if (IsPlayerConnected(i)) {
            if (PLAYER_INFO[i][pFaccion] != 0) {
                if (PLAYER_INFO[i][pFaccion] == banda_id && PLAYER_INFO[i][Agonizando] == 0) {
                    if (IsPlayerInDynamicArea(i, TerritorioInfo[terri_id][Territorio_Area])) count++;
                }
            }
        }
    }
    return count;
}
ComenzarAtaqueTerritorio(banda_id, terri_id, time) {
    BandasInfo[banda_id][B_Atacando] = true;
    BandasInfo[banda_id][UltimoAtaque] = gettime();
    TerritorioInfo[terri_id][Territorio_EnGuerra] = true;
    TerritorioInfo[terri_id][Territorio_AtacanteID] = banda_id;
    TerritorioInfo[terri_id][Territorio_Tiempo] = time;
    TerritorioInfo[terri_id][Territorio_UltimoA] = gettime();
    UpdateGangZoneColor(terri_id);
    new message[145], message_td[100];
    format(message_td, sizeof(message_td), "Conquista:_~r~%s", TimeConvert(TerritorioInfo[terri_id][Territorio_Tiempo]));

    KillTimer(TerritorioInfo[terri_id][Territorio_TimerEx]);
    TerritorioInfo[terri_id][Territorio_TimerEx] = SetTimerEx("UpdateTerritorio", 1000, false, "i", terri_id);
    if (TerritorioInfo[terri_id][Territorio_Usado]) {
        BandasInfo[TerritorioInfo[terri_id][Territorio_BandaID2]][B_Atacando] = true;
        format(message, sizeof message, "~g~~h~[Bandas] ~r~%s comenzo~w~ a atacar un territorio de la banda ~r~%s~w~ en ~g~~h~%s.", BandasInfo[banda_id][BNombre], BandasInfo[TerritorioInfo[terri_id][Territorio_BandaID2]][BNombre], TerritorioInfo[terri_id][Territorio_Lugar]);
    } else format(message, sizeof message, "~g~~h~[Bandas] ~w~La banda ~r~%s~w~ comenzo a atacar un territorio en ~w~%s.", BandasInfo[banda_id][BNombre], TerritorioInfo[terri_id][Territorio_Lugar]);
    new message_police[145];
    format(message_police, sizeof message_police, "{4286f4}[Central policia] {FFFFFF}La banda '%s' comenzo a atacar un territorio en %s.", BandasInfo[banda_id][BNombre], TerritorioInfo[terri_id][Territorio_Lugar]);
    foreach(new i : Player) {
        if (IsPlayerConnected(i)) {
            if (PLAYER_INFO[i][pFaccion] == 1) SendClientMessage(i, -1, message_police);
            if (PLAYER_INFO[i][pFaccion] > 1) {
                Notificador2(i, message);
                if (IsPlayerInDynamicArea(i, TerritorioInfo[terri_id][Territorio_Area])) {
                    if (PLAYER_INFO[i][pFaccion] == banda_id && PLAYER_INFO[i][Agonizando] == 0) {
                        ShowPlayerMessage(i, message_td);
                        Notificador2(i, "~y~¡Cuidado!~w~ Esta zona esta presentando disturbios, los vecinos han llamado a la ~b~policia");
                    }
                }
            }
        }
    }
    return 1;
}
public UpdateTerritorio(terri_id) {
    if (!TerritorioInfo[terri_id][Territorio_Valido]) return 1;
    if (!TerritorioInfo[terri_id][Territorio_EnGuerra]) return 1;
    if (TerritorioInfo[terri_id][Territorio_Tiempo] <= 0) {
        BandasInfo[TerritorioInfo[terri_id][Territorio_BandaID2]][B_Atacando] = false;
        TerritorioInfo[terri_id][Territorio_BandaID] = TerritorioInfo[terri_id][Territorio_AtacanteID];
        TerritorioInfo[terri_id][Territorio_BandaID2] = TerritorioInfo[terri_id][Territorio_AtacanteID];
        new r, g, b, a;
        HexToRGBA(BandasInfo[TerritorioInfo[terri_id][Territorio_AtacanteID]][BColor], r, g, b, a);
        TerritorioInfo[terri_id][Territorio_Color] = RGBAToHex(r, g, b, 135);
        new message[145], Query[200];
        format(message, sizeof message, "{16EA77}[Radio] La banda {FFFFFF}'%s' ha conquistado un nuevo territorio.", BandasInfo[TerritorioInfo[terri_id][Territorio_AtacanteID]][BNombre]);
        mysql_format(handle_db, Query, 200, "UPDATE `territorios` SET `Banda`='%d',`Color`='%d' WHERE `ID`='%d'", TerritorioInfo[terri_id][Territorio_AtacanteID], TerritorioInfo[terri_id][Territorio_Color], TerritorioInfo[terri_id][Territorio_ID]);
        mysql_tquery(handle_db, Query);
        new cuentaterris = 0;
        for(new t = 0; t != MAX_T; t++) {

            if (TerritorioInfo[t][Territorio_Valido] && TerritorioInfo[t][Territorio_BandaID] != 0) {
                if (TerritorioInfo[t][Territorio_BandaID] == BandasInfo[TerritorioInfo[terri_id][Territorio_AtacanteID]][bID]) {
                    cuentaterris++;
                }
            }
        }
        new query[200];
        format(query, sizeof query, "UPDATE facciones SET cuentaterris=%d WHERE id =%d", cuentaterris, BandasInfo[TerritorioInfo[terri_id][Territorio_AtacanteID]][bID]);
        mysql_tquery(handle_db, query);
        format(message, sizeof(message), "Se dice que integrantes de %s se ha apoderado de una zona cerca de %s. Vecinos del area afectada se encuentran aterrorizados.", BandasInfo[TerritorioInfo[terri_id][Territorio_AtacanteID]][BNombre], TerritorioInfo[terri_id][Territorio_Lugar]);
        Webhook_Canales(1, message, 5, 0);
        BandasInfo[TerritorioInfo[terri_id][Territorio_AtacanteID]][UltimoAtaque] = gettime();
        BandasInfo[TerritorioInfo[terri_id][Territorio_AtacanteID]][B_Atacando] = false;
        TerritorioInfo[terri_id][Territorio_EnGuerra] = false;
        TerritorioInfo[terri_id][Territorio_AtacanteID] = 0;
        TerritorioInfo[terri_id][Territorio_Tiempo] = 0;
        TerritorioInfo[terri_id][Territorio_UltimoA] = gettime();
        KillTimer(TerritorioInfo[terri_id][Territorio_TimerEx]);
        UpdateGangZoneColor(terri_id);
        TerritorioInfo[terri_id][Territorio_Usado] = true;
        foreach(new i : Player) {
            if (IsPlayerConnected(i) && JugadorLogeado[i] != 0 && !IsPlayerNPC(i)) {
                if (PLAYER_INFO[i][pFaccion] > 10) {
                    if (IsPlayerInDynamicArea(i, TerritorioInfo[terri_id][Territorio_Area])) {
                        if (PLAYER_INFO[i][pFaccion] == TerritorioInfo[terri_id][Territorio_AtacanteID]) {
                            PLAYER_INFO[i][pMateriales] += 150;
                            DarDinero(i, 1000);
                            ColorJugadorDefault(i);
                            PLAYER_INFO[i][pMarihuana] += 10;
                            SendClientMessage(i, 0xFFFFFFAA, "Ganas {ff0000}150 piezas de armas{FFFFFF}, {00ca00}$1.000{FFFFFF} y {ff0000}10 gramos de marihuana{FFFFFF}.");
                        }
                        ColorJugadorDefault(i);
                    }
                }
            }
        }
        TerritorioInfo[terri_id][Territorio_AtacanteID] = 0;
        return 1;
    }
    TerritorioInfo[terri_id][Territorio_Tiempo]--;
    new message[145];
    format(message, sizeof(message), "Conquista:_~r~%s", TimeConvert(TerritorioInfo[terri_id][Territorio_Tiempo]));

    foreach(new i : Player) {
        if (IsPlayerConnected(i) && !IsPlayerNPC(i)) {
            if (IsPlayerInDynamicArea(i, TerritorioInfo[terri_id][Territorio_Area])) {
                ShowPlayerMessage(i, message);
            }
        }
    }
    new attackers_in_area = ContarMiembrosEnTerritorio(TerritorioInfo[terri_id][Territorio_AtacanteID], terri_id);
    if (attackers_in_area <= 0) {
        format(message, sizeof message, "{16EA77}[Bandas] {FFFFFF}%s no ha podido conquistar el territorio que estaba atacando.", BandasInfo[TerritorioInfo[terri_id][Territorio_AtacanteID]][BNombre]);
        BandasInfo[TerritorioInfo[terri_id][Territorio_AtacanteID]][UltimoAtaque] = gettime();
        BandasInfo[TerritorioInfo[terri_id][Territorio_AtacanteID]][B_Atacando] = false;
        BandasInfo[TerritorioInfo[terri_id][Territorio_BandaID2]][B_Atacando] = false;
        TerritorioInfo[terri_id][Territorio_EnGuerra] = false;
        TerritorioInfo[terri_id][Territorio_AtacanteID] = 0;
        TerritorioInfo[terri_id][Territorio_Tiempo] = 0;
        TerritorioInfo[terri_id][Territorio_UltimoA] = gettime();
        KillTimer(TerritorioInfo[terri_id][Territorio_TimerEx]);
        UpdateGangZoneColor(terri_id);
        foreach(new i : Player) {
            if (IsPlayerConnected(i)) {
                if (PLAYER_INFO[i][pFaccion] > 1) {
                    SendClientMessage(i, -1, message);
                    if (IsPlayerInDynamicArea(i, TerritorioInfo[terri_id][Territorio_Area])) {
                        if (PLAYER_INFO[i][pFaccion] == BandasInfo[TerritorioInfo[terri_id][Territorio_AtacanteID]][bID]) {
                            ColorJugadorDefault(i);
                        }
                    }
                }
            }
        }
        return 1;
    }
    KillTimer(TerritorioInfo[terri_id][Territorio_TimerEx]);
    TerritorioInfo[terri_id][Territorio_TimerEx] = SetTimerEx("UpdateTerritorio", 1000, false, "i", terri_id);
    return 1;
}
stock randomize(min, max) // Rango aleatorio
{
    max++;
    new
    a = random(max - min) + min;
    return a;
}
