DAR_COLOREARAM(playerid, newweapon) {

    if (COLOR_ARMA[playerid] != -1) {
        PINTARARMA_(playerid, newweapon, COLOR_ARMA[playerid]);
    }
}

PINTARARMA_(playerid, iWepID, iChoice) {

