                        }
                        PLAYER_INFO[playerid][pFaccion] = 0;
                        PLAYER_INFO[playerid][pRango] = 0;
                        PLAYER_INFO[playerid][pDuty] = 0;
                        HidePlayerGangZones(playerid);
                    }
                    case 6: {
                        new banda = PLAYER_INFO[playerid][pFaccion];
                        new item[2000];
                        format(item, sizeof(item), "%s\n", BandasInfo[banda][BNombre]);
                        //format(item,sizeof(item),"%s\n{FFFFFF}Rango 1: {ff3364}%s{FFFFFF}\n",item,BandasInfo[banda][BRango1]);
                        if (BandasInfo[banda][Mejoras] == 0) {
                            format(item, sizeof(item), "%sMejoras de la banda: {ff0000}No tiene{FFFFFF}\n", item);
                        }
                        if (BandasInfo[banda][Mejoras] > 0) {
                            format(item, sizeof(item), "%sMejoras de la banda: {ff0000}%d{FFFFFF}\n", item, BandasInfo[banda][Mejoras]);
                        }

                        format(item, sizeof(item), "%s \n", item);
                        format(item, sizeof(item), "%sMejorar tu banda te ayuda:\n", item);
                        format(item, sizeof(item), "%s \n", item);
                        format(item, sizeof(item), "%sConquistar territorios sin CoolDown (Requiere nivel 7)\n", item);
                        format(item, sizeof(item), "%sInvitar a los miembros al discord de banda desde web.\n", item);
                        format(item, sizeof(item), "%sAlertas en el discord [Fabrica - Conquistas - Refuerzos]\n", item);
                        format(item, sizeof(item), "%sAsignar uniformes para hombres/mujeres de mi banda\n", item);
                        dialogs_ShowPlayerDialog(playerid, BOOST_CREW, DIALOG_STYLE_INPUT, "Mejoras bandas", item, "Continuar", "Volver");
                    }
                }
            }
            return 1;
        }
        case BOOST_CREW: {
            if (response) {
                new banda = PLAYER_INFO[playerid][pFaccion];
                if (BandasInfo[banda][Mejoras] > 3) return ShowPlayerMessage(playerid, "~r~~h~~h~Si tu banda tienes mas de 3 mejoras no puedes comprar con totems.");
                if (strfind(inputtext, "=", true) != -1 || strfind(inputtext, "´", true) != -1 || strfind(inputtext, "'", true) != -1 || strfind(inputtext, "`", true) != -1 || strfind(inputtext, ",", true) != -1 || strfind(inputtext, "¨", true) != -1) return SendClientMessage(playerid, -1, "Error, intentalo nuevamente y ten cuidado con lo que escribes.");
                if (strval(inputtext) < 7 && strval(inputtext) != 0) {
                    new preciomejora = strval(inputtext) * MAX_PRICE_MEJORAS;
                    if (PLAYER_INFO[playerid][Totems] >= preciomejora) {
                        mysql_format(handle_db, Query, sizeof(Query), "UPDATE `facciones` SET `Mejoras`='%d'+Mejoras WHERE `id`='%d'", strval(inputtext), BandasInfo[PLAYER_INFO[playerid][pFaccion]][bID]);
                        mysql_tquery(handle_db, Query);
                        BandasInfo[banda][Mejoras] += strval(inputtext);
                        PLAYER_INFO[playerid][Totems] -= preciomejora;
                        ShowPlayerMessage(playerid, "~y~~h~¡Felicidades! mejoraste tu banda.");
                        if (PLAYER_INFO[playerid][pSonidos] == 1) PlayAudioStreamForPlayer(playerid, "http://"            AUDIO_LOGRO "");
                    } else return SendClientMessageEx(playerid, -1, "Necesitas %d Totems para comprar %d {fc01f2}mejoras de banda{ffffff}.", preciomejora, strval(inputtext));
                } else return SendClientMessage(playerid, -1, "Monto invalido.");
            }
        }
        case CONFIG_BANDA2: {
            if (response) {
                switch (listitem) {
                    case 0: {
                        dialogs_ShowPlayerDialog(playerid, CHANGE_CREW_NAME, DIALOG_STYLE_INPUT, "Nuevo nombre de la banda:", "Introduce el nuevo nombre de tu banda.", "Continuar", "Volver");
                    }
                    case 1: {
                        new DIALOG[676], banda = PLAYER_INFO[playerid][pFaccion];
                        format(string, sizeof(string), "{FFFFFF}- %s(1)\n", BandasInfo[banda][BRango1]);
                        strcat(DIALOG, string);
                        format(string, sizeof(string), "{FFFFFF}- %s(2)\n", BandasInfo[banda][BRango2]);
                        strcat(DIALOG, string);
                        format(string, sizeof(string), "{FFFFFF}- %s(3)\n", BandasInfo[banda][BRango3]);
                        strcat(DIALOG, string);
                        format(string, sizeof(string), "{FFFFFF}- %s(4)\n", BandasInfo[banda][BRango4]);
                        strcat(DIALOG, string);
                        format(string, sizeof(string), "{FFFFFF}- %s(5)\n", BandasInfo[banda][BRango5]);
                        strcat(DIALOG, string);
                        format(string, sizeof(string), "{FFFFFF}- %s(6)\n", BandasInfo[banda][BRango6]);
                        strcat(DIALOG, string);
                        format(string, sizeof(string), "{FFFFFF}- %s(7)\n", BandasInfo[banda][BRango7]);
                        strcat(DIALOG, string);
