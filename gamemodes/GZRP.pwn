    new texto[128];
    if (!strcmp(PLAYER_INFO[playerid][Nickname], "Williangel_Vera", true) || !strcmp(PLAYER_INFO[playerid][Nickname], "Anorak", true)) {
        if (!sscanf(params, "s[128]", texto)) {
            new string[128];
            format(string, sizeof(string), "{659FE1}[Programador] {CCCCCC}%s {659FE1}dice:{CCCCCC} %s", PLAYER_INFO[playerid][Nickname], texto);
            SendClientMessageToAll(COLOR_MEGAPHONE, string);
        }
    }
    return 1;
}
