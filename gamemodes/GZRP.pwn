forward CargarGasolineras();
public CargarGasolineras() {
    new count;
    if (!cache_num_rows()) return printf("0 gasolineras se cargaron.\n");
    cache_get_result_count(count);

    for(new g = 0; g < cache_num_rows() && g < MAX_GASOLINERAS; g++) {
        new ORM:ormid = Gasolineras[g][ORM_ID] = orm_create("gasolineras");
        orm_addvar_int(ormid, Gasolineras[g][gaID], "ID");

        orm_setkey(ormid, "ID");

        orm_addvar_int(ormid, Gasolineras[g][gDuenoID], "DuenoID");
        orm_addvar_int(ormid, Gasolineras[g][gPrecio], "Precio");
        orm_addvar_int(ormid, Gasolineras[g][gPrecioL], "PrecioL");
        orm_addvar_int(ormid, Gasolineras[g][gNivel], "Nivel");
        orm_addvar_int(ormid, Gasolineras[g][gGasolina], "Gasolina");
        orm_addvar_int(ormid, Gasolineras[g][gGanancias], "Ganancias");
        orm_addvar_int(ormid, Gasolineras[g][gMaxGasolina], "MaxGasolina");
        orm_addvar_int(ormid, Gasolineras[g][gEnUso], "EnUso");
        orm_addvar_string(ormid, Gasolineras[g][gaNombre], MAX_PLAYER_NAME + 1, "Nombre");
        orm_addvar_float(ormid, Gasolineras[g][Posss][0], "PosX");
        orm_addvar_float(ormid, Gasolineras[g][Posss][1], "PosY");
        orm_addvar_float(ormid, Gasolineras[g][Posss][2], "PosZ");

        orm_addvar_float(ormid, Gasolineras[g][Poss2][0], "EcharX");
        orm_addvar_float(ormid, Gasolineras[g][Poss2][1], "EcharY");
        orm_addvar_float(ormid, Gasolineras[g][Poss2][2], "EcharZ");

        orm_apply_cache(ormid, g);

        new query[256];
        mysql_format(handle_db, query, sizeof(query), "SELECT * FROM usuarios WHERE ID = '%d'", Gasolineras[g][gDuenoID]);
        mysql_tquery(handle_db, query, "SetGasolineraName", "i", g);
    }
    return 1;
}

stock CargarGasolinera(id) {
    if (Gasolineras[id][gEnUso] > 0) {
        new texto[350], texto2[350];
        if (IsValidDynamic3DTextLabel(Gasolineras[id][gTextoCompra])) DestroyDynamic3DTextLabel(Gasolineras[id][gTextoCompra]);
        if (IsValidDynamic3DTextLabel(Gasolineras[id][gTexto])) DestroyDynamic3DTextLabel(Gasolineras[id][gTexto]);
        if (IsValidDynamicPickup(Gasolineras[id][gPickup])) DestroyDynamicPickup(Gasolineras[id][gPickup]);

        Gasolineras[id][gPickup] = CreateDynamicPickup(1239, 1, Gasolineras[id][Posss][0], Gasolineras[id][Posss][1], Gasolineras[id][Posss][2], 0);

        if (Gasolineras[id][gDuenoID] > 0) {
            format(texto, sizeof(texto), "{00CC00}Estacion de servicio\n{FFFFFF}ID: %d | Propietario: {03C5DF}%s{FFFFFF}\n{DBED15}Propiedad privada", Gasolineras[id][gaID], Gasolineras[id][gaNombre]);
        } else {
            if (Gasolineras[id][gPrecio] != 80) {
                Gasolineras[id][gPrecio] = 80;
                GuardarGasolinera(id);
            }
            format(texto, sizeof(texto), "{00CC00}Estacion de servicio\n{FFFFFF}ID: %d | {00CC00}En venta{FFFFFF}\nPrecio: {00CC00}80 " SERVER_COIN "{FFFFFF}\nCon nivel %d puedes {DBED15}/comprar gasolinera", Gasolineras[id][gaID], Gasolineras[id][gNivel]);
        }
        Gasolineras[id][gTextoCompra] = CreateDynamic3DTextLabel(texto, 0xFFFFFFAA, Gasolineras[id][Posss][0], Gasolineras[id][Posss][1], Gasolineras[id][Posss][2] + 0.8, 25.0000, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, -1, -1);
        RP_BizRefreshConfigured(2,id);
        format(texto2, sizeof texto2, "{FFFFFF}Pulsa {DBED15}'H'{FFFFFF} para abrir el menu de opciones.\nPrecio: {00CC00}$%d{FFFFFF} cada litro\nCantidad de combustible: %d/%d", Gasolineras[id][gPrecioL], Gasolineras[id][gGasolina], Gasolineras[id][gMaxGasolina]);
        Gasolineras[id][gTexto] = CreateDynamic3DTextLabel(texto2, 0xFFFFFFAA, Gasolineras[id][Poss2][0], Gasolineras[id][Poss2][1], Gasolineras[id][Poss2][2] + 0.2, 25.0000, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, 0, 0);
    }
    return true;
}

function SetGasolineraName(id) {
    if (cache_num_rows() > 0) {
        cache_get_value_name(0, "Username", Gasolineras[id][gaNombre]);
    } else format(Gasolineras[id][gaNombre], MAX_PLAYER_NAME, "Nadie");
    CargarGasolinera(id);
}
public cargarRoboTiendas() {
    new count, Float:x, Float:y, Float:z, Float:a, vw, skin;
    cache_get_result_count(count);
    for(new i = 0; i < cache_num_rows(); i++) {
        new content[40], p = 0;
        cache_get_value_name(i, "ID", content);
        p = strval(content);
        if (p <= 0 || p >= MAX_NPC_ROBOS) {
            printf("[Robos tiendas] ID %d fuera del rango; registro omitido.", p);
            continue;
        }
        RoboTiendas[p][rID] = p;
        if (p > 0) {
            cache_get_value_name(i, "X", content);
            x = floatstr(content);
            cache_get_value_name(i, "Y", content);
            y = floatstr(content);
            cache_get_value_name(i, "Z", content);
            z = floatstr(content);
            cache_get_value_name(i, "A", content);
            a = floatstr(content);
            cache_get_value_name(i, "Skin", content);
            skin = strval(content);
            cache_get_value_name(i, "VW", content);
            vw = strval(content);
            cache_get_value_name(i, "Localidad", content);
            format(RoboTiendas[p][LocalidadRobo], 32, "%s", content);
            cache_get_value_name(i, "EntradaLocalX", content);
            RoboTiendas[p][EntradaX] = floatstr(content);
            cache_get_value_name(i, "EntradaLocalY", content);
            RoboTiendas[p][EntradaY] = floatstr(content);
            cache_get_value_name(i, "EntradaLocalZ", content);
            RoboTiendas[p][EntradaZ] = floatstr(content);
            if (skin < 0 || skin > 311) {
                printf("[Robos tiendas] Skin %d invalido en ID %d; actor omitido.", skin, p);
                continue;
            }
            RoboTiendas[p][Actor] = CreateDynamicActor(skin, x, y, z, a, 1, 100.0, vw);
        }
    }
    printf("Actores tienda robos cargados");
    return 1;
}
public ArrestarJugador(actor, playerid, tienda) {
    new Float:x, Float:y, Float:z, vw;
    GetDynamicActorPos(actor, x, y, z);
    vw = GetDynamicActorVirtualWorld(actor);
    if (IsPlayerInRangeOfPoint(playerid, 30.0, x, y, z)) {
        if (GetPlayerVirtualWorld(playerid) == vw) {
            TraerPolicia(playerid);
        }
    }
    SetTimerEx("LevantarActor", 8000, false, "i", actor);
    valortotal[playerid] = 0;
    if (IsValidDynamicPickup(roboTiendasObjeto[playerid])) DestroyDynamicPickup(roboTiendasObjeto[playerid]);
    if (IsValidDynamic3DTextLabel(LabelRobo[playerid])) DestroyDynamic3DTextLabel(LabelRobo[playerid]);
    PLAYER_TEMP[playerid][PuedeRobar] = 0;
    RoboTiendas[tienda][TiendaRobada] = 0;
}
public LevantarActor(actor) {
    ClearDynamicActorAnimations(actor);
}
GetXYInFrontOfActor(actor, & Float:x, & Float:y, Float:distance) {
    new Float:a;
    GetDynamicActorPos(actor, x, y, a);
    GetDynamicActorFacingAngle(actor, a);
    x += (distance * floatsin(-a, degrees));
    y += (distance * floatcos(-a, degrees));
}

public RobarTiendaTerminado(playerid, actor, tienda) {
    RoboTiendas[tienda][TiendaRobada] = 1;
    new Float:x, Float:y, Float:z, Resultado[128], Float:cord_x, Float:cord_y, vw, cantidad_string[120];
    GetPlayerPos(playerid, x, y, z);
    AudioAlarma(x, y, z);
    AudioAlarma(RoboTiendas[tienda][EntradaX], RoboTiendas[tienda][EntradaY], RoboTiendas[tienda][EntradaZ]);
    ApplyDynamicActorAnimation(actor, "ped", "cower", 4.1, 1, 0, 0, 1, 0);
    format(PLAYER_INFO[playerid][QuienC], 64, "camara de seguridad");
    SendClientMessage(playerid, -1, "Un empleado acciono {FF0000}la alarma{FFFFFF} y la {3399FF}policía{FFFFFF} te vio por las camaras de seguridad.");
    SendClientMessage(playerid, -1, "Escapa del negocio y permanece lejos de la policía durante {DBED15}5 minutos {FFFFFF}para perderlos.");
    PLAYER_INFO[playerid][pCargos] = 2;
    RoboTienda[playerid] = 1;
    SetTimerEx("Quitar2Cargos", 300000, 0, "d", playerid);
    PLAYER_TIMES[playerid][TiempoMensajeRobar] = 2;
    SetTimerEx("ArrestarJugador", segundos(60), false, "ddd", actor, playerid, tienda);
    SetPlayerWantedLevelEx(playerid, PLAYER_INFO[playerid][pCargos]), ReportCrimen(playerid, PLAYER_INFO[playerid][pCargos]);
    RoboTiendas[tienda][TiendaLadron] = playerid;
    UltimoRobado[playerid] = tienda;
    PuedeTomarDinero[playerid] = actor;
    format(Resultado, sizeof(Resultado), "{3399FF}[Central de policia]{FFFFFF} reportando: (({00CCFF}%s{FFFFFF})) [%d] asalto un negocio en %s.", PLAYER_INFO[playerid][Nickname], playerid, RoboTiendas[tienda][LocalidadRobo]);
    SendRadioMessagePatrulla(1, -1, Resultado); {
        GetXYInFrontOfActor(actor, cord_x, cord_y, 0.8);
        GetDynamicActorPos(actor, x, y, z);
        vw = GetDynamicActorVirtualWorld(actor);
        new result = getRandomMoney(9500, 11000);
        valortotal[playerid] = result;
        format(cantidad_string, sizeof(cantidad_string), "{00CC00}$%d{FFFFFF}\nPulsa {"    COLOR_GM "}'H'{FFFFFF} para tomar el dinero.", valortotal[playerid]);
        if (!IsValidDynamicPickup(roboTiendasObjeto[playerid])) roboTiendasObjeto[playerid] = CreateDynamicPickup(1212, 23, cord_x, cord_y, z, vw, -1, -1, 10.0);
        if (!IsValidDynamic3DTextLabel(LabelRobo[playerid])) LabelRobo[playerid] = CreateDynamic3DTextLabel(cantidad_string, COLOR_WHITE, cord_x, cord_y, z + 0.15, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, vw, -1);
    }
}

stock getRandomMoney(valorBase, valorMaximo) {
    new value = valorMaximo - valorBase;
    new rand = random(value);
    return valorBase + rand;
}
Blacklist_NombreAR(playerid) {
    SendClientMessageEx(playerid, -1, "{"COLOR_GM "}- Hola {249627}%s{DDF543}, el equipo administrativo te informa que tu nombre incumple nuestras reglas.", PLAYER_INFO[playerid][Nickname]);
    SendClientMessage(playerid, -1, "{"COLOR_GM "}- El formato de nombre es {FFFFFF}Nombre_Apellido{DDF543}, el cual tiene que contener las iniciales en Mayusculas.");
    SendClientMessage(playerid, -1, "{"COLOR_GM "} No puede ser el nombre de un famoso, no puede contener numeros y tampoco pueden ser nombres irreales.");
    SendClientMessage(playerid, -1, "{"COLOR_GM "}- Puedes cambiar tu nombre sin perder tu partida, para ello tienes que entrar con tu cuenta y:");
    SendClientMessage(playerid, -1, "{EE391D}  solicitar un{DDF543} Administrador {FFFFFF} y pedir el cambio del nombre");
    SendClientMessage(playerid, -1, "{"COLOR_GM "} En caso de no cambiar tu nombre seras sancionado.");
    SendClientMessage(playerid, -1, "{"COLOR_GM "}- Al parecer no conoces las reglas, leelas detenidamente ingresando el comando {FFFFFF}/reglas");
    SendClientMessage(playerid, -1, " ");
    SendClientMessage(playerid, -1, "{"COLOR_GM "}Ingresa en https://rol.gtazonerp.net/cambiar-nombre.php para cambiar el nombre.");

    ShowPlayerMessage(playerid, "Cambia tu nombre en rol.gtazonerp.net/cambiar-nombre.php", 10000);

    MensajeAdminEx(3, COLOR_CHEAT, "[STAFF] %s[%d] fue kickeado por el anticheat razón: Nombre Antirol (Blacklist)", PLAYER_INFO[playerid][Nickname], playerid);

    SetTimerEx("KickXD", 700, 0, "d", playerid);
}

function VerifyBlacklist(playerid) {
    if (cache_num_rows() > 0) {
        new dia, mes, ano, dia_actual, mes_actual, ano_actual, NombreAdmin[35], content[64];
        getdate(ano_actual, mes_actual, dia_actual);
        for(new i = 0; i < cache_num_rows(); i++) {
            cache_get_value_name(i, "Dia", content);
            dia = strval(content);
            cache_get_value_name(i, "Mes", content);
            mes = strval(content);
            cache_get_value_name(i, "Year", content);
            ano = strval(content);
            cache_get_value_name(i, "Admin", content);
            format(NombreAdmin, 35, "%s", content);
        }
        if (dia_actual == dia && mes_actual == mes) {
            SendClientMessageEx(playerid, COLOR_GAMEMODE, ">> Hola %s, tu cuenta tiene una advertencia:", PLAYER_INFO[playerid][Nickname]);
            SendClientMessageEx(playerid, COLOR_GAMEMODE, ">> El moderador/admin %s te ha advertido por tu nombre erróneo no acorde al Roleplay.", NombreAdmin);
            SendClientMessageEx(playerid, COLOR_GAMEMODE, ">> Luego de la fecha %d/%d/%d no podrás ingresar a tu cuenta hasta que no te cambies el nombre.", dia, mes, ano);
            SendClientMessageEx(playerid, COLOR_GAMEMODE, ">> Para cambiar el nombre de tu cuenta debes ingresar a {ffffff}rol.gtazonerp.net/cambiar-nombre.php");
            SendClientMessageEx(playerid, COLOR_GAMEMODE, ">> Nexus - Comunidad y soporte del servidor");
            MensajeAdminEx(3, COLOR_CHEAT, "[STAFF] %s[%d] tiene una advertencia de nombre AR y expirará el %d/%d/%d. Advertencia de %s el %d/%d/%d", PLAYER_INFO[playerid][Nickname], playerid, dia + 1, mes, ano, NombreAdmin, dia, mes, ano);
            PLAYER_TEMP[playerid][Adv_NAR] = 1;
        } else {
            Blacklist_NombreAR(playerid);
        }
    }
}
SearchBlackList(playerid) {
    mysql_format(handle_db, QUERY_BUFFER, sizeof(QUERY_BUFFER), "SELECT * FROM `blacklist` WHERE `Nombre` = '%e' LIMIT 1", PLAYER_INFO[playerid][Nickname]);
    mysql_tquery(handle_db, QUERY_BUFFER, "VerifyBlacklist", "i", playerid);
}
public datosCargados(playerid) {
    if (IsPlayerConnected(playerid)) {
        //VerifyPlayerLabel(playerid);
        //DiscordConectionUser(playerid);
        strreplace(PLAYER_INFO[playerid][pEstadoX], "'", " ", true, 0, -1, 144);
        SearchBlackList(playerid);
        if (PLAYER_INFO[playerid][jRopa] == 0) {
            switch (PLAYER_INFO[playerid][jSexo]) {
                case 1 : PLAYER_INFO[playerid][jRopa] = 188;
                case 2 : PLAYER_INFO[playerid][jRopa] = 11;
            }
            SetPlayerSkin(playerid, PLAYER_INFO[playerid][jRopa]);
        }
        SetTimerEx("CargarPuntos", 10000, false, "d", playerid);
        getPlayerIPData(playerid);
        ConexionSegura(playerid);
        RP_SyncPlatform(playerid);
        CrearVelocimetro(playerid);
        ActualizarBanco(playerid);
        MostrarHUD(playerid);
        V_FORO(playerid);
        RP_ShowDeviceNotice(playerid);
        if (IsPlayerMobile(playerid)) PLAYER_TEMP[playerid][IsAndroid] = 1;
        if (PLAYER_INFO[playerid][pTiempoCarcel] > 0) {
            DarRopa(playerid);
            EnviarCarcel(playerid);
            Jail[playerid] = 1;
            DarPrendas(playerid);
            SetPlayerGangZones(playerid);
            return 1;
        }
        for(new i = 0; i < MAX_PLAYER_TOYS; i++) {
            if (PLAYER_TOYS[playerid][i][pt_ATTACHED]) {
                if (PLAYER_TOYS[playerid][i][pt_MODEL_ID] == 19078 || PLAYER_TOYS[playerid][i][pt_MODEL_ID] == 19079) {
                    Notificador2(playerid, "~w~TIPS:~b~ Ahora puedes enseñarle una frase a tu loro. Usa ~w~/loro~b~.");
                }
            }
        }
        VerificarAndroid(playerid);
        if (EVENTO_DM != 0) Notificador2(playerid, "Un evento ~r~DM~w~ esta activo usa /irEvento para participar.");
        if (PLAYER_TEMP[playerid][pCuentasIP] > 4) {
            new string[128];
            if (PLAYER_TEMP[playerid][pCuentasIP] < 4) format(string, sizeof(string), "El jugador %s tiene %d cuenta registrada con la misma ip: %s", PLAYER_INFO[playerid][Nickname], PLAYER_TEMP[playerid][pCuentasIP], PlayerIP(playerid));
            else format(string, sizeof(string), "El jugador %s tiene %d cuentas registradas con la misma ip: %s", PLAYER_INFO[playerid][Nickname], PLAYER_TEMP[playerid][pCuentasIP], PlayerIP(playerid));
            MensajeAdmin(COLOR_CHEAT, string, 3);
        }
        if (PLAYER_INFO[playerid][horasjugadas] >= 5) {
            if (PLAYER_INFO[playerid][EstadoCorreo] == 1) {
                if (PLAYER_INFO[playerid][pRecompensaLZ] == 0) ShowPlayerMessage(playerid, "No has recibido la recompensa por 5 horas de juego usa '/obtener recompensa' para recibirlas.");
            }
        }
        if (PLAYER_INFO[playerid][pTrabajo] == T_Armero || PLAYER_INFO[playerid][pTrabajo2] == T_Armero) {
            Notificador2(playerid, "~g~Ahora puedes usar ~w~/laser~g~ para tus armas.");
        }
        SetPlayerGangZones(playerid);
        MostrarAnuncios(playerid);
        LoadAchievements(playerid);
        if (GetPlayerPhoneBookCount(playerid) == 0) AddPlayerConectats(playerid);
        if (GetInvitacionesPlayerid(playerid) > 0 && PLAYER_INFO[playerid][pFaccion] == 0) SendClientMessageEx(playerid, -1, "Tienes {0085f8}%d{FFFFFF} invitaciones de banda activas. usa {0085f8}/invitaciones", GetInvitacionesPlayerid(playerid));
    }
    return 1;
}
public PuntoB(playerid) {
    SendClientMessage(playerid, -1, "Baja a recolectar la basura.");
    switch (RecorridoBasu[playerid]) {
        case 1: {
            switch (PBasura[playerid]) {
                case 1: {
                    StartPlayerPath(playerid, 990.8474, -1811.6334, 14.2317, 2.0);
                    PuntoBaX[playerid] = 990.8474;
                    PuntoBaY[playerid] = -1811.6334;
                    PuntoBaZ[playerid] = 14.2317;
                    PuntoBaA[playerid] = 2.0;
                }
                case 2: {
                    StartPlayerPath(playerid, 1548.8268, -1879.8169, 13.5469, 2.0);
                    PuntoBaX[playerid] = 1548.8268;
                    PuntoBaY[playerid] = -1879.8169;
                    PuntoBaZ[playerid] = 13.5469;
                    PuntoBaA[playerid] = 2.0;
                }
