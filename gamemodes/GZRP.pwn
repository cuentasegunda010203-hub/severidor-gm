        Incendios[a][pObject][4] = CreateDynamicObject(18691, Estacionamientos[houseid][PosX] - 2, Estacionamientos[houseid][PosY] - 2, Estacionamientos[houseid][PosZ], 0.0, 0.0, 0.0, -1, -1, -1, MAX_RADIO_STREAM);
