CMD:acento(playerid) {
    ShowDialog(playerid, DIALOG_ACENTO);
    return 1;
}
AccionesRol(playerid, const params[], rango = 20) {
    new string[200];
    if (PLAYER_INFO[playerid][pMascaraPuesta] == 1) format(string, sizeof(string), "Desconocido %s", params);
    format(string, sizeof(string), "%s %s", PLAYER_INFO[playerid][Nickname], params);
    ProxDetector(rango, playerid, string, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES);
    return 1;
}
stock AccionesRol2(playerid, const params[], rango) {
