        if (tipo == 6) MensajeEx(playerid, -1, "Tu {009AFF}%s{FFFFFF} ha sido guardado en el estacionamiento de {00CCFF}El castillo del diablo", GetVehicleName(autos4[playerid]));
        if (tipo == 5) MensajeEx(playerid, -1, "Tu {009AFF}%s{FFFFFF} fue trasladado al estacionamiento del Salon de Eventos.", GetVehicleName(autos4[playerid]));
        if (tipo != 6) LinkVehicleToInterior(autos4[playerid], 1);
        else LinkVehicleToInterior(autos4[playerid], 30);
        if (tipo == 2) SetVehicleVirtualWorld(autos4[playerid], 4);
        else if (tipo == 6) SetVehicleVirtualWorld(autos4[playerid], 6);
        else SetVehicleVirtualWorld(autos4[playerid], tipo);
        SetVehicleHealth(autos4[playerid], PLAYER_INFO[playerid][pVidaV4]);
        PLAYER_INFO[playerid][vEstacionado4] = estacionamientoid;
        ActualizarVariablesVeh(playerid, autos4[playerid], 4);
    }

    AddVehicleComponent(autos4[playerid], PLAYER_INFO[playerid][v4Componentes0]);
    AddVehicleComponent(autos4[playerid], PLAYER_INFO[playerid][v4Componentes1]);
    AddVehicleComponent(autos4[playerid], PLAYER_INFO[playerid][v4Componentes2]);
    AddVehicleComponent(autos4[playerid], PLAYER_INFO[playerid][v4Componentes3]);
    AddVehicleComponent(autos4[playerid], PLAYER_INFO[playerid][v4Componentes4]);
    AddVehicleComponent(autos4[playerid], PLAYER_INFO[playerid][v4Componentes5]);
    AddVehicleComponent(autos4[playerid], PLAYER_INFO[playerid][v4Componentes6]);
    AddVehicleComponent(autos4[playerid], PLAYER_INFO[playerid][v4Componentes7]);
    AddVehicleComponent(autos4[playerid], PLAYER_INFO[playerid][v4Componentes8]);
    AddVehicleComponent(autos4[playerid], PLAYER_INFO[playerid][v4Componentes9]);
    AddVehicleComponent(autos4[playerid], PLAYER_INFO[playerid][v4Componentes10]);
    AddVehicleComponent(autos4[playerid], PLAYER_INFO[playerid][v4Componentes11]);
    AddVehicleComponent(autos4[playerid], PLAYER_INFO[playerid][v4Componentes12]);
    AddVehicleComponent(autos4[playerid], PLAYER_INFO[playerid][v4Componentes13]);
    VehicleFuel[autos4[playerid]] = PLAYER_INFO[playerid][v4Gas];
    UpdateVehicleDamageStatus(autos4[playerid], PLAYER_INFO[playerid][V4E1], PLAYER_INFO[playerid][V4E2], PLAYER_INFO[playerid][V4E3], PLAYER_INFO[playerid][V4E4]);
    if (PLAYER_INFO[playerid][vPJ4] >= 0) ChangeVehiclePaintjob(autos4[playerid], PLAYER_INFO[playerid][vPJ4]);
    if (PLAYER_INFO[playerid][vSeguro4] == 1) {
        bloqueado[autos4[playerid]] = 1;
        GetVehicleParamsEx(autos4[playerid], engine, lights, alarm, doors, bonnet, boot, objective);
        SetVehicleParamsEx(autos4[playerid], engine, lights, alarm, 1, bonnet, boot, objective);
    } else if (PLAYER_INFO[playerid][vSeguro4] == 0) {
        bloqueado[autos4[playerid]] = 0;
        GetVehicleParamsEx(autos4[playerid], engine, lights, alarm, doors, bonnet, boot, objective);
        SetVehicleParamsEx(autos4[playerid], engine, lights, alarm, 0, bonnet, boot, objective);
    }
    if (IsValidVehicle(autos4[playerid]) && PLAYER_INFO[playerid][vID4] != 0) {
        new Query[256];
        mysql_format(handle_db, Query, sizeof(Query), "SELECT * FROM `tuning_objects` WHERE `ID_VEHICLE` = '%d' AND `FACC` = '0' LIMIT %d;", PLAYER_INFO[playerid][vID4], MAX_OBJETOS);
        mysql_tquery(handle_db, Query, "L_Objetos", "i", autos4[playerid]);
    }
    if (PLAYER_INFO[playerid][v4Alarma] == 1) alarma[autos4[playerid]] = 1;
    else if (PLAYER_INFO[playerid][v4Alarma] == 0) alarma[autos4[playerid]] = 0;
    ChangeVehicleColor(autos4[playerid], PLAYER_INFO[playerid][v4Color1], PLAYER_INFO[playerid][v4Color2]);
    SetVehicleNumberPlate(autos4[playerid], PLAYER_INFO[playerid][v4patente]);
    Baul[autos4[playerid]] = 0;
    MotorAuto[autos4[playerid]] = 0;
    Balde[autos4[playerid]] = 0;
    Luces[autos4[playerid]] = 0;
    SetVehicleHealth(autos4[playerid], PLAYER_INFO[playerid][pVidaV4]);
    return 1;
}
public Auto5(playerid, tipo) {
    if (!IsPlayerConnected(playerid)) return 1;
    if (JugadorLogeado[playerid] != 1) return 1;
    if (tipo == 0) {
        autos5[playerid] = LZ_CreateVehicle(PLAYER_INFO[playerid][vModelo5], PLAYER_INFO[playerid][v5X], PLAYER_INFO[playerid][v5Y], PLAYER_INFO[playerid][v5Z], PLAYER_INFO[playerid][v5A], PLAYER_INFO[playerid][v5Color1], PLAYER_INFO[playerid][v5Color2], -1, 0);
        LinkVehicleToInterior(autos5[playerid], PLAYER_INFO[playerid][v5interior]);
        SetVehicleVirtualWorld(autos5[playerid], PLAYER_INFO[playerid][v5vw]);
        SetVehicleHealth(autos5[playerid], PLAYER_INFO[playerid][pVidaV5]);
        IsPlayerNearVehicle(playerid, autos5[playerid]);
        ActualizarVariablesVeh(playerid, autos5[playerid], 5);
        SetVehicleZAngle(autos5[playerid], PLAYER_INFO[playerid][v5A]);
    }
    if (tipo == 3) {
        if (TowedCar[playerid][3] == 0) MensajeEx(playerid, -1, "Tu {009AFF}%s{FFFFFF} fue remolcado al ultimo lugar donde lo estacionaste.", GetVehicleName(autos5[playerid]));
        if (autos5[playerid] != INVALID_VEHICLE_ID) DestroyVehicleEx(autos5[playerid]);
        autos5[playerid] = LZ_CreateVehicle(PLAYER_INFO[playerid][vModelo5], PLAYER_INFO[playerid][pOX5], PLAYER_INFO[playerid][pOY5], PLAYER_INFO[playerid][pOZ5], PLAYER_INFO[playerid][pOA5], PLAYER_INFO[playerid][v5Color1], PLAYER_INFO[playerid][v5Color2], -1, 0);
        LinkVehicleToInterior(autos5[playerid], PLAYER_INFO[playerid][v5Ointerior]);
        SetVehicleVirtualWorld(autos5[playerid], PLAYER_INFO[playerid][v5Ovw]);
        SetVehicleHealth(autos5[playerid], PLAYER_INFO[playerid][pVidaV5]);
        TowedCar[playerid][3] = 0;
        ActualizarVariablesVeh(playerid, autos5[playerid], 5);
    } else if (tipo == 2 || tipo == 6 || tipo == 7 || tipo == 8 || tipo == 9 || tipo == 10) {
        new floor = 1, rand, estacionamientoid;
        switch (tipo) {
            case 2 : estacionamientoid = 4;
            case 6 : estacionamientoid = 6;
        }
        if (IsValidVehicle(autos5[playerid])) DestroyVehicleEx(autos5[playerid]);
        switch (tipo) {
            case 2 : rand = random(sizeof(EstacionamientoCamionero));
            case 6 : rand = random(sizeof(EstacionamientoMinero));
            default: rand = random(sizeof(EstacionamientoNormal));
        }
        switch (tipo) {
            case 2: {
                new random1 = random(10);
                new Float:Altitud;
                switch (random1) {
                    case 0 :  { floor = 1;
                        Altitud = 10.7177; }
                    case 1 :  { floor = 2;
                        Altitud = 14.9808; }
                    case 2 :  { floor = 3;
                        Altitud = 19.3031; }
                    case 3 :  { floor = 4;
                        Altitud = 23.5820; }
                    case 4 :  { floor = 5;
                        Altitud = 27.8949; }
                    case 5 :  { floor = 6;
                        Altitud = 32.2014; }
                    case 6 :  { floor = 7;
                        Altitud = 36.4815; }
                    case 7 :  { floor = 8;
                        Altitud = 40.8009; }
                    case 8 :  { floor = 9;
                        Altitud = 45.0817; }
                    case 9 :  { floor = 10;
                        Altitud = 49.4005; }
                    default:  { floor = 1;
                        Altitud = 10.7177; }
                }
                autos5[playerid] = LZ_CreateVehicle(PLAYER_INFO[playerid][vModelo5], EstacionamientoCamionero[rand][0], EstacionamientoCamionero[rand][1], Altitud, EstacionamientoCamionero[rand][3], PLAYER_INFO[playerid][v5Color1], PLAYER_INFO[playerid][v5Color2], -1, 0);
            }
            case 6 : autos5[playerid] = LZ_CreateVehicle(PLAYER_INFO[playerid][vModelo5], EstacionamientoMinero[rand][0], EstacionamientoMinero[rand][1], EstacionamientoMinero[rand][2], EstacionamientoMinero[rand][3], PLAYER_INFO[playerid][v5Color1], PLAYER_INFO[playerid][v5Color2], -1, 0);
            default: autos5[playerid] = LZ_CreateVehicle(PLAYER_INFO[playerid][vModelo5], EstacionamientoNormal[rand][0], EstacionamientoNormal[rand][1], EstacionamientoNormal[rand][2], EstacionamientoNormal[rand][3], PLAYER_INFO[playerid][v5Color1], PLAYER_INFO[playerid][v5Color2], -1, 0);
        }
        if (tipo == 2) MensajeEx(playerid, -1, "Tu {009AFF}%s{FFFFFF} ha sido guardado en el {8baab7}nivel %d{FFFFFF} del estacionamiento de la{00CCFF} Plaza LSPD", GetVehicleName(autos5[playerid]), floor);
        if (tipo == 6) MensajeEx(playerid, -1, "Tu {009AFF}%s{FFFFFF} ha sido guardado en el estacionamiento de {00CCFF}El castillo del diablo", GetVehicleName(autos5[playerid]));
        if (tipo == 5) MensajeEx(playerid, -1, "Tu {009AFF}%s{FFFFFF} fue trasladado al estacionamiento del Salon de Eventos.", GetVehicleName(autos5[playerid]));
        if (tipo != 6) LinkVehicleToInterior(autos5[playerid], 1);
        else LinkVehicleToInterior(autos5[playerid], 30);
        if (tipo == 2) SetVehicleVirtualWorld(autos5[playerid], 5);
        else if (tipo == 6) SetVehicleVirtualWorld(autos5[playerid], 6);
        else SetVehicleVirtualWorld(autos5[playerid], tipo);
        SetVehicleHealth(autos5[playerid], PLAYER_INFO[playerid][pVidaV5]);
        PLAYER_INFO[playerid][vEstacionado5] = estacionamientoid;
        ActualizarVariablesVeh(playerid, autos5[playerid], 5);
    }
    AddVehicleComponent(autos5[playerid], PLAYER_INFO[playerid][v5Componentes0]);
    AddVehicleComponent(autos5[playerid], PLAYER_INFO[playerid][v5Componentes1]);
    AddVehicleComponent(autos5[playerid], PLAYER_INFO[playerid][v5Componentes2]);
    AddVehicleComponent(autos5[playerid], PLAYER_INFO[playerid][v5Componentes3]);
    AddVehicleComponent(autos5[playerid], PLAYER_INFO[playerid][v5Componentes4]);
    AddVehicleComponent(autos5[playerid], PLAYER_INFO[playerid][v5Componentes5]);
    AddVehicleComponent(autos5[playerid], PLAYER_INFO[playerid][v5Componentes6]);
    AddVehicleComponent(autos5[playerid], PLAYER_INFO[playerid][v5Componentes7]);
    AddVehicleComponent(autos5[playerid], PLAYER_INFO[playerid][v5Componentes8]);
    AddVehicleComponent(autos5[playerid], PLAYER_INFO[playerid][v5Componentes9]);
    AddVehicleComponent(autos5[playerid], PLAYER_INFO[playerid][v5Componentes10]);
    AddVehicleComponent(autos5[playerid], PLAYER_INFO[playerid][v5Componentes11]);
    AddVehicleComponent(autos5[playerid], PLAYER_INFO[playerid][v5Componentes12]);
    AddVehicleComponent(autos5[playerid], PLAYER_INFO[playerid][v5Componentes13]);
    VehicleFuel[autos5[playerid]] = PLAYER_INFO[playerid][v5Gas];
    UpdateVehicleDamageStatus(autos5[playerid], PLAYER_INFO[playerid][V5E1], PLAYER_INFO[playerid][V5E2], PLAYER_INFO[playerid][V5E3], PLAYER_INFO[playerid][V5E4]);
    if (PLAYER_INFO[playerid][vPJ5] >= 0) ChangeVehiclePaintjob(autos5[playerid], PLAYER_INFO[playerid][vPJ5]);
    if (PLAYER_INFO[playerid][vSeguro5] == 1) {
        bloqueado[autos5[playerid]] = 1;
        GetVehicleParamsEx(autos5[playerid], engine, lights, alarm, doors, bonnet, boot, objective);
        SetVehicleParamsEx(autos5[playerid], engine, lights, alarm, 1, bonnet, boot, objective);
    } else if (PLAYER_INFO[playerid][vSeguro5] == 0) {
        bloqueado[autos5[playerid]] = 0;
        GetVehicleParamsEx(autos5[playerid], engine, lights, alarm, doors, bonnet, boot, objective);
        SetVehicleParamsEx(autos5[playerid], engine, lights, alarm, 0, bonnet, boot, objective);
    }
    if (IsValidVehicle(autos5[playerid]) && PLAYER_INFO[playerid][vID5] != 0) {
        new Query[256];
        mysql_format(handle_db, Query, sizeof(Query), "SELECT * FROM `tuning_objects` WHERE `ID_VEHICLE` = '%d' AND `FACC` = '0' LIMIT %d;", PLAYER_INFO[playerid][vID5], MAX_OBJETOS);
        mysql_tquery(handle_db, Query, "L_Objetos", "i", autos5[playerid]);
    }
    if (PLAYER_INFO[playerid][v5Alarma] == 1) alarma[autos5[playerid]] = 1;
    else if (PLAYER_INFO[playerid][v5Alarma] == 0) alarma[autos5[playerid]] = 0;
    ChangeVehicleColor(autos5[playerid], PLAYER_INFO[playerid][v5Color1], PLAYER_INFO[playerid][v5Color2]);
    SetVehicleNumberPlate(autos5[playerid], PLAYER_INFO[playerid][v5patente]);
    Baul[autos5[playerid]] = 0;
    MotorAuto[autos5[playerid]] = 0;
    Balde[autos5[playerid]] = 0;
    Luces[autos5[playerid]] = 0;
    SetVehicleHealth(autos5[playerid], PLAYER_INFO[playerid][pVidaV5]);
    return 1;
}
