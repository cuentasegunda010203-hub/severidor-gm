        cache_get_value_name_int(0, "Muertes", PLAYER_INFO[playerid][Muertes]);
        cache_get_value_name_int(0, "BackPack", BackPack[playerid][bDBID]);
        CAR_BackPack(playerid);
        LoadVehicles(playerid);
        LogeoCorrecto[playerid] = 1;
        PrimerSpawnDisponible[playerid]++;
        SetSpawnInfo(playerid, 0, PLAYER_INFO[playerid][jRopa], PLAYER_INFO[playerid][@X], PLAYER_INFO[playerid][@Y], PLAYER_INFO[playerid][@Z], PLAYER_INFO[playerid][@A], 0, 0, 0, 0, 0, 0);
        SetPlayerSkin(playerid, PLAYER_INFO[playerid][jRopa]);
        SetPlayerScore(playerid, PLAYER_INFO[playerid][@Nivel]);
        EstablecerVida(playerid, PLAYER_INFO[playerid][@Salud]);
        EstablecerChaleco(playerid, PLAYER_INFO[playerid][@Chaleco]);
        PLAYER_TIMES[playerid][TIMER_VIDA] = gettime() + 3;
        PLAYER_TIMES[playerid][TIMER_CHALECO] = gettime() + 3;
        if (PLAYER_INFO[playerid][pBloqueado] == 1) {

            KillTimer(LCHAT[playerid]);
            new str[220];
            format(str, sizeof(str), "_ Su cuenta se encuentra bloqueada por ingresar desde un pais distinto.", PLAYER_INFO[playerid][pRazon]);
            SendClientMessage(playerid, COLOR_MUTE, str);
            format(str, sizeof(str), "_ Contacte a un administrador en https://"WEB_ROL "/foro/index.php para realizar", PLAYER_INFO[playerid][pRazon]);
            SendClientMessage(playerid, COLOR_MUTE, str);
            format(str, sizeof(str), "el proceso de desbloqueo de su cuenta.", PLAYER_INFO[playerid][pRazon]);
            SendClientMessage(playerid, COLOR_MUTE, str);
            format(str, sizeof(str), "El jugador %s tiene la cuenta bloqueada por cambio de ip y fue kickeado.", PLAYER_INFO[playerid][Nickname]);
            //DCC_SendChannelMessage(discord_channel_id, str);
            ExpulsarJugador(playerid, "Cuenta Bloqueada.");

            return 1;
        }
        new tiempobaneo = PLAYER_INFO[playerid][@TempBan] + gettime();
        if (PLAYER_INFO[playerid][@TempBan] > tiempobaneo) return ExpulsarJugador(playerid, "Baneado Temporalmente");
        if (PLAYER_INFO[playerid][p_Ban] == 1) {
            new str[120];
            format(str, sizeof(str), "El jugador %s tiene la cuenta `baneada` y fue kickeado.", PLAYER_INFO[playerid][Nickname]);
            //DCC_SendChannelMessage(discord_channel_id, str);
            ExpulsarJugador(playerid, "Cuenta Baneada");
        }
        if (EnClub[playerid] > 0) {

            RP_LGSpawnReady(playerid);
            SacarClubLogeado(playerid);
            return true;
        }
        if (PLAYER_INFO[playerid][Agonizando] == 1) {
            Muriendo[playerid] = 1;
            if (!IsPlayerMobile(playerid)) TextDrawShowForPlayer(playerid, NewPlayer[2]), TextDrawShowForPlayer(playerid, NewPlayer[0]);
            if (!IsPlayerMobile(playerid)) TextDrawShowForPlayer(playerid, Sangre), PlayerPlaySound(playerid, 1054, 0.0, 0.0, 0.0);
        }
        if (PLAYER_INFO[playerid][pTiempoJail] > 0) {

            DarRopa(playerid);
            San[playerid] = 1;
            SetTimerEx("EnviarJail", 2000, false, "d", playerid);
            RP_LGSpawnReady(playerid);
            return 1;
        }
        if (PLAYER_INFO[playerid][pCargos] > 0) {

            DarRopa(playerid);
            new dineroquitado = PLAYER_INFO[playerid][pCargos] * 500 + 200;
            QuitarDinero(playerid, dineroquitado);
            RP_LGSpawnReady(playerid);
            SetTimerEx("Encerrando2", 3000, false, "d", playerid);
            return 1;
        }
        if (PLAYER_INFO[playerid][pEMS] == 0) {

            new string[128];
            format(string, sizeof(string), "Ingresa un e-mail valido para recuperar tu contraseña en caso de perderla.\n\nTu e-mail:");
            dialogs_ShowPlayerDialog(playerid, DEMAIL, DIALOG_STYLE_INPUT, "Ingresa tu direccion de e-mail", string, "Siguiente", "");
            return 1;
        }
        if (PLAYER_INFO[playerid][jSexo] == -1) return dialogs_ShowPlayerDialog(playerid, SEXO, DIALOG_STYLE_LIST, "¿Eres hombre o mujer?", "Hombre\nMujer", "Seleccionar", "Salir");
        else {
            JugadorLogeado[playerid] = 1;
            RP_LGSpawnReady(playerid);
            DarRopa(playerid);
            if (PLAYER_INFO[playerid][AsaltoBlindado] > 0) {
                PLAYER_INFO[playerid][pMundoVirtual] = 0;
                PLAYER_INFO[playerid][pInterior] = 0;
                SacarDeParti(playerid, PLAYER_INFO[playerid][AsaltoBlindado]);
            }
            return 1;
        }
    } else {
        if (IsPlayerConnected(playerid)) {
            ShowPlayerMessage(playerid, "~r~Detectamos un inicio de sesion inusual, introduzca su contraseña.");
            TextdrawLogin(playerid, 0);
            PLAYER_TEMP[playerid][Logueos]++;
            if (PLAYER_TEMP[playerid][Logueos] >= 3) SendClientMessage(playerid, COLOR_GAMEMODE, "Contraseña inválida."), KillTimer(LCHAT[playerid]), ExpulsarJugador(playerid, "Intentos de logueo excedido");
        }
    }
    return 1;
}
public IsArrested(playerid) {
    if (PLAYER_INFO[playerid][pTiempoCarcel] > 0) {
        if (PLAYER_INFO[playerid][@Nivel] >= 10) return SendClientMessage(playerid, -1, "Puedes pagar para cumplir la condena en prision {"    COLOR_GM "}/pagar fianza{FFFFFF}.");
        SendClientMessage(playerid, -1, "Estas en prision.");
        SendClientMessage(playerid, -1, "Para ver cuanto tiempo te falta para cumplir la condena, usa {"    COLOR_GM "}/tiempo");
        SendClientMessage(playerid, -1, "La policia le quita a los detenidos, sus armas y drogas.");
        Jail[playerid] = 1;
    }
    return 1;
}
