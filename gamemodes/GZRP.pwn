#include <YSI_Coding\y_hooks>
#define RP_NOTE_SLOTS (3)
new PlayerText:RP_NoteTD[MAX_PLAYERS][RP_NOTE_SLOTS];
new RP_NoteTimer[MAX_PLAYERS][RP_NOTE_SLOTS];
new RP_NoteGeneration[MAX_PLAYERS][RP_NOTE_SLOTS];
stock RP_ClearNote(playerid, slot) {
    if(RP_NoteTimer[playerid][slot]) KillTimer(RP_NoteTimer[playerid][slot]);
    RP_NoteTimer[playerid][slot] = 0;
    RP_NoteGeneration[playerid][slot]++;
    if(RP_NoteTD[playerid][slot] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, RP_NoteTD[playerid][slot]);
    RP_NoteTD[playerid][slot] = PlayerText:INVALID_TEXT_DRAW;
    return 1;
}
forward RP_HideNote(playerid, slot, generation);
public RP_HideNote(playerid, slot, generation) {
    if(slot < 0 || slot >= RP_NOTE_SLOTS || generation != RP_NoteGeneration[playerid][slot]) return 0;
    return RP_ClearNote(playerid, slot);
}
stock SendNotification(playerid, const reason[], seconds = 7) {
    if(!IsPlayerConnected(playerid) || IsPlayerNPC(playerid)) return 0;
    new slot = -1;
    for(new i; i < RP_NOTE_SLOTS; i++) if(RP_NoteTD[playerid][i] == PlayerText:INVALID_TEXT_DRAW) {slot = i; break;}
    if(slot == -1) slot = 0;
    RP_ClearNote(playerid, slot);
    RP_NoteTD[playerid][slot] = CreatePlayerTextDraw(playerid, 480.0, 130.0 + slot * 58.0, reason);
    PlayerTextDrawFont(playerid, RP_NoteTD[playerid][slot], 1);
    PlayerTextDrawLetterSize(playerid, RP_NoteTD[playerid][slot], 0.20, 1.0);
    PlayerTextDrawTextSize(playerid, RP_NoteTD[playerid][slot], 625.0, 0.0);
    PlayerTextDrawSetOutline(playerid, RP_NoteTD[playerid][slot], 1);
    PlayerTextDrawColor(playerid, RP_NoteTD[playerid][slot], 0xFFFFFFFF);
    PlayerTextDrawBoxColor(playerid, RP_NoteTD[playerid][slot], 0x000000BB);
    PlayerTextDrawUseBox(playerid, RP_NoteTD[playerid][slot], 1);
    PlayerTextDrawShow(playerid, RP_NoteTD[playerid][slot]);
    if(seconds < 1) seconds = 1;
    RP_NoteTimer[playerid][slot] = SetTimerEx("RP_HideNote", seconds * 1000, false, "iii", playerid, slot, RP_NoteGeneration[playerid][slot]);
    return 1;
}
hook OnGameModeInit() {
    for(new p; p < MAX_PLAYERS; p++) for(new s; s < RP_NOTE_SLOTS; s++) RP_NoteTD[p][s] = PlayerText:INVALID_TEXT_DRAW;
    return 1;
}
hook OnPlayerDisconnect(playerid, reason) {
    for(new s; s < RP_NOTE_SLOTS; s++) RP_ClearNote(playerid, s);
    return 1;
}
// ===== FIN SISTEMA INTEGRADO: notificaciones_restaurado.p =====

