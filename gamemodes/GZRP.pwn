                    }
                    default: MostrarDialogoEvento(playerid);
                }
            }
        }
        case DIALOG_VENDER_ARMA: {
            if (!response) return 1;
            new precioarma;
            if (!sscanf(inputtext, "d", precioarma)) {
                ArmaVender[playerid] = GetPlayerWeapon(playerid);
                PrecioArma[playerid] = precioarma;
                new noti2[120];
                format(noti2, sizeof(noti2), "~w~Vas a vender un ~r~%s ~w~en ~g~$%d", GetWeaponNameEx(ArmaVender[playerid]), PrecioArma[playerid]);
                PUSH(playerid, noti2);
                VenderArma(playerid);
            }
            return 1;
        }
        case DIALOG_VENDER_ARMA_1: {
            if (!response) return 1;
            new playerj;
            if (!sscanf(inputtext, "d", playerj)) {
                if (playerj == playerid) return Notificador2(playerid, "No venderte a ti mismo.");
                if (!EstaEnP(playerid, playerj, 400)) return Notificador2(playerid, "~r~Debes estar a 400 metros de la persona para venderle.");
                if (IsPlayerNPC(playerj) || !IsPlayerConnected(playerj)) return Notificador2(playerid, "El jugador no esta conectado.");
                new _dialog[200];
                CompradorArma[playerid] = playerj;
                PrecioArma[playerj] = PrecioArma[playerid];
                if (PLAYER_INFO[playerj][jDinero] < PrecioArma[playerid]) return Notificador2(playerid, "El jugador no tiene el dinero suficiente.");
                format(_dialog, sizeof _dialog, "{FFFFFF}El jugador {ffff00}%s {FFFFFF}te esta vendiendo un %s en $%d", PLAYER_INFO[playerid][Nickname], PrecioArma[playerid]);
                dialogs_ShowPlayerDialog(playerj, DIALOG_VENDER_ARMA_2, DIALOG_STYLE_MSGBOX, "¿Aceptas la oferta?", _dialog, "Aceptar", "Rechazar");
            }
            return 1;
        }
        case DIALOG_VENDER_ARMA_2: {
