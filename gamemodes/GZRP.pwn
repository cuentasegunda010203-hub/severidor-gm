                dialogs_ShowPlayerDialog(playerid, REGLAS4, DIALOG_STYLE_MSGBOX, " Reglas del juego", string2, "Aceptar", "");
            }
        }
        case COMPRARLICENCIA: {
            if (response) {
                if (PLAYER_INFO[playerid][Totems] < 30) return SendClientMessage(playerid, -1, "Necesitas 30 Totems para comprar la licencia.");
                new dia, mes, ano, Query2[200];
                getdate(ano, mes, dia);
                PLAYER_INFO[playerid][Totems] -= 30;
                switch (PLAYER_INFO[playerid][pLicencia]) {
                    case 0: {
                        PLAYER_INFO[playerid][pLicencia] = 1;
                        PLAYER_INFO[playerid][finlicencia] = gettime() + 5184000;
                    }
                    default: {
                        new texto[128], mensaje[128];
                        new result = PLAYER_INFO[playerid][finlicencia] - gettime();
                        if (result < 60) format(texto, sizeof(texto), "%ds", result % (60));
                        else if (result < 3600) format(texto, sizeof(texto), "%dm %ds", result / 60 % (60), result % (60));
                        else if (result < 86400) format(texto, sizeof(texto), "23h 59m 20s", result / 3600 / 60, result / 60 % (60), result % (60));
                        else format(texto, sizeof(texto), "%dd %dh %dm %ds", result / 86400, result / 3600 / 60, result / 60 % (60), result % (60));
                        format(mensaje, sizeof(mensaje), "Ya tienes una licencia de piloto, espera {00CC00}%s{FFFFFF} para conseguir otra.", texto);
                        SendClientMessage(playerid, -1, mensaje);
                        return 1;
                    }
                }
                mysql_format(handle_db, Query2, sizeof(Query2), "UPDATE `usuarios` SET `FinLicencia`='%d' WHERE `Username`='%e'", PLAYER_INFO[playerid][finlicencia], PLAYER_INFO[playerid][Nickname]);
                mysql_tquery(handle_db, Query2);
                SendClientMessage(playerid, -1, "{00CC00}Adquiriste una licencia de piloto valida por 2 meses.");
            }
        }
