public OnPlayerPickUpPickup(playerid, pickupid) {
    if (pickupid == pickupCarreras) {
        if (EnCarreras[playerid] > 0) {
            SetVehicleHealth(GetPlayerVehicleID(playerid), 1000);
        }
    }
    for(new i = 0; i < 6; i++) {
        if (pickupid == RopaIcono[i] && PickupRopa[playerid] == 0) {
            ComprarEnTiendaRopa(playerid);
            SendClientMessage(playerid, -1, "====================================================================================");
            SendClientMessage(playerid, -1, "Para comprar ropa de este local, ingresa a {"        COLOR_GM "}http://"WEB_ROL "{FFFFFF} e inicia sesion.");
            SendClientMessage(playerid, -1, "En caso de ya tener el codigo de compra, escribe {"        COLOR_GM "}/comprar CODIGO{FFFFFF} Por ej: {"        COLOR_GM "}/comprar AOFE 289");
            SendClientMessage(playerid, -1, "====================================================================================");
            PickupRopa[playerid] = 60;
        }
    }
    return 1;
}
public OnPlayerHealthChange(playerid, Float:newhealth, Float:oldheatlh) {
    if (IsPlayerNPC(playerid)) return true;
    if (PLAYER_INFO[playerid][@Salud] < newhealth) {

        if (TiempoVida[playerid] < gettime()) {

            new string[128];
            format(string, sizeof(string), "El jugador {FF3300}%s(ID: %d){FFFFFF} fue baneado por el anticheat. Razon: {FF3300}Cheat de vida.", PLAYER_INFO[playerid][Nickname], playerid);
            foreach(new i : Player) {

                if (IsPlayerConnected(i) && PLAYER_INFO[i][pMuteos] == 1) SendClientMessage(i, -1, string);
            }
            ExpulsarJugador(playerid, "Cheat de vida");
        }
    }
    PLAYER_INFO[playerid][@Salud] = newhealth;
    return true;
}

public OnPlayerArmourChange(playerid, Float:newhealth, Float:oldheatlh) {
    if (IsPlayerNPC(playerid)) return true;
    if (PLAYER_INFO[playerid][@Chaleco] < newhealth) {

        if (TiempoChaleco[playerid] < gettime()) {

            new string[128];
            format(string, sizeof(string), "El jugador {FF3300}%s(ID: %d){FFFFFF} fue baneado por el anticheat. Razon: {FF3300}Cheat de blindaje.", PLAYER_INFO[playerid][Nickname], playerid);
            foreach(new i : Player) {

                if (IsPlayerConnected(i) && PLAYER_INFO[i][pMuteos] == 1) SendClientMessage(i, -1, string);
            }
            ExpulsarJugador(playerid, "Cheat de blindaje");
        }
    }
    PLAYER_INFO[playerid][@Chaleco] = oldheatlh;
    return true;
}
public OnPlayerClickPlayer(playerid, clickedplayerid, source) {
    if (source == CLICK_SOURCE_SCOREBOARD) {
        MostrarPingPlayer(clickedplayerid, playerid);
    }
    return 1;
}
public OnPlayerClickPlayerTextDraw(playerid, PlayerText:playertextid) {
    if(NX_Click(playerid,playertextid)) return 1;
    if(EX_Click(playerid,playertextid)) return 1;
    if (RP_EcoClick(playerid, playertextid)) return 1;
    if (RP_BuyClick(playerid, playertextid)) return 1;
    if (RP_IAMenuClick(playerid, playertextid)) return 1;
    if (RP_StatsClick(playerid, playertextid)) return 1;
    if (RP_InvClick(playerid, playertextid)) return 1;
    if (RP_LGClick(playerid, playertextid)) return 1;
    if (RP_PhoneClick(playerid, playertextid)) return 1;
    if (JugadorLogeado[playerid] == 1 && PLAYER_TEMP[playerid][ViendoMenu] == 1) {
        for(new i; i < 50; i++) {
            if (playertextid == menuPlayerTextDraws[playerid][i]) {
                new menuid[32] = "menu_";
                strcat(menuid, playerMenu[playerid][E_PLAYER_MENU_ID]);
                playerMenu[playerid][E_PLAYER_MENU_LISTITEM] = i - 7;
                playerMenu[playerid][E_PLAYER_MENU_PAGE] = 0;
                CallLocalFunction(menuid, "iii", playerid, MENU_RESPONSE_SELECT, (playerMenu[playerid][E_PLAYER_MENU_LISTITEM] + (playerMenu[playerid][E_PLAYER_MENU_PAGE] * MENU_MAX_LISTITEMS_PERPAGE)));
            }
        }
    }
    //PESCAR
    if (playertextid == Pescar[playerid][0]) {
        if (LanzarArponID[playerid] != 1) {
            SendClientMessage(playerid, -1, "Fallaste al lanzar el arpon, intenta nuevamente.");
            HideSelector(playerid);
            CancelSelectTextDraw(playerid);
            return 1;
        }
        LanzarArponPesca(playerid);
    }
    if (playertextid == Pescar[playerid][1]) {
        if (LanzarArponID[playerid] != 2) {
            SendClientMessage(playerid, -1, "Fallaste al lanzar el arpon, intenta nuevamente.");
            HideSelector(playerid);
            CancelSelectTextDraw(playerid);
            return 1;
        }
        LanzarArponPesca(playerid);
    }
    if (playertextid == Pescar[playerid][2]) {
        if (LanzarArponID[playerid] != 3) {
            SendClientMessage(playerid, -1, "Fallaste al lanzar el arpon, intenta nuevamente.");
            HideSelector(playerid);
            CancelSelectTextDraw(playerid);
            return 1;
        }
        LanzarArponPesca(playerid);
    }
    if (playertextid == Pescar[playerid][3]) {
        if (LanzarArponID[playerid] != 4) {
            SendClientMessage(playerid, -1, "Fallaste al lanzar el arpon, intenta nuevamente.");
            HideSelector(playerid);
            CancelSelectTextDraw(playerid);
            return 1;
        }
        LanzarArponPesca(playerid);
    }
    //ROBAR CASAS
    if (playertextid == RoboCasas[playerid][0]) {

        if (ForzarCerraduraID[playerid] == 1) ForzarCerraduraPosiciones(playerid);
        else HideSelector(playerid);
    }
    if (playertextid == RoboCasas[playerid][1]) {

        if (ForzarCerraduraID[playerid] == 2) ForzarCerraduraPosiciones(playerid);
        else HideSelector(playerid);
    }
    if (playertextid == RoboCasas[playerid][2]) {

        if (ForzarCerraduraID[playerid] == 3) ForzarCerraduraPosiciones(playerid);
        else HideSelector(playerid);
    }
    if (playertextid == RoboCasas[playerid][3]) {

        if (ForzarCerraduraID[playerid] == 4) ForzarCerraduraPosiciones(playerid);
        else HideSelector(playerid);
    }
	// Inventario: acciones integradas directamente en GZRP.pwn
	if(playertextid == INVENTARIO_CONSUMIR_CRACK[playerid])
 	{	
	        if(PLAYER_INFO[playerid][pCrack] <= 0) return PUSH(playerid, "No tienes gramos de crack.");
			if(EnCombate[playerid] == 1) return PUSH(playerid,"No puedes consumir estando en combate.");
			if(PLAYER_TIMES[playerid][TiempoCrack] == 0)
			{
				new Float:resta,Float:Chaleco;
				GetPlayerArmour(playerid, Chaleco);
				resta = 100-Chaleco;
				if(resta >= 10)	EstablecerChaleco(playerid, Chaleco+10.0);
				else if(resta < 10)	EstablecerChaleco(playerid, Chaleco+resta);
				PLAYER_INFO[playerid][pCrack]--;
				PLAYER_TIMES[playerid][TiempoCrack] = 30;
				LoopingAnim(playerid, "FOOD", "EAT_Burger", 3.00, 0, 0, 0, 0, 0);
				AccionesRol(playerid,"consume un poco de crack.", 20);
				PLAYER_TIMES[playerid][Consumible] = 30;
				RevisarLogro(playerid,4);
			}
			else
			{
				new string[256];
				format(string,256,"Por favor espera {FF3300}%d{FFFFFF} segundos para volver a consumir crack.",PLAYER_TIMES[playerid][TiempoCrack]);
				SendClientMessage(playerid, -1, string);
			}
    }
    if(playertextid == INVENTARIO_CONSUMIR_MEDI[playerid])
 	{	
	        if(PLAYER_INFO[playerid][pRemedios] < 1) return PUSH(playerid, "Ya no te quedan medicamentos.");
			if(EnCombate[playerid] == 1) return PUSH(playerid,"No puedes consumir estando en combate.");
			if(PLAYER_TIMES[playerid][TiempoMedicamentos] == 0)
			{
				new Float:resta2,Float:Vida;
				GetPlayerHealth(playerid, Vida);
				resta2 = 100-Vida;
				if(resta2 >= 10) EstablecerVida(playerid, Vida+10.0);
				else if(resta2 < 10) EstablecerVida(playerid, Vida+resta2);
				PLAYER_INFO[playerid][pRemedios]--;
    			PLAYER_TIMES[playerid][TiempoMedicamentos] =  30;
				LoopingAnim(playerid, "FOOD", "EAT_Burger", 3.00, 0, 0, 0, 0, 0);
				AccionesRol(playerid,"consume un medicamento.", 20);
				PLAYER_TIMES[playerid][Consumible] = 30;
				RevisarLogro(playerid,3);
			}
			else
			{
				new string[256];
				format(string,256,"Por favor espera {FF3300}%d{FFFFFF} segundos para volver a consumir medicamentos.",PLAYER_TIMES[playerid][TiempoMedicamentos]);
				SendClientMessage(playerid, -1, string);
			}
    }
    if(playertextid == INVENTARIO_CONSUMIR_PORRO[playerid])
 	{	
				if(PLAYER_TIMES[playerid][TiempoMarihuana] == 0)
				{
					if(EnCombate[playerid] == 1) return SendClientMessage(playerid,-1,"No puedes armar un porro estando en combate");
					if(PLAYER_INFO[playerid][pMarihuana] <= 0) return SendClientMessage(playerid, -1, "Necesitas almenos 1g de marihuana para arma un porro");
					if(TienePorro[playerid] > 0) return SendClientMessage(playerid, COLOR_WHITE, "Ya tienes un porro en la mano.");
					SetPlayerAttachedObject(playerid, 4 , 3044, 6, 0.020000, 0.114999, 0.065999, 0.000000, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000);
					TienePorro[playerid] = 5;
					PLAYER_TIMES[playerid][TiempoMarihuana] = 30;
					PLAYER_INFO[playerid][pMarihuana] -= 1;
					AccionesRol(playerid,"arma un porro.", 20);
					SendClientMessage(playerid, -1, "Pulsa {DBED16}'Y'{FFFFFF} para fumar el porro.");
					RevisarLogro(playerid,6);
				}
				else
				{
					new string[128];
					format(string,128,"Por favor espera {FF3300}%d{FFFFFF} segundos para volver a armar un porro.",PLAYER_TIMES[playerid][TiempoMarihuana]);
					SendClientMessage(playerid, -1, string);
				}
    }
    if(playertextid == INVENTARIO_FUNTION_CHALECO[playerid])
 	{	
		if(Muriendo[playerid] != 0) return Notificador2(playerid, "~r~~h~~h~No puedes usar la mochila ahora mismo");
		if(PLAYER_INFO[playerid][pFaccion] > 3) if(EnCombate[playerid] == 1) return SendClientMessage(playerid,-1,"No puedes usar la mochila mientras andas en {FF3300}combate.");
		if(!BackPack[playerid][bDBID]) return SendClientMessage(playerid, -1, "Tu mochila está rota, compra una nueva.");
		if(PLAYER_INFO[playerid][Agonizando] != 0 && Esposando[playerid] != 0) return Notificador2(playerid, "~r~No puedes  hacer esto ahora");
		if(PLAYER_TEMP[playerid][VariableCaido] != 0) return Notificador2(playerid, "~r~No puedes  hacer esto ahora");
		if(JugandoEventoDinamico[playerid] == true) return Notificador2(playerid, "No puedes usar la mochila en estos momentos");
		if(PLAYER_INFO[playerid][pFaccion] == 0 || PLAYER_INFO[playerid][pFaccion] > 3) if(PLAYER_INFO[playerid][varzonasegura] == 1) return Notificador2(playerid, "No puedes usar la mochila en zona segura.");
		if(PLAYER_TEMP[playerid][pt_PLAYER_EVENTODM] == 1)return  SendClientMessage(playerid,-1,"No puedes usar en este momento tu mochila.");
		if(PLAYER_INFO[playerid][pTiempoCarcel] > 0 || PLAYER_INFO[playerid][pTiempoJail] > 0) return SendClientMessage(playerid,-1,"No puedes usar la mochila en estos momento.");
		if(PLAYER_TEMP[playerid][restriccion_mochila] > 0) return SendClientMessageEx(playerid, -1, "Espera {00ff00}%d{ffffff} segundos para usar la mochila.", PLAYER_TEMP[playerid][restriccion_mochila]);
		if(PLAYER_INFO[playerid][pFaccion] == 0)
		{
			foreach(new c : Player)
			{
				if(PLAYER_INFO[c][pFaccion] == 1 && PLAYER_INFO[c][pDuty] == 1 && EstaEnP(playerid,c,20.00)) return	SendClientMessage(playerid,-1,"No puedes hacer esto si hay un policia cerca.");
				if(PLAYER_INFO[c][pFaccion] == 2 && PLAYER_INFO[c][pDuty] == 1 && EstaEnP(playerid,c,20.00)) return	SendClientMessage(playerid,-1,"No puedes hacer esto si hay un policia cerca.");
			}
		}
		if(PLAYER_INFO[playerid][pFaccion] > 3)
		{
			foreach(new c : Player)
			{
				if(PLAYER_INFO[c][pFaccion] == 1 && PLAYER_INFO[c][pDuty] == 1 && EstaEnP(playerid,c,20.00)) return	SendClientMessage(playerid,-1,"No puedes hacer esto si hay un policia cerca.");
				if(PLAYER_INFO[c][pFaccion] == 2 && PLAYER_INFO[c][pDuty] == 1 && EstaEnP(playerid,c,20.00)) return	SendClientMessage(playerid,-1,"No puedes hacer esto si hay un policia cerca.");
			}
		}
		for(new i = 0; i < MAX_PLAYER_TOYS; i ++)
		{
			if(PLAYER_TOYS[playerid][i][pt_ATTACHED])
			{
				if(PLAYER_TOYS[playerid][i][pt_MODEL_ID] == 3026 || PLAYER_TOYS[playerid][i][pt_MODEL_ID] == 19559)
				{
					return PlayerBackPackShow(playerid);
				}
			}
		}
		SendClientMessage(playerid, -1, "Necesitas tener una mochila puesta para usarla.");
    }
    if(playertextid == INVENTARIO_FUNCION_BOTIQUIN[playerid])
 	{	
 		PUSH(playerid, "SISTEMA BOTIQUIN ~r~NO DISPONIBLE~w~ PROXIMA ACTUALIZACION.");
    }
    if(playertextid == INVENTARIO_CLICK_HABILIDADES[playerid])
 	{	
 		Habilidad(playerid,playerid);
    }
    if(playertextid == INVENTARIO_CLICK_ESTADISTICAS[playerid])
 	{	
 		UpdateEstadisticas(playerid);
		AbrirEstadisticas(playerid);
    }
    if(playertextid == INVENTARIO_CLICK_CONFIG[playerid])
 	{	
 		ShowConfig(playerid);
    }
    if(playertextid == INVENTARIO_CLICK_CASA1[playerid])
 	{	
		dialogs_ShowPlayerDialog(playerid, DIALOG_INV_CASAS, DIALOG_STYLE_LIST, "Inmobiliaria de San Andreas", "Localizar propiedad\nMás opciones", ">>", "Cancelar");
		CasaSeleccionada_INV[playerid] = 1;
		Menu_CerrarInventario(playerid);
		CancelSelectTextDraw(playerid);
    }
    if(playertextid == INVENTARIO_CLICK_CASA2[playerid])
 	{	
		dialogs_ShowPlayerDialog(playerid, DIALOG_INV_CASAS, DIALOG_STYLE_LIST, "Inmobiliaria de San Andreas", "Localizar propiedad\nMás opciones", ">>", "Cancelar");
		CasaSeleccionada_INV[playerid] = 2;
		Menu_CerrarInventario(playerid);
		CancelSelectTextDraw(playerid);
    }
    if(playertextid == INVENTARIO_CLICK_CASA3[playerid])
 	{	
		dialogs_ShowPlayerDialog(playerid, DIALOG_INV_CASAS, DIALOG_STYLE_LIST, "Inmobiliaria de San Andreas", "Localizar propiedad\nMás opciones", ">>", "Cancelar");
		CasaSeleccionada_INV[playerid] = 3;
		Menu_CerrarInventario(playerid);
		CancelSelectTextDraw(playerid);
    }
    if(playertextid == INVENTARIO_CLICK_AUTO1[playerid])
 	{	
 			dialogs_ShowPlayerDialog(playerid, DIALOG_INV_AUTOS, DIALOG_STYLE_LIST, "Funciones de tu vehiculo", "Buscar Auto\nMás opciones", ">>", "Cancelar");
			AutoSeleccionado[playerid] = 1;
			Menu_CerrarInventario(playerid);
			CancelSelectTextDraw(playerid);
    }
    if(playertextid == INVENTARIO_CLICK_AUTO2[playerid])
 	{	
 			dialogs_ShowPlayerDialog(playerid, DIALOG_INV_AUTOS, DIALOG_STYLE_LIST, "Funciones de tu vehiculo", "Buscar Auto\nMás opciones", ">>", "Cancelar");
			AutoSeleccionado[playerid] = 2;
			Menu_CerrarInventario(playerid);
			CancelSelectTextDraw(playerid);			
    }
    if(playertextid == INVENTARIO_CLICK_AUTO3[playerid])
 	{	
			dialogs_ShowPlayerDialog(playerid, DIALOG_INV_AUTOS, DIALOG_STYLE_LIST, "Funciones de tu vehiculo", "Buscar Auto\nMás opciones", ">>", "Cancelar");
			AutoSeleccionado[playerid] = 3;
			Menu_CerrarInventario(playerid);
			CancelSelectTextDraw(playerid);	
    }
    if(playertextid == INVENTARIO_CLICK_AUTO4[playerid])
 	{	
			dialogs_ShowPlayerDialog(playerid, DIALOG_INV_AUTOS, DIALOG_STYLE_LIST, "Funciones de tu vehiculo", "Buscar Auto\nMás opciones", ">>", "Cancelar");
			AutoSeleccionado[playerid] = 4;
			Menu_CerrarInventario(playerid);
			CancelSelectTextDraw(playerid);	
    }
    if(playertextid == INVENTARIO_CLICK_AUTO5[playerid])
 	{	
			dialogs_ShowPlayerDialog(playerid, DIALOG_INV_AUTOS, DIALOG_STYLE_LIST, "Funciones de tu vehiculo", "Buscar Auto\nMás opciones", ">>", "Cancelar");
			AutoSeleccionado[playerid] = 5;
			Menu_CerrarInventario(playerid);
			CancelSelectTextDraw(playerid);	
    }
    if(playertextid == INVENTARIO_ARMA_1[playerid])
    {
        RP_InventarioArmaDialog(playerid, 1);
        Menu_CerrarInventario(playerid);
        CancelSelectTextDraw(playerid);
        return 1;
    }
    if(playertextid == INVENTARIO_ARMA_2[playerid])
    {
        RP_InventarioArmaDialog(playerid, 2);
        Menu_CerrarInventario(playerid);
        CancelSelectTextDraw(playerid);
        return 1;
    }
    if(playertextid == INVENTARIO_ARMA_3[playerid])
    {
        RP_InventarioArmaDialog(playerid, 3);
        Menu_CerrarInventario(playerid);
        CancelSelectTextDraw(playerid);
        return 1;
    }
    if(playertextid == INVENTARIO_ARMA_4[playerid])
    {
        RP_InventarioArmaDialog(playerid, 4);
        Menu_CerrarInventario(playerid);
        CancelSelectTextDraw(playerid);
        return 1;
    }
    if(playertextid == INVENTARIO_ARMA_5[playerid])
    {
        RP_InventarioArmaDialog(playerid, 5);
        Menu_CerrarInventario(playerid);
        CancelSelectTextDraw(playerid);
        return 1;
    }
    if(playertextid == INVENTARIO_ARMA_6[playerid])
    {
        RP_InventarioArmaDialog(playerid, 6);
        Menu_CerrarInventario(playerid);
        CancelSelectTextDraw(playerid);
        return 1;
    }
	return 0;
}
public OnPlayerInteriorChange(playerid, newinteriorid, oldinteriorid) {
    if (newinteriorid != oldinteriorid && JugadorLogeado[playerid] == 1 && !IsPlayerNPC(playerid)) {
        RP_ShowInteriorLoading(playerid);
        if (!RP_MapLoadTimer[playerid]) CargarMapeosEx(playerid);
    }
    foreach(new i : Player) {
        if (IsPlayerConnected(i) && !IsPlayerNPC(i) && SpecJugador[i] == playerid) {
            SetPlayerInterior(i, newinteriorid);
            SetPlayerVirtualWorld(i, GetPlayerVirtualWorld(playerid));
        }
    }
    return 1;
}
public OnPlayerClickTextDraw(playerid, Text:clickedid) {
    if(_:clickedid==INVALID_TEXT_DRAW && NX_Escape(playerid)) return 1;
    if(_:clickedid==INVALID_TEXT_DRAW && EX_Escape(playerid)) return 1;
    if (_:clickedid == INVALID_TEXT_DRAW && RP_EcoEscape(playerid)) return 1;
    if (_:clickedid == INVALID_TEXT_DRAW && RP_BuyEscape(playerid)) return 1;
    if (_:clickedid == INVALID_TEXT_DRAW && RP_IAMenuCancel(playerid)) return 1;
    if (_:clickedid == INVALID_TEXT_DRAW && RP_StatsCancel(playerid)) return 1;
    if (_:clickedid == INVALID_TEXT_DRAW) {
        if (RP_PhoneClose(playerid)) return 1;
        switch (SelecTextDraw[playerid]) {
            case TD_INVENTARIO: {
                if (JugadorLogeado[playerid] == 1) {
                    Menu_CerrarInventario(playerid);
                    CancelSelectTextDraw(playerid);
                }
            }
        }
        if (JugadorLogeado[playerid] != 0) {
            if (EnGaraje[playerid]) {
                CancelPlayerTuningShop(playerid);
                ShowTuning(playerid, DIALOG_VOBJECT_MENU);
            }
            if (FaseDepa[playerid] > 0) {
                OcultarCartelCD(playerid);
            }
        }
        return 1;
    }
    if (clickedid == FondoInv[4]) return SendClientMessage(playerid, -1, "Escribe {DBED15}/vender {FFFFFF}["SERVER_COIN "] [ID] [Cantidad] [Precio]");

    if (clickedid == IntroDepa[7]) {
        dialogs_ShowPlayerDialog(playerid, D_RECEPDEPA2, DIALOG_STYLE_MSGBOX, "{37db3f}Comprar departamento",
            "{FFFFFF}\
			¿Deseas comprar el departamento por {00CC00}100 Totems{FFFFFF}?\n\
			", "Comprar", "Cerrar");
        return 1;
    }
    if (clickedid == MapaInv) {
        new string[384];
        format(string, sizeof(string), "Concesionarias\nBancos\n24/7\nTrabajos\nEdificios del gobierno\nTiendas de ropa\n{366397}Mercado Negro\nTalleres\nVer mapa\n{FFFFFF}Puerto del Ferry\nTorre VillaSuite\nEstaciones de Servicio\nPaintBall Games\nTienda Exclusiva\nBase de Bomberos");
        return dialogs_ShowPlayerDialog(playerid, GPS, DIALOG_STYLE_LIST, "GPS", string, "Siguiente", "Cancelar"), CerrarInventario(playerid);
    }

    if (clickedid == FondoInv[8]) return Inventario(playerid, playerid), CerrarInventario(playerid);
    if (EnGaraje[playerid]) {
        if (clickedid == Textdraws[textdraw_SHOP_TUNING][2]) //Comprar
        {
            new slot = GetVehicleFreeObjectSlot(TuneandoCoche[playerid]);
            if (PLAYER_INFO[playerid][pVip] == 0 && slot >= 3) {
                PlayerPlaySound(playerid, 1085, 0.0, 0.0, 0.0);
                SendClientMessage(playerid, -1, "{FFFFFF}Los jugadores sin VIP pueden tener hasta 3 objetos en vehiculos.");
                return 1;
            }
            if (PLAYER_INFO[playerid][pVip] == 1 && slot >= 5) {
                PlayerPlaySound(playerid, 1085, 0.0, 0.0, 0.0);
                SendClientMessage(playerid, -1, "{FFFFFF}Los jugadores VIP1 pueden tener hasta 5 objetos en vehiculos.");
                return 1;
            }
            if (PLAYER_INFO[playerid][pVip] == 2 && slot >= 7) {
                PlayerPlaySound(playerid, 1085, 0.0, 0.0, 0.0);
                SendClientMessage(playerid, -1, "{FFFFFF}Los jugadores VIP2 pueden tener hasta 7 objetos en vehiculos.");
                return 1;
            }
            if (PLAYER_INFO[playerid][pVip] == 3 && slot >= 10) {
                PlayerPlaySound(playerid, 1085, 0.0, 0.0, 0.0);
                SendClientMessage(playerid, -1, "{FFFFFF}Los jugadores GVIP pueden tener hasta 10 objetos en vehiculos.");
                return 1;
            }
            if (slot == -1) {
                SendClientMessage(playerid, -1, "{FFFFFF}No hay mas espacio para objetos en este vehiculo.");
                ShowTuning(playerid, DIALOG_VOBJECT_OBJECT);
                return 1;
            }
            if (PLAYER_INFO[playerid][jDinero] < Tuning_Shop_Objects[ObjetoTuning[playerid]][tuning_object_PRICE]) return SendClientMessage(playerid, -1, "No tienes el dinero suficiente ($2000)");
            QuitarDinero(playerid, Tuning_Shop_Objects[ObjetoTuning[playerid]][tuning_object_PRICE]);
            VEHICLE_OBJECTS[TuneandoCoche[playerid]][slot][vobject_VALID] = true;
            VEHICLE_OBJECTS[TuneandoCoche[playerid]][slot][vobject_TYPE] = VOBJECT_TYPE_OBJECT;
            VEHICLE_OBJECTS[TuneandoCoche[playerid]][slot][vobject_ID] = 0;
            VEHICLE_OBJECTS[TuneandoCoche[playerid]][slot][vobject_MODELID] = Tuning_Shop_Objects[ObjetoTuning[playerid]][tuning_object_MODELID];
            format(VEHICLE_OBJECTS[TuneandoCoche[playerid]][slot][vobject_NAME], 32, "%s", Tuning_Shop_Objects[ObjetoTuning[playerid]][tuning_object_NAME]);
            VEHICLE_OBJECTS[TuneandoCoche[playerid]][slot][vobject_ATTACHED] = true;
            UpdateVehicleAttachedObject(TuneandoCoche[playerid], slot);
            RegisterNewVehicleObject(playerid, TuneandoCoche[playerid], slot);
            CancelPlayerTuningShop(playerid);
            SendClientMessage(playerid, -1, "{FFFFFF}Ajusta el objeto y haz clic en el icono de guardar, si pulsas {009AFF}'ESCAPE' {FFFFFF}no se guardaro la configuracion.");
            SendClientMessage(playerid, -1, "{FFFFFF}Manten presionado {009AFF}'W' {FFFFFF}para mover la camara.");
            EditVehicleObject(playerid, TuneandoCoche[playerid], slot);
            return 1;
        } else if (clickedid == Textdraws[textdraw_SHOP_TUNING][3]) //Siguiente
        {
            if (ObjetoTuning[playerid] == (sizeof(Tuning_Shop_Objects) - 1)) ObjetoTuning[playerid] = 0;
            else ObjetoTuning[playerid]++;
            UpdateTuningShop(playerid);
            return 1;
        } else if (clickedid == Textdraws[textdraw_SHOP_TUNING][4]) //Anterior
        {
            if (ObjetoTuning[playerid] == 0) ObjetoTuning[playerid] = sizeof(Tuning_Shop_Objects) - 1;
            else ObjetoTuning[playerid]--;
            UpdateTuningShop(playerid);
            return 1;
        }
        if (clickedid == PlayerBackGround[_button_close] || clickedid == EquisCerrar) {
            HideSelector(playerid);
            CancelSelectTextDraw(playerid);
        }
        CancelSelectTextDraw(playerid);
        return 1;
    } else {
        if (_Select_Status[playerid] > 0) {
            CancelSelectTextDraw(playerid);
            HideSelector(playerid);
        }
    }
    return 0;
}
public OnPlayerStateChange(playerid, newstate, oldstate) {
    if(IsPlayerNPC(playerid)) return 1; // Los NPC no pasan por el anticheat ni el HUD de jugadores.
    VelocimetroStateChange(playerid, newstate, oldstate);
	#if DEBUG_GM == 1
    printf("(OnPlayerStateChange) PlayerID: %d | NewState: %d | OldState: %d", playerid, newstate, oldstate);
	#endif
    if (newstate == PLAYER_STATE_DRIVER) {
        carEnterTime[playerid] = GetTickCount();
    } else if (oldstate == PLAYER_STATE_DRIVER) {
        if ((GetTickCount() - carEnterTime[playerid]) < 220) {
            if (EnAuto[playerid] != GetPlayerVehicleID(playerid)) {
                if (EnCarreras[playerid] == 0) {
                    if (PLAYER_TIMES[playerid][TiempoAntiAB] <= gettime()) {
                        new strings[144];
                        format(strings, sizeof strings, "%s(ID:%d) posible cheater, sube sin animacion a los vehículos (Nivel:%d - %dhs)", PLAYER_INFO[playerid][Nickname], playerid, PLAYER_INFO[playerid][@Nivel], PLAYER_INFO[playerid][horasjugadas]);
                        MensajeAdmin(0xDBED15FF, strings, ADMIN_LEVEL_BANEOS);
                        RespawnNearbyVehicles(playerid, 20);
                        //ExpulsarJugador(playerid,"Subir sin animacion a los vehículos");
                    }
                }
            }
        }
    }
    if (newstate == PLAYER_STATE_ENTER_VEHICLE_DRIVER || newstate == PLAYER_STATE_DRIVER || newstate == PLAYER_STATE_PASSENGER) {

        if (Objeto[playerid] > 0 /*|| PLAYER_TEMP[playerid][pt_TIENE_BARRIL] > 0)*/ ) {

            SendClientMessage(playerid, -1, "No puedes subir a un vehiculo con un objeto, usa {"        COLOR_GM "}/tirar objeto.");
            ClearAnimations(playerid);
            RemovePlayerFromVehicle(playerid);
        }
    }
    if (newstate == PLAYER_STATE_DRIVER || newstate == PLAYER_STATE_PASSENGER) {
        if (EmisoraEscuchando[GetPlayerVehicleID(playerid)] != -1) {
            new emisoraid;
            emisoraid = EmisoraEscuchando[GetPlayerVehicleID(playerid)];
            Ciclo(id, MAX_CONECTADOS) {
                if (Emisoras[id][CabinaOcupada] == emisoraid) {
                    if (Emisoras[id][TransEmisora] == 1) {
                        new stringa[128];
                        EmisoraEscuchando[emisoraid]++;
                        format(stringa, sizeof(stringa), "Escuchando radio ~y~%s~w~, para cambiar de emisora usa ~y~/emisoras", Emisoras[id][NombreEmisora]);
                        Notificador2(playerid, stringa);
                        format(stringa, sizeof(stringa), "http://"            WEB_RADIO ":8000/listen.pls?sid=%d", Emisoras[id][EmisoraID]);
                        PlayAudioStreamForPlayer(playerid, stringa);
                    }
                }
            }
        }
    }
    if (newstate == PLAYER_STATE_PASSENGER) {

        if (GetPlayerWeapon(playerid) != 30 && GetPlayerWeapon(playerid) != 31 && GetPlayerWeapon(playerid) != 29 && GetPlayerWeapon(playerid) != 22) {

            SetPlayerArmedWeapon(playerid, 0);
        }
        if (PLAYER_INFO[playerid][Agonizando] == 1 && PacienteAmbu[playerid] == 0) {
            RemovePlayerFromVehicle(playerid);
        }
        if (GetPlayerWeapon(playerid) == 0 || GetPlayerWeapon(playerid) == 29 || GetPlayerWeapon(playerid) == 25 || GetPlayerWeapon(playerid) == 31 || GetPlayerWeapon(playerid) == 30) return 1;
        else {
            if (PLAYER_INFO[playerid][j_ARMAS][GetWeaponSlot(25)] == 25 || PLAYER_INFO[playerid][j_ARMAS][GetWeaponSlot(29)] == 29 || PLAYER_INFO[playerid][j_ARMAS][GetWeaponSlot(30)] == 30 || PLAYER_INFO[playerid][j_ARMAS][GetWeaponSlot(31)] == 31) {
                DarArmas(playerid);
            } else {
                Manejando[playerid] = 1;
                SetPlayerArmedWeapon(playerid, 0);
            }
        }
    }
    if (newstate == PLAYER_STATE_DRIVER) {

        if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) {

            if (PLAYER_INFO[playerid][pDuty] == 0 && (SAPD(GetPlayerVehicleID(playerid)) || HELISAPD(GetPlayerVehicleID(playerid)))) {

                ExpulsarJugador(playerid, "Subirse a patrulla de conductor sin uniforme y sin faccion SAPD.");
            }
            if (PLAYER_INFO[playerid][pTrabajo] != T_Camionero && PLAYER_INFO[playerid][pTrabajo2] != T_Camionero && CAMION(GetPlayerVehicleID(playerid))) {

                ExpulsarJugador(playerid, "Subirse a camion de conductor sin trabajo.");
            }
            if (PLAYER_INFO[playerid][pTrabajo] != T_Taxista && PLAYER_INFO[playerid][pTrabajo2] != T_Taxista && TAXI(GetPlayerVehicleID(playerid))) {

                ExpulsarJugador(playerid, "Subirse a taxi de conductor sin trabajo.");
            }
        }
        SetPlayerArmedWeapon(playerid, 0);
        if (PLAYER_INFO[playerid][Agonizando] == 1 && PacienteAmbu[playerid] == 0) {
            RemovePlayerFromVehicle(playerid);
        }
    }
    if (newstate == PLAYER_STATE_DRIVER || newstate == PLAYER_STATE_PASSENGER) {

        if (Specteado[playerid] == 1) {

            foreach(new i : Player) {

                if (SpecJugador[i] == playerid) {

                    PlayerSpectateVehicle(i, GetPlayerVehicleID(playerid));
                }
            }
        }
    }
    if (newstate == PLAYER_STATE_ONFOOT) {
        SetPVarInt(playerid, "AC_Velocidad", 0);
        if (EsUnTren(GetPlayerVehicleID(playerid))) {
            Boletos[playerid] = 0;
        }
        foreach(new i : Player) {
            if (SpecJugador[i] == playerid) PlayerSpectatePlayer(i, playerid);
        }
    }
    if (newstate == PLAYER_STATE_ONFOOT) {

        if (Specteado[playerid] == 1) {

            foreach(new i : Player) {

                if (SpecJugador[i] == playerid) {

                    PlayerSpectatePlayer(i, playerid);
                }
            }
        }
    }
    if (newstate == PLAYER_STATE_DRIVER) {

        new vehicleid = GetPlayerVehicleID(playerid), color_1, color_2;
        if (CAMION(vehicleid)) {

            GetVehicleColor(vehicleid, color_1, color_2);
            if (PLAYER_INFO[playerid][pTrabajo] != T_Camionero && PLAYER_INFO[playerid][pTrabajo2] != T_Camionero) {

                SendClientMessage(playerid, -1, "Necesitas el empleo de camionero para usar este vehiculo.");
                SendClientMessage(playerid, -1, "Para aprender mas sobre los trabajos disponibles, escribe {"            COLOR_GM "}/ayuda trabajos{FFFFFF}.");
                SacarVehiculo(playerid);
            } else {

                if (PLAYER_INFO[playerid][pVip] == 0) {

                    if (color_1 == 0 && color_2 == 0) {
                        SendClientMessage(playerid, -1, "Este camion es solamente para jugadores con cuenta {"                    COLOR_GM "}VIP2{FFFFFF}.");
                        RemovePlayerFromVehicle(playerid);
                        EnAuto[playerid] = INVALID_PLAYER_ID;
                        return 1;
                    }
                }
                new string[256];
                switch (CamionCargado[vehicleid]) {

                    case 0 : format(string, sizeof(string), "Camion de carga numero: {00cc00}%d{FFFFFF} | Contenido: {00CC00}Ninguno {FFFFFF}| Chofer: {00cc00}Ninguno", vehicleid);
                    case 1 : format(string, sizeof(string), "Camion de carga numero: {00cc00}%d{FFFFFF} | Contenido: {00CC00}Productos 24/7{FFFFFF} {FFFFFF}| Chofer: {00CCFF}%s", vehicleid, PLAYER_INFO[Chofer[vehicleid]][Nickname]);
                    case 2 : format(string, sizeof(string), "Camion de carga numero: {00cc00}%d{FFFFFF} | Contenido: {00CC00}Ropa{FFFFFF} | Chofer: {00CCFF}%s", vehicleid, PLAYER_INFO[Chofer[vehicleid]][Nickname]);
                    case 3 : format(string, sizeof(string), "Camion de carga numero: {00cc00}%d{FFFFFF} | Contenido: {FF3300}Drogas{FFFFFF} | Chofer: {00CCFF}%s", vehicleid, PLAYER_INFO[Chofer[vehicleid]][Nickname]);
                    case 4:
                        format(string, sizeof(string), "Camion de carga numero: {00cc00}%d{FFFFFF} | Contenido: {FF3300}Armas{FFFFFF} | Chofer: {00CCFF}%s", vehicleid, PLAYER_INFO[Chofer[vehicleid]][Nickname]);
                        default: format(string, sizeof(string), "Camion de carga numero: {00cc00}%d{FFFFFF} | Contenido: {00CC00}Ninguno {FFFFFF}| Chofer: {00cc00}Ninguno", vehicleid);
                }
                SendClientMessage(playerid, -1, string);
                if (CamionCargado[vehicleid] == 0) SendClientMessage(playerid, -1, "Escribe {"            COLOR_GM "}/cargar camion{FFFFFF} para cargar el camion y {"            COLOR_GM "}/arrancar{FFFFFF} para encender el motor.");
            }
        }
    }
    if (newstate & PLAYER_STATE_DRIVER || newstate & PLAYER_STATE_PASSENGER) {

        // Alarma
        if (IsPlayerInAnyVehicle(playerid)) {

            new autoid = GetPlayerVehicleID(playerid);
            if (autos[playerid] == autoid || autos2[playerid] == autoid || autos3[playerid] == autoid || autos4[playerid] == autoid || autos5[playerid] == autoid) { SetTimerEx("ComprobarDanoMotor", 1000, 0, "d", playerid);
                DesactivarAlarma(autoid);
                SendClientMessage(playerid, -1, "Este vehiculo te pertenece."); } else {

                if (alarma[autoid] == 1 && alarmaon[autoid] == 0) {

                    GetVehicleParamsEx(autoid, engine, lights, alarm, doors, bonnet, boot, objective);
                    SetVehicleParamsEx(autoid, engine, lights, true, doors, bonnet, boot, objective);
                    SetTimerEx("DesactivarAlarma", minutos(1), false, "d", autoid);
                    TimerLuces[autoid] = SetTimerEx("TimerLucesIntermitentes", 500, false, "d", autoid);
                    alarma[autoid] = 1;
                }
            }
            PlayerAnticheat[playerid][@pWeapon] = GetPlayerWeapon(playerid);
            EnAuto[playerid] = GetPlayerVehicleID(playerid);
            if (bloqueado[GetPlayerVehicleID(playerid)] == 1 && PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) {

                VirtualWorldAutos[playerid] = GetPlayerVirtualWorld(playerid);
                SetPlayerVirtualWorld(playerid, 666);
                SetTimerEx("KickPlayerState", 5000, false, "d", playerid);
                TogglePlayerControllable(playerid, 0);
                SetPVarInt(playerid, "IsFrozen", 0);
            }
        }
    }
    if (newstate == PLAYER_STATE_DRIVER || newstate == PLAYER_STATE_PASSENGER) {

        if (TieneHerramientaEnMano[playerid] > 0) {

            switch (TieneHerramientaEnMano[playerid]) {

                case 1 : SendClientMessage(playerid, -1, "Tu martillo fue guardado en el inventario.");
                case 2 : SendClientMessage(playerid, -1, "Tu destornillador fue guardado en el inventario.");
                case 3 : SendClientMessage(playerid, -1, "Tu barreta fue guardado en el inventario.");
            }
            TieneHerramientaEnMano[playerid] = 0;
            RemovePlayerAttachedObject(playerid, 4);
        }
        new vehicleid = GetPlayerVehicleID(playerid);
        if (autos[playerid] == vehicleid) {

            GetVehicleParamsEx(autos[playerid], engine, lights, alarm, doors, bonnet, boot, objective);
            SetVehicleParamsEx(autos[playerid], engine, lights, 0, doors, bonnet, boot, objective);
        } else if (autos2[playerid] == vehicleid) {

            GetVehicleParamsEx(autos2[playerid], engine, lights, alarm, doors, bonnet, boot, objective);
            SetVehicleParamsEx(autos2[playerid], engine, lights, 0, doors, bonnet, boot, objective);
        } else if (autos3[playerid] == vehicleid) {

            GetVehicleParamsEx(autos3[playerid], engine, lights, alarm, doors, bonnet, boot, objective);
            SetVehicleParamsEx(autos3[playerid], engine, lights, 0, doors, bonnet, boot, objective);
        } else if (autos4[playerid] == vehicleid) {

            GetVehicleParamsEx(autos4[playerid], engine, lights, alarm, doors, bonnet, boot, objective);
            SetVehicleParamsEx(autos4[playerid], engine, lights, 0, doors, bonnet, boot, objective);
        } else if (autos5[playerid] == vehicleid) {

            GetVehicleParamsEx(autos5[playerid], engine, lights, alarm, doors, bonnet, boot, objective);
            SetVehicleParamsEx(autos5[playerid], engine, lights, 0, doors, bonnet, boot, objective);
        }
    }
    fVehSpeed[playerid] = 0.0;
    if (newstate == PLAYER_STATE_ONFOOT && oldstate == PLAYER_STATE_DRIVER) {

        EnAuto[playerid] = INVALID_VEHICLE_ID;
        if (EnCarreras[playerid] > 0 && EmpezoCarrera == 1) {

            NoTeleportHack(playerid);
            DisablePlayerRaceCheckpoint(playerid);
            SetPlayerPos(playerid, -1405.2959, -309.6738, 1052.0900);
            SetPlayerFacingAngle(playerid, 190.0000);
            TextDrawHideForPlayer(playerid, BoxCarrera[0]);
            TextDrawHideForPlayer(playerid, BoxCarrera[1]);
            TextDrawHideForPlayer(playerid, BoxCarrera[2]);
            TextDrawHideForPlayer(playerid, BoxCarrera[3]);
            PlayerTextDrawHide(playerid, CarreraPosicion[playerid]);
            PlayerTextDrawHide(playerid, CarreraT[playerid][0]);
            PlayerTextDrawHide(playerid, CarreraT[playerid][1]);
            PlayerTextDrawHide(playerid, CarreraT[playerid][2]);
            SacarCarrera(playerid, 2);
            if (ParticipantesCarrera <= 0) {
                ResetearCarrera();
                HabilitarCarreras = 0;
                UpdateDynamic3DTextLabelText(TextoCarrera, COLOR_WHITE, "{FF3300}Boleteria cerrada\n{"            COLOR_GM "}Horarios de los eventos: {FFFFFF}5hs,11hs,17hs,23hs");
            }
            SendClientMessage(playerid, -1, "Has sido descalificado por salir del vehiculo.");
        }
    }
    if (oldstate == PLAYER_STATE_PASSENGER) {

        if (Manejando[playerid] == 1) {
            DarArmas(playerid);
            Manejando[playerid] = 0;
        }
    }
    if (newstate == PLAYER_STATE_DRIVER) {
        new autoid = GetPlayerVehicleID(playerid);
        EnAuto[playerid] = autoid;
        if (PLAYER_INFO[playerid][Agonizando] == 1 && PacienteAmbu[playerid] == 0) {
            RemovePlayerFromVehicle(playerid);
            EnAuto[playerid] = INVALID_PLAYER_ID;
        }
        SetPlayerArmedWeapon(playerid, 0);
        if (MotorAuto[autoid] == 0) {
            if (!CAMION(autoid) && !BICI(autoid)) {
                if (VehiculosInfo[autoid][vcomprable] != 1) {
                    ShowPlayerMessage(playerid, "~w~Para encender el ~y~motor~w~ del vehiculo, pulsa ~y~'2'~w~.");
                    Notificador2(playerid, "Para escuchar alguna emisora de radio de San Andreas, usa ~y~/emisoras");
                }
            }
        }
        if (VehiculosInfo[autoid][vcomprable] == 1) {
            if (!SAPD(autoid)) {
                new string[256], vehicleid = GetPlayerVehicleID(playerid), baul[2], gaso[4], modelo = GetVehicleModel(autoid), vehiclefuel = CombustibleCoche(modelo), velocidadmaxv = VelocidadMaxAuto(modelo);
                format(gaso, sizeof(gaso), "%d", vehiclefuel);
                if (BAUL8(GetPlayerVehicleID(playerid))) format(baul, sizeof(baul), "8");
                else if (BAUL6(GetPlayerVehicleID(playerid))) format(baul, sizeof(baul), "6");
                else if (MOTO(GetPlayerVehicleID(playerid))) format(baul, sizeof(baul), "0");
                else format(baul, sizeof(baul), "4");
                if (VehiculosInfo[autoid][vmoneda] == 0) format(string, sizeof(string), "{FFFFFF}Nombre: {"            COLOR_GM "}%s\n{FFFFFF}Espacios del baul: {00CC00}%s\n{FFFFFF}Velocidad maxima: {ff0000}%d km/h\n{FFFFFF}Cantidad de combustible: {00ccff}%s Litros\n{FFFFFF}Costo del seguro: {ff0000}$%d\n{FFFFFF}Precio: {00CC00}$%d", NombreAuto[GetVehicleModel(vehicleid) - 400], baul, velocidadmaxv, gaso, VehiculosInfo[autoid][vprecio] / 100, VehiculosInfo[autoid][vprecio]);
                else format(string, sizeof(string), "{FFFFFF}Nombre: {"            COLOR_GM "}%s\n{FFFFFF}Espacios del baul: {00CC00}%s\n{FFFFFF}Velocidad maxima: {ff0000}%d km/h\n{FFFFFF}Cantidad de combustible: {00ccff}%s Litros\n{FFFFFF}Costo del seguro: {ff0000}$%d\n{FFFFFF}Precio: {DEA221}%d "    SERVER_COIN "", NombreAuto[GetVehicleModel(vehicleid) - 400], baul, velocidadmaxv, gaso, VehiculosInfo[autoid][vprecio] / 100, VehiculosInfo[autoid][vprecio]);
                dialogs_ShowPlayerDialog(playerid, CVEHICULO, DIALOG_STYLE_MSGBOX, "Detalles del vehiculo", string, "Comprar", "Cancelar");

            }
        }
        new veh = GetPlayerVehicleID(playerid);
        if (JugadorLogeado[playerid] == 1) {
            if (BajandoV[playerid] == 1) {
                if (EnCarreras[playerid] > 0) return 1;
                if (MOTO(veh) && GetPlayerState(playerid) == PLAYER_STATE_PASSENGER) return 1;
            }
        }
        new Float: fCurrentSpeed;
        fCurrentSpeed = player_get_speed(playerid);
        fVehSpeed[playerid] = fCurrentSpeed;
        iVehicle[playerid] = GetPlayerVehicleID(playerid);
        if (BICI(iVehicle[playerid])) {

            Manejando[playerid] = 1;
            KillTimer(Bajando[playerid]);
            return 1;
        }
    }
    if (oldstate == PLAYER_STATE_DRIVER) {
        EnAuto[playerid] = INVALID_VEHICLE_ID;
        if (Ficha[playerid] != 0) {
            TextDrawHideForPlayer(playerid, TAXIMET);
            PlayerTextDrawHide(playerid, TAXIMET2[playerid]);
            TextDrawHideForPlayer(playerid, TAXIMET3);
            TextDrawHideForPlayer(playerid, TAXIMET4);
        }
    }
    return 1;
}
public OnPlayerCommandReceived(playerid, cmd[], params[], flags) {
    if (RP_LGValid(playerid) && JugadorLogeado[playerid] != 1 && !strcmp(cmd, "acceso", true)) return 1;
    if (isnull(params)) printf("[CMD] [%s - %d]: /%s", NombreJugador(playerid), playerid, cmd);
    else printf("[CMD] [%s - %d]: /%s %s", NombreJugador(playerid), playerid, cmd, params);
    if (isnull(params)) ComandosLZEx(3, COLOR_CHEAT, "[CMD] [%s - %d]: /%s", PLAYER_INFO[playerid][Nickname], playerid, cmd), printf("[CMD] [%s - %d]: /%s", PLAYER_INFO[playerid][Nickname], playerid, cmd);
    else ComandosLZEx(3, COLOR_CHEAT, "[CMD] [%s - %d]: /%s %s", PLAYER_INFO[playerid][Nickname], playerid, cmd, params), printf("[CMD] [%s - %d]: /%s %s", PLAYER_INFO[playerid][Nickname], playerid, cmd, params);

    if (LogeoCorrecto[playerid] == 0) {
        if (!strcmp(cmd, "battlepass", true)) {
            printf("[NEXUS PASS] Comando bloqueado antes de abrir: jugador=%d cuenta=%d logeo=%d", playerid, PLAYER_INFO[playerid][pID], LogeoCorrecto[playerid]);
            SendClientMessage(playerid, -1, "Termina el inicio de sesion antes de abrir el pase.");
        }
        return false;
    }
    if (PLAYER_INFO[playerid][pAdmin] < 1) {
        if (ComandoEstado == 0) { SendClientMessageEx(playerid, -1, "No puedes usar comandos durante el reinicio del servidor."); return false; }
        if (GetTickCount() - PLAYER_TEMP[playerid][pt_Antiflood] < 999) { SendClientMessageEx(playerid, 0xFF8C00FF, "Límite de comandos por segundo: 1"); return false; }
    }
    GetSpam(playerid, params);
    SacarAyudaComandos(playerid);
    // El pase se despacha aqui una sola vez, despues de los filtros normales.
    if (!strcmp(cmd, "battlepass", true)) {
        new passResult = callcmd::battlepass(playerid, params);
        PLAYER_TEMP[playerid][pt_Antiflood] = GetTickCount();
        printf("[NEXUS PASS] Comando atendido: jugador=%d resultado=%d", playerid, passResult);
        return false;
    }
    return 1;
}

public OnPlayerCommandPerformed(playerid, cmd[], params[], result, flags) {
    if (result == 0 || result == -1)
        if (isnull(params)) MensajeEx(playerid, -1, "({FF3300}/%s{FFFFFF}) Comando desconocido, usa {DBED15}/ayuda{FFFFFF} para recibir ayuda.", cmd, params);
        else MensajeEx(playerid, -1, "({FF3300}/%s %s{FFFFFF}) Comando desconocido, usa {DBED15}/ayuda{FFFFFF} para recibir ayuda.", cmd, params);
    PLAYER_TEMP[playerid][pt_Antiflood] = GetTickCount();
    return 1;
}

ObtenerReputacionCostoNivel(nivel, & reputacion, & costo = 0) {
    if (nivel < 0) {

        costo = 0;
        reputacion = 0;
        return 0;
    } else {

        switch (nivel) {

            case 0 : costo = 0, reputacion = 0;
            case 1 : costo = 0, reputacion = 0;
            case 2 : costo = 980, reputacion = 7;
            case 3 : costo = 3240, reputacion = 12;
            case 4 : costo = 7600, reputacion = 19;
            case 5 : costo = 16430, reputacion = 31;
            case 6 : costo = 34320, reputacion = 52;
            case 7 : costo = 67940, reputacion = 86;
            case 8 : costo = 131560, reputacion = 143;
            case 9 : costo = 250950, reputacion = 239;
            case 10 : costo = 468460, reputacion = 397;
            case 11 : costo = 867220, reputacion = 662;
            case 12 : costo = 1588320, reputacion = 1103;
            case 13 : costo = 2885660, reputacion = 1838;
            case 14 : costo = 5207100, reputacion = 3063;
            case 15 : costo = 9342150, reputacion = 5105;
            case 16 : costo = 16675680, reputacion = 8508;
            case 17 : costo = 29634110, reputacion = 14179;
            default: costo = 29634110, reputacion = 14179;
        }
    }
    return 1;
}


public ShowStats(playerid, targetid) {
    if (IsPlayerConnected(playerid) && IsPlayerConnected(targetid)) {

        new SexoInfo[20], stringjobs[256];
        if (PLAYER_INFO[targetid][jSexo] == 1) { SexoInfo = "Masculino"; } else if (PLAYER_INFO[targetid][jSexo] == 2) { SexoInfo = "Femenino"; }

        new NivelUser = PLAYER_INFO[targetid][@Nivel];
        new ExpUser = PLAYER_INFO[targetid][jExperiencia];
        new ExpMonto = PLAYER_INFO[targetid][NivelExp];

        new costo, reputacion;
        ObtenerReputacionCostoNivel(PLAYER_INFO[playerid][@Nivel] + 1, reputacion, costo);

        new CuentaString[350];
        if (ExpUser == ExpMonto) {

            format(CuentaString, sizeof(CuentaString), "| Nivel: {37db45}%d{FFFFFF} | Reputacion: {37db45}%d{FFFFFF}/{37db45}%d{FFFFFF} | {"        COLOR_GM "}/comprar nivel{FFFFFF} - Costo: {37db45}$%d", NivelUser, ExpUser, reputacion, costo);
            SendClientMessage(playerid, COLOR_WHITE, CuentaString);
        } else if (ExpUser != ExpMonto) {

            format(CuentaString, sizeof(CuentaString), "| Nivel:{37db45} %d{FFFFFF} | Reputacion: {ffcc00}%d{FFFFFF}/{37db45}%d {FFFFFF}| Costo del siguiente nivel: {37db45}$%d", NivelUser, ExpUser, reputacion, costo);
            SendClientMessage(playerid, COLOR_WHITE, CuentaString);
        }
        format(stringjobs, sizeof(stringjobs), "| Trabajo primario: {"    COLOR_GM "}%s{FFFFFF} | Trabajo secundario: %s |", NombreTrabajo(PLAYER_INFO[targetid][pTrabajo]), NombreTrabajo(PLAYER_INFO[targetid][pTrabajo2]));
        SendClientMessage(playerid, -1, stringjobs);
        if (PLAYER_INFO[targetid][pFaccion] > 0) {

            new banda = PLAYER_INFO[targetid][pFaccion];
            switch (PLAYER_INFO[targetid][pRango]) {

                case 1 : MensajeEx(playerid, 0xFFFFFFFF, "{FFFFFF}| Integrante de: {"            COLOR_GM "}%s{FFFFFF} | Rango: {"            COLOR_GM "}%s{FFFFFF} | {FFFFFF}Barrio: {"            COLOR_GM "}%s{FFFFFF}", BandasInfo[banda][BNombre], BandasInfo[banda][BRango1], BandasInfo[banda][territorio]);
                case 2 : MensajeEx(playerid, 0xFFFFFFFF, "{FFFFFF}| Integrante de: {"            COLOR_GM "}%s{FFFFFF} | Rango: {"            COLOR_GM "}%s{FFFFFF} | {FFFFFF}Barrio: {"            COLOR_GM "}%s{FFFFFF}", BandasInfo[banda][BNombre], BandasInfo[banda][BRango2], BandasInfo[banda][territorio]);
                case 3 : MensajeEx(playerid, 0xFFFFFFFF, "{FFFFFF}| Integrante de: {"            COLOR_GM "}%s{FFFFFF} | Rango: {"            COLOR_GM "}%s{FFFFFF} | {FFFFFF}Barrio: {"            COLOR_GM "}%s{FFFFFF}", BandasInfo[banda][BNombre], BandasInfo[banda][BRango3], BandasInfo[banda][territorio]);
                case 4 : MensajeEx(playerid, 0xFFFFFFFF, "{FFFFFF}| Integrante de: {"            COLOR_GM "}%s{FFFFFF} | Rango: {"            COLOR_GM "}%s{FFFFFF} | {FFFFFF}Barrio: {"            COLOR_GM "}%s{FFFFFF}", BandasInfo[banda][BNombre], BandasInfo[banda][BRango4], BandasInfo[banda][territorio]);
                case 5 : MensajeEx(playerid, 0xFFFFFFFF, "{FFFFFF}| Integrante de: {"            COLOR_GM "}%s{FFFFFF} | Rango: {"            COLOR_GM "}%s{FFFFFF} | {FFFFFF}Barrio: {"            COLOR_GM "}%s{FFFFFF}", BandasInfo[banda][BNombre], BandasInfo[banda][BRango5], BandasInfo[banda][territorio]);
                case 6 : MensajeEx(playerid, 0xFFFFFFFF, "{FFFFFF}| Integrante de: {"            COLOR_GM "}%s{FFFFFF} | Rango: {"            COLOR_GM "}%s{FFFFFF} | {FFFFFF}Barrio: {"            COLOR_GM "}%s{FFFFFF}", BandasInfo[banda][BNombre], BandasInfo[banda][BRango6], BandasInfo[banda][territorio]);
                case 7 : MensajeEx(playerid, 0xFFFFFFFF, "{FFFFFF}| Integrante de: {"            COLOR_GM "}%s{FFFFFF} | Rango: {"            COLOR_GM "}%s{FFFFFF} | {FFFFFF}Barrio: {"            COLOR_GM "}%s{FFFFFF}", BandasInfo[banda][BNombre], BandasInfo[banda][BRango7], BandasInfo[banda][territorio]);
                case 8 : MensajeEx(playerid, 0xFFFFFFFF, "{FFFFFF}| Integrante de: {"            COLOR_GM "}%s{FFFFFF} | Rango: {"            COLOR_GM "}%s{FFFFFF} | {FFFFFF}Barrio: {"            COLOR_GM "}%s{FFFFFF}", BandasInfo[banda][BNombre], BandasInfo[banda][BRango8], BandasInfo[banda][territorio]);
                case 9 : MensajeEx(playerid, 0xFFFFFFFF, "{FFFFFF}| Integrante de: {"            COLOR_GM "}%s{FFFFFF} | Rango: {"            COLOR_GM "}09{FFFFFF} | {FFFFFF}Barrio: {"            COLOR_GM "}%s{FFFFFF}", BandasInfo[banda][BNombre], BandasInfo[banda][territorio]);
            }
        }
        if (PLAYER_INFO[playerid][pAdmin] > ADMIN_LEVEL_DUDAS) {

            new sexo[24], Telefono[10], BandaID[10], valueVip[10], android[40];
            new fps = GetPlayerFPS(playerid);
            if (PLAYER_INFO[targetid][pVip] == 0) valueVip = "No tiene";
            else format(valueVip, sizeof(valueVip), "%d", PLAYER_INFO[targetid][pVip]);
            if (PLAYER_INFO[targetid][pFaccion] == 0) BandaID = "No tiene";
            else format(BandaID, sizeof(BandaID), "%d", PLAYER_INFO[targetid][pFaccion]);
            if (PLAYER_INFO[targetid][pNumero] == 0) Telefono = "No tiene";
            else format(Telefono, sizeof(Telefono), "%d", PLAYER_INFO[targetid][pNumero]);
            if (PLAYER_INFO[targetid][jSexo] == 1) sexo = "Masculino";
            else sexo = "Femenino";
            if (fps == 0) {
                android = "Android";
            } else if (fps != 0) {
                android = "Samp";
            }


            MensajeEx(playerid, -1, "ID: %d | VIP: %s | HJ: %d | S: %s | N: %s | Banda ID: %s", PLAYER_INFO[targetid][pID], valueVip, PLAYER_INFO[targetid][horasjugadas], sexo, Telefono, BandaID);
            MensajeEx(playerid, -1, "Email: %s | Skin: %d", PLAYER_INFO[targetid][pEmail], PLAYER_INFO[targetid][jRopa]);
            MensajeEx(playerid, -1, "{FF0000}Plataforma ={FFFFFF} %s ", android);

            if (PLAYER_INFO[playerid][pAdmin] >= ADMIN_LEVEL_GLOBAL && PLAYER_INFO[targetid][pAdmin] < PLAYER_INFO[playerid][pAdmin]) {

                new ip[32];
                GetPlayerIp(targetid, ip, 32);
                SendClientMessageEx(playerid, -1, "La IP de %s es: %s", PLAYER_INFO[targetid][Nickname], ip);
            }
        }
        return 1;
    }
    return 1;
}
public PayDay(value) {
    new horas, minutos, segundos;
    gettime(horas, minutos, segundos);
    foreach(new i : Player) {
        if (LoggedYet[i] == true && IsPlayerConnected(i)) {
            if (!IsPlayerNPC(i)) {
                new gastosest, paga = PLAYER_INFO[i][@Nivel] * 100 + 50, suma, intereses, seguro, sumat, seguro2, estacionamiento, gananciasest, seguro3, seguro4, seguros, gastos, total;
                PLAYER_INFO[i][horasjugadas] += ExpPD;
                if(PLAYER_INFO[i][TiempoPD] < value) return SendClientMessage(i,COLOR_GREY,"No jugaste el tiempo suficiente para recibir tu pago diario");
                seguro = PLAYER_INFO[i][vPrecio] / 100, seguro2 = PLAYER_INFO[i][v2Precio] / 100, seguro3 = PLAYER_INFO[i][v3Precio] / 100, seguro4 = PLAYER_INFO[i][v4Precio] / 100;
                seguros = seguro + seguro2 + seguro3 + seguro4, PLAYER_INFO[i][TiempoPD] = 0;
                for(new c = 0; c < MAX_PROPIEDADES; c++)
                    estacionamiento = PLAYER_INFO[i][vEstacionado4];
                gastos = seguro + seguro2 + seguro3 + seguro4 + estacionamiento;
                switch (PLAYER_INFO[i][pVip]) {
                    case 1 : total = 1500;
                    case 2 : total = 3000;
                    case 3 : total = 5000;
                    default: total = 1000;
                }
                intereses = PLAYER_INFO[i][pBanco] / 1000;
                if (intereses >= total) { intereses = total; }
                if (GetVehicleInterior(autos[i]) != 0 && PLAYER_INFO[i][vEstacionado1] > 0) { gastosest += 150; }
                if (GetVehicleInterior(autos2[i]) != 0 && PLAYER_INFO[i][vEstacionado2] > 0) { gastosest += 150; }
                if (GetVehicleInterior(autos3[i]) != 0 && PLAYER_INFO[i][vEstacionado3] > 0) { gastosest += 150; }
                if (GetVehicleInterior(autos4[i]) != 0 && PLAYER_INFO[i][vEstacionado4] > 0) { gastosest += 150; }
                if (GetVehicleInterior(autos5[i]) != 0 && PLAYER_INFO[i][vEstacionado5] > 0) { gastosest += 150; }
                new rpBankBefore = PLAYER_INFO[i][pBanco], rpBasePay = paga;
                PLAYER_INFO[i][pBanco] -= gastosest;
                RP_EcoParkingDaily(i);
                PLAYER_INFO[i][pBanco] += gananciasest;
                ActualizarBanco(i);
                suma = paga + gananciasest - estacionamiento - seguros, sumat = suma + intereses;
                if (Emisoras[i][TransEmisora] == 1) {
                    new emisoraid = Emisoras[i][CabinaOcupada], oyentes = CabinasOcupadasEmisoras[emisoraid][2], pagalocutor = 3000 + (oyentes * 500);
                    paga += pagalocutor;
                    MensajeEx(i, COLOR_WHITE, " Ganancias por la emisora de radio: {fe814c}$%d{FFFFFF}.", pagalocutor);
                }
                new cuentaterris = 0;
                for(new t = 0; t != MAX_T; t++) {

                    if (TerritorioInfo[t][Territorio_Valido] && TerritorioInfo[t][Territorio_BandaID] != 0) {
                        if (TerritorioInfo[t][Territorio_BandaID] == PLAYER_INFO[i][pFaccion]) {
                            cuentaterris++;
                        }
                    }
                }

                if (cuentaterris != 0 && !PayDayActive) {
                    new terrisaccount[128], terrisaccount2[128];
                    paga += cuentaterris * PD_POR_TERRITORIO;
                    format(terrisaccount, sizeof(terrisaccount), " Ganancias por territorios(%d): ~g~$%d~w~.", cuentaterris, cuentaterris * PD_POR_TERRITORIO / 2);
                    Notificador2(i, terrisaccount);
                    DarDinero(i, cuentaterris * PD_POR_TERRITORIO);
                    PLAYER_INFO[i][pMateriales] += 300;
                    format(terrisaccount2, sizeof(terrisaccount2), "Has obtenido ~g~300 materiales~w~ por ~r~%d territorios~w~ conquistados.", cuentaterris);
                    if (PLAYER_INFO[i][pFaccion] > 5) ShowPlayerMessage(i, terrisaccount2, 7000);
                }

                //
                //SendClientMessage(i, COLOR_WHITE, "{F0F0F0}/________________ FIN DEL RESUMEN ________________/");
                PLAYER_INFO[i][pBanco] += sumat;
                ActualizarBanco(i);
                new rpExpBefore = PLAYER_INFO[i][jExperiencia];
                if (PLAYER_INFO[i][jExperiencia] < PLAYER_INFO[i][NivelExp]) PLAYER_INFO[i][jExperiencia] += ExpPD;
                RP_PDShow(i, rpBasePay, intereses, gastos + gastosest, PLAYER_INFO[i][pBanco] - rpBankBefore, PLAYER_INFO[i][pBanco], PLAYER_INFO[i][jExperiencia] - rpExpBefore);
            }
        }
    }
    printf("Se le ha dado payday a los jugadores.");
    return true;
}
DetectSPAM(const SPAM[]) {
    new StringSPAM;
    new COUNTP, COUNTN, COUNTW, COUNTTP;
    for(StringSPAM = 0; StringSPAM < strlen(SPAM); StringSPAM++) {

        if (SPAM[StringSPAM] == '.') COUNTP++;
        if (SPAM[StringSPAM] == '0' || SPAM[StringSPAM] == '1' || SPAM[StringSPAM] == '2' || SPAM[StringSPAM] == '3' || SPAM[StringSPAM] == '4' || SPAM[StringSPAM] == '5' || SPAM[StringSPAM] == '6' || SPAM[StringSPAM] == '7' || SPAM[StringSPAM] == '8' || SPAM[StringSPAM] == '9') COUNTN++; //Count ot the Numbers
        if (SPAM[StringSPAM] == ':') COUNTTP++;
    }
    if (COUNTP >= 3 && COUNTN >= 6) return 1;
    if (COUNTW >= 3) return 1;
    if (strfind(SPAM, ".ga", true) != -1 || strfind(SPAM, ".ml", true) != -1 || strfind(SPAM, ".com.ar", true) != -1 || strfind(SPAM, ".org", true) != -1 || strfind(SPAM, ".com", true) != -1 || strfind(SPAM, ".es", true) != -1 || strfind(SPAM, ".tk", true) != -1) return 1;
    if (COUNTTP >= 1 && COUNTN >= 6) return 1;
    return 0;
}
VehiculoOcupado(vehicleid) {
