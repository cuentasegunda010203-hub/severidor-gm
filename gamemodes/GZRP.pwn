    SetTimer("TimerFC3", 180000, false);
    foreach(new i : Player) {

        if (GetPlayerVirtualWorld(i) == 15 && GetPlayerInterior(i) == 15) {

            SendClientMessage(i, 0x3399FFFF, "[Guardia]:{FFFFFF} Tienen 3 minutos para regresar a sus celdas.");
        }
