        case VENDERMARIHUANA: {
            if (response) {
                new cantidad = strval(inputtext);
                new precio = 150;
                new preciototal = precio * cantidad;
                if (cantidad <= 0) return SendClientMessage(playerid, -1, "Los items deben ser mayor a 0");
                if (cantidad > 500) return SendClientMessage(playerid, -1, "Los items deben ser menor a 5000");
                if (PLAYER_INFO[playerid][pMarihuana] > cantidad && IsNumeric(inputtext)) {
                    if (DineroCamello > preciototal) {
                        new day, month, year, querys[200];
                        getdate(year, month, day);
                        SendClientMessageEx(playerid, -1, "Vendiste %dg. de marihuana por {00CC00}$%d{FFFFFF}.", cantidad, preciototal);
                        DarDinero(playerid, preciototal);
                        DineroCamello -= preciototal;
                        MarihuanaCamello += strval(inputtext);
                        PLAYER_INFO[playerid][pMarihuana] -= cantidad;

                        mysql_format(handle_db, querys, sizeof(querys), "INSERT INTO `log_ventas` (Vendedor, item, cantidad, precio, comprador,fecha) VALUES ('%e','marihuana', '%d','%d','camello','%02d/%02d/%02d')", PLAYER_INFO[playerid][Nickname], cantidad, preciototal, day, month, year);
                        mysql_tquery(handle_db, querys);
                    } else SetPlayerChatBubble(Camello, "No tengo mas dinero.", -1, 30.0, 5000), SendClientMessage(playerid, -1, "El camello no tiene dinero, vuelve mas tarde");
                } else SendClientMessage(playerid, -1, "No tienes esa cantidad de marihuana.");
            }
            return 1;
        }
        case VENDERCRACK: {
