            CreatePlayerObject(playerid, 19532, 609.04999, -3250.76001, 4.86000, 0.00000, 0.00000, 0.00000, 250);
            CreatePlayerObject(playerid, 19788, 888.98999, -3320.76001, 4.86000, 0.00000, 0.00000, 0.00000, 250);
            CreatePlayerObject(playerid, 19788, 889.02002, -3040.77002, 4.86000, 0.00000, 0.00000, 90.00000, 250);
            CreatePlayerObject(playerid, 19788, 749.02002, -3040.78003, 4.86000, 0.00000, 0.00000, 180.00000, 250);
            CreatePlayerObject(playerid, 18803, 749.02002, -3403.27002, 4.56000, 0.00000, 0.00000, 90.00000, 250);
            CreatePlayerObject(playerid, 19534, 594.04999, -3180.76001, 4.86000, 0.00000, 0.00000, 180.00000, 250);
            CreatePlayerObject(playerid, 19534, 749.02002, -3485.73999, 4.88000, 0.00000, 0.00000, -90.00000, 250);
            CreatePlayerObject(playerid, 19534, 609.03998, -3180.76001, 4.86000, 0.00000, 0.00000, 180.00000, 250);
            CreatePlayerObject(playerid, 19534, 623.97998, -3180.76001, 4.90000, 0.00000, 0.00000, 180.00000, 250);
            CreatePlayerObject(playerid, 19534, 749.02002, -3180.76001, 4.86000, 0.00000, 0.00000, 180.00000, 250);
            CreatePlayerObject(playerid, 18805, 666.76001, -3180.76001, -0.70000, 0.00000, -4.00000, 0.00000, 250);
            //Estacionamiento
            CreatePlayerObject(playerid, 7010, 1727.82605, -1891.48206, -41.05000, 0.00000, 0.00000, 359.88000, 1148829696);
            CreatePlayerObject(playerid, 7244, 1653.01001, -1860.55005, -51.76400, 0.00000, 0.00000, 0.00000, 1148829696);
            //Salon de Eventos
            CreatePlayerObject(playerid, 13657, -1252.81006, 2055.30005, 1248.78003, 0.00000, 0.00000, 0.00000, 1148829696);
            CreatePlayerObject(playerid, 13657, -1252.81995, 2099.14990, 1254.63000, 0.00000, 180.00000, 180.00000, 1148829696);
            CreatePlayerObject(playerid, 10766, -1304.91003, 2021.48999, 1269.75000, 0.00000, 0.00000, 0.00000, 1148829696);
            CreatePlayerObject(playerid, 10766, -1273.46997, 2017.13000, 1276.88000, 0.00000, 0.00000, 0.00000, 1148829696);
            CreatePlayerObject(playerid, 10766, -1265.25000, 1972.28003, 1269.75000, 0.00000, 0.00000, 0.00000, 1148829696);
        }
        ViendoGPS[playerid] = 0;
        for(new i = 0; i < MAX_TEXTDRAWS; i++) {

            if (TDPGPSCreado[playerid][i] > 0) {

                PlayerTextDrawDestroy(playerid, TextDPGPS[playerid][i]);
                PlayerTextDrawDestroy(playerid, TextDPGPS2[playerid][i]);
                TDPGPSCreado[playerid][i] = 0;
            }
        }
        for(new i = 0; i < TDGPSCreadoS; i++) { TextDrawHideForPlayer(playerid, TextDGPS[i]); }
        StopAudioStreamForPlayer(playerid);
        BloqueoCuenta(playerid);
        CargarMapeosEx(playerid);
        if (PLAYER_INFO[playerid][pFaccion] > 0) MostrarBoxLogeo(playerid);
        if (PLAYER_INFO[playerid][pAdmin] == ADMIN_LEVEL_USER) {
            if (PLAYER_TIMES[playerid][TiempoDuda] == 0) {
                PLAYER_TIMES[playerid][TiempoDuda] = 300;
            }
        }
        if (PLAYER_INFO[playerid][pVip] > 0) SetTimerEx("CheckVIP", 1000, false, "d", playerid);
        CalcularNivel(playerid);
        new year, month, day;
        new hour, minuite, second;
        new string2[128];
        getdate(year, month, day);
        gettime(hour, minuite, second);
        if (PLAYER_INFO[playerid][pAdmin] == ADMIN_LEVEL_USER) PLAYER_TIMES[playerid][TiempoDarDinero] = 300;
        else PLAYER_TIMES[playerid][TiempoDarDinero] = 15;
        //GPS
        GPSActivado[playerid] = 0;
        for(new i = 0; i < MAX_TEXTDRAWS; i++) {

            if (TDPGPSCreado[playerid][i] > 0) {

                PlayerTextDrawDestroy(playerid, TextDPGPS[playerid][i]);
                PlayerTextDrawDestroy(playerid, TextDPGPS2[playerid][i]);
                TDPGPSCreado[playerid][i] = 0;
            }
        }
        for(new i = 0; i < TDGPSCreadoS; i++) TextDrawHideForPlayer(playerid, TextDGPS[i]);
        new plrIP[32];
        GetPlayerIp(playerid, plrIP, sizeof(plrIP));
        format(PLAYER_TEMP[playerid][voIP], sizeof(plrIP), "%s", plrIP);
        format(string2, sizeof(string2), "%02d/%02d/%02d %02d:%02d:%02d", day, month, year, hour, minuite, second);
        InsertLog(playerid);
        MostrarMapas(playerid);
        if(!IsPlayerMobile(playerid)) LoadAnimLibs(playerid);
        LoadPlayerPhoneBook(playerid);
        StopAudioStreamForPlayer(playerid);
        ClearAnimations(playerid);
        gettime(Hora, Minuto);
        SetPlayerTime(playerid, Hora, Minuto);
        SetPlayerInterior(playerid, PLAYER_INFO[playerid][pInterior]);
        SetPlayerVirtualWorld(playerid, PLAYER_INFO[playerid][pMundoVirtual]);
        ResetPlayerWeapons(playerid);
        DarArmas(playerid);
        ColorJugadorDefault(playerid);
        ResetPlayerMoney(playerid);
        SetTimerEx("Logeado", 1000, false, "d", playerid);
        SetTimerEx("Logeado2", 3000, false, "d", playerid);
        Logeando[playerid] = 0;
        JugadorLogeado[playerid] = 1;
        LoadPlayerToys(playerid);
        //ChecarVehBanda(playerid);
        SetPlayerStats(playerid);
        SetPlayerArmedWeapon(playerid, 0);
        MostrarHUD(playerid);
        for(new g = 0; g < MAX_PCASAS; g++) {
            if (PLAYER_INFO[playerid][CasaID][g] > 0 && PropInfo[PLAYER_INFO[playerid][CasaID][g]][pIDPropietario] != PLAYER_INFO[playerid][pID]) PLAYER_INFO[playerid][CasaID][g] = 0;
        }
        if (PLAYER_INFO[playerid][pBarras] == 1) {

            ActualizarHambre(playerid, 1);
            ActualizarSed(playerid, 1);
        }
        DarRopa(playerid);
        if (PLAYER_INFO[playerid][pFaccion] == 1) {
            BuscarCriminales();
        }
        if (PLAYER_INFO[playerid][pFaccion] > 5) {
            for(new ID = 1; ID < MAX_FABRICAS; ID++) {
                if (!FABRICAS_INFO[ID][f_VALID]) continue;
                if (FABRICAS_INFO[ID][f_FACCION_ID] != PLAYER_INFO[playerid][pFaccion]) continue;
                if (gettime() > FABRICAS_INFO[ID][f_SOBORNO_TIME]) {
                    new chatadmin[328], idfab;
                    idfab = FABRICAS_INFO[ID][f_FACCION_ID];
                    Webhook_Fabrica(idfab, "Atencion: La fabrica no ha pagado el soborno, la policía fue avisada.");
                    SendClientMessage(playerid, 0xFFFFFFFF, "Tu fabrica {FF0000}no ha pagado el soborno{FFFFFF} a la policia.");
                    format(chatadmin, sizeof(chatadmin), "((SMS Informante)) La fabrica de %s no ha pagado el soborno.", BandasInfo[idfab][BNombre]);
                    SendRadioMessagePatrulla(1, -1, chatadmin);
                    break;
                }
            }
        }
        CheckAndroid(playerid);
        VerificarAndroid(playerid);
        VerificarIP(playerid);
        Actualizar(playerid);
        SetTimerEx("datosCargados", 10000, false, "d", playerid);
        SetTimerEx("CheckSobeit", segundos(10), 0, "i", playerid);
        return 1;
    }
    if (PLAYER_TEMP[playerid][@Specteando] == 1) {
        EstablecerChaleco(playerid, PLAYER_INFO[playerid][@Chaleco]);
        EstablecerVida(playerid, PLAYER_INFO[playerid][@Salud]);
        NoTeleportHack(playerid);
        DarRopa(playerid);
        DarArmas(playerid);
        DarPrendas(playerid);
        SetPlayerPos(playerid, SpecX[playerid], SpecY[playerid], SpecZ[playerid]);
        SetPlayerInterior(playerid, SpecInt[playerid]);
        SetPlayerVirtualWorld(playerid, SpecVW[playerid]);
        PLAYER_TEMP[playerid][@Specteando] = 0;
        SpecJugador[playerid] = INVALID_PLAYER_ID;
        return 1;
    }
    new policiason;
    GetPolicesOn(policiason);
    if (PLAYER_INFO[playerid][Agonizando] == 1 && PLAYER_INFO[playerid][pCargos] > 1) {
        if (GetPlayerInterior(playerid) > 0) {
            Revivir(playerid);
            Encerrando2(playerid);
            Muriendo[playerid] = 0;
            PLAYER_INFO[playerid][Agonizando] = 0;
            Jail[playerid] = 1;
            return 1;
        }
        if (policiason > 0) {
            PLAYER_INFO[playerid][Agonizando] = 0;
            ResetPlayerWeapons(playerid);
            DarArmas(playerid);
            DarRopa(playerid);
            for(new i = 0; i <= GetPlayerPoolSize(); i++)
                if (PLAYER_INFO[i][pDuty] == 1) SetPlayerMarkerForPlayer(i, playerid, c0_color);
            PLAYER_TEMP[playerid][VariableCaido] = 1;
            EstablecerVida(playerid, 10.0);
            SendClientMessage(playerid, 0xafafafFF, "{FFBC00}Los Medicos no van a tratar con un delincuente.");
            SendClientMessage(playerid, 0xafafafFF, "{FFBC00}Espera a que la policia te traslade.");
            ClearAnimations(playerid);
            ApplyAnimation(playerid, "SWEET", "Sweet_injuredloop", 4.0, 1, 0, 0, 0, 0, 1);
            ApplyAnimation(playerid, "SWEET", "Sweet_injuredloop", 4.0, 1, 0, 0, 0, 0, 1);
            SetPlayerColor(playerid, DEFAULT_COLOR);
            for(new i = 0; i <= GetPlayerPoolSize(); i++)
                if (PLAYER_INFO[i][pDuty] == 1) {
                    SetPlayerMarkerForPlayer(i, playerid, 0x9EC73DFF);
                    CongelarPlayerID(playerid);
                }
            new Float:anglex;
            GetPlayerFacingAngle(playerid, anglex);
            DarPrendas(playerid);
            return 1;
        } else {
            QuitarConsumibles(playerid);
            EstablecerVida(playerid, 90);
            if (PLAYER_INFO[playerid][pCargos] < 2) { PLAYER_INFO[playerid][pCargos] = 0;
                ActualizarRadar(); }
            if (PLAYER_INFO[playerid][pCargos] < 2) SetPlayerWantedLevelEx(playerid, PLAYER_INFO[playerid][pCargos]);
            DarRopa(playerid);
            TimerWeapons[playerid] = gettime() + 10;
            ResetPlayerWeapons(playerid);
            DarArmas(playerid);
            Muriendo[playerid] = 1;
            DarDinero(playerid, 0);
            ClearAnimations(playerid);
            SetPlayerInterior(playerid, PLAYER_INFO[playerid][pInterior]);
            SetPlayerVirtualWorld(playerid, PLAYER_INFO[playerid][pMundoVirtual]);
            if (!IsPlayerMobile(playerid)) {
                TextDrawShowForPlayer(playerid, Sangre);
                ApplyAnimation(playerid, "CRACK", "crckdeth2", 4.0, 1, 0, 0, 0, 0, 1);
                ApplyAnimation(playerid, "CRACK", "crckdeth2", 4.0, 1, 0, 0, 0, 0, 1);
            }
           /* if (IsPlayerMobile(playerid)) {
                ApplyAnimation(playerid, "CRACK", "crckdeth2", 4.0, 1, 0, 0, 0, 0, 0);
            }*/
            SendClientMessage(playerid, 0xafafafFF, "{FFFFFF}Estas muy malherido y comienzas a perder sangre.");
            if (IsPlayerMobile(playerid)) MostrarBoxMedicoAndroid(playerid);
            else MostrarBoxMedico(playerid);
            DarPrendas(playerid);
            return 1;
        }
    } else if (PLAYER_INFO[playerid][pCargos] <= 1 && PLAYER_INFO[playerid][Agonizando] == 1) {
        QuitarConsumibles(playerid);
        EstablecerVida(playerid, 90);
        if (PLAYER_INFO[playerid][pCargos] < 2) { PLAYER_INFO[playerid][pCargos] = 0;
            ActualizarRadar(); }
        if (PLAYER_INFO[playerid][pCargos] < 2) SetPlayerWantedLevelEx(playerid, PLAYER_INFO[playerid][pCargos]);
        DarRopa(playerid);
        ResetPlayerWeapons(playerid);
        DarArmas(playerid);
        Muriendo[playerid] = 1;
        DarDinero(playerid, 0);
        ClearAnimations(playerid);
        SetPlayerInterior(playerid, PLAYER_INFO[playerid][pInterior]);
        SetPlayerVirtualWorld(playerid, PLAYER_INFO[playerid][pMundoVirtual]);
        if (!IsPlayerMobile(playerid)) {
            TextDrawShowForPlayer(playerid, Sangre);
            ApplyAnimation(playerid, "CRACK", "crckdeth2", 4.0, 1, 0, 0, 0, 0, 1);
            ApplyAnimation(playerid, "CRACK", "crckdeth2", 4.0, 1, 0, 0, 0, 0, 1);
        }
        /*if (IsPlayerMobile(playerid)) {
            ApplyAnimation(playerid, "CRACK", "crckdeth2", 4.0, 1, 0, 0, 0, 0, 0);
        }*/
        SendClientMessage(playerid, 0xafafafFF, "{FFFFFF}Estas muy malherido y comienzas a perder sangre.");
        if (IsPlayerMobile(playerid)) MostrarBoxMedicoAndroid(playerid);
        else MostrarBoxMedico(playerid);
        DarPrendas(playerid);
        return 1;
    }
    if (PLAYER_INFO[playerid][pTiempoCarcel] > 0) {
        DarRopa(playerid);
        EnviarCarcel(playerid);
        Jail[playerid] = 1;
        DarPrendas(playerid);
        return 1;
    }
    if (PLAYER_INFO[playerid][pTiempoJail] > 0) {
        DarRopa(playerid);
        San[playerid] = 1;
        SetTimerEx("EnviarJail", 2000, false, "d", playerid);
        DarPrendas(playerid);
        return 1;
    }
    
    if (PLAYER_INFO[playerid][Agonizando] == 2) {
        if (PLAYER_INFO[playerid][pDuty] != 1) QuitarArmas(playerid);
        PLAYER_TEMP[playerid][@pHospital] = 1;
        ApareceHospital(playerid);
        DarPrendas(playerid);
        return 1;
    }
    return 1;
}

function SpawnearJugador(playerid) {
    if (IsPlayerConnected(playerid)) {
        SetSpawnInfo(playerid, 0, PLAYER_INFO[playerid][jRopa], DeathX[playerid], DeathY[playerid], DeathZ[playerid] + 0.3, 0, 0, 0, 0, 0, 0, 0);
        SetPlayerSkin(playerid, PLAYER_INFO[playerid][jRopa]);
        SetPlayerScore(playerid, PLAYER_INFO[playerid][@Nivel]);
        EstablecerChaleco(playerid, PLAYER_INFO[playerid][@Chaleco]);
        EstablecerVida(playerid, PLAYER_INFO[playerid][@Salud]);
        RP_LGSpawnReady(playerid);
    }
    return 1;
}

public OnPlayerPickUpDynamicPickup(playerid, pickupid)
{
    if(ATM_Pickup(playerid,pickupid)) return 1;
    if (RP_IAPickup(playerid, pickupid)) return 1;
	PLAYER_TEMP[playerid][pt_LAST_PICKUP_ID] = pickupid;
	return 1;
}
public OnPlayerRequestClass(playerid, classid)
{
	#if DEBUG_GM == 1
	printf("(OnPlayerRequestClass) PlayerID: %d | ClassID: %d", playerid, classid);
	#endif
	if(IsPlayerNPC(playerid)) return 1;
	return 1;
}
public OnPlayerRequestSpawn(playerid)
{
	#if DEBUG_GM == 1
	printf("(OnPlayerRequestSpawn) PlayerID: %d", playerid);
	#endif
	if(IsPlayerNPC(playerid)) return 1;
	if(JugadorLogeado[playerid] == 1)
	{
		SetSpawnInfo(playerid,NO_TEAM,PLAYER_INFO[playerid][jRopa],DeathX[playerid], DeathY[playerid], DeathZ[playerid],0,0,0,0,0,0,0);
		RP_LGSpawnReady(playerid);
        if(!IsPlayerSpawned(playerid) && !IsPlayerMobile(playerid)) SetTimerEx("SpawnearJugador",500, false, "d",playerid);
	}
	return 0;
}
public OnPlayerText(playerid, text[]) {
    if (JugadorLogeado[playerid] != 1) return 0;
    //DiscordTexto(playerid, text);
    if (dudas_debate == 1) EnviarDuda2(playerid, text);
    new dudaColor[700];
    new count;
    format(dudaColor, sizeof(dudaColor), text);
    for(new i; i < sizeof(dudaColor) - 160; i++) //by renzolini pa :v
    {
        if (dudaColor[i] == '-') {
            if (dudaColor[i] == '-')
                strins(dudaColor, "{df4b57}", i);
            for(new e = i; e < sizeof(dudaColor); e++) {
                if (dudaColor[e] == '-') {
                    strins(dudaColor, "{df4b57}", e);
                    i += 80;
                    count++;
                    break;
                }
            }
            for(new u = i; u < sizeof(dudaColor); u++) {
                if (dudaColor[u] == ' ') {
                    strins(dudaColor, "{cccccc}", u);
                    i += 80;
                    count++;
                    break;
                }
            }
        }
    }
    if (PLAYER_TEMP[playerid][@Specteando] == 1 && text[0] != '!' && text[1] != '!' && text[0] != '@') {

        SendClientMessage(playerid, 0xDEA600FF, "Por seguridad, no esta permitido hablar dentro del personaje mientras ves a un jugador.");
        SendClientMessage(playerid, -1, "Si necesitas hacerlo, usa el comando {"    COLOR_GM "}/d [texto]{ffffff}.");
        return false;
    }
    assert(AntiFlood_Check(playerid));
    DetectarSPAM(playerid, text);
    if (strfind(text, PLAYER_INFO[playerid][ContraTemporal], true) != -1) {
        new pText[144];
        if (PLAYER_INFO[playerid][pMascaraPuesta] == 1) return format(pText, sizeof(pText), "Anonymous dice: %s", text);
        format(pText, sizeof(pText), "%s dice: %s", PlayerName(playerid), text);
        SendClientMessage(playerid, 0xE6E6E6E6, pText);
        new dialog[385];
        format(dialog, sizeof(dialog), "{FFFFFF}No le des tu contraseña a NADIE, si alguien te pidio tu la contraseña reportalo usando {009AFF}/reportar [ID o Nombre] Ladron de cuentas.\n\n{00CC00}** Los administradores no necesitan tu contraseña. **{FFFFFF}\n\nNo te preocupes por haber enviado la contraseña, el mensaje fue filtrado por nuestro sistema.\nDe todas formas puedes cambiar tu contraseña si lo deseas desde la web.");
        dialogs_ShowPlayerDialog(playerid, INFOMEDICO, DIALOG_STYLE_MSGBOX, "{009AFF}¡ATENCION!", dialog, "Cerrar", "");
        return false;
    }
    SacarAyudaComandos(playerid);
    if (GetPlayerScore(playerid) == 0) return 0;
    new cmdrem[20];
    format(cmdrem, sizeof(cmdrem), "/rem");
    if (strfind(text, cmdrem, true) != -1) {
        Kick(playerid);
        return false;
    }
    if (text[0] == '@' && text[1] != '@') {
        if (PLAYER_INFO[playerid][pAdmin] > ADMIN_LEVEL_AYUDANTE && VerAdmin[playerid] > 0) {

            if (strlen(text[1]) > 0) {

                new string[128];
                format(string, 128, "[@Admins] %s %s (%d) dice: %s", ADMIN_RANKS_FULLNAME[PLAYER_INFO[playerid][pAdmin]], PLAYER_INFO[playerid][Nickname], playerid, text[1]);
                MensajeAdmin(COLOR_VERDECLARO, string, ADMIN_LEVEL_DUDAS);
                Webhook_Canales(playerid, text[1], 2, 0);
                return 0;
            }
        }
    }
    if (text[0] == '#' && text[1] != '#') {
        if (PLAYER_INFO[playerid][pTiempoCarcel] > 0 || PLAYER_INFO[playerid][pTiempoJail] > 0) {
            SendClientMessage(playerid, -1, "Te quitaron el telefono antes de meterte en la celda.");
            return 0;
        }
        if (CanalTwt[playerid] == 0) return 0;
        if (PLAYER_INFO[playerid][pNumero] == 0) return 0;
        if (activocanal == 0) return 0;
        new string[256];
        if (strlen(text[1]) > 0) {
            if (PLAYER_INFO[playerid][TiempoTwitter] - gettime() > 60) {
                format(string, sizeof(string), "{FFFFFF}No se te permite hablar en el canal. Debes esperar {00CC00}%d{FFFFFF} minutos para volver a usar.",
                    (PLAYER_INFO[playerid][TiempoTwitter] - gettime()) / 60);
                SendClientMessage(playerid, 0xff9a00FF, string);
                return 0;
            }

            if (PLAYER_INFO[playerid][TiempoTwitter] - gettime() > 0 && PLAYER_INFO[playerid][TiempoTwitter] - gettime() <= 60) {
                SendClientMessageEx(playerid, -1, "Debes esperar {00CC00}%d{FFFFFF} segundos para volver a enviar otro mensaje.", PLAYER_INFO[playerid][TiempoTwitter] - gettime());
            } else {
                new arank[17];
                switch (PLAYER_INFO[playerid][pVip]) {
                    case 0 : arank = "@";
                    case 1, 2 : arank = "[VIP]";
                    case 3 : arank = "{ec4134}[GVIP]";
                }
                format(string, sizeof(string), "{6099FB}[#Twitter] %s{FFFFFF}%s {6099FB}dice: {ffffff}@%s", arank, PlayerName(playerid), text[1]);
                foreach(new i : Player) {
                    if (CanalTwt[i] == 1) {
                        SendClientMessage(i, 0xFFFFFFFF, string);
                    }
                }
                Webhook_Canales(playerid, text[1], 3, 0);
                if (PLAYER_INFO[playerid][pAdmin] == 0) PLAYER_INFO[playerid][TiempoTwitter] = gettime() + 120;
                return 0;
            }
        }
    }
    if (text[0] == '!' && text[1] != '!') {

        if (PLAYER_INFO[playerid][pTiempoCarcel] > 0 || PLAYER_INFO[playerid][pTiempoJail] > 0) {

            SendClientMessage(playerid, -1, "Te quitaron el radio comunicador antes de meterte en la celda.");
            return 0;
        }
        if (PLAYER_INFO[playerid][pDuty] == 1 && (PLAYER_INFO[playerid][pFaccion] == 1 || PLAYER_INFO[playerid][pFaccion] == 2 || PLAYER_INFO[playerid][pFaccion] == 3)) {
            if (PLAYER_INFO[playerid][pRadio] == 0 && PLAYER_INFO[playerid][pDuty] == 0) return 1;
            new chatadmin[256], banda, rango[50];
            banda = PLAYER_INFO[playerid][pFaccion];
            switch (PLAYER_INFO[playerid][pRango]) {
                case 1 : format(rango, sizeof(rango), "%s", BandasInfo[banda][BRango1]);
                case 2 : format(rango, sizeof(rango), "%s", BandasInfo[banda][BRango2]);
                case 3 : format(rango, sizeof(rango), "%s", BandasInfo[banda][BRango3]);
                case 4 : format(rango, sizeof(rango), "%s", BandasInfo[banda][BRango4]);
                case 5 : format(rango, sizeof(rango), "%s", BandasInfo[banda][BRango5]);
                case 6 : format(rango, sizeof(rango), "%s", BandasInfo[banda][BRango6]);
                case 7 : format(rango, sizeof(rango), "%s", BandasInfo[banda][BRango7]);
                case 8 : format(rango, sizeof(rango), "%s", BandasInfo[banda][BRango8]);
            }
            new color[6 + 1];
            if (PLAYER_INFO[playerid][pFaccion] == 1) color = "3399FF";
            else if (PLAYER_INFO[playerid][pFaccion] == 2) color = "b5773a";
            else if (PLAYER_INFO[playerid][pFaccion] == 3) color = "b6413e";
            format(chatadmin, sizeof(chatadmin), "[Radio] (%s %s) dice: %s", rango, PlayerName(playerid), text[1]);
            ProxDetector(15.0, playerid, chatadmin, COLOR_GRAD6, COLOR_GRAD5, COLOR_GRAD4, COLOR_GRAD3, COLOR_GRAD2);
            format(chatadmin, sizeof(chatadmin), "{%s}[Radio]{ffffff} %s - %s: %s", color, rango, PLAYER_INFO[playerid][Nickname], text[1]);
            SendRadioMessage(1, -1, chatadmin, playerid, Frecuencia[playerid]);
            SendRadioMessage(2, -1, chatadmin, playerid, Frecuencia[playerid]);
            Webhook_Bandas(playerid, text[1]);
            //ReportCrimen(playerid,3);
            return 0;
        } else if (PLAYER_INFO[playerid][pFaccion] > 5) {
            if (PLAYER_INFO[playerid][pDuty] == 1) PLAYER_INFO[playerid][pDuty] = 0;
            if (PLAYER_INFO[playerid][pRadio] > 0) {

                new CrewColorChat = getPlayerCrewColor(playerid);
                new chatadmin[256], banda, rango[50];
                banda = PLAYER_INFO[playerid][pFaccion];
                switch (PLAYER_INFO[playerid][pRango]) {
                    case 1 : format(rango, sizeof(rango), "%s - ", BandasInfo[banda][BRango1]);
                    case 2 : format(rango, sizeof(rango), "%s - ", BandasInfo[banda][BRango2]);
                    case 3 : format(rango, sizeof(rango), "%s - ", BandasInfo[banda][BRango3]);
                    case 4 : format(rango, sizeof(rango), "%s - ", BandasInfo[banda][BRango4]);
                    case 5 : format(rango, sizeof(rango), "%s - ", BandasInfo[banda][BRango5]);
                    case 6 : format(rango, sizeof(rango), "%s - ", BandasInfo[banda][BRango6]);
                    case 7 : format(rango, sizeof(rango), "%s - ", BandasInfo[banda][BRango7]);
                    case 8 : format(rango, sizeof(rango), "%s - ", BandasInfo[banda][BRango8]);
                }
                if (strfind(rango, "=", true) != -1 || strfind(rango, "´", true) != -1 || strfind(rango, "'", true) != -1 || strfind(rango, "`", true) != -1 || strfind(rango, ",", true) != -1 || strfind(rango, "¨", true) != -1 || strfind(rango, "%", true) != -1) return SendClientMessage(playerid, -1, "Tu banda tiene un error en los rangos, contacta al lider.");
                format(chatadmin, sizeof(chatadmin), "[Radio de banda] {FFFFFF}%s dice: %s", PlayerName(playerid), text[1]);
                ProxDetector(15.0, playerid, chatadmin, COLORCARGO0, COLORCARGO0, COLORCARGO0, COLORCARGO0, COLORCARGO0);
                format(chatadmin, sizeof(chatadmin), "[Radio] {FFFFFF}%s - %s dice: %s", rango, PLAYER_INFO[playerid][Nickname], text[1]);
                SendRadioMessage(PLAYER_INFO[playerid][pFaccion], CrewColorChat, chatadmin, playerid, 1);
                Webhook_Bandas(playerid, text[1]);
                return 0;
            }
        } else {
            new string[256];
            if (GetPlayerDrunkLevel(playerid) > 5000) format(string, sizeof(string), "%s alcoholizado dice: %s", PLAYER_INFO[playerid][Nickname], text);
            else if (PLAYER_INFO[playerid][pMascaraPuesta] == 1) format(string, sizeof(string), "Anonymous dice: %s", text);
            format(string, sizeof(string), "%s dice: %s", PlayerName(playerid), text);
            if (PLAYER_TEMP[playerid][@Specteando] == 0) ProxDetector(15.0, playerid, string, Hablar, Hablar2, Hablar3, Hablar4, Hablar5);
            SetPlayerChatBubble(playerid, text, 0xFFFFFFFF, 15.0, 5000);
            return false;
        }
    }
    if (text[0] == '!' && text[1] == '!') {
        if (PLAYER_INFO[playerid][pFaccion] > 0 && PLAYER_INFO[playerid][pFaccion] <= 2) {
            new color[6 + 1];
            if (PLAYER_INFO[playerid][pFaccion] == 1) color = "3399FF";
            else color = "b5773a";
            new chatadmin[256];
            format(chatadmin, sizeof(chatadmin), "{%s}[Radio]{FFFFFF} %s: (( %s ))", color, PLAYER_INFO[playerid][Nickname], text[2]);
            SendRadioFP(PLAYER_INFO[playerid][pFaccion], -1, chatadmin, INVALID_PLAYER_ID);
            Webhook_Bandas(playerid, text[2], 1);
            return 0;
        } else if (PLAYER_INFO[playerid][pFaccion] > 1) {
            if (PLAYER_INFO[playerid][pRadio] > 0) {
                new CrewColorChat = getPlayerCrewColor(playerid);
                new chatadmin[256], rango[50];
                switch (PLAYER_INFO[playerid][pRango]) {
                    case 1 : format(rango, sizeof(rango), "%s", BandasInfo[PLAYER_INFO[playerid][pFaccion]][BRango1]);
                    case 2 : format(rango, sizeof(rango), "%s", BandasInfo[PLAYER_INFO[playerid][pFaccion]][BRango2]);
                    case 3 : format(rango, sizeof(rango), "%s", BandasInfo[PLAYER_INFO[playerid][pFaccion]][BRango3]);
                    case 4 : format(rango, sizeof(rango), "%s", BandasInfo[PLAYER_INFO[playerid][pFaccion]][BRango4]);
                    case 5 : format(rango, sizeof(rango), "%s", BandasInfo[PLAYER_INFO[playerid][pFaccion]][BRango5]);
                    case 6 : format(rango, sizeof(rango), "%s", BandasInfo[PLAYER_INFO[playerid][pFaccion]][BRango6]);
                    case 7 : format(rango, sizeof(rango), "%s", BandasInfo[PLAYER_INFO[playerid][pFaccion]][BRango7]);
                    case 8 : format(rango, sizeof(rango), "%s", BandasInfo[PLAYER_INFO[playerid][pFaccion]][BRango8]);
                }
                format(chatadmin, sizeof(chatadmin), "[Radio] {FFFFFF}%s - %s: (( %s ))", rango, PLAYER_INFO[playerid][Nickname], text[2]);
                SendRadioMessage(PLAYER_INFO[playerid][pFaccion], CrewColorChat, chatadmin, INVALID_PLAYER_ID, 1);
                Webhook_Bandas(playerid, text[2], 1);
                return 0;
            }
        }
    }
    if (PLAYER_INFO[playerid][Mobile] != INVALID_PLAYER_ID) {

        if (PLAYER_INFO[playerid][Mobile] == 2540) {

            if (text[0] == 's' && text[1] == 'i' || text[0] == 'S' && text[1] == 'i' || text[0] == 'S' && text[1] == 'I') {
                new string[256];
                if (PLAYER_INFO[playerid][pMascaraPuesta] == 1) format(string, sizeof(string), "Anonymous (por celular) dice: %s", text);
                format(string, sizeof(string), "%s (por celular) dice: %s", PlayerName(playerid), text);
                if (PLAYER_TEMP[playerid][@Specteando] == 0) ProxDetector(15.0, playerid, string, COLORCARGO0, COLORCARGO0, COLORCARGO0, COLORCARGO0, COLORCARGO0);
                SetTimerEx("LlamadaAceptada", 1000, false, "d", playerid);
                return 0;
            } else if (text[0] == 'n' || text[0] == 'N') {
                new string[256];
                if (PLAYER_INFO[playerid][pMascaraPuesta] == 1) format(string, sizeof(string), "Anonymous (por celular) dice: %s", text);
                format(string, sizeof(string), "%s (por celular) dice: %s", PlayerName(playerid), text);
                if (PLAYER_TEMP[playerid][@Specteando] == 0) ProxDetector(15.0, playerid, string, COLORCARGO0, COLORCARGO0, COLORCARGO0, COLORCARGO0, COLORCARGO0);
                SetTimerEx("LlamadaCancelada", 1000, false, "d", playerid);
                return 0;
            } else SendClientMessage(playerid, -1, "Usa para contestar {"        COLOR_GM "}si{FFFFFF} o {"        COLOR_GM "}no{FFFFFF} enviandolo como chat comon.");
        }

        if (EnLlamada911[playerid] == 911) {
            new string[256];
            if (PLAYER_INFO[playerid][pMascaraPuesta] == 1) format(string, sizeof(string), "Anonymous (por celular) dice: %s", text);
            format(string, sizeof(string), "%s (por celular) {FFFFFF}dice: %s", PlayerName(playerid), text);
            SendClientMessage(PLAYER_INFO[playerid][Mobile], TEAM_BLUE_COLOR, string);
            if (PLAYER_TEMP[playerid][@Specteando] == 0) ProxDetector(15.0, playerid, string, COLOR_WHITE, COLOR_WHITE, COLOR_WHITE, COLOR_WHITE, COLOR_WHITE);
            return 0;
        } else {
            new string[256];
            if (PLAYER_INFO[playerid][pMascaraPuesta] == 1) format(string, sizeof(string), "Anonymous (por celular) dice: %s", text);
            format(string, sizeof(string), "%s (por celular) dice: %s", PlayerName(playerid), text);
            SendClientMessage(PLAYER_INFO[playerid][Mobile], COLOR_DORADO, string);
            if (PLAYER_TEMP[playerid][@Specteando] == 0) ProxDetector(15.0, playerid, string, COLOR_WHITE, COLOR_WHITE, COLOR_WHITE, COLOR_WHITE, COLOR_WHITE);
            return 0;
        }
    }
    new string[256];
    if (IsPlayerInRangeOfPoint(playerid, 1.0, -1191.9042, 2035.5724, 1248.3600) || IsPlayerInRangeOfPoint(playerid, 1.0, 631.2384, -180.1683, 1276.7941)) {
        if (IsPlayerInRangeOfPoint(playerid, 1.0, 631.2384, -180.1683, 1276.7941)) {
            if (PLAYER_INFO[playerid][pDuty] == 1) {
                if (GetPlayerDrunkLevel(playerid) > 1999) format(string, sizeof(string), "%s alcoholizado por microfono: %s", PLAYER_INFO[playerid][Nickname], text);
                else format(string, sizeof(string), "%s por microfono: %s", PlayerName(playerid), text);
                ProxDetector(25.0, playerid, string, 0x00FFFFFF, 0x00FFFFFF, 0x00FFFFFF, 0x00FFFFFF, 0x00FFFFFF);
            } else {
                if (GetPlayerDrunkLevel(playerid) > 5000) format(string, sizeof(string), "%s alcoholizado dice: %s", PLAYER_INFO[playerid][Nickname], text);
                else format(string, sizeof(string), "%s dice: %s", PlayerName(playerid), text);
                if (PLAYER_TEMP[playerid][@Specteando] == 0) ProxDetector(15.0, playerid, string, Hablar, Hablar2, Hablar3, Hablar4, Hablar5);
                SetPlayerChatBubble(playerid, text, 0xFFFFFFFF, 15.0, 5000);
            }
        } else {
            if (GetPlayerDrunkLevel(playerid) > 1999) format(string, sizeof(string), "%s alcoholizado por microfono: %s", PLAYER_INFO[playerid][Nickname], text);
            else format(string, sizeof(string), "%s por microfono: %s", PlayerName(playerid), text);
            ProxDetector(15.0, playerid, string, Hablar, Hablar2, Hablar3, Hablar4, Hablar5);
        }
    } else {
        if (PLAYER_INFO[playerid][pAcento] > 0) {
            if (GetPlayerDrunkLevel(playerid) > 5000) format(string, sizeof(string), "[Acento %s] %s alcoholizado dice: %s", GetNameAcento(PLAYER_INFO[playerid][pAcento]), PlayerName(playerid), dudaColor);
            else format(string, sizeof(string), "[Acento %s] %s dice: %s", GetNameAcento(PLAYER_INFO[playerid][pAcento]), PlayerName(playerid), dudaColor);
        } else if (PLAYER_INFO[playerid][pAcento] == 0 && GetPlayerDrunkLevel(playerid) > 5000) format(string, sizeof(string), "%s alcoholizado dice: %s", PlayerName(playerid), dudaColor);
        else format(string, sizeof(string), "%s dice: %s", PlayerName(playerid), dudaColor);

        if (PLAYER_TEMP[playerid][@Specteando] == 0) ProxDetector(15.0, playerid, string, Hablar, Hablar2, Hablar3, Hablar4, Hablar5);
        SetPlayerChatBubble(playerid, text, 0xFFFFFFFF, 15.0, 5000);
    }
    return 0;
}
