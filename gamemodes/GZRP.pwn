                                for(new e; e != 14; e++) TextDrawShowForPlayer(i, TeleportEvent[e]);
                                SendClientMessageEx(i, 0xFFFFFFFF, "{ffa500}» Evento:{FFFFFF} El administrador {00CC00}%s{FFFFFF} organizo el evento %s, utiliza {DBED15}'/ir evento'{FFFFFf} para entrar.", PLAYER_INFO[playerid][Nickname], NombreEventoDynamic);
                            }
                        }
                        TiempoAnuncioEvento = 30;
                        AnunciadoEvento = true;
                        SendClientMessage(playerid, 0xFFFFFFFF, "{ffa500}» Evento:{FFFFFF} Anunciaste el evento a los no participantes.");
                        MostrarDialogoEvento(playerid);
                    }
                    case 10 :  {
                        if (EventoX == 0) return SendClientMessage(playerid, -1, "{ffa500}» Evento:{FFFFFF} No puedes iniciar el evento hasta que no configures el lugar de spawn."), MostrarDialogoEvento(playerid);
                        switch (EventoStatus) {
