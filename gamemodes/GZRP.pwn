        if (DynamicHousesInfo[i][int_Tipo] == DH_TIPO_TIENDA) {
            floatMapa3Da2D(DynamicHousesInfo[i][int_Pickup_X], DynamicHousesInfo[i][int_Pickup_Y], 360.000000, 26.000000, 256.000000, 256.000000, GPSPOS[i][0], GPSPOS[i][1]);
