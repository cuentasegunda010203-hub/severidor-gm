                	{
                		dialogs_ShowPlayerDialog(playerid,DIALOG_REG_ESTADO,DIALOG_STYLE_INPUT,"{1E29D6}•{FFFFFF} Escribe tu estado","{FFFFFF}Maximo 32 caracteres","Aceptar","Cancelar");
                	}
                	case 1:
