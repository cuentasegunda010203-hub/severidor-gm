        FABRICAS_INFO[ID][f_OBJETO_SNIPER][cb] = CreateDynamicObject(358, PSnipers[cb][0], PSnipers[cb][1], PSnipers[cb][2], PSnipers[cb][3], PSnipers[cb][4], PSnipers[cb][5], FABRICAS_INFO[ID][f_VW], FABRICAS_INFO[ID][f_INTERIOR]);
