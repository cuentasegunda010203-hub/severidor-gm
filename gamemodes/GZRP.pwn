public LoadDoors() {
    new Query[128];
    mysql_format(handle_db, Query, sizeof(Query), "SELECT * FROM `doors`");
    mysql_tquery(handle_db, Query, "LoadDoor");
}

public OnPlayerDownloadedSong(index, response_code, data[]) {
    if (!PLAYER_TEMP[index][pt_PLAYER_WAITING_MP3_HTTP]) return 1;

    if (response_code == 200) {
        if (!strcmp(data, "OK")) {
            new url[128];
            format(url, 128, ""DOWNLOADED_YT_PATH "%s.mp3", PLAYER_TEMP[index][pt_VIDEO_ID]);
            PlayMp3(index, url, PLAYER_TEMP[index][pt_VIDEO_NAME]);
        } else SendClientMessage(index, -1, "Esta cancion no se puede reproducir.");
    } else SendClientMessage(index, -1, "Hubo un problema con el servidor de descarga, intentelo de nuevo mas tarde.");

    PLAYER_TEMP[index][pt_PLAYER_WAITING_MP3_HTTP] = false;
    return 1;
}

PlayMp3(playerid, const url[], song_name[]) {
    if (PLAYER_TEMP[playerid][pt_MUSIC_FOR_PROPERTY]) {
        foreach(new i : Player) {
            if (IsPlayerConnected(i)) {
                PlayAudioStreamForPlayer(i, url);
                SendClientMessageEx(i, -1, "Reproduciendo {00C43E} '%s' {FFFFFF}.", song_name);
            }
        }
        PLAYER_TEMP[playerid][pt_MUSIC_FOR_PROPERTY] = false;
        AccionesRol(playerid, "pone musica en su propiedad.", 20);
    } else if (PLAYER_TEMP[playerid][pt_MUSIC_FOR_VEHICLE]) {
        foreach(new i : Player) {
            if (IsPlayerConnected(i)) {
                if (IsPlayerInAnyVehicle(i)) {
                    if (GetPlayerVehicleID(playerid) == GetPlayerVehicleID(i)) {
                        PlayAudioStreamForPlayer(i, url);
                        SendClientMessageEx(i, -1, "Reproduciendo {00C43E} '%s' {FFFFFF}.", song_name);
                    }
                }
            }
        }
        PLAYER_TEMP[playerid][pt_MUSIC_FOR_VEHICLE] = false;
        AccionesRol(playerid, "pone musica en el vehiculo.", 20);
    } else if (PLAYER_TEMP[playerid][pt_MUSIC_FOR_SPEAKERS]) {
        new Float:pos[3];
        GetPlayerPos(playerid, pos[0], pos[1], pos[2]);

        foreach(new i : Player) {
            if (IsPlayerConnected(i)) {
                if (GetPlayerDistanceFromPoint(i, pos[0], pos[1], pos[2]) <= 30.0) {
                    PlayAudioStreamForPlayer(i, url, pos[0], pos[1], pos[2], 50.0, true);
                    SendClientMessageEx(i, 0xf796bdFF, "* Se escuchan unos altavoces...");
                }
            }
        }
        PLAYER_TEMP[playerid][pt_SPEAKERS_TIME] = gettime();
        PLAYER_TEMP[playerid][pt_MUSIC_FOR_SPEAKERS] = false;
        AccionesRol(playerid, "pone musica de su MP3 en los altavoces.", 20);
    } else {
        PlayAudioStreamForPlayer(playerid, url);
        SendClientMessageEx(playerid, -1, "Reproduciendo {00C43E} '%s' {FFFFFF}.", song_name);
        AccionesRol(playerid, "escucha musica de su MP3 en sus auriculares.", 20);
    }
    return 1;
}
