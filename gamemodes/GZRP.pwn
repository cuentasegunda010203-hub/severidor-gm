CMD:log(playerid, params[]) {
    new string[70];
    if (AdminDuty[playerid] == 0) return SendClientMessage(playerid, -1, "No puedes usar este comando en fuera de servicio administrativo");
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_DUDAS) return 0;

    format(string, 70, "El log del chat fue borrado por {106C24}%s.", PLAYER_INFO[playerid][Nickname]);
    MensajeAdmin(-1, string, 2);
    LimpiarLog(150);
    LimpiarAnuncios();
    return 1;
}
CMD:ir(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) return 0;
    if (AdminDuty[playerid] == 0) return SendClientMessage(playerid, -1, "No puedes usar este comando en fuera de servicio administrativo");

    if (!sscanf(params, "d", params[0])) {

        if (IsPlayerConnected(params[0])) {
            //if(PLAYER_INFO[params[0]][pAdmin] > PLAYER_INFO[playerid][pAdmin]) return SendClientMessage(playerid, COLOR_WHITE, "Error.");
            new Float:p_x, Float:p_y, Float:p_z, vw = GetPlayerVirtualWorld(params[0]), interior = GetPlayerInterior(params[0]);
            GetPlayerPos(params[0], p_x, p_y, p_z);
            if (IsPlayerNPC(params[0])) return SendClientMessage(playerid, COLOR_WHITE, "Esa id es invalida.");
            NoTeleportHack(playerid);
            SetPlayerPos(playerid, p_x, p_y, p_z);
            SetPlayerInterior(playerid, interior);
            SetPlayerVirtualWorld(playerid, vw);
            if (GetPlayerInterior(params[0]) > 0 || GetPlayerVirtualWorld(params[0]) > 0) {
                PLAYER_INFO[playerid][jPosE_x] = PLAYER_INFO[params[0]][jPosE_x];
                PLAYER_INFO[playerid][jPosE_y] = PLAYER_INFO[params[0]][jPosE_y];
                PLAYER_INFO[playerid][jPosE_z] = PLAYER_INFO[params[0]][jPosE_z];
            }
        } else SendClientMessage(playerid, COLOR_WHITE, "Esa id es invalida.");
    }
    return 1;

}
CMD:evento(playerid) {
    if (PLAYER_INFO[playerid][Agonizando] != 0 && Esposando[playerid] != 0) return 1;
    if (PLAYER_TEMP[playerid][pt_PLAYER_EVENTODM] == 1) return SendClientMessage(playerid, -1, "No puedes usar en este momento tu mochila.");
    if (PLAYER_INFO[playerid][pTiempoCarcel] > 0 || PLAYER_INFO[playerid][pTiempoJail] > 0) return SendClientMessage(playerid, -1, "No puedes ir al evento en estos momento.");
    if (EventoStatus == false) return SendClientMessage(playerid, 0xFFFFFFFF, "No hay ningun evento activo en este momento.");
    GetPlayerPos(playerid, BeforeEventX[playerid], BeforeEventY[playerid], BeforeEventZ[playerid]);
    GetPlayerFacingAngle(playerid, BeforeEventA[playerid]);
    BeforeEventInt[playerid] = GetPlayerInterior(playerid);
    BeforeEventVw[playerid] = GetPlayerVirtualWorld(playerid);
    SetPosEx(playerid, EventoX, EventoY, EventoZ, EventoA, EventoInt, EventoVw, 1);
    JugandoEventoDinamico[playerid] = true;

    return 1;
}
