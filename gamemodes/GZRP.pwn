                DarArma(playerid, ArmaVender[playerid]);
                QuitarArma(VendedorArma[playerid], GetPlayerWeapon(playerid));
                DarDinero(VendedorArma[playerid], PrecioArma[playerid]);
            } else return Notificador2(playerid, "~w~Rechazaste la oferta");
        }
