funcion A_Reloj() {
    new RconCommand[50], time[3];
    gettime(time[0], time[1], time[2]);
    if (time[0] >= 12) format(RconCommand, 32, "worldtime Son las %02d:%02d PM", (time[0] == 12) ? (12) : (time[0] - 12), time[1]);
    else if (time[0] < 12) format(RconCommand, 32, "worldtime Son las %02d:%02d AM", (time[0] == 0) ? (12) : (time[0]), time[1]);
    //SetServerRule("hora", RconCommand);
    SendRconCommand(RconCommand);
    return 1;
}

