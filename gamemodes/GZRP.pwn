            mysql_format(handle_db, Query, sizeof(Query), "UPDATE `p_vehicles` SET `Color1`='%d',`Color2`='%d' WHERE id = '%d'", color_1, color_2, PLAYER_INFO[playerid][vID5]);
            mysql_tquery(handle_db, Query);
        } else if (PLAYER_INFO[playerid][pFaccion] != 0) {
            new vehicleid = GetPlayerVehicleID(playerid);
            if (IsPlayerInAnyVehicle(playerid) && vehicleid != INVALID_VEHICLE_ID && GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
                new slot = GetVehicleFaccionSlot(vehicleid, PLAYER_INFO[playerid][pFaccion]);
                if (IsVehicleFaccion(vehicleid, PLAYER_INFO[playerid][pFaccion])) {
                    GetVehicleColor(vehicleid, color_1, color_2);
                    PLAYER_INFO[playerid][v4Color1] = color_1;
                    PLAYER_INFO[playerid][v4Color2] = color_2;

                    mysql_format(handle_db, Query, sizeof(Query), "UPDATE `p_vehicles` SET `Componentes1`='%d',`Componentes2`='%d',`Componentes3`='%d',`Componentes4`='%d',`Componentes5`='%d',`Componentes6`='%d',`Componentes7`='%d' WHERE id = '%d'", GetVehicleComponentInSlot(vehicleid, 1), GetVehicleComponentInSlot(vehicleid, 2), GetVehicleComponentInSlot(vehicleid, 3), GetVehicleComponentInSlot(vehicleid, 4), GetVehicleComponentInSlot(vehicleid, 5), GetVehicleComponentInSlot(vehicleid, 6), GetVehicleComponentInSlot(vehicleid, 7), BandasInfo[PLAYER_INFO[playerid][pFaccion]][bVehFac][slot]);
                    mysql_tquery(handle_db, Query);
                    mysql_format(handle_db, Query, sizeof(Query), "UPDATE `p_vehicles` SET `Componentes8`='%d',`Componentes9`='%d',`Componentes10`='%d',`Componentes11`='%d',`Componentes12`='%d',`Componentes13`='%d',`Componentes0`='%d' WHERE id = '%d'", GetVehicleComponentInSlot(vehicleid, 8), GetVehicleComponentInSlot(vehicleid, 9), GetVehicleComponentInSlot(vehicleid, 10), GetVehicleComponentInSlot(vehicleid, 11), GetVehicleComponentInSlot(vehicleid, 12), GetVehicleComponentInSlot(vehicleid, 13), GetVehicleComponentInSlot(vehicleid, 0), BandasInfo[PLAYER_INFO[playerid][pFaccion]][bVehFac][slot]);
                    mysql_tquery(handle_db, Query);
                }
            }

        }
    }
    return 1;
}

