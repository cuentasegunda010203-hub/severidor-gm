        case D_RECEPDEPA2: //Timestamp() + 2 * 86400;
        {
            if (!response) return OcultarCartelCD(playerid);
            if (PLAYER_INFO[playerid][pTiempoDepa] != 0) return Notificador2(playerid, "Ya tienes un departamento comprado.");
            if (PLAYER_INFO[playerid][Totems] < 90) return Notificador2(playerid, "No tienes suficientes Totems (90)"), OcultarCartelCD(playerid);
            PLAYER_INFO[playerid][pTiempoDepa] += gettime() + 31 * 86400;
            new month, day, year;
            gmtime(PLAYER_INFO[playerid][pTiempoDepa], year, month, day);
            Notificador2(playerid, "!Compraste un departamento¡ dirígete al ascensor para ingresar.");
            PLAYER_INFO[playerid][Totems] -= 90;
            OcultarCartelCD(playerid);
            GuardarCuenta(playerid);
