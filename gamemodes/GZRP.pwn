CMD:forcar(playerid, params[]) { return callcmd::forzar(playerid, params); }
CMD:proteger(playerid, params[]) { return callcmd::cubrir(playerid, params); }
CMD:colete(playerid, params[]) { return callcmd::chaleco(playerid, params); }
CMD:prender(playerid, params[]) { return callcmd::arrestar(playerid, params); }

CMD:offsapd(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] > ADMIN_LEVEL_BANEOS) {
        SetPlayerColor(playerid, COLOR_WHITE);
        frecuencias[Frecuencia[playerid]]--;
        Frecuencia[playerid] = 0;
        SendClientMessage(playerid, -1, "Dejaste el uniforme de policia y recuperaste tu ropa.");
        SetPlayerSkin(playerid, PLAYER_INFO[playerid][jRopa]);
        RemovePlayerAttachedObject(playerid, 4);
        RemovePlayerAttachedObject(playerid, 5);
        PLAYER_INFO[playerid][pDuty] = 0;
        if (PLAYER_INFO[playerid][j_ARMAS][1] == 3) QuitarArma(playerid, 3);
        ResetPlayerWeapons(playerid);
        RopaMine[playerid] = 0, RopaMedi[playerid] = 0, RopaBasu[playerid] = 0, RopaMeca[playerid] = 0;
        DarArmas(playerid);
    }
    return 1;
}

CMD:conteo(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_DUDAS) return SendClientMessage(playerid, COLOR_GRAD2, "{E11111}[>!<] {FFFFFF}No puedes usar este comando");

    if (EnConteo == true) return SendClientMessage(playerid, -1, "Ya hay un conteo en curso.");
    new TiempoConteo;
    if (sscanf(params, "i", TiempoConteo)) return SendClientMessage(playerid, -1, "USO: /conteo [segundos]");
    if (TiempoConteo < 3 || TiempoConteo > 10) return SendClientMessage(playerid, -1, "Los segundos deben estar entre 3 y 10.");
    EnConteo = true;
    SetTimerEx("Conteos", 1000, false, "i", TiempoConteo);
    return 1;
}
CMD:npckick(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM_TEMP) return 0;
    foreach(new i : Player) {
        if (IsPlayerNPC(i)) {
            ExpulsarJugador(i, "Npc's kickeados.");
        }
    }
    SendClientMessage(playerid, -1, "NPCs Kickeados.");
    npctoggle = 0;
    return 1;
}
RepararSerg(playerid) {
    PutPlayerInVehicle(playerid, NPC_Tren[4], 0);
    SetPlayerSkin(playerid, 71);
    PLAYER_INFO[playerid][pDuty] = 1;
    ColorJugadorDefault(playerid);
}
CMD:repararsergio(playerid) {
    new npcname[MAX_PLAYER_NAME];
    foreach(new i : Player) {
        if (IsPlayerNPC(i)) {
            GetPlayerName(i, npcname, sizeof(npcname));
            if (!strcmp(npcname, ".Sergio", true)) RepararSerg(i);
        }
    }
    return 1;
}
CMD:rnpcid(playerid, params[]) {
    new ID;
    if (sscanf(params, "u", ID)) return SendClientMessage(playerid, -1, "Escribe {009AFF}/rnpcid {FFFFFF}<NPCID>");
    if (!IsPlayerConnected(ID)) return SendClientMessage(playerid, -1, "El NPC esta desconectado.");
    if (ID == playerid) return SendClientMessage(playerid, -1, "No te puedes hacer esto.");
    RepararSerg(ID);
    return 1;
}
CMD:apagar(playerid, params[]) {
    new string[50];
    if (strcmp(params, "radio", true) == 0) {
        if (EnRadio(playerid)) {
            for(new p = 1; p < MAX_PROPIEDADES; p++) {
                if (GetPlayerVirtualWorld(playerid) == PropInfo[p][pVW]) {
                    if (PropInfo[p][pEmisora] == 0) return SendClientMessage(playerid, -1, "La radio ya se encuentra apagada.");
                    PropInfo[p][pEmisora] = 0;
                    format(string, sizeof(string), "%s cambia de emisora.", PLAYER_INFO[playerid][Nickname]);
                    ProxDetector(30.0, playerid, string, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO);
                    foreach(new i : Player) {
                        if (!IsPlayerConnected(i) || IsPlayerNPC(i))
                            continue;
                        if (GetPlayerVirtualWorld(i) == PropInfo[p][pVW]) {
                            SendClientMessage(i, -1, "Ya no se escucha la radio.");
                            PararEmisora(i);
                        }
                    }
                    return 1;
                }
            }
        } else return SendClientMessage(playerid, -1, "Necesitas estar junto a una radio para poder apagarla.");
    }
    return 1;
}
CMD:npcjoin(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM_TEMP) return 0;
    if (npctoggle == 0) {
        LoadNPCs();
        SendClientMessage(playerid, -1, "NPCs Cargados.");
    } else {
        SendClientMessage(playerid, -1, " Todos los NPC estan cargados, para re-cargarlos use /npckick y despues use este comando.");
    }
    return 1;
}
CMD:ubicar(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM) return 0;
    if (!sscanf(params, "u", params[0])) {

        if (!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, "La ID es invalida.");
        new Float:X, Float:Y, Float:Z, zone[MAX_ZONE_NAME], string[256];
        GetPlayer3DZone(params[0], zone, MAX_ZONE_NAME);
        GetPlayerPos(params[0], X, Y, Z);
        StartPlayerPath(playerid, X, Y, Z, 6);
        format(string, sizeof(string), "[Busqueda]{FFFFFF} {00C7FF}%s{FFFFFF}(%d) fue visto por ultimas ves en %s.", PLAYER_INFO[params[0]][Nickname], params[0], zone);
        SendClientMessage(playerid, COLOR_YELLOW, string);
    } else SendClientMessage(playerid, -1, "Utilize: /ubicar [Nombre_Jugador/ID]");
    return 1;
}
CMD:sanoff(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_GLOBAL) return 0;
    new tiempo, JugadorSancionado[25], RazonSan[128];
    if (sscanf(params, "ds[25]s[128]s[128]", tiempo, JugadorSancionado, RazonSan)) return SendClientMessage(playerid, -1, "Modo de uso: /sanoff [Tiempo] [Nombre_Apellido] [Razon]");
    new DB_Query[128];
    format(DB_Query, sizeof DB_Query, "SELECT `ID` FROM `usuarios` WHERE `Username`='%e';", JugadorSancionado);
    mysql_tquery(handle_db, DB_Query, "SelectJugadorASan", "ddss", playerid, tiempo, JugadorSancionado, RazonSan);
    return 1;
}
CMD:recargarcamello(playerid) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_GLOBAL) return 0;
    CrackCamello = 1500;
    MarihuanaCamello = 1500;
    MedicamentosCamello = 1500;
    DineroCamello = 20000;
    SendClientMessage(playerid, -1, "Camello recargado.");
    return 1;
}

CMD:academia(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] <= ADMIN_LEVEL_DUDAS) return 0;
    SetPosEx(playerid, 2339.4460, 2334.3179, 10.8203, 231.5187, 0, 0, 0);
    return 1;
}
CMD:cargos(playerid, params[]) {
    new string[148], texto[100], id, cargos;
    if (PLAYER_INFO[playerid][pFaccion] != 1 && PLAYER_INFO[playerid][pFaccion] != 2) return 1;
    if (sscanf(params, "rd", id, cargos)) return SendClientMessage(playerid, -1, "Escribe {"COLOR_GM "}/cargos [ID] {FFFFFF}[{"COLOR_GM "}Cargos{FFFFFF}]");
    if (!IsPlayerConnected(id)) return SendClientMessage(playerid, COLORCARGO0, "No se encontro ningun jugador.");
    if (IsPlayerNPC(id)) return 1;
    if (PLAYER_INFO[id][pFaccion] == 1 && cargos != 0 && PLAYER_INFO[id][pDuty] != 0) return SendClientMessage(playerid, -1, "{"COLOR_GM "}Le estas intentado poner nivel de busqueda a un policia.");
    if (PLAYER_INFO[id][pCargos] == cargos) return SendClientMessage(playerid, -1, "Ese jugador ya tiene los mismos cargos.");
    if (cargos < 0 || cargos > 6) return SendClientMessage(playerid, -1, "Escribe {"COLOR_GM "}/cargos [ID] {FFFFFF}[{"COLOR_GM "}Cargos{FFFFFF}]");
    if (!EstaEnP(playerid, id, 400)) return SendClientMessage(playerid, -1, "Debes estar a 400 metros de la persona para colocarle cargos.");
    PLAYER_INFO[id][pCargos] = cargos;
    if (cargos == 0) { ActualizarRadar(); }
    SetPlayerWantedLevelEx(id, PLAYER_INFO[id][pCargos]);
    ReportCrimen(id, cargos);
    if (PLAYER_INFO[playerid][pDuty] == 0 && cargos == 0) SendClientMessage(id, -1, "Un policia de civil te quito los cargos.");
    if (PLAYER_INFO[playerid][pDuty] == 0 && cargos > 0) SendClientMessage(id, -1, "Un policia de civil te puso cargos.");
    new asdf[150];
    if (cargos == 0) format(asdf, 150, "Nadie"), Advertido[id] = 0;
    else format(asdf, 150, "%s", PLAYER_INFO[playerid][Nickname]);
    PLAYER_INFO[id][QuienC] = asdf;
    switch (cargos) {

        case 0 : format(texto, sizeof(texto), "tiene todo en orden, lo dejo continuar");
        case 1:
            format(texto, sizeof(texto), "parece sospechoso, lo voy a interrogar"), SendClientMessage(id, COLOR_YELLOW, "La policia quiere hablar con usted, si se da a la fuga, sera arrestado.");
        case 2 : format(texto, sizeof(texto), "se da a la fuga, procedemos a su persecucion");
        case 3 : format(texto, sizeof(texto), "se encuentra armado, procedan con precaucion");
        case 4 : format(texto, sizeof(texto), "abrio fuego, necesito refuerzos");
        case 5 : format(texto, sizeof(texto), "asesino, detener vivo o muerto");
        case 6 : format(texto, sizeof(texto), "es extremadamente peligroso, disparen a matar");
    }
    CagoSeguro[id] = 0;
    BuscarCriminales();
    format(string, sizeof(string), "[Radio SAPD - SATA] (%s) dice: %s %s", PLAYER_INFO[playerid][Nickname], PLAYER_INFO[id][Nickname], texto);
    ProxDetector(15.0, playerid, string, COLOR_GRAD6, COLOR_GRAD5, COLOR_GRAD4, COLOR_GRAD3, COLOR_GRAD2);
    format(string, sizeof(string), "[Central]{FFFFFF} %s reportando: {00CCFF}%s{FFFFFF} [%d] %s. {"COLOR_GM "}(%d)*", PLAYER_INFO[playerid][Nickname], PLAYER_INFO[id][Nickname], id, texto, cargos);
    SendRadioMessage(1, -1, string, playerid, 1);
    return 1;
}
CMD:w(playerid, params[]) {
    new id, msj[128], string[256];
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) return 1;
    if (!sscanf(params, "ds[128]", id, msj)) {
        format(string, sizeof(string), "{DBDE50}%s (%d) te envia un mp: %s", PLAYER_INFO[playerid][Nickname], playerid, msj);
        SendClientMessage(id, COLOR_WHITE, string);
        format(string, sizeof(string), "{DBDE50}Mensaje privado a %s (%d): %s", PLAYER_INFO[id][Nickname], id, msj);
        SendClientMessage(playerid, COLOR_WHITE, string);
    }
    return 1;
}

CMD:fixid(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) return 0;
    if (sscanf(params, "r", params[0])) return SendClientMessage(playerid, -1, "Escribe {009AFF}/fixid {FFFFFF}<PlayerID>");
    if (IsPlayerNPC(params[0])) return 1;
    if (!IsPlayerConnected(params[0])) return SendClientMessage(playerid, 0x25AB26FF, "Jugador no conectado");
    SetPosEx(params[0], 1510.2300, -1671.5197, 14.0469, 0, 0, 0, 0);
    SetPlayerInterior(params[0], 0);
    SetPlayerVirtualWorld(params[0], 0);
    SetCameraBehindPlayer(params[0]);
    return 1;
}
CMD:plantas(playerid, params[]) {
    new string[200];
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LVL_GLOBAL1) return 0;
    new plantas = 0;
    for(new p = 0; p < MAX_MARIHUANA; p++) {
        if (MariInfo[p][Creado] == 1 && MariInfo[p][State] != 0) plantas++;
    }
    format(string, sizeof(string), "Hay {00cc00}%d{FFFFFF} plantas de marihuana creadas en el servidor.", plantas);
    SendClientMessage(playerid, -1, string);
    return 1;
}

CMD:irmaria(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LVL_GLOBAL1) return 0;
    new id, string[150];
    if (sscanf(params, "d", id)) return SendClientMessage(playerid, -1, "Usa {DBED15}/irmaria [ID]");
    if (MariInfo[id][State] == 0) return SendClientMessage(playerid, -1, "ID invalida.");
    format(string, sizeof(string), "Fuiste a la posicion de la planta ID {DBED15}%d", id);
    SendClientMessage(playerid, -1, string);
    SetPosEx(playerid, MariInfo[id][pX], MariInfo[id][pY], MariInfo[id][pZ], 0, 0, 0);
    return true;
}

CMD:destruirmaria(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LVL_GLOBAL1) return 0;
    new id, string[150];
    if (sscanf(params, "d", id)) return SendClientMessage(playerid, -1, "Usa {DBED15}/destruirmaria [ID]");
    if (MariInfo[id][State] == 0) return SendClientMessage(playerid, -1, "ID invalida.");
    format(string, sizeof(string), "Destruiste la planta ID {DBED15}%d", id);
    SendClientMessage(playerid, -1, string);
    DestroyDynamicObjectEx(MariInfo[id][ObjetoID]);
    DestroyDynamic3DTextLabel(MariInfo[id][Label]);
    MariInfo[id][State] = 0;
    MariInfo[id][Creado] = 0;
    MariInfo[id][pX] = 0;
    MariInfo[id][pY] = 0;
    MariInfo[id][pZ] = 0;
    format(MariInfo[id][Plantador], 24, "Nadie");
    return true;
}
