// Pantalla de transicion: comparte el tiempo del cargador original de mapeos.
stock RP_HideInteriorLoading(playerid) {
    if (RP_LoadingProgressTimer[playerid]) KillTimer(RP_LoadingProgressTimer[playerid]);
    RP_LoadingProgressTimer[playerid] = 0;
    if (RP_LoadingVisible[playerid]) {
        for (new i = 0; i < 5; i++) {
            PlayerTextDrawHide(playerid, RP_LoadingTD[playerid][i]);
            PlayerTextDrawDestroy(playerid, RP_LoadingTD[playerid][i]);
        }
    }
    RP_LoadingVisible[playerid] = false;
    new hudMask = RP_LoadingHudMask[playerid];
    RP_LoadingHudMask[playerid] = 0;
    if (IsPlayerConnected(playerid) && !IsPlayerNPC(playerid))
        for (new stat = 0; stat < 4; stat++)
            if (hudMask & (1 << stat)) RP_HUDShowStat(playerid, stat);
    return 1;
}
stock RP_ClearInteriorLoading(playerid) {
    RP_HideInteriorLoading(playerid);
    if (RP_MapLoadTimer[playerid]) KillTimer(RP_MapLoadTimer[playerid]);
    RP_MapLoadTimer[playerid] = 0;
    return 1;
}
stock RP_ShowInteriorLoading(playerid) {
    if (!IsPlayerConnected(playerid) || IsPlayerNPC(playerid)) return 0;
    if (RP_LoadingVisible[playerid]) return 1;
    RP_LoadingTD[playerid][0] = CreatePlayerTextDraw(playerid, -10.0, -10.0, "_");
    RP_LoadingTD[playerid][1] = CreatePlayerTextDraw(playerid, 320.0, 193.0, "~r~Cargando ~w~objetos");
    RP_LoadingTD[playerid][2] = CreatePlayerTextDraw(playerid, 320.0, 240.0, "Espera mientras se cargan los objetos del lugar.");
    RP_LoadingTD[playerid][3] = CreatePlayerTextDraw(playerid, 220.0, 277.0, "LD_SPAC:white");
    RP_LoadingTD[playerid][4] = CreatePlayerTextDraw(playerid, 222.0, 279.0, "LD_SPAC:white");
    for (new i = 0; i < 5; i++) {
        if (RP_LoadingTD[playerid][i] == PlayerText:INVALID_TEXT_DRAW) {
            for (new j = 0; j < 5; j++)
                if (RP_LoadingTD[playerid][j] != PlayerText:INVALID_TEXT_DRAW)
                    PlayerTextDrawDestroy(playerid, RP_LoadingTD[playerid][j]);
            return 0;
        }
        PlayerTextDrawSetSelectable(playerid, RP_LoadingTD[playerid][i], false);
    }
    PlayerTextDrawLetterSize(playerid, RP_LoadingTD[playerid][0], 0.0, 52.0);
    PlayerTextDrawTextSize(playerid, RP_LoadingTD[playerid][0], 650.0, 0.0);
    PlayerTextDrawUseBox(playerid, RP_LoadingTD[playerid][0], true);
    PlayerTextDrawBoxColor(playerid, RP_LoadingTD[playerid][0], 0x000000FF);
    PlayerTextDrawFont(playerid, RP_LoadingTD[playerid][1], 3);
    PlayerTextDrawLetterSize(playerid, RP_LoadingTD[playerid][1], 0.65, 2.7);
    PlayerTextDrawAlignment(playerid, RP_LoadingTD[playerid][1], 2);
    PlayerTextDrawColor(playerid, RP_LoadingTD[playerid][1], 0xFFFFFFFF);
    PlayerTextDrawSetOutline(playerid, RP_LoadingTD[playerid][1], 1);
    PlayerTextDrawFont(playerid, RP_LoadingTD[playerid][2], 1);
    PlayerTextDrawLetterSize(playerid, RP_LoadingTD[playerid][2], 0.24, 1.2);
    PlayerTextDrawAlignment(playerid, RP_LoadingTD[playerid][2], 2);
    PlayerTextDrawColor(playerid, RP_LoadingTD[playerid][2], 0xFFFFFFFF);
    PlayerTextDrawSetShadow(playerid, RP_LoadingTD[playerid][2], 0);
    PlayerTextDrawFont(playerid, RP_LoadingTD[playerid][3], 4);
    PlayerTextDrawTextSize(playerid, RP_LoadingTD[playerid][3], 200.0, 10.0);
    PlayerTextDrawColor(playerid, RP_LoadingTD[playerid][3], 0x555555FF);
    PlayerTextDrawFont(playerid, RP_LoadingTD[playerid][4], 4);
    PlayerTextDrawTextSize(playerid, RP_LoadingTD[playerid][4], 1.0, 6.0);
    PlayerTextDrawColor(playerid, RP_LoadingTD[playerid][4], 0xE53935FF);
    if (RP_InvVisible[playerid]) Menu_CerrarInventario(playerid);
    RP_LoadingHudMask[playerid] = 0;
    for (new stat = 0; stat < 4; stat++) {
        if (RP_HUDVisible[playerid][stat]) RP_LoadingHudMask[playerid] |= (1 << stat);
        RP_HUDHideStat(playerid, stat);
    }
    RP_LoadingVisible[playerid] = true;
    for (new i = 0; i < 5; i++) PlayerTextDrawShow(playerid, RP_LoadingTD[playerid][i]);
    RP_LoadingStart[playerid] = GetTickCount();
    RP_LoadingDuration[playerid] = 3500;
    RP_LoadingProgressTimer[playerid] = SetTimerEx("RP_LoadingProgress", 100, true, "i", playerid);
    return 1;
}
public RP_LoadingProgress(playerid) {
    if (!IsPlayerConnected(playerid) || !RP_LoadingVisible[playerid]) {
        RP_HideInteriorLoading(playerid);
        return 1;
    }
    new elapsed = GetTickCount() - RP_LoadingStart[playerid];
    new Float:progress = float(elapsed) / float(RP_LoadingDuration[playerid] - 200);
    if (progress < 0.0) progress = 0.0;
    if (progress > 1.0) progress = 1.0;
    PlayerTextDrawTextSize(playerid, RP_LoadingTD[playerid][4], 1.0 + 195.0 * progress, 6.0);
    PlayerTextDrawShow(playerid, RP_LoadingTD[playerid][4]);
    return 1;
}
stock CargarMapeosEx(playerid, time = 3, mostrar = 1) {
    NoTeleportHack(playerid);
    TogglePlayerControllable(playerid, 0);
    if (mostrar == 1 && !RP_LoadingVisible[playerid]) GameTextForPlayerEx(playerid, "~r~Cargando...~n~~w~Espera por favor", time, 4);
    if (RP_MapLoadTimer[playerid]) KillTimer(RP_MapLoadTimer[playerid]);
    RP_MapLoadTimer[playerid] = SetTimerEx("DesCargarMapeosEx", time * 1000 + 500, false, "i", playerid);
    if (RP_LoadingVisible[playerid]) {
        RP_LoadingStart[playerid] = GetTickCount();
        RP_LoadingDuration[playerid] = time * 1000 + 500;
    }
    SetPVarInt(playerid, "IsFrozen", 0);
    return 1;
}
stock VerTiempos(playerid, id) {
    if (Jail[id] == 1) {
        new string[256];
        if (PLAYER_INFO[id][pTiempoCarcel] < 60) format(string, sizeof(string), "Tiempo restante para cumplir la condena: {00CC00}%ds{FFFFFF}.", PLAYER_INFO[id][pTiempoCarcel]);
        else if (PLAYER_INFO[id][pTiempoCarcel] >= 60) format(string, sizeof(string), "Tiempo restante para cumplir la condena: {00CC00}%dm %ds{FFFFFF}.", PLAYER_INFO[id][pTiempoCarcel] / 60, PLAYER_INFO[id][pTiempoCarcel] % (60));
        SendClientMessage(playerid, -1, string);
    } else if (PLAYER_INFO[id][pTiempoJail] > 0) {
        new string[256];
        if (PLAYER_INFO[id][pTiempoJail] < 60) format(string, sizeof(string), "Tiempo restante para cumplir la condena: {00CC00}%ds{FFFFFF}.", PLAYER_INFO[id][pTiempoJail]);
        else if (PLAYER_INFO[id][pTiempoJail] >= 60) format(string, sizeof(string), "Tiempo restante para cumplir la condena: {00CC00}%dm %ds{FFFFFF}.", PLAYER_INFO[id][pTiempoJail] / 60, PLAYER_INFO[id][pTiempoJail] % (60));
        SendClientMessage(playerid, -1, string);
    }
    return 1;
}
stock VerSuspension(playerid, id) {
    if (PLAYER_INFO[id][suspendido] > 0) {
        new string[256];
        if (PLAYER_INFO[id][suspendido] < 60) format(string, sizeof(string), "Tiempo restante suspendido {00CC00}%ds{FFFFFF}.", PLAYER_INFO[id][pTiempoJail]);
        else if (PLAYER_INFO[id][suspendido] >= 60) format(string, sizeof(string), "Tiempo restante para cumplir la suspension: {00CC00}%dm %ds{FFFFFF}.", PLAYER_INFO[id][pTiempoJail] / 60, PLAYER_INFO[id][pTiempoJail] % (60));
        SendClientMessage(playerid, -1, string);
    }
    return 1;
}
stock VehicleToPoint(Float:radi, vehicleid, Float:x, Float:y, Float:z) {
    new Float:oldposx, Float:oldposy, Float:oldposz;
    new Float:tempposx, Float:tempposy, Float:tempposz;
    GetVehiclePos(vehicleid, oldposx, oldposy, oldposz);
    tempposx = (oldposx - x);
    tempposy = (oldposy - y);
    tempposz = (oldposz - z);
    if (((tempposx < radi) && (tempposx > -radi)) && ((tempposy < radi) && (tempposy > -radi)) && ((tempposz < radi) && (tempposz > -radi))) {
        return 1;
    }
    return 0;
}

stock ColocarCombate(playerid) {
    if (EnCombate[playerid] == 0) {
        TimerCombate[playerid] = SetTimerEx("TextoCombate", 800, true, "d", playerid);
        EnCombate[playerid] = 1;
        PLAYER_TIMES[playerid][TiempoCombate] = 40;
    } else if (EnCombate[playerid] == 1) PLAYER_TIMES[playerid][TiempoCombate] = 40;
}

stock GetNumberOfPlayersOnThisIP(const test_ip[]) {
    new against_ip[32 + 1];
    new x = 0;
    new ip_count = 0;
    for(x = 0; x <= GetPlayerPoolSize(); x++) {
        if (IsPlayerConnected(x) && !IsPlayerNPC(x)) {
            GetPlayerIp(x, against_ip, 32);
            if (!strcmp(against_ip, test_ip)) ip_count++;
        }
    }
    return ip_count;
}

stock QueMes(month) {
    new rango[15];
    if (month == 1) format(rango, sizeof(rango), "Enero");
    if (month == 2) format(rango, sizeof(rango), "Febrero");
    if (month == 3) format(rango, sizeof(rango), "Marzo");
    if (month == 4) format(rango, sizeof(rango), "Abril");
    if (month == 5) format(rango, sizeof(rango), "Mayo");
    if (month == 6) format(rango, sizeof(rango), "Junio");
    if (month == 7) format(rango, sizeof(rango), "Julio");
    if (month == 8) format(rango, sizeof(rango), "Agosto");
    if (month == 9) format(rango, sizeof(rango), "Septiembre");
    if (month == 10) format(rango, sizeof(rango), "Octubre");
    if (month == 11) format(rango, sizeof(rango), "Noviembre");
    if (month == 12) format(rango, sizeof(rango), "Diciembre");
    return rango;
}
stock ObtenerEstadoSalud(playerid) {
    new Float:vida;
    GetPlayerHealth(playerid, vida);
    if (vida > 0 && vida < 11) PLAYER_INFO[playerid][pEnfermedad] = 10;
    else if (vida > 10 && vida < 21) PLAYER_INFO[playerid][pEnfermedad] = 1;
    else if (vida > 20 && vida < 31) PLAYER_INFO[playerid][pEnfermedad] = 3;
    else if (vida > 30 && vida < 41) PLAYER_INFO[playerid][pEnfermedad] = 2;
    else if (vida > 40 && vida < 51) PLAYER_INFO[playerid][pEnfermedad] = 5;
    else if (vida > 50 && vida < 61) PLAYER_INFO[playerid][pEnfermedad] = 8;
    else if (vida > 60 && vida < 71) PLAYER_INFO[playerid][pEnfermedad] = 7;
    else if (vida > 70 && vida < 81) PLAYER_INFO[playerid][pEnfermedad] = 6;
    else if (vida > 80 && vida < 91) PLAYER_INFO[playerid][pEnfermedad] = 9;
    else if (vida > 90 && vida < 100) PLAYER_INFO[playerid][pEnfermedad] = 4;
    else PLAYER_INFO[playerid][pEnfermedad] = 4;
    return 1;
}
stock SetPosEx(playerid, Float:X, Float:Y, Float:Z, Float:A, interiorid, worldid, congelar = 1) {
    if (congelar == 1 || interiorid > 0 || GetPlayerInterior(playerid) > 0) RP_ShowInteriorLoading(playerid);
    NoTeleportHack(playerid);
    if (interiorid > 0) GetPlayerPos(playerid, PLAYER_INFO[playerid][jPosE_x], PLAYER_INFO[playerid][jPosE_y], PLAYER_INFO[playerid][jPosE_z]), CargarMapeosEx(playerid);
    if (congelar == 1) CargarMapeosEx(playerid);
    SetPlayerPos(playerid, X, Y, Z);
    SetPlayerFacingAngle(playerid, A);
    SetPlayerInterior(playerid, interiorid);
    SetPlayerVirtualWorld(playerid, worldid);
    Streamer_UpdateEx(playerid, X, Y, Z, worldid, interiorid, STREAMER_TYPE_OBJECT);
    if (interiorid == 0) GetPlayerPos(playerid, PLAYER_INFO[playerid][jPosE_x], PLAYER_INFO[playerid][jPosE_y], PLAYER_INFO[playerid][jPosE_z]);
    return 1;
}

stock SetPosEntrar(playerid, Float:X, Float:Y, Float:Z, Float:A, interiorid, worldid, tienda = 0) {
    HV_RemoveForPlayer(playerid, interiorid, X, Y, Z, worldid);
    //if(GetPlayerSpeed(playerid) > 5) return 1;
    if (IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, "Tienes que estar parado en la puerta de la propiedad para poder entrar.");
    RP_ShowInteriorLoading(playerid);
    if (tienda == 1) SendClientMessage(playerid, -1, "Ingresaste a un supermercado {"COLOR_GM "}24/7{FFFFFF}, para comprar productos escribe {"COLOR_GM "}/comprar productos{FFFFFF}.");
    if (interiorid > 0) GetPlayerPos(playerid, PLAYER_INFO[playerid][jPosE_x], PLAYER_INFO[playerid][jPosE_y], PLAYER_INFO[playerid][jPosE_z]);
    NoTeleportHack(playerid);
    CargarMapeosEx(playerid);
    SetPlayerPos(playerid, X, Y, Z);
    SetPlayerFacingAngle(playerid, A);
    SetPlayerInterior(playerid, interiorid);
    SetPlayerVirtualWorld(playerid, worldid);
    Streamer_UpdateEx(playerid, X, Y, Z, worldid, interiorid, STREAMER_TYPE_OBJECT);
    if (interiorid == 0) GetPlayerPos(playerid, PLAYER_INFO[playerid][jPosE_x], PLAYER_INFO[playerid][jPosE_y], PLAYER_INFO[playerid][jPosE_z]);
    return 1;
}
stock AnticheatLZ(color, const string[], level) {
    foreach(new i : Player) {
        if (PLAYER_INFO[i][pAdmin] >= level && VerAnticheat[i] == 1) SendClientMessage(i, color, string);
    }
    if (LOG_DC == 0) {
        //DCC_SendChannelMessage(discord_channel_id, string);
    }
    return 1;
}
stock AnticheatLZEx(level, color, const form[], { Float, _ }: ...) {
	#pragma unused form
    static tmp[250];
    new t1 = level, t2 = color;
    const n4 = -4, n16 = -16, size = sizeof tmp;
	#emit stack 28
	#emit push.c size
	#emit push.c tmp
	#emit stack n4
	#emit sysreq.c format
	#emit stack n16
    return AnticheatLZ(t2, tmp, t1);
}
stock ComandosLZEx(level, color, const form[], { Float, _ }: ...) {
	#pragma unused form
    static tmp[250];
    new t1 = level, t2 = color;
    const n4 = -4, n16 = -16, size = sizeof tmp;
	#emit stack 28
	#emit push.c size
	#emit push.c tmp
	#emit stack n4
	#emit sysreq.c format
	#emit stack n16
    return ComandosLZ(t2, tmp, t1);
}
stock ComandosLZ(color, const string[], level) {
    foreach(new i : Player) {
        if (PLAYER_INFO[i][pAdmin] >= level && VerComandos[i] == 1) SendClientMessage(i, color, string);
    }
    if (LOG_DC == 0) {
        //DCC_SendChannelMessage(discord_channel_id, string);
    }
    return 1;
}
stock CercaDeObjeto(Float:rango, playerid, objectid) {
    new Float:Pos[3];
    GetObjectPos(objectid, Pos[0], Pos[1], Pos[2]);
    if (IsPlayerInRangeOfPoint(playerid, rango, Pos[0], Pos[1], Pos[2])) return 1;
    return 0;
}
stock ApareceHospital(playerid) {
    EstablecerVida(playerid, 4.0);
    if (PLAYER_INFO[playerid][pDuty] != 1) {
        QuitarArmas(playerid);
        EstablecerChaleco(playerid, 0.0);
    }
    DarRopa(playerid);
    DarArmas(playerid);
    HospitalMasCercano(playerid);
    LlamadaMedicos[playerid] = 0;
    SetPlayerInterior(playerid, 0);
    PLAYER_TEMP[playerid][VariableCaido] = 0;
    SetPlayerVirtualWorld(playerid, 0);
    PLAYER_INFO[playerid][Agonizando] = 0;
    Muriendo[playerid] = 0;
    TogglePlayerControllable(playerid, 0);
    SetPVarInt(playerid, "IsFrozen", 0);
    EnCombate[playerid] = 0;
    TextDrawHideForPlayer(playerid, Sangre);
    TextDrawHideForPlayer(playerid, NewPlayer[2]);
    TextDrawHideForPlayer(playerid, NewPlayer[0]);
    SendClientMessage(playerid, 0xafafafFF, "{FFBC00}Fuiste trasladado al hospital y los medicos pudieron reanimarte");
    SendClientMessage(playerid, 0xafafafFF, "{FFBC00}Estan curandote las heridas, aguarda un momento.");
    TimerMalherido[playerid] = 0;
    SetTimerEx("CurarON", 1000, false, "d", playerid);
    return 1;
}
stock ASendClientMessageEx(color, const text[], aLevel = 2) {
    foreach(new i : Player) {
        if (PLAYER_INFO[i][pAdmin] < aLevel) continue;
        SendClientMessage(i, color, text);
    }
    //DCC_SendChannelMessage(discord_channel_id, text);
    return 1;
}
stock PonerPrenda(playerid, prenda) {
    new Query[256];
    if (PLAYER_INFO[playerid][pObj] == prenda && prenda != INVALID_TOY_ID) {
        if (UsandoP[playerid] >= 4 || TieneSombrero[playerid] > 0 && UsandoP[playerid] > 1) return ErroresPrenda(playerid, 2);
        if (UsandoObj[playerid] == 1) return ErroresPrenda(playerid, 1);
        if (!IsPlayerAttachedObjectSlotUsed(playerid, 0)) { SlotP2[0][playerid] = 0; } else if (!IsPlayerAttachedObjectSlotUsed(playerid, 1)) { SlotP2[0][playerid] = 1; } else if (!IsPlayerAttachedObjectSlotUsed(playerid, 2)) { SlotP2[0][playerid] = 2; } else if (!IsPlayerAttachedObjectSlotUsed(playerid, 3)) { SlotP2[0][playerid] = 3; }
        SetPlayerAttachedObject(playerid, SlotP2[0][playerid], PLAYER_INFO[playerid][pObj], 2, PLAYER_INFO[playerid][pfOffsetX], PLAYER_INFO[playerid][pfOffsetY], PLAYER_INFO[playerid][pfOffsetZ], PLAYER_INFO[playerid][pfRotX], PLAYER_INFO[playerid][pfRotY], PLAYER_INFO[playerid][pfRotZ], PLAYER_INFO[playerid][pfScaleX], PLAYER_INFO[playerid][pfScaleY], PLAYER_INFO[playerid][pfScaleZ]);
        UsandoObj[playerid] = 1;
        UsandoP[playerid]++;
        mysql_format(handle_db, Query, 200, "UPDATE `prendas` SET `ObjUsed`='1',`ATH`='%d' WHERE Propietario ='%e' AND Slot='1'", SlotP2[0][playerid], PLAYER_INFO[playerid][Nickname]);
        mysql_tquery(handle_db, Query);
        SendClientMessage(playerid, -1, "Te pusiste una prenda, en cualquier momento puedes {"    COLOR_GM "}/quitar prenda{FFFFFF} o {"    COLOR_GM "}/acomodar prenda{FFFFFF}.");
        HideSelector(playerid);
        CancelSelectTextDraw(playerid);
        return 1;
    }
    if (PLAYER_INFO[playerid][pObj2] == prenda && prenda != INVALID_TOY_ID) {
        if (UsandoP[playerid] >= 4 || TieneSombrero[playerid] > 0 && UsandoP[playerid] > 1) return ErroresPrenda(playerid, 2);
        if (UsandoObj2[playerid] == 1) return ErroresPrenda(playerid, 1);
        if (!IsPlayerAttachedObjectSlotUsed(playerid, 0)) { SlotP2[1][playerid] = 0; } else if (!IsPlayerAttachedObjectSlotUsed(playerid, 1)) { SlotP2[1][playerid] = 1; } else if (!IsPlayerAttachedObjectSlotUsed(playerid, 2)) { SlotP2[1][playerid] = 2; } else if (!IsPlayerAttachedObjectSlotUsed(playerid, 3)) { SlotP2[1][playerid] = 3; }
        SetPlayerAttachedObject(playerid, SlotP2[1][playerid], PLAYER_INFO[playerid][pObj2], 2, PLAYER_INFO[playerid][pfOffsetX2], PLAYER_INFO[playerid][pfOffsetY2], PLAYER_INFO[playerid][pfOffsetZ2], PLAYER_INFO[playerid][pfRotX2], PLAYER_INFO[playerid][pfRotY2], PLAYER_INFO[playerid][pfRotZ2], PLAYER_INFO[playerid][pfScaleX2], PLAYER_INFO[playerid][pfScaleY2], PLAYER_INFO[playerid][pfScaleZ2]);
        UsandoObj2[playerid] = 1;
        UsandoP[playerid]++;
        mysql_format(handle_db, Query, 200, "UPDATE `prendas` SET `ObjUsed`='1',`ATH`='%d' WHERE Propietario ='%e' AND Slot='2'", SlotP2[1][playerid], PLAYER_INFO[playerid][Nickname]);
        mysql_tquery(handle_db, Query);
        SendClientMessage(playerid, -1, "Te pusiste una prenda, en cualquier momento puedes {"    COLOR_GM "}/quitar prenda{FFFFFF} o {"    COLOR_GM "}/acomodar prenda{FFFFFF}.");
        HideSelector(playerid);
        CancelSelectTextDraw(playerid);
        return 1;
    }
    if (PLAYER_INFO[playerid][pObj3] == prenda && prenda != INVALID_TOY_ID) {
        if (UsandoP[playerid] >= 4 || TieneSombrero[playerid] > 0 && UsandoP[playerid] > 1) return ErroresPrenda(playerid, 2);
        if (UsandoObj3[playerid] == 1) return ErroresPrenda(playerid, 1);
        if (!IsPlayerAttachedObjectSlotUsed(playerid, 0)) { SlotP2[2][playerid] = 0; } else if (!IsPlayerAttachedObjectSlotUsed(playerid, 1)) { SlotP2[2][playerid] = 1; } else if (!IsPlayerAttachedObjectSlotUsed(playerid, 2)) { SlotP2[2][playerid] = 2; } else if (!IsPlayerAttachedObjectSlotUsed(playerid, 3)) { SlotP2[2][playerid] = 3; }
        SetPlayerAttachedObject(playerid, SlotP2[2][playerid], PLAYER_INFO[playerid][pObj3], 2, PLAYER_INFO[playerid][pfOffsetX3], PLAYER_INFO[playerid][pfOffsetY3], PLAYER_INFO[playerid][pfOffsetZ3], PLAYER_INFO[playerid][pfRotX3], PLAYER_INFO[playerid][pfRotY3], PLAYER_INFO[playerid][pfRotZ3], PLAYER_INFO[playerid][pfScaleX3], PLAYER_INFO[playerid][pfScaleY3], PLAYER_INFO[playerid][pfScaleZ3]);
        UsandoObj3[playerid] = 1;
        UsandoP[playerid]++;
        mysql_format(handle_db, Query, 200, "UPDATE `prendas` SET `ObjUsed`='1',`ATH`='%d' WHERE Propietario ='%e' AND Slot='3'", SlotP2[2][playerid], PLAYER_INFO[playerid][Nickname]);
        mysql_tquery(handle_db, Query);
        SendClientMessage(playerid, -1, "Te pusiste una prenda, en cualquier momento puedes {"    COLOR_GM "}/quitar prenda{FFFFFF} o {"    COLOR_GM "}/acomodar prenda{FFFFFF}.");
        HideSelector(playerid);
        CancelSelectTextDraw(playerid);
        return 1;
    }
    if (PLAYER_INFO[playerid][pObj4] == prenda && prenda != INVALID_TOY_ID) {
        if (UsandoP[playerid] >= 4 || TieneSombrero[playerid] > 0 && UsandoP[playerid] > 1) return ErroresPrenda(playerid, 2);
        if (UsandoObj4[playerid] == 1) return ErroresPrenda(playerid, 1);
        if (!IsPlayerAttachedObjectSlotUsed(playerid, 0)) { SlotP2[3][playerid] = 0; } else if (!IsPlayerAttachedObjectSlotUsed(playerid, 1)) { SlotP2[3][playerid] = 1; } else if (!IsPlayerAttachedObjectSlotUsed(playerid, 2)) { SlotP2[3][playerid] = 2; } else if (!IsPlayerAttachedObjectSlotUsed(playerid, 3)) { SlotP2[3][playerid] = 3; }
        SetPlayerAttachedObject(playerid, SlotP2[3][playerid], PLAYER_INFO[playerid][pObj4], 2, PLAYER_INFO[playerid][pfOffsetX4], PLAYER_INFO[playerid][pfOffsetY4], PLAYER_INFO[playerid][pfOffsetZ4], PLAYER_INFO[playerid][pfRotX4], PLAYER_INFO[playerid][pfRotY4], PLAYER_INFO[playerid][pfRotZ4], PLAYER_INFO[playerid][pfScaleX4], PLAYER_INFO[playerid][pfScaleY4], PLAYER_INFO[playerid][pfScaleZ4]);
        UsandoObj4[playerid] = 1;
        UsandoP[playerid]++;
        mysql_format(handle_db, Query, 200, "UPDATE `prendas` SET `ObjUsed`='1',`ATH`='%d' WHERE Propietario ='%e' AND Slot='4'", SlotP2[3][playerid], PLAYER_INFO[playerid][Nickname]);
        mysql_tquery(handle_db, Query);
        SendClientMessage(playerid, -1, "Te pusiste una prenda, en cualquier momento puedes {"    COLOR_GM "}/quitar prenda{FFFFFF} o {"    COLOR_GM "}/acomodar prenda{FFFFFF}.");
        HideSelector(playerid);
        CancelSelectTextDraw(playerid);
        return 1;
    }
    HideSelector(playerid);
    CancelSelectTextDraw(playerid);
    return 1;
}


stock LimpiarLog(lineas) {
    foreach(new i : Player) {
        if (PLAYER_INFO[i][pAdmin] < ADMIN_LEVEL_DUDAS) {
            for(new e = 0; e < lineas; e++) SendClientMessage(i, -1, "");
            SendClientMessage(i, 0xAA3333AA, "El log del chat fue borrado.");
        }
    }
    return 1;
}

stock LimpiarChat(playerid, lines, color) {
    if (IsPlayerConnected(playerid)) {
        for(new i = 0; i < lines; i++) SendClientMessage(playerid, color, " ");
    }
    return 1;
}

stock CrearIconoGPS(tdid, Float: PosGPS_X, Float: PosGPS_Y, const text[]) {
    TDGPSCreadoS++;
    TDGPSCreado[tdid] = 1;
    TextDGPS[tdid] = TextDrawCreate(PosGPS_X, PosGPS_Y, text);
    TextDrawLetterSize(TextDGPS[tdid], 0.000000, 0.000000);
    TextDrawTextSize(TextDGPS[tdid], 8.444448, 9.457767);
    TextDrawAlignment(TextDGPS[tdid], 2);
    TextDrawColor(TextDGPS[tdid], -1);
    TextDrawSetShadow(TextDGPS[tdid], 0);
    TextDrawSetOutline(TextDGPS[tdid], 0);
    TextDrawFont(TextDGPS[tdid], 4);
    return 1;
}
DarPrendas(playerid) {
    for(new i = 0; i < MAX_PLAYER_TOYS; i++) RemovePlayerAttachedObject(playerid, i);
    for(new i = 0; i < MAX_PLAYER_TOYS; i++) {
        if (PLAYER_TOYS[playerid][i][pt_MODEL_ID] == 0) continue;
        if (PLAYER_TOYS[playerid][i][pt_ATTACHED]) {
            if (IsPlayerMobile(playerid)) {
                GiveItem(playerid, PLAYER_TOYS[playerid][i][pt_MODEL_ID], i);
            }
            if (!IsPlayerMobile(playerid) || !IsPlayerAttachedObjectSlotUsed(playerid, i)) {
                SetPlayerAttachedObject(playerid, i, PLAYER_TOYS[playerid][i][pt_MODEL_ID], PLAYER_TOYS[playerid][i][pt_BONE], PLAYER_TOYS[playerid][i][pt_POS][0], PLAYER_TOYS[playerid][i][pt_POS][1], PLAYER_TOYS[playerid][i][pt_POS][2],
                    PLAYER_TOYS[playerid][i][pt_ROT][0], PLAYER_TOYS[playerid][i][pt_ROT][1], PLAYER_TOYS[playerid][i][pt_ROT][2], PLAYER_TOYS[playerid][i][pt_SCALE][0], PLAYER_TOYS[playerid][i][pt_SCALE][1], PLAYER_TOYS[playerid][i][pt_SCALE][2], PLAYER_TOYS[playerid][i][player_toy_COLOR_1], PLAYER_TOYS[playerid][i][player_toy_COLOR_2]);
            }
            if (PLAYER_INFO[playerid][pMascaraPuesta] == 1) SetPlayerAttachedObject(playerid, 2, 19036, 1, 0.487999, 0.089999, 0.000000, 93.999992, 94.900001, 0.000000, 1.000000, 1.000000, 1.000000);
        }
    }
    return 1;
}

stock IsPlayerNearVehicle(playerid, vehicleid) {
    new Float:X, Float:Y, Float:Z;
    GetVehiclePos(vehicleid, X, Y, Z);
    if (IsPlayerInRangeOfPoint(playerid, 1.0, X, Y, Z)) {
        new Float:x1, Float:y1, Float:z1;
        GetPlayerPos(playerid, x1, y1, z1);
        SetPlayerPos(playerid, x1, y1, z1 + 1);
    }
}

stock Actualizar(playerid) {
    CalcularNivel(playerid);
    BarraExp(playerid, 1);
    SetPlayerScore(playerid, PLAYER_INFO[playerid][@Nivel]);
    SetPlayerStats(playerid);
}

stock Float:GetPlayerDistanceToVehicle(playerid, vehicleid) {
    new Float:PCoords[3], Float:VCoords[3];
    GetPlayerPos(playerid, PCoords[0], PCoords[1], PCoords[2]);
    GetVehiclePos(vehicleid, VCoords[0], VCoords[1], VCoords[2]);
    new Float:Distance[4];
    for(new n = 0; n < 3; n++) {
        Distance[n] = floatabs(PCoords[n]) - floatabs(VCoords[n]);
    }
    Distance[3] = floatsqroot((Distance[0] * Distance[0]) + (Distance[1] * Distance[1]) + (Distance[2] * Distance[2]));
    return Distance[3];
}


stock GetPlayerNearestVehicle(playerid) {
    new nearest[2] = {-1, -1 };
    for(new v, j = GetVehiclePoolSize(); v <= j; v++) {
        if (GetVehicleModel(v) == 453) {
            if (nearest[0] == -1) {
                nearest[0] = v;
                nearest[1] = floatround(GetPlayerDistanceToVehicle(playerid, v));
            } else {
                if (floatround(GetPlayerDistanceToVehicle(playerid, v)) < nearest[1]) {
                    nearest[0] = v;
                    nearest[1] = floatround(GetPlayerDistanceToVehicle(playerid, v));
                }
            }
        }
    }
    return nearest[0];
}

stock floatMapa3Da2D(Float:_3Dx, Float:_3Dy, Float:texturaX, Float:texturaY, Float:textura_tamanoX, Float:textura_tamanoY, & Float:_2Dx, & Float:_2Dy) {
    const Float:mapaTamanoMaximo = 6000.0;
    _2Dx = ((textura_tamanoX / mapaTamanoMaximo) * _3Dx + texturaX + (textura_tamanoX / 2));
    _2Dy = ((textura_tamanoY / mapaTamanoMaximo) * -_3Dy + texturaY + (textura_tamanoY / 2));
    return 1;
}

stock SetVehiclePassengersInteriorEx(vehicleid, interior_id) {
    foreach(new i : Player) {
        if (IsPlayerConnected(i)) {
            if (IsPlayerInVehicle(i, vehicleid)) {
                SetPlayerInterior(i, interior_id);
            }
        }
    }
    return LinkVehicleToInterior(vehicleid, interior_id);
}

stock SetVehiclePassengersVWEx(vehicleid, vw_id) {
    foreach(new i : Player) {
        if (IsPlayerConnected(i)) {
            if (IsPlayerInVehicle(i, vehicleid)) {
                SetPlayerVirtualWorld(i, vw_id);
            }
        }
    }
    return SetVehicleVirtualWorld(vehicleid, vw_id);
}

stock EnviarAlGaraje(vehicleid, garaje_id) {
    foreach(new i : Player) {
        if (IsPlayerConnected(i)) {
            if (IsPlayerInVehicle(i, vehicleid)) PLAYER_INFO[i][EnGarage] = garaje_id;
        }
    }
    return 1;
}
CreatePlayerVehicle(playerid, modelid, Float: x, Float: y, Float: z, Float: angle, color1, color2, precio, monedas, idmensaje) {
    new mensaje[10];
    new day, month, year, Query[600], value = 120 + random(899);
    getdate(year, month, day);
    format(mensaje, 10, ""SERVER_COIN2 "RP %d", value);
    if (PLAYER_INFO[playerid][vModelo] == 0) {
        mysql_format(handle_db, Query, sizeof(Query), "INSERT INTO `p_vehicles` (Modelo,X,Y,Z,A,Color1,Color2,Vida,Precio,vMoneda,Propietario,Slot,Garage) VALUES ('%d','%f','%f','%f','%f','%d','%d','1000.0','%d','%d','%d','1','0')", modelid, x, y, z, angle, color1, color2, precio, monedas, PLAYER_INFO[playerid][pID]);
        new Cache:RP_InsertCache = mysql_query(handle_db, Query, true);
        new RP_NewVehicleID = cache_insert_id();
        cache_delete(RP_InsertCache);
        if(!RP_NewVehicleID) return 0;

        PLAYER_INFO[playerid][vID1] = RP_NewVehicleID;
        PLAYER_INFO[playerid][vModelo] = modelid;
        PLAYER_INFO[playerid][pOX] = x;
        PLAYER_INFO[playerid][pOY] = y;
        PLAYER_INFO[playerid][pOZ] = z;
        PLAYER_INFO[playerid][pOA] = angle;
        PLAYER_INFO[playerid][vColor1] = color1;
        PLAYER_INFO[playerid][vColor2] = color2;
        PLAYER_INFO[playerid][vPrecio] = precio;
        PLAYER_INFO[playerid][vMonedaa] = monedas;
        bloqueado[autos[playerid]] = 0;
        PLAYER_INFO[playerid][vSeguro] = 0;
        PLAYER_INFO[playerid][vAAlarma] = 0;
        PLAYER_INFO[playerid][vAAlarma] = 0;
        alarma[autos[playerid]] = 0;
        PLAYER_INFO[playerid][pVidaV] = 1000;
        autos[playerid] = LZ_CreateVehicle(modelid, x, y, z, angle, color1, color2, -1);
        format(PLAYER_INFO[playerid][vpatente], 38, "%s", mensaje);
        SetVehicleNumberPlate(autos[playerid], PLAYER_INFO[playerid][vpatente]);
        mysql_format(handle_db, Query, sizeof(Query), "UPDATE p_vehicles SET `Patente`='%e',`EstacionadoX`='%f',`EstacionadoY`='%f',`EstacionadoZ`='%f',`EstacionadoA`='%f',`O_Interior`='0',`O_VW`='0' WHERE `Propietario`='%d' AND Slot = '1'", mensaje, x, y, z, angle, PLAYER_INFO[playerid][pID]);
