stock PlayerIP(playerid) {
    new pIP[32];
    GetPlayerIp(playerid, pIP, 32);
    return pIP;
}



stock GetClosestPlayers(playerid, const array_IDS[], Float:radi) {
    new count, Float:p[3];
    foreach(new i : Player) if (IsPlayerConnected(i)) {
        GetPlayerPos(i, p[0], p[1], p[2]);
        if (GetPlayerDistanceFromPoint(playerid, p[0], p[1], p[2]) < radi) {
            array_IDS[count] = i;
            count++;
        }
    }
    return count;
}
stock Barrera1(trenid) {
    if (PasoTrenBarrera[trenid][0] == 0) {
        PasoTrenBarrera[trenid][0] = 1;
        MoveObject(BarreraTren[0], 2280.1448, -1155.7435, 26.5826 - 0.0001, 0.0001, 0.0000, -90.0000, -94.0000);
        MoveObject(BarreraTren[1], 2292.8923, -1144.0405, 26.5826 - 0.0001, 0.0001, 0.00000, -90.0000, 90.00000);
        foreach(new i : Player) {
            if (IsPlayerInRangeOfPoint(i, RangoSonidoPlayer, 2286.9500, -1151.3966, 29.3280) && PLAYER_INFO[i][pSonidos] == 1) {
                PlayAudioStreamForPlayer(i, "http://"    AUDIO_CAMPANAS "", 2286.9500, -1151.3966, 29.3280, 50.0, 1);
            }
        }
    }
}
