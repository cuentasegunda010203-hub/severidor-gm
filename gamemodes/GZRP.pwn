            inte = GetVehicleInterior(autos4[playerid]);
            vw = GetVehicleVirtualWorld(autos4[playerid]);
            PLAYER_INFO[playerid][v4interior] = inte;
            PLAYER_INFO[playerid][v4vw] = vw;
            mysql_format(handle_db, Query, sizeof(Query), "UPDATE `p_vehicles` SET `ACELERACION`='%d', `ACTIVE`='%d', `SALTO_V`='%d', `SALTO_V_1`='%d', `SALTO_V_2`='%d',`VE1`='%d',`VE2`='%d',`VE3`='%d',`VE4`='%d',`Combustible`='%d', `Vida`='%f',`X`='%f',`Y`='%f',`Z`='%f',`A`='%f',`Interior`='%d',`VW`='%d' WHERE id ='%d'", PLAYER_INFO[playerid][v4ACELERACION], PLAYER_INFO[playerid][v4ACTIVE], PLAYER_INFO[playerid][v4SALTO_V], PLAYER_INFO[playerid][v4SALTO_V_1], PLAYER_INFO[playerid][v4SALTO_V_2], PLAYER_INFO[playerid][V4E1], PLAYER_INFO[playerid][V4E2], PLAYER_INFO[playerid][V4E3], PLAYER_INFO[playerid][V4E4], PLAYER_INFO[playerid][v4Gas], PLAYER_INFO[playerid][pVidaV4], PLAYER_INFO[playerid][v4X], PLAYER_INFO[playerid][v4Y], PLAYER_INFO[playerid][v4Z], PLAYER_INFO[playerid][v4A], PLAYER_INFO[playerid][v4interior], PLAYER_INFO[playerid][v4vw], PLAYER_INFO[playerid][vID4]);
            mysql_tquery(handle_db, Query);
        }
        if (autos5[playerid] > 0) {
            GetVehicleDamageStatus(autos5[playerid], PLAYER_INFO[playerid][V4E1], PLAYER_INFO[playerid][V4E2], PLAYER_INFO[playerid][V4E3], PLAYER_INFO[playerid][V4E4]);
            PLAYER_INFO[playerid][v4Gas] = VehicleFuel[autos5[playerid]];
            GetVehicleHealth(autos5[playerid], VidaV5);
