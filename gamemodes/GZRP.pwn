                            case 0 : CanalTwt[playerid] = 1, PUSH(playerid, "El Twitter ha sido ~b~activado~w~.");
                            default: CanalTwt[playerid] = 0, PUSH(playerid, "El Twitter ha sido ~r~desactivado~w~.");
                        }
