                        if (PLAYER_INFO[playerid][jDinero] < 20) return SendClientMessage(playerid, -1, "No tienes el dinero suficiente ($20)");
                        if (TieneHerramientaEnMano[playerid] != 0) return SendClientMessage(playerid, -1, "Ya tienes algo en tu mano derecha.");

                        if (!RP_EcoPay(playerid,20)) return 1;
