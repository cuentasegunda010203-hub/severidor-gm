CMD:banoff(playerid, params[]) {
    if (AdminDuty[playerid] == 0) return SendClientMessage(playerid, -1, "No puedes usar este comando en fuera de servicio administrativo");
    new ID[32], RAZON[100], string[200], query[200], pName[32], day, month, year, hora, minuto, segundo;
    gettime(hora, minuto, segundo);
    getdate(year, month, day);
    GetPlayerName(playerid, pName, 32);
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) return 0;
    if (PLAYER_INFO[playerid][BaneosD] >= 6 && PLAYER_INFO[playerid][pAdmin] != ADMIN_LEVEL_ADM && PLAYER_INFO[playerid][BaneosD2] > gettime()) return SendClientMessage(playerid, -1, "Solamente puedes banear 6 jugadores por dia.");
    if (!sscanf(params, "s[29]s[100]", ID, RAZON)) {
        format(string, sizeof(string), "El jugador {FF3300}%s{FFFFFF} fue baneado por un admin. Razon: {FF0000}%s{FFFFFF}.", ID, RAZON);
        MensajeAdmin(-1, string, ADMIN_LEVEL_BANEOS);
        format(string, 200, "Administrador: %s", PlayerName(playerid));
        ASendClientMessageEx(COLOR_GREY, string);
        new Query[520];
        mysql_format(handle_db, Query, sizeof(Query), "INSERT INTO `registros_admin` (Responsable, Jugador, Razon, Accion) VALUES ('%s','%s','%s','3')", PLAYER_INFO[playerid][Nickname], ID, RAZON);
        mysql_tquery(handle_db, Query);
        mysql_format(handle_db, query, sizeof(query), "UPDATE `usuarios` SET `Baneado`='1',`razon`='%s',`Banpor`='%s' WHERE `Username`=('%s')", RAZON, PLAYER_INFO[playerid][Nickname], ID);
        mysql_tquery(handle_db, query);
        if (PLAYER_INFO[playerid][pAdmin] > ADMIN_LEVEL_DUDAS) {
            PLAYER_INFO[playerid][BaneosD]++;
            PLAYER_INFO[playerid][BaneosD2] = gettime() + 86400;
        }
    } else return SendClientMessage(playerid, -1, "Modo de uso: /banoff [Nombre_Apellido] [Razon]");
    return 1;
}
CMD:lsalon(playerid) {
    if (PLAYER_INFO[playerid][pAdmin] <= ADMIN_LEVEL_DUDAS) return 0;

    {
        if (Alquilado == true) {
            SendClientMessage(playerid, -1, "Limpiaste el salon de eventos.");
            SalonTimer();
        } else SendClientMessage(playerid, -1, "El salon no se encuentra alquilado.");
    }
    return 1;
}

CMD:ao(playerid, params[]) {
    new texto[128];
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM_TEMP) return 0;

    if (!sscanf(params, "s[128]", texto)) {
        new string[128];
        format(string, 128, "{FF0000}["    SERVER_NAME2 "]: {FFFFFF} %s", texto);
        SendClientMessageToAll(COLOR_MEGAPHONE, string);
        format(string, 128, "Administrador: %s", PLAYER_INFO[playerid][Nickname]);
        MensajeAdmin(COLOR_GREY, string, ADMIN_LEVEL_ADM_TEMP);
        Webhook_Canales(playerid, texto, 4, 0);
    }
    return 1;
}
