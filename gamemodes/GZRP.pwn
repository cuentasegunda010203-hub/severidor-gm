		}
		else //DCC_SendChannelMessage(discord_channel_id, "/estado [texto]");
	}
	if(!strcmp(command, "/admins", true))
	{
		new string[128];
		new count = 0;
		foreach(new i : Player)
		{
			if(PLAYER_INFO[i][pAdmin] > 0)
			{
				format(string, sizeof(string), "%s [ID: %d] [ADM: %d] [Duty: %d]",PLAYER_INFO[i][Nickname],i,PLAYER_INFO[i][pAdmin],AdminDuty[i]);
				//DCC_SendChannelMessage(discord_channel_id, string);
				count ++;
			}
		}
		if(count == 0) return //DCC_SendChannelMessage(discord_channel_id, "**No hay administradores conectados**");
		format(string, sizeof(string), "**Hay %d administradores conectados**",count);
		//DCC_SendChannelMessage(discord_channel_id, string);
	}
	if(!strcmp(command, "/jugadores", true))
	{
		new string[128];
		new count = 0;
		foreach(new i : Player)
		{
			if(JugadorLogeado[i] > 0)
			{
				format(string, sizeof(string), "%s [ID: %d] [Nivel: %d]",PLAYER_INFO[i][Nickname],i,PLAYER_INFO[i][@Nivel]);
				//DCC_SendChannelMessage(discord_channel_id, string);
				count ++;
			}
		}
		if(count == 0) return //DCC_SendChannelMessage(discord_channel_id, "**No hay jugadores conectados**");
		format(string, sizeof(string), "**Hay %d jugadores conectados**",count);
		//DCC_SendChannelMessage(discord_channel_id, string);
	}
