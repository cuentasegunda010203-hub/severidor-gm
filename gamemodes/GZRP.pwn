function QuitarCargo(playerid) {
    foreach(new c : Player) {
        if (PLAYER_INFO[c][pFaccion] == 1 && PLAYER_INFO[c][pDuty] == 1 && EstaEnP(playerid, c, 20.00)) return SendClientMessage(playerid, -1, "Un policia esta muy cerca de ti y no podemos quitarte los cargos.");
        if (PLAYER_INFO[c][pFaccion] == 2 && PLAYER_INFO[c][pDuty] == 1 && EstaEnP(playerid, c, 20.00)) return SendClientMessage(playerid, -1, "Un policia esta muy cerca de ti y no podemos quitarte los cargos.");
    }
    ActualizarRadar();
    PLAYER_INFO[playerid][pCargos] -= 1;
    SetPlayerWantedLevelEx(playerid, PLAYER_INFO[playerid][pCargos]);
    return 1;
}

