        case DIALOG_ANUNCIO3: {
            if (response) {
                new anuncio[200], anuncio2[300];
                if (PLAYER_TEMP[playerid][AnuncioTipo2] == 1) {
                    switch (AnuncioTipo[playerid]) {
                        case 1 : format(anuncio, sizeof(anuncio), "~y~>~h~~h~Compra:~w~ %s ~b~", AnuncioTexto[playerid]);
                        case 2 : format(anuncio, sizeof(anuncio), "~g~>~h~~h~Venta:~w~ %s ", AnuncioTexto[playerid]);
                        case 3 : format(anuncio, sizeof(anuncio), "~r~>~h~~h~Anuncio:~w~ %s ", AnuncioTexto[playerid]);
                    }
                } else {
                    switch (AnuncioTipo[playerid]) {
                        case 1 : format(anuncio2, sizeof(anuncio2), ">Compra:{FFFFFF} %s {006600}[#%d]", AnuncioTexto[playerid], PLAYER_INFO[playerid][pNumero]);
                        case 2 : format(anuncio2, sizeof(anuncio2), ">Venta:{FFFFFF} %s {006600}[#%d]", AnuncioTexto[playerid], PLAYER_INFO[playerid][pNumero]);
                        case 3 : format(anuncio2, sizeof(anuncio2), ">Anuncio:{FFFFFF} %s {006600}[#%d]", AnuncioTexto[playerid], PLAYER_INFO[playerid][pNumero]);
                    }
                }
                if (PLAYER_INFO[playerid][jDinero] < strlen(AnuncioTexto[playerid]) * 100) return SendClientMessage(playerid, -1, "No tienes dinero suficiente...");
                switch (PLAYER_TEMP[playerid][AnuncioTipo2]) {
                    case 1:
                        SetTextDrawAnuncioText(PLAYER_INFO[playerid][pNumero], anuncio);
                        default:SetTextDrawAnuncioText(PLAYER_INFO[playerid][pNumero], anuncio2, 1);
