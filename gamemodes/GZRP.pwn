stock RP_AddTuningComponent(playerid, vehicleid, component, price = 0) {
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER || GetPlayerVehicleID(playerid) != vehicleid) return 0;
    if(!RP_TuningCompatible(GetVehicleModel(vehicleid), component)) return SendClientMessage(playerid, -1, "Esta pieza no es compatible con tu vehiculo.");
    if(price && PLAYER_INFO[playerid][jDinero] < price) return SendClientMessage(playerid, -1, "No tienes suficiente dinero.");
    if(!AddVehicleComponent(vehicleid, component)) return 0;
    if(price) QuitarDinero(playerid, price);
    return 1;
}
stock RP_ShowTuningParts(playerid, type) {
    new vehicleid = GetPlayerVehicleID(playerid), model = GetVehicleModel(vehicleid), menu[1800], line[64];
    RP_TuningVehicle[playerid] = vehicleid;
    RP_TuningCount[playerid] = 0;
    for(new i; i < sizeof(RP_TuningParts); i++) {
        if(RP_TuningParts[i][RP_PartType] != type || !RP_TuningCompatible(model, RP_TuningParts[i][RP_PartID])) continue;
        if(RP_TuningCount[playerid] >= 32) break;
        RP_TuningChoices[playerid][RP_TuningCount[playerid]++] = RP_TuningParts[i][RP_PartID];
        format(line, sizeof line, "%s (%d)\n", RP_TuningParts[i][RP_PartName], RP_TuningParts[i][RP_PartID]);
        strcat(menu, line, sizeof menu);
    }
    if(!RP_TuningCount[playerid]) return SendClientMessage(playerid, -1, "Este modelo no admite piezas de esta categoria.");
    dialogs_ShowPlayerDialog(playerid, Tuning + type, DIALOG_STYLE_LIST, "Piezas compatibles", menu, "Colocar", "Cancelar");
    return 1;
}
stock RP_PaintjobCount(model) {
    switch(model) {
        case 483: return 1;
        case 575: return 2;
        case 534,535,536,558,559,560,561,562,565,567,576: return 3;
    }
    return 0;
}
stock RP_ShowPaintjobs(playerid) {
    new vehicleid = GetPlayerVehicleID(playerid), count = RP_PaintjobCount(GetVehicleModel(vehicleid)), menu[160], line[32];
    if(!count) return SendClientMessage(playerid, -1, "Este modelo no admite disenos de pintura.");
    RP_TuningVehicle[playerid] = vehicleid;
    for(new i; i < count; i++) {format(line, sizeof line, "Diseno %d\n", i + 1); strcat(menu, line, sizeof menu);}
    strcat(menu, "Quitar diseno", sizeof menu);
    dialogs_ShowPlayerDialog(playerid, Tuning + 3, DIALOG_STYLE_LIST, "Pinturas compatibles", menu, "Colocar", "Cancelar");
    return 1;
}
