                    if (cantidad > 500) return Notificador2(playerid, "No puedes comprar esa cantidad, ingresa una cantidad menor.");
                    if (PLAYER_INFO[playerid][jDinero] < preciofinal) return Notificador2(playerid, "No tienes el dinero suficiente para comprar ~g~~h~Crack");
                    if (PLAYER_INFO[playerid][jDinero] > preciofinal) {
