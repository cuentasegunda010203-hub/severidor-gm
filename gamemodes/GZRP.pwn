CMD:setskin(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM) return 0; {
        new Query[200], id, skin;

        if (!sscanf(params, "dd", id, skin)) {
            if (IsPlayerNPC(id)) return 1;
            //if(skin <= 0 || skin >= 300) return SendClientMessage(playerid,-1,"No puedes asignar esa skin.");
            PLAYER_INFO[id][jRopa] = skin;
            SetPlayerSkin(id, PLAYER_INFO[id][jRopa]);
            mysql_format(handle_db, Query, 200, "UPDATE `usuarios` SET `Skin`='%d' WHERE `Username`='%e'", skin, PLAYER_INFO[id][Nickname]);
            mysql_tquery(handle_db, Query);
        }
    }
    return 1;
}
CMD:traer(playerid, params[]) {
    new Float:Pos[3], id;
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) return 0;
    if (sscanf(params, "d", id)) return 0; {
        if (IsPlayerConnected(id)) {
            if (IsPlayerNPC(id)) return 1;
            if (PLAYER_INFO[id][pAdmin] > PLAYER_INFO[playerid][pAdmin]) return 1;
            if (GetPlayerInterior(playerid) > 0 || GetPlayerVirtualWorld(playerid) > 0) {
                PLAYER_INFO[id][jPosE_x] = PLAYER_INFO[playerid][jPosE_x];
                PLAYER_INFO[id][jPosE_y] = PLAYER_INFO[playerid][jPosE_y];
                PLAYER_INFO[id][jPosE_z] = PLAYER_INFO[playerid][jPosE_z];
            }
            NoTeleportHack(id);
            GetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);
            SetPlayerPos(id, Pos[0], Pos[1], Pos[2] + 1);
            SetPlayerVirtualWorld(id, GetPlayerVirtualWorld(playerid));
            SetPlayerInterior(id, GetPlayerInterior(playerid));
            new stringxd[150];
            format(stringxd, 150, "{DC143C}(Administracion): %s trajo a %s a su posicion.", PlayerName(playerid), PlayerName(id));
            MensajeAdmin(-1, stringxd, 5);

        }
    }
    return 1;
}
CMD:irv(playerid, params[]) {
    new id;
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) return 0;

    if (!sscanf(params, "d", id)) {
        if (!IsValidVehicle(id)) return SendClientMessage(playerid, -1, "Vehiculo invalido.");
        new Float:x, Float:y, Float:z;
        GetVehiclePos(id, x, y, z);
        SetPlayerPos(playerid, x, y, z + 5);
        SendClientMessageEx(playerid, -1, "Fuiste al vehiculo ID:%d", id);
    }
    return true;
}
CMD:traerv(playerid, params[]) {
    new id, Float:Pos[3];
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_DUDAS) return 0;

    if (!sscanf(params, "d", id)) {
        if (!IsValidVehicle(id)) return SendClientMessage(playerid, -1, "Vehiculo invalido.");
        PLAYER_TIMES[playerid][TiempoAntiAB] = 5;
        EnAuto[playerid] = id;
        GetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);
        SetVehicleInterior(id, GetPlayerInterior(playerid));
        SetVehicleVirtualWorld(id, GetPlayerVirtualWorld(playerid));
        SetVehiclePos(id, Pos[0], Pos[1], Pos[2]);
        PutPlayerInVehicle(playerid, id, 0);
    }
    return 1;
}
