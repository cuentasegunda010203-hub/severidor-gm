CMD:armas(playerid, params[]) {
    new string[256], pName[32];
    GetPlayerName(playerid, pName, 32);
    if (PLAYER_INFO[playerid][pDuty] != 1) return 1;
    if (IsPlayerInRangeOfPoint(playerid, 5.0, 250.4184, 73.3132, 1003.6406) || IsPlayerInRangeOfPoint(playerid, 5.0, 677.5463, 2545.2993, -89.4512)) {
        format(string, 256, "Palo de Policia");
        format(string, 256, "%s\nArma: Desert-eagle", string);
        format(string, 256, "%s\nArma: MP5", string);
