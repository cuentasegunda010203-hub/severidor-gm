public CheckSobeit(playerid) {
    if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid) || IsPlayerNPC(playerid) || !JugadorLogeado[playerid]) return 1;
    new Float:x, Float:y, Float:z;
    GetPlayerCameraFrontVector(playerid, x, y, z);
		#pragma unused x
		#pragma unused y
    if (z < -0.8 && !IsPlayerMobile(playerid)) {
        new string[128];
        format(string, sizeof string, "%s Se conecto con Sobeit. Usa /spec %d", PLAYER_INFO[playerid][Nickname], playerid);
        MensajeAdmin(COLOR_CHEAT, string, 3);
        //Kick(playerid);
    }
    return 1;
}
public CheckTakenHealth() {
    new Float:CurrHealth;
    GetPlayerHealth(target1, CurrHealth);
    SetPVarFloat(target1, "CurrHealth", CurrHealth);
    SetTimer("CheckNewHealth", NewHealthTime, false);
}
stock GetVehicleSpeedExP(vehicleid) {
    new Velocidad, VelocidadF[20];
    Velocidad = GetVehicleSpeedEx(vehicleid);
    if (Velocidad < 10) format(VelocidadF, sizeof(VelocidadF), "00%d", Velocidad);
    else if (Velocidad > 10 && Velocidad < 100) format(VelocidadF, sizeof(VelocidadF), "0%d", Velocidad);
    else if (Velocidad > 99) format(VelocidadF, sizeof(VelocidadF), "%d", Velocidad);
    return VelocidadF;
}





