    return SetPosEx(playerid, 1802.7854, -1303.8938, 93.0391, 0, 0, 0, 0);
}
CMD:spec(playerid, params[]) {
    new id, string99[128];
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) return 0;
    if (sscanf(params, "u", id)) return 1;

    //if(GetPlayerScore(id) == 0) return SendClientMessage(playerid, -1, "El jugador que quieres spectear esta conectado pero aun no ha ingresado al juego.");
    if (id == playerid) return 1;
    if (id == INVALID_PLAYER_ID) return SendClientMessage(playerid, 0x25AB26FF, "Jugador no conectado");
    if (PLAYER_TEMP[playerid][@Specteando] == 0) {
        GetPlayerPos(playerid, SpecX[playerid], SpecY[playerid], SpecZ[playerid]);
        SpecInt[playerid] = GetPlayerInterior(playerid);
        SpecVW[playerid] = GetPlayerVirtualWorld(playerid);
    }
    PLAYER_TEMP[playerid][@Specteando] = 1;
    SpecJugador[playerid] = id;
    Specteado[id] = 1;
    TogglePlayerSpectating(playerid, true);
    if (!IsPlayerInAnyVehicle(id)) {
        SetPlayerInterior(playerid, GetPlayerInterior(id));
        SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(id));
        PlayerSpectatePlayer(playerid, id);
    } else {
        SetPlayerInterior(playerid, GetPlayerInterior(id));
        SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(id));
        PlayerSpectateVehicle(playerid, GetPlayerVehicleID(id));
    }
    format(string99, 128, "%s (ID: %d | Nivel %d) ahora es el specteador de %s (ID: %d | Nivel: %d)", PLAYER_INFO[playerid][Nickname], playerid, PLAYER_INFO[playerid][@Nivel], PLAYER_INFO[id][Nickname], id, PLAYER_INFO[id][@Nivel]);
    MensajeAdmin(COLOR_CHEAT, string99, ADMIN_LEVEL_ADM);
    return 1;
}
CMD:specoff(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) return 1;
    if (PLAYER_TEMP[playerid][@Specteando] == 0) return 1;
    TogglePlayerSpectating(playerid, false);
    EstablecerChaleco(playerid, PLAYER_INFO[playerid][@Chaleco]);
    EstablecerVida(playerid, PLAYER_INFO[playerid][@Salud]);
    SpecJugador[playerid] = INVALID_PLAYER_ID;
    DarPrendas(playerid);
    return 1;
}

CMD:foro(playerid, params[]) { SendClientMessage(playerid, -1, "El foro esta desactivado. Usa /ayuda para consultar los sistemas."); return 1; }
CMD:web(playerid, params[]) { SendClientMessage(playerid, -1, "La web es: {"COLOR_GM "}https://"WEB_INDEX ""); return 1; }
CMD:discord(playerid, params[]) { SendClientMessage(playerid, -1, "El discord es: {"COLOR_GM "}https://"DISCORD ""); return 1; }

CMD:resetearcarreras(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM) return 0;
    ResetearCarrera();
    UpdateDynamic3DTextLabelText(TextoCarrera, COLOR_WHITE, "{FF3300}Boleteria cerrada\n{"COLOR_GM "}Horarios de los eventos: {FFFFFF}5hs,11hs,17hs,23hs");
    return 1;
}
CMD:ccarrera(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM) return 0;
    if (sscanf(params, "d", params[0])) return SendClientMessage(playerid, -1, "Escribe {"COLOR_GM "}/ccarrera {FFFFFF}<Minutos>");
    if (HabilitarCarreras == 1) return SendClientMessage(playerid, -1, "Ya hay una carrera en curso.");
    if (params[0] < 1 || params[0] > 11) return SendClientMessage(playerid, -1, "El valor debe ser mayor a 1 y menor a 0 ");
    ResetearCarrera();
    HabilitarCarreras = 1;
    UpdateDynamic3DTextLabelText(TextoCarrera, COLOR_WHITE, "{00CC00}Boleteria abierta\n{FFFFFF}Costo de la entrada: {00CC00}$600\n{"COLOR_GM "}/comprar entrada");
    ConteoCarrera = params[0] * 60;
    SetTimer("EmpezarCarrera", segundos(10), 0);
    return true;
}
CMD:resetearpuntos(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_GLOBAL) return 0;
    new Query[128];
    mysql_format(handle_db, Query, 200, "UPDATE `usuarios` SET `PuntosCarrera`='0' WHERE `PuntosCarrera`");
    mysql_tquery(handle_db, Query);
    foreach(new u : Player) {
        PLAYER_INFO[u][pPuntosCarrera] = 0;
    }
    return 1;
}
CMD:logad(playerid, params[]) {
    new string[70];
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_DUDAS) return 0;
    format(string, 70, "El log de anuncios fue borrado por {106C24}%s.", PLAYER_INFO[playerid][Nickname]);
    MensajeAdmin(-1, string, 2);
    Notificador2(playerid, "Log de anuncios borrados ~g~Correctamente.");
    LimpiarAnuncios();
    return true;
}
CMD:reportes(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_DUDAS) return 1;
    new reportdialog[600], itemid = 0;
    for(new i = 0; i < MAX_REPORTS; i++) {
        if (Reports[i][BeingUsed] == 1 && itemid < 100) {
            ListItemReportId[playerid][itemid] = i;
            itemid++;
            format(reportdialog, sizeof(reportdialog), "%sID: %d - Nv: %d - R: %s\n", reportdialog, Reports[i][ReportFrom], PLAYER_INFO[Reports[i][ReportFrom]][@Nivel], Reports[i][Report]);
        }
    }
    CancelReport[playerid] = itemid;
    format(reportdialog, sizeof(reportdialog), "%s\n", reportdialog);
    format(reportdialog, sizeof(reportdialog), "%sSalir", reportdialog);
    if (itemid > 0) dialogs_ShowPlayerDialog(playerid, REPORTSMENU, DIALOG_STYLE_LIST, "Reportes", reportdialog, "Ver reporte", "Cerrar");
    else SendClientMessage(playerid, -1, "No hay reportes.");
    return 1;
}
CMD:zz(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_DUDAS) return 0;
    SetPosEx(playerid, 78.4577, 7.4216, 72.5629, 90, 0, 0);
    SetCameraBehindPlayer(playerid);
    return 1;
}
CMD:limpiarreportes(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) return 1;
    for(new i = 0; i < MAX_REPORTS; i++) {
        if (Reports[i][BeingUsed] == 1) {
            Reports[i][BeingUsed] = 0;
            for(new iX = 0; iX < 5; iX++) {
                if (IsPlayerConnected(Reports[i][ReportFrom])) {
                    Reportado[Reports[i][ReportFrom]][iX] = INVALID_PLAYER_ID;
                }
            }
        }
    }
    SendClientMessage(playerid, COLOR_WHITE, "Limpiaste la lista de reportes.");
    return 1;
}

CMD:garageid(playerid, params[]) {
    if (PLAYER_INFO[playerid][pMapper] == 0 && PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_GLOBAL) return 0;
    for(new id = 0; id < MAX_PROPIEDADES; id++) {
        if (IsPlayerInRangeOfPoint(playerid, 2, PropInfo[id][pGX], PropInfo[id][pGY], PropInfo[id][pGZ])) {
            if (PropInfo[id][pGX] != 0) {
                new string[170];
                format(string, sizeof(string), "Esta garaje tiene la ID {"            COLOR_GM "}%d{FFFFFF}.", id);
                SendClientMessage(playerid, -1, string);
            }
        }
    }
    return 1;
}
CMD:info(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < 4) return 0;
    for(new id = 0; id < MAX_PROPIEDADES; id++) {
        if (IsPlayerInRangeOfPoint(playerid, 2, PropInfo[id][pPosX], PropInfo[id][pPosY], PropInfo[id][pPosZ])) {
            if (PropInfo[id][pEnUso] == 1) {
                new string[170];
                format(string, sizeof(string), "Esta propiedad tiene la (ID {009AFF}%d {FFFFFF}- Propietario: {009AFF}%s{FFFFFF} - Interior: {009AFF}%d)", id, PropInfo[id][pPropietario], PropInfo[id][pInterior]);
                SendClientMessage(playerid, -1, string);
            }
        }
    }
    for(new ID = 1; ID < MAX_FABRICAS; ID++) {
        if (!FABRICAS_INFO[ID][f_VALID]) continue;
        if (IsPlayerInRangeOfPoint(playerid, 3.0, FABRICAS_INFO[ID][f_POS][0], FABRICAS_INFO[ID][f_POS][1], FABRICAS_INFO[ID][f_POS][2])) {
            if (FABRICAS_INFO[ID][f_VENTA] == 1) SendClientMessageEx(playerid, -1, "Esta fabrica tiene la (ID {009AFF}%d {FFFFFF}- Nombre de banda: {009AFF}%s{FFFFFF})", ID, BandasInfo[FABRICAS_INFO[ID][f_FACCION_ID]][BNombre]);
            else SendClientMessageEx(playerid, -1, "Esta fabrica tiene la (ID {009AFF}%d {FFFFFF}- {009AFF}En venta{FFFFFF})", ID);
        }
    }
    return 1;
}
CMD:infoex(playerid, params[]) {
    new ID, type, Float:X, Float:Y, Float:Z, Float:Angulo;
    if (PLAYER_INFO[playerid][pAdmin] < 2) return 0;
    if (!sscanf(params, "id", ID, type)) {
        if (!IsPlayerConnected(ID)) return SendClientMessage(playerid, -1, "{FF6347}El jugador no esta conectado.");
        if (PLAYER_INFO[ID][pAdmin] > PLAYER_INFO[playerid][pAdmin]) return SendClientMessage(playerid, -1, "{FF6347}El rango administrativo de este jugador es superior al tuyo.");

        switch (type) {
            case 1 : SendClientMessageEx(playerid, -1, "{999999}%s(%d) tiene la animacion: %d.", PLAYER_INFO[ID][Nickname], ID, GetPlayerAnimationIndex(ID));
            case 2: {
                GetPlayerFacingAngle(ID, Angulo);
                GetPlayerPos(ID, X, Y, Z);
                SendClientMessageEx(playerid, -1, "{999999}[Coordenadas %s[ID: %d] actuales X: %.2f | Y: %.2f | Z: %.2 | A: %.2f | Int: %i | VW: %d].", PLAYER_INFO[ID][Nickname], ID, X, Y, Z, Angulo, GetPlayerInterior(ID), GetPlayerVirtualWorld(ID));
            }
            case 3: {
                SendClientMessageEx(playerid, -1, "{999999}Salud del jugador %s [ID: %d]: (Vida: %.1f) - (Chaleco: %.1f)", PLAYER_INFO[ID][Nickname], ID, PLAYER_INFO[ID][@Salud], PLAYER_INFO[ID][@Chaleco]);

            }
        }
        return 1;
    } else if (!sscanf(params, "d", type)) {
        switch (type) {
            case 1 : SendClientMessageEx(playerid, -1, "{999999}Tienes la animacion: %d.", GetPlayerAnimationIndex(playerid));
            case 2: {
                GetPlayerFacingAngle(playerid, Angulo);
                GetPlayerPos(playerid, X, Y, Z);

                SendClientMessageEx(playerid, -1, "{999999}[Tus coordenadas actuales X: %.2f | Y: %.2f | Z: %.2f | A: %.2f | Int: %d | VW: %d].", X, Y, Z, Angulo, GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid));
            }
            case 3 : SendClientMessageEx(playerid, -1, "{999999}Tu salud es de: (Vida: %.1f) - (Chaleco: %.1f)", PLAYER_INFO[playerid][@Salud], PLAYER_INFO[playerid][@Chaleco]);
        }
        return 1;
    } else {
        SendClientMessage(playerid, -1, "Uso 1: {009AFF}/infoex{ffffff} [ID] [type: 1: animacion | 2: cordenadas - 3: Vida y Chaleco");
        SendClientMessage(playerid, -1, "Uso 2: {009AFF}/infoex{ffffff} [type: 1: animacion | 2: cordenadas - 3: Vida y Chaleco");
    }
    return 1;
}
CMD:reloadf(playerid) {
    if (PLAYER_INFO[playerid][pAdmin] < 5) return 0;
    for(new ID = 1; ID < MAX_FABRICAS; ID++) {
        if (FABRICAS_INFO[ID][f_VALID]) {
            GuardarFabrica(ID);
        }
    }
    CargarFabricas();
    return 1;
}
CMD:dfabrica(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < 5) return 0;
    new cantidad, f;
    if (sscanf(params, "dd", f, cantidad)) return SendClientMessage(playerid, -1, "Escribe {009AFF}/dfabrica {FFFFFF}<FabricaID> <Cantidad>");
    if (f >= MAX_FABRICAS) return SendClientMessage(playerid, -1, "No puedes dar dinero a una fabrica que no existe.");
    if (!FABRICAS_INFO[f][f_VALID]) return SendClientMessage(playerid, -1, "No puedes dar dinero a una fabrica que no existe.");

    DarDineroFabrica(f, cantidad);
    return 1;
}
CMD:fso(playerid) {
    return Kick(playerid);
}
CMD:fstd(playerid) {
    return Kick(playerid);
}
CMD:fstat(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < 5) return 0;
    if (sscanf(params, "dii", params[0], params[1], params[2])) {
        SendClientMessage(playerid, -1, "Escribe {009AFF}/fstat {FFFFFF}<Fabrica_ID> <Numero> <Valor>");
        SendClientMessage(playerid, -1, "{FE6F00}Tanques {FFFFFF}1. Tanque #1 | 2. Tanque #2 | 3. Tanque #3 | 4. Tanque #4 | 5. Tanque #5");
        SendClientMessage(playerid, -1, "{FE6F00}Tanques {FFFFFF}6. Tanque #6 | 7. Tanque #7 | 8. Tanque #8 | 9. Tanque #9");
        SendClientMessage(playerid, -1, "{FE6F00}Moledores {FFFFFF}10. Actor #1 | 11. Actor #2 | 12. Actor #3 | 13. Actor #4 | 14. Actor #5");
        SendClientMessage(playerid, -1, "{FE6F00}Almacen {FFFFFF}15. Almacen #1 | 16. Almacen #2 | 17. Almacen #3 | 18. Almacen #4 | 19. Almacen #5");
        SendClientMessage(playerid, -1, "{FE6F00}Almacen {FFFFFF}20. Almacen #6 | 21. Almacen #7 | 22. Almacen #8 | 23. Almacen #9 | 24. Almacen #10");
        return 1;
    }
    if (params[0] >= MAX_FABRICAS) return SendClientMessage(playerid, -1, "No puedes dar stats a una fabrica que no existe.");
    if (!FABRICAS_INFO[params[0]][f_VALID]) return SendClientMessage(playerid, -1, "No puedes dar stats a una fabrica que no existe.");

    switch (params[1]) {
        case 1..9: {
            FABRICAS_INFO[params[0]][f_TANQUE][params[1] - 1] = params[2];
            ActualizarLabelsFabrica(params[0]);
            return 1;
        }
        case 10..14: {
            FABRICAS_INFO[params[0]][f_PORCIENTO_COCINERO][params[1] - 10] = params[2];
            FABRICAS_INFO[params[0]][f_ESTADO_COCINERO][params[1] - 10] = 2;
            CargarActoresFabrica(params[0]);
            return 1;
        }
        case 15..24: {
            FABRICAS_INFO[params[0]][f_CAJAS_SLOT][params[1] - 15] = params[2];
            ActualizarAlmacenFabrica(params[0]);
            return 1;
        }
        default: {
            SendClientMessage(playerid, -1, "Escribe {009AFF}/fstat {FFFFFF}<Fabrica_ID> <Numero> <Valor>");
            SendClientMessage(playerid, -1, "{FE6F00}Cocinas {FFFFFF}1. Tanque #1 | 2. Tanque #2 | 3. Tanque #3 | 4. Tanque #4 | 5. Tanque #5");
            SendClientMessage(playerid, -1, "{FE6F00}Cocinas {FFFFFF}6. Tanque #6 | 7. Tanque #7 | 8. Tanque #8 | 9. Tanque #9");
            SendClientMessage(playerid, -1, "{FE6F00}Moledores {FFFFFF}10. Actor #1 | 11. Actor #2 | 12. Actor #3 | 13. Actor #4 | 14. Actor #5");
            SendClientMessage(playerid, -1, "{FE6F00}Almacen {FFFFFF}15. Almacen #1 | 16. Almacen #2 | 17. Almacen #3 | 18. Almacen #4 | 19. Almacen #5");
            SendClientMessage(playerid, -1, "{FE6F00}Almacen {FFFFFF}20. Almacen #6 | 21. Almacen #7 | 22. Almacen #8 | 23. Almacen #9 | 24. Almacen #10");
            return 1;
        }
    }
    return 1;
}
CMD:ci(playerid, params[]) {
    new id, interior, query[70];
    if (PLAYER_INFO[playerid][pMapper] == 0 && PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_GLOBAL) return 0;
    if (sscanf(params, "dd", id, interior)) return SendClientMessage(playerid, -1, "Escribe {"COLOR_GM "}/ci {FFFFFF}<CasaID> <Interior>"); {
        if (PropInfo[id][pEnUso] == 1) {
            DarInteriorCasa(id, interior);
            switch (interior) {
                case 40 : PropInfo[id][pTipo] = 2;
                case 41 : PropInfo[id][pTipo] = 3;
                case 43 : PropInfo[id][pTipo] = 4;
                default: PropInfo[id][pTipo] = 1;
            }
            PropInfo[id][pInterior] = interior;
            BorrarLabelCasa(id);
            CargarPropiedad(id);
            GuardarPropiedad(id);
            mysql_format(handle_db, query, sizeof(query), "Cambiaste el interior de la casa ID: {"        COLOR_GM "}%d (Interior: %d).", id, interior);
            SendClientMessage(playerid, -1, query);
        } else SendClientMessage(playerid, -1, "Esa propiedad no existe.");
    }
    return true;
}
CMD:borrargarage(playerid, params[]) {
    new casa, string[200];
    if (PLAYER_INFO[playerid][pMapper] == 0 && PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_GLOBAL) return 0;
    if (sscanf(params, "d", casa)) return SendClientMessage(playerid, -1, "Escribe {"COLOR_GM "}/borrargarage {FFFFFF}<GarageID>"); {
        if (PropInfo[casa][pGX] != 0) {
            PropInfo[casa][pGX] = 0, PropInfo[casa][pGY] = 0;
            PropInfo[casa][pGZ] = 0, PropInfo[casa][pGA] = 0;
            format(string, sizeof(string), "Eliminaste el garaje con id: {"        COLOR_GM "}%d", casa);
            SendClientMessage(playerid, -1, string);
            format(string, sizeof(string), "UPDATE `propiedades` SET `GX`='%f',`GY`='%f',`GZ`='%f',`GA`='%f' WHERE `ID`='%d'",
                PropInfo[casa][pGX], PropInfo[casa][pGY],
                PropInfo[casa][pGZ], PropInfo[casa][pGA],
                PropInfo[casa][pID]), mysql_tquery(handle_db, string);
            BorrarLabelCasa(casa), CargarPropiedad(casa);
        } else SendClientMessage(playerid, -1, "Esa propiedad no tiene un garage.");
    }
    return 1;
}
CMD:malnombre(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) return 0;
    if (AdminDuty[playerid] == 0) return SendClientMessage(playerid, -1, "No puedes usar este comando en fuera de servicio administrativo");
    if (sscanf(params, "r", params[0])) return SendClientMessage(playerid, COLOR_GRAD2, "MODO DE USO: /malnombre <PlayerID>");
    if (PLAYER_INFO[params[0]][pAdmin] > 0) return ExpulsarJugador(playerid, "Intento de trollear admins");
    if (PLAYER_TEMP[params[0]][Adv_NAR] > 0) SendClientMessage(playerid, -1, "El jugador ya fue advertido.");
    if (IsPlayerNPC(params[0])) return 1;
    if (!IsPlayerConnected(params[0])) return SendClientMessage(playerid, 0x25AB26FF, "Jugador no conectado");
    new stringa2[128];
    format(stringa2, sizeof(stringa2), "{"COLOR_GM "}- Hola {249627}%s{DDF543}, el equipo administrativo te informa que tu nombre incumple nuestras reglas.", PlayerName(params[0]));
    SendClientMessage(params[0], -1, stringa2);
    SendClientMessage(params[0], -1, "{"COLOR_GM "}- El formato de nombre es {FFFFFF}Nombre_Apellido{DDF543}, el cual tiene que contener las iniciales en Mayusculas.");
    SendClientMessage(params[0], -1, "{"COLOR_GM "} No puede ser el nombre de un famoso, no puede contener numeros y tampoco pueden ser nombres irreales.");
    SendClientMessage(params[0], -1, "{"COLOR_GM "}- Puedes cambiar tu nombre sin perder tu partida, para ello tienes que entrar con tu cuenta y:");
    SendClientMessage(params[0], -1, "{EE391D}  solicitar un{DDF543} Administrador {FFFFFF} y pedir el cambio del nombre");
    SendClientMessage(params[0], -1, "{"COLOR_GM "} En caso de no cambiar tu nombre seras sancionado.");
    SendClientMessage(params[0], -1, "{"COLOR_GM "}- Al parecer no conoces las reglas, leelas detenidamente ingresando el comando {FFFFFF}/reglas");
    new year, month, day;
    getdate(year, month, day);
    mysql_format(handle_db, QUERY_BUFFER, sizeof(QUERY_BUFFER), "INSERT INTO blacklist (Nombre, Dia, Mes, Year, Admin) VALUES ('%s','%d','%d','%d','%s')", PLAYER_INFO[params[0]][Nickname], day, month, year, PLAYER_INFO[playerid][Nickname]);
    mysql_tquery(handle_db, QUERY_BUFFER);
    new stringa[120];
    format(stringa, 120, "%s envio una advertencia de nombre antirol a %s[%d]", PlayerName(playerid), PlayerName(params[0]), params[0]);
    MensajeAdmin(COLOR_CHEAT, stringa, 4);

    return 1;
}

CMD:advcheat(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) return 0;
    if (AdminDuty[playerid] == 0) return SendClientMessage(playerid, -1, "No puedes usar este comando en fuera de servicio administrativo");
    if (sscanf(params, "r", params[0])) return SendClientMessage(playerid, COLOR_GRAD2, "MODO DE USO: /advcheat <PlayerID>");
    if (IsPlayerNPC(params[0])) return 1;
    if (!IsPlayerConnected(params[0])) return SendClientMessage(playerid, 0x25AB26FF, "Jugador no conectado");
    new str[670], string[90], id;
    format(str, sizeof(str), "%s{DBED15}Hola {FF3300}%s{DBED15}, el anticheat detecto el uso de CLEOS o MODS prohibidos.\n", str, PlayerName(id));
    format(str, sizeof(str), "%s{DBED15}- No se permite el uso de cleos o mods que te beneficien o den ventajas a tu jugador\n", str);
    format(str, sizeof(str), "%spor favor, salga del juego y desinstale/remueva todos los cleos o mods prohibidos.\n", str);
    format(str, sizeof(str), "%s{DBED15}- En caso que no sigas esta regla, podras ser baneado permanentemente del servidor.\n", str);
    format(str, sizeof(str), "%s{DBED15}- Al parecer no conoces las reglas, leelas detenidamente ingresando el comando {DBED15}/reglas", str);
    dialogs_ShowPlayerDialog(id, INFOLADRON, DIALOG_STYLE_MSGBOX, "{FFFFFF}Informacion", str, "Aceptar", "");
    format(string, 90, "%s envio una advertencia de cheat a %s[%d]", PlayerName(playerid), PlayerName(params[0]), params[0]);
    MensajeAdmin(COLOR_CHEAT, string, 4);
    SetTimerEx("KickXD", 1000, 0, "d", params[0]);
    return 1;
}

CMD:editar(playerid, params[]) {
    if (PLAYER_INFO[playerid][pMapper] == 0 && PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_GLOBAL) return 0;
    new id, precio, nivel, moneda, comprable, string[70];
    if (!sscanf(params, "ddddd", id, precio, nivel, moneda, comprable)) {
        if (PropInfo[id][pEnUso] == 1) {
            if (moneda < 0 || moneda > 2) return SendClientMessage(playerid, -1, "Esa moneda es invalida.");
            if (comprable < 0 || comprable > 1) return SendClientMessage(playerid, -1, "Ese comprable es invalido.");
            PropInfo[id][pPrecio] = precio, PropInfo[id][pNivel] = nivel;
            PropInfo[id][pEnVentaPor] = moneda, PropInfo[id][pEnVenta] = comprable;
            BorrarLabelCasa(id), GuardarPropiedad(id);
            CargarPropiedad(id), format(string, sizeof(string), "Editaste el estado de la casa con id: {"        COLOR_GM "}%d", id);
            SendClientMessage(playerid, -1, string);
        } else SendClientMessage(playerid, -1, "Esa propiedad no existe.");
    } else SendClientMessage(playerid, -1, "Escribe {"COLOR_GM "}/editar {FFFFFF}<CasaID> <Precio> <Nivel> <Moneda> <Comprable>");
    return true;
}


public ActualizarRadar() {
    foreach(new playerid : Player) //Loop de playerids
    {
        if (PLAYER_INFO[playerid][pFaccion] == 1 && PLAYER_INFO[playerid][pDuty] == 1 || PLAYER_INFO[playerid][pFaccion] == 2 && PLAYER_INFO[playerid][pDuty] == 1) {
            foreach(new x : Player) //Loop de playerids
            {
                if (!IsPlayerNPC(x) && IsPlayerConnected(x)) {
                    switch (PLAYER_INFO[x][pCargos]) {
                        case 0 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO0);
                        case 1 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO1);
                        case 2 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO2);
                        case 3 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO3);
                        case 4 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO4);
                        case 5 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO5);
                        case 6 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                        case 7 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                        case 8 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                        case 9 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                        case 10 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                        case 11 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                        case 12 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                        case 13 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                        case 14 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                        case 15 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                        case 16 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                        case 17 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                        case 18 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                        case 19 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                        case 20 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO6);
                    }
                }
            }
        }
    }
    return 1;
}


public BuscarCriminales() {
    foreach(new playerid : Player) //Loop de playerids
    {
        if (PLAYER_INFO[playerid][pFaccion] == 1 && PLAYER_INFO[playerid][pDuty] == 1 || PLAYER_INFO[playerid][pFaccion] == 2 && PLAYER_INFO[playerid][pDuty] == 1) {
            foreach(new x : Player) //Loop de playerids
            {
                if (!IsPlayerNPC(x) && IsPlayerConnected(x)) {
                    if (PLAYER_TEMP[x][VariableCaido] == 0) {
                        switch (PLAYER_INFO[x][pCargos]) {
                            case 1 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO1);
                            case 2 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO2);
                            case 3 : SetPlayerMarkerForPlayer(playerid, x, COLORCARGO3);
