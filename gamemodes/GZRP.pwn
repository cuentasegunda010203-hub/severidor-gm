                			format(stringranking, sizeof(stringranking), "{F0525F}[%s] %s",Launcher(playerid), PLAYER_INFO[playerid][pEstadoX]);
                			CreatePlayerLabel(playerid, stringranking, COLOR_GAMEMODE);
