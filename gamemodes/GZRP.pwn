                            if (PLAYER_INFO[playerid][pVelocimetro] == 1) {
                                PLAYER_INFO[playerid][pVelocimetro] = 0;
                            } else {
                                PLAYER_INFO[playerid][pVelocimetro] = 1;
                                ShowConfig(playerid);
                            }
                        }
                        if (GetPlayerState(playerid) != PLAYER_STATE_DRIVER) {
                            switch (PLAYER_INFO[playerid][pVelocimetro]) {
                                case 0 : PLAYER_INFO[playerid][pVelocimetro] = 1;
                                default: PLAYER_INFO[playerid][pVelocimetro] = 0;
                            }
                            ShowConfig(playerid);
                        }
                    }
                    case 9: {
                        if (JugadorLogeado[playerid] != 1) return 1;
                        new habilitado = !RP_AutoLogin[playerid], consulta[180];
                        mysql_format(handle_db, consulta, sizeof(consulta), "UPDATE usuarios SET LogAutomatico=%d WHERE ID=%d", habilitado, PLAYER_INFO[playerid][pID]);
                        new Cache:resultado = mysql_query(handle_db, consulta);
                        new error = mysql_errno(handle_db);
                        if (cache_is_valid(resultado)) cache_delete(resultado);
                        if (error != 0) return SendClientMessage(playerid, -1, "No se pudo guardar la configuracion de ingreso.");
                        RP_AutoLogin[playerid] = habilitado;
                        if (habilitado) SendClientMessage(playerid, -1, "Ingreso automatico activado para conexiones desde la misma IP.");
                        else SendClientMessage(playerid, -1, "Ingreso automatico desactivado. Se pedira tu clave al volver a conectar.");
                        ShowConfig(playerid);
                    }
                    case 10: {
                        if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_DUDAS) return 0;
                        new a[30];
                        if (VerAdmin[playerid] == 0) VerAdmin[playerid] = 1, a = "Mostrando log de admin.";
                        else VerAdmin[playerid] = 0, a = "Ocultando log de admin.";
                        SendClientMessage(playerid, -1, a);
                        ShowConfig(playerid);
                    }
                }
            }
