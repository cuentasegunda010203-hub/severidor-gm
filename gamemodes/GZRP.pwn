static const RP_GuardTimes[] = {TiempoGuarda, TiempoGuarda2, TiempoGuarda3, TiempoGuarda4, TiempoGuarda5, TiempoGuarda6};
new ContarNPC, RP_FactoryOwner[MAX_PLAYERS];
enum RP_GuardInfo { Float:gVida, gExiste, guarNombre[128], Text3D:TextGuarda, manejando, propietario };
new guardaespaldabot[MAX_PLAYERS][RP_GuardInfo];
new Float:gSpawn[][] = {{1412.1326, -1663.7592, 13.5469}};
new Float:gSpawn2[][] = {{1126.3505, -2041.9137, 69.8812}};
new bool:SiNosAtacan[MAX_PLAYERS], G_Atacando[MAX_PLAYERS], G_Siguiendo[MAX_PLAYERS];
new bool:SiNosAtacan2[MAX_PLAYERS], G_Atacando2[MAX_PLAYERS], G_Siguiendo2[MAX_PLAYERS];
new bool:SiNosAtacan3[MAX_PLAYERS], G_Atacando3[MAX_PLAYERS], G_Siguiendo3[MAX_PLAYERS];
new bool:SiNosAtacan4[MAX_PLAYERS], G_Atacando4[MAX_PLAYERS], G_Siguiendo4[MAX_PLAYERS];
new bool:SiNosAtacan5[MAX_PLAYERS], G_Atacando5[MAX_PLAYERS], G_Siguiendo5[MAX_PLAYERS];
