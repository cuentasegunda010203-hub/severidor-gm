        case D_COLOR1: {
            if (response) {
                if (PLAYER_INFO[playerid][Totems] < 20) return SendClientMessage(playerid, -1, "Necesitas 20 Totems para esto");
                dialogs_ShowPlayerDialog(playerid, D_COLOR2, DIALOG_STYLE_LIST, "{FFFFFF}Selecciona el color para tu banda", DIALOG_CREATE_CREW_COLOR_String, "Seleccionar", "Atras");
            }
        }

        case D_COLOR2: {
            if (response) {

                new Banda = PLAYER_INFO[playerid][pFaccion];
                new ColorB = RandomColors[listitem];
                for(new id; id < MAX_BANDAS; id++) {
                    if (BandasInfo[id][BColor] == ColorB) return dialogs_ShowPlayerDialog(playerid, D_COLOR2, DIALOG_STYLE_LIST, "{FFFFFF}Color en uso, selecciona otro color", DIALOG_CREATE_CREW_COLOR_String, "Seleccionar", "Atras");
                }
                BandasInfo[Banda][BColor] = ColorB;
                new DB_Query[256];
                mysql_format(handle_db, DB_Query, sizeof(DB_Query), "UPDATE `facciones` SET `Color` = '%d' WHERE `id`='%d'", BandasInfo[Banda][BColor], BandasInfo[Banda][bID]);
                mysql_tquery(handle_db, DB_Query);
                new CrewColorChat = getPlayerCrewColor(playerid);
                foreach(new i : Player) {
                    if (PLAYER_INFO[playerid][pFaccion] > 1) {
                        SetPlayerGangZones(i);
                        if (PLAYER_INFO[i][pFaccion] == Banda) {
                            SendClientMessageEx(i, CrewColorChat, "[Banda]{00CCFF}%s{FFFFFF} cambio el color de la banda a:", PLAYER_INFO[playerid][Nickname], BandasInfo[Banda][BColor]);
                            SendClientMessageEx(i, CrewColorChat, "||||||||||||||||||||||||||||||||");
                        }

                    }
                }
            }
        }
        case TNEON: {
            new params[128];
            new vehicleid = GetPlayerVehicleID(playerid);
            if (response) {
                switch (listitem) {
                    case 0: {
                        if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
                            if (PLAYER_TIMES[playerid][TiempoMotor] == 0) {

                                if (VehiculosInfo[vehicleid][vcomprable] != 1) {

                                    if (!BICI(vehicleid)) {

                                        if (MotorAuto[vehicleid] == 0) {
                                            if (VehicleFuel[vehicleid] <= 1) return SetTimerEx("SinGasolina", 1200, false, "d", playerid);
                                            ShowPlayerMessage(playerid, "Encendiendo motor...", 1500);
                                            PLAYER_TEMP[playerid][EncendiendoVeh] = 1;
                                            SetTimerEx("EncenderMotor", 1200, false, "d", playerid);
                                            PLAYER_TIMES[playerid][TiempoMotor] = 2;
                                        } else {
                                            PLAYER_TIMES[playerid][TiempoMotor] = 2;
                                            ApagarMotor(playerid);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    case 1: {
                        callcmd::luces(playerid, params);
                    }

                    case 2 : {
                        if (PLAYER_INFO[playerid][pVip] < 2) return SendClientMessage(playerid, COLOR_WHITE, "Para activar esta caracteristica necesitar tener una membresia VIP {00CC00}#2.");
                        if (IsPlayerOnBike(playerid) || IsPlayerInBoat(playerid) || IsPlayerOnBicycle(playerid)) return SendClientMessage(playerid, COLOR_GREY, "* Este vehiculo no acepta neon.");
                        if (PLAYER_INFO[playerid][pDuty] == 1) return SendClientMessage(playerid, COLOR_GREY, "* Los policias en servicio no pueden usar neones.");
                        if (Neon[GetPlayerVehicleID(playerid)][NeonPrendido] == 1) return SendClientMessage(playerid, -1, "* Los neones ya estan encendidos.");
                        format(string, sizeof(string), "Azul\nVerde\nBlanco\nAmarilo\nRojo\nRosa");
                        dialogs_ShowPlayerDialog(playerid, TNEON2, DIALOG_STYLE_LIST, "Elige un color", string, "Seleccionar", "");
                    }
                    case 3: {
                        DestroyDynamicObject(Neon[GetPlayerVehicleID(playerid)][neon0]);
                        DestroyDynamicObject(Neon[GetPlayerVehicleID(playerid)][neon1]);
                        DestroyDynamicObject(Neon[GetPlayerVehicleID(playerid)][neon2]);
                        DestroyDynamicObject(Neon[GetPlayerVehicleID(playerid)][neon3]);
                        Neon[GetPlayerVehicleID(playerid)][NeonPrendido] = 0;
                        AccionesRol(playerid, "apreta un boton de su tablero, y seguidamente se apagan las luces de neon del vehiculo.", 20);
                    }
                    case 4: {
                        if (IsPlayerOnBike(playerid) || IsPlayerInBoat(playerid) || IsPlayerOnBicycle(playerid)) return SendClientMessage(playerid, COLOR_GREY, "* Este vehiculo no tiene ventanas.");
                        if (IsPlayerInAnyVehicle(playerid)) {
                            if (VehicleWindows[GetPlayerVehicleID(playerid)] == 0) {
                                VehicleWindows[GetPlayerVehicleID(playerid)] = 1;
                                new driver, passenger, backleft, backright;
                                GetVehicleParamsCarWindows(GetPlayerVehicleID(playerid), driver, passenger, backleft, backright);
                                SetVehicleParamsCarWindows(GetPlayerVehicleID(playerid), 0, 0, 0, 0);
                                AccionesRol(playerid, "baja las ventanas del vehiculo.", 20);
                                return 1;
                            } else if (VehicleWindows[GetPlayerVehicleID(playerid)] == 1) {
                                VehicleWindows[GetPlayerVehicleID(playerid)] = 0;
                                AccionesRol(playerid, "sube las ventanas del vehiculo.", 20);
                                new driver, passenger, backleft, backright;
                                GetVehicleParamsCarWindows(GetPlayerVehicleID(playerid), driver, passenger, backleft, backright);
                                SetVehicleParamsCarWindows(GetPlayerVehicleID(playerid), 1, 1, 1, 1);
                                return 1;
                            }

                        }
                    }
                    case 5: {
                        new datosxd[200];
                        new autoid = GetPlayerVehicleID(playerid), Float:Health;
                        GetVehicleHealth(autoid, Health);
                        format(datosxd, 200, "El estado del vehiculo es de {00CC00}(%d){FFFFFF}.", Health);
                        SendClientMessage(playerid, -1, datosxd);
                    }
                    //cierre
                }
            }
        }

