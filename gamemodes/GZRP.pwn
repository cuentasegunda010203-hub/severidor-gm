CMD:verificar(playerid, params[]) {
    new item[128];
    if (sscanf(params, "s[128]", item)) {
        PUSH(playerid, "~g~~h~Usa /verificar correo");
        return 1;
    }
    if (strcmp(item, "correo", true) == 0) {
        if (PLAYER_INFO[playerid][EstadoCorreo] == 0) {
            PUSH(playerid, "Espere...");
            SetTimerEx("TimerVerificarC", 10000, false, "d", playerid);
            EnviarCorreo(playerid, 0); //plantilla-email-v.php
        } else return SendClientMessage(playerid, -1, "Tu correo ya se encuentra verificado.");
    }
    return 1;
}
public TimerVerificarC(playerid) {
    Notificador2(playerid, "~r~Se ha enviado el correo de verificacion ~g~exitosamente.");
    Notificador2(playerid, "~g~En caso de no encontrar el correo, revisa la carpeta ~w~SPAM~g~.");
    return 1;
}

CMD:vincular(playerid, params[]) {
    new item[128];
    if (sscanf(params, "s[128]", item)) {
        if (CanDoAnims(playerid) == 1) return 1;
        ApplyAnimation(playerid, "BAR", "Barserve_give", 4.1, 0, 0, 0, 0, 0);
        return 1;
    }
    if (strcmp(item, "foro", true) == 0) {
        SendClientMessage(playerid, -1, "Ahora es /obtener recompensa");
    }
    return 1;
}
CMD:obtener(playerid, params[]) {
    new item[128];
    if (sscanf(params, "s[128]", item)) {
        if (CanDoAnims(playerid) == 1) return 1;
        ApplyAnimation(playerid, "BAR", "Barserve_give", 4.1, 0, 0, 0, 0, 0);
        return 1;
    }
    if (strcmp(item, "recompensa", true) == 0) {
        if (PLAYER_INFO[playerid][EstadoCorreo] == 0) return SendClientMessage(playerid, -1, "Para recibir las{ffff00} Recompensas{ffffff} verifica tu correo en {ffff00}"WEB_INDEX "/cuenta.php");
        if (PLAYER_INFO[playerid][pRecompensaLZ] == 1) return SendClientMessage(playerid, -1, "Ya obtuviste la recompensa.");
        if (PLAYER_INFO[playerid][horasjugadas] >= 5) {
            new query[256];
            mysql_format(handle_db, query, sizeof(query), "UPDATE `usuarios` SET `RecompensaLZ`='1' WHERE `ID`='%d'", PLAYER_INFO[playerid][pID]);
            mysql_tquery(handle_db, query);
            new Query1[500];
            mysql_format(handle_db, Query1, sizeof(Query1), "UPDATE `usuarios` SET `Stats`='1' WHERE `ID`='%d'", PLAYER_INFO[playerid][pID]);
            mysql_tquery(handle_db, Query1);
            DarDinero(playerid, 100000);
            PLAYER_INFO[playerid][pRecompensaLZ] = 1;
            PLAYER_INFO[playerid][Totems] += 10;
            PLAYER_INFO[playerid][Moneda] += 50;
            PLAYER_INFO[playerid][pCrack] += 1400, PLAYER_INFO[playerid][pRemedios] += 1800;
            PLAYER_INFO[playerid][@Nivel] += 1;
            PLAYER_INFO[playerid][pNivelArmero] += 1, PLAYER_INFO[playerid][pNivelCamionero] = 2;
            RevisarLogro(playerid, 1);
            PLAYER_INFO[playerid][pMateriales] += 1000;
            Actualizar(playerid);
            SendClientMessage(playerid, -1, "{366397}¡Gracias por jugar en {CCCCCC}"    NAME_LARGO "{366397}!");
            dialogs_ShowPlayerDialog(playerid, INVENTARIO, DIALOG_STYLE_TABLIST_HEADERS, "{366397}"    NAME_LARGO " "SERVER_VERSION "", "Nombre\tCantidad\t+\n{DDD378}Nivel\t{00ff00}-\t{75AEFC}+1\n{DDD378}Nivel Job\t{00ff00}+1\t{DDD378}Armero\n{DDD378}Piezas de Armas\t{00ff00}-\t{DDD378}+3.000\n{DDD378}Medicamentos\t{00ff00}-\t{DDD378}+3800\n{DDD378}Nivel Job\t{00ff00}+2\t{DDD378}Camionero\n{75AEFC}Monedas\t50 | 10\t"SERVER_COIN " | Totems", "{366397}Aceptar", "");
            GuardarCuenta(playerid);
        } else return SendClientMessageEx(playerid, -1, "{"    COLOR_GM "}Necesitas mas de 5 horas de juego para hacer esto y tienes %d.", PLAYER_INFO[playerid][horasjugadas]);
    }
    return 1;
}
CMD:recibir(playerid, params[]) {
    new item[128];
    if (sscanf(params, "s[128]", item)) {
        if (CanDoAnims(playerid) == 1) return 1;
        ApplyAnimation(playerid, "BAR", "Barserve_give", 4.1, 0, 0, 0, 0, 0);
        return 1;
    }
    if (strcmp(item, "stats", true) == 0) {
        if (PLAYER_INFO[playerid][pStats] == 0) {
            SendClientMessage(playerid, -1, "{FF0000}Luego de 5 horas en "NAME_LARGO " podras usar /obtener recompensa");
            new string1[1300];
            string1 = "{FFFFFF}Bienvenido a "    NAME_LARGO " Roleplay\nEn esta version te traemos sistemas unicos, para que te diviertas y trabajes con tus amigos.\nRecuerda leer las Reglas del Juego en nuestro foro.\nEn nuestra web tenemos variedades de items para comprar con monedas "    SERVER_COIN ", usa /web.\n{FFFFFF}Pulsa Aceptar para recibir regalos de bienvenida.";
            dialogs_ShowPlayerDialog(playerid, DIALOG_STATS, DIALOG_STYLE_MSGBOX, "{ffffff}"    SERVER_NAME3 "{366397} v"SERVER_VERSION "", string1, "Ok", ""); //Mejorar
        }
    }
    return 1;
}
