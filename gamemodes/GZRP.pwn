CMD:unsan(playerid, params[]) {
    new id;
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_SANCIONES) return 0;
    if (!sscanf(params, "d", id)) {
        if (IsPlayerNPC(id)) return 1;
        NoTeleportHack(id);
        SetPlayerInterior(id, 0);
        SetPlayerVirtualWorld(id, 0);
        PLAYER_INFO[id][pTiempoCarcel] = 0;
        PLAYER_INFO[playerid][Agonizando] = 0;
        San[id] = 0;
        Jail[id] = 0;
        CeldaJugador[id] = 0;
        PLAYER_INFO[id][pTiempoJail] = 0;
        PLAYER_INFO[id][pEnFC] = 0;
        PLAYER_INFO[id][pCargos] = 0;
        ActualizarRadar();
        SetPlayerWantedLevelEx(id, PLAYER_INFO[id][pCargos]);
        SetPlayerColor(id, c0_color);
        SetPlayerPos(id, 1510.23, -1672.60, 14.05);
        Revivir(id);
        new string[150];
        format(string, 150, "{CCCCCC}(Administracion): %s saco de sancion a %s.", PlayerName(playerid), PlayerName(id));
        MensajeAdmin(-1, string, 5);
    } else return SendClientMessage(playerid, COLOR_WHITE, "Escribe {"COLOR_GM "}/unsan {FFFFFF}<PlayerID>");
    return 1;
}
CMD:setarma(playerid, params[]) {
    new id, arma;
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM_TEMP) return 0;
    if (!sscanf(params, "dd", id, arma)) {
        if (IsPlayerNPC(id)) return 1;
        //if(arma == 35 || arma == 36 || arma == 37 || arma == 38 || arma == 38 || arma == 39 || arma == 44 || arma == 41 || arma == 40 || arma == 41 || arma == 44) return SendClientMessage(playerid,-1,"No puedes dar ese arma.");
        DarArma(id, arma);
        new string[150];
        format(string, 150, "{DC143C}(Administracion): %s le dio un arma a %s modelo %s.", PlayerName(playerid), PlayerName(id), NombreArma[arma]);
        MensajeAdmin(-1, string, 5);
    }
    return 1;
}


CMD:mutead(playerid, params[]) {
    new id, tiempo, string[128], razon[200], string2[128];
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_DUDAS) return 0;
    if (!sscanf(params, "dds[200]", id, tiempo, razon)) {
        if (!IsPlayerConnected(id)) return SendClientMessage(playerid, COLOR_WHITE, "No se encontro ningun jugador.");
        if (tiempo <= 3) return SendClientMessage(playerid, -1, "El tiempo minimo de muteo es de 5 minutos.");
        if (PLAYER_TIMES[id][TiempoAD] > 240) return SendClientMessage(playerid, -1, "Ese jugador ya esta muteado.");
        PLAYER_TIMES[id][TiempoAD] = tiempo * 60;
        foreach(new i : Player) {
            if (JugadorLogeado[i] == 1) {
                if (PLAYER_INFO[i][pMuteos] == 1) {
                    format(string, sizeof(string), "Al numero %d no se le permite colocar anuncios. Razon: %s", PLAYER_INFO[id][pNumero], razon);
                    SendClientMessage(i, 0xAA3333FF, string);
                }
            }
            if (PLAYER_INFO[i][pAdmin] > ADMIN_LEVEL_DUDAS) {
                format(string, 128, "Tiempo de muteo: %d minutos, Administrador: %s", tiempo, PlayerName(playerid));
                SendClientMessage(i, COLOR_GREY, string);
            }
        }
        format(string2, 128, "No se te permite hablar en el canal de anuncios. Por %d minuto(s)", tiempo);
        format(string2, 128, "Se te Desconto $20000.");
        SendClientMessage(id, 0xDEA600FF, string2);
        new message[120];
        format(message, 120, "%s muteo a %s por %s (Tiempo: %d).", NombreJugador(playerid), NombreJugador(id), razon, tiempo);
    } else return SendClientMessage(playerid, -1, "Usa: {CC46DC}/mutead [id] [minutos] [razon]");
    return 1;
}

CMD:dararmatodos(playerid, params[]) {
    new arma;
    if (PLAYER_INFO[playerid][jAdminNvl] < ADMIN_LEVEL_ADM_TEMP) return 0;
    if (!sscanf(params, "d", arma)) {
        foreach(new i : Player) {
            if (IsPlayerConnected(i) && !IsPlayerNPC(i)) {
                DarArma(i, arma);
            }
        }
        new cadena[50];
        format(cadena, sizeof(cadena), "%s le diste un %s a todos los jugadores.", NombreJugador(playerid), GetWeaponNameEx(arma));
        SendClientMessage(playerid, -1, cadena);

    }
    return 1;
}

CMD:setvip(playerid, params[]) {
    new id, dia, mes, ano, memb, string[128], Query[200];
    getdate(ano, mes, dia);
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM) return 0;

    if (!sscanf(params, "dd", id, memb)) {
        if (IsPlayerNPC(id)) return 1;
        if (memb < 0 || memb > 3) return SendClientMessage(playerid, -1, "Solo puedes asignar membresia VIP1, VIP2 o GVIP");
        PLAYER_INFO[id][pVip] = memb;
        mysql_format(handle_db, Query, sizeof(Query), "UPDATE `usuarios` SET `FinDia`='%d',`FinMes`='%d',`FinAno`='%d' WHERE `Username`='%e'", dia, mes + 1, ano, PLAYER_INFO[id][Nickname]);
        mysql_tquery(handle_db, Query);
        format(string, 128, "El administrador %s te dio una membresia Vip%d", PLAYER_INFO[playerid][Nickname], memb);
        SendClientMessage(id, -1, string);
        format(string, 128, "Le diste a %s una membresia VIP%d hasta el %02d/%02d/%02d", PLAYER_INFO[id][Nickname], memb, dia, mes + 1, ano);
        PLAYER_INFO[id][findia] = dia;
        PLAYER_INFO[id][finmes] = mes + 1;
        PLAYER_INFO[id][finano] = ano;

        SendClientMessage(playerid, -1, string);
    }
    return 1;
}
CMD:dudaslargo(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_DUDAS) return 0; {
        if (dudas_largo == 1) {
            dudas_largo = 0;
            foreach(new i : Player) { Notificador2(i, "Canal de dudas largo ~r~desactivado"); }
        } else if (dudas_largo == 0) {
            dudas_largo = 1;
            foreach(new i : Player) { Notificador2(i, "Canal de dudas largo ~b~activado"); }
        }
    }
    return 1;
}
CMD:dudasfz(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_DUDAS) return 0; {
        switch (dudas_fz) {
            case 0:
                dudas_fz = 1, Notificador2(playerid, "Canal de dudas fz ~b~activado");
            case 1 : dudas_fz = 0, Notificador2(playerid, "Canal de dudas fz ~r~desactivado");
        }
    }
    return 1;
}
