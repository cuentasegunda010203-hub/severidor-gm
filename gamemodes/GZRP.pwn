                        format(string, sizeof(string), "Ofreciste tu propiedad ubicada en {00CC00}%s{FFFFFF} por {00CC00}$%d.", PropInfo[p][pLocalizacion], EnCuantoLoVende[playerid]);
                        MensajeEx(playerid, -1, string);
                        QueSlot[playerid] = home;
                        PLAYER_TEMP[playerid][CasaOfrecida] = PLAYER_INFO[playerid][CasaID][home];
                        PLAYER_TEMP[VenderA[playerid]][CasaOfrecida] = PLAYER_INFO[playerid][CasaID][home];
                        new _dialog[200];
                        if (PLAYER_INFO[VenderA[playerid]][jDinero] < EnCuantoLoVende[playerid]) return SendClientMessage(playerid, -1, "El jugador no tiene el dinero suficiente.");
                        format(_dialog, sizeof _dialog, "{FFFFFF}El jugador {ffff00}%s {FFFFFF}te esta ofreciendo una propiedad ubicada en %s{FFFFFF} por {00FF00}$%d", PLAYER_INFO[playerid][Nickname], PropInfo[p][pLocalizacion], EnCuantoLoVende[playerid]);
                        dialogs_ShowPlayerDialog(VenderA[playerid], VENDER_CASA_A5, DIALOG_STYLE_MSGBOX, "¿Aceptas la compra?", _dialog, "Aceptar", "Rechazar");
                        break;
                    }
                }
            }
        }
        case VENDER_CASA_A5: {
            if (!response) return SendClientMessage(VenderA[playerid], -1, "El jugador rechazo la compra.");
            if (!IsPlayerConnected(VenderA[playerid])) return SendClientMessage(playerid, -1, "El vendedor se desconecto.");
            new c = PLAYER_TEMP[playerid][CasaOfrecida];
            if(c<=0 || c>=MAX_PROPIEDADES) return 1;
            if(!RP_BizLegacyVipCheck(playerid,"propiedad",c)) return 1;
            if(PropInfo[c][pTipo]<2 || PropInfo[c][pTipo]>4) switch (PLAYER_INFO[playerid][pVip]) {

                case 2 : if(ObtenerCasas(playerid) > 1) return SendClientMessage(playerid, -1, "Solo puedes tener hasta 2 propiedades con tu membresía VIP actual.");
                case 3 : if(ObtenerCasas(playerid) > 2) return SendClientMessage(playerid, -1, "Solo puedes tener hasta 3 propiedades con tu membresía VIP actual.");
                default: if(ObtenerCasas(playerid) > 0) return SendClientMessage(playerid, -1, "Solo puedes tener hasta 1 propiedad.");
            }
            if (PLAYER_TEMP[playerid][CasaOfrecida] == 0) return SendClientMessage(playerid, -1, "Se ha producido un error. Vuelve a intentarlo");

            new hslot = SlotPropiedad(playerid), query[260];
            if (hslot != -1) {
                PLAYER_INFO[playerid][CasaID][hslot] = PropInfo[c][pID];
                mysql_format(handle_db, query, sizeof(query), "UPDATE `usuarios` SET `CasaID%d`='%d' WHERE `ID`='%d'", hslot + 1, PropInfo[c][pID], PLAYER_INFO[playerid][pID]);
                mysql_tquery(handle_db, query);
                PropInfo[c][pEnVenta] = 0;
                PropInfo[c][pEnUso] = 1;
                format(PropInfo[c][pPropietario], 40, "%s", PLAYER_INFO[playerid][Nickname]);
                BorrarLabelCasa(c);
                CargarPropiedad(c);
                mysql_format(handle_db, query, sizeof(query), "UPDATE `propiedades` SET `EnVenta`='0', `Propietario`='%s',`IDPropietario`='%d' WHERE `ID`='%d'", PropInfo[c][pPropietario], PLAYER_INFO[playerid][pID], PropInfo[c][pID]);
                mysql_tquery(handle_db, query);
                Notificador2(playerid, "~g~~h~Acabas de comprar la propiedad");
                printf("Casa comprada id %d a id", playerid, VenderA[playerid]);
                if (PropInfo[c][pTipo] == 1) RevisarLogro(playerid, 9);
                if (PropInfo[c][pTipo] == 2) RevisarLogro(playerid, 10);
                if (PropInfo[c][pTipo] == 3) RevisarLogro(playerid, 11);
                PropInfo[c][pIDPropietario] = PLAYER_INFO[playerid][pID];
                PLAYER_INFO[VenderA[playerid]][CasaID][QueSlot[VenderA[playerid]]] = 0;
                PLAYER_TEMP[playerid][CasaOfrecida] = 0;
                PLAYER_TEMP[VenderA[playerid]][CasaOfrecida] = 0;
            }
            QuitarDinero(playerid, EnCuantoLoVende[VenderA[playerid]]);
            DarDinero(VenderA[playerid], EnCuantoLoVende[VenderA[playerid]]);
            MensajeEx(playerid, -1, "Compraste una propiedad a {366397}%s", PLAYER_INFO[VenderA[playerid]][Nickname]);
            MensajeEx((VenderA[playerid]), -1, "Le vendiste una propiedad a {00FF00}%s", PLAYER_INFO[playerid][Nickname]);
        }
        case VENDERCASA1: {
            if (!response) return 0;
            new home = ObtenerOrdenPropiedad(playerid, listitem);
            if (PLAYER_INFO[playerid][CasaID][home] > 0) {
                for(new p = 1; p < MAX_PROPIEDADES; p++) {
                    if (PropInfo[p][pID] == PLAYER_INFO[playerid][CasaID][home] && PropInfo[p][pPosX] != 0) {
                        switch (PropInfo[p][pEnVentaPor]) {
                            case 0 : format(string, sizeof(string), "Vendiste tu propiedad ubicada en {00CC00}%s{FFFFFF} por {00CC00}$%s.", PropInfo[p][pLocalizacion], ConvertirNumero(PropInfo[p][pPrecio] / 2)), DarDinero(playerid, PropInfo[p][pPrecio] / 2);
                            case 1 : format(string, sizeof(string), "Vendiste tu propiedad ubicada en {00CC00}%s{FFFFFF} por {DBED15}%s "                SERVER_COIN ".", PropInfo[p][pLocalizacion], ConvertirNumero(PropInfo[p][pPrecio] / 2)), PLAYER_INFO[playerid][Moneda] += PropInfo[p][pPrecio] / 2;
                            case 2 : format(string, sizeof(string), "Vendiste tu propiedad ubicada en {00CC00}%s{FFFFFF} por {DBED15}%s Totems.", PropInfo[p][pLocalizacion], ConvertirNumero(PropInfo[p][pPrecio] / 2)), PLAYER_INFO[playerid][Totems] += PropInfo[p][pPrecio] / 2;

                        }
                        MensajeEx(playerid, -1, string);
                        PLAYER_INFO[playerid][CasaID][home] = 0;
                        mysql_format(handle_db, Query, sizeof(Query), "UPDATE `usuarios` SET `CasaID%d`='0',`Moneda`='%d' WHERE `ID`='%d'", home + 1, PLAYER_INFO[playerid][Moneda], PLAYER_INFO[playerid][pID]);
                        mysql_tquery(handle_db, Query);
                        PropInfo[p][pEnVenta] = 1;
                        format(PropInfo[p][pPropietario], 40, "Nadie");
                        PropInfo[p][pAbierta] = 1;
                        PropInfo[p][pRoperoAbierto] = 0;
                        PropInfo[p][pIDPropietario] = 0;
                        mysql_format(handle_db, Query, sizeof(Query), "UPDATE `propiedades` SET `Propietario`='Nadie',`IDPropietario`='0',`EnVenta`='1' WHERE `ID`='%d'", p);
                        mysql_tquery(handle_db, Query);
                        BorrarLabelCasa(p);
                        CargarPropiedad(p);
            printf("[Casas] Casa %d cargada desde MySQL, EnUso=%d.",p,PropInfo[p][pEnUso]);
                        GuardarPropiedad(p);
                        break;
                    }
                }
            }
        }
