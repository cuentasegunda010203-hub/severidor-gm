EstaEnVehiculog(vehicleid, playerid) {
    foreach(new i : Player) {
        if (IsPlayerInVehicle(i, vehicleid)) {
            SendClientMessage(playerid, -1, "{33CCFF}[Servicio de grua]{FFFFFF} Angelica: Encontramos una persona dentro del vehículo, no podemos remolcarlo.");
            SendClientMessage(playerid, -1, "{33CCFF}[Servicio de grua]{FFFFFF} Angelica: Llama a la policía si crees que tu vehículo ha sido robado.");
            callcmd::colgar(playerid);
            return 0;
        }
    }
    return 1;
}
SetVehiclePosEx(vehicleid, Float:x, Float:y, Float:z) {
    GLOBAL_VEHICLES[vehicleid][pt_INMUTE_VEH_TP] = gettime() + 4;
    GLOBAL_VEHICLES[vehicleid][gb_vehicle_SPAWN_X] = x;
    GLOBAL_VEHICLES[vehicleid][gb_vehicle_SPAWN_Y] = y;
    GLOBAL_VEHICLES[vehicleid][gb_vehicle_SPAWN_Z] = z;

    SetVehiclePos(vehicleid, x, y, z);
    return 1;
}
CMD:eventodm1(playerid) {
    if (AdminDuty[playerid] == 0) return SendClientMessage(playerid, -1, "No puedes usar este comando en fuera de servicio administrativo");
    if (EVENTO_DM == 0) {
        foreach(new i : Player) Notificador2(i, "Una sala de evento ~r~DM~w~ ha sido activada. usa /irEvento");
        EVENTO_DM = 1;
    } else {
        foreach(new i : Player) PLAYER_TEMP[i][pt_PLAYER_EVENTODM] = 0;
        EVENTO_DM = 0;
    }
    return 1;
}

CMD:salirevento(playerid) {
    //if(EVENTO_DM == 0) return SendClientMessage(playerid, -1, "El evento no esta activo.");
    if (PLAYER_TEMP[playerid][pt_PLAYER_EVENTODM] == 0) return SendClientMessage(playerid, -1, "No te encuentras en ninguna sala.");

    SetPosEx(playerid, PLAYER_TEMP[playerid][pt_EVENTO_POS][0], PLAYER_TEMP[playerid][pt_EVENTO_POS][1], PLAYER_TEMP[playerid][pt_EVENTO_POS][2], 0, PLAYER_TEMP[playerid][pt_EVENTO_INT], PLAYER_TEMP[playerid][pt_EVENTO_VW]);
    PLAYER_TEMP[playerid][pt_PLAYER_EVENTODM] = 0;

    SetPlayerHealthEx(playerid, 100);
    SetPlayerArmourEx(playerid, 0);
    QuitarArmas(playerid);
    return 1;
}
CMD:salirpb(playerid) {
    //if(EVENTO_DM == 0) return SendClientMessage(playerid, -1, "El evento no esta activo.");
    if (PLAYER_TEMP[playerid][pt_PLAYER_EVENTODM] == 0) return SendClientMessage(playerid, -1, "No te encuentras en ninguna sala.");

    SetPosEx(playerid, PLAYER_TEMP[playerid][pt_EVENTO_POS][0], PLAYER_TEMP[playerid][pt_EVENTO_POS][1], PLAYER_TEMP[playerid][pt_EVENTO_POS][2], 0, PLAYER_TEMP[playerid][pt_EVENTO_INT], PLAYER_TEMP[playerid][pt_EVENTO_VW]);
    PLAYER_TEMP[playerid][pt_PLAYER_EVENTODM] = 0;

    SetPlayerHealthEx(playerid, 100);
    SetPlayerArmourEx(playerid, 0);
    QuitarArmas(playerid);
    return 1;
}
CMD:irevento(playerid) {
    if (EVENTO_DM == 0) return SendClientMessage(playerid, -1, "El evento no esta activo.");
    if (PLAYER_INFO[playerid][pTiempoJail] != 0) return 1;
    if (PLAYER_INFO[playerid][Agonizando] != 0 && Esposando[playerid] != 0) return 1;
    if (PLAYER_INFO[playerid][pTiempoCarcel] != 0) return 1;

    if (PLAYER_TEMP[playerid][pt_PLAYER_EVENTODM] == 0) {
        if (PLAYER_INFO[playerid][pDuty] == 1) {
            SetPlayerColor(playerid, COLOR_WHITE);
            SetPlayerSkin(playerid, PLAYER_INFO[playerid][jRopa]);
            PLAYER_INFO[playerid][pDuty] = 0;
        }
        PLAYER_TEMP[playerid][pt_PLAYER_EVENTODM] = 1;
        PLAYER_TEMP[playerid][pt_EVENTO_INT] = GetPlayerInterior(playerid);
        PLAYER_TEMP[playerid][pt_EVENTO_VW] = GetPlayerVirtualWorld(playerid);
        GetPlayerPos(playerid, PLAYER_TEMP[playerid][pt_EVENTO_POS][0], PLAYER_TEMP[playerid][pt_EVENTO_POS][1], PLAYER_TEMP[playerid][pt_EVENTO_POS][2]);
    }
    SetPlayerHealthEx(playerid, 100);
    SetPlayerArmourEx(playerid, 100);
    QuitarArmas(playerid);

    defer EnviarEventoDM(playerid);
    return 1;
}
CMD:control(playerid, params[]) {
    new item[17], type;
    if (!sscanf(params, "s[17]d", item, type)) {
        if (strcmp(item, "policial", true) == 0) {
            if (PLAYER_INFO[playerid][pFaccion] != 1) return SendClientMessage(playerid, -1, "No eres policía.");
            if (PLAYER_INFO[playerid][pDuty] != 1) return SendClientMessage(playerid, -1, "No estas de servicio como policía.");
            if (AUTORIZED_POLICE_OBJECT_ID == 0) return SendClientMessage(playerid, -1, "No hay autorizacion para colocar controles policíales.");
            if (GetPlayerVirtualWorld(playerid) != 0 || GetPlayerInterior(playerid) != 0) return SendClientMessage(playerid, -1, "No puedes colocar objetos policiales aquí.");

            new modelid;
            switch (type) {
                case 1 : modelid = 1459;
                case 2 : modelid = 19425;
                case 3 : modelid = 1238;
                case 4 : modelid = 1425;
                case 5 : modelid = 4519;
                case 6 : modelid = 3265;
                case 7 : modelid = 3091;
                case 8 : modelid = 1237;
                case 9 : modelid = 1424;
                case 10 : modelid = 1423;
                default: return SendClientMessage(playerid, -1, "Utiliza {009AFF}/control [Tipo 1 - 10]");
            }
            new ID = GetFreePoliceObjectSlot();
            if (ID == -1) return SendClientMessage(playerid, -1, "No se pueden crear mas objetos policiales.");

            POLICE_OBJECTS[ID][police_object_VALID] = true;
            format(POLICE_OBJECTS[ID][police_object_USER], 24, "%s", PLAYER_INFO[playerid][Nickname]);

            new Float:pos[3], Float:angle;
            GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
            GetPlayerFacingAngle(playerid, angle);
            pos[0] += (1.5 * floatsin(-angle, degrees));
            pos[1] += (1.5 * floatcos(-angle, degrees));

            POLICE_OBJECTS[ID][police_object_OBJECT_ID] = CreateDynamicObject(modelid, pos[0], pos[1], pos[2], 0.0, 0.0, angle, 0, 0);
            Streamer_Update(playerid);

            new info[2];
            info[0] = 1;
            info[1] = ID;
            Streamer_SetArrayData(STREAMER_TYPE_OBJECT, POLICE_OBJECTS[ID][police_object_OBJECT_ID], E_STREAMER_EXTRA_ID, info);
            PLAYER_TEMP[playerid][pt_SELECTED_POLICE_OBJECT_ID] = ID;
            EditDynamicObject(playerid, POLICE_OBJECTS[ID][police_object_OBJECT_ID]);
            SendClientMessage(playerid, -1, "Coloca el objeto, posteriormente puedes usar {009AFF}/editar control{ffffff} para moverlo o eliminarlo.");
            return 1;
        } else SendClientMessage(playerid, -1, "Utiliza {009AFF}/control [Tipo 1 - 10]");
    } else {
        if (!IsPlayerInRangeOfPoint(playerid, 5.0, -1192.7413, 2064.7136, 1254.8612)) return SendClientMessage(playerid, -1, "Solo se puede controlar el escenario desde el panel de control.");

        new maquina1[50], maquina2[50], mensaje[100];
        if (Humo1Ojb == 0) maquina1 = "Encender maquinas de humo delanteras";
        else maquina1 = "Apagar maquinas de humo delanteras";
        if (Humo2Ojb == 0) maquina2 = "Encender maquinas de humo traseras";
        else maquina2 = "Apagar maquinas de humo traseras";
        format(mensaje, sizeof(mensaje), "%s\n%s", maquina1, maquina2);
        return dialogs_ShowPlayerDialog(playerid, CONTROLES, DIALOG_STYLE_LIST, "Panel de control", mensaje, "Accionar", "Cancelar");
    }
    return 1;
}

CMD:edit(playerid, params[]) {
    if (PLAYER_INFO[playerid][pFaccion] != 1) return SendClientMessage(playerid, -1, "No eres policía.");
    if (PLAYER_INFO[playerid][pDuty] != 1) return SendClientMessage(playerid, -1, "No estas de servicio como policía.");

    new item[17];
    if (sscanf(params, "s[17]", item)) return SendClientMessage(playerid, -1, "Utiliza {009AFF}/edit control.");
    else if (strcmp(item, "control", true) == 0) {
        if (AUTORIZED_POLICE_OBJECT_ID == 0) return SendClientMessage(playerid, -1, "No hay autorizacion para editar controles policíales.");
        if (GetPlayerVirtualWorld(playerid) != 0 || GetPlayerInterior(playerid) != 0) return SendClientMessage(playerid, -1, "No puedes editar objetos policiales aquí.");

        SendClientMessage(playerid, -1, "Para editar tienes que hacer click en el objeto policíal.");
        return SelectObject(playerid);
    }
    return 1;
}

CMD:autorizar(playerid, params[]) {
    if (PLAYER_INFO[playerid][pFaccion] != 1) return SendClientMessage(playerid, -1, "No eres policía.");
    if (PLAYER_INFO[playerid][pDuty] != 1) return SendClientMessage(playerid, -1, "No estas de servicio como policía.");
    if (PLAYER_INFO[playerid][pRango] <= 3) return SendClientMessage(playerid, -1, "Debes ser al menos rango Sargento para colocar objetos policiales.");

    new item[17];
    if (sscanf(params, "s[17]", item)) return SendClientMessage(playerid, -1, "Utiliza {009AFF}/autorizar control.");
    else if (strcmp(item, "control", true) == 0) {
        if (AUTORIZED_POLICE_OBJECT_ID == 0) AUTORIZED_POLICE_OBJECT_ID = 1;
        else AUTORIZED_POLICE_OBJECT_ID = 0;

        new string[200];
        format(string, 200, "{3399FF}[Central de policía]{FFFFFF} %s %s %s a colocar controles a todos los policias.", RangoBanda(PLAYER_INFO[playerid][pDuty], PLAYER_INFO[playerid][pRango]), PLAYER_INFO[playerid][Nickname], (AUTORIZED_POLICE_OBJECT_ID) ? ("autoriza") : ("qutio la autorizacion"));
        SendRadioPoliceMessage(-1, string);
        return 1;
    }
    return 1;
}

CMD:borrarcontrol(playerid, params[]) {
    new count;
    for(new i = 0; i != MAX_POLICE_OBJECTS; i++) {
        if (!POLICE_OBJECTS[i][police_object_VALID]) continue;

        DestroyDynamicObject(POLICE_OBJECTS[i][police_object_OBJECT_ID]);
        POLICE_OBJECTS[i][police_object_VALID] = false;
        POLICE_OBJECTS[i][police_object_USER][0] = EOS;
        POLICE_OBJECTS[i][police_object_OBJECT_ID] = INVALID_STREAMER_ID;
        count++;
    }
    SendClientMessageEx(playerid, -1, "Se han eliminado todos los objetos policiales, %d objetos afectados.", count);
    return 1;
}
SetPlayerHealthEx(playerid, Float:vida) {
    PLAYER_INFO[playerid][@Salud] = vida;
    if (PLAYER_INFO[playerid][@Salud] > 100.0) PLAYER_INFO[playerid][@Salud] = 100.0;
    return EstablecerVida(playerid, PLAYER_INFO[playerid][@Salud]);
}

SetPlayerArmourEx(playerid, Float:chaleco) {
    PLAYER_INFO[playerid][@Chaleco] = chaleco;
    if (PLAYER_INFO[playerid][@Chaleco] > 100) return 1;
    return EstablecerChaleco(playerid, PLAYER_INFO[playerid][@Chaleco]);
}
SendRadioPoliceMessage(color, const string[], id = INVALID_PLAYER_ID, frecuencia = 0) {
    foreach(new i : Player) {
        if (IsPlayerConnected(i)) {
            if (frecuencia > 0 && PLAYER_INFO[i][pFaccion] == 1) //a los que tengan frecuencia
            {
                if ((PLAYER_INFO[i][pDuty] == 1) && (Frecuencia[i] == frecuencia) && (EstadoRadio[i] == 1) && (i != id) && (PLAYER_INFO[i][pRadio] == 1)) {
                    SendClientMessage(i, color, string);
                }
            } else if (frecuencia == 0 && PLAYER_INFO[i][pFaccion] == 1) // para todos
            {
                if ((PLAYER_INFO[i][pDuty] == 1) && (EstadoRadio[i] == 1) && (i != id) && (PLAYER_INFO[i][pRadio] == 1)) {
                    SendClientMessage(i, color, string);
                }
            }
        }
    }
    return 1;
}
GetFreePoliceObjectSlot() {
    for(new i = 0; i != MAX_POLICE_OBJECTS; i++) {
        if (!POLICE_OBJECTS[i][police_object_VALID]) return i;
    }
    return -1;
}
public OnPlayerSelectDynamicObject(playerid, objectid, modelid, Float:x, Float:y, Float:z) {
    new infod[2];
    Streamer_GetArrayData(STREAMER_TYPE_OBJECT, objectid, E_STREAMER_EXTRA_ID, infod);
    if (infod[0] == PLAYER_INFO[playerid][pFaccion]) {
        if (PLAYER_INFO[playerid][pFaccion] != 2) {
            CancelEdit(playerid);
            return SendClientMessage(playerid, -1, "No eres militar.");
        }
        if (PLAYER_INFO[playerid][pDuty] != 1) {
            CancelEdit(playerid);
            return SendClientMessage(playerid, -1, "No estas de servicio como militar.");
        }
        if (AUTORIZED_POLICE_OBJECT_ID == 0) {
            CancelEdit(playerid);
            return SendClientMessage(playerid, -1, "No hay autorizacion para editar controles militares.");
        }
        new cadena[128];
        format(cadena, sizeof(cadena), "Este objeto fue colocado por %s. Usa 'ESC' para borrar el objeto.", POLICE_OBJECTS[infod[1]][police_object_USER]);
        SendClientMessage(playerid, -1, cadena);
        PLAYER_TEMP[playerid][pt_SELECTED_POLICE_OBJECT_ID] = infod[1];
        EditDynamicObject(playerid, objectid);
        return 1;
    }
    return 1;
}

CMD:lchat(playerid, params[]) {
    LimpiarChat(playerid, 100, -1);
    SendClientMessage(playerid, 0xAA3333FF, "{0085f8}Limpiaste tu chat.");
    return 1;
}

CMD:quitarbotiquin(playerid, params[]) {
    new id, cantidad;
    if (PLAYER_INFO[playerid][jAdminNvl] < ADMIN_LEVEL_ADM) return SendClientMessage(playerid, -1, "No tienes permisos para utilizar este comando.");
    if (sscanf(params, "dd", id, cantidad)) return SendClientMessage(playerid, -1, "Uso correcto /quitarbotiquin id cantidad"); {
        new string[128];
        format(string, sizeof(string), "Un Administrador te quito %d botiquines", cantidad);
        SendClientMessage(id, COLOR_BLANCO, string);
        PLAYER_INFO[id][pBotiquines] -= cantidad;
    }
    new string[200];
    format(string, sizeof(string), "Le quitaste una cantidad de {00cc00}%d{FFFFFF} Botiquines a %s.", cantidad, NombreJugador(id));
    ASendClientMessageEx(-1, string);
    return 1;
}
CMD:darbotiquin(playerid, params[]) {
    new id, cantidad, string[128];
    if (AdminDuty[playerid] == 0) return SendClientMessage(playerid, -1, "No puedes usar este comando en fuera de servicio administrativo");
    if (PLAYER_INFO[playerid][pAdmin] < 6) return 0;
    if (!sscanf(params, "ud", id, cantidad)) {
        format(string, 128, "%s le has dado una cantidad de %d Botiquines a %s", NombreJugador(playerid), cantidad, NombreJugador(id));
        SendClientMessage(playerid, -1, string);
        format(string, 128, "{FFFFFF}Has recibido {00FF00}%d Botiquines{FFFFFF} por parte de la administracion.", cantidad);
        SendClientMessage(id, -1, string);
        PLAYER_INFO[id][pBotiquines] += cantidad;
        format(string, sizeof(string), "{0085f8}[Administracion]: {FFFFFF} comando /darbotiquin usado por %s ", PLAYER_INFO[playerid][Nickname]);
        MensajeAdmin(-1, string, 3);
    }
    return 1;
}

CMD:curar(playerid, params[]) {
    new id, string[100], Float:Pos[3];
    if (PLAYER_INFO[playerid][pBotiquines] <= 0) return SendClientMessage(playerid, -1, "No tienes un botiquin para curar."), PLAYER_INFO[playerid][pBotiquines] = 0;
    if (!sscanf(params, "d", id)) {
        if (id == playerid) return SendClientMessage(playerid, 0x25AB26FF, "No puedes usar el comando contigo mismo.");
        GetPlayerPos(id, Pos[0], Pos[1], Pos[2]);
        if (!IsPlayerInRangeOfPoint(playerid, 2.0, Pos[0], Pos[1], Pos[2])) return SendClientMessage(playerid, -1, "No estas cerca de este jugador");
        if (PLAYER_INFO[id][Agonizando] == 1) {
            LoopingAnim(playerid, "MEDIC", "CPR", 4.0, 1, 1, 1, 1, 12000);
            GameTextForPlayerEx(playerid, "~n~~n~~n~~r~Reviviendo...", 12000, 5);
            SetTimerEx("SacarAnimF", 12000, false, "d", playerid);
            SetTimerEx("ReanimarBotiquin", 12000, false, "dd", playerid, id);
            PLAYER_INFO[playerid][pBotiquines] -= 1;
            format(string, sizeof(string), "Usaste un botiquin para curar a esta persona.");
            SendClientMessage(playerid, -1, string);
        } else return SendClientMessage(playerid, -1, "Este jugador no se esta muriendo");
    } else return SendClientMessage(playerid, -1, "Usa: {FFFFFF}/curar {0085f8}[ID]");
    return 1;
}
CMD:exp(playerid, params[])
{
    new cantidad;
    if (AdminDuty[playerid] == 0) return SendClientMessage(playerid, -1, "No puedes usar este comando en fuera de servicio administrativo");
    if (PLAYER_INFO[playerid][pAdmin] < 6) return 0;
    if (!sscanf(params, "d", cantidad)) 
    {
        ExpPD = cantidad;
        for(new i, j = GetPlayerPoolSize(); i <= j; i++) {
            if (PlayerConectado(i) && !IsPlayerNPC(i)) 
            {
                SendFormatNotification(i, "~g~Se activó la EXP x%d", ExpPD);             
            }   
        }
        new hostname[128];
        format(hostname,sizeof(hostname), "hostname %s", RP_SERVER_HOSTNAME);
        SendRconCommand(hostname);
    }
    return 1;
}
CMD:drogastodos(playerid, params[]) {
    new cantidad, string[128];
    if (AdminDuty[playerid] == 0) return SendClientMessage(playerid, -1, "No puedes usar este comando en fuera de servicio administrativo");
    if (PLAYER_INFO[playerid][pAdmin] < 6) return 0;
    if (!sscanf(params, "d", cantidad)) {
        for(new i, j = GetPlayerPoolSize(); i <= j; i++) {
            if (PlayerConectado(i) && !IsPlayerNPC(i)) {
                SendClientMessageEx(i, COLOR_CHEAT, "%s te dio %dg de Krippy y LSD.", PLAYER_INFO[playerid][Nickname], cantidad);
                PLAYER_INFO[i][pLSD] += cantidad;
                PLAYER_INFO[i][pKrippy] += cantidad;
            }
        }
        format(string, sizeof(string), "{0085f8}[Administracion]: {FFFFFF}%s dio %dg de Krippy y LSD a todos los jugadores. ", PLAYER_INFO[playerid][Nickname], cantidad);
        MensajeAdmin(-1, string, 3);
    }
    return 1;
}
CMD:darbotiquintodos(playerid, params[]) {
    new cantidad, string[128];
    if (AdminDuty[playerid] == 0) return SendClientMessage(playerid, -1, "No puedes usar este comando en fuera de servicio administrativo");
    if (PLAYER_INFO[playerid][pAdmin] < 6) return 0;
    if (!sscanf(params, "d", cantidad)) {
        for(new i, j = GetPlayerPoolSize(); i <= j; i++) {
            if (PlayerConectado(i) && !IsPlayerNPC(i)) {
                format(string, 128, "{FFFFFF}Has recibido {00CC00}%d botiquines{FFFFFF} de parte de la administracion, ofelicidades!", cantidad);
                dialogs_ShowPlayerDialog(i, DRECARGA, DIALOG_STYLE_MSGBOX, "Informacion", string, "Aceptar", "");
                PLAYER_INFO[i][pBotiquines] += cantidad;
            }
        }
        format(string, sizeof(string), "{0085f8}[Administracion]: {FFFFFF} comando /darbotiquintodos usado por %s ", PLAYER_INFO[playerid][Nickname]);
        MensajeAdmin(-1, string, 3);
    }
    return 1;
}
public ReanimarBotiquin(playerid, ID) {
    new string[100];
    PLAYER_INFO[ID][Agonizando] = 0, Muriendo[ID] = 0, Esposando[ID] = 0, TogglePlayerControllable(ID, 1);
    SetPVarInt(ID, "IsFrozen", 1), EstablecerVida(ID, 50.0), ClearAnimations(ID);
    ColorJugadorDefault(ID);
    LlamadaMedicos[ID] = 0;
    TextDrawHideForPlayer(ID, Sangre);
    TextDrawHideForPlayer(ID, NewPlayer[2]);
    TextDrawHideForPlayer(ID, NewPlayer[0]);
    Descongelar(ID);
    suicidio[ID] = 0;
    TimerMalherido[ID] = 0;
    DescongelarCBUG(ID);
    ApplyAnimation(ID, "CARRY", "crry_prtial", 1.0, 0, 0, 0, 0, 0);
    format(string, sizeof(string), "%s usa un botiquin para curar a %s", PLAYER_INFO[playerid][Nickname], PLAYER_INFO[ID][Nickname]);
    ProxDetector(20.0, playerid, string, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO);
}

funcion ColocarAutoGrua(playerid, autoid) {
    VEHICLE_GRUA[playerid] = autoid;
    new Float:POS_YO[4];
    GetPlayerPos(playerid, POS_YO[0], POS_YO[1], POS_YO[2]);
    POSICION_GRUA(VEHICLE_GRUA[playerid], POS_YO[0] + 1, POS_YO[1] + 2, POS_YO[2] + 1, 90);
    SetVehicleInterior(VEHICLE_GRUA[playerid], GetPlayerInterior(playerid));
    SetVehicleVirtualWorld(VEHICLE_GRUA[playerid], GetPlayerVirtualWorld(playerid));
    ShowPlayerMessage(playerid, "Grua: ~g~Su vehículo fue trasladado exitosamente.");
    return 1;
}
forward DisputaZonaHide();
public DisputaZonaHide() {
    TextDrawHideForAll(ConquistandoMercaoide);
    //KillTimer(HideTextGra);
    return 1;
}
stock BandaGanadorhha(playerid) {
    new CrewColorGraffitiWin = getPlayerCrewColor(playerid);
    KillTimer(HideTextGra);
    format(CrewNameGrafo, sizeof(CrewNameGrafo), "%s", getPlayerCrew(playerid));
    TextDrawSetString(BandaGanadoraGrafo[4], CrewNameGrafo);
    TextDrawColor(BandaGanadoraGrafo[4], CrewColorGraffitiWin);
    HideTextGra = SetTimer("DisputaZonaHide", 15000, 0);
    KillTimer(DiezParagrafo);
    for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++) {
        if (IsPlayerConnected(i)) {
            if (PLAYER_CREW[i][player_crew_VALID]) {

                TextDrawHideForPlayer(i, ConquistandoMercaoide);
            }
        }
    }

    return 1;
}
stock BandaGanadoraM(playerid) {
    new CrewColorGraffitiWin = getPlayerCrewColor(playerid);
    KillTimer(HideTextGra);
    format(CrewNameGrafo, sizeof(CrewNameGrafo), "%s", getPlayerCrew(playerid));
    TextDrawSetString(BandaGanadoraGrafo[4], CrewNameGrafo);
    TextDrawColor(BandaGanadoraGrafo[4], CrewColorGraffitiWin);
    HideTextGra = SetTimer("DisputaZonaHide", 15000, 0);
    GraffitiGanadorM(PLAYER_INFO[playerid][pFaccion]);
    for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++) {
        if (IsPlayerConnected(i)) {
            if (PLAYER_INFO[i][pFaccion] > 0) {
                TextDrawHideForPlayer(I, ConquistandoMercaoide);
            }
        }
    }

    return 1;
}
stock RP_InventarioArmaDialog(playerid, slot) {
    if (JugadorLogeado[playerid] != 1 || slot < 1 || slot > 6) return 0;
    new arma, municion;
    GetPlayerWeaponData(playerid, slot, arma, municion);
    if (arma == 0 || !HasWeapon(playerid, arma)) return SendClientMessage(playerid, -1, "Esta casilla no contiene un arma.");
    new dialogos[] = {DIALOG_ARMAS_1, DIALOG_ARMAS_2, DIALOG_ARMAS_3, DIALOG_ARMAS_4, DIALOG_ARMAS_5, DIALOG_ARMAS_6};
    new texto[160];
    format(texto, sizeof(texto), "Equipar %s\nTirar %s", GetWeaponNameEx(arma), GetWeaponNameEx(arma));
    dialogs_ShowPlayerDialog(playerid, dialogos[slot - 1], DIALOG_STYLE_LIST, "Arma del inventario", texto, "Aceptar", "Cerrar");
    return 1;
}
stock RP_UsarArmaInventario(playerid, slot, opcion) {
    if (JugadorLogeado[playerid] != 1 || slot < 1 || slot > 6 || opcion < 0 || opcion > 1) return 0;
    if (GetPlayerState(playerid) == PLAYER_STATE_WASTED || GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return 0;
    new arma, municion;
    GetPlayerWeaponData(playerid, slot, arma, municion);
    if (arma == 0 || !HasWeapon(playerid, arma)) return SendClientMessage(playerid, -1, "Ya no tienes el arma de esta casilla.");
    SetPlayerArmedWeapon(playerid, arma);
    if (opcion == 1) return TirarArma(playerid);
    return SendClientMessageEx(playerid, -1, "Equipaste %s.", GetWeaponNameEx(arma));
}
CMD:inv(playerid, params[]) {
    if (JugadorLogeado[playerid] != 1) return SendClientMessage(playerid, -1, "Primero inicia sesion en tu cuenta.");
    if (SelecTextDraw[playerid] == TD_INVENTARIO) return 1;
    Menu_AbrirInventario(playerid);
    return 1;
}

CMD:tiendadp(playerid, params[]) {
    if (JugadorLogeado[playerid] != 1) return SendClientMessage(playerid, -1, "Primero inicia sesion en tu cuenta.");
    if (!IsPlayerInRangeOfPoint(playerid, 5.0, 1170.5438, -1700.4456, 22.3204) || GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0)
        return SendClientMessage(playerid, -1, "Acercate a la tienda exclusiva para comprar. Puedes localizarla en /gps.");
    return ComprarEnTienda(playerid);
}

