                }
                if (PropInfo[c][pPaloDeGolf] > 0) {
                    format(ropero2, sizeof(ropero2), " {FFFFFF}Palo-de-Golf {00CC00}x%d {00CCFF}||", PropInfo[c][pPaloDeGolf]);
                    strcat(ropero3, ropero2);
