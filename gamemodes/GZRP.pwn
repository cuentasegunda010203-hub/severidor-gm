                        format(string, 128, "{00E1FF}%s{FFFFFF} ha salido de la banda.", PLAYER_INFO[playerid][Nickname]);
                        BandasInfo[PLAYER_INFO[playerid][pFaccion] - 1][BIntegrantes]--;
                        mysql_format(handle_db, query, sizeof(query), "UPDATE `facciones` SET `Integrantes`='%d' WHERE `id`='%d'", BandasInfo[PLAYER_INFO[playerid][pFaccion]][BIntegrantes], PLAYER_INFO[playerid][pFaccion]);
                        mysql_tquery(handle_db, query);
