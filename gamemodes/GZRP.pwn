CMD:pararrappel(playerid, params[]) {
    if (rappelactivo[playerid] == 1) {
        if (GetPVarInt(playerid, "rappelling") == 0) return SendClientMessage(playerid, COLOR_WHITE, "No estas bajando con rappel!!");
        for(new i = 0; i < 58; i++) {
            EstablecerVida(playerid, vidayarmadura[playerid][0]);
            EstablecerChaleco(playerid, vidayarmadura[playerid][1]);
            SetPVarInt(playerid, "rappelling", 0);
            DestroyDynamicObject(rapel[i]);
            ClearAnimations(playerid);
            Revivir(playerid);
        }
    }
    return 1;
}
CMD:sethptodos(playerid, params[]) {
    new vida, string[128];
    if (PLAYER_INFO[playerid][jAdminNvl] < ADMIN_LEVEL_GLOBAL) return 0;
    if (!sscanf(params, "d", vida)) {
        foreach(new i : Player) {
            if (IsPlayerConnected(i) && !IsPlayerNPC(i)) {
                EstablecerVida(i, vida);
                format(string, 128, "Un Administrador Te dio %d de vida.", NombreJugador(playerid), playerid, vida);
                SendClientMessage(i, COLOR_BLANCO, string);
            }
        }
        new cadena[50];
        format(cadena, sizeof(cadena), "Le diste %d de vida a todos los jugadores.", vida);
        SendClientMessage(playerid, -1, cadena);

    }
    return 1;
}

CMD:setartodos(playerid, params[]) {
    new chaleco, string[128];
    if (PLAYER_INFO[playerid][jAdminNvl] < ADMIN_LEVEL_GLOBAL) return 0;
    if (!sscanf(params, "d", chaleco)) {
        foreach(new i : Player) {
            if (IsPlayerConnected(i) && !IsPlayerNPC(i)) {
                EstablecerChaleco(i, chaleco);
                format(string, 128, "Un administrador te dio %d de chaleco.", NombreJugador(playerid), playerid, chaleco);
                SendClientMessage(i, COLOR_BLANCO, string);
            }
        }
        new cadena[50];
        format(cadena, sizeof(cadena), "Le diste %d de chaleco a todos los jugadores.", chaleco);
        SendClientMessage(playerid, -1, cadena);
    }
    return 1;
}
CMD:jetpack(playerid, params[]) {
    if (PLAYER_INFO[playerid][jAdminNvl] < ADMIN_LEVEL_GLOBAL) return 0;
    if (IsPlayerConnected(playerid)) {
        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USEJETPACK);
    }
    return 1;
}
CMD:top(playerid) {
    if (JugadorLogeado[playerid] != 1) return 1;
    dialogs_ShowPlayerDialog(playerid, D_TOPS, DIALOG_STYLE_LIST, ""SERVER_NAME " - Top's", "{FFFFFF}Top Kill's {fd6f33}[Los asesinos mas peligrosos]\n{FFFFFF}Top Bandas {fd6f33}[Las pandillas mas peligrosas]\n{FFFFFF}Top Monopolio's {fd6f33}[Los que tienen mas dolares]\n{FFFFFF}Top Inversionistas {fd6f33}[Los que tienen mas criptomonedas]\n{FFFFFF}Top caídos {fd6f33}[Los mas EZ de "SERVER_NAME2 "]\n{FFFFFF}Top Police {fd6f33}[Los mas delincuentes]", "Seleccionar", "Cancelar");
    return 1;
}
CMD:traertodos(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_GLOBAL) return 0;
    new Float:pos[3], string[128];
    GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
    foreach(new id : Player) {
        if (IsPlayerConnected(id) && !IsPlayerNPC(id)) {
            if (Entrando[id] == 0) {
                Entrando[id] = 1;
                SetTimerEx("Entrandos", 3000, false, "d", playerid);
            }
            format(string, 128, "Un administrador te trajo a su pocision.", NombreJugador(playerid), playerid);
            NoTeleportHack(id);
            SendClientMessage(id, COLOR_BLANCO, string);
            SetPlayerPos(id, pos[0], pos[1], pos[2]);
            SetPlayerInterior(id, GetPlayerInterior(playerid));
            SetPlayerVirtualWorld(id, GetPlayerVirtualWorld(playerid));
        }
    }
    SendClientMessage(playerid, -1, "Has traido a todos a tu posicion.");
    return 1;
}
CMD:congelartodos(playerid, params[]) {
    if (PLAYER_INFO[playerid][jAdminNvl] < ADMIN_LEVEL_GLOBAL) return 0;
    foreach(new i : Player) {
        if (IsPlayerConnected(i) && !IsPlayerNPC(i)) {
            new string[128];
            Congelar(i);
            format(string, 128, "Un administrador te congelo.", NombreJugador(playerid), playerid);
            SendClientMessage(i, COLOR_BLANCO, string);
        }
    }
    SendClientMessage(playerid, -1, "Congelaste a todos los jugadores.");
    return 1;
}
CMD:dardinerobanco(playerid, params[]) {
    new id, dinero, string[128];
    if (PLAYER_INFO[playerid][jAdminNvl] < 7) return 0;
    if (!sscanf(params, "dd", id, dinero)) {
        PLAYER_INFO[id][pBanco] += dinero;
        new cadena[50];
        format(string, 128, "Un administrador te dio $%d en tu cuenta bancaria.", dinero);
        SendClientMessage(id, COLOR_BLANCO, string);
        ActualizarBanco(id);
        format(cadena, sizeof(cadena), "Diste %d$ a %s", dinero, NombreJugador(id));
        SendClientMessage(playerid, -1, cadena);
    }
    return 1;
}

CMD:descongelartodos(playerid, params[]) {
    if (PLAYER_INFO[playerid][jAdminNvl] < ADMIN_LEVEL_GLOBAL) return 0;
    foreach(new i : Player) {
        if (IsPlayerConnected(i) && !IsPlayerNPC(i)) {
            Descongelar(i);
            new string[128];
            format(string, 128, "Un administrador te descongelo.", NombreJugador(playerid), playerid);
            SendClientMessage(i, COLOR_BLANCO, string);
        }
    }
    SendClientMessage(playerid, -1, "Descongelaste a todos los jugadores.");
    return 1;
}

CMD:disarmtodos(playerid, params[]) {
    if (PLAYER_INFO[playerid][jAdminNvl] < ADMIN_LEVEL_GLOBAL) return 0;
    foreach(new i : Player) {
        if (IsPlayerConnected(i) && !IsPlayerNPC(i)) {
            QuitarArmas2(i);
            new string[128];
            format(string, 128, "Un administrador te desarmo.", NombreJugador(playerid), playerid);
            SendClientMessage(i, COLOR_BLANCO, string);
        }
    }
    SendClientMessage(playerid, -1, "Desarmaste a todos los jugadores.");
    return 1;
}

CMD:revivetodos(playerid, params[]) {
    if (PLAYER_INFO[playerid][jAdminNvl] < ADMIN_LEVEL_GLOBAL) return 0;
    foreach(new i : Player) {
        if (IsPlayerConnected(i) && !IsPlayerNPC(i)) {
            if (IsPlayerNPC(i)) return 1;
            new string[128];
            format(string, 128, "%s(ID:%d) Te revivio.", NombreJugador(playerid), playerid);
            SendClientMessage(i, COLOR_BLANCO, string);
            Revivir(i);
        }
    }
    SendClientMessage(playerid, -1, "Reviviste a todos los jugadores.");
    return 1;
}


CMD:explotar(playerid, params[]) {
    new item[32];
    if (strcmp(item, "puerta", true) == 0) // :)
    {
        if (IsPlayerInRangeOfPoint(playerid, 3, 998.5244, -1170.1731, 12.7304)) {
            if (explotopuertabanco == 1) return SendClientMessage(playerid, COLOR_WHITE, "La puerta del banco ya fue explotada.");
            if (Banco_Activo != 0) return SendClientMessage(playerid, COLOR_WHITE, "No puedes explotar la puerta, por que el banco ya fue robado recientemente.");
            if (cbomba[playerid] != 1) return SendClientMessage(playerid, COLOR_WHITE, "Necesitas una bomba tipo {FC0000}C4{FFFFFF} para poder explotar la puerta.");
            new Float:x1, Float:y1, Float:z1;
            GetPlayerPos(playerid, x1, y1, z1);
            ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 1, 1, 0, 0);
            ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 1, 1, 0, 0);

            if(!C4_Change(playerid,false)) return 1;
            BOMBA[playerid] = CreateObject(1252, x1, y1 - 0.5, z1 - 0.5, 0, 0, 0, 0);
            SendClientMessage(playerid, COLOR_WHITE, "{FF0000}["SERVER_COIN2 ":RP] {FFFFFF}La bomba fue plantada, ¡apartate va a explotar!");
            SetTimerEx("TimerBANCO2", 70000, 0, "d", playerid);
            Audiobomba(x1, y1, z1);
            SetTimerEx("explotarpuerta", 10000, false, "d", playerid);
            explotopuertabanco = 1;
        }
    }
    return 1;
}
RobandoBanco(playerid) {
    if (IsPlayerInRangeOfPoint(playerid, 2.0, 1014.0793, -1170.7107, 12.6183)) {
        if (PLAYER_INFO[playerid][pMascara] == 0) Notificador2(playerid, "Khezzy: ¡Hola! Necesitas una mascara para realizar esto, consiguela en el mercado negro: /mercado gps");
        if (Banco_Activo != 1) {
            if (robobanco[playerid] == 0) {
                if (PLAYER_INFO[playerid][pMascaraPuesta] == 0) PUSH(playerid, "Colocate la mascara para robar.");
                if (explotopuertabanco == 0) return SendClientMessage(playerid, COLOR_WHITE, "La puerta esta cerrada no tienes como escapar.");
                new string[256];
                SetTimer("TimerBANCO", 2700000, 0);
                canceltimer[playerid] = SetTimerEx("robandobancoc", 20000, false, "d", playerid);
                ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 0, 0, 1, 90000, 1);
                ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 0, 0, 1, 90000, 1);
                format(string, sizeof(string), "* %s saca un bolso vacio y seguidamente empieza a llenar de dinero dicho bolso...", PLAYER_INFO[playerid][Nickname]);
                ProxDetector(15.0, playerid, string, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES);
                robobanco[playerid] = 1;
            } else SendClientMessage(playerid, -1, "{FFFFFF}Ya robaste el banco.");
        } else SendClientMessage(playerid, -1, "{FFFFFF}El banco ha sido robado recientemente, no quedaron bolsas.");
    } else SendClientMessage(playerid, -1, "{FFFFFF}No estas en el banco.");
    return 1;
}
#include "modulos/robo_cajafuerte.p"
AtracarCajaFuerte(playerid) {
    return RP_SafeStart(playerid);
}

CMD:atracar(playerid, params[]) {
    new item[32];
    if (!sscanf(params, "s[32]", item) && !strcmp(item, "cajafuerte", true)) return AtracarCajaFuerte(playerid);
    if (IsAPolice(playerid)) return SendClientMessage(playerid, COLOR_WHITE, "Los policias no pueden hacer esto.");
    if (PLAYER_INFO[playerid][pCargos] > 0) return SendClientMessage(playerid, -1, "No puedes hacer esto si la policia te esta siguiendo.");
    if ((PLAYER_INFO[playerid][@Nivel] < 7 && PLAYER_INFO[playerid][pVip] < 1)) return SendClientMessage(playerid, -1, "Solamente jugadores VIP2 y de nivel 7 en adelante pueden robar casas.");
    if (PLAYER_INFO[playerid][pMascara] == 0) Notificador2(playerid, "Khezzy: ¡Hola! Necesitas una mascara para realizar esto, consiguela en el mercado negro: /mercado gps");
    if (!sscanf(params, "s[32]", item)) {
        if (strcmp(item, "banco", true) == 0) // :)
        {
            if (IsPlayerInRangeOfPoint(playerid, 2.0, 1014.0793, -1170.7107, 12.6183)) {
                if (Banco_Activo != 1) {
                    if (robobanco[playerid] == 0) {
                        if (explotopuertabanco == 0) return SendClientMessage(playerid, COLOR_WHITE, "La puerta esta cerrada no tienes como escapar.");
                        new string[256];
                        SetTimer("TimerBANCO", 2700000, 0);
                        canceltimer[playerid] = SetTimerEx("robandobancoc", 20000, false, "d", playerid);
                        ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 0, 0, 1, 90000, 1);
                        ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 0, 0, 1, 90000, 1);
                        format(string, sizeof(string), "* %s saca un bolso vacio y seguidamente empieza a llenar de dinero dicho bolso...", PLAYER_INFO[playerid][Nickname]);
                        ProxDetector(15.0, playerid, string, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES);
                        robobanco[playerid] = 1;
                    } else SendClientMessage(playerid, -1, "{FFFFFF}Ya robaste el banco.");
                } else SendClientMessage(playerid, -1, "{FFFFFF}El banco ha sido robado recientemente, no quedaron bolsas.");
            } else SendClientMessage(playerid, -1, "{FFFFFF}No estas en el banco.");
        }
        if (strcmp(item, "cajafuerte", true) == 0) return AtracarCajaFuerte(playerid);
    }
    return 1;
}
CMD:robar(playerid, params[]) {
    if(!strcmp(params,"bolsas",true) || !strcmp(params,"bolsa",true)) return RB_TakeBag(playerid);
    new item[20];
    SetPVarInt(playerid, "antiflood", GetTickCount());
    if (IsAPolice(playerid)) return SendClientMessage(playerid, COLOR_WHITE, "Los policias no pueden hacer esto.");
    if (!sscanf(params, "s[20]", item)) {
        if (strcmp(item, "cajero", true) == 0) return ATM_Request(playerid);
        if (strcmp(item, "cajafuerte", true) == 0) return RobarCaja(playerid);
        if (strcmp(item, "tienda", true) == 0) {
            if (GetPlayerWeapon(playerid) == 0) return ShowPlayerMessage(playerid, "~r~Necesitas un arma, para robar.");
            switch (GetPlayerWeapon(playerid)) {
                case 22..33: {
                    if (PLAYER_INFO[playerid][pMascara] == 0) return Notificador2(playerid, "Isabela: ¡Hola! Necesitas una mascara para realizar esto, consiguela en el mercado negro: /mercado gps");
                    RobarTiendaAndroid(playerid);
                }
                default: SendClientMessage(playerid, COLOR_GAMEMODE, "Necesitas un arma de fuego para poder robar.");
            }
        }
    }
    return 1;
}
CMD:musicaadmin(playerid, Params[]) {
    if (PLAYER_INFO[playerid][pAdmin] > ADMIN_LEVEL_SANCIONES) {
        dialogs_ShowPlayerDialog(playerid, NMusica, DIALOG_STYLE_INPUT, "Dialogo de musica administrativa", "Ingresa el link .mp3 para reproducir", "Reproducir", "Cancelar");
    }
    return 1;
}
CMD:prendas(playerid) {
    if (RopaMine[playerid] == 1) {
        RemovePlayerAttachedObject(playerid, 1);
        RemovePlayerAttachedObject(playerid, 2);
        RemovePlayerAttachedObject(playerid, 3);
        SendClientMessage(playerid, -1, "Se te quitaron las prendas de minero");
    }
    SetPVarInt(playerid, "antiflood", GetTickCount());
    if (CountPlayerToys(playerid) == 0) return SendClientMessage(playerid, -1, "Tienes que tener al menos un accesorio para poder usar este comando.");
    ShowDialog(playerid, DIALOG_TOYS);
    return 1;
}
CMD:tablero(playerid, params[]) {
    if (!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_GREY, "* Debes estar en un vehiculo.");
    dialogs_ShowPlayerDialog(playerid, TNEON, DIALOG_STYLE_LIST, "Tablero", "Motor\nLuces\nPrender neon\nApagar neon\nVentanas", "Continuar", "");
    return 1;
}


CMD:ex1(playerid, params[]) {
    if (PLAYER_INFO[playerid][jAdminNvl] < ADMIN_LEVEL_GLOBAL) return 0;
    if (!sscanf(params, "d", params[0])) {
        if (IsPlayerConnected(params[0])) {
            if (PLAYER_INFO[params[0]][pAdmin] == ADMIN_LEVEL_ADM) return SendClientMessage(playerid, COLOR_WHITE, "Error: este comando no funciona con fundadores.");
            new Float:p_x, Float:p_y, Float:p_z;
            GetPlayerPos(params[0], p_x, p_y, p_z);
            CreateExplosion(p_x, p_y, p_z, 0, 10.0);
            return SendClientMessage(playerid, COLOR_WHITE, "Explotado!");
        } else SendClientMessage(playerid, COLOR_WHITE, "Esa id es invalida.");
    } else SendClientMessage(playerid, COLOR_WHITE, "Usa {F4FA58}/ex [id]");
    return 1;
}
CMD:invitaciones(playerid) {
    if (PLAYER_INFO[playerid][pFaccion] != 0) return SendClientMessage(playerid, -1, "No puedes ver tus invitaciones si eres miembro de una organizacion.");

    new Query[150];
    mysql_format(handle_db, Query, sizeof(Query), "SELECT * FROM `invitaciones` WHERE `Invitado`='%s'", PLAYER_INFO[playerid][Nickname]);
    mysql_query(handle_db, Query, true);

    new dialog[115 * 15 + 1], line_str[115], count = -1;
    dialog = "ID\tLider\tNombre\n";

    for(new i = 0; i < cache_num_rows(); i++) {
        if (count == 14) break;

        new content[20], BANDA_ID, ID;
        cache_get_value_name(i, "BandaID", content);
        BANDA_ID = strval(content);
        cache_get_value_name(i, "ID", content);
        ID = strval(content);

        PLAYER_TEMP[playerid][p_INVITACIONES][i] = BANDA_ID;
        PLAYER_TEMP[playerid][p_INVITACIONES_ID][i] = ID;
        format(line_str, sizeof line_str, "%d.\t%s\t%s\n", i + 1, BandasInfo[BANDA_ID][BLider], BandasInfo[BANDA_ID][BNombre]);
        strcat(dialog, line_str);
        count = i;
    }
    if (count == -1) return SendClientMessage(playerid, -1, "No tienes invitaciones pendientes.");
    else {
        strcat(dialog, "{c4290d}Eliminar todo\n");
        PLAYER_TEMP[playerid][p_INVITACIONES][count + 1] = -1;
    }
    dialogs_ShowPlayerDialog(playerid, MENU_INVITACIONES, DIALOG_STYLE_TABLIST_HEADERS, "Menu Invitaciones", dialog, "Seleccionar", "Salir");
    return 1;
}

function InvitarBanda(playerid, ID) {
    new banda = PLAYER_INFO[playerid][pFaccion];
    new integrantes = cache_num_rows();
    if (integrantes >= BandasInfo[banda][MaxIntegrantes]) {
        SendClientMessageEx(playerid, -1, "{"    COLOR_GM "}Tu banda sólo puede tener un máximo de {ffffff}%d {"    COLOR_GM "}integrantes y actualmente tienes {ffffff}%d {"    COLOR_GM "}integrantes.", BandasInfo[banda][MaxIntegrantes], integrantes);
    } else {
        mysql_format(handle_db, QUERY_BUFFER, sizeof(QUERY_BUFFER), "INSERT INTO `invitaciones`(`Invitador`, `Invitado`, `BandaID`) VALUES ('%s', '%s', '%d');", PLAYER_INFO[playerid][Nickname], PLAYER_INFO[ID][Nickname], PLAYER_INFO[playerid][pFaccion]);
        mysql_tquery(handle_db, QUERY_BUFFER);
        SendClientMessageEx(playerid, -1, "Invitaste a {33CCFF}%s {FFFFFF}a la banda, espera a que acepte.", PLAYER_INFO[ID][Nickname]);
        SendClientMessageEx(ID, -1, "Te han ofrecido unirte a {33CCFF}%s{FFFFFF}, Para unirte utilza {009AFF}/invitaciones", BandasInfo[banda][BNombre]);
    }
}
CMD:invitar(playerid, params[]) {
    if (PLAYER_INFO[playerid][pFaccion] == 0) return SendClientMessage(playerid, -1, "No eres miembro de ninguna banda.");
    if (PuedeInvitar(playerid)) return SendClientMessage(playerid, -1, "No tienes permiso para invitar personas a la banda.");

    new ID;
    if (sscanf(params, "u", ID)) return SendClientMessage(playerid, -1, "Escribe {009AFF}/invitar {FFFFFF}<PlayerID>");
    if (!IsPlayerConnected(ID)) return SendClientMessage(playerid, -1, "El jugador esta desconectado.");
    if (ID == playerid) return SendClientMessage(playerid, -1, "No te puedes hacer esto.");

    new Float:pos[3];
    GetPlayerPos(ID, pos[0], pos[1], pos[2]);
    if (!IsPlayerInRangeOfPoint(playerid, 4.0, pos[0], pos[1], pos[2])) return SendClientMessage(playerid, -1, "Este jugador no esta cerca tuyo.");
    if (PLAYER_INFO[ID][pFaccion] > 0) return SendClientMessage(playerid, -1, "Este jugador ya se encuentra en una Banda.");

    new banda = PLAYER_INFO[playerid][pFaccion];

    new Query[250];
    mysql_format(handle_db, Query, sizeof(Query), "SELECT * FROM `invitaciones` WHERE `Invitado`='%s' AND `BandaID`='%d'", PLAYER_INFO[ID][Nickname], banda);
    new Cache:result = mysql_query(handle_db, Query, true);

    if (cache_num_rows()) {
        return SendClientMessage(playerid, -1, "El usuario ya ha sido invitado para esta organizacion."), cache_delete(result);
    } else {
        cache_delete(result);
        mysql_format(handle_db, QUERY_BUFFER, sizeof(QUERY_BUFFER), "SELECT * FROM `usuarios` WHERE `Faccion`='%d' AND `Baneado`='0'", banda);
        mysql_tquery(handle_db, QUERY_BUFFER, "InvitarBanda", "ii", playerid, ID);
    }
    return 1;
}
CMD:ascender(playerid, params[]) {
    new pName[32], pSub[32];
    GetPlayerName(playerid, pName, 32);
    SetPVarInt(playerid, "antiflood", GetTickCount());
    if (PLAYER_INFO[playerid][pFaccion] > 0) {
        new id, rango;
        if (PLAYER_INFO[playerid][pRango] < 7) return 1;
        if (sscanf(params, "dd", id, rango)) return SendClientMessage(playerid, -1, "Modo de uso /ascender id [RANGO (1-8)]");
        if (PLAYER_INFO[id][pFaccion] != PLAYER_INFO[playerid][pFaccion]) return SendClientMessage(playerid, -1, "Este jugador no es miembro de tu faccion");
        if (PLAYER_INFO[id][pRango] >= PLAYER_INFO[playerid][pRango] && PLAYER_INFO[playerid][pRango] != 8) return SendClientMessage(playerid, -1, "Solo puedes cambiar de rango a los miembros con un rango menor al tuyo"); {
            GetPlayerName(id, pSub, 32);
            if (rango == 1) {
                SendClientMessage(playerid, -1, "{FF0000}["    SERVER_COIN2 ":RP] {FFFFFF} Cambio realizado con exito.");
                PLAYER_INFO[id][pRango] = rango;
            }
            if (rango == 2) {
                SendClientMessage(playerid, -1, "{FF0000}["    SERVER_COIN2 ":RP] {FFFFFF} Cambio realizado con exito.");
                PLAYER_INFO[id][pRango] = rango;
            }
            if (rango == 3) {
                SendClientMessage(playerid, -1, "{FF0000}["    SERVER_COIN2 ":RP] {FFFFFF} Cambio realizado con exito.");
                PLAYER_INFO[id][pRango] = rango;
            }
            if (rango == 4) {
                SendClientMessage(playerid, -1, "{FF0000}["    SERVER_COIN2 ":RP] {FFFFFF} Cambio realizado con exito.");
                PLAYER_INFO[id][pRango] = rango;
            }
            if (rango == 5) {
                SendClientMessage(playerid, -1, "{FF0000}["    SERVER_COIN2 ":RP] {FFFFFF} Cambio realizado con exito.");
                PLAYER_INFO[id][pRango] = rango;
            }
            if (rango == 6) {
                SendClientMessage(playerid, -1, "{FF0000}["    SERVER_COIN2 ":RP] {FFFFFF} Cambio realizado con exito.");
                PLAYER_INFO[id][pRango] = rango;
            }
            if (rango == 7) {
                SendClientMessage(playerid, -1, "{FF0000}["    SERVER_COIN2 ":RP] {FFFFFF} Cambio realizado con exito.");
                PLAYER_INFO[id][pRango] = rango;
            }
            if (rango == 8) {

                SendClientMessage(playerid, -1, "{FF0000}["    SERVER_COIN2 ":RP] {FFFFFF} Cambio realizado con exito.");
                new DB_Query[256];
                PLAYER_INFO[id][pRango] = rango;
                PLAYER_INFO[playerid][pRango] = 1;
                mysql_format(handle_db, DB_Query, sizeof(DB_Query), "UPDATE `facciones` SET `Lider`='%s' WHERE `Lider`='%s'", NombreJugador(id), NombreJugador(playerid));
                mysql_tquery(handle_db, DB_Query);
            }
        }
    }
    return 1;
}
CMD:estivenwashington1(playerid, params[]) {
    if (PLAYER_INFO[playerid][pFaccion] == 0) return SendClientMessage(playerid, -1, "No perteneces a ninguna banda.");
    if (PLAYER_INFO[playerid][pRango] != 8) return SendClientMessage(playerid, -1, "Solo el dueño puede ocupar este comando.");
    new ID[32], string[256], Query[200], pName[32];
    GetPlayerName(playerid, pName, 32);
    if (!sscanf(params, "s[32]", ID)) {
        mysql_format(handle_db, Query, sizeof(Query), "SELECT * FROM `usuarios` WHERE `Username`='%s' AND `Faccion`='%d'", ID, PLAYER_INFO[playerid][pFaccion]);
        mysql_query(handle_db, Query, true);

        if (cache_num_rows()) {
            if (PLAYER_INFO[playerid][pFaccion] == 1) {
                format(string, sizeof(string), "{009BE4}%s {FFFFFF}fue expulsado de la banda por {009BE4}%s", ID, PLAYER_INFO[playerid][Nickname]);
                SendRadioPoliceMessage(-1, string);
            } else {
                format(string, sizeof(string), "{%06x}%s{FFFFFF} fue expulsado de la banda por {%06x}%s", BandasInfo[PLAYER_INFO[playerid][pFaccion]][BColor] >>> 8, ID, BandasInfo[PLAYER_INFO[playerid][pFaccion]][BColor] >>> 8, PLAYER_INFO[playerid][Nickname]);
                SendRadioMessage(PLAYER_INFO[playerid][pFaccion], -1, string, playerid, Frecuencia[playerid]);
            }
            mysql_format(handle_db, Query, sizeof(Query), "UPDATE `usuarios` SET `Faccion`='0',`Rango`='0',`Duty`='0' WHERE `Username`='%s'", ID);
            mysql_query(handle_db, Query, true);
        } else {
            SendClientMessage(playerid, -1, "Este usuario no se encuentra en tu faccion.");
        }
    } else return SendClientMessage(playerid, -1, "Escribe {009AFF}/despediroff {FFFFFF}<Nombre_Apellido>");
    return 1;
}
CMD:roleplaiir(playerid, params[]) {
    if (PLAYER_INFO[playerid][pFaccion] == 0) return SendClientMessage(playerid, -1, "No perteneces a ninguna banda");
    if (PuedeExpulsar(playerid)) return SendClientMessage(playerid, -1, "No tienes permiso para sacar personas a la banda.");

    new id, string[128], pName[32], pSub[32];
    GetPlayerName(playerid, pName, 32);
    if (!sscanf(params, "d", id)) {
        if (id == playerid) return 1;
        if (PLAYER_INFO[id][pFaccion] != PLAYER_INFO[playerid][pFaccion]) return SendClientMessage(playerid, -1, "Este jugador no pertenece a tu faccion");
        if (PLAYER_INFO[id][pRango] == 8) return SendClientMessage(playerid, -1, "No puedes despedir a este jugador.");

        GetPlayerName(id, pSub, 32);
        if (PLAYER_INFO[id][pFaccion] == 1) {
            format(string, 200, "{009BE4}%s {FFFFFF}fue expulsado de la faccion por {009BE4}%s", PLAYER_INFO[id][Nickname], PLAYER_INFO[playerid][Nickname]);
            SendRadioPoliceMessage(-1, string);
        } else {
            format(string, 200, "{%06x}%s{FFFFFF} fue expulsado de la banda por {%06x}%s", BandasInfo[PLAYER_INFO[playerid][pFaccion]][BColor] >>> 8, PLAYER_INFO[id][Nickname], BandasInfo[PLAYER_INFO[playerid][pFaccion]][BColor] >>> 8, PLAYER_INFO[playerid][Nickname]);
            SendRadioMessage(PLAYER_INFO[playerid][pFaccion], -1, string, playerid, Frecuencia[playerid]);
        }
        if (PLAYER_INFO[id][pFaccion] == 1) {
            SetPlayerSkin(id, PLAYER_INFO[id][jRopa]);
            ClearAnimations(id);
        }
        PLAYER_INFO[id][pFaccion] = 0;
        PLAYER_INFO[id][pRango] = 0;
        PLAYER_INFO[id][pDuty] = 0;
        HidePlayerGangZones(id);
    } else return SendClientMessage(playerid, -1, "Escribe {009AFF}/despedir {FFFFFF}<PlayerID>");
    return 1;
}

CMD:mutear(playerid, params[]) {
    if (AdminDuty[playerid] == 0) return SendClientMessage(playerid, -1, "No puedes usar este comando en fuera de servicio administrativo");
    new id, tiempo, string[128], razon[200], string2[128], day, month, year, hora, minuto, segundo;
    getdate(year, month, day);
    gettime(hora, minuto, segundo);
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_DUDAS) return 1;
    if (!sscanf(params, "dds[200]", id, tiempo, razon)) {
        if (IsPlayerNPC(id)) return 1;
        if (!IsPlayerConnected(id)) return SendClientMessage(playerid, 0x25AB26FF, "Jugador no conectado");
        if (tiempo <= 0) return 1;
        if (PLAYER_TIMES[id][TiempoDuda] > 240) return SendClientMessage(playerid, -1, "Ese jugador ya esta muteado.");
        foreach(new i : Player) {
            if (JugadorLogeado[i] == 1) {
                if (PLAYER_INFO[i][pMuteos] == 1) {
                    format(string, sizeof(string), "A %s no se le permite hablar en el chat de ayuda. Razon: %s", PLAYER_INFO[id][Nickname], razon);
                    SendClientMessage(i, 0xAA3333FF, string);
                }
            }
            if (PLAYER_INFO[i][pAdmin] > ADMIN_LEVEL_DUDAS) {
                format(string, 128, "Tiempo de muteo: %d minutos, Administrador: %s", tiempo, PLAYER_INFO[playerid][Nickname]);
                SendClientMessage(i, COLOR_GREY, string);
            }
        }
        new calculo = tiempo * 60 * 1;
        SetTimerEx("DudaOn", calculo, 0, "d", id);
        RecienDuda[id] = 0;
        PLAYER_TIMES[id][TiempoDuda] = tiempo * 60;
        format(string2, 128, "No se te permite hablar en el chat de ayuda. Por %d minuto(s)", tiempo);
        SendClientMessage(id, 0xDEA600FF, string2);
        format(string2, 128, "Se te desconto $%d por el muteo.", tiempo);
        SendClientMessage(id, 0xDEA600FF, string2);
        QuitarDinero(id, tiempo);
        new query[560];
        mysql_format(handle_db, query, sizeof(query), "INSERT INTO registros_admin (Responsable, Jugador, Razon, Accion) VALUES ('%e','%e','%e','1')", PLAYER_INFO[playerid][Nickname], PLAYER_INFO[id][Nickname], razon);
        mysql_tquery(handle_db, query);
    } else return SendClientMessage(playerid, -1, "Escribe {"COLOR_GM "}/mutear {FFFFFF}<PlayerID> <Tiempo> <Razon>");
    return 1;
}
CMD:desmutear(playerid, params[]) {
    new id, string[128], razon[200];
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_DUDAS) return 0;
    if (!sscanf(params, "ds[200]", id, razon)) {
        if (IsPlayerNPC(id)) return 1;
        foreach(new i : Player) {
            if (JugadorLogeado[i] == 1) {
                if (PLAYER_INFO[i][pMuteos] == 1) {
                    format(string, sizeof(string), "A %s ahora se le permite hablar en el chat de ayuda. Razon: %s", PLAYER_INFO[id][Nickname], razon);
                    SendClientMessage(i, COLOR_GREY, string);
                }
            }
            if (PLAYER_INFO[i][pAdmin] > ADMIN_LEVEL_DUDAS) {
                format(string, 128, "Administrador: %s", PLAYER_INFO[playerid][Nickname]);
                SendClientMessage(i, COLOR_GREY, string);
            }
        }
        PLAYER_TIMES[id][TiempoDuda] = 0;
        RecienDuda[id] = 1;
        SendClientMessage(id, 0xDEA600FF, "Se te quito la restriccion del canal de dudas.");
    } else return SendClientMessage(playerid, -1, "MODO DE USO: {"COLOR_GM "}/desmutear {FFFFFF}<PlayerID> <Razon>");
    return 1;
}
