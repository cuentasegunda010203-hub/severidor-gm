public OnPlayerCarTroll(playerid, vehicleid, trolledid, trolltype) {
    new KickString[80];

    if (trolledid != INVALID_PLAYER_ID) // If the trolled person is valid
    {
        SendClientMessage(trolledid, -1, "Fuiste trolleado pero el tramposo fue expulsado."); //Inform him
        format(KickString, sizeof(KickString), "Trolling #%d vehicle %d player %d", trolltype, vehicleid, trolledid); //Kick with a reasonable message
    } else format(KickString, sizeof(KickString), "Trolling #%d vehicle %d", trolltype, vehicleid); //If no one was trolled kick the troller normally

    if (!IsPlayerMobile(playerid)) KickPlayer(playerid, 0, KickString);

    return 1;
}
public Conteos(Tiempo) {
    if (Tiempo >= 1) {
        new Mensaje[6];
        format(Mensaje, sizeof(Mensaje), "~r~%d", Tiempo);
        foreach(new i : Player) {
            if (IsPlayerConnected(i)) GameTextForPlayerEx(i, Mensaje, 1000, 3);
        }
        SetTimerEx("Conteos", 1000, false, "i", Tiempo - 1);
    } else {
        foreach(new i : Player) {
            if (IsPlayerConnected(i)) GameTextForPlayerEx(i, "~g~YA!", 1000, 3);
            EnConteo = false;
        }
    }
    return 1;
}


public GuardarCuentasAT() {
    foreach(new i : Player) {
        if (IsPlayerConnected(i) && !IsPlayerNPC(i)) {
            if (LoggedYet[i] != false) GuardarCuenta(i);
        }
    }
}
public OnGameModeExit() {
    RP_IACleanup();
    BorrarMochilas();
    for(new ID = 1; ID < MAX_FABRICAS; ID++) {
        if (FABRICAS_INFO[ID][f_VALID]) {
            GuardarFabrica(ID);
        }
    }
    for(new m; m < MAX_MERCADOS; m++) { GuardarMerca(m); }
    for(new i = 0; i < 20; i++) {
        if (IsPlayerNPC(i)) Kick(i);
    }
    GuardarCuentasAT();
    mysql_close(handle_db);
    return 1;
}
