                        Notificador2(playerid, "Para ajustar los permisos de tu banda debes ingresar a la ~y~/web"); //dialogs_ShowPlayerDialog(playerid,CHANGE_PROP_RANK,DIALOG_STYLE_LIST, "Bandas: Administra tu banda","{FFFFFF}- Ajustar permiso de invitaciones\n{FFFFFF}- Ajustar permiso de expulsiones\n{FFFFFF}- Ajustar permiso de ascender/descender\n", "Cambiar", "Volver");
                    }
                    case 3: {
                        if (PLAYER_INFO[playerid][pRango] < 8) return SendClientMessage(playerid, -1, "La banda solo puede ser borrada por el lider.");
                        mysql_format(handle_db, Query, sizeof(Query), "DELETE FROM `facciones` WHERE `id`='%d'", BandasInfo[PLAYER_INFO[playerid][pFaccion]][bID]);
                        mysql_tquery(handle_db, Query);
                        mysql_format(handle_db, Query, sizeof(Query), "UPDATE `usuarios` SET `Faccion`='0',`Rango`='0' WHERE `Faccion`='%d'", PLAYER_INFO[playerid][pFaccion]);
                        mysql_tquery(handle_db, Query);
                        foreach(new i : Player) {
                            if (PLAYER_INFO[i][pFaccion] == PLAYER_INFO[playerid][pFaccion] && i != playerid) {
                                PLAYER_INFO[i][pFaccion] = 0;
                                PLAYER_INFO[i][pRango] = 0;
                                SendClientMessage(i, -1, "La banda que pertenecías fue borrada por el lider.");
                            }
                        }
                        DarRopa(playerid);
                        ResetPlayerWeapons(playerid);
                        DarArmas(playerid);
                        PLAYER_INFO[playerid][pFaccion] = 0;
                        PLAYER_INFO[playerid][pRango] = 0;
                        CargarFacciones();
                        HidePlayerGangZones(playerid);
                        SendClientMessage(playerid, -1, "Tu banda fue borrada correctamente.");
                    }
                }
            }
        }
        case D_INMIGRACION: {
            if (response) {
                if (IsNumeric(inputtext)) return NombreInvalido(playerid);
                if (strfind(inputtext, "=", true) != -1 || strfind(inputtext, "´", true) != -1 || strfind(inputtext, "'", true) != -1 || strfind(inputtext, "`", true) != -1 || strfind(inputtext, ",", true) != -1 || strfind(inputtext, "¨", true) != -1) return NombreInvalido(playerid);
                if (strlen(inputtext) < 1 && strlen(inputtext) > 23) return ShowPlayerMessage(playerid, "~r~Nombre demasiado largo."), NombreInvalido(playerid);
                new jugenc = GetPlayerID(inputtext);
                if (jugenc == INVALID_PLAYER_ID) {
                    format(PLAYER_INFO[playerid][Nickname], 26, "%s", inputtext);
                    if (!NameCheck(inputtext)) {
                        NombreInvalido(playerid);
                    } else {
                        if (IsPlayerConnected(playerid)) {
                            mysql_format(handle_db, QUERY_BUFFER, sizeof(QUERY_BUFFER), "SELECT * FROM `usuarios` WHERE `Username`='%s' LIMIT 1", PLAYER_INFO[playerid][Nickname]);
                            mysql_tquery(handle_db, QUERY_BUFFER, "OnPlayerDataLoaded", "d", playerid);
                        }
                    }
                } else {
                    ShowPlayerMessage(playerid, "~r~Elige otro nombre que no este conectado en el servidor.");
                    NombreInvalido(playerid);
                }
            } else ExpulsarJugador(playerid, "Nombre invalido");
        }
        case CHANGE_CREW_NAME: {
            if (!response) {
