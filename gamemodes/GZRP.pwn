stock GetPolicesOn( & value) {
    new count;
    foreach(new i : Player) {
        if (!IsPlayerNPC(i)) {
            if (PLAYER_INFO[i][pFaccion] == 1 && PLAYER_INFO[i][pDuty] > 0 || PLAYER_INFO[i][pFaccion] == 2 && PLAYER_INFO[i][pDuty] > 0) count++;
        }
    }
    value = count;
}
stock GetBomberosOn( & value) {
    new count;
    foreach(new i : Player) {
        if (!IsPlayerNPC(i)) {
            if (PLAYER_INFO[i][pFaccion] == 3 && PLAYER_INFO[i][pDuty] > 0) count++;
        }
    }
    value = count;
}
stock NoTeleportHack(playerid) {
    PLAYER_AC_INFO[playerid][CHEAT_POS][p_ac_info_IMMUNITY] = gettime() + 3;
    PLAYER_AC_INFO[playerid][CHEAT_STATE_SPAMMER][p_ac_info_IMMUNITY] = gettime() + 3;
    PLAYER_AC_INFO[playerid][CHEAT_UNOCCUPIED_VEHICLE_TP][p_ac_info_IMMUNITY] = gettime() + 5;
    Entrando[playerid] = 3;
}
stock prendasValidas(value) {
    if (value == 11704 || value == 18640 || value == 18645 || value == 18893 || value == 18895 || value == 18897 || value == 18899 || value >= 18912 && value <= 18920 || value == 18929) return 1;
    if (value == 18933 || value == 18939 || value == 18941 || value == 18942 || value == 18943 || value == 18946 || value == 18949 || value == 18958 || value == 18959 || value == 18961) return 1;
    if (value == 18962 || value == 18964 || value == 18966 || value == 18967 || value == 18968 || value == 18969 || value == 18971 || value == 18972 || value == 18974 || value == 18976) return 1;
    if (value == 18978 || value == 18979 || value == 19009 || value == 19010 || value == 19022 || value == 19023 || value == 19025 || value == 19029 || value == 19030 || value == 19033 || value == 6865) return 1;
    if (value == 19036 || value == 19064 || value == 19069 || value == 19078 || value == 19085 || value == 19086 || value == 19096 || value == 19112 || value == 19114 || value == 19136 || value == 3524) return 1;
    if (value == 19472 || value == 19274 || value == 19314 || value == 19352 || value == 19469 || value == 19475 || value == 19487 || value == 19488 || value == 19528 || value == 19583 || value == 19801) return 1;
    return 0;
}
stock QuitarConsumibles(playerid) {
    TieneSprunk[playerid] = 0;
    TieneVino[playerid] = 0;
    TieneCerveza[playerid] = 0;
    TienePizza[playerid] = 0;
    TieneAquariu[playerid] = 0;
    TienePorro[playerid] = 0;
}
stock CancelarRobo(playerid, actor) {
    for(new i = 0; i < MAX_NPC_ROBOS; i++) {
        if (RoboTiendas[i][Actor] == actor) {
            KillTimer(PLAYER_TEMP[playerid][TimerRobar]);
            new id = RoboTiendas[i][rID];
            ApplyDynamicActorAnimation(actor, "RIOT", "RIOT_FUKU", 4.000000, 0, 0, 0, 1, 0);
            RoboTiendas[id][RoboProceso] = 0;
        }
    }
    return 1;
}
stock GetPlayerArrestedPositions(playerid, & Float:x, & Float:y, & Float:z, & Float:a) {
    if (IsPlayerInRangeOfPoint(playerid, 10, -28.3834, -89.9474, 1003.5469)) {
        x = -28.5330;
        y = -88.5960;
        z = 1003.5469;
        a = 145.1751;
    }
    if (IsPlayerInRangeOfPoint(playerid, 10, -28.6914, -185.8927, 1007.7300)) {
        x = -28.6914;
        y = -185.8927;
        z = 1007.7300;
        a = 229.6577;
    }
    if (IsPlayerInRangeOfPoint(playerid, 20, 370.4197, -123.0341, 1001.4995)) {
        x = 370.4197;
        y = -123.0341;
        z = 1001.4995;
        a = 188.7337;
    }
}
stock Float:GetDistanceBetweenPoints(Float:x1, Float:y1, Float:z1, Float:x2, Float:y2, Float:z2) //By milous22 (http://github.com/milous22)
{
    return floatsqroot(floatadd(floatadd(floatpower(floatsub(x1, x2), 2), floatpower(floatsub(y1, y2), 2)), floatpower(floatsub(z1, z2), 2)));
}
stock PermiteRobar(playerid, id) {
    if (PLAYER_INFO[playerid][pFaccion] == 1) return PLAYER_TEMP[playerid][PuedeRobar] = 0;
    if (GetPlayerInterior(playerid) == 0) return PLAYER_TEMP[playerid][PuedeRobar] = 0;
    if (PLAYER_INFO[playerid][pTrabajo] == T_Medico || PLAYER_INFO[playerid][pTrabajo2] == T_Medico || PLAYER_INFO[playerid][pTrabajo] == T_Basurero || PLAYER_INFO[playerid][pTrabajo2] == T_Basurero) {
        if (PLAYER_TIMES[playerid][TiempoMensajeRobar] == 0) {
            if (PLAYER_INFO[playerid][pTrabajo] == T_Medico || PLAYER_INFO[playerid][pTrabajo2] == T_Medico) SendClientMessage(playerid, -1, "No puedes asaltar negocios siendo medico.");
            else if (PLAYER_INFO[playerid][pTrabajo] == T_Basurero || PLAYER_INFO[playerid][pTrabajo2] == T_Basurero) SendClientMessage(playerid, -1, "No puedes asaltar negocios siendo basurero.");
            PLAYER_TIMES[playerid][TiempoMensajeRobar] = 2;
        }
        PLAYER_TEMP[playerid][PuedeRobar] = 0;
        KillTimer(PLAYER_TEMP[playerid][TimerRobar]);
        return 0;
    }
    if (GetPlayerWantedLevel(playerid) > 0) {
        if (PLAYER_TIMES[playerid][TiempoMensajeRobar] == 0) {
            SendClientMessage(playerid, -1, "La {3399FF}policia{FFFFFF} te esta buscando, {FF0000}no puedes robar{ffffff} un negocio en este momento.");
            PLAYER_TIMES[playerid][TiempoMensajeRobar] = 2;
        }
        PLAYER_TEMP[playerid][PuedeRobar] = 0;
        KillTimer(PLAYER_TEMP[playerid][TimerRobar]);
        return 0;
    }
    if (UltimoRobado[playerid] == id) {
        if (PLAYER_TIMES[playerid][TiempoMensajeRobar] == 0) {
            SendClientMessage(playerid, -1, "No puedes robar el {FF0000}mismo negocio{FFFFFF} seguidamente.");
            PLAYER_TIMES[playerid][TiempoMensajeRobar] = 2;
        }
        PLAYER_TEMP[playerid][PuedeRobar] = 0;
        KillTimer(PLAYER_TEMP[playerid][TimerRobar]);
        return 0;
    }
    new last = UltimoRobado[playerid];
    new Float:CordX = RoboTiendas[id][EntradaX];
    new Float:CordY = RoboTiendas[id][EntradaY];
    new Float:CordZ = RoboTiendas[id][EntradaZ];
    new Float:CordAX = RoboTiendas[last][EntradaX];
    new Float:CordAY = RoboTiendas[last][EntradaY];
    new Float:CordAZ = RoboTiendas[last][EntradaZ];
    new Float:dis = GetDistanceBetweenPoints(CordX, CordY, CordZ, CordAX, CordAY, CordAZ);
    if (dis < 250) {
        if (UltimoRobado[playerid] != 0) {
            if (PLAYER_TIMES[playerid][TiempoMensajeRobar] == 0) {
                SendClientMessage(playerid, -1, "No puedes robar un negocio {FF0000}tan cercano{FFFFFF} al de tu ultimo robo.");
                PLAYER_TIMES[playerid][TiempoMensajeRobar] = 2;
            }
            PLAYER_TEMP[playerid][PuedeRobar] = 0;
            KillTimer(PLAYER_TEMP[playerid][TimerRobar]);
            return 0;
        }
    }
    return 1;
}

stock KickPlayer(playerid, slot, const razon[], admin = -1) {
    new string[256], r_por[128];
    if (!IsPlayerNPC(playerid)) {
        if (slot == 0) //ANTICHEAT KICK
        {
            format(string, sizeof string, "El jugador {FF3300}%s(ID: %d) [%s]{FFFFFF} fue expulsado por el anticheat. Razon: {FF3300}%s [N: %d].", PLAYER_INFO[playerid][Nickname], playerid, Launcher(playerid), razon, PLAYER_INFO[playerid][@Nivel]);
        } else if (slot == 1) //ANTICHEAT BAN
        {
            format(string, sizeof string, "El jugador {FF3300}%s(ID: %d) [%s]{FFFFFF} fue baneado por el anticheat. Razon: {FF3300}%s [N: %d].", PLAYER_INFO[playerid][Nickname], playerid, Launcher(playerid), razon, PLAYER_INFO[playerid][@Nivel]);
        } else if (slot == 2) //ADMIN KICK
        {
            format(string, sizeof string, "El jugador {FF3300}%s(ID: %d) [%s]{FFFFFF} fue expulsado por un admin. Razon: {FF3300}%s [N: %d].", PLAYER_INFO[playerid][Nickname], playerid, Launcher(playerid), razon, PLAYER_INFO[playerid][@Nivel]);
            format(r_por, sizeof r_por, "[!] Administrador que realizo la accion %s.", PLAYER_INFO[admin][Nickname]);
            ASendClientMessageEx(0xEEB415FF, r_por);
        } else if (slot == 3) //ADMIN BAN
        {
            format(string, sizeof string, "El jugador {FF3300}%s(ID: %d){ [%s]FFFFFF} fue baneado por un admin. Razon: {FF3300}%s [N: %d].", PLAYER_INFO[playerid][Nickname], playerid, Launcher(playerid), razon, PLAYER_INFO[playerid][@Nivel]);
            ASendClientMessageEx(0xEEB415FF, string);
            format(r_por, sizeof r_por, "[!] Administrador que realizo la accion %s.", PLAYER_INFO[admin][Nickname]);
            ASendClientMessageEx(0xEEB415FF, r_por);
        } else if (slot == 4) //OTRO KICKEO
        {
            format(r_por, sizeof r_por, "[!] %s salio del servidor, Razon: %s.", PLAYER_INFO[admin][Nickname], razon);
            ASendClientMessageEx(0xEEB415FF, r_por);
        }
        if (slot < 4 || slot > 4) {
            if (PLAYER_TEMP[playerid][Expulsando] == 0) SendClientMessageToAll(-1, string);
        }
        PLAYER_TEMP[playerid][Expulsando]++;
        ExpulsarJugador(playerid, razon);
    }
    return 1;
}
CalcularCargos(playerid) {
    new time;
    switch (PLAYER_INFO[playerid][pVip]) {
        case 0: {
            switch (PLAYER_INFO[playerid][pCargos]) {
                case 1 : time = 2;
                case 2 : time = 3;
                case 3 : time = 4;
                case 4 : time = 5;
                case 5 : time = 6;
                case 6 : time = 7;
                case 7 : time = 8;
                case 8 : time = 9;
                case 9 : time = 10;
                default: time = 15;
            }
        }
        case 1: {
            switch (PLAYER_INFO[playerid][pCargos]) {
                case 1 : time = 2;
                case 2 : time = 3;
                case 3 : time = 4;
                case 4 : time = 5;
                case 5 : time = 6;
                case 6 : time = 7;
                case 7 : time = 8;
                case 8 : time = 9;
                case 9 : time = 10;
                default: time = 15;
            }
        }
        case 2: {
            switch (PLAYER_INFO[playerid][pCargos]) {
                case 1 : time = 2;
                case 2 : time = 3;
                case 3 : time = 4;
                case 4 : time = 5;
                case 5 : time = 6;
                case 6 : time = 7;
                case 7 : time = 8;
                case 8 : time = 9;
                case 9 : time = 10;
                default: time = 15;
            }
        }
        case 3: {
            switch (PLAYER_INFO[playerid][pCargos]) {
                case 1 : time = 2;
                case 2 : time = 3;
                case 3 : time = 4;
                case 4 : time = 5;
                case 5 : time = 6;
                case 6 : time = 7;
                case 7 : time = 8;
                case 8 : time = 9;
                case 9 : time = 10;
                default: time = 15;
            }
        }
    }
    return time;
}
stock EnLugarRobo(playerid) {
    if (IsPlayerInRangeOfPoint(playerid, 4.0, -2279.4539, -15.9261, 38.2993)) { return 1; } else if (IsPlayerInRangeOfPoint(playerid, 4.0, 940.9933, 1975.9020, 11.6227)) { return 1; } else if (IsPlayerInRangeOfPoint(playerid, 4, -2395.5342, -17.3052, 35.3740)) { return 1; } else if (IsPlayerInRangeOfPoint(playerid, 4.0, 2369.2874, -1129.8945, 30.0510)) { return 1; } else if (IsPlayerInRangeOfPoint(playerid, 4.0, -2730.4619, -58.3389, 7.0453)) { return 1; } else if (IsPlayerInRangeOfPoint(playerid, 4.0, -2731.8608, -163.3383, 7.2174)) { return 1; } else if (IsPlayerInRangeOfPoint(playerid, 4.0, -2628.6865, -178.5047, 7.1544)) { return 1; } else if (IsPlayerInRangeOfPoint(playerid, 4.0, 2481.6006, -1988.2667, 13.6347)) { return 1; } else if (IsPlayerInRangeOfPoint(playerid, 4.0, 2063.2168, 696.6254, 11.5381)) { return 1; } else if (IsPlayerInRangeOfPoint(playerid, 4.0, -1449.5641, 2644.4102, 56.5616)) { return 1; } else if (IsPlayerInRangeOfPoint(playerid, 4.0, 2450.7051, 746.4616, 11.5165)) { return 1; } else if (IsPlayerInRangeOfPoint(playerid, 4.0, 2450.3611, 746.4504, 11.5165)) { return 1; }
    return 0;
}

