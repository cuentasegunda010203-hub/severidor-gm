                    case 17 : SetPosEx(playerid, -1444.645507, -664.526000, 1053.572998, 0, 4, 100, 1);
                    case 18 : SetPosEx(playerid, -1465.268676, 1557.868286, 1052.531250, 0, 14, 100, 1);
                    case 19 : SetPosEx(playerid, -1401.829956, 107.051300, 1032.273437, 0, 1, 100, 1);
                    case 20 : SetPosEx(playerid, 1710.433715, -1669.379272, 20.225049, 0, 18, 100, 1);
                }
            } else MostrarDialogoEvento(playerid);
        }
        case DIALOG_EVENT: {
            if (response) {
                switch (listitem) {
                    case 0 :  {
                        dialogs_ShowPlayerDialog(playerid, DIALOG_CHANGENAME_EVENT, DIALOG_STYLE_INPUT, "{ffa500}Nombre del evento", "{FFFFFF}Escribe el nombre del evento:", "Aceptar", "Atras");
