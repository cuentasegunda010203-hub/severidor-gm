CMD:radio(playerid, params[]) {
    new item[138];
    if (PLAYER_INFO[playerid][pRadio] != 1) return Notificador2(playerid, "Tu no tienes un radio comunicador, puedes comprar uno en un 24/7");
    if (sscanf(params, "s[138]", item)) return SendClientMessage(playerid, -1, "Escribe ~b~/radio ON/OFF"); {
        if (strcmp(item, "on", true) == 0) {
            if (EstadoRadio[playerid] == 1) return PUSH(playerid, "Tu radio comunicador ya se encuentra encendido.");
            EstadoRadio[playerid] = 1;
            if (PLAYER_TEMP[playerid][@Specteando] == 0) AccionesRol(playerid, "encendio su radio comunicador.", 20);
        }
        if (strcmp(item, "off", true) == 0) {
            if (EstadoRadio[playerid] == 0) return PUSH(playerid, "Tu radio comunicador ya se encuentra apagado.");
            EstadoRadio[playerid] = 0;
            if (PLAYER_TEMP[playerid][@Specteando] == 0) AccionesRol(playerid, "apago su radio comunicador.", 20);
        }
    }
    return 1;
}
CMD:n(playerid, params[]) {
    new texto[128], string[400];
    if (GetPlayerScore(playerid) == 0) return 1;
    if (CanalDudas[playerid] == 0) return PUSH(playerid, "Tienes el canal de dudas desactivado");
    if (sscanf(params, "s[128]", texto)) return SendClientMessage(playerid, -1, "Usa {FFCA00}/n {FFFFFF}({FFCA00}y tu pregunta{FFFFFF}) para recibir ayuda de otros jugadores.");
    if (PLAYER_INFO[playerid][pTiempoJail] > 0) return SendClientMessage(playerid, 0x3AA000FF, "No puedes usar el canal de dudas mientras estas sancionado.");
    if (PLAYER_TIMES[playerid][TiempoDuda] > 0 && RecienDuda[playerid] == 1) {
        if (PLAYER_TIMES[playerid][TiempoDuda] < 60) format(string, sizeof(string), "Debes esperar %d segundos para volver a utilizar el canal de dudas.", PLAYER_TIMES[playerid][TiempoDuda]);
        else if (PLAYER_TIMES[playerid][TiempoDuda] >= 60) format(string, sizeof(string), "Debes esperar %dm %ds para volver a utilizar el canal de dudas.", PLAYER_TIMES[playerid][TiempoDuda] / 60, PLAYER_TIMES[playerid][TiempoDuda] % (60));
        SendClientMessage(playerid, 0xff9a00FF, string);
        return 1;
    }
    if (PLAYER_TIMES[playerid][TiempoDuda] > 0 && RecienDuda[playerid] == 0) {
        if (PLAYER_TIMES[playerid][TiempoDuda] < 60) format(string, sizeof(string), "No se te permite hablar por el chat de ayuda. Espera {00CC00}%ds{FFFFFF} para enviar otra consulta al canal de ayuda.", PLAYER_TIMES[playerid][TiempoDuda]);
        else if (PLAYER_TIMES[playerid][TiempoDuda] >= 60) format(string, sizeof(string), "No se te permite hablar por el chat de ayuda. Espera {00CC00}%dm %ds{FFFFFF} para enviar otra consulta al canal de ayuda.", PLAYER_TIMES[playerid][TiempoDuda] / 60, PLAYER_TIMES[playerid][TiempoDuda] % (60));
        SendClientMessage(playerid, -1, string);
        return 1;
    }
    if (PLAYER_INFO[playerid][pAdmin] == ADMIN_LEVEL_USER) {
        new string1[300];
        new s = GetSpam(playerid, params);
        if (s == 2 || s == 3) {
            format(string1, sizeof(string1), "({6E0B14}Bloqueado /n{A946F6}) %s (%d)[N: %d]: %s", NombreJugador(playerid), playerid, PLAYER_INFO[playerid][@Nivel], params);
            MensajeAdmin(0xA946F6FF, string, 3);
            DudaOff[playerid] = 1;
            PLAYER_TIMES[playerid][TiempoDuda] = 60;
            MensajeEx(playerid, -1, "Se detecto un posible spam en tu pregunta vuelve a intentarlo.");
            SetTimerEx("DudaOn", 30000, 0, "d", playerid);
            return 0;
        }
        if (PLAYER_INFO[playerid][pTiempoJail] > 0) return MensajeEx(playerid, -1, "No puedes utilizar el canal de dudas en una sancion");
        format(string, sizeof(string), "{FFFFFF}El canal de dudas /n es unicamente para dudas.\n\nNO USES el canal de dudas para comunicarte con tus amigos, para vender cosas o para insultar.\nEn caso de hacerlo, vas a ser sancionado con descuento de dinero.\nTambien tu cuenta puede ser baneada permanentemente.\n\n                   ¿Quieres enviar la duda o respuesta a la duda?");
        dialogs_ShowPlayerDialog(playerid, DAYUDA, DIALOG_STYLE_MSGBOX, "{FFCA00}¡ATENCION!", string, "Si", "No");
        DudaTexto[playerid] = texto;
    }
    if (PLAYER_INFO[playerid][pAdmin] > ADMIN_LEVEL_USER) return EnviarDuda2(playerid, params);
    return 1;
}


CMD:hora(playerid, params[]) {
    new hour, minute, second, string[180];
    new day, month, year;
    gettime(hour, minute, second);
    getdate(year, month, day);
    format(string, sizeof(string), "{FFFFFF}Fecha y hora actual del servidor: {"COLOR_GM "}%02d/%02d/%02d %02d:%02d:%02d.", day, month, year, hour, minute, second);
    SendClientMessage(playerid, -1, string);
    return 1;
}
CMD:intentar(playerid, params[]) {
    if (PLAYER_TIMES[playerid][TiempoIntentar] > 0) {
        new tmpString[250];
        format(tmpString, sizeof(tmpString), "El comando {"    COLOR_GM "}/intentar{FFFFFF} solo se puede usar una vez por minuto. Por favor espera {"    COLOR_GM "}%d {FFFFFF}segundos.", PLAYER_TIMES[playerid][TiempoIntentar]);
        return SendClientMessage(playerid, COLOR_WHITE, tmpString);
    }
    if (!isnull(params)) {
        new string[128];
        format(string, sizeof(string), "%s intenta %s %s", PLAYER_INFO[playerid][Nickname], params, ((random(2)) ? ("y lo logra.") : ("y no puede.")));
        if (strlen(string) < 128) ProxDetector(30.0, playerid, string, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES);
        PLAYER_TIMES[playerid][TiempoIntentar] = 59;
    } else SendClientMessage(playerid, COLOR_WHITE, "Por favor escribe {"COLOR_GM "}/intentar accion{FFFFFF}, por ejemplo: {"COLOR_GM "}/intentar encestar el balon en el aro{FFFFFF}.");
    return 1;
}
CMD:do(playerid, params[]) {
    if (!isnull(params)) {
        new string[128];
        if (PLAYER_INFO[playerid][pMascaraPuesta] == 1) format(string, sizeof(string), "* %s (( Anonymous ))", params);
        else format(string, sizeof(string), "* %s (( %s ))", params, PLAYER_INFO[playerid][Nickname]);
        if (strlen(string) < 128) ProxDetector(15.0, playerid, string, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO);
    } else SendClientMessage(playerid, COLOR_WHITE, "Por favor escribe {009AFF}/p entorno{FFFFFF}, por ejemplo: {009AFF}/p se cae una roca por la montaña");
    return 1;
}
CMD:p(playerid, params[]) {
    if (!isnull(params)) {
        new string[128];
        if (PLAYER_INFO[playerid][pMascaraPuesta] == 1) format(string, sizeof(string), "* %s (( Anonymous ))", params);
        else format(string, sizeof(string), "* %s (( %s ))", params, PLAYER_INFO[playerid][Nickname]);
        if (strlen(string) < 128) ProxDetector(15.0, playerid, string, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO);
    } else SendClientMessage(playerid, COLOR_WHITE, "Por favor escribe {009AFF}/p entorno{FFFFFF}, por ejemplo: {009AFF}/p se cae una roca por la montaña");
    return 1;
}
CMD:mascara(playerid, params[]) {
    new string[512];
    if (PLAYER_INFO[playerid][Agonizando] != 0 && Esposando[playerid] != 0) return Notificador2(playerid, "~r~No puedes  hacer esto ahora");
    if (JugandoEventoDinamico[playerid] == true) return Notificador2(playerid, "No puedes usar la mascara en estos momentos");
    if (PLAYER_INFO[playerid][varzonasegura] == 1) return Notificador2(playerid, "No puedes usar la mascara en zona segura.");
    if (PLAYER_TEMP[playerid][pt_PLAYER_EVENTODM] == 1) return SendClientMessage(playerid, -1, "No puedes usar en este momento tu mascara.");
    if (PLAYER_INFO[playerid][pTiempoCarcel] > 0 || PLAYER_INFO[playerid][pTiempoJail] > 0) return SendClientMessage(playerid, -1, "No puedes usar la mascara en estos momento.");
    foreach(new c : Player) {
        if (PLAYER_INFO[c][pFaccion] == 1 && PLAYER_INFO[c][pDuty] == 1 && EstaEnP(playerid, c, 20.00)) return SendClientMessage(playerid, -1, "No puedes hacer esto si hay un policia cerca.");
        if (PLAYER_INFO[c][pFaccion] == 2 && PLAYER_INFO[c][pDuty] == 1 && EstaEnP(playerid, c, 20.00)) return SendClientMessage(playerid, -1, "No puedes hacer esto si hay un policia cerca.");

    }
    if (PLAYER_INFO[playerid][pMascara] == 0) return PUSH(playerid, "No tienes una mascara comprala en el mercado negro.");
    if (PLAYER_INFO[playerid][pMascaraPuesta] == 1) {
        PUSH(playerid, "Mascara removida con exito Anonymous.");
        PLAYER_INFO[playerid][pMascaraPuesta] = 0;
        SetPlayerName(playerid, PLAYER_INFO[playerid][Nickname]);
        if (IsPlayerAttachedObjectSlotUsed(playerid, 4)) RemovePlayerAttachedObject(playerid, 4);
        return 1;
    }
    if (PLAYER_INFO[playerid][pMascaraPuesta] == 0) {
        PUSH(playerid, "Mascara puesta con exito Anonymous");
        PLAYER_INFO[playerid][pMascaraPuesta] = 1;
        format(string, sizeof(string), "Desconocido_%d", playerid);
        SetPlayerName(playerid, string);
        if (IsPlayerAttachedObjectSlotUsed(playerid, 4)) RemovePlayerAttachedObject(playerid, 4);
        GiveItem(playerid, 19036, 4);
    }
    return 1;
}
CMD:d(playerid, params[]) {
    new text[128], string[128];
    if (sscanf(params, "s[128]", text)) return SendClientMessage(playerid, -1, "Por favor escribe {"COLOR_GM "}/d texto{FFFFFF}, por ejemplo: {"COLOR_GM "}/d Hola, buen dia.{FFFFFF}.");
    if (GetPlayerDrunkLevel(playerid) > 5000) {
        format(string, sizeof(string), "%s alcoholizado dice: %s", PlayerName(playerid), text);
        if (strlen(string) < 128) ProxDetector(15.0, playerid, string, Hablar, Hablar2, Hablar3, Hablar4, Hablar5);
    } else {
        format(string, sizeof(string), "%s dice: %s", PlayerName(playerid), text);
        if (strlen(string) < 128) ProxDetector(15.0, playerid, string, Hablar, Hablar2, Hablar3, Hablar4, Hablar5);
    }
    DetectarSPAM(playerid, text);
    return 1;
}

//
CMD:b(playerid, params[]) {
    if (!isnull(params)) {
        new string[128];
        format(string, sizeof(string), "%s: (( %s ))", PlayerName(playerid), params);
        if (strlen(string) < 128) ProxDetector(15.0, playerid, string, COLOR_WHITE, COLOR_WHITE, COLOR_WHITE, CHAT, CHAT2);
        DetectarSPAM(playerid, params);
    } else SendClientMessage(playerid, COLOR_WHITE, "Por favor escribe {"COLOR_GM "}/b texto{FFFFFF}, por ejemplo: {"COLOR_GM "}/b ¿que comando era para entrar en las propiedades?{FFFFFF}.");
    return 1;
}

CMD:tunning(playerid) {
    if (!IsPlayerInRangeOfPoint(playerid, 3.5, 1573.0505, -2159.0889, 13.6081)) return PUSH(playerid, "No estas en el lugar adecuado.");
    if (GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, -1, "No estas en nigon vehiculo.");
    if (GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0) return PUSH(playerid, "No estas en el lugar adecuado.");
    new vehicleid = GetPlayerVehicleID(playerid);
    if (vehicleid != autos[playerid] && vehicleid != autos2[playerid] && vehicleid != autos3[playerid] && vehicleid != autos4[playerid] && vehicleid != autos5[playerid]) {
        if (!IsVehicleFaccion(vehicleid, PLAYER_INFO[playerid][pFaccion])) return SendClientMessage(playerid, -1, "Solo puedes modificar tus vehiculos.");
    }
    if (vehicleid == autos[playerid] && PLAYER_INFO[playerid][vID1] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para tunear.");
    if (vehicleid == autos2[playerid] && PLAYER_INFO[playerid][vID2] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para tunear.");
    if (vehicleid == autos3[playerid] && PLAYER_INFO[playerid][vID3] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para tunear.");
    if (vehicleid == autos4[playerid] && PLAYER_INFO[playerid][vID4] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para tunear.");
    if (vehicleid == autos5[playerid] && PLAYER_INFO[playerid][vID5] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para tunear.");
    EnGaraje[playerid] = true;
    TuneandoCoche[playerid] = vehicleid;
    SetVehiclePos(vehicleid, 1573.0505, -2159.0889, 13.6081);
    SetVehicleZAngle(vehicleid, 0.9501);
    PLAYER_TEMP[playerid][p_TUNNING_VEHICLE_ID] = vehicleid;
    SetVehicleVelocity(vehicleid, 0.0, 0.0, 0.0);
    SetVehicleVirtualWorldEx(vehicleid, playerid + MAX_PLAYERS);
    SetPlayerVirtualWorld(playerid, playerid + MAX_PLAYERS);
    GLOBAL_VEHICLES[TuneandoCoche[playerid]][gb_vehicle_PARAMS_ENGINE] = 0;
    UpdateVehicleParams(TuneandoCoche[playerid]);
    SetCameraBehindPlayer(playerid);
    ShowTuning(playerid, DIALOG_VOBJECT_MENU);
    return 1;
}


CMD:g(playerid, params[]) {
    if (!isnull(params)) {
        if (GetPlayerDrunkLevel(playerid) > 5000) {
            new string[128];
            format(string, sizeof(string), "%s grita alcoholizado: ¡%s!", PLAYER_INFO[playerid][Nickname], params);
            if (strlen(string) < 128) ProxDetector(30.0, playerid, string, COLOR_WHITE, COLOR_WHITE, COLOR_WHITE, CHAT, CHAT2);
            format(string, sizeof(string), "¡%s!", params);
            if (strlen(string) < 128) SetPlayerChatBubble(playerid, string, COLOR_WHITE, 60.0, 5000);
        } else {
            new string[128];
            format(string, sizeof(string), "%s grita: ¡%s!", PLAYER_INFO[playerid][Nickname], params);
            if (strlen(string) < 128) ProxDetector(30.0, playerid, string, COLOR_WHITE, COLOR_WHITE, COLOR_WHITE, CHAT, CHAT2);
            format(string, sizeof(string), "¡%s!", params);
            if (strlen(string) < 128) SetPlayerChatBubble(playerid, string, COLOR_WHITE, 60.0, 5000);
        }
        DetectarSPAM(playerid, params);
    } else SendClientMessage(playerid, COLOR_WHITE, "Por favor escribe {"COLOR_GM "}/g texto{FFFFFF}, por ejemplo: {"COLOR_GM "}/g Esperame.");
    return 1;
}
