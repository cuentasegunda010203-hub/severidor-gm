            PLAYER_INFO[playerid][v5A] = z_a5;
            PLAYER_INFO[playerid][pVidaV5] = VidaV5;
            inte = GetVehicleInterior(autos5[playerid]);
            vw = GetVehicleVirtualWorld(autos5[playerid]);
            PLAYER_INFO[playerid][v5interior] = inte;
            PLAYER_INFO[playerid][v5vw] = vw;
            mysql_format(handle_db, Query, sizeof(Query), "UPDATE `p_vehicles` SET `ACELERACION`='%d', `ACTIVE`='%d', `SALTO_V`='%d', `SALTO_V_1`='%d', `SALTO_V_2`='%d',`VE1`='%d',`VE2`='%d',`VE3`='%d',`VE4`='%d',`Combustible`='%d', `Vida`='%f',`X`='%f',`Y`='%f',`Z`='%f',`A`='%f',`Interior`='%d',`VW`='%d' WHERE id ='%d'", PLAYER_INFO[playerid][v5ACELERACION], PLAYER_INFO[playerid][v5ACTIVE], PLAYER_INFO[playerid][v5SALTO_V], PLAYER_INFO[playerid][v5SALTO_V_1], PLAYER_INFO[playerid][v5SALTO_V_2], PLAYER_INFO[playerid][V5E1], PLAYER_INFO[playerid][V5E2], PLAYER_INFO[playerid][V5E3], PLAYER_INFO[playerid][V5E4], PLAYER_INFO[playerid][v5Gas], PLAYER_INFO[playerid][pVidaV5], PLAYER_INFO[playerid][v5X], PLAYER_INFO[playerid][v5Y], PLAYER_INFO[playerid][v5Z], PLAYER_INFO[playerid][v5A], PLAYER_INFO[playerid][v5interior], PLAYER_INFO[playerid][v5vw], PLAYER_INFO[playerid][vID5]);
