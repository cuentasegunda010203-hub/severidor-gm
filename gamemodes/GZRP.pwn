            foreach(new i : Player) { Notificador2(i, "Notificaciones ~b~V2"); }
        }
    }
    return 1;
}
CMD:slots(playerid,params[])
{
	if(PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_DUDAS) return 0;
	{
		new id;
		if(!sscanf(params,"d",id))
		{
			if(id >= MAX_PLAYERS) return SendClientMessage(playerid, -1, "No puedes colocar más de 400 slots disponibles.");
			CambiarSlots(id);
			SendClientMessageEx(playerid, -1, "Ahora el servidor tendrá %d slots disponibles.",id);
		}
	}
    return 1;
}
