static const RP_GuardFields[] = {T_Guarda, T_Guarda2, T_Guarda3, T_Guarda4, T_Guarda5, T_Guarda6};
stock RP_SelectedGuard(playerid)
{
    new slot = PLAYER_TEMP[playerid][GE_Seleccionado];
    if (slot < 0 || slot >= sizeof(RP_GuardFields)) return INVALID_PLAYER_ID;
    new npc = PLAYER_INFO[playerid][RP_GuardFields[slot]];
    if (npc < 0 || npc >= MAX_PLAYERS || !FCNPC_IsValid(npc)) return INVALID_PLAYER_ID;
    if (guardaespaldabot[npc][propietario] != playerid) return INVALID_PLAYER_ID;
    return npc;
}
stock RP_GuardDialog(playerid, dialogid, response, listitem, inputtext[])
{
    switch (dialogid)
    {
        case C_GUARDA, DIALOG_GE_CREAR:
        {
            if (!LoggedYet[playerid]) return 1;
            if (!response) return 1;
            if (RP_ContractExpires(playerid) < gettime() && PLAYER_INFO[playerid][Moneda] < 25)
                return SendClientMessage(playerid, -1, "Necesitas 25 monedas para contratar un guardaespaldas.");
        }
        case C_GUARDA2, DIALOG_GE_CREAR2:
        {
            if (!LoggedYet[playerid] || PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_PROGRAMMER) return 1;
        }
        case G_Disparar, G_Apunta, GUARDA, ARMAS_GE, SKIN_GE, G_AUTO:
        {
            if (!response) return 1;
            if (RP_SelectedGuard(playerid) == INVALID_PLAYER_ID)
                return SendClientMessage(playerid, -1, "Selecciona un guardaespaldas valido con /guardaespaldas.");
            if (dialogid == GUARDA && (listitem < 0 || listitem > 11)) return 1;
            if (dialogid == G_AUTO && (listitem < 0 || listitem >= sizeof(LocalizarID[]))) return 1;
            if (dialogid == G_Disparar || dialogid == G_Apunta)
            {
                new target;
                if (sscanf(inputtext, "i", target) || target < 0 || target >= MAX_PLAYERS || !IsPlayerConnected(target))
                    return SendClientMessage(playerid, -1, "Ingresa un ID de jugador conectado.");
                if (target == playerid || target == RP_SelectedGuard(playerid)) return 1;
                if (GetPlayerInterior(target) != GetPlayerInterior(playerid) || GetPlayerVirtualWorld(target) != GetPlayerVirtualWorld(playerid)) return 1;
            }
            if (dialogid == SKIN_GE && (strval(inputtext) < 0 || strval(inputtext) > 311)) return 1;
            if (dialogid == ARMAS_GE && (strval(inputtext) < 1 || strval(inputtext) > 46)) return 1;
        }
        case D_G_FABRICA: { if (!LoggedYet[playerid]) return 1; }
        default: return 0;
    }
    return RP_GuardDialogOriginal(playerid, dialogid, response, listitem, inputtext);
}
stock RP_ClearGuards(playerid)
{
    for (new slot; slot < sizeof(RP_GuardFields); slot++)
    {
        new npc = PLAYER_INFO[playerid][RP_GuardFields[slot]];
        if (npc >= 0 && npc < MAX_PLAYERS && FCNPC_IsValid(npc) && guardaespaldabot[npc][propietario] == playerid)
        {
            if (IsValidDynamic3DTextLabel(guardaespaldabot[npc][TextGuarda])) DestroyDynamic3DTextLabel(guardaespaldabot[npc][TextGuarda]);
            guardaespaldabot[npc][gExiste] = 0;
            FCNPC_Destroy(npc);
        }
        PLAYER_INFO[playerid][RP_GuardFields[slot]] = -1;
    }
    return 1;
}
forward RP_GuardTick();
public RP_GuardTick()
{
    foreach (new playerid : Player)
    {
        if (LoggedYet[playerid]) {
            for (new slot; slot < sizeof(RP_GuardFields); slot++) {
                new npc = PLAYER_INFO[playerid][RP_GuardFields[slot]];
                if (npc >= 0 && npc < MAX_PLAYERS && FCNPC_IsValid(npc) && PLAYER_TIMES[playerid][RP_GuardTimes[slot]] <= gettime()) {
                    if (IsValidDynamic3DTextLabel(guardaespaldabot[npc][TextGuarda])) DestroyDynamic3DTextLabel(guardaespaldabot[npc][TextGuarda]);
                    guardaespaldabot[npc][gExiste] = 0;
                    PLAYER_INFO[playerid][RP_GuardFields[slot]] = -1;
                    FCNPC_Destroy(npc);
                }
            }
            SeguirGuardaEspaldas(playerid);
        }
    }
    return 1;
}
CMD:guardiasfabrica(playerid)
{
    if (!LoggedYet[playerid] || PLAYER_INFO[playerid][pFaccion] <= 0) return 0;
    SendClientMessage(playerid,-1,"Los negocios ya no usan empleados NPC. Usa /negocio para administrar existencias y caja.");
    return 1;
}
forward RP_TestFCNPC();
public RP_TestFCNPC()
{
    new npc = FCNPC_Create("GZRP_PruebaNPC");
    if (!FCNPC_IsValid(npc)) { print("[RESTAURO] FCNPC: fallo al crear NPC de prueba."); return 0; }
    FCNPC_Spawn(npc, 164, 1412.1326, -1663.7592, 13.5469);
    FCNPC_SetWeapon(npc, 22);
    FCNPC_SetHealth(npc, 250.0);
    FCNPC_GoTo(npc, 1413.1326, -1663.7592, 13.5469);
    printf("[RESTAURO] FCNPC: NPC %d creado, armado y movimiento solicitado.", npc);
    FCNPC_Destroy(npc);
    return 1;
}

function CreateNPCP(playerid, id, name[])
{
    if (!LoggedYet[playerid] || id < 0 || id >= sizeof(RP_GuardFields)) return 0;
    if (PLAYER_INFO[playerid][RP_GuardFields[id]] >= 0 && FCNPC_IsValid(PLAYER_INFO[playerid][RP_GuardFields[id]])) return 0;
    new expires;
    for (new slot; slot < sizeof(RP_GuardTimes); slot++) if (PLAYER_TIMES[playerid][RP_GuardTimes[slot]] > expires) expires = PLAYER_TIMES[playerid][RP_GuardTimes[slot]];
    new bool:newContract = expires <= gettime();
    if (newContract && PLAYER_INFO[playerid][Moneda] < 25) return SendClientMessage(playerid, -1, "Necesitas 25 monedas para contratar.");
    CreateNPCPOriginal(playerid, id, name);
    new npc = PLAYER_INFO[playerid][RP_GuardFields[id]];
    if (npc < 0 || !FCNPC_IsValid(npc)) return 0;
    if (newContract)
    {
        PLAYER_INFO[playerid][Moneda] -= 25;
        expires = gettime() + 43200;
        new query[144];
        mysql_format(handle_db, query, sizeof(query), "UPDATE usuarios SET Moneda=%d WHERE ID=%d", PLAYER_INFO[playerid][Moneda], PLAYER_INFO[playerid][pID]);
        mysql_tquery(handle_db, query);
    }
    PLAYER_TIMES[playerid][RP_GuardTimes[id]] = expires;
    return 1;
}
stock RP_ContractExpires(playerid)
{
    new expires;
    for (new slot; slot < sizeof(RP_GuardTimes); slot++) if (PLAYER_TIMES[playerid][RP_GuardTimes[slot]] > expires) expires = PLAYER_TIMES[playerid][RP_GuardTimes[slot]];
    return expires;
}
