stock RP_ConstructionSlot(playerid) {
    if (PLAYER_INFO[playerid][pTrabajo] == T_Albanil) return 0;
    if (PLAYER_INFO[playerid][pTrabajo2] == T_Albanil) return 1;
    if (PLAYER_INFO[playerid][pTrabajo] == T_Ninguno) return 0;
    if (PLAYER_INFO[playerid][pTrabajo2] == T_Ninguno && PLAYER_INFO[playerid][pVip] >= 2) return 1;
    return -1;
}
stock RP_SaveConstructionJobs(playerid) {
    new query[256];
    mysql_format(handle_db, query, sizeof(query), "UPDATE usuarios SET Trabajo=%d,Trabajo2=%d WHERE Username='%e'", PLAYER_INFO[playerid][pTrabajo], PLAYER_INFO[playerid][pTrabajo2], PLAYER_INFO[playerid][Nickname]);
    mysql_tquery(handle_db, query);
    return 1;
}
stock RP_ClearConstructionDelivery(playerid) {
    if (IsValidDynamicPickup(RP_ConstructionPickup[playerid])) DestroyDynamicPickup(RP_ConstructionPickup[playerid]);
    if (IsValidDynamic3DTextLabel(RP_ConstructionLabel[playerid])) DestroyDynamic3DTextLabel(RP_ConstructionLabel[playerid]);
    if (IsValidDynamicMapIcon(RP_ConstructionIcon[playerid])) DestroyDynamicMapIcon(RP_ConstructionIcon[playerid]);
    RP_ConstructionPickup[playerid] = INVALID_STREAMER_ID;
    RP_ConstructionLabel[playerid] = Text3D:INVALID_STREAMER_ID;
    RP_ConstructionIcon[playerid] = INVALID_STREAMER_ID;
    RP_ConstructionTarget[playerid] = -1;
    if (Mescla[playerid]) {
        RemovePlayerAttachedObject(playerid, 4);
        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
        ClearAnimations(playerid);
        SacarAnimF(playerid);
    }
    Mescla[playerid] = 0;
    return 1;
}
stock RP_StopConstruction(playerid) {
    RP_ClearConstructionDelivery(playerid);
    if (JugadorEnAlbanil[playerid]) {
        RemovePlayerAttachedObject(playerid, 2);
        RemovePlayerAttachedObject(playerid, 3);
    }
    JugadorEnAlbanil[playerid] = 0;
    return 1;
}
stock RP_ResignConstruction(playerid) {
    RP_StopConstruction(playerid);
    if (PLAYER_INFO[playerid][pTrabajo] == T_Albanil) PLAYER_INFO[playerid][pTrabajo] = T_Ninguno;
    if (PLAYER_INFO[playerid][pTrabajo2] == T_Albanil) PLAYER_INFO[playerid][pTrabajo2] = T_Ninguno;
    RP_SaveConstructionJobs(playerid);
    UpdateEstadisticas(playerid);
    return SendClientMessage(playerid, -1, "Has abandonado el trabajo de Obrero.");
}
stock RP_StartConstruction(playerid) {
    if (!JugadorLogeado[playerid] || PLAYER_INFO[playerid][pTiempoCarcel] != 0) return 0;
    if (GetPlayerVirtualWorld(playerid) != 0 || GetPlayerInterior(playerid) != 0 || !IsPlayerInRangeOfPoint(playerid, 2.0, 1960.5045, -1318.6222, 23.5397)) return 0;
    if (IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, "Debes estar a pie para trabajar como obrero.");
    if (PLAYER_INFO[playerid][pDuty] > 0) return SendClientMessage(playerid, -1, "No puedes obtener este trabajo estando de servicio.");
    new slot = RP_ConstructionSlot(playerid);
    if (slot < 0) {
        if (PLAYER_INFO[playerid][pTrabajo2] != T_Ninguno) return YaTiene2Jobs(playerid);
        return NoPuedeTrabajo(playerid);
    }
    if (PLAYER_INFO[playerid][pTrabajo] != T_Albanil && PLAYER_INFO[playerid][pTrabajo2] != T_Albanil) {
        AsignarTrabajo(playerid, T_Albanil, slot);
        RP_SaveConstructionJobs(playerid);
    }
    UpdateEstadisticas(playerid);
    return SendClientMessage(playerid, -1, "Contrato de Obrero registrado en /est. Ve al vestuario y pulsa Y para ponerte el uniforme. Consulta /ayuda trabajos.");
}
stock RP_ToggleConstructionUniform(playerid) {
    if (!JugadorLogeado[playerid] || PLAYER_INFO[playerid][pTiempoCarcel] != 0) return 0;
    if (GetPlayerVirtualWorld(playerid) != 0 || GetPlayerInterior(playerid) != 0 || !IsPlayerInRangeOfPoint(playerid, 2.0, 1956.3177, -1326.8419, 22.3482)) return 0;
    if (IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, "Debes estar a pie para usar el vestuario.");
    if (PLAYER_INFO[playerid][pTrabajo] != T_Albanil && PLAYER_INFO[playerid][pTrabajo2] != T_Albanil) return SendClientMessage(playerid, -1, "Necesitas el trabajo de Obrero. Contratate primero en la oficina.");
    if (JugadorEnAlbanil[playerid]) {
        RP_StopConstruction(playerid);
        return SendClientMessage(playerid, -1, "Te quitaste el uniforme de obrero. Tu empleo sigue registrado en /est.");
    }
    if (PLAYER_INFO[playerid][pDuty] > 0 || RopaMedi[playerid] || RopaBasu[playerid] || RopaMeca[playerid] || RopaMine[playerid]) return SendClientMessage(playerid, -1, "Termina tu servicio o quitate el otro uniforme antes de vestir como obrero.");
    RP_ClearConstructionDelivery(playerid);
    JugadorEnAlbanil[playerid] = 1;
    SetPlayerAttachedObject(playerid, 2, 18638, 2, 0.165000, 0.042999, -0.000999, 0.000000, 0.000000, 0.000000, 1.000000, 1.053000, 1.068000);
    SetPlayerAttachedObject(playerid, 3, 19904, 17, -0.241999, 0.119000, 0.000000, -86.900001, 106.200050, -89.200027, 1.000000, 1.110000, 1.121000);
    return SendClientMessage(playerid, -1, "Uniforme de obrero colocado. Recoge mezcla con Y y sigue la marca azul y la flecha de entrega.");
}
stock RP_SetConstructionDelivery(playerid, point) {
    if (point < 0 || point >= sizeof RP_ConstructionPoints) return 0;
    RP_ClearConstructionDelivery(playerid);
    new Float:x = RP_ConstructionPoints[point][0], Float:y = RP_ConstructionPoints[point][1], Float:z = RP_ConstructionPoints[point][2];
    new text[192];
    format(text, sizeof(text), "{3399FF}Entrega de mezcla - Piso %d\n{FFFFFF}Pulsa {3399FF}'Y'{FFFFFF} para entregar el balde", RP_ConstructionFloors[point]);
    RP_ConstructionPickup[playerid] = CreateDynamicPickup(1318, 1, x, y, z, 0, 0, playerid, 150.0);
    RP_ConstructionLabel[playerid] = CreateDynamic3DTextLabel(text, COLORWHITE1, x, y, z + 0.5, 40.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0, playerid, 150.0);
    RP_ConstructionIcon[playerid] = CreateDynamicMapIcon(x, y, z, 0, 0x3399FFFF, 0, 0, playerid, 1000.0, MAPICON_GLOBAL);
    if (!IsValidDynamicPickup(RP_ConstructionPickup[playerid]) || !IsValidDynamic3DTextLabel(RP_ConstructionLabel[playerid]) || !IsValidDynamicMapIcon(RP_ConstructionIcon[playerid])) {
        RP_ClearConstructionDelivery(playerid);
        return 0;
    }
    RP_ConstructionTarget[playerid] = point;
    return 1;
}
stock RP_HandleConstructionMaterial(playerid) {
    if (!JugadorEnAlbanil[playerid] || (PLAYER_INFO[playerid][pTrabajo] != T_Albanil && PLAYER_INFO[playerid][pTrabajo2] != T_Albanil)) return 0;
    if (GetPlayerVirtualWorld(playerid) != 0 || GetPlayerInterior(playerid) != 0 || IsPlayerInAnyVehicle(playerid)) return 0;
    if (!Mescla[playerid] && IsPlayerInRangeOfPoint(playerid, 2.0, 1925.7717, -1320.3131, 18.4147)) {
        new point = random(sizeof RP_ConstructionPoints);
        if (!RP_SetConstructionDelivery(playerid, point)) return SendClientMessage(playerid, -1, "No se pudo marcar la entrega. Vuelve a recoger mezcla.");
        Mescla[playerid] = 1;
        ClearAnimations(playerid);
        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
        SetPlayerAttachedObject(playerid, 4, 1329, 1, 0.20, 0.36, 0.0, 0.0, 90.0, 0.0, 0.4, 0.3, 0.6);
        new message[160];
        format(message, sizeof(message), "Entrega la mezcla en el piso %d: sigue la marca azul, sube por el elevador y pulsa Y junto a la flecha de entrega.", RP_ConstructionFloors[point]);
        SendClientMessage(playerid, -1, message);
        return 1;
    }
    new point = RP_ConstructionTarget[playerid];
    if (Mescla[playerid] && point >= 0 && point < sizeof RP_ConstructionPoints && IsPlayerInRangeOfPoint(playerid, 2.0, RP_ConstructionPoints[point][0], RP_ConstructionPoints[point][1], RP_ConstructionPoints[point][2])) {
        Constructor[playerid]++;
        if (point >= 2) DarDinero(playerid, 430);
        MezclaEntregada(playerid);
        RP_ClearConstructionDelivery(playerid);
        return SendClientMessage(playerid, -1, "Mezcla entregada. Vuelve al deposito y pulsa Y para recoger otro balde.");
    }
    return 0;
}
stock RP_ShowConstructionHelp(playerid) {
    new help[1000];
    strcat(help, "{FFFFFF}1. Usa /gps y elige Trabajo Obrero. En la oficina pulsa {3399FF}Y{FFFFFF} y firma el contrato.\n");
    strcat(help, "2. Tu empleo aparece como {3399FF}Obrero{FFFFFF} en /est. Ve al vestuario y pulsa Y para ponerte el uniforme.\n");
    strcat(help, "3. Recoge mezcla pulsando {3399FF}Y{FFFFFF} junto al deposito.\n");
    strcat(help, "4. Sigue la marca azul del mapa. El mensaje y el texto indican el piso de entrega. Sube por el elevador.\n");
    strcat(help, "5. Acercate a la flecha de entrega y pulsa {3399FF}Y{FFFFFF}. Recibiras tu paga y podras recoger otro balde.\n\n");
    strcat(help, "Para renunciar usa {3399FF}/dejar trabajo{FFFFFF} y escribe el comando indicado para Obrero. Tambien puedes renunciar en la oficina con Y.\n");
    strcat(help, "Al morir o desconectarte se cancela el balde. Conservas el empleo; vuelve al vestuario y pulsa Y para empezar otro turno.\n");
    return dialogs_ShowPlayerDialog(playerid, INFOMEDICO, DIALOG_STYLE_MSGBOX, "Ayuda - Trabajo de Obrero", help, "Aceptar", "");
}

