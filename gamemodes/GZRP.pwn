            mysql_tquery(handle_db, Query);
            mysql_format(handle_db, Query, sizeof(Query), "UPDATE `p_vehicles` SET `Componentes8`='%d',`Componentes9`='%d',`Componentes10`='%d',`Componentes11`='%d',`Componentes12`='%d',`Componentes13`='%d',`Componentes0`='%d' WHERE id = '%d'", PLAYER_INFO[playerid][v2Componentes8], PLAYER_INFO[playerid][v2Componentes9], PLAYER_INFO[playerid][v2Componentes10], PLAYER_INFO[playerid][v2Componentes11], PLAYER_INFO[playerid][v2Componentes12], PLAYER_INFO[playerid][v2Componentes13], PLAYER_INFO[playerid][v2Componentes0], PLAYER_INFO[playerid][vID2]);
            mysql_tquery(handle_db, Query);
            mysql_format(handle_db, Query, sizeof(Query), "UPDATE `p_vehicles` SET `Color1`='%d',`Color2`='%d' WHERE id = '%d'", color_1, color_2, PLAYER_INFO[playerid][vID2]);
            mysql_tquery(handle_db, Query);
        } else if (IsPlayerInVehicle(playerid, autos3[playerid])) {

            GetVehicleColor(autos3[playerid], color_1, color_2);
