    format(string, 200, "{3399FF}[Central de policia]{FFFFFF} Romina: Hola, %s (%d) esta llamando al 911.", PLAYER_INFO[playerid][Nickname], playerid);
    SendRadioMessage(1, -1, string, INVALID_PLAYER_ID, 1);
