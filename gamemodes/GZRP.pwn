        SendRconCommand("language "RP_SERVER_LANGUAGE);
    // RCON se conserva desde server.cfg.
        SendRconCommand("password 0");
    }
		#else
    {
        SendRconCommand("hostname "RP_SERVER_HOSTNAME);
        SetGameModeText(RP_SERVER_MODE);
        SendRconCommand("mapname San Andreas");
        SendRconCommand("weburl "    WEB_ROL "");
        SendRconCommand("language "RP_SERVER_LANGUAGE);
    // RCON se conserva desde server.cfg.
        SendRconCommand("password 0");
