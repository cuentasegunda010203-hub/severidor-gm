                CopObjectData[id][ObjLabel] = CreateDynamic3DTextLabel(stringXZ, 0x3498DBFF, x, y, z - 0.4, 3.0, _, _, _, CopObjectData[id][ObjVirtualWorld], CopObjectData[id][ObjInterior]);
