                CamionCargado[CamionID[playerid]] = 3;
                Chofer[CamionID[playerid]] = playerid;
                Carga[playerid] = 3;
                PLAYER_TEMP[playerid][pt_Camionero] = true;
                HidePlayerProgressBar(playerid, Progressbar[playerid][Camionero]);
