// Acceso de la cueva ubicado con /save del cliente, 5 octubre 2026.
// Usa el interior minero existente; conserva el regreso por el acceso utilizado.
stock RP_TryMineTransition(playerid) {
    if (!IsPlayerConnected(playerid) || IsPlayerNPC(playerid)) return 0;
    new bool:diablo = GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0 && IsPlayerInRangeOfPoint(playerid, 2.0, -611.3066, 2325.3142, 79.5825);
    new bool:colinas = GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0 && IsPlayerInRangeOfPoint(playerid, 2.0, 2358.5374, -650.5816, 128.0505);
    new bool:salida = GetPlayerInterior(playerid) == 9 && GetPlayerVirtualWorld(playerid) == 9 && IsPlayerInRangeOfPoint(playerid, 2.0, -690.5643, -1746.8252, 801.0569);
    if (!diablo && !colinas && !salida) return 0;
    if (!JugadorLogeado[playerid] || PLAYER_INFO[playerid][pTiempoCarcel] > 0) return 1;
    if (GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) {
        SendClientMessage(playerid, -1, "Tienes que estar a pie para acceder a la mina.");
        return 1;
    }
    if (salida) {
        new bool:volverDiablo = RP_MineReturnDiablo[playerid];
        RP_MineReturnDiablo[playerid] = false;
        RopaMine[playerid] = 0;
        RemovePlayerAttachedObject(playerid, 1);
        RemovePlayerAttachedObject(playerid, 2);
        RemovePlayerAttachedObject(playerid, 3);
        if (volverDiablo) SetPosEx(playerid, -611.3066, 2325.3142, 79.5825, 120.7415, 0, 0);
        else SetPosEx(playerid, 2358.5374, -650.5816, 128.0505, 307.3289, 0, 0);
        return 1;
    }
    if (PLAYER_INFO[playerid][pTrabajo] != T_Minero && PLAYER_INFO[playerid][pTrabajo2] != T_Minero) {
        SendClientMessage(playerid, -1, "Necesitas el trabajo de minero para poder ingresar a la mina.");
        return 1;
    }
    if (GetPlayerSkin(playerid) != 27 && GetPlayerSkin(playerid) != 131) {
        SendClientMessage(playerid, -1, "Necesitas la ropa de minero para poder ingresar a la mina.");
        return 1;
    }
    if (Armados(playerid) && PLAYER_INFO[playerid][pDuty] != 1) {
        SendClientMessage(playerid, -1, "No puedes entrar armado a la mina.");
        return 1;
    }
    RP_MineReturnDiablo[playerid] = diablo;
    SetPosEx(playerid, -690.5643, -1746.8252, 801.0569, 192.4327, 9, 9);
    return 1;
}
