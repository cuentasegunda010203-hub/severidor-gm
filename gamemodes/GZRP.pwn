CMD:escapar(playerid, params[]) {
    new escapar = 0;
    if (IsPlayerInRangeOfPoint(playerid, 2.5, -2278.8904, -10.3138, 38.2993)) escapar = 1;
    if (IsPlayerInRangeOfPoint(playerid, 2.5, 932.2437, 1975.8787, 11.6227)) escapar = 2;
    if (IsPlayerInRangeOfPoint(playerid, 2.5, -2396.0010, -13.0565, 35.3486)) escapar = 3;
    if (IsPlayerInRangeOfPoint(playerid, 2.5, 2373.7302, -1136.8610, 30.0583)) escapar = 4;
    if (IsPlayerInRangeOfPoint(playerid, 2.5, -2730.4609, -155.6674, 7.2174)) escapar = 5;
    if (IsPlayerInRangeOfPoint(playerid, 2.5, 2485.0527, -1995.0458, 14.0434)) escapar = 7;
    if (IsPlayerInRangeOfPoint(playerid, 2.5, -1449.7598, 2647.9287, 56.5345)) escapar = 8;
    if (IsPlayerInRangeOfPoint(playerid, 2.5, 1762.7701, -2098.9631, 13.9989)) escapar = 9;
    if (IsPlayerInRangeOfPoint(playerid, 2.5, 1841.8738, 770.7863, 11.5959)) escapar = 10;
    if (IsPlayerInRangeOfPoint(playerid, 2.5, 1344.4647, 2612.5925, 11.5559)) escapar = 11;
    if (IsPlayerInRangeOfPoint(playerid, 2.5, 1666.9180, 2612.6965, 11.5559)) escapar = 12;
    if (IsPlayerInRangeOfPoint(playerid, 2.5, -2729.9800, -50.8513, 7.0453)) escapar = 13;
    if (escapar > 0) {
        NoTeleportHack(playerid);
        if (Objeto[playerid] > 0) {
            AccionesRol(playerid, "dejo un objeto en el suelo.", 20);
            SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
            RemovePlayerAttachedObject(playerid, 4);
            Objeto[playerid] = 0;
        }
        switch (escapar) {
            case 1 : SetPlayerPos(playerid, -2277.1763, -9.9763, 38.2523);
            case 2 : SetPlayerPos(playerid, 931.9277, 1973.0038, 11.3073);
            case 3 : SetPlayerPos(playerid, -2393.9712, -13.1641, 35.3125);
            case 4 : SetPlayerPos(playerid, 2373.8467, -1139.5442, 30.0510);
            case 5 : SetPlayerPos(playerid, -2727.5054, -155.6168, 7.2009);
            case 7 : SetPlayerPos(playerid, 2481.2834, -1997.9987, 13.5469);
            case 8 : SetPlayerPos(playerid, -1448.9193, 2647.9514, 56.4912);
            case 9 : SetPlayerPos(playerid, 1762.8772, -2101.1462, 13.9916);
            case 10 : SetPlayerPos(playerid, 1844.5101, 770.9579, 11.4838);
            case 11 : SetPlayerPos(playerid, 1344.6938, 2610.3264, 11.5494);
            case 12 : SetPlayerPos(playerid, 1667.0402, 2610.3267, 11.5494);
            case 13 : SetPlayerPos(playerid, -2727.9619, -51.2697, 7.0297);
        }
        SendClientMessage(playerid, -1, "{00CC00}Lograste salir{FFFFFF} de la casa, escapa de la zona.");
    } else if (IsPlayerInRangeOfPoint(playerid, 2.0, 994.2881, -1169.8217, 12.7304)) // ROBO BANCO
    {
        Congelar(playerid);
        SendClientMessage(playerid, COLOR_RED, "Has comenzado ha subir espera 1 minuto.");
        GameTextForPlayerEx(playerid, "~r~Subiendo...", 60000, 3);
        new string[256];
        format(string, sizeof(string), "* %s toma una soga y la apoya hacia rejilla seguidamente sube por el ducto de ventilacion", PLAYER_INFO[playerid][Nickname]);
        ProxDetector(15.0, playerid, string, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES);
        SetTimerEx("TimerESCAPE", 60000, false, "d", playerid);
        ApplyAnimation(playerid, "ped", "abseil", 4.0, 0, 0, 0, 1, 0);
    }
    return 1;
}
stock RP_ReviewCargoTruck(playerid, vehicleid = INVALID_VEHICLE_ID) {
    if (PLAYER_INFO[playerid][pDuty] != 1) return SendClientMessage(playerid, -1, "Debes estar de servicio para revisar camiones.");
    if (vehicleid != INVALID_VEHICLE_ID && (!IsValidVehicle(vehicleid) || !CAMION(vehicleid)))
        return SendClientMessage(playerid, -1, "ID de camion no valido.");
    new encontrados, Float:pos[3], choferNombre[MAX_PLAYER_NAME + 1], mensaje[256];
    for (new veh = 1; veh <= GetVehiclePoolSize(); veh++) {
        if (vehicleid != INVALID_VEHICLE_ID && veh != vehicleid) continue;
        if (!IsValidVehicle(veh) || !CAMION(veh)) continue;
        if (GetVehicleVirtualWorld(veh) != GetPlayerVirtualWorld(playerid) || GetPlayerInterior(playerid) != 0) continue;
        GetVehiclePos(veh, pos[0], pos[1], pos[2]);
        if (!IsPlayerInRangeOfPoint(playerid, 10.0, pos[0], pos[1], pos[2])) continue;
        format(choferNombre, sizeof choferNombre, "Sin chofer");
        new chofer = Chofer[veh];
        if (chofer >= 0 && chofer < MAX_PLAYERS && IsPlayerConnected(chofer) && GetPlayerVehicleID(chofer) == veh && GetPlayerState(chofer) == PLAYER_STATE_DRIVER)
            format(choferNombre, sizeof choferNombre, "%s", PLAYER_INFO[chofer][Nickname]);
        format(mensaje, sizeof mensaje, "Camion ID: {00CC00}%d{FFFFFF} | Contenido: {00CC00}%s{FFFFFF} | Chofer: {00CC00}%s", veh, GetContenido(veh), choferNombre);
        SendClientMessage(playerid, -1, mensaje);
        encontrados++;
    }
    if (!encontrados) SendClientMessage(playerid, -1, "No hay camiones de carga a menos de 10 metros.");
    return 1;
}
CMD:revisar(playerid, params[]) {
    new opcion[32], camionid;
    if (!sscanf(params, "s[32]", opcion) && !strcmp(opcion, "camion", true)) {
        if (sscanf(params, "s[32]d", opcion, camionid)) camionid = INVALID_VEHICLE_ID;
        return RP_ReviewCargoTruck(playerid, camionid);
    }
    new Float:Pos[3], autoid, string[256], texto[10], id;
    if (!sscanf(params, "s[10]d", texto, id)) {
        if (strcmp(texto, "paciente", true) == 0) {
            if (!IsABombero(playerid)) return ShowPlayerMessage(playerid, "~r~No perteneces a San Andreas Fire Departament");
            //if(PLAYER_INFO[playerid][pTrabajo] != T_Medico && PLAYER_INFO[playerid][pTrabajo2] != T_Medico) return SendClientMessage(playerid,-1,"Necesitas el trabajo de Medico para utilizar este comando");
            if (id < 0 || id >= MAX_PLAYERS || !IsPlayerConnected(id) || IsPlayerNPC(id)) return SendClientMessage(playerid, -1, "Paciente no conectado.");
            if (RopaMedi[playerid] > 0) {
                if (PLAYER_INFO[id][pEnfermedad] == 0) return 1;
                if (PLAYER_INFO[id][pAtendido] == 1) return SendClientMessage(playerid, -1, "El paciente ya fue atendido.");
                new enfermedad[32];
                GetPlayerPos(id, Pos[0], Pos[1], Pos[2]);
                switch (PLAYER_INFO[id][pEnfermedad]) {
                    case 1 : enfermedad = "Herida de bala";
                    case 2 : enfermedad = "Multiples heridas de bala";
                    case 3 : enfermedad = "Fracturas Graves";
                    case 4 : enfermedad = "Fracturas leves";
                    case 5 : enfermedad = "Herida abierta de sangre";
                    case 6 : enfermedad = "Hematomas";
                    case 7 : enfermedad = "Hematomas y huesos fracturados";
                    case 8 : enfermedad = "Hemorragia cerebral";
                    case 9 : enfermedad = "Quemaduras";
                    case 10 : enfermedad = "Daños severos";
                }
                if (EstaEn(playerid, 2.0, Pos[0], Pos[1], Pos[2])) {
                    format(string, sizeof(string), "El paciente presenta %s.", enfermedad);
                    SendClientMessage(playerid, -1, string);
                    format(string, sizeof(string), "%s observa al paciente y procede a revisarlo.", NombreJugador(playerid));
                    ProxDetector(15.0, playerid, string, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO);
                }
            } else return SendClientMessage(playerid, -1, "Necesitas tener la ropa de medico para utilizar este comando.");
        }
    } else {
        if (PLAYER_INFO[playerid][pTrabajo] != T_Mecanico && PLAYER_INFO[playerid][pTrabajo2] != T_Mecanico) return SendClientMessage(playerid, -1, "Necesitas el trabajo de mecanico para revisar motores de vehiculos."); {
            if (RopaMeca[playerid] == 0 && PLAYER_INFO[playerid][pVip] == 0) return SendClientMessage(playerid, -1, "Necesitar usar la ropa de mecanico para poder reparar un vehiculo.");
            foreach(new i : Player) {
                if (LlamadaMeca[i] == 1 && IsPlayerInAnyVehicle(i)) {
                    GetPlayerPos(i, Pos[0], Pos[1], Pos[2]);
                    if (IsPlayerInRangeOfPoint(playerid, 7.0, Pos[0], Pos[1], Pos[2])) {
                        autoid = GetPlayerVehicleID(i);
                        if (Capo[autoid] != 1) return SendClientMessage(playerid, -1, "El capo del vehiculo debe estar abierto"); {
                            if (autoid <= AUTOS) {
                                SendClientMessage(playerid, -1, "El vehiculo necesita {00CC00}0{FFFFFF} repuestos.");
                                MRepuestos[playerid] = 0;
                                return 1;
                            } else {
                                foreach(new u : Player) {
                                    if (autos[u] == autoid) {
                                        new repuestos = PLAYER_INFO[u][vPrecio] / 5000;
                                        format(string, 256, "Este vehiculo necesita {00CC00}%d{FFFFFF} repuestos.", repuestos);
                                        SendClientMessage(playerid, -1, string);
                                        MRepuestos[playerid] = repuestos;
                                        return 1;
                                    }
                                    if (autos2[u] == autoid) {
                                        new repuestos = PLAYER_INFO[u][v2Precio] / 5000;
                                        format(string, 256, "Este vehiculo necesita {00CC00}%d{FFFFFF} repuestos.", repuestos);
                                        SendClientMessage(playerid, -1, string);
                                        MRepuestos[playerid] = repuestos;
                                        return 1;
                                    }
                                    if (autos3[u] == autoid) {
                                        new repuestos = PLAYER_INFO[u][v3Precio] / 5000;
                                        format(string, 256, "Este vehiculo necesita {00CC00}%d{FFFFFF} repuestos.", repuestos);
                                        SendClientMessage(playerid, -1, string);
                                        MRepuestos[playerid] = repuestos;
                                        return 1;
                                    }
                                    if (autos4[u] == autoid) {
                                        new repuestos = PLAYER_INFO[u][v4Precio] / 5000;
                                        format(string, 256, "Este vehiculo necesita {00CC00}%d{FFFFFF} repuestos.", repuestos);
                                        SendClientMessage(playerid, -1, string);
                                        MRepuestos[playerid] = repuestos;
                                        return 1;
                                    }
                                    if (autos5[u] == autoid) {
                                        new repuestos = PLAYER_INFO[u][v5Precio] / 5000;
                                        format(string, 256, "Este vehiculo necesita {00CC00}%d{FFFFFF} repuestos.", repuestos);
                                        SendClientMessage(playerid, -1, string);
                                        MRepuestos[playerid] = repuestos;
                                        return 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return 1;
}
CMD:reparar(playerid, params[]) {
    if (TimerCombustible[playerid] > 0) return SendClientMessageEx(playerid, -1, "Para usar este comando debes esperar %d segundos.", TimerCombustible[playerid]);
    new Float:Pos[3], autoid = GetPlayerVehicleID(playerid), precio, item[13], repuestos = 0;
    if (sscanf(params, "s[13]", item)) {
        if (!IsPlayerInAnyVehicle(playerid)) return true;
        if (PLAYER_INFO[playerid][pTrabajo] != T_Mecanico && PLAYER_INFO[playerid][pTrabajo2] != T_Mecanico) return SendClientMessage(playerid, -1, "Debes ser mecanico para utilizar este comando");
        if (autoid == autos[playerid]) repuestos = PLAYER_INFO[playerid][vPrecio] / 5000;
        else if (autoid == autos2[playerid]) repuestos = PLAYER_INFO[playerid][v2Precio] / 5000;
        else if (autoid == autos3[playerid]) repuestos = PLAYER_INFO[playerid][v3Precio] / 5000;
        else if (autoid == autos4[playerid]) repuestos = PLAYER_INFO[playerid][v4Precio] / 5000;
        else if (autoid == autos5[playerid]) repuestos = PLAYER_INFO[playerid][v5Precio] / 5000;
        else {
            for(new i = 0; i <= GetPlayerPoolSize(); i++) {
                if (autoid == autos[i]) repuestos = PLAYER_INFO[i][vPrecio] / 5000;
                else if (autoid == autos2[i]) repuestos = PLAYER_INFO[i][v2Precio] / 5000;
                else if (autoid == autos3[i]) repuestos = PLAYER_INFO[i][v3Precio] / 5000;
                else if (autoid == autos4[i]) repuestos = PLAYER_INFO[i][v4Precio] / 5000;
                else if (autoid == autos5[i]) repuestos = PLAYER_INFO[i][v5Precio] / 5000;
            }
        }
        if (PLAYER_INFO[playerid][Repuestos] < repuestos) return MensajeEx(playerid, -1, "Necesitas {FF0000}%d{FFFFFF} repuestos para reparar este vehiculo.", repuestos);
        Congelar(playerid);
        switch (PLAYER_INFO[playerid][pNivelMecanico]) {
            case 1:
                PLAYER_TIMES[playerid][TiempoAntiAB] = 17, SetTimerEx("Reparando", 15000, false, "dddd", playerid, playerid, GetPlayerVehicleID(playerid), 0), LoopingAnim(playerid, "CAR", "Fixn_Car_Loop", 1, 4, 0, 0, 1, 17000);
            case 2:
                PLAYER_TIMES[playerid][TiempoAntiAB] = 15, SetTimerEx("Reparando", 13000, false, "dddd", playerid, playerid, GetPlayerVehicleID(playerid), 0), LoopingAnim(playerid, "CAR", "Fixn_Car_Loop", 1, 4, 0, 0, 1, 15000);
            case 3 : PLAYER_TIMES[playerid][TiempoAntiAB] = 11, SetTimerEx("Reparando", 9000, false, "dddd", playerid, playerid, GetPlayerVehicleID(playerid), 0), LoopingAnim(playerid, "CAR", "Fixn_Car_Loop", 1, 4, 0, 0, 1, 11000);
            case 4 : PLAYER_TIMES[playerid][TiempoAntiAB] = 8, SetTimerEx("Reparando", 6000, false, "dddd", playerid, playerid, GetPlayerVehicleID(playerid), 0), LoopingAnim(playerid, "CAR", "Fixn_Car_Loop", 1, 4, 0, 0, 1, 8000);
            default: PLAYER_TIMES[playerid][TiempoAntiAB] = 5, SetTimerEx("Reparando", 3000, false, "dddd", playerid, playerid, GetPlayerVehicleID(playerid), 0), LoopingAnim(playerid, "CAR", "Fixn_Car_Loop", 1, 4, 0, 0, 1, 5000);
        }
        TimerReparar[playerid] = 10;
        AceptoRepara[playerid] = 1;
        AccionesRol(playerid, "comienza a reparar el vehiculo.", 20);
        return true;
    }
    if (!sscanf(params, "d", precio)) {
        if (precio < 0) return SendClientMessage(playerid, -1, "Monto invalido.");
        if (precio > 1000) return SendClientMessage(playerid, -1, "Monto invalido.");
        if (RopaMeca[playerid] == 0 && PLAYER_INFO[playerid][pVip] == 0) return SendClientMessage(playerid, -1, "Necesitar usar la ropa de mecanico para poder reparar un vehiculo.");
        if (PLAYER_INFO[playerid][pTrabajo] == T_Mecanico || PLAYER_INFO[playerid][pTrabajo2] == T_Mecanico) {
            for(new i, j = GetPlayerPoolSize(); i <= j; i++) {
                if (LlamadaMeca[i] == 1 && IsPlayerInAnyVehicle(i)) {
                    GetPlayerPos(i, Pos[0], Pos[1], Pos[2]);
                    if (IsPlayerInRangeOfPoint(playerid, 7.0, Pos[0], Pos[1], Pos[2])) {
                        autoid = GetPlayerVehicleID(i);
                        if (Capo[autoid] == 1) {
                            for(new u = 0; u <= GetPlayerPoolSize(); u++) {
                                if (autoid == autos[u]) {
                                    if (PLAYER_INFO[playerid][Repuestos] >= MRepuestos[playerid]) {
                                        MensajeEx(i, -1, "El mecanico %s te ofrece reparar el vehiculo por {2BFF00}$%s{FFFFFF}.", PLAYER_INFO[playerid][Nickname], Numeros(precio));
                                        SendClientMessage(i, -1, "Para aceptar la reparacion usa {FFFF00}/aceptar reparacion");
                                        MensajeEx(playerid, -1, "Le ofreciste una reparacion a %s por {2BFF00}$%s{FFFFFF}.", PLAYER_INFO[i][Nickname], Numeros(precio));
                                        Mecanico[i] = playerid;
                                        MConductor[i] = precio;
                                        return 1;
                                    } else return SendClientMessage(playerid, -1, "No tienes suficientes repuestos para reparar el motor de este vehiculo.");
                                } else if (autoid == autos2[u]) {
                                    if (PLAYER_INFO[playerid][Repuestos] >= MRepuestos[playerid]) {
                                        MensajeEx(i, -1, "El mecanico %s te ofrece reparar el vehiculo por {2BFF00}$%s{FFFFFF}.", PLAYER_INFO[playerid][Nickname], Numeros(precio));
                                        SendClientMessage(i, -1, "Para aceptar la reparacion usa {FFFF00}/aceptar reparacion");
                                        MensajeEx(playerid, -1, "Le ofreciste una reparacion a %s por {2BFF00}$%s{FFFFFF}.", PLAYER_INFO[i][Nickname], Numeros(precio));
                                        Mecanico[i] = playerid;
                                        MConductor[i] = precio;
                                        return 1;
                                    } else return SendClientMessage(playerid, -1, "No tienes suficientes repuestos para reparar el motor de este vehiculo.");
                                } else if (autoid == autos3[u]) {
                                    if (PLAYER_INFO[playerid][Repuestos] >= MRepuestos[playerid]) {
                                        MensajeEx(i, -1, "El mecanico %s te ofrece reparar el vehiculo por {2BFF00}$%s{FFFFFF}.", PLAYER_INFO[playerid][Nickname], Numeros(precio));
                                        SendClientMessage(i, -1, "Para aceptar la reparacion usa {FFFF00}/aceptar reparacion");
                                        MensajeEx(playerid, -1, "Le ofreciste una reparacion a %s por {2BFF00}$%s{FFFFFF}.", PLAYER_INFO[i][Nickname], Numeros(precio));
                                        Mecanico[i] = playerid;
                                        MConductor[i] = precio;
                                        return 1;
                                    } else return SendClientMessage(playerid, -1, "No tienes suficientes repuestos para reparar el motor de este vehiculo.");
                                } else if (autoid == autos4[u]) {
                                    if (PLAYER_INFO[playerid][Repuestos] >= MRepuestos[playerid]) {
                                        MensajeEx(i, -1, "El mecanico %s te ofrece reparar el vehiculo por {2BFF00}$%s{FFFFFF}.", PLAYER_INFO[playerid][Nickname], Numeros(precio));
                                        SendClientMessage(i, -1, "Para aceptar la reparacion usa {FFFF00}/aceptar reparacion");
                                        MensajeEx(playerid, -1, "Le ofreciste una reparacion a %s por {2BFF00}$%s{FFFFFF}.", PLAYER_INFO[i][Nickname], Numeros(precio));
                                        Mecanico[i] = playerid;
                                        MConductor[i] = precio;
                                        return 1;
                                    } else return SendClientMessage(playerid, -1, "No tienes suficientes repuestos para reparar el motor de este vehiculo.");
                                } else if (autoid == autos5[u]) {
                                    if (PLAYER_INFO[playerid][Repuestos] >= MRepuestos[playerid]) {
                                        MensajeEx(i, -1, "El mecanico %s te ofrece reparar el vehiculo por {2BFF00}$%s{FFFFFF}.", PLAYER_INFO[playerid][Nickname], Numeros(precio));
                                        SendClientMessage(i, -1, "Para aceptar la reparacion usa {FFFF00}/aceptar reparacion");
                                        MensajeEx(playerid, -1, "Le ofreciste una reparacion a %s por {2BFF00}$%s{FFFFFF}.", PLAYER_INFO[i][Nickname], Numeros(precio));
                                        Mecanico[i] = playerid;
                                        MConductor[i] = precio;
                                        return 1;
                                    } else return SendClientMessage(playerid, -1, "No tienes suficientes repuestos para reparar el motor de este vehiculo.");
                                } else {
                                    if (PLAYER_INFO[playerid][Repuestos] >= MRepuestos[playerid]) {
                                        MensajeEx(i, -1, "El mecanico %s te ofrece reparar el vehiculo por {2BFF00}$%s{FFFFFF}.", PLAYER_INFO[playerid][Nickname], Numeros(precio));
                                        SendClientMessage(i, -1, "Para aceptar la reparacion usa {FFFF00}/aceptar reparacion");
                                        MensajeEx(playerid, -1, "Le ofreciste una reparacion a %s por {2BFF00}$%s{FFFFFF}.", PLAYER_INFO[i][Nickname], Numeros(precio));
                                        Mecanico[i] = playerid;
                                        MConductor[i] = precio;
                                        return 1;
                                    } else return SendClientMessage(playerid, -1, "No tienes suficientes repuestos para reparar el motor de este vehiculo.");
                                }
                            }
                        } else return SendClientMessage(playerid, -1, "El capo del vehiculo debe estar abierto.");
                    }
                }
            }
        } else return SendClientMessage(playerid, -1, "Debes ser mecanico para utilizar este comando.");
    }
    if (!sscanf(params, "s[13]", item)) {
        if (strcmp(item, "embarcacion", true) == 0) {
            if (PLAYER_INFO[playerid][pTrabajo] != T_Mecanico && PLAYER_INFO[playerid][pTrabajo2] != T_Mecanico) return 1;
            if (!IsPlayerInRangeOfPoint(playerid, 20.0, 2745.3225, -2596.3396, -0.1532)) return SendClientMessage(playerid, -1, "Debes estar al lado de pesca para reparar tu bote.");
            if (!BOTE(GetPlayerVehicleID(playerid))) return SendClientMessage(playerid, -1, "Debes estar en un bote para repararlo.");
            SetVehicleHealth(GetPlayerVehicleID(playerid), 1000.0);
            RepairVehicle(GetPlayerVehicleID(playerid));
            SendClientMessage(playerid, COLOR_GRAD2, "Embarcacion reparada.");
        }
    }
    return 1;
}
CMD:ficha(playerid, params[]) {
    new monto, autoid, item[128];
    autoid = GetPlayerVehicleID(playerid);
    if (PLAYER_INFO[playerid][pTrabajo] != T_Taxista && PLAYER_INFO[playerid][pTrabajo2] != T_Taxista) return SendClientMessage(playerid, -1, "Necesitas ser taxista para utilizar este comando");
    if (TAXI(autoid) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
        if (!sscanf(params, "d", monto)) {
            if (monto >= 2 && monto <= 50) {
                new string[600];
                Ficha[playerid] = monto;
                format(string, sizeof(string), "El taxímetro de ({00cbf7}%s{FFFFFF}) fue configurado con un precio de {11FF00}$%d{FFFFFF} por ficha.", PLAYER_INFO[playerid][Nickname], monto);
                foreach(new i : Player) {
                    if (IsPlayerInVehicle(i, autoid)) SendClientMessage(i, -1, string);
                }
                TextDrawShowForPlayer(playerid, TAXIMET);
                PlayerTextDrawShow(playerid, TAXIMET2[playerid]);
                TextDrawShowForPlayer(playerid, TAXIMET3);
                TextDrawShowForPlayer(playerid, TAXIMET4);
            } else return SendClientMessage(playerid, -1, "El precio de la ficha tiene que ser entre {11FF00}$2{FFFFFF} a {11FF00}$50{FFFFFF}.");
        } else if (strcmp(item, "off", true) == 0) {
            if (Ficha[playerid] == 0) return 1;
            new string[64];
            Ficha[playerid] = 0;
            format(string, sizeof(string), "({00cbf7}%s{FFFFFF}) apago el taxímetro.", PLAYER_INFO[playerid][Nickname]);
            TextDrawHideForPlayer(playerid, TAXIMET);
            PlayerTextDrawHide(playerid, TAXIMET2[playerid]);
            TextDrawHideForPlayer(playerid, TAXIMET3);
            TextDrawHideForPlayer(playerid, TAXIMET4);
            foreach(new i : Player) {
                if (IsPlayerInVehicle(i, autoid)) {
                    SendClientMessage(i, -1, string);
                }
            }
        }
    } else return 1;
    return 1;
}
CMD:mecanico(playerid, params[]) {
    if (IsPlayerInAnyVehicle(playerid)) return 1;
    if (PLAYER_INFO[playerid][pTrabajo] != T_Mecanico && PLAYER_INFO[playerid][pTrabajo2] != T_Mecanico) {
        SendClientMessage(playerid, -1, "Para ponerte en servicio de mecanico con su respectiva ropa, necesitas conseguir el trabajo.");
        SendClientMessage(playerid, -1, "Usa {"    COLOR_GM "}/ayuda trabajos{FFFFFF} para obtener mas informacion.");
        return 1;
    }
    if (IsPlayerInRangeOfPoint(playerid, 2.0, 84.3491, -149.0520, 2.6000)) {
        if (RopaMeca[playerid] == 0) {
            SendClientMessage(playerid, -1, "Ahora estas en servicio de mecanico.");
            RopaMeca[playerid] = 1;
            switch (PLAYER_INFO[playerid][jSexo]) {
                case 2: {
                    RemovePlayerAttachedObject(playerid, 5);
                    RemovePlayerAttachedObject(playerid, 4);
                    SetPlayerSkin(playerid, 309);
                    SetPlayerAttachedObject(playerid, 5, 19773, 1, 0.227999, 0.077000, 0.090000, 87.700004, 57.700054, 109.999763, 1.165000, 0.429000, 0.433999);
                    SetPlayerAttachedObject(playerid, 4, 19627, 1, 0.243999, 0.108997, 0.082998, 108.500007, 147.200057, 149.900009, 0.595997, 0.907997, 1.306998);
                }
                default: SetPlayerSkin(playerid, 50);
            }

        } else if (RopaMeca[playerid] == 1) {
            SendClientMessage(playerid, -1, "Te has quitado la ropa de trabajo.");
            RemovePlayerAttachedObject(playerid, 4);
            RemovePlayerAttachedObject(playerid, 5);
            SetPlayerSkin(playerid, PLAYER_INFO[playerid][jRopa]);
            RopaMeca[playerid] = 0;
        }
    }
    return 1;
}
CMD:basurero(playerid, params[]) {
    if (IsPlayerInAnyVehicle(playerid)) return 1;
    if (PLAYER_INFO[playerid][pTrabajo] != T_Basurero && PLAYER_INFO[playerid][pTrabajo2] != T_Basurero) return SendClientMessage(playerid, -1, "Primero tienes que conseguir el trabajo de basurero.");
    if (IsPlayerInRangeOfPoint(playerid, 2.0, -170.1398, -1556.1694, 5.6444)) {
        if (RopaBasu[playerid] == 0) {
            switch (PLAYER_INFO[playerid][jSexo]) {
                case 2: {
                    SetPlayerSkin(playerid, 131);
                    SetPlayerAttachedObject(playerid, 4, 19904, 1, 0.103999, 0.065000, -0.001998, 2.099929, 90.200180, 174.199905, 0.949001, 1.222001, 0.876000);
                }
                default: SetPlayerSkin(playerid, 16);
            }
            SendClientMessage(playerid, -1, "Te has colocado la ropa de trabajo, ahora puedes comenzar a trabajar");
            RopaBasu[playerid] = 1;
            Descongelar(playerid);
        } else if (RopaBasu[playerid] == 1) {
            SendClientMessage(playerid, -1, "Te has quitado la ropa de trabajo");
            RemovePlayerAttachedObject(playerid, 4);
            SetPlayerSkin(playerid, PLAYER_INFO[playerid][jRopa]);
            RopaBasu[playerid] = 0;
            Descongelar(playerid);
        }
    }
    return 1;
}
CMD:medico(playerid, params[]) {
    new autoid = GetPlayerVehicleID(playerid);
    if (PLAYER_INFO[playerid][pTrabajo] != T_Medico && PLAYER_INFO[playerid][pTrabajo2] != T_Medico) return 1;
    if (!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, "Debes estar en una ambulancia para colocarte el uniforme");
    if (!AMBU(autoid)) return SendClientMessage(playerid, -1, "Debes estar en una ambulancia para colocarte el uniforme");
    if (GetPlayerVehicleSeat(playerid) == 2 || GetPlayerVehicleSeat(playerid) == 3) {
        if (RopaMedi[playerid] == 0) {
            RopaMedi[playerid] = 1;
            switch (PLAYER_INFO[playerid][jSexo]) {
                case 2 : SetPlayerSkin(playerid, 308);
                default: SetPlayerSkin(playerid, 276);
            }
            RemovePlayerFromVehicle(playerid);
            PLAYER_INFO[playerid][pModelo] = GetPlayerSkin(playerid);
            SendClientMessage(playerid, COLOR_DORADO, "Ropa cambiada, ahora estas en servicio.");
        } else if (RopaMedi[playerid] == 1) {
            RopaMedi[playerid] = 0;
            SetPlayerSkin(playerid, PLAYER_INFO[playerid][jRopa]);
            RemovePlayerFromVehicle(playerid);
            SendClientMessage(playerid, COLOR_DORADO, "Ya no estas de servicio.");
        }
        foreach(new i : Player) RemovePlayerMapIcon(playerid, i);
    } else return SendClientMessage(playerid, -1, "Debes estar en la parte trasera de una ambulancia para colocarte el uniforme");
    return 1;
}
CMD:regar(playerid, params[]) {
    if (PLAYER_INFO[playerid][jBalde] != 4) return SendClientMessage(playerid, COLOR_BLANCO, "Necesitas tener un balde con agua para regar.");
    if (AguaBalde[playerid] != 1) return SendClientMessage(playerid, COLOR_BLANCO, "Necesitas llenar el balde de agua para hacer esto.");
    if (IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_BLANCO, "No puedes hacer esto en un vehículo.");
    if (GetPlayerInterior(playerid) != 0) return SendClientMessage(playerid, COLOR_BLANCO, "No puedes hacer esto en un interior.");
    if (GetPlayerVirtualWorld(playerid) != 0) return SendClientMessage(playerid, COLOR_BLANCO, "No puedes hacer esto en un interior.");
    new string[80];
    for(new e; e < MAX_MARIHUANA; e++) {
        if (EstaEn(playerid, 1.0, MariInfo[e][pX], MariInfo[e][pY], MariInfo[e][pZ])) {
            if (MariInfo[e][State] == 1) {
                GameTextForPlayerEx(playerid, "~b~Regando...", 3000, 3);
                LoopingAnim(playerid, "BOMBER", "BOM_Plant", 4.0, 1, 1, 1, 1, 3000);
                SetTimerEx("Regando", 3000, false, "ud", playerid, e);
                format(string, sizeof(string), "%s vacía el balde de agua en la planta.", NombreJugador(playerid));
                ProxDetector(10.0, playerid, string, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO);
                return 1;
            }
        }
    }
    return 1;
}
CMD:cosechar(playerid, params[]) {
    new item[128];
    if (!sscanf(params, "s[128]", item)) {
        if (strcmp(item, "planta", true) == 0) {
            if (PLAYER_INFO[playerid][@Nivel] < 4) return SendClientMessage(playerid, COLOR_BLANCO, "Para sembrar necesitas tener como mínimo nivel 4.");
            if (PLAYER_INFO[playerid][j_ARMAS][GetWeaponSlot(4)] != 4) return SendClientMessage(playerid, COLOR_BLANCO, "Necesitas un cuchillo para cosechar marihuana.");
            for(new e; e < MAX_MARIHUANA; e++) {
                if (EstaEn(playerid, 2.0, MariInfo[e][pX], MariInfo[e][pY], MariInfo[e][pZ])) {
                    if (MariInfo[e][Creado] == 0) continue;
                    if (MariInfo[e][State] == 3) {
                        if (strcmp(MariInfo[e][Plantador], NombreJugador(playerid), true) == 1) {
                            if (PLAYER_INFO[playerid][jExperiencia] <= 0) return SendClientMessage(playerid, -1, "Necesitas por lo menos 1 hora de experiencia para poder cosechar la planta de otro jugador.");
                            PLAYER_INFO[playerid][jExperiencia] -= 1;
                        }
                        new string[100];
                        if (PLAYER_INFO[playerid][pSonidos] == 1) PlayAudioStreamForPlayer(playerid, "http://sonidos.gtazonerp.net/Cortar.mp3");
                        LoopingAnim(playerid, "BOMBER", "BOM_Plant", 4.0, 1, 1, 1, 1, 3000);
                        GameTextForPlayerEx(playerid, "~r~Cosechando...", 3000, 3);
                        SetTimerEx("CosechandoPlanta", 3000, false, "ud", playerid, e);
                        format(string, sizeof(string), "%s corta con un cuchillo la planta de marihuana.", NombreJugador(playerid));
                        ProxDetector(10.0, playerid, string, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO, COLOR_VERDECLARO);
                        return 1;
                    }
                }
            }
        }
    }
    if (sscanf(params, "s[30]", item)) {
        if (IsPlayerInRangeOfPoint(playerid, 5.0, -392.1681, -1481.9919, 25.6680)) {
            if (IsPlayerInAnyVehicle(playerid)) return 1;
            if (Cosechas[playerid][CosechaLugar] == 0) {
                new randomly = random(8);
                switch (randomly) {
                    case 0 : randomly = 1;
                    case 1 : randomly = 1;
                    case 2 : randomly = 2;
                    case 3 : randomly = 2;
                    default: randomly = 1;
                }
                Cosechas[playerid][CosechaLugar] = 1;
                Cosechas[playerid][RutaCosecha] = randomly;
                CosechasPoints(playerid);
                SetPlayerProgressBarValue(playerid, Progressbar[playerid][Cosecha], 0);
                UpdatePlayerProgressBar(playerid, Progressbar[playerid][Cosecha]);
                if (randomly == 1) SetPlayerProgressBarMaxValue(playerid, Progressbar[playerid][Cosecha], 20.0);
                else if (randomly == 2) SetPlayerProgressBarMaxValue(playerid, Progressbar[playerid][Cosecha], 16.0);
                SendClientMessage(playerid, -1, "Sube a una cosechadora y comienza a trabajar.");
            } else return SendClientMessage(playerid, -1, "Ya te dieron un campo para cosechar.");
        } else if (IsPlayerInRangeOfPoint(playerid, 5.0, -31.3545, 54.7022, 3.1172)) {
            if (IsPlayerInAnyVehicle(playerid)) return 1;
            if (Cosechas[playerid][CosechaLugar] == 0) {
                new randomly = random(8);
                switch (randomly) {
                    case 0 : randomly = 1;
                    case 1 : randomly = 1;
                    case 2 : randomly = 2;
                    case 3 : randomly = 2;
                    default: randomly = 2;
                }
                Cosechas[playerid][CosechaLugar] = 2;
                Cosechas[playerid][RutaCosecha] = randomly;
                CosechasPoints(playerid);
                SetPlayerProgressBarMaxValue(playerid, Progressbar[playerid][Cosecha], 15.0);
                SetPlayerProgressBarValue(playerid, Progressbar[playerid][Cosecha], 0);
                UpdatePlayerProgressBar(playerid, Progressbar[playerid][Cosecha]);
                SendClientMessage(playerid, -1, "Sube a una cosechadora y comienza a trabajar.");
            } else return SendClientMessage(playerid, -1, "Ya te dieron un campo para cosechar.");
        } else SendClientMessage(playerid, -1, "No estas donde dan el trabajo de cosechador.");
    }
    return 1;
}
CMD:ref(playerid, params[]) {
    //	new string__[128];
    new Float:X, Float:Y, Float:Z;
    GetPlayerPos(playerid, X, Y, Z);

    if (PLAYER_TIMES[playerid][TiempoRef] > 0) return SendClientMessageEx(playerid, -1, "Debes esperar %s para volver a pedir refuerzos.", TimeConvertEx(PLAYER_TIMES[playerid][TiempoRef]));
    if (PLAYER_INFO[playerid][pFaccion] == 1) {
        if (PLAYER_INFO[playerid][pDuty] == 0) return SendClientMessage(playerid, COLOR_WHITE, "No tienes el uniforme de policia puesto.");
        new string[128], zone[MAX_ZONE_NAME];
        GetPlayer3DZone(playerid, zone, MAX_ZONE_NAME);
        if (IsPlayerInRangeOfPoint(playerid, 700.0, 727.1412, -3320.2461, 5.8700)) format(zone, sizeof(zone), "Isla Santa Carolina");
        if (IsPlayerInRangeOfPoint(playerid, 700.0, -729.2760, 503.0869, 1371.9718)) format(zone, sizeof(zone), "Linox City");
        foreach(new i : Player) {
            if (PLAYER_INFO[i][pFaccion] == 1) {
                format(string, 128, "[S.A.P.D]{FFFFFF}El oficial {3A1B0B}%s{FFFFFF} esta solicitando refuerzos en{3399FF} %s.", PLAYER_INFO[playerid][Nickname], zone);
                SendClientMessage(i, COLOR_WHITE, string);
            }
        }

        format(string, 128, "[Radio] El oficial %s esta solicitando refuerzos en %s", PLAYER_INFO[playerid][Nickname], zone);
        Webhook_Refuerzos(playerid, 0);
        ProxDetector(15.0, playerid, string, Hablar, Hablar2, Hablar3, Hablar4, Hablar5);
        for(new td; td < 5; td++) {
            TextDrawShowForPlayer(playerid, AlertaRefuerzos[td]);
        }
        ReportCrimen(playerid, 7);
        PLAYER_TIMES[playerid][TiempoRef] = 60;
        PidioRefuerzos[playerid] = 1;
        return 1;
    } else if (PLAYER_INFO[playerid][pFaccion] == 2) {
        if (PLAYER_INFO[playerid][pDuty] == 0) return SendClientMessage(playerid, COLOR_WHITE, "No tienes el uniforme puesto.");
        new string[128], zone[MAX_ZONE_NAME];
        GetPlayer3DZone(playerid, zone, MAX_ZONE_NAME);
        if (IsPlayerInRangeOfPoint(playerid, 700.0, 727.1412, -3320.2461, 5.8700)) format(zone, sizeof(zone), "Isla Santa Carolina");
        if (IsPlayerInRangeOfPoint(playerid, 700.0, -729.2760, 503.0869, 1371.9718)) format(zone, sizeof(zone), "Linox City");
        foreach(new i : Player) {
            if (PLAYER_INFO[i][pFaccion] == 2) {
                format(string, 128, "[S.A.T.A]{FFFFFF}El militante {3A1B0B}%s{FFFFFF} esta solicitando refuerzos en{3A1B0B} %s.", PLAYER_INFO[playerid][Nickname], zone);
                SendClientMessage(i, COLOR_WHITE, string);
            }
        }

        format(string, 128, "[Radio] El militar %s esta solicitando refuerzos en %s", PLAYER_INFO[playerid][Nickname], zone);
        Webhook_Refuerzos(playerid, 0);
        ProxDetector(15.0, playerid, string, Hablar, Hablar2, Hablar3, Hablar4, Hablar5);
        for(new td; td < 5; td++) {
            TextDrawShowForPlayer(playerid, AlertaRefuerzos[td]);
        }
        ReportCrimen(playerid, 7);
        PLAYER_TIMES[playerid][TiempoRef] = 60;
        PidioRefuerzos[playerid] = 2;
        return 1;
    } else if (PLAYER_INFO[playerid][pFaccion] == 3) {
        if (PLAYER_INFO[playerid][pDuty] == 0) return SendClientMessage(playerid, COLOR_WHITE, "No tienes el uniforme puesto.");
        new string[128], zone[MAX_ZONE_NAME];
        GetPlayer3DZone(playerid, zone, MAX_ZONE_NAME);
        if (IsPlayerInRangeOfPoint(playerid, 700.0, 727.1412, -3320.2461, 5.8700)) format(zone, sizeof(zone), "Isla Santa Carolina");
        if (IsPlayerInRangeOfPoint(playerid, 700.0, -729.2760, 503.0869, 1371.9718)) format(zone, sizeof(zone), "Linox City");
        foreach(new i : Player) {
            if (PLAYER_INFO[i][pFaccion] == 3) {
                format(string, 128, "[S.A.F.D] El bombero %s esta solicitando refuerzos en{cccccc} %s.", PLAYER_INFO[playerid][Nickname], zone);
                SendClientMessage(i, COLOR_BOMBERO, string);
            }
        }

        format(string, 128, "[Radio] El bombero %s esta solicitando refuerzos en %s", PLAYER_INFO[playerid][Nickname], zone);
        Webhook_Refuerzos(playerid, 0);
        ProxDetector(15.0, playerid, string, Hablar, Hablar2, Hablar3, Hablar4, Hablar5);
        for(new td; td < 5; td++) {
            TextDrawShowForPlayer(playerid, AlertaRefuerzos[td]);
        }

        PLAYER_TIMES[playerid][TiempoRef] = 60;
        PidioRefuerzos[playerid] = 3;
        return 1;
    } else if (PLAYER_INFO[playerid][pFaccion] > 5) {
        new string[128], zone[MAX_ZONE_NAME];
        GetPlayer3DZone(playerid, zone, MAX_ZONE_NAME);
        if (IsPlayerInRangeOfPoint(playerid, 700.0, 727.1412, -3320.2461, 5.8700)) format(zone, sizeof(zone), "Isla Santa Carolina");
        if (IsPlayerInRangeOfPoint(playerid, 700.0, -729.2760, 503.0869, 1371.9718)) format(zone, sizeof(zone), "Liberty City");
        foreach(new i : Player) {
            new CrewColorChat = getPlayerCrewColor(i);
            if (PLAYER_INFO[i][pFaccion] == PLAYER_INFO[playerid][pFaccion]) {
                format(string, 128, "[Radio Banda] El integrante %s esta solicitando refuerzos en {ffffff}%s", PLAYER_INFO[playerid][Nickname], zone);
                SendClientMessage(i, CrewColorChat, string);
            }
        }
        format(string, 128, "[Radio] %s esta solicitando refuerzos en %s.", PLAYER_INFO[playerid][Nickname], zone);
        Webhook_Refuerzos(playerid, 0);
        ProxDetector(15.0, playerid, string, Hablar, Hablar2, Hablar3, Hablar4, Hablar5);
        PidioRefuerzos[playerid] = PLAYER_INFO[playerid][pFaccion];
    }
    return 1;
}
CMD:cref(playerid, params[]) {
    new Float:X, Float:Y, Float:Z;
    GetPlayerPos(playerid, X, Y, Z);
    if (PLAYER_INFO[playerid][pFaccion] == 1 && PidioRefuerzos[playerid] == 1 || PLAYER_INFO[playerid][pFaccion] == 2 && PidioRefuerzos[playerid] == 2 || PLAYER_INFO[playerid][pFaccion] == 3 && PidioRefuerzos[playerid] == 3) {
        if (PLAYER_INFO[playerid][pDuty] == 0) return SendClientMessage(playerid, COLOR_WHITE, "No tienes el uniforme de policia puesto.");
        new string[128], zone[MAX_ZONE_NAME];
        GetPlayer3DZone(playerid, zone, MAX_ZONE_NAME);
        if (IsPlayerInRangeOfPoint(playerid, 700.0, 727.1412, -3320.2461, 5.8700)) format(zone, sizeof(zone), "Isla Santa Carolina");
        if (IsPlayerInRangeOfPoint(playerid, 700.0, -729.2760, 503.0869, 1371.9718)) format(zone, sizeof(zone), "Liberty City");
        foreach(new i : Player) {
            if (PLAYER_INFO[i][pFaccion] == 1) {
                format(string, 128, "El oficial %s cancelo el pedido de refuerzos en{cccccc} %s.", PLAYER_INFO[playerid][Nickname], zone);
                SendClientMessage(i, COLOR_POLICIA, string);
            }
            if (PLAYER_INFO[i][pFaccion] == 2) {
                format(string, 128, "El militar %s cancelo el pedido de refuerzos en{cccccc} %s.", PLAYER_INFO[playerid][Nickname], zone);
                SendClientMessage(i, COLOR_MILITAR, string);
            }
            if (PLAYER_INFO[i][pFaccion] == 3) {
                format(string, 128, "El bombero {3399FF}%s{FFFFFF} cancelo el pedido de refuerzos en{cccccc} %s.", PLAYER_INFO[playerid][Nickname], zone);
                SendClientMessage(i, COLOR_BOMBERO, string);
            }
        }
        if (PLAYER_INFO[playerid][pFaccion] == 1) {
            format(string, 128, "[Radio] El oficial %s cancelo el pedido de refuerzos en %s.", PLAYER_INFO[playerid][Nickname], zone);
            ProxDetector(15.0, playerid, string, Hablar, Hablar2, Hablar3, Hablar4, Hablar5);
            ReportCrimen(playerid, 7);
        }
        if (PLAYER_INFO[playerid][pFaccion] == 2) {
            format(string, 128, "[Radio] El militar %s cancelo el pedido de refuerzos en %s.", PLAYER_INFO[playerid][Nickname], zone);
            ProxDetector(15.0, playerid, string, Hablar, Hablar2, Hablar3, Hablar4, Hablar5);
        }
        if (PLAYER_INFO[playerid][pFaccion] == 3) {
            format(string, 128, "[Radio] El bombero %s cancelo el pedido de refuerzos en %s.", PLAYER_INFO[playerid][Nickname], zone);
            ProxDetector(15.0, playerid, string, Hablar, Hablar2, Hablar3, Hablar4, Hablar5);

        }
        PidioRefuerzos[playerid] = 0;
        foreach(new i : Player) {
            if (PLAYER_INFO[i][pFaccion] == 1) {
                SetPlayerMarkerForPlayer(i, playerid, COLOR_POLICIA);
            }
            if (PLAYER_INFO[i][pFaccion] == 2) {
                SetPlayerMarkerForPlayer(i, playerid, COLOR_MILITAR);
            }
            if (PLAYER_INFO[i][pFaccion] == 3) {
                SetPlayerMarkerForPlayer(i, playerid, COLOR_BOMBERO);
            }
        }
        for(new td; td < 5; td++) {
            TextDrawHideForPlayer(playerid, AlertaRefuerzos[td]);
        }
        return 1;
    } else if (PLAYER_INFO[playerid][pFaccion] > 5 && PidioRefuerzos[playerid] > 5) {
        new string[128], zone[MAX_ZONE_NAME];
        GetPlayer3DZone(playerid, zone, MAX_ZONE_NAME);
        if (IsPlayerInRangeOfPoint(playerid, 700.0, 727.1412, -3320.2461, 5.8700)) format(zone, sizeof(zone), "Isla Santa Carolina");
        if (IsPlayerInRangeOfPoint(playerid, 700.0, -729.2760, 503.0869, 1371.9718)) format(zone, sizeof(zone), "Liberty City");
        foreach(new i : Player) {
            if (PLAYER_INFO[i][pFaccion] == PLAYER_INFO[playerid][pFaccion]) {
                format(string, 128, "{FF8C00}%s{FFFFFF} cancelo el pedido de refuerzos en {FF8C00}%s{FFFFFF}.", PLAYER_INFO[playerid][Nickname], zone);
                SendClientMessage(i, COLOR_WHITE, string);
            }
        }
        format(string, 128, "[Radio] %s cancelo el pedido de refuerzos en %s.", PLAYER_INFO[playerid][Nickname], zone);
        ProxDetector(15.0, playerid, string, Hablar, Hablar2, Hablar3, Hablar4, Hablar5);
        foreach(new i : Player) {
            if (PLAYER_INFO[i][pFaccion] == PidioRefuerzos[playerid]) {
                SetPlayerMarkerForPlayer(i, playerid, INVISIBLE2);
            }
        }
        PidioRefuerzos[playerid] = 0;
    }
    return 1;
}
CMD:canal(playerid, params[]) {
    if (strcmp(params, "anuncios", true) == 0) {
        if (CanalAnuncios[playerid] == 0) {
            SendClientMessage(playerid, 0xDBED15FF, "Activaste el canal de anuncios, usalo con cuidado que puedes llegar a ser baneado.");
            CanalAnuncios[playerid] = 1;
        } else {
            SendClientMessage(playerid, 0xFF9900FF, "Desactivaste el canal de anuncios, ingresa el mismo comando para activarlo.");
            CanalAnuncios[playerid] = 0;
        }
    }
    if (strcmp(params, "dudas", true) == 0) {
        if (CanalDudas[playerid] == 0) {
            SendClientMessage(playerid, 0xDBED15FF, "Activaste el canal dudas, osalo con cuidado que puedes llegar a ser baneado.");
            CanalDudas[playerid] = 1;
        } else {
            SendClientMessage(playerid, 0xFF9900FF, "Desactivaste el canal de dudas /n, ingresa el mismo comando para activarlo.");
            CanalDudas[playerid] = 0;
        }
    } else SendClientMessage(playerid, -1, "Escribe {"COLOR_GM "}/canal dudas");
    return 1;
}
CMD:mostrar(playerid, params[]) {
    new item[128];
    if (!sscanf(params, "s[128]", item)) {
        if (strcmp(params, "sed", true) == 0) {
            if (PLAYER_INFO[playerid][pBarras] == 0) return SendClientMessage(playerid, -1, "Ya tienes visible la barra indicadora de sed.");
            PLAYER_INFO[playerid][pBarras] = 0;
            ActualizarHambre(playerid, 1);
            ActualizarSed(playerid, 1);
            SendClientMessage(playerid, -1, "Ahora puedes ver la barra de sed, para ocultarla usa {"        COLOR_GM "}/ocultar sed{FFFFFF}.");
        }

        if (strcmp(item, "anuncios", true) == 0) {
            if (CanalDudas[playerid] == 1) return PUSH(playerid, "Tienes los anuncios activados, revisa ~g~~h~/config");
            for(new i = 0; i < MAX_ANUNCIOS; i++) {
                if (CanalDudas[playerid] == 1) {
                    TextDrawShowForPlayer(playerid, _InfoAnuncio[i][TDAnuncio]);
                    PUSH(playerid, "Mostrando anuncios.");
                }
            }
        }

        if (strcmp(params, "nombres", true) == 0) {
            if (NombresOcultos[playerid] == 0) GameTextForPlayerEx(playerid, "MOSTRANDO NOMBRES", 1000, 5);
            else {
                NombresOcultos[playerid] = 0;
                foreach(new i : Player) ShowPlayerNameTagForPlayer(playerid, i, 1);
                GameTextForPlayerEx(playerid, "~g~MOSTRANDO ~w~NOMBRES", 1000, 5);
                SendClientMessage(playerid, -1, "Ahora puedes ver los nombres de los jugadores, para ocultarlos escribe {"            COLOR_GM "}/ocultar nombres{FFFFFF}.");
            }
        }
    }
    return 1;
}
CMD:reglas(playerid, params[]) {
    new string[500];
    if (JugadorLogeado[playerid] == 1) {
        string = "{FFFF00}Nombres\n{FFFFFF}A la hora de elejir un hombre hay que tener en cuenta:\n- El nombre elejido tiene que ser real, es decir, que alguien en el mundo lo tenga.\n- Se prohibe el uso de diminutivos o sobrenombres. Ejemplo: Nico_Gonzales o Nacho_Lopez.\n- Es importante el uso de mayusculas solo en la primer letra del Nombre y Apellido.\n- Se prohibe usar nombres de personas famosas. Ejemplo: Marcelo_Tinelli. Chuck_Norris, etc.";
        dialogs_ShowPlayerDialog(playerid, REGLAS, DIALOG_STYLE_MSGBOX, "Reglas del juego", string, "Siguiente", "");
    }
    return 1;
}
CMD:reportar(playerid, params[]) {
    new id, razon[250];
    if (PLAYER_INFO[playerid][pTiempoJail] > 0) return SendClientMessage(playerid, -1, "No puedes usar este comando en este momento, en su lugar escribe {"COLOR_GM "}/reglas");
    if (!sscanf(params, "ds[250]", id, razon)) {
        if (IsPlayerNPC(id)) return SendClientMessage(playerid, -1, "Por favor, para reportar escribe {"    COLOR_GM "}/reportar [ID] [Razon]");
        if (!IsPlayerConnected(id)) return SendClientMessage(playerid, COLOR_WHITE, "{"    COLOR_GM "}La persona a la que estas intentando reportar, esta desconectada.");
        if (id == Reportado[playerid][0] || id == Reportado[playerid][1] || id == Reportado[playerid][2] || id == Reportado[playerid][3] || id == Reportado[playerid][4]) return SendClientMessage(playerid, 0xFF3000FF, "Ya tienes un reporte activo.");
        new length = strlen(razon);
        if (length > 100) return SendClientMessage(playerid, -1, "No puedes enviar un reporte muy extenso, abrevia tus palabras por favor.");
        for(new i = 0; i < 5; i++) {
            if (Reportado[playerid][i] == INVALID_PLAYER_ID) {
                Reportado[playerid][i] = id;
                SendReportToQue(playerid, id, razon);
                PLAYER_TIMES[playerid][RemoveReportTimer][i] = SetTimerEx("RemoveReport", 180000, false, "dd", playerid, i);
                SendClientMessage(playerid, -1, "{00CC00}El reporte fue enviado correctamente.");
                break;
            }
        }
        return 1;
    } else return SendClientMessage(playerid, -1, "Por favor, para reportar escribe {"COLOR_GM "}/reportar [ID] [Razon]");
}
CMD:gasolinera(playerid) {
    if (JugadorLogeado[playerid] != 1) return 1;
    for(new g = 0; g < MAX_GASOLINERAS; g++) {
        if (IsPlayerInRangeOfPoint(playerid, 2.0, Gasolineras[g][Posss][0], Gasolineras[g][Posss][1], Gasolineras[g][Posss][2])) {
            if (Gasolineras[g][gEnUso] == 1) {
                if (PLAYER_INFO[playerid][pID] == Gasolineras[g][gDuenoID]) {
                    dialogs_ShowPlayerDialog(playerid, ADM_GASOLINERA, DIALOG_STYLE_LIST, "Gasolinera", "Modificar precio por litro\nComprar tanque\nLlenar tanque\nVer Ganancias", "Aceptar", "Cancelar");
                }
            }
        }
    }
    return 1;
}
CMD:combustible(yo, jaja[]) {
    extract jaja - > new litros; else return 1;
    new petroleo, autoid = GetPlayerVehicleID(yo);
    for(new gid = 0; gid < MAX_GASOLINERAS; gid++) {
        if (IsPlayerInRangeOfPoint(yo, 15.0, Gasolineras[gid][Poss2][0], Gasolineras[gid][Poss2][1], Gasolineras[gid][Poss2][2])) {
            if (Gasolineras[gid][gGasolina] < litros) return SendClientMessage(yo, -1, "La gasolinera no tiene esa cantidad de combustible.");
            if (litros < 0) return SendClientMessage(yo, -1, "Ingresa la cantidad de combustible que deseas cargar.");
            new modelo = GetVehicleModel(autoid), vehiclefuel = CombustibleCoche(modelo);
            if (VehicleFuel[autoid] >= vehiclefuel) return SendClientMessage(yo, -1, "El tanque de este vehiculo esta lleno."); {
                new nuevacantidad = litros + VehicleFuel[autoid];
                if (nuevacantidad > vehiclefuel) return SendClientMessage(yo, -1, "No puedes recargar esa cantidad de combustible.");
                petroleo = VehicleFuel[autoid] + litros;
                if (PLAYER_INFO[yo][jDinero] < litros * Gasolineras[gid][gPrecioL]) {
                    SendClientMessageEx(yo, -1, "El litro de combustible cuesta {00CC00}$%d{FFFFFF}, necesitas {00CC00}$%d{FFFFFF} para pagar {"                COLOR_GM "}%d{FFFFFF} litros.", Gasolineras[gid][gPrecioL], litros * Gasolineras[gid][gPrecioL], litros);
                    return 1;
                }
                llenado[autoid] = SetTimerEx("DarGasolina", 1000, true, "dddd", yo, autoid, petroleo, gid);
                SendClientMessageEx(yo, -1, "Se van a cargar %d litros de combustible.", litros);
                Congelar(yo);
                if (!IsPlayerInAnyVehicle(yo)) return SendClientMessage(yo, -1, "Debes estar dentro del vehículo.");
                SendClientMessageEx(yo, -1, "Costo total: {00CC00}$%d{FFFFFF}.", litros * Gasolineras[gid][gPrecioL]);
                new striong[20];
                format(striong, sizeof(striong), "~r~-$%d", litros * Gasolineras[gid][gPrecioL]);
                GameTextForPlayerEx(yo, striong, 5000, 1);
                QuitarDinero(yo, litros * 10);
                SinGaso[autoid] = 0;
                TimerCombustible[yo] = 150;
            }
        }
    }
    return 1;
}

CMD:llenar(playerid, params[]) {
    new item[128], resta, string[128], resta2;
    if (!sscanf(params, "s[128]", item)) {
        if (strcmp(item, "tanque", true) == 0) {
            for(new g = 0; g < MAX_GASOLINERAS; g++) {
                if (IsPlayerInRangeOfPoint(playerid, 15.0, Gasolineras[g][Poss2][0], Gasolineras[g][Poss2][1], Gasolineras[g][Poss2][2])) {
                    if (!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, " Necesitas estar manejando el vehiculo para cargar combustible.");
                    if (MotorAuto[GetPlayerVehicleID(playerid)] == 1) return SendClientMessage(playerid, -1, "Para llenar el tanque, primero debes apagar el motor.");
                    new autoid = GetPlayerVehicleID(playerid);
                    if (PLAYER_TIMES[playerid][TiempoLlenar] > 0) return SendClientMessage(playerid, -1, "Ya estas llenando el tanque, espera un poco.");

                    new modelo = GetVehicleModel(autoid);
                    new vehiclefuel = CombustibleCoche(modelo);
                    if (VehicleFuel[autoid] >= vehiclefuel) return SendClientMessage(playerid, -1, "El tanque de este vehiculo esta lleno");
                    resta = vehiclefuel - VehicleFuel[autoid];
                    resta2 = vehiclefuel;
                    if (PLAYER_INFO[playerid][jDinero] < resta * Gasolineras[g][gPrecioL]) {
                        format(string, 128, "No tienes suficiente dinero para llenar tu vehiculo, necesitas {00CC00}$%d{FFFFFF}.", resta * Gasolineras[g][gPrecioL]);
                        return SendClientMessage(playerid, -1, string);
                    }
                    if (Gasolineras[g][gGasolina] < resta) return SendClientMessage(playerid, -1, "Esta gasolinera no tiene mas combustible.");
                    llenado[autoid] = SetTimerEx("DarGasolina", 1000, true, "dddd", playerid, autoid, resta2, g);
                    format(string, 128, "Se van a cargar %d litros de combustible.", resta);
                    SendClientMessage(playerid, -1, string);
                    format(string, 128, "Costo total: {00CC00}$%d{FFFFFF}.", resta * Gasolineras[g][gPrecioL]);
                    SendClientMessage(playerid, -1, string);
                    TogglePlayerControllable(playerid, 0);
                    SetPVarInt(playerid, "IsFrozen", 0);
                    QuitarDinero(playerid, resta * Gasolineras[g][gPrecioL]);
                    SinGaso[autoid] = 0;
                    PLAYER_TIMES[playerid][TiempoLlenar] = resta;
                    new striong[20];
                    format(striong, sizeof(striong), "~r~-$%d", resta * Gasolineras[g][gPrecioL]);
                    GameTextForPlayerEx(playerid, striong, 5000, 1);
                    TimerCombustible[playerid] = 150;
                }
            }
        }
        if (strcmp(item, "balde", true) == 0) {
            if (!EnBaldes(playerid)) return 1;
            if (PLAYER_INFO[playerid][jBalde] == 0) return SendClientMessage(playerid, -1, "Necesitas tener un balde en tu inventario.");
            if (Objeto[playerid] > 0) return SendClientMessage(playerid, -1, "Ya tienes un objeto en tu inventario.");
            if (AguaBalde[playerid] == 1) return SendClientMessage(playerid, -1, "Tu balde ya contiene agua.");
            TogglePlayerControllable(playerid, 0);
            Objeto[playerid] = 9003;
            SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
            SetPlayerAttachedObject(playerid, 4, 19468, 5, 0.126999, -0.089000, 0.127998, 101.199981, -164.499847, 82.999900, 1.032001, 0.972000, 1.002997);
            TogglePlayerControllable(playerid, 1);
            Congelar(playerid);
            if (PLAYER_INFO[playerid][pSonidos] == 1) {
                PlayAudioStreamForPlayer(playerid, "http://"    AUDIO_BALDE "");
            }
            SendClientMessage(playerid, COLOR_WHITE, "Se esta llenando el balde de agua, espera por favor..");
            GameTextForPlayerEx(playerid, "~b~Llenando Balde...", 4000, 5);
            SetTimerEx("LlenarBalde", 10000, false, "u", playerid);
        }
    }
    return 1;
}
CMD:fuel(playerid) {
    if (PLAYER_INFO[playerid][pAdmin] < 3) return 0;
    new string[128], autoid, resta;
    if (!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, " Necesitas estar manejando el vehiculo para cargar combustible.");
    autoid = GetPlayerVehicleID(playerid);
    new modelo = GetVehicleModel(autoid);
    new vehiclefuel = CombustibleCoche(modelo);
    if (VehicleFuel[autoid] >= vehiclefuel) return SendClientMessage(playerid, -1, "El tanque de este vehiculo esta lleno");
    resta = vehiclefuel - VehicleFuel[autoid];
    format(string, 128, "Se van a cargar %d litros de combustible.", resta);
    SendClientMessage(playerid, -1, string);
    VehicleFuel[autoid] += resta;
    return 1;
}

CMD:telefono(playerid, params[]) {
    if (PLAYER_INFO[playerid][pNumero] <= 0) return SendClientMessage(playerid, -1, "No tienes un Telefono celular.");
    AccionesRol(playerid, "mira su telefono.", 20);
    RP_PhoneOpen(playerid);
    return 1;
}
CMD:agenda(playerid, params[]) {
    if (PLAYER_INFO[playerid][pTiempoCarcel] > 0 || PLAYER_INFO[playerid][pTiempoJail] > 0) return SendClientMessage(playerid, -1, "Te quitaron el Telefono antes de meterte en la celda.");
    if (PLAYER_INFO[playerid][pNumero] == 0) return SendClientMessage(playerid, -1, "No tienes ningun Telefono, puedes ir a cualquier 24/7 para comprar uno.");
    if (TelefonoEstado[playerid] == 1) return SendClientMessageEx(playerid, -1, "Tu Telefono esta apagado, para encenderlo escribe /telefono.");
    if (EnLlamada[playerid] == 1) return SendClientMessageEx(playerid, -1, "estas en una llamada.");
    ShowDialog(playerid, DIALOG_PHONE_BOOK);
    return 1;
}
CMD:desbug(playerid, params[]) {
    if (JugadorLogeado[playerid] == 1) {
        new item[32];
        if (!sscanf(params, "s[32]", item)) {
            if (strcmp(item, "vehiculos", true) == 0) {
                if (PLAYER_TEMP[playerid][DESBUG] >= 1) return SendClientMessage(playerid, COLOR_CHEAT, "No puedes seguir usando este comando.");
                if (IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, "Error, relogea.");
                AutosUsuarios(playerid);
                LimpiarAutosU(playerid);
                ShowPlayerMessage(playerid, "~y~Cargando...");
                Notificador2(playerid, "~r~~h~El mal uso de este comando implica un baneo.");
                LoadVehicles(playerid);
                Congelar(playerid);
                printf("Ejecutando /desbug vehiculos.");
                SetTimerEx("AntiCJ", 2000, false, "d", playerid);
                SetTimerEx("Cargar2AutosxD", 2000, false, "d", playerid);
                MensajeAdminEx(3, COLOR_CHEAT, "[ANTI-FLOOD] %s[%d] uso el comando /desbug vehiculos.", PLAYER_INFO[playerid][Nickname], playerid);
                PLAYER_TEMP[playerid][DESBUG]++;
            }
        } else SendClientMessage(playerid, -1, "Usa {"    COLOR_GM "}/desbug vehiculos");
    }
    SetPVarInt(playerid, "antiflood", GetTickCount());
    return 1;
}
CMD:ver(playerid, params[]) {
    new item[32], string[500];
    if (!sscanf(params, "s[32]", item)) {
        if (strcmp(item, "botiquin", true) == 0) {
            if (EnBotiquin(playerid)) MostrarBotiquin(playerid);
        } else if (strcmp(params, "mapa", true) == 0) {
            if (!EnVerMapa(playerid)) return 1;
            format(string, sizeof(string), "Concesionarias\nBancos\n24/7\nTrabajos\nEdificios del gobierno\nTiendas de ropa\n{366397}Mercado Negro\nTalleres\nVer mapa\n{FFFFFF}Puerto del Ferry\nTorre VillaSuite\nEstaciones de Servicio\nPaintBall Games\nTienda Exclusiva\nBase de Bomberos");
            dialogs_ShowPlayerDialog(playerid, GPS, DIALOG_STYLE_LIST, "Puntos de interes", string, "Siguiente", "Cancelar");
        } else if (strcmp(params, "incendios", true) == 0) {
            if (IsABombero(playerid)) {
                LIncendios(playerid);
            } else return ShowPlayerMessage(playerid, "No perteneces a ~r~San Andreas Fire Departament");
        } else if (strcmp(params, "pantalla", true) == 0) {
            if (!IsAtPantallaStation(playerid)) return 1;
            MostrarPantalla(playerid);
        } else if (strcmp(params, "fps", true) == 0) {
            if (PLAYER_INFO[playerid][pVip] < 2) return SendClientMessage(playerid, COLOR_WHITE, "Para activar esta caracteristica necesitar tener una membresia VIP {00CC00}#2.");
            if (!strval(params)) return SendClientMessage(playerid, 0xFF0000FF, "Error: /ver fps <Player ID>");
            new id = strval(params);
            new name[MAX_PLAYER_NAME];
            GetPlayerName(id, name, sizeof(name));
            format(string, sizeof(string), "Los FPS de %s son: %d", name, GetPlayerFPS(id));
            SendClientMessage(playerid, 0xFFFFFFFF, string);
        } else if (strcmp(params, "estanteria", true) == 0) {
            if (!IsPlayerInRangeOfPoint(playerid, 10, 254.2685, -41.5420, 1002.0308) && GetPlayerInterior(playerid) != 14) return 1;
            MostrarEstanteria(playerid);
        } else if (strcmp(params, "baul", true) == 0) {
            if (!IsPlayerInAnyVehicle(playerid)) return ShowPlayerMessage(playerid, "~r~No estas en un vehiculo.");
            BaulPolice(playerid);
            BaulIlegal(playerid);
        } else if (strcmp(params, "camion", true) == 0) {
            if ((PLAYER_INFO[playerid][pFaccion] == 3)) {
                if (RP_SAFDCanEquip(playerid)) {
                    format(string, sizeof(string), "Chaleco\t{FF0000} Cantidad{FFFFFF} +100 Armour\n");
                    format(string, sizeof(string), "%sBendas\t{FF0000} Cantidad:{FFFFFF} +100 Health\n", string);
                    format(string, sizeof(string), "%sBotiquin\t{FF0000} Cantidad:{FFFFFF} +1\n", string);
                    format(string, sizeof(string), "%sExtintor\t{FF0000} Cantidad:{FFFFFF} +1\n", string);
                    dialogs_ShowPlayerDialog(playerid, KITBOMBERO, DIALOG_STYLE_LIST, "Equipo de SAFD", string, "Seleccionar", "Cancelar");
                } else return SendClientMessage(playerid, COLOR_BLANCO, "No estas en un camion de bomberos.");
            } else return SendClientMessage(playerid, COLOR_BLANCO, "No eres bombero.");
        } else if (strcmp(params, "heladera", true) == 0 || strcmp(params, "geladeira", true) == 0) {
            MostrarHeladera(playerid);
        }
    }
    return 1;
}
CMD:guardar(playerid, params[]) {
    if(!strcmp(params,"bolsa",true) || !strcmp(params,"bolso",true)) return RB_StoreBag(playerid);
    new arma[20], armaid, string[150], cantidad;
    if (!sscanf(params, "s[20]d", arma, cantidad)) {
        if (strcmp(arma, "medicamentos", true) == 0 || strcmp(arma, "medicamento", true) == 0) armaid = 100;
        if (strcmp(arma, "crack", true) == 0) armaid = 200;
    } else if (!sscanf(params, "s[20]", arma)) {
        if (strcmp(arma, "manopla", true) == 0) armaid = 1;
        if (strcmp(arma, "palo-de-golf", true) == 0) armaid = 2;
        if (strcmp(arma, "cuchillo", true) == 0) armaid = 4;
        if (strcmp(arma, "bate-de-beisbol", true) == 0) armaid = 5;
        if (strcmp(arma, "pala", true) == 0) armaid = 6;
        if (strcmp(arma, "palo-de-billar", true) == 0) armaid = 7;
        if (strcmp(arma, "katana", true) == 0) armaid = 8;
        if (strcmp(arma, "consolador-rosa", true) == 0) armaid = 10;
        if (strcmp(arma, "vibrador-blanco", true) == 0) armaid = 11;
        if (strcmp(arma, "gran-vibrador-blanco", true) == 0) armaid = 12;
        if (strcmp(arma, "vibrador-plateado", true) == 0) armaid = 13;
        if (strcmp(arma, "ramo-de-flores", true) == 0) armaid = 14;
        if (strcmp(arma, "baston", true) == 0) armaid = 15;
        if (strcmp(arma, "granada", true) == 0) armaid = 16;
        if (strcmp(arma, "9mm", true) == 0) armaid = 22;
        if (strcmp(arma, "9mm-silenciada", true) == 0) armaid = 23;
        if (strcmp(arma, "desert-eagle", true) == 0) armaid = 24;
        if (strcmp(arma, "escopeta-de-madera", true) == 0) armaid = 25;
        if (strcmp(arma, "escopeta-de-combate", true) == 0) armaid = 27;
        if (strcmp(arma, "MP5", true) == 0) armaid = 29;
        if (strcmp(arma, "AK-47", true) == 0) armaid = 30;
        if (strcmp(arma, "M4", true) == 0) armaid = 31;
        if (strcmp(arma, "rifle", true) == 0) armaid = 33;
        if (strcmp(arma, "camara", true) == 0) armaid = 43;
        if (strcmp(arma, "bolso", true) == 0) armaid = 1000;
    }
    if (armaid != 0 && armaid == 300) // Marihuana
    {
        if (IsPlayerInRangeOfPoint(playerid, 10, 254.2685, -41.5420, 1002.0308) && GetPlayerInterior(playerid) == 14) {
            for(new c; c < MAX_PROPIEDADES; c++) {
                if (GetPlayerVirtualWorld(playerid) == PropInfo[c][pVW]) {
                    if (PLAYER_INFO[playerid][pMarihuana] >= cantidad) {
                        if (cantidad <= 0) return SendClientMessage(playerid, -1, "Cantidad invalida.");
                        PLAYER_INFO[playerid][pMarihuana] -= cantidad;
                        PropInfo[c][pMarihuana] += cantidad;
                        GuardarPropiedad(c);
                        AccionesRol(playerid, "coloca marihuana en el estante.", 20);
                    } else SendClientMessage(playerid, -1, "No tienes esa cantidad de marihuana.");
                }
            }
        }
    }
    if (armaid != 0 && armaid == 100) //Medicamentos
    {
        if (IsPlayerInRangeOfPoint(playerid, 10, 254.2685, -41.5420, 1002.0308) && GetPlayerInterior(playerid) == 14) {
            for(new c; c < MAX_PROPIEDADES; c++) {
                if (GetPlayerVirtualWorld(playerid) == PropInfo[c][pVW]) {
                    if (PLAYER_INFO[playerid][pRemedios] >= cantidad) {
                        if (cantidad <= 0) return SendClientMessage(playerid, -1, "Cantidad invalida.");
                        PLAYER_INFO[playerid][pRemedios] -= cantidad;
                        PropInfo[c][pMedicamentos] += cantidad;
                        GuardarPropiedad(c);
                        AccionesRol(playerid, "coloca medicamentos en el estante.", 20);
                    } else SendClientMessage(playerid, -1, "No tienes esa cantidad de medicamentos.");
                }
            }
        }
    } else if (armaid != 0 && armaid == 200) //Crack
    {
        if (IsPlayerInRangeOfPoint(playerid, 10, 254.2685, -41.5420, 1002.0308) && GetPlayerInterior(playerid) == 14) {
            for(new c; c < MAX_PROPIEDADES; c++) {
                if (GetPlayerVirtualWorld(playerid) == PropInfo[c][pVW]) {
                    if (PLAYER_INFO[playerid][pCrack] >= cantidad) {
                        if (cantidad <= 0) return SendClientMessage(playerid, -1, "Cantidad invalida.");
                        PLAYER_INFO[playerid][pCrack] -= cantidad;
                        PropInfo[c][pCrack] += cantidad;
                        GuardarPropiedad(c);
                        AccionesRol(playerid, "coloca gramos de crack en el estante.", 20);
                    } else SendClientMessage(playerid, -1, "No tienes esa cantidad de crack.");
                }
            }
        }
    } else if (armaid != 0 && armaid != 100 && armaid != 200) //Armas
    {
        if (IsPlayerInRangeOfPoint(playerid, 10, 254.2685, -41.5420, 1002.0308) && GetPlayerInterior(playerid) == 14) {
            for(new c; c < MAX_PROPIEDADES; c++) {
                if (GetPlayerVirtualWorld(playerid) == PropInfo[c][pVW]) {
                    if (EspacioRopero(c) < PropInfo[c][pLugarRopero]) {
                        if (SiTieneArma(playerid, armaid)) {
                            if (armaid == 1) PropInfo[c][pManopla]++;
                            else if (armaid == 2) PropInfo[c][pPaloDeGolf]++;
                            else if (armaid == 4) PropInfo[c][pCuchillo]++;
                            else if (armaid == 5) PropInfo[c][pBateDeBeisbol]++;
                            else if (armaid == 6) PropInfo[c][pPala]++;
                            else if (armaid == 7) PropInfo[c][pPaloDeBillar]++;
                            else if (armaid == 8) PropInfo[c][pKatana]++;
                            else if (armaid == 10) PropInfo[c][pConsoladorRosa]++;
                            else if (armaid == 11) PropInfo[c][pVibradorBlanco]++;
                            else if (armaid == 12) PropInfo[c][pGranVibradorBlanco]++;
                            else if (armaid == 13) PropInfo[c][pVibradorPlateado]++;
                            else if (armaid == 14) PropInfo[c][pFlores]++;
                            else if (armaid == 15) PropInfo[c][pBaston]++;
                            else if (armaid == 16) PropInfo[c][pGranada]++;
                            else if (armaid == 22) PropInfo[c][p9mm]++;
                            else if (armaid == 23) PropInfo[c][p9mmSilenciada]++;
                            else if (armaid == 24) PropInfo[c][pDesertEagle]++;
                            else if (armaid == 25) PropInfo[c][pEscopetaNormal]++;
                            else if (armaid == 27) PropInfo[c][pEscopetaDeCombate]++;
                            else if (armaid == 29) PropInfo[c][pMP5]++;
                            else if (armaid == 30) PropInfo[c][pAK47]++;
                            else if (armaid == 31) PropInfo[c][pM4]++;
                            else if (armaid == 33) PropInfo[c][pRifle]++;
                            else if (armaid == 43) PropInfo[c][pCamara]++;
                            QuitarArma(playerid, armaid);
                            format(string, sizeof(string), "%s coloca su %s en el estante.", PLAYER_INFO[playerid][Nickname], ArmaNombre2[armaid]);
                            ProxDetector(15.0, playerid, string, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES);
                            GuardarPropiedad(c);
                        } else SendClientMessage(playerid, -1, "No tienes esa arma en tus manos.");
                    } else SendClientMessage(playerid, -1, "No hay espacios libres en el estante.");
                }
            }
        }
    }
    return true;
}
CMD:sacar(playerid, params[]) {
    new arma[128], armaid, string[150], cantidad;
    if (!sscanf(params, "s[128]d", arma, cantidad)) {
        if (strcmp(arma, "medicamentos", true) == 0 || strcmp(arma, "medicamento", true) == 0 || strcmp(arma, "remedio", true) == 0 || strcmp(arma, "remedios", true) == 0) armaid = 100;
        if (strcmp(arma, "crack", true) == 0) armaid = 200;
    } else if (strcmp(arma, "estado", true) == 0) {
        if (ConEstado[playerid] == true) {
            SendClientMessage(playerid, COLOR_RED, "Tu estado ha sido eliminado.");
            Delete3DTextLabel(estado[playerid]);
            ConEstado[playerid] = false;
            return 1;
        }
        if (ConEstado[playerid] == false) return SendClientMessage(playerid, COLOR_WHITE, "No tienes ningun estado activo.");
        return 1;
    } else if (!sscanf(params, "s[128]", arma)) {
        if (strcmp(arma, "manopla", true) == 0) armaid = 1;
        if (strcmp(arma, "palo-de-golf", true) == 0) armaid = 2;
        if (strcmp(arma, "cuchillo", true) == 0) armaid = 4;
        if (strcmp(arma, "bate-de-beisbol", true) == 0) armaid = 5;
        if (strcmp(arma, "pala", true) == 0) armaid = 6;
        if (strcmp(arma, "palo-de-billar", true) == 0) armaid = 7;
        if (strcmp(arma, "katana", true) == 0) armaid = 8;
        if (strcmp(arma, "consolador-rosa", true) == 0) armaid = 10;
        if (strcmp(arma, "vibrador-blanco", true) == 0) armaid = 11;
        if (strcmp(arma, "gran-vibrador-blanco", true) == 0) armaid = 12;
        if (strcmp(arma, "vibrador-plateado", true) == 0) armaid = 13;
        if (strcmp(arma, "ramo-de-flores", true) == 0) armaid = 14;
        if (strcmp(arma, "baston", true) == 0) armaid = 15;
        if (strcmp(arma, "granada", true) == 0) armaid = 16;
        if (strcmp(arma, "9mm", true) == 0) armaid = 22;
        if (strcmp(arma, "9mm-silenciada", true) == 0) armaid = 23;
        if (strcmp(arma, "desert-eagle", true) == 0) armaid = 24;
        if (strcmp(arma, "escopeta-de-madera", true) == 0) armaid = 25;
        if (strcmp(arma, "escopeta-de-combate", true) == 0) armaid = 27;
        if (strcmp(arma, "MP5", true) == 0) armaid = 29;
        if (strcmp(arma, "AK-47", true) == 0) armaid = 30;
        if (strcmp(arma, "M4", true) == 0) armaid = 31;
        if (strcmp(arma, "rifle", true) == 0) armaid = 33;
        if (strcmp(arma, "camara", true) == 0) armaid = 43;
        if (strcmp(arma, "caramelos", true) == 0) armaid = 666;
        if (strcmp(arma, "caramelo", true) == 0) armaid = 666;
    }
    if (armaid == 300) {
        if (PLAYER_INFO[playerid][@Nivel] < 3) return SendClientMessage(playerid, -1, "Necesitas ser nivel 3 para sacar objetos de la estanteria.");
        if (IsPlayerInRangeOfPoint(playerid, 10, 254.2685, -41.5420, 1002.0308) && GetPlayerInterior(playerid) == 14) {
            for(new c; c < MAX_PROPIEDADES; c++) {
                if (GetPlayerVirtualWorld(playerid) == PropInfo[c][pVW]) {
