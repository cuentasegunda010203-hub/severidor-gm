public AbrirCaja(playerid) {
    if (!RP_SafeValid(playerid) || RP_SafePhase[playerid] != 1 ||
        PLAYER_INFO[playerid][pID] != RP_SafeAccount[playerid] || gettime() < RP_SafeDeadline[playerid]) return 0;
    if (Jail[playerid] || PLAYER_INFO[playerid][Agonizando] || GetPlayerState(playerid) != PLAYER_STATE_ONFOOT ||
        !IsPlayerInRangeOfPoint(playerid, 3.0, 820.41010, 8.37117, 1003.60370) ||
        GetPlayerInterior(playerid) != RP_SafeInterior[playerid] || GetPlayerVirtualWorld(playerid) != RP_SafeWorld[playerid]) return RP_SafeCancel(playerid, true);
    KillTimer(RP_SafeTimer[playerid]);
    RP_SafeTimer[playerid] = 0;
    RP_SafePhase[playerid] = 0;
    RP_SafeToken[playerid]++;
    RP_SafeOpenInterior = GetPlayerInterior(playerid);
    RP_SafeOpenWorld = GetPlayerVirtualWorld(playerid);
    DeletePVar(playerid, "robandobanco");
    ClearAnimations(playerid);
    StopAudioStreamForPlayer(playerid);
    if (RP_SafeResetTimer) KillTimer(RP_SafeResetTimer);
    RP_SafeResetTimer = SetTimer("ReactivarCaja", 3600000, false);
    GameTextForPlayerEx(playerid, "~g~Caja abierta~n~~w~/robar cajafuerte", 5000, 4);
    new Float:Pos[3];
    GetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);
    if (IsPlayerAttachedObjectSlotUsed(playerid, 4)) RemovePlayerAttachedObject(playerid, 4);
    DestroyDynamic3DTextLabel(textorobo);
    DestroyDynamic3DTextLabel(CajaFuerteTX);
    Robado[0] = 0;
    Robado[1] = 0;
    Robado[2] = 0;
    Robado[3] = 0;
    CajaAbierta = 1;
    AudioAlarma(Pos[0], Pos[1], Pos[2]);
    CajaFuerteTX = CreateDynamic3DTextLabel("{FFFFFF}La caja esta abierta{"COLOR_GM "}\nutiliza '/robar cajafuerte'", 0xFFFFFFFF, 820.41010, 8.37117, 1003.60370, 10.0);
    SendClientMessage(playerid, -1, "{FFFFFF}¡ROBA LA CAJA ANTES QUE LA POLICIA TE {FC0000}ATRAPE!");
    SendClientMessage(playerid, COLOR_RED, "{FFFFFF}Utiliza {FC0000}/robar cajafuerte.");
    TogglePlayerControllable(playerid, 1);
    SetPVarInt(playerid, "IsFrozen", 1);
    foreach(new i : Player) Notificador2(i, "~g~~h~[APSA] ~w~El banco ha sido robado por un grupo de sujetos armados en el banco de la plaza a los lados de LSPD.");
    TipoCargo[playerid] = 1;
    PLAYER_INFO[playerid][pCargos] += 4;
    SetPlayerWantedLevelEx(playerid, PLAYER_INFO[playerid][pCargos]);
    foreach(new i : Player)
    if (PLAYER_INFO[i][pDuty] == 1)
        SetPlayerMarkerForPlayer(i, playerid, c4_color);
    new string5[256];
    format(string5, sizeof(string5), "{3399FF}[Central de policia]{FFFFFF} A todas las unidades informan un robo en progreso en el banco de LSPD.", playerid);
    SendRadioMessagePatrulla(1, -1, string5);
    return 1;
}

