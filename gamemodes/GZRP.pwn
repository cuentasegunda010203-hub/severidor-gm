    UpdateDynamic3DTextLabelText(FABRICAS_INFO[ID][f_LABELS][19], -1, label_string);

    format(label_string, sizeof(label_string), "{000cff}Mesa de produccion\n{FFFFFF}Cristal molido: {EB0000}%d%%{FFFFFF}\nEstado: %s", FABRICAS_INFO[ID][f_PORCIENTO_COCINERO][4], EstadoCocinero(FABRICAS_INFO[ID][f_ESTADO_COCINERO][4], FABRICAS_INFO[ID][f_ACTORES][4]));
    UpdateDynamic3DTextLabelText(FABRICAS_INFO[ID][f_LABELS][20], -1, label_string);

