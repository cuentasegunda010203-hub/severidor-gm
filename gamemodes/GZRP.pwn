}

stock AbrirRegalo(playerid) {
    new regalo = random(13);
    switch (regalo) {
        case 0: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$50.000{FFFFFF} y {74F20C}una camara{FFFFFF} de regalo.");
            DarDinero(playerid, 50000);
            DarArma(playerid, 43);
        }
        case 1: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$80.000{FFFFFF} y {74F20C}un bate de Beisbol{FFFFFF} de regalo.");
            DarDinero(playerid, 80000);
            DarArma(playerid, 5);
        }
        case 2: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$70.000{FFFFFF} y {74F20C}una Katana{FFFFFF} de regalo.");
            DarDinero(playerid, 80000);
            DarArma(playerid, 8);
        }
        case 3: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$30.000{FFFFFF} y {74F20C}una Palo de Golf{FFFFFF} de regalo.");
            DarDinero(playerid, 30000);
            DarArma(playerid, 2);
        }
        case 4: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$40.000{FFFFFF} y {74F20C}500 piezas de armas{FFFFFF} de regalo.");
            DarDinero(playerid, 40000);
            PLAYER_INFO[playerid][pMateriales] += 500;
        }
        case 5: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$90.500{FFFFFF} y {74F20C}1 "SERVER_COIN "{FFFFFF} de regalo.");
            DarDinero(playerid, 90500);
            PLAYER_INFO[playerid][Moneda] += 1;
        }
        case 6: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$90.000{FFFFFF} y {74F20C}1 Totems{FFFFFF} de regalo.");
            DarDinero(playerid, 90000);
            PLAYER_INFO[playerid][Totems] += 1;
        }
        case 7: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$10.000{FFFFFF} y {74F20C}100 de crack{FFFFFF} de regalo.");
            DarDinero(playerid, 10000);
            PLAYER_INFO[playerid][pCrack] += 100;
        }
        case 8: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$50000{FFFFFF} y {74F20C}10 Totems{FFFFFF} de regalo.");
            DarDinero(playerid, 50000);
            PLAYER_INFO[playerid][Totems] += 10;
        }
        case 9: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$80500{FFFFFF} y {74F20C}una Katana{FFFFFF} de regalo.");
            DarDinero(playerid, 80500);
            DarArma(playerid, 8);
        }
        case 10: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}$20.000{FFFFFF} y {74F20C}una camara{FFFFFF} de regalo.");
            DarDinero(playerid, 20000);
            DarArma(playerid, 43);
        }
        case 11: {
            SendClientMessage(playerid, -1, "Lamentablemente no recibiras regalo.");
        }
        case 12: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}10 Totems{FFFFFF} de regalo.");
            PLAYER_INFO[playerid][Totems] += 10;
        }
        case 13: {
            SendClientMessage(playerid, -1, "Recibes {74F20C}Patines{FFFFFF} de regalo.");
            PLAYER_INFO[playerid][pPatines] = 1;
        }
    }
    return 1;
}

stock VehiculoEnGaraje(vehicleid) {
    for(new p; p < MAX_PROPIEDADES; p++) {
        if (PropInfo[p][pEnUso] == 1 && GetVehicleInterior(vehicleid) == 4 && GetVehicleVirtualWorld(vehicleid) == PropInfo[p][pVW]) return true;
    }
    return false;
}

stock EstaEnP(playerid, id, Float:rang) {
    new Float:Pos[3];
    GetPlayerPos(id, Pos[0], Pos[1], Pos[2]);
    if (IsPlayerInRangeOfPoint(playerid, rang, Pos[0], Pos[1], Pos[2])) return 1;
    return 0;
}

