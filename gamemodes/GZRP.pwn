CMD:me(playerid, params[]) {
    if (!isnull(params)) {
        new stringLength = strlen(params);
        if (stringLength <= 128) {
            AccionesRol2(playerid, params, 15);
            //SendClientMessage(playerid,-1,"Por favor acostombrate a usar {"COLOR_GM"}/y{FFFFFF} en lugar de {"COLOR_GM"}/me{FFFFFF}, ya que en futuras versiones el comando dejaro de existir.");
            DetectarSPAM(playerid, params);
        }
    } else SendClientMessage(playerid, COLOR_WHITE, "Usa {"COLOR_GM "}/y [Texto]");
    return 1;
}
CMD:y(playerid, params[]) {
    if (!isnull(params)) {
        new string[128];
        format(string, sizeof(string), "* %s %s", PLAYER_INFO[playerid][Nickname], params);
        if (strlen(string) < 128) ProxDetector(15.0, playerid, string, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES);
        DetectarSPAM(playerid, params);
    } else SendClientMessage(playerid, COLOR_WHITE, "Por favor escribe {"COLOR_GM "}/y texto{FFFFFF}, por ejemplo: {"COLOR_GM "}/y se rie{FFFFFF}.");
    return 1;
}
CMD:limpiarls(playerid) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) return 0; {
        if (AntiLagLS == 1) {
            AntiLagLS = 0;
            SendClientMessage(playerid, -1, "Has desactivado el Anti lag de LS");
        } else if (AntiLagLS == 0) {
            AntiLagLS = 1;
            SendClientMessage(playerid, -1, "Has Activado el Anti Lag de LS");
        }
    }
    return 1;
}
CMD:limpiarsalon(playerid) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) return 0; {
        if (Alquilado == true) {
            SendClientMessage(playerid, -1, "Limpiaste el salon de eventos.");
            SalonTimer();
        } else SendClientMessage(playerid, -1, "El salon no se encuentra alquilado.");
    }
    return 1;
}
CMD:limpiararmas(playerid) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) return 0; {
        LimpiarArmasSuelo();
        ShowPlayerMessage(playerid, "Armas en el suelo eliminadas ~g~correctamente~w~.");
    }
    return 1;
}
CMD:alquilar(playerid, params[]) {
    if (strcmp(params[0], "salon", true) == 0) {
        if (PLAYER_INFO[playerid][@Nivel] <= 5) return SendClientMessage(playerid, -1, "Necesitas nivel 6 o mas para poder alquilar este salon.");
        if (!IsPlayerInRangeOfPoint(playerid, 5, -1250.3397, 2093.7437, 1246.6360)) return SendClientMessage(playerid, -1, "No estas en donde se alquila el salon.");
        if (Alquilado == true) return SendClientMessage(playerid, -1, "El salon ya se encuentra alquilado.");
        if (Boleto[playerid] == true) return SendClientMessage(playerid, -1, "Ya compraste una entrada.");
        dialogs_ShowPlayerDialog(playerid, AlquilarSalon1, DIALOG_STYLE_INPUT, "Alquiler de salon", "Tiempo en horas:", "Siguiente", "Salir");
    }
    if (strcmp(params[0], "vehiculo", true) == 0) {
        if (IsPlayerInRangeOfPoint(playerid, 5, 825.1167, -1356.1001, 13.5428)) {
            new string[250];
            format(string, 256, "Alquilar una moto {ff3e3e}FCR-400{FFFFFF} por {00CC00}$5000");
            dialogs_ShowPlayerDialog(playerid, ALQUILARV, DIALOG_STYLE_LIST, "Gestion de alquiler", string, "Seleccionar", "Cancelar");
        }
    }
    return 1;
}
