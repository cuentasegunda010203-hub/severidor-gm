            SetDynamicObjectMaterial(PropInfo[id][PuertaIT], 0, 14592, "casinoVault01", "copbtm_brown");
            if (PropInfo[id][pRoperoX] != 0) {

                PropInfo[id][pLabel4] = CreateDynamic3DTextLabel("{FFFFFF}Pulsar [ F ] Para Entrar.", COLOR_WHITE, PropInfo[id][pRoperoX], PropInfo[id][pRoperoY], PropInfo[id][pRoperoZ] + 0.6, 7.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, PropInfo[id][pVW], PropInfo[id][pInteriorID], -1, 100.0);
