                            ActualizarHambre(playerid, 2);
                            ActualizarSed(playerid, 2);
                            PLAYER_INFO[playerid][pBarras] = 0;
                            ShowConfig(playerid);
                        } else if (PLAYER_INFO[playerid][pBarras] == 0) {
                            ActualizarHambre(playerid, 1);
                            ActualizarSed(playerid, 1);
                            PLAYER_INFO[playerid][pBarras] = 1;
                            ShowConfig(playerid);
                        }
                    }
