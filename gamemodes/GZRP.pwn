    return 1;
}

function StatsAutomaticos(playerid) {
    new string1[1300];
    string1 = "{FFFFFF}Bienvenido a "NAME_LARGO " Roleplay\nEn esta version te traemos sistemas unicos, para que te diviertas y trabajes con tus amigos.\nRecuerda leer las Reglas del Juego en nuestro foro.\nEn nuestra web tenemos variedades de items para comprar con monedas "SERVER_COIN ", usa /web.\n{FFFFFF}Pulsa Aceptar para recibir regalos de bienvenida.";
    dialogs_ShowPlayerDialog(playerid, DIALOG_STATS, DIALOG_STYLE_MSGBOX, "{ffffff}"SERVER_NAME3 " v{366397}"SERVER_VERSION "", string1, "Aceptar", "");
    Notificador2(playerid, "Has llegado a la ciudad de ~b~~h~Los Santos~w~.");
    Notificador2(playerid, "~y~Romina dice:~w~ Bienvenido a ~b~Los Santos~w~, una ciudad muy urbana y animada. Donde podras llevar la vida que desees a continuacion te daremos algunos ~g~tips~g~.");
    return 1;
}
public ColocarSkinVerde(playerid) {
    if (PLAYER_TEMP[playerid][RecienRegistradoTmp] == 1) {
        if (strcmp(PLAYER_INFO[playerid][jConexion], "1", false) != 0) {
            printf("[DEBUG] ColocarSkinVerde Ejecutado a un usuario ya registrado. Nombre: %s", PLAYER_INFO[playerid][Nickname]);
        } else {
            PlayAudioStreamForPlayer(playerid, "http://sonidos.gtazonerp.net/Avion.mp3");
            SetPosEx(playerid, 1360.0394, -2531.5564, 13.5469, 330.7344, 0, playerid + 1);
            SetPlayerVirtualWorld(playerid, playerid + 1);
            InterpolateCameraPos(playerid, 1504.140258, -2493.829833, 13.290760, 1504.140258, -2493.829833, 13.290760, 1000);
            InterpolateCameraLookAt(playerid, 1499.242309, -2493.428955, 14.212541, 1499.425903, -2493.404052, 14.901365, 1000);
            MoveDynamicObject(Avion[playerid + 1], 1459.00732, -2490.80957, 18.53950, 20.0, 3.17999, -0.23998, 0.00000);
            SetTimerEx("SiguienteToma", 9400, false, "i", playerid);
        }
    }
    return 1;
}
CMD:actualizaciones(playerid, params[]) {
    SendClientMessageEx(playerid, -1, "Ingresa a "WEB_INDEX2 " para enterarte de las actualizaciones.");
    return 1;
}
CMD:pagar(playerid, params[]) {
    new item[32], total_deuda;
    if (Jail[playerid] == 0) return SendClientMessage(playerid, -1, "Necesitas estar en la carcel para poder pagar la fianza");
    if (!sscanf(params, "s[32]", item)) {
        if (strcmp(item, "fianza", true) == 0) {
            if (PLAYER_TEMP[playerid][pTiempoFianza] > gettime()) return SendClientMessageEx(playerid, -1, "Tienes que esperar %s para poder pagar la fianza.", TimeConvertEx(PLAYER_TEMP[playerid][pTiempoFianza] - gettime()));
            switch (PLAYER_INFO[playerid][arrestado]) {
                case 0..5 : total_deuda = 1 * 5000;
                case 6..10 : total_deuda = 2 * 5000;
                case 11..15 : total_deuda = 3 * 5000;
                case 16..20 : total_deuda = 3 * 5000;
                case 21..25 : total_deuda = 4 * 5000;
                case 26..30 : total_deuda = 5 * 5000;
                case 31..35 : total_deuda = 6 * 5000;
                case 36..40 : total_deuda = 7 * 5000;
                case 41..45 : total_deuda = 8 * 5000;
                case 46..50 : total_deuda = 9 * 5000;
                case 51..55 : total_deuda = 10 * 5000;
                default: total_deuda = (PLAYER_INFO[playerid][arrestado] * 5000);
            }
            PLAYER_TEMP[playerid][pFianzaTotal] = total_deuda;
            new string[128];
            format(string, sizeof(string), "{FFFFFF}El costo para pagar tu fianza es de {04D616}%d$", total_deuda);
            dialogs_ShowPlayerDialog(playerid, DIALOG_FIANZA, DIALOG_STYLE_MSGBOX, "Pagar fianza", string, "Confirmar", "Rechazar");
        } else return SendClientMessage(playerid, -1, "Utiliza: {009AFF}/pagar fianza");
    } else return SendClientMessage(playerid, -1, "Utiliza: {009AFF}/pagar fianza");
    return 1;
}
CMD:colorbanda(playerid, params[]) { if (PLAYER_INFO[playerid][pVip] < 2) return SendClientMessage(playerid, COLOR_WHITE, "Para activar esta caracteristica necesitar tener una membresía VIP {00CC00}#3.."); if (PLAYER_INFO[playerid][pRango] < 8) return SendClientMessage(playerid, -1, "Tu no tienes los permisos suficientes para realizar esto.");
    dialogs_ShowPlayerDialog(playerid, D_COLOR1, DIALOG_STYLE_MSGBOX, "{"COLOR_GM "}¡Sistema de territorios!", "{FFFFFF}aca podras asigarle un color a tu banda\n{F12311}NOTA{FFFFFF}: Al asigarle el color a tu banda, para poder cambiarlo de nuevo tendra un costo de {"COLOR_GM "}20"SERVER_COIN2 "{FFFFFF}.\n\n{"COLOR_GM "}"SERVER_NAME "{FFFFFF} - 2020", "Siguiente", "Salir"); return 1; }

CMD:mejorasbanda(playerid) {
    new banda = PLAYER_INFO[playerid][pFaccion];
    if (banda < 5) return SendClientMessage(playerid, -1, "{"COLOR_GM "}Necesitas estar en una banda/organizacion/pandilla para hacer esto.");
    new item[2000];
    format(item, sizeof(item), "%s\n", BandasInfo[banda][BNombre]);
    if (BandasInfo[banda][Mejoras] == 0) {
        format(item, sizeof(item), "%sMejoras de la banda: {ff0000}No tiene{FFFFFF}\n", item);
    }
    if (BandasInfo[banda][Mejoras] > 0) {
        format(item, sizeof(item), "%sMejoras de la banda: {ff0000}%d{FFFFFF}\n", item, BandasInfo[banda][Mejoras]);
    }

    format(item, sizeof(item), "%s \n", item);
    format(item, sizeof(item), "%sMejorando tu banda podran:\n", item);
    format(item, sizeof(item), "%s \n", item);
    format(item, sizeof(item), "%s>Conquistar territorios sin CoolDown (Requiere nivel 7)\n", item);
    format(item, sizeof(item), "%s>Invitar a los miembros al discord de banda desde web.\n", item);
    format(item, sizeof(item), "%s>Alertas en el discord [Fabrica - Conquistas - Refuerzos]\n", item);
    format(item, sizeof(item), "%s>Asignar uniformes para hombres/mujeres de mi banda\n", item);
    dialogs_ShowPlayerDialog(playerid, BOOST_CREW, DIALOG_STYLE_INPUT, "Mejoras bandas", item, "Continuar", "Volver");
    return 1;
}
CMD:banda(playerid) {
    if (PLAYER_INFO[playerid][pFaccion] == 0) return SendClientMessage(playerid, -1, "{"COLOR_GM "}Necesitas estar en una banda/organizacion/pandilla.");
    if (PLAYER_INFO[playerid][pRango] >= 8) SendClientMessage(playerid, -1, "/eliminarbanda");
    SendClientMessage(playerid, -1, "/mejorasbanda - /miembros - /infobanda - /invitar - /ascender");
    return 1;
}
CMD:infobanda(playerid) {
    if (PLAYER_INFO[playerid][pFaccion] <= 3) return SendClientMessage(playerid, -1, "Las {"COLOR_GM "}Bandas civiles{FFFFFF} no pueden usar esta opcion.");
    new affected_members, crew_territories;

    mysql_format(handle_db, QUERY_BUFFER, sizeof(QUERY_BUFFER), "SELECT * FROM `usuarios` WHERE `Faccion`='%d';", PLAYER_INFO[playerid][pFaccion]);
    mysql_query(handle_db, QUERY_BUFFER, true);
    affected_members = cache_num_rows();

    mysql_format(handle_db, QUERY_BUFFER, sizeof(QUERY_BUFFER), "SELECT * FROM `facciones` WHERE `id`='%d' AND `cuentaterris`;", PLAYER_INFO[playerid][pFaccion]);
    mysql_query(handle_db, QUERY_BUFFER, true);

    crew_territories = cache_num_rows();

    mysql_format(handle_db, QUERY_BUFFER, sizeof(QUERY_BUFFER), "SELECT * FROM `territorios` WHERE `Z_Activa` = '1';", PLAYER_INFO[playerid][pFaccion]);
    mysql_query(handle_db, QUERY_BUFFER, true);

    new crew_territoriestotal = cache_num_rows();

    new dialog[450];
    format(dialog, sizeof dialog, "Banda: %s\nMiembros: %d\nFabrica: %s\nTerritorios: %d/%d", BandasInfo[PLAYER_INFO[playerid][pFaccion]][BNombre], affected_members, (TieneFabrica(PLAYER_INFO[playerid][pFaccion])) ? ("Si") : ("No"), crew_territories, crew_territoriestotal);
    dialogs_ShowPlayerDialog(playerid, INVENTARIO, DIALOG_STYLE_MSGBOX, "Informacion de tu banda", dialog, "Aceptar", "");
    return 1;
}
CMD:eliminarbanda(playerid) {
    if (PLAYER_INFO[playerid][pFaccion] == 0) return SendClientMessage(playerid, -1, "{"COLOR_GM "}Necesitas estar en una banda/organizacion/pandilla.");
    if (PLAYER_INFO[playerid][pRango] < 8) return SendClientMessage(playerid, -1, "La banda solo puede ser borrada por el lider.");
    if (PLAYER_INFO[playerid][pFaccion] > 5) {
        mysql_format(handle_db, QUERY_BUFFER, sizeof(QUERY_BUFFER), "DELETE FROM `facciones` WHERE `id`='%d'", BandasInfo[PLAYER_INFO[playerid][pFaccion]][bID]);
        mysql_tquery(handle_db, QUERY_BUFFER);
        mysql_format(handle_db, QUERY_BUFFER, sizeof(QUERY_BUFFER), "UPDATE `usuarios` SET `Faccion`='0',`Rango`='0' WHERE `Faccion`='%d'", PLAYER_INFO[playerid][pFaccion]);
        mysql_tquery(handle_db, QUERY_BUFFER);
        foreach(new i : Player) {
            if (PLAYER_INFO[i][pFaccion] == PLAYER_INFO[playerid][pFaccion] && i != playerid) {
                PLAYER_INFO[i][pFaccion] = 0;
                PLAYER_INFO[i][pRango] = 0;
                SendClientMessage(i, -1, "La banda que pertenecías fue borrada por el lider.");
            }
        }
        DarRopa(playerid);
        ResetPlayerWeapons(playerid);
        DarArmas(playerid);
        PLAYER_INFO[playerid][pFaccion] = 0;
        PLAYER_INFO[playerid][pRango] = 0;
        CargarFacciones();
        HidePlayerGangZones(playerid);
        SendClientMessage(playerid, -1, "Tu banda fue borrada correctamente.");
    } else return SendClientMessage(playerid, -1, "Bandas civiles no pueden hacer esto.");
    return 1;
}
CMD:miembros(playerid) {
    if (PLAYER_INFO[playerid][pFaccion] == 0) return SendClientMessage(playerid, -1, "{"COLOR_GM "}Necesitas estar en una banda/organizacion/pandilla.");
    mysql_format(handle_db, QUERY_BUFFER, sizeof(QUERY_BUFFER), "SELECT * FROM `usuarios` WHERE `Faccion`='%d'", PLAYER_INFO[playerid][pFaccion]);
    mysql_query(handle_db, QUERY_BUFFER, true);

    new dialog[115 * 25 + 1], line_str[115], Conexion[90], rango, name[24], online, time;
    dialog = "Nombre\tRango\tult. conexion\n";

    for(new i = 0; i < cache_num_rows(); i++) {
        cache_get_value_name(i, "Username", name);
        cache_get_value_name_int(i, "Rango", rango);
        cache_get_value_name(i, "Conexion", Conexion);
        cache_get_value_name_int(i, "Online", online);
        cache_get_value_name_int(i, "TiempoOffline", time);

        if (online == 0) format(line_str, sizeof line_str, "%s\t%s\t%s\n", name, RangoBanda(PLAYER_INFO[playerid][pFaccion], rango), TimeConvertEx(gettime() - time));
        else format(line_str, sizeof line_str, "%s\t%s\t{80D465}Conectado{FFFFFF}\n", name, RangoBanda(PLAYER_INFO[playerid][pFaccion], rango));
        strcat(dialog, line_str);
    }
    return dialogs_ShowPlayerDialog(playerid, INVENTARIO, DIALOG_STYLE_TABLIST_HEADERS, "Bandas: Miembros", dialog, "Volver", "");
}
CMD:estadocv(playerid) {
    if (PLAYER_INFO[playerid][pRango] <= 7 && PLAYER_INFO[playerid][pFaccion] == 1) {
        if (CV_ACTIVATE == 0) CV_ACTIVATE = 1;
        else CV_ACTIVATE = 0;

        return SendClientMessageEx(playerid, -1, "Las convocatorias para SAPD estan %s.", CV_ACTIVATE ? ("activadas") : ("desactivadas"));
    } else SendClientMessage(playerid, -1, "No tienes los permisos necesarios.");
    return 1;
}

CMD:deletecvs(playerid) {
    if (PLAYER_TEMP[playerid][pOwnerCMD_Use] == 1) {
        new Query[70];
        mysql_format(handle_db, Query, sizeof(Query), "TRUNCATE `curriculum_table`;", PLAYER_INFO[playerid][pID]);
        mysql_query(handle_db, Query, false);

        return SendClientMessage(playerid, -1, "Todos los curriculums fueron borrados correctamente.");
    } else if (PLAYER_INFO[playerid][pRango] == 8 && PLAYER_INFO[playerid][pFaccion] == 1) {
        new Query[70];
        mysql_format(handle_db, Query, sizeof(Query), "TRUNCATE `curriculum_table`;", PLAYER_INFO[playerid][pID]);
        mysql_query(handle_db, Query, false);

        return SendClientMessage(playerid, -1, "Todos los curriculums fueron borrados correctamente.");
    } else SendClientMessage(playerid, -1, "No tienes los permisos necesarios.");
    return 1;
}

CMD:curriculums(playerid) {
    if (PLAYER_INFO[playerid][pRango] < 4 && PLAYER_INFO[playerid][pFaccion] != 1) return SendClientMessage(playerid, -1, "No tienes los permisos necesarios.");
    ShowDialog(playerid, DIALOG_CURRICULUMS);
    return 1;
}

CMD:curriculum(playerid) {
    if (PlayerToPoint(5.0, playerid, 252.3920, 117.3864, 1003.2188)) {
        if (CV_ACTIVATE == 0) return SendClientMessage(playerid, -1, "Las convocatorias para SAPD no estan activas.");

        if (PLAYER_INFO[playerid][pFaccion] != 0) return SendClientMessage(playerid, -1, "No puedes pertenecer a una banda para hacer esta accion.");

        new Query[70];
        mysql_format(handle_db, Query, sizeof(Query), "SELECT * FROM `curriculum_table` WHERE `ID_DB`='%d';", PLAYER_INFO[playerid][pID]);
        mysql_query(handle_db, Query, true);

        if (!cache_num_rows()) ShowDialog(playerid, DIALOG_POSTULACION);
        else SendClientMessage(playerid, -1, "La base de datos ya tiene un registro de tu curriculum.");
        return 1;
    }
    return 1;
}

CMD:fabricas(playerid) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_ADM) return 0; {
        ShowDialog(playerid, DIALOG_DESOCUPAR_FABRICAS);
    }
    return 1;
}
EstadoVelocidad(playerid, vehicleid, bool:give = false) {
    if (vehicleid != autos[playerid] && vehicleid != autos2[playerid] && vehicleid != autos3[playerid] && vehicleid != autos4[playerid] && vehicleid != autos5[playerid]) return SendClientMessage(playerid, -1, "Solo puedes modificar tus vehiculos.");
    if (vehicleid == autos[playerid] && PLAYER_INFO[playerid][vID1] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para modificar.");
    if (vehicleid == autos2[playerid] && PLAYER_INFO[playerid][vID2] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para modificar.");
    if (vehicleid == autos3[playerid] && PLAYER_INFO[playerid][vID3] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para modificar.");
    if (vehicleid == autos4[playerid] && PLAYER_INFO[playerid][vID4] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para modificar.");
    if (vehicleid == autos5[playerid] && PLAYER_INFO[playerid][vID5] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para modificar.");
    if (vehicleid == autos[playerid]) {
        if (give) {
            if (PLAYER_INFO[playerid][vACELERACION] == 1) return 0;
            else {
                PLAYER_INFO[playerid][vACELERACION] = 1;
                return 1;
            }
        } else if (PLAYER_INFO[playerid][vACELERACION] == 0) return SendClientMessage(playerid, -1, "Tu vehiculo no tiene aceleracion");

        if (PLAYER_INFO[playerid][vACTIVE] == 1) {
            new action[84];
            format(action, sizeof action, "desactiva la aceleracion de su vehiculo %s *", GetVehicleName(GetPlayerVehicleID(playerid)));
            AccionesRol(playerid, action);
            PLAYER_INFO[playerid][vACTIVE] = 0;
            GLOBAL_VEHICLES[vehicleid][gb_vehicle_ACELERACION_ACTIVE] = 0;
        } else if (PLAYER_INFO[playerid][vACTIVE] == 0) {
            PLAYER_INFO[playerid][vACTIVE] = 1;
            GLOBAL_VEHICLES[vehicleid][gb_vehicle_ACELERACION_ACTIVE] = 1;
            new action[84];
            format(action, sizeof action, "activa la aceleracion de su vehiculo %s *", GetVehicleName(GetPlayerVehicleID(playerid)));
            AccionesRol(playerid, action);
        }

    } else if (vehicleid == autos2[playerid]) {
        if (give) {
            if (PLAYER_INFO[playerid][v2ACELERACION] == 1) return 0;
            else {
                PLAYER_INFO[playerid][v2ACELERACION] = 1;
                return 1;
            }
        } else if (PLAYER_INFO[playerid][v2ACELERACION] == 0) return SendClientMessage(playerid, -1, "Tu vehiculo no tiene aceleracion");

        if (PLAYER_INFO[playerid][v2ACTIVE] == 1) {
            new action[84];
            format(action, sizeof action, "desactiva la aceleracion de su vehiculo %s *", GetVehicleName(GetPlayerVehicleID(playerid)));
            AccionesRol(playerid, action);
            PLAYER_INFO[playerid][v2ACTIVE] = 0;
            GLOBAL_VEHICLES[vehicleid][gb_vehicle_ACELERACION_ACTIVE] = 0;
        } else if (PLAYER_INFO[playerid][v2ACTIVE] == 0) {
            PLAYER_INFO[playerid][v2ACTIVE] = 1;
            GLOBAL_VEHICLES[vehicleid][gb_vehicle_ACELERACION_ACTIVE] = 1;
            new action[84];
            format(action, sizeof action, "activa la aceleracion de su vehiculo %s *", GetVehicleName(GetPlayerVehicleID(playerid)));
            AccionesRol(playerid, action);
        }
    } else if (vehicleid == autos3[playerid]) {
        if (give) {
            if (PLAYER_INFO[playerid][v3ACELERACION] == 1) return 0;
            else {
                PLAYER_INFO[playerid][v3ACELERACION] = 1;
                return 1;
            }
        } else if (PLAYER_INFO[playerid][v3ACELERACION] == 0) return SendClientMessage(playerid, -1, "Tu vehiculo no tiene aceleracion");

        if (PLAYER_INFO[playerid][v3ACTIVE] == 1) {
            new action[84];
            format(action, sizeof action, "desactiva la aceleracion de su vehiculo %s *", GetVehicleName(GetPlayerVehicleID(playerid)));
            AccionesRol(playerid, action);
            PLAYER_INFO[playerid][v3ACTIVE] = 0;
            GLOBAL_VEHICLES[vehicleid][gb_vehicle_ACELERACION_ACTIVE] = 0;
        } else if (PLAYER_INFO[playerid][v3ACTIVE] == 0) {
            PLAYER_INFO[playerid][v3ACTIVE] = 1;
            GLOBAL_VEHICLES[vehicleid][gb_vehicle_ACELERACION_ACTIVE] = 1;
            new action[84];
            format(action, sizeof action, "activa la aceleracion de su vehiculo %s *", GetVehicleName(GetPlayerVehicleID(playerid)));
            AccionesRol(playerid, action);
        }
    } else if (vehicleid == autos4[playerid]) {
        if (give) {
            if (PLAYER_INFO[playerid][v4ACELERACION] == 1) return 0;
            else {
                PLAYER_INFO[playerid][v4ACELERACION] = 1;
                return 1;
            }
        } else if (PLAYER_INFO[playerid][v4ACELERACION] == 0) return SendClientMessage(playerid, -1, "Tu vehiculo no tiene aceleracion");

        if (PLAYER_INFO[playerid][v4ACTIVE] == 1) {
            new action[84];
            format(action, sizeof action, "desactiva la aceleracion de su vehiculo %s *", GetVehicleName(GetPlayerVehicleID(playerid)));
            AccionesRol(playerid, action);

            PLAYER_INFO[playerid][v4ACTIVE] = 0;
            GLOBAL_VEHICLES[vehicleid][gb_vehicle_ACELERACION_ACTIVE] = 0;
        } else if (PLAYER_INFO[playerid][v4ACTIVE] == 0) {
            PLAYER_INFO[playerid][v4ACTIVE] = 1;
            GLOBAL_VEHICLES[vehicleid][gb_vehicle_ACELERACION_ACTIVE] = 1;
            new action[84];
            format(action, sizeof action, "activa la aceleracion de su vehiculo %s *", GetVehicleName(GetPlayerVehicleID(playerid)));
            AccionesRol(playerid, action);
        }
    } else if (vehicleid == autos5[playerid]) {
        if (give) {
            if (PLAYER_INFO[playerid][v5ACELERACION] == 1) return 0;
            else {
                PLAYER_INFO[playerid][v5ACELERACION] = 1;
                return 1;
            }
        } else if (PLAYER_INFO[playerid][v5ACELERACION] == 0) return SendClientMessage(playerid, -1, "Tu vehiculo no tiene aceleracion");

        if (PLAYER_INFO[playerid][v5ACTIVE] == 1) {
            new action[84];
            format(action, sizeof action, "desactiva la aceleracion de su vehiculo %s *", GetVehicleName(GetPlayerVehicleID(playerid)));
            AccionesRol(playerid, action);

            PLAYER_INFO[playerid][v5ACTIVE] = 0;
            GLOBAL_VEHICLES[vehicleid][gb_vehicle_ACELERACION_ACTIVE] = 0;
        } else if (PLAYER_INFO[playerid][v5ACTIVE] == 0) {
            PLAYER_INFO[playerid][v5ACTIVE] = 1;
            GLOBAL_VEHICLES[vehicleid][gb_vehicle_ACELERACION_ACTIVE] = 1;
            new action[84];
            format(action, sizeof action, "activa la aceleracion de su vehiculo %s *", GetVehicleName(GetPlayerVehicleID(playerid)));
            AccionesRol(playerid, action);
        }
    }
    return 1;
}
EstadoSalto(playerid, vehicleid /*, bool:add = false*/ ) {
    if (vehicleid != autos[playerid] && vehicleid != autos2[playerid] && vehicleid != autos3[playerid] && vehicleid != autos4[playerid] && vehicleid != autos5[playerid]) return SendClientMessage(playerid, -1, "Solo puedes modificar tus vehiculos.");
    if (vehicleid == autos[playerid] && PLAYER_INFO[playerid][vID1] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para modificar.");
    if (vehicleid == autos2[playerid] && PLAYER_INFO[playerid][vID2] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para modificar.");
    if (vehicleid == autos3[playerid] && PLAYER_INFO[playerid][vID3] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para modificar.");
    if (vehicleid == autos4[playerid] && PLAYER_INFO[playerid][vID4] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para modificar.");
    if (vehicleid == autos5[playerid] && PLAYER_INFO[playerid][vID5] == 0) return SendClientMessage(playerid, -1, "Debes reloguear para modificar.");
    if (GLOBAL_VEHICLES[vehicleid][gb_vehicle_SALTO_V_1] == 0) return SendClientMessage(playerid, -1, "Tu vehiculo no tiene esta mejora");
    if (GLOBAL_VEHICLES[vehicleid][gb_vehicle_SALTO_V] == 1) {
        GLOBAL_VEHICLES[vehicleid][gb_vehicle_SALTO_V] = 0;
        SendClientMessage(playerid, -1, "Salto v1 desactivado");
    } else {
        GLOBAL_VEHICLES[vehicleid][gb_vehicle_SALTO_V] = 1;
        SendClientMessage(playerid, -1, "Salto v1 activado");
    }
    GLOBAL_VEHICLES[vehicleid][gb_vehicle_SALTO_V] = PLAYER_INFO[playerid][vSALTO_V];
    GLOBAL_VEHICLES[vehicleid][gb_vehicle_SALTO_V_1] = PLAYER_INFO[playerid][vSALTO_V_1];
    GLOBAL_VEHICLES[vehicleid][gb_vehicle_SALTO_V_2] = PLAYER_INFO[playerid][vSALTO_V_2];
    return 1;
}
CMD:mejoras(playerid, params[]) {
    for(new i = 0; i < sizeof POSTALLERES; i++) {
        if (IsPlayerInRangeOfPoint(playerid, 5, POSTALLERES[i][xXx], POSTALLERES[i][yYy], POSTALLERES[i][zZz])) {
            if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
                dialogs_ShowPlayerDialog(playerid, DIALOG_MEJORAS_VEH, DIALOG_STYLE_LIST, "Mejoras para el vehiculo", "Mejorar motor\nMejorar estetica", "Aceptar", "Cerrar");
            }
        }
    }
    return 1;
}

CMD:vehiculo(playerid) {
    if (GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
    new vehicleid = GetPlayerVehicleID(playerid), aceletiene[10], aceleactive[10];
    switch (GLOBAL_VEHICLES[vehicleid][gb_vehicle_ACELERACION]) {
        case 0 :aceletiene = "No";
        case 1 :aceletiene = "Si";
    }
    switch (GLOBAL_VEHICLES[vehicleid][gb_vehicle_ACELERACION_ACTIVE]) {
        case 0 :aceleactive = "No";
        case 1 :aceleactive = "Si";
    }

    new string[200], dialog[1000];
    format(string, sizeof(string), "Aceleracion : \"%s\" | Activo : \"%s\"\n", aceletiene, aceleactive);
    strcat(dialog, string);

    format(string, sizeof(string), "Salto vertical opcion :  \"%d\"\n", GLOBAL_VEHICLES[vehicleid][gb_vehicle_SALTO_V]);
    strcat(dialog, string);

    new formt[20];
    format(formt, sizeof(formt), "{D32B2B}%s", GetVehicleName(GetPlayerVehicleID(playerid)));
    dialogs_ShowPlayerDialog(playerid, DIALOG_ACTIVE_MEJORAS, DIALOG_STYLE_LIST, formt, dialog, "Seguir(>>)", "Cerrar");
    return 1;
}

