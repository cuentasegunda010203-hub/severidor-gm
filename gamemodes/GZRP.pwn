stock MezclaEntregada(playerid) {
    if (!JugadorEnAlbanil[playerid] || !Mescla[playerid]) return 0;
    // Consume the bucket before awarding money and points: one reward per delivery.
    Mescla[playerid] = 0;
    new ganancias;
    if (JugadorEnAlbanil[playerid] == 1) {
        switch (Mescla[playerid] == 1) {
            case 0..5: {
                new intento = random(6);
                switch (intento) {
                    case 0 :  { ganancias = 1762; }
                    case 1 :  { ganancias = 1451; }
                    case 2 :  { ganancias = 1381; }
                    case 3 :  { ganancias = 1422; }
                    case 4 :  { ganancias = 1513; }
                    case 5 :  { ganancias = 1661; }

                }
            }
        }
        new exp, texto[128];
        if (PLAYER_INFO[playerid][pVip] == 0) {
            format(texto, sizeof(texto), "Esta entrega suma habilidad de Obrero. No obtuviste experiencia extra esta vez.");
            exp = random(5);
        } else {
            format(texto, sizeof(texto), "Esta entrega suma habilidad de Obrero. No obtuviste experiencia extra esta vez.");
            exp = random(4);
        }
        switch (exp) {
            case 0 : SendClientMessage(playerid, -1, texto);
            case 1: {
                Notificador2(playerid, "Ganaste ~y~ +3 "    SERVER_COIN " ~w~/~y~ +1 Experiencia.");
                PLAYER_INFO[playerid][jExperiencia]++;
                BarraExp(playerid, 1);
                PLAYER_INFO[playerid][Moneda] += 3;
            }
            case 2 : {
                Notificador2(playerid, "Ganaste~y~ +1 Experiencia.");
                PLAYER_INFO[playerid][jExperiencia]++;
                BarraExp(playerid, 1);
            }
            case 3 : SendClientMessage(playerid, -1, texto);
            case 4 : SendClientMessage(playerid, -1, texto);
        }
        AccionesRol(playerid, "le da el balde al Obrero.", 20);
        new string[128];
        format(string, sizeof(string), "~g~¡Buen trabajo!~w~ Tus ganancias son: ~g~$%d~g~.", ganancias);
        ShowPlayerMessage(playerid, string);
        DarDinero(playerid, ganancias);
    }
    ClearAnimations(playerid);
    SacarAnimF(playerid);
    RemovePlayerAttachedObject(playerid, 4);
    TogglePlayerControllable(playerid, 1);
    ClearAnimations(playerid);
    AddPlayerJobPoints(playerid, T_Albanil);
    GuardarCuenta(playerid);
    return 1;
}


CMD:licencias(playerid, params[]) {
    if (PLAYER_INFO[playerid][pAdmin] < ADMIN_LEVEL_PROGRAMMER) return 0;
    extract params - > new player:id; else Licencias(playerid, playerid);
    new string[200];
    if (id != playerid) {
        Licencias(playerid, id);
        format(string, sizeof(string), "%s le muestra sus licencias a %s", PLAYER_INFO[playerid][Nickname], PLAYER_INFO[id][Nickname]);
        ProxDetector(10.0, playerid, string, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES);
    } else return ProxDetector(10.0, playerid, "mira sus licencias", COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES, COLOR_ACCIONES);
    return 1;
}

new NombresLicencias[7][7] = {
    "Coche", // 01 - Coche
    "Camion", // 02 - Camion
    "Moto", // 03 - Moto
    "Vuelo", // 04 - Vuelo
    "Botes", // 05 - Bote
    "Tren", // 06 - Tren
    "Pesca" // 07 - Pesca
};
stock BuscarModeIndexInt(model, & dest) {
    for(new i = 0; i < sizeof(ObjetosInterior); i++) {
        if (model == ObjetosInterior[i][0]) dest = i;
    }
    return 0;
}
stock VenderMuebleCasa(playerid, oID, casaid) {
    new query[256], OBJ_INDEX;
    if (PropInfo[casaid][ModeloMuebles][oID]) {
        if(PropInfo[casaid][pIDPropietario] != PLAYER_INFO[playerid][pID]) return 1; 
        PropInfo[casaid][ModeloMuebles][oID] = -1;
        mysql_format(handle_db, query, sizeof(query), "DELETE FROM server_muebles WHERE ID = '%d'", PropInfo[casaid][MuebleID][oID]);
        mysql_tquery(handle_db, query);
        if (PropInfo[casaid][Puesto][oID] > 0) {
            if (IsValidDynamicObject(PropInfo[casaid][Inmobiliario][oID])) DestroyDynamicObject(PropInfo[casaid][Inmobiliario][oID]);
            PropInfo[casaid][Puesto][oID] = 0;
        }
        BuscarModeIndexInt(PropInfo[casaid][ModeloMuebles][oID], OBJ_INDEX);
        SendClientMessageEx(playerid, -1, "Vendiste tu '%s' al mercado por %d", ObjetosInterior[OBJ_INDEX][2], ObjetosInterior[OBJ_INDEX][1] / 2);
        DarDinero(playerid, ObjetosInterior[OBJ_INDEX][1] / 2);
    }
    return 1;
}
stock ObtenerSlotMuebleVacio(casaid) {
    new contador = 0;
    for(new i = 0; i < MAX_OBJETOS_CASAS; i++) {
        if (PropInfo[casaid][MuebleID][i] > 0) {
            contador++;
        }
    }
    if (contador >= MAX_OBJETOS_CASAS) { return 1000; }
    for(new i = 0; i < MAX_OBJETOS_CASAS; i++) {
        if (PropInfo[casaid][ModeloMuebles][i] <= 0) {
            printf("%d", i);
            return i;
        }
    }
    return 1000;
}
forward CargarMueblesCasa(p);
public CargarMueblesCasa(p) {
    if (cache_num_rows() > 0) {
        for(new i = 0; i < cache_num_rows(); i++) {
            cache_get_value_name_int(i, "ID", PropInfo[p][MuebleID][i]);
            cache_get_value_name_float(i, "x", PropInfo[p][MuebleX1][i]);
            cache_get_value_name_float(i, "y", PropInfo[p][MuebleY1][i]);
            cache_get_value_name_float(i, "z", PropInfo[p][MuebleZ1][i]);
            cache_get_value_name_float(i, "x1", PropInfo[p][MuebleX2][i]);
            cache_get_value_name_float(i, "y1", PropInfo[p][MuebleY2][i]);
            cache_get_value_name_float(i, "z1", PropInfo[p][MuebleZ2][i]);
            cache_get_value_name_int(i, "Modelo", PropInfo[p][ModeloMuebles][i]);
            cache_get_value_name_int(i, "Puesto", PropInfo[p][Puesto][i]);

            if (PropInfo[p][Puesto][i] > 0) PropInfo[p][Inmobiliario][i] = CreateDynamicObject(PropInfo[p][ModeloMuebles][i], PropInfo[p][MuebleX1][i], PropInfo[p][MuebleY1][i], PropInfo[p][MuebleZ1][i], PropInfo[p][MuebleX2][i], PropInfo[p][MuebleY2][i], PropInfo[p][MuebleZ2][i], PropInfo[p][pVW], PropInfo[p][pInteriorID]);
            MC_ReadMaterials(p,i);
        }
    }
    return true;
}
CMD:casa(playerid, params[]) {
    if (GetPlayerVirtualWorld(playerid) == 0) return 1;
    new puerta[80], str[160];
    for(new p = 0; p < MAX_PROPIEDADES; p++) {
        if (PropInfo[p][pEnUso] == 1) {
            if (GetPlayerVirtualWorld(playerid) == PropInfo[p][pVW] && GetPlayerInterior(playerid) == PropInfo[p][pInteriorID] && PLAYER_INFO[playerid][pID] == PropInfo[p][pIDPropietario]) {
                if (PropInfo[p][pAbierta] == 1) {
                    puerta = "{00FF00}Abierta";
                } else {
                    puerta = "{FF0000}Cerrada";
                }
                format(str, sizeof(str), "Propietario\t%s\nPuerta\t%s\nMuebles\nComprar muebles\n\nVender Propiedad\nMover textos y puntos\nPortones", PropInfo[p][pPropietario], puerta);
                dialogs_ShowPlayerDialog(playerid, D_Casa, DIALOG_STYLE_TABLIST, "{72B1FF}Opciones de la propiedad", str, "Seleccionar", "Cerrar");
                return 1;
            }
        }
    }
    return true;
}
forward Licencias(playerid, id);
public Licencias(playerid, id) {
    new mensaje[150];
    SendClientMessage(id, 0xAFAFAFAA, "............:::::Licencias:::::............");

    for(new i = 0; i < sizeof NombresLicencias; i++) {
        format(mensaje, sizeof(mensaje), "%s: si", NombresLicencias[i]);
        SendClientMessage(id, 0xAFAFAFAA, mensaje);
    }
}

