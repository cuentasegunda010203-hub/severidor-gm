{
    ViendoCajas[playerid] = 0;
    return 1;
}
function SiguienteToma2( playerid )
{
    if(PLAYER_TEMP[playerid][RecienRegistradoTmp] == 1)
    {
        MoveDynamicObject(Avion[playerid+1],1250.13855, -2497.30396, 77.84116,50.0,-1.02001, 15.36001, 1.20000);
        SetCameraBehindPlayer(playerid);
        acc_TogglePlayerSpectating(playerid, true);
        SetPlayerInterior(playerid,GetPlayerInterior(TrenUno));
        SetPlayerVirtualWorld(playerid,GetPlayerVirtualWorld(TrenUno));
        PlayerSpectateVehicle(playerid,GetPlayerVehicleID(TrenUno));
        Notificador2(playerid, "Estas por llegar a ~g~Los Santos~w~.");//mejorar 3
        SetTimerEx("SiguienteToma3", 10000, false, "i", playerid);
    }
    return 1;
}
function SiguienteToma3(playerid)
{
    if(PLAYER_TEMP[playerid][RecienRegistradoTmp] == 1)
    {
        acc_TogglePlayerSpectating(playerid, false);
        SetCameraBehindPlayer(playerid);
        SetPlayerVirtualWorld(playerid, 0);
        SetPosEx(playerid, 1714.7008,-1898.6792,13.5666, 0, 0, 0);
        MostrarLuegoDe(playerid);
        SetTimerEx("StatsAutomaticos",3000,false,"d",playerid);
    }
	return 1;
}
