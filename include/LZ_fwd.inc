function SiguienteToma( playerid )
{
    if(PLAYER_TEMP[playerid][RecienRegistradoTmp] == 1)
    {
        MoveDynamicObject(Avion[playerid+1],1779.46436, -2493.12866, 18.53950, 25.0,3.17999, -0.23998, 0.00000);
        InterpolateCameraPos(playerid, 1503.829589, -2493.906982, 13.690046, 1501.442016, -2471.728759, 21.215038, 5000);
        InterpolateCameraLookAt(playerid, 1498.922607, -2493.629394, 14.608755, 1506.263671, -2472.548828, 20.176050, 5000);
        Notificador2(playerid, "El servidor esta en una version ~y~estable~w~. Las actualizaciones se van mejorando constantemente para la experiencia del jugador");
        SetTimerEx("SiguienteToma2", 8000, false, "i", playerid);
    }
    //Notificador2(playerid, "Minutos despues cogerias un ~b~tren~w~.");
    return 1;
}
